    <script>
            (function () {
                function normalizeArabicHeaderText(value) {
                    return (value || '')
                        .replace(/[إأآ]/g, 'ا')
                        .replace(/ة/g, 'ه')
                        .replace(/\s+/g, ' ')
                        .trim();
                }

                function isVisibleElement(element) {
                    if (!element) return false;
                    const rect = element.getBoundingClientRect();
                    const style = window.getComputedStyle(element);
                    return rect.width > 0 && rect.height > 0 && style.display !== 'none' && style.visibility !== 'hidden';
                }

                function findEmployeeManagementHeaderTitle() {
                    const target = 'اداره الموظفين';
                    const candidates = Array.from(document.querySelectorAll('header *, .header *, .main-header *, .topbar *, .navbar *, .page-header *, .app-header *, body > *'));

                    return candidates.find(function (element) {
                        if (!element || element.closest('.employee-transactions-page') || element.closest('#luxiraEmployeeDefaultHeaderNavTemplate')) {
                            return false;
                        }

                        if (!isVisibleElement(element)) {
                            return false;
                        }

                        const rect = element.getBoundingClientRect();
                        if (rect.top < -5 || rect.top > 90) {
                            return false;
                        }

                        const text = normalizeArabicHeaderText(element.textContent);
                        return text === target || text.includes(target);
                    }) || null;
                }

                function findHeaderContainer(titleElement) {
                    let current = titleElement;
                    for (let i = 0; i < 8 && current; i++) {
                        const rect = current.getBoundingClientRect();
                        const className = (current.className || '').toString().toLowerCase();

                        if (
                            current.tagName === 'HEADER' ||
                            className.includes('header') ||
                            className.includes('navbar') ||
                            className.includes('topbar') ||
                            className.includes('app-bar') ||
                            (rect.top <= 80 && rect.width >= window.innerWidth * 0.55 && rect.height <= 80)
                        ) {
                            return current;
                        }

                        current = current.parentElement;
                    }

                    return titleElement ? titleElement.parentElement : null;
                }

                function markCurrentLink(nav) {
                    const path = (window.location.pathname || '').toLowerCase().replace(/\/$/, '');
                    nav.querySelectorAll('a[href]').forEach(function (link) {
                        const linkPath = (link.getAttribute('href') || '').toLowerCase().replace(/\/$/, '');
                        if (linkPath && path === linkPath) {
                            link.classList.add('is-current');
                        }
                    });
                }

                function injectEmployeeHeaderLinks() {
                    const template = document.getElementById('luxiraEmployeeDefaultHeaderNavTemplate');
                    if (!template) return;

                    document.querySelectorAll('.luxira-employee-default-header-nav:not(#luxiraEmployeeDefaultHeaderNavTemplate .luxira-employee-default-header-nav)').forEach(function (oldNav) {
                        oldNav.remove();
                    });

                    const sourceNav = template.querySelector('.luxira-employee-default-header-nav');
                    if (!sourceNav) return;

                    const nav = sourceNav.cloneNode(true);
                    markCurrentLink(nav);

                    const titleElement = findEmployeeManagementHeaderTitle();
                    const headerContainer = findHeaderContainer(titleElement);

                    if (headerContainer) {
                        const containerStyle = window.getComputedStyle(headerContainer);
                        if (containerStyle.position === 'static') {
                            headerContainer.style.position = 'relative';
                        }
                        headerContainer.appendChild(nav);
                        return;
                    }

                    nav.classList.add('is-fixed-fallback');
                    document.body.appendChild(nav);
                }

                if (document.readyState === 'loading') {
                    document.addEventListener('DOMContentLoaded', injectEmployeeHeaderLinks);
                } else {
                    injectEmployeeHeaderLinks();
                }

                window.addEventListener('load', function () {
                    setTimeout(injectEmployeeHeaderLinks, 150);
                    setTimeout(injectEmployeeHeaderLinks, 600);
                });
            })();
    </script>


