    <script id="employee-transactions-center-white-popup-script">
            (function () {
                const backdrop = document.getElementById('employeeCenterPopupBackdrop');
                const icon = document.getElementById('employeeCenterPopupIcon');
                const title = document.getElementById('employeeCenterPopupTitle');
                const message = document.getElementById('employeeCenterPopupMessage');
                const okButton = document.getElementById('employeeCenterPopupOk');
                const cancelButton = document.getElementById('employeeCenterPopupCancel');
                let pendingResolver = null;
                let autoCloseTimer = null;

                function closePopup(result) {
                    if (autoCloseTimer) {
                        clearTimeout(autoCloseTimer);
                        autoCloseTimer = null;
                    }

                    if (backdrop) backdrop.classList.remove('is-visible');

                    const resolver = pendingResolver;
                    pendingResolver = null;

                    if (resolver) {
                        resolver(result === true);
                    }
                }

                function openPopup(options) {
                    options = options || {};
                    const mode = options.mode || 'message';
                    const isError = options.isError === true;
                    const isQuestion = mode === 'confirm';

                    if (title) {
                        title.textContent = options.title || (isQuestion ? 'هل أنت متأكد؟' : (isError ? 'تنبيه' : 'تم التحديث'));
                    }

                    if (message) {
                        message.textContent = options.message || '';
                    }

                    if (icon) {
                        icon.classList.remove('error', 'question');
                        if (isQuestion) icon.classList.add('question');
                        if (isError) icon.classList.add('error');
                        icon.textContent = isQuestion ? '?' : (isError ? '!' : '✓');
                    }

                    if (cancelButton) {
                        cancelButton.style.display = isQuestion ? 'inline-flex' : 'none';
                    }

                    if (okButton) {
                        okButton.classList.toggle('employee-center-popup-confirm', isQuestion);
                        okButton.classList.toggle('employee-center-popup-ok', !isQuestion);
                        okButton.textContent = isQuestion ? 'تأكيد' : 'حسنًا';
                    }

                    if (backdrop) backdrop.classList.add('is-visible');

                    if (!isQuestion && !isError) {
                        if (autoCloseTimer) clearTimeout(autoCloseTimer);
                        autoCloseTimer = window.setTimeout(function () {
                            closePopup(true);
                        }, 3000);
                    }

                    return new Promise(function (resolve) {
                        pendingResolver = resolve;
                    });
                }

                window.employeeTransactionsShowCenterPopup = openPopup;

                window.employeeTransactionsShowMessage = function (message, isError, title) {
                    return openPopup({
                        mode: 'message',
                        title: title || (isError ? 'تنبيه' : 'تم التحديث'),
                        message: message || '',
                        isError: isError === true
                    });
                };

                window.employeeTransactionsAsk = function (title, message) {
                    return openPopup({
                        mode: 'confirm',
                        title: title || 'هل أنت متأكد؟',
                        message: message || '',
                        isError: true
                    });
                };

                if (okButton) {
                    okButton.addEventListener('click', function () { closePopup(true); });
                }

                if (cancelButton) {
                    cancelButton.addEventListener('click', function () { closePopup(false); });
                }

                if (backdrop) {
                    backdrop.addEventListener('click', function (event) {
                        if (event.target === backdrop) {
                            closePopup(false);
                        }
                    });
                }
            })();
    </script>



