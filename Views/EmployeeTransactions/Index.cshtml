    <div id="pagination-link" class="mt-3 container-fluid">
        <div class="d-flex justify-content-center align-items-center flex-wrap">
            <nav aria-label="Page navigation" class="mx-auto">
                <ul class="pagination p-0">
                    @{
                        int currentPage = Model.CurrentPage;
                        int totalPages = Model.TotalPages;
                        int previousPage = currentPage > 1 ? currentPage - 1 : 1;
                        int nextPage = currentPage < totalPages ? currentPage + 1 : totalPages;
                        var pagesToShow = new SortedSet<int>();

                        if (totalPages <= 7)
                        {
                            for (int i = 1; i <= totalPages; i++) pagesToShow.Add(i);
                        }
                        else
                        {
                            int windowStart = currentPage <= 2 ? 1 : currentPage >= totalPages - 1 ? totalPages - 2 : currentPage - 1;
                            int windowEnd = currentPage <= 2 ? 3 : currentPage >= totalPages - 1 ? totalPages : currentPage + 1;

                            for (int i = Math.Max(1, windowStart); i <= Math.Min(totalPages, windowEnd); i++) pagesToShow.Add(i);
                            for (int i = Math.Max(1, totalPages - 2); i <= totalPages; i++) pagesToShow.Add(i);
                        }

                        int lastRenderedPage = 0;
                    }

                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                        <a class="page-link pointer" data-page="1" title="أول صفحة"><i class="fa-solid fa-chevron-double-right text-green"></i></a>
                    </li>
                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                        <a class="page-link" data-page="@previousPage" title="الصفحة السابقة"><i class="fa-solid fa-chevron-right text-green"></i></a>
                    </li>

                    @foreach (var pageNumber in pagesToShow)
                    {
                        if (lastRenderedPage > 0 && pageNumber - lastRenderedPage > 1)
                        {
                            <li class="page-item disabled"><span class="page-link">...</span></li>
                        }

                        <li class="numbers page-item @(currentPage == pageNumber ? "active" : "")">
                            <a class="page-link" data-page="@pageNumber">@pageNumber</a>
                        </li>

                        lastRenderedPage = pageNumber;
                    }

                    <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                        <a class="page-link" data-page="@nextPage" title="الصفحة التالية"><i class="fa-solid fa-chevron-left text-green"></i></a>
                    </li>
                    <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                        <a class="page-link" data-page="@totalPages" title="آخر صفحة"><i class="fa-solid fa-chevron-double-left text-green"></i></a>
                    </li>
                </ul>
            </nav>
        </div>
    </div>

