@model lotus_blue.Models.ViewModel.PaginationViewModel<lotus_blue.Models.ViewModel.EmployeeTransactionViewModel>
@using lotus_blue.Models
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "مكافآت وخصومات الموظفين";

    var activeEmployees = ViewBag.ActiveEmployees as List<SelectListItem> ?? new List<SelectListItem>();
    var formerEmployeesList = ViewBag.FormerEmployees as List<SelectListItem> ?? new List<SelectListItem>();
    var selectedEmployeeId = ViewBag.FilterEmployeeId?.ToString() ?? string.Empty;
    var formerEmployees = ViewBag.FormerEmployeesFilter is bool formerValue && formerValue;
    var filterFromDate = ViewBag.FilterFromDate?.ToString() ?? string.Empty;
    var filterToDate = ViewBag.FilterToDate?.ToString() ?? string.Empty;

    var selectedActiveEmployee = !formerEmployees
        ? activeEmployees.FirstOrDefault(e => e.Value == selectedEmployeeId)
        : null;

    var selectedFormerEmployee = formerEmployees
        ? formerEmployeesList.FirstOrDefault(e => e.Value == selectedEmployeeId)
        : null;

    var selectedEmployeeText = selectedActiveEmployee == null ? "كل الموظفين" : selectedActiveEmployee.Text;
    var selectedEmployeeImage = selectedActiveEmployee?.Group?.Name ?? string.Empty;
    var selectedFormerEmployeeText = selectedFormerEmployee == null
        ? (formerEmployees && string.IsNullOrWhiteSpace(selectedEmployeeId) ? "كل الموظفين السابقين" : "اختار موظف سابق")
        : selectedFormerEmployee.Text;
    var selectedFormerEmployeeImage = selectedFormerEmployee?.Group?.Name ?? string.Empty;
    var dateRangeText = string.Empty;

    if (!string.IsNullOrWhiteSpace(filterFromDate) && !string.IsNullOrWhiteSpace(filterToDate))
    {
        dateRangeText = $"{filterFromDate} - {filterToDate}";
    }
    else if (!string.IsNullOrWhiteSpace(filterFromDate))
    {
        dateRangeText = filterFromDate;
    }
    else if (!string.IsNullOrWhiteSpace(filterToDate))
    {
        dateRangeText = filterToDate;
    }

    string FormatMoney(decimal? value)
    {
        return value.HasValue && value.Value > 0 ? value.Value.ToString("N0") : "-";
    }
}

<div class="employee-transactions-page" dir="rtl">

    <script id="employee-transactions-clear-filter-on-refresh-script">
            (function () {
                try {
                    var navigationEntry = performance && performance.getEntriesByType
                        ? performance.getEntriesByType('navigation')[0]
                        : null;

                    var isReload = navigationEntry
                        ? navigationEntry.type === 'reload'
                        : (performance && performance.navigation && performance.navigation.type === 1);

                    if (isReload && window.location.search) {
                        window.location.replace(window.location.pathname);
                    }
                } catch {
                    if (window.location.search) {
                        window.location.replace(window.location.pathname);
                    }
                }
            })();
    </script>

    <style>
