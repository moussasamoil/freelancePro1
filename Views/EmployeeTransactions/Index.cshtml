    <script type="text/javascript">
        (function () {
        const pageRoot = document.querySelector('.employee-transactions-page');
        const filterForm = document.getElementById('employeeTransactionsFilterForm');
        const pageInput = document.getElementById('pageInput');
        const pageSizeSelect = document.getElementById('pageSize');
        const employeeIdInput = document.getElementById('employeeIdInput');
        const formerEmployeesInput = document.getElementById('formerEmployeesInput');
        const formerEmployeesCheckbox = document.getElementById('formerEmployeesCheckbox');
        const dateInput = document.getElementById('custom-datepicker');
        const startInput = document.getElementById('startDate');
        const endInput = document.getElementById('endDate');
        let submitTimer = null;
        let isLoading = false;

        function parseDateRangeInput() {
        if (!dateInput || !startInput || !endInput) return;

        const value = (dateInput.value || '').trim();
        if (!value) {
        startInput.value = '';
        endInput.value = '';
        return;
        }

        const parts = value.split(' - ');
        if (parts.length >= 2) {
        startInput.value = parts[0].trim();
        endInput.value = parts[1].trim();
        } else if (parts.length === 1 && parts[0]) {
        startInput.value = parts[0].trim();
        endInput.value = parts[0].trim();
        }
        }

        function buildUrl(page) {
        parseDateRangeInput();

        const url = new URL('/EmployeeTransactions', window.location.origin);
        const pageSize = pageSizeSelect ? pageSizeSelect.value : '@Model.PageSize';
        const employeeId = employeeIdInput ? employeeIdInput.value : '';
        const formerEmployees = formerEmployeesInput ? formerEmployeesInput.value : 'false';
        const fromDate = startInput ? startInput.value : '';
        const toDate = endInput ? endInput.value : '';

        url.searchParams.set('page', page || 1);
        url.searchParams.set('pageSize', pageSize || 10);

        if (employeeId) url.searchParams.set('employeeId', employeeId);
        if (formerEmployees === 'true') url.searchParams.set('formerEmployees', 'true');
        if (fromDate) url.searchParams.set('fromDate', fromDate);
        if (toDate) url.searchParams.set('toDate', toDate);

        return url.toString();
        }

        function loadPage(page, pushState) {
        if (isLoading) return;
        isLoading = true;
        if (pageRoot) pageRoot.classList.add('is-loading');

        const url = buildUrl(page || 1);

        fetch(url, {
        method: 'GET',
        headers: { 'X-Requested-With': 'XMLHttpRequest' },
        cache: 'no-store',
        credentials: 'same-origin'
        })
        .then(response => response.text())
        .then(html => {
        const parser = new DOMParser();
        const doc = parser.parseFromString(html, 'text/html');

        const newTbody = doc.querySelector('#table tbody');
        const currentTbody = document.querySelector('#table tbody');
        if (newTbody && currentTbody) currentTbody.innerHTML = newTbody.innerHTML;

        const newPagination = doc.querySelector('#pagination-link');
        const currentPagination = document.querySelector('#pagination-link');
        if (newPagination && currentPagination) currentPagination.innerHTML = newPagination.innerHTML;

        const newCount = doc.querySelector('.employee-transactions-count');
        const currentCount = document.querySelector('.employee-transactions-count');
        if (newCount && currentCount) currentCount.innerHTML = newCount.innerHTML;

        const newTotal = doc.querySelector('.employee-transactions-total-card');
        const currentTotal = document.querySelector('.employee-transactions-total-card');
        if (newTotal && currentTotal) currentTotal.innerHTML = newTotal.innerHTML;

        if (pushState !== false) {
        window.history.pushState({}, '', url);
        }
        })
        .catch(() => {
        window.location.href = url;
        })
        .finally(() => {
        isLoading = false;
        if (pageRoot) pageRoot.classList.remove('is-loading');
        if (window.employeeTransactionsUpdateSelectionState) {
        window.employeeTransactionsUpdateSelectionState();
        }
        });
        }

        window.employeeTransactionsGetCurrentPage = function () {
        const activePage = document.querySelector('#pagination-link .page-item.active .page-link');
        const value = activePage ? parseInt(activePage.getAttribute('data-page') || activePage.textContent || '1', 10) : 1;
        return isNaN(value) || value <= 0 ? 1 : value;
        };

        window.employeeTransactionsRefreshTable = function (page, pushState) {
        const targetPage = page || window.employeeTransactionsGetCurrentPage();
        loadPage(targetPage, pushState === true);
        };

        function submitFilterDelayed() {
        if (submitTimer) clearTimeout(submitTimer);
        submitTimer = setTimeout(function () { loadPage(1, true); }, 80);
        }

        if (filterForm) {
        filterForm.addEventListener('submit', function (event) {
        event.preventDefault();
        loadPage(1, true);
        });
        }

        if (pageSizeSelect) {
        pageSizeSelect.addEventListener('change', function () {
        if (pageInput) pageInput.value = '1';
        submitFilterDelayed();
        });
        }

        if (formerEmployeesCheckbox) {
        formerEmployeesCheckbox.addEventListener('change', function () {
        if (formerEmployeesInput) formerEmployeesInput.value = formerEmployeesCheckbox.checked ? 'true' : 'false';
        if (employeeIdInput) employeeIdInput.value = '';
        window.location.href = buildUrl(1);
        });
        }

        document.addEventListener('click', function (event) {
        const pageLink = event.target.closest('#pagination-link .page-link[data-page]');
        if (pageLink) {
        event.preventDefault();
        const page = pageLink.getAttribute('data-page') || '1';
        loadPage(page, true);
        return;
        }

        const historyBtn = event.target.closest('.transaction-history-btn:not(a)');
        if (historyBtn) {
        event.preventDefault();
        document.getElementById('detailsEmployee').textContent = historyBtn.getAttribute('data-history-employee') || '-';
        document.getElementById('detailsType').textContent = historyBtn.getAttribute('data-history-type') || '-';
        document.getElementById('detailsAmount').textContent = (historyBtn.getAttribute('data-history-amount') || '-') + ' TRY';
        document.getElementById('detailsReason').textContent = historyBtn.getAttribute('data-history-reason') || '-';
        document.getElementById('detailsStart').textContent = historyBtn.getAttribute('data-history-start') || '-';
        document.getElementById('detailsEnd').textContent = historyBtn.getAttribute('data-history-end') || '-';
        document.getElementById('detailsDate').textContent = historyBtn.getAttribute('data-history-date') || '-';
        document.getElementById('transactionDetailsBackdrop').classList.add('is-visible');
        return;
        }

        if (event.target && (event.target.id === 'transactionDetailsClose' || event.target.id === 'transactionDetailsBackdrop')) {
        document.getElementById('transactionDetailsBackdrop').classList.remove('is-visible');
        }
        });

        function initializeDateFilter() {
        if (!dateInput) return;

        if (typeof initializeLitepicker === 'function') {
        initializeLitepicker('.custom-datepicker', function () {
        parseDateRangeInput();
        submitFilterDelayed();
        });
        return;
        }

        dateInput.addEventListener('change', function () {
        parseDateRangeInput();
        submitFilterDelayed();
        });
        }

        initializeDateFilter();
        })();
    </script>

    <script>
        (function () {
        const hiddenInput = document.getElementById('employeeIdInput');
        const formerInput = document.getElementById('formerEmployeesInput');

        function closeAllDropdowns() {
        document.querySelectorAll('.employee-custom-dropdown.open').forEach(function (dropdown) {
        dropdown.classList.remove('open');
        });
        }

        function buildEmployeeFilterUrl(value, isFormer) {
        const pageSize = document.getElementById('pageSize') ? document.getElementById('pageSize').value : '10';
        const startInput = document.getElementById('startDate');
        const endInput = document.getElementById('endDate');
        const dateInput = document.getElementById('custom-datepicker');

        if (dateInput && startInput && endInput) {
        const text = (dateInput.value || '').trim();
        if (!text) {
        startInput.value = '';
        endInput.value = '';
        } else {
        const parts = text.split(' - ');
        startInput.value = (parts[0] || '').trim();
        endInput.value = (parts[1] || parts[0] || '').trim();
        }
        }

        const url = new URL('/EmployeeTransactions', window.location.origin);
        url.searchParams.set('page', '1');
        url.searchParams.set('pageSize', pageSize || '10');

        if (value) url.searchParams.set('employeeId', value);
        if (isFormer) url.searchParams.set('formerEmployees', 'true');
        if (startInput && startInput.value) url.searchParams.set('fromDate', startInput.value);
        if (endInput && endInput.value) url.searchParams.set('toDate', endInput.value);

        return url.toString();
        }

        function updateDropdownVisual(dropdown, value, text, image) {
        const selectedText = dropdown.querySelector('.selected-employee-text');
        const selectedImage = dropdown.querySelector('.selected-employee-image');
        const selectedPlaceholder = dropdown.querySelector('.selected-employee-placeholder');
        const options = Array.from(dropdown.querySelectorAll('.employee-option'));

        if (selectedText) selectedText.textContent = text || 'كل الموظفين';

        if (image && selectedImage) {
        selectedImage.src = image;
        selectedImage.style.display = 'inline-block';
        if (selectedPlaceholder) selectedPlaceholder.style.display = 'none';
        } else {
        if (selectedImage) {
        selectedImage.removeAttribute('src');
        selectedImage.style.display = 'none';
        }
        if (selectedPlaceholder) selectedPlaceholder.style.display = 'inline-flex';
        }

        options.forEach(function (option) {
        option.classList.toggle('active', (option.getAttribute('data-value') || '') === (value || ''));
        });
        }

        document.querySelectorAll('.employee-custom-dropdown').forEach(function (dropdown) {
        const button = dropdown.querySelector('.selected-employee');
        const options = Array.from(dropdown.querySelectorAll('.employee-option'));
        if (!button) return;

        button.addEventListener('click', function (event) {
        event.preventDefault();
        event.stopPropagation();
        const wasOpen = dropdown.classList.contains('open');
        closeAllDropdowns();
        if (!wasOpen) dropdown.classList.add('open');
        });

        button.addEventListener('keydown', function (event) {
        if (event.key === 'Enter' || event.key === ' ') {
        event.preventDefault();
        const wasOpen = dropdown.classList.contains('open');
        closeAllDropdowns();
        if (!wasOpen) dropdown.classList.add('open');
        }
        });

        options.forEach(function (option) {
        option.addEventListener('click', function (event) {
        event.preventDefault();
        event.stopPropagation();

        const value = option.getAttribute('data-value') || '';
        const text = option.getAttribute('data-text') || '';
        const image = option.getAttribute('data-image') || '';
        const isFormer = option.getAttribute('data-former') === 'true';

        if (hiddenInput) hiddenInput.value = value;
        if (formerInput) formerInput.value = isFormer ? 'true' : 'false';

        updateDropdownVisual(dropdown, value, text, image);
        closeAllDropdowns();

        window.location.href = buildEmployeeFilterUrl(value, isFormer);
        });
        });
        });

        document.addEventListener('click', function (event) {
        if (!event.target.closest('.employee-custom-dropdown')) {
        closeAllDropdowns();
        }
        });
        })();
    </script>




    <script id="employee-transactions-history-trash-script">
        (function () {
        const historyButton = document.getElementById('openTransactionsEditHistory');
        const printStatementButton = document.getElementById('printTransactionsStatement');
        const trashButton = document.getElementById('openTransactionsTrash');
        const historyBackdrop = document.getElementById('transactionsHistoryBackdrop');
        const trashBackdrop = document.getElementById('transactionsTrashBackdrop');
        const historyList = document.getElementById('transactionsHistoryList');
        const trashList = document.getElementById('transactionsTrashList');
        const historyClose = document.getElementById('transactionsHistoryClose');
        const trashClose = document.getElementById('transactionsTrashClose');
        const restoreAllButton = document.getElementById('restoreAllTransactions');
        const deleteSelectedButton = document.getElementById('deleteSelectedTransactions');
        const selectedTransactionsCount = document.getElementById('selectedTransactionsCount');
        const deleteAllCurrentButton = document.getElementById('deleteAllCurrentTransactions');
        const deleteAllDeletedButton = document.getElementById('deleteAllDeletedPermanently');
        const bulkConfirmBackdrop = document.getElementById('transactionBulkConfirmBackdrop');
        const bulkConfirmTitle = document.getElementById('transactionBulkConfirmTitle');
        const bulkConfirmMessage = document.getElementById('transactionBulkConfirmMessage');
        const bulkConfirmCancel = document.getElementById('transactionBulkConfirmCancel');
        const bulkConfirmOk = document.getElementById('transactionBulkConfirmOk');
        const actionToast = document.getElementById('transactionActionToast');
        let pendingBulkAction = null;
        let isBulkActionRunning = false;

        function getToken() {
        const input = document.querySelector('#employeeTransactionPopupAntiForgery input[name="__RequestVerificationToken"]');
        return input ? input.value : '';
        }

        function escapeHtml(value) {
        return (value || '').toString()
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
        }

        function openBackdrop(backdrop) {
        if (backdrop) backdrop.classList.add('is-visible');
        }

        function closeBackdrop(backdrop) {
        if (backdrop) backdrop.classList.remove('is-visible');
        }

        function showActionToast(message, isError) {
        const cleanMessage = message || (isError ? 'حدث خطأ' : 'تم التحديث');
        if (window.employeeTransactionsShowMessage) {
        window.employeeTransactionsShowMessage(cleanMessage, isError === true, isError ? 'تنبيه' : cleanMessage);
        return;
        }
        console.warn(cleanMessage);
        }

        function buildCurrentFilterFormData() {
        const formData = new FormData();
        const employeeIdInput = document.getElementById('employeeIdInput');
        const formerEmployeesInput = document.getElementById('formerEmployeesInput');
        const startDateInput = document.getElementById('startDate');
        const endDateInput = document.getElementById('endDate');

        formData.append('__RequestVerificationToken', getToken());

        if (employeeIdInput && employeeIdInput.value) formData.append('employeeId', employeeIdInput.value);
        if (formerEmployeesInput && formerEmployeesInput.value === 'true') formData.append('formerEmployees', 'true');
        if (startDateInput && startDateInput.value) formData.append('fromDate', startDateInput.value);
        if (endDateInput && endDateInput.value) formData.append('toDate', endDateInput.value);

        return formData;
        }

        function getSelectedTransactionIds() {
        return Array.from(document.querySelectorAll('.transaction-select-circle:checked'))
        .map(function (input) { return input.getAttribute('data-transaction-id') || ''; })
        .filter(function (value) { return value !== ''; });
        }

        function updateSelectionState() {
        const checkboxes = Array.from(document.querySelectorAll('.transaction-select-circle'));
        const checkedBoxes = checkboxes.filter(function (input) { return input.checked; });
        const selectAll = document.getElementById('selectAllTransactions');

        checkboxes.forEach(function (input) {
        const row = input.closest('tr');
        if (row) row.classList.toggle('is-selected', input.checked);
        });

        if (selectAll) {
        selectAll.checked = checkboxes.length > 0 && checkedBoxes.length === checkboxes.length;
        selectAll.indeterminate = checkedBoxes.length > 0 && checkedBoxes.length < checkboxes.length;
        }

        if (selectedTransactionsCount) selectedTransactionsCount.textContent = '(' + checkedBoxes.length + ')';

        if (deleteSelectedButton) {
        deleteSelectedButton.classList.toggle('is-active', checkedBoxes.length > 0);
        deleteSelectedButton.disabled = checkedBoxes.length <= 0;
        }
        }

        window.employeeTransactionsUpdateSelectionState = updateSelectionState;

        function buildTransactionsStatementUrl(selectedIds) {
        const params = new URLSearchParams();
        params.set('ids', (selectedIds || []).join(','));

        const query = params.toString();
        return '/Pdf/PrintEmployeeTransactionsStatement?' + query;
        }

        function openBulkConfirm(title, message, action) {
        pendingBulkAction = action;
        if (bulkConfirmTitle) bulkConfirmTitle.textContent = title || 'هل أنت متأكد؟';
        if (bulkConfirmMessage) bulkConfirmMessage.textContent = message || 'سيتم تنفيذ العملية على كل الحركات.';
        if (bulkConfirmBackdrop) bulkConfirmBackdrop.classList.add('is-visible');
        }

        function closeBulkConfirm() {
        if (isBulkActionRunning) return;
        pendingBulkAction = null;
        if (bulkConfirmBackdrop) bulkConfirmBackdrop.classList.remove('is-visible');
        }

        async function runBulkConfirmAction() {
        if (!pendingBulkAction || isBulkActionRunning) return;

        isBulkActionRunning = true;
        if (bulkConfirmOk) {
        bulkConfirmOk.disabled = true;
        bulkConfirmOk.textContent = 'جاري التنفيذ...';
        }

        try {
        await pendingBulkAction();
        if (bulkConfirmBackdrop) bulkConfirmBackdrop.classList.remove('is-visible');
        pendingBulkAction = null;
        } finally {
        isBulkActionRunning = false;
        if (bulkConfirmOk) {
        bulkConfirmOk.disabled = false;
        bulkConfirmOk.textContent = 'تأكيد';
        }
        }
        }

        function renderHistory(items) {
        if (!historyList) return;

        if (!items || !items.length) {
        historyList.innerHTML = '<div class="transactions-list-empty">لا توجد تعديلات مسجلة حتى الآن</div>';
        return;
        }

        historyList.innerHTML = items.map(function (item) {
        const changes = (item.changes || []).map(function (change) {
        return '<div class="transaction-list-change">' +
        '<strong>' + escapeHtml(change.fieldName) + '</strong>: ' +
        '<span class="transaction-list-old">' + escapeHtml(change.oldValue) + '</span>' +
        ' ← ' +
        '<span class="transaction-list-new">' + escapeHtml(change.newValue) + '</span>' +
        '</div>';
        }).join('');

        return '<div class="transaction-list-item">' +
        '<div class="transaction-list-item-head">' +
        '<span>' + escapeHtml(item.employeeName) + '</span>' +
        '<span class="transaction-list-item-meta">بواسطة: ' + escapeHtml(item.changedBy) + ' - ' + escapeHtml(item.changedAt) + '</span>' +
        '</div>' + changes + '</div>';
        }).join('');
        }

        function renderTrash(items) {
        if (!trashList) return;

        if (!items || !items.length) {
        trashList.innerHTML = '<div class="transactions-list-empty">سلة المهملات فارغة</div>';
        if (restoreAllButton) restoreAllButton.style.display = 'none';
        return;
        }

        if (restoreAllButton) restoreAllButton.style.display = 'inline-flex';

        trashList.innerHTML = items.map(function (item) {
        return '<div class="transaction-list-item">' +
        '<div class="transaction-list-item-head">' +
        '<span>' + escapeHtml(item.employeeName) + ' - ' + escapeHtml(item.transactionType) + ' - ' + escapeHtml(item.amount) + '</span>' +
        '<button type="button" class="restore-one-transaction-btn" data-transaction-id="' + escapeHtml(item.id) + '">استرداد</button>' +
        '</div>' +
        '<div class="transaction-list-change"><strong>السبب:</strong> ' + escapeHtml(item.reason) + '</div>' +
        '<div class="transaction-list-change"><strong>تاريخ الحركة:</strong> ' + escapeHtml(item.transactionDate) + '</div>' +
        '<div class="transaction-list-change"><strong>تم الحذف:</strong> ' + escapeHtml(item.deletedAt) + ' بواسطة ' + escapeHtml(item.deletedBy) + '</div>' +
        '</div>';
        }).join('');
        }

        async function loadHistory() {
        if (historyList) historyList.innerHTML = '<div class="transactions-list-empty">جاري تحميل سجل التعديلات...</div>';
        openBackdrop(historyBackdrop);

        try {
        const response = await fetch('/EmployeeTransactions/GetTransactionsEditHistory', {
        method: 'GET',
        headers: { 'X-Requested-With': 'XMLHttpRequest' },
        cache: 'no-store',
        credentials: 'same-origin'
        });
        const result = await response.json();
        renderHistory(result && result.items ? result.items : []);
        } catch {
        if (historyList) historyList.innerHTML = '<div class="transactions-list-empty">تعذر تحميل سجل التعديلات</div>';
        }
        }

        async function loadTrash() {
        if (trashList) trashList.innerHTML = '<div class="transactions-list-empty">جاري تحميل سلة المهملات...</div>';
        openBackdrop(trashBackdrop);

        try {
        const response = await fetch('/EmployeeTransactions/GetDeletedTransactions', {
        method: 'GET',
        headers: { 'X-Requested-With': 'XMLHttpRequest' },
        cache: 'no-store',
        credentials: 'same-origin'
        });
        const result = await response.json();
        renderTrash(result && result.items ? result.items : []);
        } catch {
        if (trashList) trashList.innerHTML = '<div class="transactions-list-empty">تعذر تحميل سلة المهملات</div>';
        }
        }

        async function restoreOne(id) {
        if (!id) return;

        const formData = new FormData();
        formData.append('id', id);
        formData.append('__RequestVerificationToken', getToken());

        const response = await fetch('/EmployeeTransactions/RestoreDeleted', {
        method: 'POST',
        body: formData,
        credentials: 'same-origin'
        });

        const result = await response.json();
        if (!response.ok || !result || !result.success) {
        showActionToast(result && result.message ? result.message : 'تعذر استرداد الحركة', true);
        return;
        }

        showActionToast(result.message || 'تم الاسترداد');
        await loadTrash();
        if (window.employeeTransactionsRefreshTable) window.employeeTransactionsRefreshTable(null, false);
        }

        async function restoreAll() {
        const formData = new FormData();
        formData.append('__RequestVerificationToken', getToken());

        const response = await fetch('/EmployeeTransactions/RestoreAllDeleted', {
        method: 'POST',
        body: formData,
        credentials: 'same-origin'
        });

        const result = await response.json();
        if (!response.ok || !result || !result.success) {
        showActionToast(result && result.message ? result.message : 'تعذر استرداد كل الحركات', true);
        return;
        }

        showActionToast(result.message || 'تم استرداد الكل');
        await loadTrash();
        if (window.employeeTransactionsRefreshTable) window.employeeTransactionsRefreshTable(null, false);
        }

        async function deleteSelectedTransactionsRequest() {
        const ids = getSelectedTransactionIds();

        if (!ids.length) {
        showActionToast('اختار حركة واحدة على الأقل', true);
        return;
        }

        const formData = new FormData();
        formData.append('__RequestVerificationToken', getToken());
        formData.append('ids', ids.join(','));

        const response = await fetch('/EmployeeTransactions/DeleteSelected', {
        method: 'POST',
        body: formData,
        credentials: 'same-origin',
        headers: {
        'X-Requested-With': 'XMLHttpRequest',
        'Accept': 'application/json'
        }
        });

        const result = await response.json();
        if (!response.ok || !result || !result.success) {
        showActionToast(result && result.message ? result.message : 'تعذر حذف المحدد', true);
        return;
        }

        showActionToast(result.message || 'تم حذف المحدد');
        if (window.employeeTransactionsRefreshTable) window.employeeTransactionsRefreshTable(null, false);
        }

        async function deleteAllCurrentTransactions() {
        const response = await fetch('/EmployeeTransactions/DeleteAllActive', {
        method: 'POST',
        body: buildCurrentFilterFormData(),
        credentials: 'same-origin',
        headers: {
        'X-Requested-With': 'XMLHttpRequest',
        'Accept': 'application/json'
        }
        });

        const result = await response.json();
        if (!response.ok || !result || !result.success) {
        showActionToast(result && result.message ? result.message : 'تعذر حذف الجميع', true);
        return;
        }

        showActionToast(result.message || 'تم حذف الجميع');
        if (window.employeeTransactionsRefreshTable) window.employeeTransactionsRefreshTable(1, false);
        }

        async function deleteAllDeletedPermanently() {
        const formData = new FormData();
        formData.append('__RequestVerificationToken', getToken());

        const response = await fetch('/EmployeeTransactions/DeleteAllDeletedPermanently', {
        method: 'POST',
        body: formData,
        credentials: 'same-origin',
        headers: {
        'X-Requested-With': 'XMLHttpRequest',
        'Accept': 'application/json'
        }
        });

        const result = await response.json();
        if (!response.ok || !result || !result.success) {
        showActionToast(result && result.message ? result.message : 'تعذر حذف كل المحذوف', true);
        return;
        }

        showActionToast(result.message || 'تم حذف كل المحذوف');
        await loadTrash();
        if (window.employeeTransactionsRefreshTable) window.employeeTransactionsRefreshTable(null, false);
        }

        if (historyButton) historyButton.addEventListener('click', loadHistory);
        if (printStatementButton) {
        printStatementButton.addEventListener('click', function () {
        const selectedIds = getSelectedTransactionIds();
        if (!selectedIds.length) {
        showActionToast('لازم تحدد حركة واحدة على الأقل', true);
        return;
        }

        window.open(buildTransactionsStatementUrl(selectedIds), '_blank');
        });
        }
        if (trashButton) trashButton.addEventListener('click', loadTrash);

        document.addEventListener('change', function (event) {
        const rowCheckbox = event.target.closest('.transaction-select-circle');
        if (rowCheckbox) {
        updateSelectionState();
        return;
        }

        const selectAll = event.target.closest('#selectAllTransactions');
        if (selectAll) {
        document.querySelectorAll('.transaction-select-circle').forEach(function (input) {
        input.checked = selectAll.checked;
        });
        updateSelectionState();
        }
        });

        if (deleteSelectedButton) {
        deleteSelectedButton.addEventListener('click', function () {
        const ids = getSelectedTransactionIds();
        if (!ids.length) {
        showActionToast('اختار حركة واحدة على الأقل', true);
        return;
        }
        openBulkConfirm('هل أنت متأكد من حذف المحدد؟', 'سيتم نقل ' + ids.length + ' حركة محددة إلى سلة المهملات.', deleteSelectedTransactionsRequest);
        });
        }

        if (deleteAllCurrentButton) {
        deleteAllCurrentButton.addEventListener('click', function () {
        openBulkConfirm('هل أنت متأكد من حذف الجميع؟', 'سيتم نقل كل الحركات المطابقة للفلتر الحالي إلى سلة المهملات.', deleteAllCurrentTransactions);
        });
        }

        if (deleteAllDeletedButton) {
        deleteAllDeletedButton.addEventListener('click', function () {
        openBulkConfirm('هل أنت متأكد من حذف كل المحذوف؟', 'سيتم حذف كل الحركات الموجودة في سلة المهملات نهائيًا ولا يمكن استردادها.', deleteAllDeletedPermanently);
        });
        }

        if (bulkConfirmCancel) bulkConfirmCancel.addEventListener('click', closeBulkConfirm);
        if (bulkConfirmOk) bulkConfirmOk.addEventListener('click', runBulkConfirmAction);
        if (bulkConfirmBackdrop) {
        bulkConfirmBackdrop.addEventListener('click', function (event) {
        if (event.target === bulkConfirmBackdrop) closeBulkConfirm();
        });
        }

        if (historyClose) historyClose.addEventListener('click', function () { closeBackdrop(historyBackdrop); });
        if (trashClose) trashClose.addEventListener('click', function () { closeBackdrop(trashBackdrop); });
        if (historyBackdrop) historyBackdrop.addEventListener('click', function (event) { if (event.target === historyBackdrop) closeBackdrop(historyBackdrop); });
        if (trashBackdrop) trashBackdrop.addEventListener('click', function (event) { if (event.target === trashBackdrop) closeBackdrop(trashBackdrop); });
        if (restoreAllButton) restoreAllButton.addEventListener('click', restoreAll);

        updateSelectionState();

        document.addEventListener('click', function (event) {
        const restoreButton = event.target.closest('.restore-one-transaction-btn');
        if (!restoreButton) return;
        event.preventDefault();
        restoreOne(restoreButton.getAttribute('data-transaction-id'));
        });
        })();
    </script>

    <script id="employee-transaction-delete-popup-script">
        (function () {
        const backdrop = document.getElementById('transactionDeleteConfirmBackdrop');
        const cancelBtn = document.getElementById('transactionDeleteCancel');
        const confirmBtn = document.getElementById('transactionDeleteConfirm');
        const toast = document.getElementById('transactionActionToast');
        let pendingDeleteId = '';
        let pendingDeleteUrl = '';
        let isDeleting = false;

        function getToken() {
        const input = document.querySelector('#employeeTransactionPopupAntiForgery input[name="__RequestVerificationToken"]');
        return input ? input.value : '';
        }

        function showToast(message, isError) {
        const cleanMessage = message || (isError ? 'حدث خطأ' : 'تم الحذف');
        if (window.employeeTransactionsShowMessage) {
        window.employeeTransactionsShowMessage(cleanMessage, isError === true, isError ? 'تنبيه' : cleanMessage);
        return;
        }
        console.warn(cleanMessage);
        }

        function openDeletePopup(id, url) {
        pendingDeleteId = id || '';
        pendingDeleteUrl = url || '';
        if (backdrop) backdrop.classList.add('is-visible');
        }

        function closeDeletePopup() {
        if (isDeleting) return;
        pendingDeleteId = '';
        pendingDeleteUrl = '';
        if (backdrop) backdrop.classList.remove('is-visible');
        }

        async function confirmDelete() {
        if (!pendingDeleteId || isDeleting) return;
        isDeleting = true;
        if (confirmBtn) {
        confirmBtn.disabled = true;
        confirmBtn.textContent = 'جاري الحذف...';
        }

        try {
        const formData = new FormData();
        formData.append('__RequestVerificationToken', getToken());

        const response = await fetch(pendingDeleteUrl || ('/EmployeeTransactions/Delete/' + encodeURIComponent(pendingDeleteId)), {
        method: 'POST',
        body: formData,
        credentials: 'same-origin',
        headers: {
        'X-Requested-With': 'XMLHttpRequest',
        'Accept': 'application/json'
        }
        });

        const text = await response.text();
        let result = null;
        try { result = text ? JSON.parse(text) : null; } catch { result = null; }

        if (!response.ok || !result || result.success === false) {
        showToast(result && result.message ? result.message : 'تعذر حذف الحركة', true);
        return;
        }

        if (backdrop) backdrop.classList.remove('is-visible');
        pendingDeleteId = '';
        pendingDeleteUrl = '';
        showToast(result.message || 'تم الحذف');
        if (window.employeeTransactionsRefreshTable) window.employeeTransactionsRefreshTable(null, false);
        } catch {
        showToast('حدث خطأ أثناء الحذف', true);
        } finally {
        isDeleting = false;
        if (confirmBtn) {
        confirmBtn.disabled = false;
        confirmBtn.textContent = 'تأكيد';
        }
        }
        }

        document.addEventListener('click', function (event) {
        const deleteButton = event.target.closest('.transaction-delete-popup-btn');
        if (!deleteButton) return;
        event.preventDefault();
        openDeletePopup(deleteButton.getAttribute('data-transaction-id'), deleteButton.getAttribute('data-delete-action'));
        });

        if (cancelBtn) cancelBtn.addEventListener('click', closeDeletePopup);
        if (confirmBtn) confirmBtn.addEventListener('click', confirmDelete);
        if (backdrop) {
        backdrop.addEventListener('click', function (event) {
        if (event.target === backdrop) closeDeletePopup();
        });
        }
        })();
    </script>

    <script id="employee-transaction-popup-edit-script">
        (function () {
        const editBackdrop = document.getElementById('transactionEditBackdrop');
        const editClose = document.getElementById('transactionEditClose');
        const cancelBtn = document.getElementById('transactionEditCancel');
        const saveBtn = document.getElementById('transactionEditSave');
        const successBackdrop = document.getElementById('transactionEditSuccessBackdrop');
        const successOk = document.getElementById('transactionEditSuccessOk');
        const historyToggle = document.getElementById('transactionEditHistoryToggle');
        const historyBlock = document.getElementById('transactionEditHistoryBlock');
        const historyList = document.getElementById('transactionEditHistoryList');
        const historyCount = document.getElementById('transactionEditHistoryCount');
        const errorBox = document.getElementById('transactionEditError');

        const idInput = document.getElementById('transactionEditId');
        const employeeNameInput = document.getElementById('transactionEditEmployeeName');
        const deductionInput = document.getElementById('transactionEditDeductionAmount');
        const advanceInput = document.getElementById('transactionEditAdvanceAmount');
        const bonusInput = document.getElementById('transactionEditBonusAmount');
        const dateInput = document.getElementById('transactionEditDate');
        const reasonInput = document.getElementById('transactionEditReason');
        const shiftStartDisplay = document.getElementById('transactionEditShiftStart');
        const shiftEndDisplay = document.getElementById('transactionEditShiftEnd');

        let shouldReloadAfterSuccess = false;
        let lastAmountEditedType = '';

        function parsePopupAmount(value) {
        const text = (value || '').toString().replace(',', '.').trim();
        const number = parseFloat(text);
        return isNaN(number) || number < 0 ? 0 : number;
        }

        function markLastAmountEdited(type) {
        lastAmountEditedType = type || '';
        }

        function getPopupAmountsForSave() {
        let deductionAmount = parsePopupAmount(deductionInput ? deductionInput.value : '0');
        let advanceAmount = parsePopupAmount(advanceInput ? advanceInput.value : '0');
        let bonusAmount = parsePopupAmount(bonusInput ? bonusInput.value : '0');

        // مهم: لا نمسح القيم من الشاشة أثناء الكتابة.
        // لو المستخدم كتب في خانة جديدة، نرسل الخانة الأخيرة فقط للسيرفر حتى تتغير نوع الحركة بدون ما تصفر الخانات قدامه.
        if (lastAmountEditedType === 'deduction') {
        advanceAmount = 0;
        bonusAmount = 0;
        } else if (lastAmountEditedType === 'advance') {
        deductionAmount = 0;
        bonusAmount = 0;
        } else if (lastAmountEditedType === 'bonus') {
        deductionAmount = 0;
        advanceAmount = 0;
        }

        return { deductionAmount, advanceAmount, bonusAmount };
        }

        function getToken() {
        const input = document.querySelector('#employeeTransactionPopupAntiForgery input[name="__RequestVerificationToken"]');
        return input ? input.value : '';
        }

        function showEditError(message) {
        if (errorBox) {
        errorBox.textContent = '';
        errorBox.style.display = 'none';
        }

        if (message && window.employeeTransactionsShowMessage) {
        window.employeeTransactionsShowMessage(message, true, 'تنبيه');
        }
        }

        function closeEditPopup() {
        if (editBackdrop) editBackdrop.classList.remove('is-visible');
        showEditError('');
        }

        function openEditPopup() {
        if (editBackdrop) editBackdrop.classList.add('is-visible');
        }

        function setLoading(isLoading) {
        if (!saveBtn) return;
        saveBtn.disabled = isLoading;
        saveBtn.innerText = isLoading ? 'جاري الحفظ...' : 'موافقة';
        }

        [
        { input: deductionInput, type: 'deduction' },
        { input: advanceInput, type: 'advance' },
        { input: bonusInput, type: 'bonus' }
        ].forEach(function (item) {
        if (!item.input) return;
        item.input.addEventListener('input', function () {
        markLastAmountEdited(item.type);
        });
        });

        function fillEditPopup(data) {
        idInput.value = data.id || '';
        employeeNameInput.value = data.employeeName || '';
        deductionInput.value = data.deductionAmount || '0.00';
        advanceInput.value = data.advanceAmount || '0.00';
        bonusInput.value = data.bonusAmount || '0.00';
        dateInput.value = data.transactionDateOnly || '';
        reasonInput.value = data.reason || '';
        shiftStartDisplay.textContent = data.shiftStartTimeText || '-';
        shiftEndDisplay.textContent = data.shiftEndTimeText || '-';
        lastAmountEditedType = '';

        if (historyList) {
        historyList.innerHTML =
        '<div>نوع العملية: ' + (data.transactionTypeText || '-') + '</div>' +
        '<div>المبلغ الحالي: ' + (data.amountText || '-') + '</div>' +
        '<div>تاريخ الحركة الحالي: ' + (data.transactionDate || '-') + '</div>';
        }
        if (historyCount) historyCount.textContent = '1';
        if (historyBlock) historyBlock.classList.remove('is-visible');
        if (historyToggle) historyToggle.classList.remove('is-active');
        }

        document.addEventListener('click', async function (event) {
        const editButton = event.target.closest('.transaction-edit-popup-btn');
        if (!editButton) return;

        event.preventDefault();
        const transactionId = editButton.getAttribute('data-transaction-id');
        if (!transactionId) {
        showEditError('لم يتم العثور على رقم الحركة');
        return;
        }

        try {
        const response = await fetch('/EmployeeTransactions/GetTransactionForEdit?id=' + encodeURIComponent(transactionId), {
        method: 'GET',
        headers: { 'X-Requested-With': 'XMLHttpRequest' },
        cache: 'no-store',
        credentials: 'same-origin'
        });

        const result = await response.json();
        if (!response.ok || !result || !result.success) {
        if (window.employeeTransactionsShowMessage) window.employeeTransactionsShowMessage(result && result.message ? result.message : 'تعذر تحميل بيانات الحركة', true, 'تنبيه');
        return;
        }

        fillEditPopup(result.data);
        openEditPopup();
        } catch (error) {
        if (window.employeeTransactionsShowMessage) window.employeeTransactionsShowMessage('حدث خطأ أثناء فتح التعديل', true, 'تنبيه');
        }
        });

        if (saveBtn) {
        saveBtn.addEventListener('click', async function () {
        showEditError('');

        const popupAmounts = getPopupAmountsForSave();
        const payload = {
        id: parseInt(idInput.value || '0', 10),
        deductionAmount: popupAmounts.deductionAmount,
        advanceAmount: popupAmounts.advanceAmount,
        bonusAmount: popupAmounts.bonusAmount,
        reason: reasonInput.value || '',
        transactionDate: dateInput.value || ''
        };

        if (!payload.id) {
        showEditError('لم يتم العثور على رقم الحركة');
        return;
        }

        const positiveAmounts = [payload.deductionAmount, payload.advanceAmount, payload.bonusAmount]
        .filter(function (value) { return value && value > 0; }).length;

        if (positiveAmounts === 0) {
        showEditError('يجب إدخال مبلغ في الخصم أو السلفة أو المكافأة');
        return;
        }

        if (positiveAmounts > 1) {
        showEditError('اختار نوع واحد فقط: خصم أو سلفة أو مكافأة');
        return;
        }

        if (!payload.transactionDate) {
        showEditError('يجب اختيار تاريخ الحركة');
        return;
        }

        setLoading(true);

        try {
        const response = await fetch('/EmployeeTransactions/UpdateTransactionFromPopup', {
        method: 'POST',
        headers: {
        'Content-Type': 'application/json',
        'RequestVerificationToken': getToken()
        },
        body: JSON.stringify(payload),
        credentials: 'same-origin'
        });

        const responseText = await response.text();
        let result = null;
        try { result = responseText ? JSON.parse(responseText) : null; } catch { result = null; }

        if (response.ok && result && result.success) {
        closeEditPopup();
        shouldReloadAfterSuccess = false;
        if (window.employeeTransactionsRefreshTable) window.employeeTransactionsRefreshTable(null, false);
        if (successBackdrop) successBackdrop.classList.add('is-visible');
        return;
        }

        showEditError(result && result.message ? result.message : 'تعذر حفظ التعديل');
        } catch (error) {
        showEditError('حدث خطأ أثناء حفظ التعديل');
        } finally {
        setLoading(false);
        }
        });
        }

        if (editClose) editClose.addEventListener('click', closeEditPopup);
        if (cancelBtn) cancelBtn.addEventListener('click', closeEditPopup);
        if (editBackdrop) {
        editBackdrop.addEventListener('click', function (event) {
        if (event.target === editBackdrop) closeEditPopup();
        });
        }

        if (historyToggle) {
        historyToggle.addEventListener('click', function () {
        if (!historyBlock) return;
        const isVisible = historyBlock.classList.toggle('is-visible');
        historyToggle.classList.toggle('is-active', isVisible);
        });
        }

        if (successOk) {
        successOk.addEventListener('click', function () {
        if (successBackdrop) successBackdrop.classList.remove('is-visible');
        if (shouldReloadAfterSuccess && window.employeeTransactionsRefreshTable) {
        window.employeeTransactionsRefreshTable(null, false);
        }
        });
        }
        })();
    </script>

</div>




