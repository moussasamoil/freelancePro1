    <div id="pagination-link" class="mt-0 mb-2 container-fluid">
        <div class="d-flex justify-content-center align-items-center flex-wrap">
            <p class="text-start pt-0 text-nowrap pt-lg-0 d-inline total-items-display" style="display:none !important;">
                @Model.PaginationViewModel.TotalItems
                <span class="d-none d-md-inline">عدد الطلبات</span>
            </p>

            <nav aria-label="Page navigation" class="mx-auto mt-2 mt-lg-0 nav-nav home-pagination-nav">
                @{
                    int currentPage = Model.PaginationViewModel.CurrentPage;
                    int totalPages = Model.PaginationViewModel.TotalPages;

                    if (currentPage < 1)
                    {
                        currentPage = 1;
                    }

                    if (totalPages < 1)
                    {
                        totalPages = 1;
                    }

                    if (currentPage > totalPages)
                    {
                        currentPage = totalPages;
                    }

                    int previousPage = currentPage > 1 ? currentPage - 1 : 1;
                    int nextPage = currentPage < totalPages ? currentPage + 1 : totalPages;
                    var pagesToShow = new System.Collections.Generic.SortedSet<int>();

                    if (totalPages <= 7)
                    {
                        for (int i = 1; i <= totalPages; i++)
                        {
                            pagesToShow.Add(i);
                        }
                    }
                    else
                    {
                        int windowStart;
                        int windowEnd;

                        if (currentPage <= 2)
                        {
                            windowStart = 1;
                            windowEnd = 3;
                        }
                        else if (currentPage >= totalPages - 1)
                        {
                            windowStart = totalPages - 2;
                            windowEnd = totalPages;
                        }
                        else
                        {
                            windowStart = currentPage - 1;
                            windowEnd = currentPage + 1;
                        }

                        for (int i = Math.Max(1, windowStart); i <= Math.Min(totalPages, windowEnd); i++)
                        {
                            pagesToShow.Add(i);
                        }

                        if (currentPage >= totalPages - 1)
                        {
                            for (int i = 1; i <= Math.Min(3, totalPages); i++)
                            {
                                pagesToShow.Add(i);
                            }
                        }
                        else
                        {
                            for (int i = Math.Max(1, totalPages - 2); i <= totalPages; i++)
                            {
                                pagesToShow.Add(i);
                            }
                        }
                    }

                    int lastRenderedPage = 0;
                }

                <div class="home-pagination-shell">
                    <ul class="pagination home-pagination mb-0 p-0">
                        <li class="page-item home-pagination-arrow home-pagination-first @(currentPage == 1 ? "disabled" : "")">
                            <a href="#" class="page-link pointer" data-page="1" title="أول صفحة" aria-label="أول صفحة">
                                <svg class="pagination-arrow-svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                    <path d="M13 6 L19 12 L13 18"></path>
                                    <path d="M5 6 L11 12 L5 18"></path>
                                </svg>
                            </a>
                        </li>

                        <li class="page-item home-pagination-arrow home-pagination-prev @(currentPage == 1 ? "disabled" : "")">
                            <a href="#" class="page-link" data-page="@previousPage" title="الصفحة السابقة" aria-label="الصفحة السابقة">
                                <svg class="pagination-arrow-svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                    <path d="M9 6 L15 12 L9 18"></path>
                                </svg>
                            </a>
                        </li>

                        @foreach (var pageNumber in pagesToShow)
                        {
                            if (lastRenderedPage > 0 && pageNumber - lastRenderedPage > 1)
                            {
                                <li class="page-item home-pagination-ellipsis pagination-ellipsis disabled">
                                    <span class="page-link">...</span>
                                </li>
                            }

                            <li class="page-item home-pagination-number @(currentPage == pageNumber ? "active" : "")">
                                <a href="#" class="page-link" data-page="@pageNumber">@pageNumber</a>
                            </li>

                            lastRenderedPage = pageNumber;
                        }

                        <li class="page-item home-pagination-arrow home-pagination-next @(currentPage == totalPages ? "disabled" : "")">
                            <a href="#" class="page-link" data-page="@nextPage" title="الصفحة التالية" aria-label="الصفحة التالية">
                                <svg class="pagination-arrow-svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                    <path d="M15 6 L9 12 L15 18"></path>
                                </svg>
                            </a>
                        </li>

                        <li class="page-item home-pagination-arrow home-pagination-last @(currentPage == totalPages ? "disabled" : "")">
                            <a href="#" class="page-link" data-page="@totalPages" title="آخر صفحة" aria-label="آخر صفحة">
                                <svg class="pagination-arrow-svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                    <path d="M11 6 L5 12 L11 18"></path>
                                    <path d="M19 6 L13 12 L19 18"></path>
                                </svg>
                            </a>
                        </li>
                    </ul>
                </div>
            </nav>
        </div>
    </div>
</div>

<script>

    // ============================================================
    // Server-side temporary selections
    // No localStorage/sessionStorage is used here because more than one employee/device may be working.
    // ============================================================
    var pendingFailureReasons = {};
    var pendingDeliveredOrderIds = [];
    var serverSelectionsLoaded = false;
    var originalDeliveryCounter = parseInt($('#remainingDeliveryCounter').data('original-count') || '0') || 0;

    function getPendingFailureReasons() {
    return pendingFailureReasons || {};
    }

    function getPendingDeliveredOrderIds() {
    return (pendingDeliveredOrderIds || []).map(String);
    }

    function setPendingDeliveredOrderIds(ids) {
    pendingDeliveredOrderIds = (ids || []).map(String).filter(function (id, index, arr) {
    return id && arr.indexOf(id) === index;
    });
    }

    function addPendingDeliveredOrder(orderId) {
    orderId = String(orderId || '');
    if (!orderId) return;
    var ids = getPendingDeliveredOrderIds();
    if (ids.indexOf(orderId) === -1) ids.push(orderId);
    setPendingDeliveredOrderIds(ids);
    delete pendingFailureReasons[orderId];
    }

    function removePendingDeliveredOrder(orderId) {
    orderId = String(orderId || '');
    if (!orderId) return;
    setPendingDeliveredOrderIds(getPendingDeliveredOrderIds().filter(function (id) { return id !== orderId; }));
    }

    function getSelectedOrderIds() {
    return getPendingDeliveredOrderIds();
    }

    function saveServerSelection(orderId, targetStatus, failureReason, onSuccess, onError) {
    $.ajax({
    url: '/Order/SaveStatusUpdateSelection',
    type: 'POST',
    data: {
    orderId: orderId,
    targetStatus: targetStatus,
    failureReason: failureReason || ''
    },
    success: function (result) {
    if (result && result.success) {
    if (typeof onSuccess === 'function') onSuccess(result);
    } else {
    showStatusUpdateToast((result && result.message) || 'فشل حفظ التحديد المؤقت', '#dc2626');
    if (typeof onError === 'function') onError(result);
    }
    },
    error: function () {
    showStatusUpdateToast('حدث خطأ أثناء حفظ التحديد المؤقت', '#dc2626');
    if (typeof onError === 'function') onError();
    }
    });
    }

    function clearServerSelection(orderId, onSuccess) {
    $.ajax({
    url: '/Order/ClearStatusUpdateSelection',
    type: 'POST',
    data: { orderId: orderId },
    success: function (result) {
    if (result && result.success) {
    if (typeof onSuccess === 'function') onSuccess(result);
    } else {
    showStatusUpdateToast((result && result.message) || 'فشل إلغاء التحديد', '#dc2626');
    }
    },
    error: function () {
    showStatusUpdateToast('حدث خطأ أثناء إلغاء التحديد', '#dc2626');
    }
    });
    }

    function applyServerSelections(selections) {
    pendingFailureReasons = {};
    pendingDeliveredOrderIds = [];

    (selections || []).forEach(function (item) {
    var orderId = String(item.orderId || item.OrderId || '');
    var targetStatus = String(item.targetStatus || item.TargetStatus || '');
    var failureReason = String(item.failureReason || item.FailureReason || '').trim();
    if (!orderId) return;

    if (targetStatus === 'تم_التسليم') {
    addPendingDeliveredOrder(orderId);
    } else if (targetStatus === 'فشل_التسليم') {
    pendingFailureReasons[orderId] = failureReason || 'فشل التسليم';
    } else if (targetStatus === 'الطلبات_المعلقة') {
    pendingFailureReasons[orderId] = 'الطلبات المعلقة';
    }
    });

    serverSelectionsLoaded = true;
    }

    function loadServerSelections(callback) {
    $.ajax({
    url: '/Order/GetStatusUpdateSelections',
    type: 'GET',
    cache: false,
    success: function (result) {
    if (result && result.success) {
    applyServerSelections(result.selections || []);
    }
    },
    complete: function () {
    if (typeof callback === 'function') callback();
    }
    });
    }

    function showStatusUpdateToast(message, color) {
    var toast = document.createElement('div');
    toast.className = 'status-center-toast';
    toast.textContent = message || '';
    toast.style.background = color || '#18a088';
    document.body.appendChild(toast);

    requestAnimationFrame(function () {
    toast.classList.add('is-visible');
    });

    setTimeout(function () {
    toast.classList.remove('is-visible');
    setTimeout(function () {
    if (toast && toast.parentNode) toast.parentNode.removeChild(toast);
    }, 220);
    }, 2300);
    }

    function escapeHtml(value) {
    return String(value == null ? '' : value)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#039;');
    }

    function updateVisibleRowsCounter() {
    var visibleCount = $('tr.order-row:visible').length;
    $('#ordersTotalCounterTop .orders-total-counter-number').text(visibleCount);
    originalDeliveryCounter = visibleCount;
    $('#remainingDeliveryCounter').text(visibleCount).attr('data-original-count', visibleCount);
    }

    function applyCrossPagePendingVisibility() {
    var failureMap = getPendingFailureReasons();

    $('tr.order-row').each(function () {
    var $row = $(this);
    var id = String($row.data('order-id') || '');
    var shouldHide = !!failureMap[id];
    $row.toggle(!shouldHide);
    if (shouldHide) {
    removePendingDeliveredOrder(id);
    $row.find('input[name="selectedOrders"]').prop('checked', false);
    $row.removeClass('delivered-selected');
    }
    });

    updateVisibleRowsCounter();
    }

    function restoreDeliveredSelectionUI() {
    var ids = getPendingDeliveredOrderIds();

    $('tr.order-row').removeClass('delivered-selected');
    $('input[name="selectedOrders"]').prop('checked', false);

    ids.forEach(function (id) {
    var $row = $('tr.order-row[data-order-id="' + id + '"]');
    if ($row.length && $row.is(':visible')) {
    $row.addClass('delivered-selected');
    $row.find('input[name="selectedOrders"]').prop('checked', true);
    }
    });

    updateDeliveredActionState();
    }

    function updateDeliveredActionState() {
    var ids = getSelectedOrderIds();
    $('#updateToDeliveredBtn').toggleClass('is-ready', ids.length > 0);
    $('.selected-count-label').text('(' + ids.length + ')');
    $('#selectedLiveCounter').text(ids.length);
    $('#remainingDeliveryCounter').text(Math.max(originalDeliveryCounter - ids.length, 0));
    }

    function markDelivered(orderId) {
    orderId = String(orderId || '');
    if (!orderId) return;

    // تحديث الواجهة فورًا قبل رد السيرفر عشان الزرار يبان شغال والصف يبقى أخضر حالًا.
    addPendingDeliveredOrder(orderId);
    var $row = $('tr.order-row[data-order-id="' + orderId + '"]');
    $row.addClass('delivered-selected');
    $row.find('input[name="selectedOrders"]').prop('checked', true);
    updateDeliveredActionState();

    saveServerSelection(orderId, 'تم_التسليم', '', function () {
    showStatusUpdateToast('تم تحديد الطلب للتسليم مؤقتًا', '#16a34a');
    }, function () {
    removePendingDeliveredOrder(orderId);
    $row.removeClass('delivered-selected');
    $row.find('input[name="selectedOrders"]').prop('checked', false);
    updateDeliveredActionState();
    });
    }

    function cancelDelivered(orderId) {
    orderId = String(orderId || '');
    if (!orderId) return;

    clearServerSelection(orderId, function () {
    removePendingDeliveredOrder(orderId);
    var $row = $('tr.order-row[data-order-id="' + orderId + '"]');
    $row.removeClass('delivered-selected');
    $row.find('input[name="selectedOrders"]').prop('checked', false);
    $('#selectAll').prop('checked', false);
    updateDeliveredActionState();
    showStatusUpdateToast('تم إلغاء تحديد الطلب', '#64748b');
    });
    }

    window.markDeliveredFromInline = function (event, orderId) {
    if (event) { event.preventDefault(); event.stopPropagation(); }
    markDelivered(String(orderId || ''));
    return false;
    };

    window.cancelDeliveredFromInline = function (event, orderId) {
    if (event) { event.preventDefault(); event.stopPropagation(); }
    cancelDelivered(String(orderId || ''));
    return false;
    };

    window.submitDeliveredButtonClick = function (event, targetStatus, statusText) {
    if (event) { event.preventDefault(); event.stopPropagation(); }
    submitSelectedStatus(targetStatus, statusText);
    return false;
    };

    function updateTopTotalCounterFromResult($result) {
    var totalFromResult = $result.find('#ordersTotalCounterTop .orders-total-counter-number').text().trim();

    if (!totalFromResult) {
    var bottomText = $result.find('.total-items-display').first().text().trim();
    var match = bottomText.match(/\d+/);
    totalFromResult = match ? match[0] : '';
    }

    if (totalFromResult) {
    $('#ordersTotalCounterTop .orders-total-counter-number').text(totalFromResult);
    originalDeliveryCounter = parseInt(totalFromResult || '0') || 0;
    $('#remainingDeliveryCounter').attr('data-original-count', originalDeliveryCounter);
    }
    }

    function updateRepresentativeVisibility() {
    var $rep = $('#DeliveryRepresentativeId');
    if (!$rep.length) return;

    var hasRealOptions = $rep.find('option').filter(function () {
    var v = $(this).val();
    return v !== undefined && v !== null && String(v).trim() !== '' && String(v).trim() !== '-1';
    }).length > 0;

    $('#deliveryRepresentativeFilterCol').toggle(hasRealOptions);
    }

    function loadStatusUpdatePage(page) {
    var data = {
    page: page || 1,
    pageSize: $('#pageSize').val(),
    countryId: $('#CountryId').val(),
    storeId: $('#ManufacturingCompanyId').val(),
    deliverycompanyId: $('#DeliveryCompanyId').val(),
    deliveryrepresentativeId: $('#DeliveryRepresentativeId').val()
    };

    $.ajax({
    url: '/Order/UpdateDelivered',
    type: 'GET',
    data: data,
    success: function (result) {
    var $result = $('<div>').html(result);

    $('#ordersTable').replaceWith($result.find('#ordersTable'));
    if (window.applyStatusUpdateCurrentPageSearch) window.applyStatusUpdateCurrentPageSearch();
    $('#pagination-link').replaceWith($result.find('#pagination-link'));
    $('.total-items-display').text($result.find('.total-items-display').text());

    updateTopTotalCounterFromResult($result);
    loadServerSelections(function () {
    applyCrossPagePendingVisibility();
    restoreDeliveredSelectionUI();
    updateRepresentativeVisibility();
    hideAllProductsTooltips();
    });
    }
    });
    }

    function submitSelectedStatus(targetStatus, statusText) {
    var ids = getSelectedOrderIds();

    if (ids.length === 0) {
    showStatusUpdateToast('اختاري طلب واحد على الأقل', '#dc2626');
    return;
    }

    $('#loadingIndicator').show();

    $.ajax({
    url: '/Order/UpdateStatusForMultiple',
    type: 'POST',
    data: {
    ids: ids,
    orderStatus: targetStatus
    },
    success: function (result) {
    if (result && result.success) {
    if (typeof window.showStatusDonePopup === 'function') { window.showStatusDonePopup(statusText, ids.length); } else { showStatusUpdateToast('تم تحديث الطلبات إلى ' + statusText, '#16a34a'); }
    ids.forEach(function (id) {
    removePendingDeliveredOrder(id);
    $('tr.order-row[data-order-id="' + id + '"]').fadeOut(180, function () {
    $(this).remove();
    updateVisibleRowsCounter();
    updateDeliveredActionState();
    });
    });
    updateDeliveredActionState();
    } else {
    showStatusUpdateToast((result && result.message) || 'فشل في تحديث الطلبات', '#dc2626');
    }
    },
    error: function () {
    showStatusUpdateToast('حدث خطأ أثناء تحديث الطلبات', '#dc2626');
    },
    complete: function () {
    $('#loadingIndicator').hide();
    }
    });
    }

    $(document).ready(function () {
    loadServerSelections(function () {
    applyCrossPagePendingVisibility();
    restoreDeliveredSelectionUI();
    setTimeout(updateRepresentativeVisibility, 500);
    });
    setTimeout(updateRepresentativeVisibility, 1200);

    $(document).on('click', '.row-delivered-btn', function (event) {
    event.preventDefault();
    event.stopPropagation();
    markDelivered(String($(this).data('order-id')));
    });

    $(document).on('click', '.row-cancel-delivered-btn', function (event) {
    event.preventDefault();
    event.stopPropagation();
    cancelDelivered(String($(this).data('order-id')));
    });

    $(document).on('change', 'input[type="checkbox"][name="selectedOrders"]', function () {
    var id = String($(this).val());
    if ($(this).is(':checked')) {
    markDelivered(id);
    } else {
    cancelDelivered(id);
    }
    });

    $(document).on('change', '#selectAll', function () {
    var checked = $(this).is(':checked');
    $('tr.order-row:visible input[type="checkbox"][name="selectedOrders"]').each(function () {
    var id = String($(this).val());
    if (checked) {
    markDelivered(id);
    } else {
    cancelDelivered(id);
    }
    });
    });

    $(document).on('click', '#updateToDeliveredBtn', function () {
    submitSelectedStatus('تم_التسليم', 'تم التسليم');
    });

    $(document).on('click', '#updateToPendingBtn', function () {
    submitSelectedStatus('الطلبات_المعلقة', 'الطلبات المعلقة');
    });

    $('#ManufacturingCompanyId, #CountryId, #DeliveryCompanyId, #DeliveryRepresentativeId, #pageSize').on('change', function () {
    setTimeout(updateRepresentativeVisibility, 300);
    loadStatusUpdatePage(1);
    });

    $(document).on('click', '.pagination a.page-link', function (event) {
    event.preventDefault();
    if ($(this).closest('.page-item').hasClass('disabled') || $(this).closest('.page-item').hasClass('active')) return;
    var page = parseInt($(this).data('page'));
    if (!page || page < 1) return;
    loadStatusUpdatePage(page);
    });
    });



    function handleStatusUpdateSelectionChanged(payload) {
    if (!payload) return;
    var orderId = String(payload.orderId || payload.OrderId || '');
    var targetStatus = String(payload.targetStatus || payload.TargetStatus || '');
    var isActive = payload.isActive;
    if (!orderId) return;

    if (isActive === false) {
    delete pendingFailureReasons[orderId];
    removePendingDeliveredOrder(orderId);
    loadStatusUpdatePage(1);
    return;
    }

    if (targetStatus === 'تم_التسليم') {
    addPendingDeliveredOrder(orderId);
    var $row = $('tr.order-row[data-order-id="' + orderId + '"]');
    if ($row.length) {
    $row.show().addClass('delivered-selected');
    $row.find('input[name="selectedOrders"]').prop('checked', true);
    }
    } else if (targetStatus === 'فشل_التسليم' || targetStatus === 'الطلبات_المعلقة') {
    pendingFailureReasons[orderId] = payload.failureReason || payload.FailureReason || targetStatus;
    var $hideRow = $('tr.order-row[data-order-id="' + orderId + '"]');
    $hideRow.fadeOut(140, function () { $(this).hide(); updateVisibleRowsCounter(); updateDeliveredActionState(); });
    }

    applyCrossPagePendingVisibility();
    restoreDeliveredSelectionUI();
    }

    function initStatusUpdateSelectionSignalR() {
    if (!window.signalR || !window.signalR.HubConnectionBuilder) return;

    var connection = window.orderStatusUpdateSelectionConnection;
    if (!connection) {
    connection = new signalR.HubConnectionBuilder()
    .withUrl('/orderHub')
    .withAutomaticReconnect()
    .build();
    window.orderStatusUpdateSelectionConnection = connection;
    }

    if (!connection.__statusUpdateSelectionListenerAdded) {
    connection.on('OrderStatusUpdateSelectionChanged', handleStatusUpdateSelectionChanged);
    connection.__statusUpdateSelectionListenerAdded = true;
    }

    if (window.signalR.HubConnectionState && connection.state === signalR.HubConnectionState.Disconnected) {
    connection.start().catch(function () { });
    }
    }

    $(document).ready(function () {
    initStatusUpdateSelectionSignalR();
    });

    function normalizeImageSrc(src) {
    if (!src) return '';
    if (src.indexOf('http://') === 0 || src.indexOf('https://') === 0 || src.indexOf('/') === 0) return src;
    return '/' + src.replace(/^\/+/, '');
    }

    function getTooltipCloud(wrap) {
    return wrap ? wrap.querySelector('.products-tooltip-cloud') : null;
    }

    function hideProductsTooltip(wrap) {
    if (!wrap) return;
    wrap.classList.remove('is-tooltip-active');
    var cloud = getTooltipCloud(wrap);
    if (cloud) {
    cloud.hidden = true;
    cloud.style.setProperty('display', 'none', 'important');
    cloud.style.setProperty('opacity', '0', 'important');
    cloud.style.setProperty('visibility', 'hidden', 'important');
    }
    }

    function hideAllProductsTooltips() {
    document.querySelectorAll('.products-tooltip-wrap').forEach(function (wrap) {
    hideProductsTooltip(wrap);
    });
    }

    function showProductsTooltip(wrap) {
    if (!wrap) return;
    var cloud = getTooltipCloud(wrap);
    if (cloud) {
    cloud.hidden = false;
    cloud.style.setProperty('display', 'block', 'important');
    cloud.style.setProperty('opacity', '1', 'important');
    cloud.style.setProperty('visibility', 'visible', 'important');
    }
    wrap.classList.add('is-tooltip-active');
    }

    function renderProducts(wrap, products) {
    var itemsBox = wrap.querySelector('.products-tooltip-items');
    if (!itemsBox) return;
    if (!products || !products.length) {
    wrap.classList.add('no-products');
    itemsBox.innerHTML = '<div class="products-tooltip-empty">لا توجد منتجات مسجلة لهذا الطلب</div>';
    return;
    }
    wrap.classList.remove('no-products');
    itemsBox.innerHTML = products.map(function (product) {
    var imageHtml = product.image
    ? '<img class="product-tooltip-image" src="' + escapeHtml(product.image) + '" alt="' + escapeHtml(product.name) + '" loading="lazy" />'
    : '<span class="product-tooltip-image-placeholder"><i class="fa-solid fa-box-open"></i></span>';

    return '<div class="product-tooltip-row">'
    + imageHtml
    + '<div>'
    + '<div class="product-tooltip-name">' + escapeHtml(product.name || 'منتج') + '</div>'
    + '<div class="product-tooltip-qty">عدد ' + escapeHtml(product.qty || '1') + ' قطعة</div>'
    + '</div>'
    + '</div>';
    }).join('');
    }

    function extractProductsFromDetailsHtml(html) {
    var container = document.createElement('div');
    container.innerHTML = html;
    var rows = Array.prototype.slice.call(container.querySelectorAll('#orderDetails_warehouseData tr'));
    return rows.map(function (row) {
    var cells = row.querySelectorAll('td');
    if (!cells || cells.length === 0) return null;
    var img = row.querySelector('img');
    var image = img ? normalizeImageSrc(img.getAttribute('src')) : '';
    var name = cells[1] ? cells[1].textContent.trim() : '';
    var qty = cells[2] ? cells[2].textContent.trim() : '';
    return { image: image, name: name || 'منتج', qty: qty || '1' };
    }).filter(function (item) {
    return item && (item.name || item.image);
    });
    }

    function adjustTooltipDirection(wrap) {
    if (!wrap) return;
    var rect = wrap.getBoundingClientRect();
    if (rect.top < 165) wrap.classList.add('tooltip-open-down');
    else wrap.classList.remove('tooltip-open-down');
    }

    function loadProductsForTooltip(wrap) {
    if (!wrap || wrap.dataset.productsLoaded === 'true' || wrap.dataset.productsLoading === 'true') return;
    var orderId = wrap.getAttribute('data-order-id');
    var itemsBox = wrap.querySelector('.products-tooltip-items');
    if (!orderId || !itemsBox) return;
    wrap.dataset.productsLoading = 'true';
    wrap.classList.remove('no-products');
    itemsBox.innerHTML = '<div class="products-tooltip-loading">جاري تحميل المنتجات...</div>';
    fetch('/Order/DetailsPartial/' + encodeURIComponent(orderId), { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
    .then(function (response) {
    if (!response.ok) throw new Error('Failed to load details');
    return response.text();
    })
    .then(function (html) {
    var products = extractProductsFromDetailsHtml(html);
    wrap.dataset.productsLoaded = 'true';
    renderProducts(wrap, products);
    })
    .catch(function () {
    itemsBox.innerHTML = '<div class="products-tooltip-empty">تعذر تحميل المنتجات</div>';
    })
    .finally(function () {
    wrap.dataset.productsLoading = 'false';
    });
    }

    function activateProductsTooltip(wrap) {
    if (!wrap) return;
    adjustTooltipDirection(wrap);
    showProductsTooltip(wrap);
    loadProductsForTooltip(wrap);
    }

    document.addEventListener('mouseover', function (event) {
    var wrap = event.target.closest && event.target.closest('.products-tooltip-wrap');
    if (!wrap) return;
    activateProductsTooltip(wrap);
    }, true);

    document.addEventListener('click', function (event) {
    var wrap = event.target.closest && event.target.closest('.products-tooltip-wrap');
    if (wrap) {
    event.stopPropagation();
    activateProductsTooltip(wrap);
    return;
    }
    hideAllProductsTooltips();
    }, true);

    document.addEventListener('mouseout', function (event) {
    var wrap = event.target.closest && event.target.closest('.products-tooltip-wrap');
    if (!wrap) return;
    var related = event.relatedTarget;
    if (related && wrap.contains(related)) return;
    hideProductsTooltip(wrap);
    }, true);

    window.addEventListener('load', function () {
    hideAllProductsTooltips();
    setTimeout(hideAllProductsTooltips, 250);
    });


    // Polling fallback: يخلي الأجهزة المفتوحة تعرف التحديدات المؤقتة حتى لو SignalR مش متحمل في الصفحة.
    function refreshDeliveredSelectionsFromServer() {
    loadServerSelections(function () {
    applyCrossPagePendingVisibility();
    restoreDeliveredSelectionUI();
    });
    }

    function startDeliveredSelectionPolling() {
    if (window.__deliveredSelectionPollingStarted) return;
    window.__deliveredSelectionPollingStarted = true;
    setInterval(refreshDeliveredSelectionsFromServer, 2500);
    document.addEventListener('visibilitychange', function () {
    if (!document.hidden) refreshDeliveredSelectionsFromServer();
    });
    }

    $(document).ready(function () {
    startDeliveredSelectionPolling();
    });

</script>


