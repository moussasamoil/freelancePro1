<script id="fix13-page-size-left-final-script">
    (function () {
    function ensurePageSizeToolbarFix13() {
    var table = document.getElementById('ordersTable');
    var select = document.getElementById('pageSize');
    if (!table || !select) return;

    var sourceGroup = select.closest('.form-group') || select.closest('.col-12') || select.parentElement;

    var toolbar = document.getElementById('statusUpdatePageSizeToolbar');
    if (!toolbar) {
    toolbar = document.createElement('div');
    toolbar.id = 'statusUpdatePageSizeToolbar';
    toolbar.className = 'status-update-page-size-toolbar';
    toolbar.innerHTML = '<label for="pageSize">أظهر:</label><span class="page-size-holder"></span><span>مدخلات</span>';
    table.parentNode.insertBefore(toolbar, table);
    } else if (toolbar.nextElementSibling !== table) {
    table.parentNode.insertBefore(toolbar, table);
    }

    var holder = toolbar.querySelector('.page-size-holder');
    if (holder && select.parentNode !== holder) {
    holder.appendChild(select);
    }

    select.style.display = 'inline-block';
    select.style.visibility = 'visible';
    select.style.opacity = '1';

    if (sourceGroup && sourceGroup !== toolbar && !sourceGroup.classList.contains('page-size-holder')) {
    sourceGroup.classList.add('status-page-size-source-hidden');
    }
    }

    document.addEventListener('DOMContentLoaded', ensurePageSizeToolbarFix13);
    window.addEventListener('load', ensurePageSizeToolbarFix13);
    window.setTimeout(ensurePageSizeToolbarFix13, 250);
    window.setTimeout(ensurePageSizeToolbarFix13, 800);
    window.setTimeout(ensurePageSizeToolbarFix13, 1600);
    })();
</script>




