    var toolbar = document.getElementById('statusUpdatePageSizeToolbar');
    if (!toolbar) {
    toolbar = document.createElement('div');
    toolbar.id = 'statusUpdatePageSizeToolbar';
    toolbar.className = 'status-update-page-size-toolbar';
    toolbar.innerHTML = '<label for="pageSize">أظهر:</label><span class="page-size-holder"></span><span>مدخلات</span>';
    table.parentNode.insertBefore(toolbar, table);
    }

    var holder = toolbar.querySelector('.page-size-holder');
    if (holder && select.parentNode !== holder) {
    holder.appendChild(select);
    }
    select.style.display = 'inline-block';
    select.style.visibility = 'visible';
    select.style.opacity = '1';
    }

    document.addEventListener('DOMContentLoaded', ensurePageSizeToolbar);
    window.addEventListener('load', ensurePageSizeToolbar);
    window.setTimeout(ensurePageSizeToolbar, 300);
    window.setTimeout(ensurePageSizeToolbar, 1000);
    })();
</script>


