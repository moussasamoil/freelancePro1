<script id="status-update-delivery-cost-sync-script">
    (function () {
    function parseCost(value) {
    if (value === null || value === undefined || value === '') return 0;
    var numeric = Number(String(value).replace(/,/g, ''));
    return isNaN(numeric) ? 0 : numeric;
    }

    function formatCost(value) {
    value = parseCost(value);
    try {
    return value.toLocaleString('en-US', { maximumFractionDigits: 0 });
    } catch (e) {
    return String(Math.round(value));
    }
    }

    function applyDeliveryCost(orderId, cost) {
    var badge = document.querySelector('.home-delivery-cost-badge[data-order-id="' + orderId + '"]');
    if (!badge) return;
    var valueNode = badge.querySelector('.delivery-cost-value');
    if (valueNode) valueNode.textContent = formatCost(cost);
    badge.setAttribute('data-delivery-cost-value', parseCost(cost));
    }

    function syncDeliveryCosts() {
    var badges = Array.prototype.slice.call(document.querySelectorAll('.home-delivery-cost-badge[data-order-id]'));
    var ids = badges.map(function (badge) { return badge.getAttribute('data-order-id'); })
    .filter(function (id, index, arr) { return id && arr.indexOf(id) === index; });

    if (!ids.length) return;

    fetch('/Order/DeliveryCostsByOrderIds?ids=' + encodeURIComponent(ids.join(',')), {
    method: 'GET',
    cache: 'no-store',
    credentials: 'same-origin',
    headers: { 'Accept': 'application/json' }
    })
    .then(function (response) { return response.ok ? response.json() : null; })
    .then(function (result) {
    var items = result && (result.items || result.Items);
    if (!items || !items.length) return;

    items.forEach(function (item) {
    var orderId = item.orderId || item.OrderId;
    var cost = item.deliveryCost;
    if (cost === undefined) cost = item.DeliveryCost;
    if (orderId !== undefined) applyDeliveryCost(orderId, cost);
    });
    })
    .catch(function () { });
    }

    if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function () { setTimeout(syncDeliveryCosts, 150); });
    } else {
    setTimeout(syncDeliveryCosts, 150);
    }

    window.statusUpdateSyncDeliveryCosts = syncDeliveryCosts;
    })();
</script>


