@functions {
    static string NormalizePhoneForDisplay(string raw, string countryName)
    {
        if (string.IsNullOrWhiteSpace(raw)) return raw ?? string.Empty;
        var cleaned = new string(raw.Where(c => c != '-' && !char.IsWhiteSpace(c)).ToArray());
        if (string.IsNullOrEmpty(cleaned)) return string.Empty;

        string code = Common.GetPhoneNumberCodeByCountryStatus(countryName);
        if (string.IsNullOrEmpty(code) || code == "Country not found" || code == "Invalid country name")
            return cleaned;

        string digits = code.TrimStart('+');

        if (cleaned.StartsWith("00" + digits))
            cleaned = cleaned.Substring(2 + digits.Length);
        else if (cleaned.StartsWith("+" + digits))
            cleaned = cleaned.Substring(1 + digits.Length);

        if (!cleaned.StartsWith("0"))
            cleaned = "0" + cleaned;

        return cleaned;
    }

    static string StripCountryCodeAndLeadingZero(string raw, string countryName)
    {
        if (string.IsNullOrWhiteSpace(raw)) return raw ?? string.Empty;
        var cleaned = new string(raw.Where(c => c != '⁦' && c != '⁧' && c != '⁨' && c != '⁩' && c != '-' && !char.IsWhiteSpace(c)).ToArray());
        if (string.IsNullOrEmpty(cleaned)) return string.Empty;

        string code = Common.GetPhoneNumberCodeByCountryStatus(countryName);
        string digits = string.IsNullOrEmpty(code) ? string.Empty : code.TrimStart('+');

        if (!string.IsNullOrEmpty(digits))
        {
            if (cleaned.StartsWith("00" + digits)) cleaned = cleaned.Substring(2 + digits.Length);
            else if (cleaned.StartsWith("+" + digits)) cleaned = cleaned.Substring(1 + digits.Length);
        }

        if (cleaned.StartsWith("0")) cleaned = cleaned.Substring(1);
        return cleaned;
    }

    static decimal? GetStatusUpdateOrderDeliveryCost(object order)
    {
        if (order == null) return null;

        var type = order.GetType();
        string[] deliveryCostProps = new[]
        {
            "DeliveryCost", "deliveryCost",
            "DeliveryPrice", "deliveryPrice",
            "DeliveryFee", "deliveryFee",
            "DeliveryFees", "deliveryFees",
            "ShippingCost", "shippingCost",
            "ShippingPrice", "shippingPrice",
            "ShippingFee", "shippingFee",
            "DeliveryAmount", "deliveryAmount",
            "DeliveryCostAmount", "deliveryCostAmount",
            "DeliveryPriceAmount", "deliveryPriceAmount",
            "OrderDeliveryCost", "orderDeliveryCost",
            "OrderDeliveryPrice", "orderDeliveryPrice",
            "ReceiptDeliveryCost", "receiptDeliveryCost",
            "ReceiptDeliveryPrice", "receiptDeliveryPrice"
        };

        foreach (var propName in deliveryCostProps)
        {
            var prop = type.GetProperty(propName);
            if (prop == null) continue;

            var value = prop.GetValue(order);
            if (value == null) continue;

            try
            {
                if (value is decimal decimalValue) return decimalValue;
                if (value is double doubleValue) return Convert.ToDecimal(doubleValue);
                if (value is float floatValue) return Convert.ToDecimal(floatValue);
                if (value is int intValue) return intValue;

                var text = value.ToString();
                if (string.IsNullOrWhiteSpace(text)) continue;

                text = text
                    .Replace(",", "")
                    .Replace("LYD", "")
                    .Replace("TRY", "")
                    .Replace("IQD", "")
                    .Replace("JOD", "")
                    .Replace("USD", "")
                    .Replace("EGP", "")
                    .Trim();

                if (decimal.TryParse(text, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var invariantValue))
                {
                    return invariantValue;
                }

                if (decimal.TryParse(text, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.CurrentCulture, out var currentValue))
                {
                    return currentValue;
                }
            }
            catch
            {
            }
        }

        return null;
    }

    static string GetStatusUpdateSalesIndicatorIcon(string salesIndicatorState)
    {
        salesIndicatorState = (salesIndicatorState ?? string.Empty).Trim();

        if (salesIndicatorState == "minimum") return "↓";
        if (salesIndicatorState == "middle") return "→";
        if (salesIndicatorState == "basic") return "↑";
        if (salesIndicatorState == "above-basic") return "✓";

        return "";
    }

}

