                    <input type="text" inputmode="text" autocomplete="off" id="statusUpdateQuickReportOrderId" class="status-update-quick-report-input" placeholder="اكتب كود الطلب هنا" />
                </div>
                <div class="status-update-quick-report-field">
                    <textarea id="statusUpdateQuickReportReason" class="status-update-quick-report-textarea" placeholder="اكتب سبب البلاغ هنا"></textarea>
                </div>
                <div class="status-update-quick-report-field">
                    <div class="status-update-quick-report-image-zone" id="statusUpdateQuickReportImageZone" tabindex="0">
                        اضغط هنا لاختيار صورة أو الصق الصورة Ctrl + V <br />الصورة اختيارية
                    </div>
                    <input type="file" id="statusUpdateQuickReportImageInput" accept="image/*" hidden />
                    <div id="statusUpdateQuickReportImagePreview" class="status-update-quick-report-image-preview" style="display:none;"></div>
                    <div id="statusUpdateQuickReportError" class="status-update-quick-report-error"></div>
                </div>
                <button type="button" id="statusUpdateQuickReportSubmit" class="status-update-quick-report-submit-wide">إرسال البلاغ</button>
            </div>
        </div>
    </div>



    <div id="statusUpdateDonePopupBackdrop" class="status-update-done-popup-backdrop">
        <div class="status-update-done-popup-card">
            <div class="status-update-done-popup-icon">✓</div>
            <div class="status-update-done-popup-title">تم التحديث</div>
            <div id="statusUpdateDonePopupStatus" class="status-update-done-popup-status"></div>
            <button type="button" id="statusUpdateDonePopupOk" class="status-update-done-popup-ok">حسنًا</button>
        </div>
    </div>

    <form id="statusUpdateQuickReportAntiforgery" style="display:none">@Html.AntiForgeryToken()</form>

    <script id="status-update-quick-report-script">
        (function () {
        var quickReportType = 0;
        var quickReportTitle = '';
        var quickReportImageFile = null;

        function getToken() {
        var input = document.querySelector('#statusUpdateQuickReportAntiforgery input[name="__RequestVerificationToken"]');
        return input ? input.value : '';
        }

        function showError(message) {
        var error = document.getElementById('statusUpdateQuickReportError');
        if (!error) return;
        error.textContent = message || '';
        error.style.display = message ? 'block' : 'none';
        }

        function setZoneText(text, hasImage) {
        var zone = document.getElementById('statusUpdateQuickReportImageZone');
        if (!zone) return;
        zone.innerHTML = text;
        zone.classList.toggle('has-image', !!hasImage);
        }

        function resetQuickReportImage() {
        quickReportImageFile = null;
        var input = document.getElementById('statusUpdateQuickReportImageInput');
        var preview = document.getElementById('statusUpdateQuickReportImagePreview');
        if (input) input.value = '';
        setZoneText('اضغط هنا لاختيار صورة أو الصق الصورة Ctrl + V <br />الصورة اختيارية', false);
        if (preview) {
        preview.innerHTML = '';
        preview.style.display = 'none';
        }
        }

        function setQuickReportImage(file) {
        if (!file) return;
        if (!file.type || file.type.indexOf('image/') !== 0) {
        showError('الملف المختار يجب أن يكون صورة');
        return;
        }

        quickReportImageFile = file;
        showError('');

        var reader = new FileReader();
        reader.onload = function (event) {
        var preview = document.getElementById('statusUpdateQuickReportImagePreview');
        setZoneText('تم إضافة الصورة - اضغط أو Ctrl + V لتغييرها', true);
        if (preview) {
        preview.innerHTML = '<img src="' + event.target.result + '" alt="صورة البلاغ" />';
        preview.style.display = 'block';
        }
        };
        reader.readAsDataURL(file);
        }

        function readImageFromPaste(event) {
        var clipboard = event.clipboardData || (event.originalEvent && event.originalEvent.clipboardData);
        var items = clipboard && clipboard.items;
        if (!items) return false;

        for (var i = 0; i < items.length; i++) {
        var item = items[i];
        if (item.kind === 'file' && item.type && item.type.indexOf('image/') === 0) {
        var file = item.getAsFile();
        if (file) {
        setQuickReportImage(file);
        event.preventDefault();
        return true;
        }
        }
        }
        return false;
        }

        function setSubmitText() {
        var submitBtn = document.getElementById('statusUpdateQuickReportSubmit');
        if (!submitBtn) return;
        submitBtn.textContent = quickReportType === 1 ? 'إرسال التعديل الفوري' : 'إرسال البلاغ';
        }

        function openQuickReport(type, title) {
        quickReportType = parseInt(type, 10) || 0;
        quickReportTitle = title || (quickReportType === 1 ? 'تبليغ عن تعديل فوري' : 'التبليغ عن مشكلة');

        var titleEl = document.getElementById('statusUpdateQuickReportTitle');
        var orderInput = document.getElementById('statusUpdateQuickReportOrderId');
        var reasonInput = document.getElementById('statusUpdateQuickReportReason');
        var backdrop = document.getElementById('statusUpdateQuickReportBackdrop');
        var historyPanel = document.getElementById('statusUpdateQuickReportHistoryPanel');

        if (titleEl) titleEl.textContent = quickReportTitle;
        if (orderInput) orderInput.value = '';
        if (reasonInput) reasonInput.value = '';
        if (historyPanel) historyPanel.classList.remove('is-visible');
        resetQuickReportImage();
        showError('');
        setSubmitText();
        loadInlineQuickReportHistory(quickReportType, true);
        if (backdrop) backdrop.classList.add('is-visible');
        setTimeout(function () { if (orderInput) orderInput.focus(); }, 100);
        }

        function closeQuickReport() {
        var backdrop = document.getElementById('statusUpdateQuickReportBackdrop');
        var historyPanel = document.getElementById('statusUpdateQuickReportHistoryPanel');
        if (backdrop) backdrop.classList.remove('is-visible');
        if (historyPanel) historyPanel.classList.remove('is-visible');
        resetQuickReportImage();
        showError('');
        }

        function toggleHistoryPanel() {
        var historyPanel = document.getElementById('statusUpdateQuickReportHistoryPanel');
        if (!historyPanel) return;
        historyPanel.classList.toggle('is-visible');
        }

        function parseQuickReportResponse(response) {
        return response.text().then(function (text) {
        var json = null;
        if (text) {
        try { json = JSON.parse(text); } catch (e) { json = null; }
        }

        if (!response.ok || (json && json.success === false)) {
        var message = (json && json.message)
        ? json.message
        : (text || 'فشل إرسال البلاغ');
        throw new Error(message);
        }

        return json || { success: true };
        });
        }



        function escapeHtml(value) {
        return String(value == null ? '' : value)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
        }

        function setQuickReportCountValue(el, count) {
        if (!el) return;
        count = parseInt(count || 0, 10) || 0;
        el.textContent = count;
        el.classList.toggle('is-zero', count <= 0);
        }

        function setQuickReportCounts(problemCount, editCount) {
        setQuickReportCountValue(document.getElementById('statusUpdateMyProblemReportsCount'), problemCount);
        setQuickReportCountValue(document.getElementById('statusUpdateMyEditReportsCount'), editCount);
        }

        function loadQuickReportCounts() {
        fetch('/Order/QuickReportList', {
        method: 'GET',
        credentials: 'same-origin',
        headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
        .then(parseQuickReportResponse)
        .then(function (data) {
        setQuickReportCounts(data.problemCount || 0, data.editCount || 0);
        })
        .catch(function (error) {
        console.error('QuickReportList count failed:', error);
        });
        }

        function reportCopyText(report) {
        var typeText = report.typeText || (report.type === 1 ? 'تعديل مطلوب' : 'بلاغ');
        var text = typeText + '\n' +
        'كود الطلب: ' + (report.orderId || '') + '\n' +
        'التاريخ: ' + (report.createdAt || '') + '\n' +
        'السبب: ' + (report.body || '');
        if (report.imageUrl) text += '\nالصورة: ' + report.imageUrl;
        return text;
        }

        function renderQuickReportList(data, type) {
        var body = document.getElementById('statusUpdateReportListBody');
        if (!body) return;

        var reports = (data && data.reports) ? data.reports : [];
        if (!reports.length) {
        body.innerHTML = '<div class="status-update-report-list-empty">لا توجد بيانات للعرض</div>';
        return;
        }

        body.innerHTML = reports.map(function (report) {
        var imageLink = report.imageUrl
        ? '<a class="status-update-report-card-image" href="' + escapeHtml(report.imageUrl) + '" target="_blank">عرض الصورة</a>'
        : '';

        return '<div class="status-update-report-card" data-report-id="' + escapeHtml(report.id) + '">' +
        '<div class="status-update-report-card-head">' +
        '<span class="status-update-report-card-code">كود الطلب: ' + escapeHtml(report.orderId || '') + '</span>' +
        '<span class="status-update-report-card-date">' + escapeHtml(report.createdAt || '') + '</span>' +
        '</div>' +
        '<div class="status-update-report-card-body">' + escapeHtml(report.body || '') + '</div>' +
        imageLink +
        '<div class="status-update-report-card-actions">' +
        '<button type="button" class="status-update-report-card-action copy" data-copy-report-id="' + escapeHtml(report.id) + '">نسخ</button>' +
        '<button type="button" class="status-update-report-card-action delete" data-delete-report-id="' + escapeHtml(report.id) + '">مسح</button>' +
        '</div>' +
        '</div>';
        }).join('');

        window.statusUpdateQuickReportsCache = window.statusUpdateQuickReportsCache || {};
        reports.forEach(function (report) {
        window.statusUpdateQuickReportsCache[String(report.id)] = report;
        });
        }


        function renderInlineQuickReportHistory(data, type) {
        var panel = document.getElementById('statusUpdateQuickReportHistoryPanel');
        if (!panel) return;

        var reports = (data && data.reports) ? data.reports : [];
        if (!reports.length) {
        panel.innerHTML = '<div class="status-update-inline-history-empty">لا يوجد سجل للعرض</div>';
        return;
        }

        window.statusUpdateQuickReportsCache = window.statusUpdateQuickReportsCache || {};

        panel.innerHTML = reports.map(function (report) {
        window.statusUpdateQuickReportsCache[String(report.id)] = report;
        var imageLink = report.imageUrl
        ? '<a class="status-update-inline-history-image" href="' + escapeHtml(report.imageUrl) + '" target="_blank"><i class="fa-regular fa-image"></i> عرض الصورة</a>'
        : '';

        var userName = report.userName || report.authorName || report.createdByName || report.employeeName || 'الموظف';
        var typeText = report.typeText || (parseInt(report.type || type, 10) === 1 ? 'تعديل' : 'بلاغ');

        return '<div class="status-update-inline-history-card" data-report-id="' + escapeHtml(report.id) + '">' +
        '<span class="status-update-inline-history-avatar"><i class="fa-solid fa-user"></i></span>' +
        '<button type="button" class="status-update-inline-history-delete" data-delete-report-id="' + escapeHtml(report.id) + '" title="مسح"><i class="fa-regular fa-trash-can"></i></button>' +
        '<div class="status-update-inline-history-head">' +
        '<span class="status-update-inline-history-date">' + escapeHtml(report.createdAt || '') + '<span class="status-update-inline-history-type">' + escapeHtml(typeText) + '</span></span>' +
        '<span class="status-update-inline-history-user">' + escapeHtml(userName) + '</span>' +
        '</div>' +
        '<div class="status-update-inline-history-body">' + escapeHtml(report.body || '') + '</div>' +
        '<div class="status-update-inline-history-actions">' +
        '<button type="button" class="status-update-inline-history-copy" data-copy-report-id="' + escapeHtml(report.id) + '"><i class="fa-regular fa-copy"></i> نسخ</button>' +
        imageLink +
        '</div>' +
        '</div>';
        }).join('');
        }

        function loadInlineQuickReportHistory(type, showPanel) {
        var panel = document.getElementById('statusUpdateQuickReportHistoryPanel');
        if (!panel) return;
        if (showPanel) panel.classList.add('is-visible');
        panel.innerHTML = '<div class="status-update-inline-history-empty">جاري التحميل...</div>';

        var parsedType = parseInt(type, 10);
        if (isNaN(parsedType)) parsedType = 0;

        fetch('/Order/QuickReportList?type=' + encodeURIComponent(parsedType), {
        method: 'GET',
        credentials: 'same-origin',
        headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
        .then(parseQuickReportResponse)
        .then(function (data) {
        setQuickReportCounts(data.problemCount || 0, data.editCount || 0);
        renderInlineQuickReportHistory(data, parsedType);
        })
        .catch(function (error) {
        panel.innerHTML = '<div class="status-update-inline-history-empty">' + escapeHtml(error && error.message ? error.message : 'فشل تحميل السجل') + '</div>';
        });
        }

        function toggleInlineQuickReportHistory() {
        var panel = document.getElementById('statusUpdateQuickReportHistoryPanel');
        if (!panel) return;
        if (panel.classList.contains('is-visible')) {
        panel.classList.remove('is-visible');
        return;
        }
        loadInlineQuickReportHistory(quickReportType, true);
        }

        function copyAllInlineQuickReports() {
        var panel = document.getElementById('statusUpdateQuickReportHistoryPanel');
        if (!panel || !panel.classList.contains('is-visible')) {
        loadInlineQuickReportHistory(quickReportType, true);
        setTimeout(copyAllInlineQuickReports, 500);
        return;
        }

        window.statusUpdateQuickReportsCache = window.statusUpdateQuickReportsCache || {};
        var reports = Object.keys(window.statusUpdateQuickReportsCache)
        .map(function (id) { return window.statusUpdateQuickReportsCache[id]; })
        .filter(function (report) { return report && parseInt(report.type || quickReportType, 10) === parseInt(quickReportType, 10); });

        if (!reports.length) {
        if (typeof window.showStatusUpdateToast === 'function') window.showStatusUpdateToast('لا يوجد بيانات للنسخ', '#f59e0b');
        return;
        }

        var text = reports.map(reportCopyText).join('\n----------------\n');
        if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(text).then(function () {
        if (typeof window.showStatusUpdateToast === 'function') window.showStatusUpdateToast('تم نسخ الكل', '#18a088');
        }).catch(function () { window.prompt('انسخي النص', text); });
        } else {
        window.prompt('انسخي النص', text);
        }
        }

        function deleteAllInlineQuickReports() {
        var panel = document.getElementById('statusUpdateQuickReportHistoryPanel');
        if (!panel || !panel.classList.contains('is-visible')) {
        loadInlineQuickReportHistory(quickReportType, true);
        setTimeout(deleteAllInlineQuickReports, 500);
        return;
        }

        window.statusUpdateQuickReportsCache = window.statusUpdateQuickReportsCache || {};
        var reports = Object.keys(window.statusUpdateQuickReportsCache)
        .map(function (id) { return window.statusUpdateQuickReportsCache[id]; })
        .filter(function (report) { return report && parseInt(report.type || quickReportType, 10) === parseInt(quickReportType, 10); });

        if (!reports.length) {
        if (typeof window.showStatusUpdateToast === 'function') window.showStatusUpdateToast('لا يوجد بيانات للمسح', '#f59e0b');
        return;
        }

        if (!confirm('هل تريدين مسح كل العناصر المعروضة؟')) return;

        var token = getToken();
        var requests = reports.map(function (report) {
        var fd = new FormData();
        fd.append('id', report.id);
        if (token) fd.append('__RequestVerificationToken', token);
        return fetch('/Order/QuickReportDelete', {
        method: 'POST',
        body: fd,
        credentials: 'same-origin',
        headers: { 'X-Requested-With': 'XMLHttpRequest' }
        }).then(parseQuickReportResponse);
        });

        Promise.all(requests)
        .then(function () {
        loadQuickReportCounts();
        loadInlineQuickReportHistory(quickReportType, true);
        if (typeof window.showStatusUpdateToast === 'function') window.showStatusUpdateToast('تم المسح', '#18a088');
        })
        .catch(function (error) {
        alert(error && error.message ? error.message : 'فشل مسح العناصر');
        });
        }

        function openQuickReportList(type) {
        var parsedType = parseInt(type, 10);
        if (isNaN(parsedType)) parsedType = 0;

        var backdrop = document.getElementById('statusUpdateReportListBackdrop');
        var title = document.getElementById('statusUpdateReportListTitle');
        var body = document.getElementById('statusUpdateReportListBody');
        if (title) title.textContent = parsedType === 1 ? 'التعديلات المطلوبة' : 'الإبلاغات';
        if (body) body.innerHTML = '<div class="status-update-report-list-empty">جاري التحميل...</div>';
        if (backdrop) {
        backdrop.setAttribute('data-current-type', String(parsedType));
        backdrop.classList.add('is-visible');
        }

        fetch('/Order/QuickReportList?type=' + encodeURIComponent(parsedType), {
        method: 'GET',
        credentials: 'same-origin',
        headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
        .then(parseQuickReportResponse)
        .then(function (data) {
        setQuickReportCounts(data.problemCount || 0, data.editCount || 0);
        renderQuickReportList(data, parsedType);
        })
        .catch(function (error) {
        if (body) body.innerHTML = '<div class="status-update-report-list-empty">' + escapeHtml(error && error.message ? error.message : 'فشل تحميل البيانات') + '</div>';
        });
        }

        function closeQuickReportList() {
        var backdrop = document.getElementById('statusUpdateReportListBackdrop');
        if (backdrop) backdrop.classList.remove('is-visible');
        }

        function deleteQuickReportItem(id) {
        if (!id) return;
        if (!confirm('هل تريدين مسح هذا العنصر؟')) return;

        var fd = new FormData();
        fd.append('id', id);
        var token = getToken();
        if (token) fd.append('__RequestVerificationToken', token);

        fetch('/Order/QuickReportDelete', {
        method: 'POST',
        body: fd,
        credentials: 'same-origin',
        headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
        .then(parseQuickReportResponse)
        .then(function () {
        var card = document.querySelector('[data-report-id="' + String(id).replace(/"/g, '\\"') + '"]');
        if (card) card.remove();
        loadQuickReportCounts();
        var listBackdrop = document.getElementById('statusUpdateReportListBackdrop');
        var currentType = listBackdrop && listBackdrop.classList.contains('is-visible') ? listBackdrop.getAttribute('data-current-type') : null;
        if (currentType !== null) {
        openQuickReportList(currentType);
        } else {
        loadInlineQuickReportHistory(quickReportType, true);
        }
        })
        .catch(function (error) {
        alert(error && error.message ? error.message : 'فشل مسح العنصر');
        });
        }

        function copyQuickReportItem(id) {
        window.statusUpdateQuickReportsCache = window.statusUpdateQuickReportsCache || {};
        var report = window.statusUpdateQuickReportsCache[String(id)];
        if (!report) return;
        var text = reportCopyText(report);
        if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(text).then(function () {
        if (typeof window.showStatusUpdateToast === 'function') {
        window.showStatusUpdateToast('تم النسخ', '#18a088');
        }
        }).catch(function () {
        window.prompt('انسخي النص', text);
        });
        } else {
        window.prompt('انسخي النص', text);
        }
        }

        function submitQuickReport() {
        var orderInput = document.getElementById('statusUpdateQuickReportOrderId');
        var reasonInput = document.getElementById('statusUpdateQuickReportReason');
        var submitBtn = document.getElementById('statusUpdateQuickReportSubmit');
        var orderCode = orderInput ? String(orderInput.value || '').trim() : '';
        var reason = reasonInput ? String(reasonInput.value || '').trim() : '';

        if (!orderCode) {
        showError('اكتب كود الطلب');
        return;
        }
        if (!reason) {
        showError('اكتب سبب البلاغ');
        return;
        }

        var fd = new FormData();
        fd.append('orderCode', orderCode);
        fd.append('orderId', orderCode);
        fd.append('type', quickReportType);
        fd.append('reason', reason);
        fd.append('body', reason);
        if (quickReportImageFile) {
        fd.append('images', quickReportImageFile);
        }
        var token = getToken();
        if (token) fd.append('__RequestVerificationToken', token);

        showError('');
        if (submitBtn) submitBtn.disabled = true;

        fetch('/Order/QuickReportCreate', {
        method: 'POST',
        body: fd,
        credentials: 'same-origin',
        headers: {
        'X-Requested-With': 'XMLHttpRequest'
        }
        })
        .then(parseQuickReportResponse)
        .then(function () {
        closeQuickReport();
        loadQuickReportCounts();
        if (typeof window.showStatusUpdateToast === 'function') {
        window.showStatusUpdateToast('تم إرسال ' + quickReportTitle, '#18a088');
        } else {
        alert('تم إرسال ' + quickReportTitle);
        }
        })
        .catch(function (error) {
        showError(error && error.message ? error.message : 'فشل إرسال البلاغ');
        console.error('QuickReportCreate failed:', error);
        })
        .finally(function () {
        if (submitBtn) submitBtn.disabled = false;
        });
        }


        window.showStatusDonePopup = function (statusText, count) {
        var statusEl = document.getElementById('statusUpdateDonePopupStatus');
        var backdrop = document.getElementById('statusUpdateDonePopupBackdrop');
        var text = 'الحالة: ' + (statusText || '');
        if (count) text += ' - عدد الطلبات: ' + count;
        if (statusEl) statusEl.textContent = text;
        if (backdrop) backdrop.classList.add('is-visible');
        setTimeout(function () {
        if (backdrop) backdrop.classList.remove('is-visible');
        }, 2500);
        };

        document.addEventListener('click', function (event) {
        var deleteBtn = event.target.closest && event.target.closest('[data-delete-report-id]');
        if (deleteBtn) {
        event.preventDefault();
        event.stopPropagation();
        deleteQuickReportItem(deleteBtn.getAttribute('data-delete-report-id'));
        return;
        }

        var copyBtn = event.target.closest && event.target.closest('[data-copy-report-id]');
        if (copyBtn) {
        event.preventDefault();
        event.stopPropagation();
        copyQuickReportItem(copyBtn.getAttribute('data-copy-report-id'));
        return;
        }

        if (event.target && event.target.id === 'statusUpdateReportListClose') {
        closeQuickReportList();
        return;
        }

        if (event.target && event.target.id === 'statusUpdateReportListRefresh') {
        var listBackdrop = document.getElementById('statusUpdateReportListBackdrop');
        openQuickReportList(listBackdrop ? listBackdrop.getAttribute('data-current-type') : '0');
        return;
        }

        if (event.target && event.target.id === 'statusUpdateReportListBackdrop') {
        closeQuickReportList();
        return;
        }

        var btn = event.target.closest && event.target.closest('[data-quick-report-type]');
        if (btn) {
        event.preventDefault();
        event.stopPropagation();
        openQuickReport(btn.getAttribute('data-quick-report-type'), btn.getAttribute('data-quick-report-title'));
        return;
        }

        if (event.target && (
        event.target.id === 'statusUpdateQuickReportBack' ||
        event.target.id === 'statusUpdateQuickReportClose')) {
        closeQuickReport();
        return;
        }

        if (event.target && event.target.id === 'statusUpdateQuickReportHistory') {
        toggleInlineQuickReportHistory();
        return;
        }

        if (event.target && event.target.id === 'statusUpdateQuickReportCopyAll') {
        copyAllInlineQuickReports();
        return;
        }

        if (event.target && (event.target.id === 'statusUpdateQuickReportDeleteAll' || (event.target.closest && event.target.closest('#statusUpdateQuickReportDeleteAll')))) {
        deleteAllInlineQuickReports();
        return;
        }

        if (event.target && event.target.id === 'statusUpdateQuickReportSubmit') {
        submitQuickReport();
        return;
        }

        if (event.target && event.target.id === 'statusUpdateQuickReportImageZone') {
        event.preventDefault();
        event.stopPropagation();
        var input = document.getElementById('statusUpdateQuickReportImageInput');
        if (input) input.click();
        return;
        }

        if (event.target && event.target.id === 'statusUpdateQuickReportBackdrop') {
        closeQuickReport();
        return;
        }

        if (event.target && (event.target.id === 'statusUpdateDonePopupOk' || event.target.id === 'statusUpdateDonePopupBackdrop')) {
        var doneBackdrop = document.getElementById('statusUpdateDonePopupBackdrop');
        if (doneBackdrop) doneBackdrop.classList.remove('is-visible');
        }
        }, true);

        document.addEventListener('change', function (event) {
        if (event.target && event.target.id === 'statusUpdateQuickReportImageInput') {
        var file = event.target.files && event.target.files[0];
        if (file) setQuickReportImage(file);
        }
        }, true);

        document.addEventListener('paste', function (event) {
        var backdrop = document.getElementById('statusUpdateQuickReportBackdrop');
        if (!backdrop || !backdrop.classList.contains('is-visible')) return;
        readImageFromPaste(event);
        }, true);

        loadQuickReportCounts();
        window.addEventListener('focus', loadQuickReportCounts);

        })();
    </script>




