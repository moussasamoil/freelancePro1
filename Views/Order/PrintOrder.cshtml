                                    @Model.Address<br>
                                    @Model.TelephoneNumber<br>
                                    @if (Model.IsPaid == true)
                                    {
                                        <span class="fw-bold">
                                            <span class="fw-bold"> حالة الطلب : تم التحويل حوالة بنكية</span>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="fw-bold"> حالة الطلب : غير مدفوع</span>
                                    }
                                </address>
                            </div>
                            <div class="col-12 col-sm-6 col-md-4">
                                <h4 class="row">
                                    <span class="col-6">Invoice #</span>
                                    <span class="col-6 text-sm-end">@Model.Id</span>
                                </h4>
                                <div class="row">

                                    <span class="col-6">تاريخ  الطلب  </span>
                                    <span class="col-6 text-sm-end">
                                        @Model.CreatedDate.ToString("yyyy-MM-dd")
                                    </span>
                                    <span class="col-6">تاريخ التوصيل </span>
                                    <span class="col-6 text-sm-end">@Model.CreatedDate.AddDays(3).ToString("yyyy-MM-dd")</span>
                                </div>
                            </div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-12">
                                <div class="table-responsive">
                                    <table class="table table-striped">
                                        <thead>
                                            <tr>
                                                <th scope="col" class="text-uppercase pb-2">القطع</th>
                                                <th scope="col" class="text-uppercase pb-2">اسم المنتج</th>


                                            </tr>
                                        </thead>

                                        <tbody class="table-group-divider">
                                            @foreach (var warehouse in Model.SelectedWarehouses)
                                            {
                                                <tr>
                                                    <th scope="row">@warehouse.Amount</th>
                                                    <td>@warehouse.WarehouseName</td>
                                                    <td class="text-end"></td>
                                                    <td class="text-end"></td>
                                                </tr>






                                                <tr>
                                                    <th scope="row" colspan="1" class="text-uppercase">الأجمالي</th>
                                                    <td></td>
                                                    <td class="text-end"></td>
                                                    <td class="text-start" colspan="4">@Model.TotalPrice @Common.GetCurrencyByCountryName(Model.Country.ToString())</td>
                                                </tr>


                                            }
                                        </tbody>


                                        <tbody class="table-group-divider">
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </section>
    }
}



