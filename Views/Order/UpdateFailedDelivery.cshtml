    if (window.pendingFailureReasonImageFiles && window.pendingFailureReasonImageFiles[orderId]) {
    return window.pendingFailureReasonImageFiles[orderId];
    }
    if (typeof pendingFailureReasonImageFiles !== 'undefined' && pendingFailureReasonImageFiles && pendingFailureReasonImageFiles[orderId]) {
    return pendingFailureReasonImageFiles[orderId];
    }
    } catch (e) { }
    return null;
