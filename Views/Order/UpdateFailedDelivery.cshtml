    $('.failure-image-thumb-btn[data-order-id="' + orderId + '"]').removeClass('is-visible').hide().find('img').attr('src', '');
    }

    function setProfileImage(orderId, dataUrl) {
    var $btn = window.jQuery ? $('.failure-image-inline-btn[data-order-id="' + orderId + '"]') : null;
    if (!$btn || !$btn.length) return;
    if (!dataUrl) {
    clearProfileImage(orderId);
