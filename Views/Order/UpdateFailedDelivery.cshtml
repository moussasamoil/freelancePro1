    });

    $(document).on('click', '#failureRowImageBackdrop', function (event) {
    if (event.target === this) {
    event.preventDefault();
    event.stopPropagation();
    event.stopImmediatePropagation();
    $('#failureRowImagePasteZone').trigger('focus');
    showStatusUpdateToast('البوب لا يغلق إلا بعد إضافة صورة سبب الفشل', '#dc2626');
    return false;
    }
    });

    $(document).on('change', 'input[type="checkbox"][name="selectedOrders"]', function () {
    var orderId = String($(this).val());
    var $select = $('.inline-failure-select[data-order-id="' + orderId + '"]');
    var reason = String($select.val() || '').trim();

    if ($(this).is(':checked') && reason.length === 0) {
    $(this).prop('checked', false);
    showStatusUpdateToast('اختاري سبب الفشل أولاً', '#dc2626');
    return;
    }

    if (!$(this).is(':checked')) {
    clearServerSelection(orderId, function () {
    delete pendingFailureReasons[orderId];
