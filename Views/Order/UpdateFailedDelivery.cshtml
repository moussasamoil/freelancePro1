        gap: 5px !important;
        }

        #pagination-link .page-link {
        min-width: 34px !important;
        height: 33px !important;
        padding: 0 7px !important;
        font-size: 12px !important;
        }
        }
    </style>

    <div id="pagination-link" class="mt-0 mb-2 container-fluid">
        <div class="d-flex justify-content-center align-items-center flex-wrap">
            <p class="text-start pt-0 text-nowrap pt-lg-0 d-inline total-items-display" style="display:none !important;">
                @Model.PaginationViewModel.TotalItems
                <span class="d-none d-md-inline">عدد الطلبات</span>
            </p>

            <nav aria-label="Page navigation" class="mx-auto mt-2 mt-lg-0 nav-nav home-pagination-nav">
                @{
                    int currentPage = Model.PaginationViewModel.CurrentPage;
                    int totalPages = Model.PaginationViewModel.TotalPages;

                    if (currentPage < 1)
                    {
                        currentPage = 1;
                    }

                    if (totalPages < 1)
                    {
                        totalPages = 1;
                    }

                    if (currentPage > totalPages)
                    {
                        currentPage = totalPages;
                    }

                    int previousPage = currentPage > 1 ? currentPage - 1 : 1;
                    int nextPage = currentPage < totalPages ? currentPage + 1 : totalPages;
                    var pagesToShow = new System.Collections.Generic.SortedSet<int>();

                    if (totalPages <= 7)
                    {
                        for (int i = 1; i <= totalPages; i++)
                        {
                            pagesToShow.Add(i);
                        }
                    }
                    else
                    {
                        int windowStart;
                        int windowEnd;

                        if (currentPage <= 2)
                        {
                            windowStart = 1;
                            windowEnd = 3;
                        }
                        else if (currentPage >= totalPages - 1)
                        {
                            windowStart = totalPages - 2;
                            windowEnd = totalPages;
                        }
                        else
                        {
                            windowStart = currentPage - 1;
                            windowEnd = currentPage + 1;
                        }

                        for (int i = Math.Max(1, windowStart); i <= Math.Min(totalPages, windowEnd); i++)
                        {
                            pagesToShow.Add(i);
                        }

                        if (currentPage >= totalPages - 1)
                        {
                            for (int i = 1; i <= Math.Min(3, totalPages); i++)
                            {
                                pagesToShow.Add(i);
                            }
                        }
                        else
                        {
                            for (int i = Math.Max(1, totalPages - 2); i <= totalPages; i++)
                            {
                                pagesToShow.Add(i);
                            }
                        }
                    }

                    int lastRenderedPage = 0;
                }

                <div class="home-pagination-shell">
                    <ul class="pagination home-pagination mb-0 p-0">
                        <li class="page-item home-pagination-arrow home-pagination-first @(currentPage == 1 ? "disabled" : "")">
                            <a href="#" class="page-link pointer" data-page="1" title="أول صفحة" aria-label="أول صفحة">
                                <svg class="pagination-arrow-svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                    <path d="M13 6 L19 12 L13 18"></path>
                                    <path d="M5 6 L11 12 L5 18"></path>
                                </svg>
                            </a>
                        </li>

                        <li class="page-item home-pagination-arrow home-pagination-prev @(currentPage == 1 ? "disabled" : "")">
                            <a href="#" class="page-link" data-page="@previousPage" title="الصفحة السابقة" aria-label="الصفحة السابقة">
                                <svg class="pagination-arrow-svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                    <path d="M9 6 L15 12 L9 18"></path>
                                </svg>
                            </a>
                        </li>

                        @foreach (var pageNumber in pagesToShow)
                        {
                            if (lastRenderedPage > 0 && pageNumber - lastRenderedPage > 1)
                            {
                                <li class="page-item home-pagination-ellipsis pagination-ellipsis disabled">
                                    <span class="page-link">...</span>
                                </li>
                            }

                            <li class="page-item home-pagination-number @(currentPage == pageNumber ? "active" : "")">
                                <a href="#" class="page-link" data-page="@pageNumber">@pageNumber</a>
                            </li>

                            lastRenderedPage = pageNumber;
                        }

                        <li class="page-item home-pagination-arrow home-pagination-next @(currentPage == totalPages ? "disabled" : "")">
                            <a href="#" class="page-link" data-page="@nextPage" title="الصفحة التالية" aria-label="الصفحة التالية">
                                <svg class="pagination-arrow-svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                    <path d="M15 6 L9 12 L15 18"></path>
                                </svg>
                            </a>
                        </li>

                        <li class="page-item home-pagination-arrow home-pagination-last @(currentPage == totalPages ? "disabled" : "")">
                            <a href="#" class="page-link" data-page="@totalPages" title="آخر صفحة" aria-label="آخر صفحة">
                                <svg class="pagination-arrow-svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                    <path d="M11 6 L5 12 L11 18"></path>
                                    <path d="M19 6 L13 12 L19 18"></path>
                                </svg>
                            </a>
                        </li>
                    </ul>
                </div>
            </nav>
        </div>
    </div>
</div>

<div id="statusUpdateConfirmBackdrop" class="status-update-confirm-backdrop">
    <div class="status-update-confirm-modal">
        <div class="status-update-confirm-title">
            <i class="fa-solid fa-circle-question text-danger"></i>
            تأكيد تحديث الحالة
        </div>
        <div id="statusUpdateConfirmMessage" class="status-update-confirm-message"></div>

        <div class="status-update-confirm-field">
            <label>الأسباب المختارة</label>
            <div id="statusUpdateReasonsSummary" class="status-update-reasons-summary"></div>
        </div>

        <div id="failureImageArea" class="status-update-confirm-field">
            <label>صورة سبب الفشل</label>
            <input type="file" id="failureReasonImageInput" class="form-control" accept="image/*" />
            <div id="failureImagePasteZone" class="status-update-image-paste-zone" tabindex="0">
                اضغطي هنا ثم Ctrl + V للصق الصورة
            </div>
            <img id="failureReasonImagePreview" class="status-update-image-preview" alt="صورة سبب الفشل" />
        </div>

        <div class="status-update-confirm-actions">
            <button type="button" id="statusUpdateConfirmOk" class="status-update-confirm-ok">موافقة</button>
            <button type="button" id="statusUpdateConfirmCancel" class="status-update-confirm-cancel">تراجع</button>
        </div>
    </div>
</div>



<div id="failureRowImageBackdrop" class="failure-row-image-backdrop">
    <div class="failure-row-image-modal">
        <div class="failure-row-image-title">
            <i class="fa-solid fa-image text-danger"></i>
            صورة سبب فشل الطلب
        </div>
        <div id="failureRowImageReason" class="failure-row-image-reason"></div>
        <div class="failure-row-image-reason-select-field">
            <label for="failureRowReasonSelect">سبب الفشل</label>
            <select id="failureRowReasonSelect" class="inline-failure-select form-control drop-down-design filter-btn failure-row-reason-select">
                <option value="">اختر سبب الفشل</option>
                @foreach (var reasonName in failureReasonOptions)
                {
                    <option value="@reasonName">@reasonName</option>
                }
            </select>
        </div>
        <div id="failureRowImagePasteZone" class="failure-row-image-paste-zone" tabindex="0">
            اضغطي هنا ثم Ctrl + V للصق صورة سبب الفشل - الصورة إجبارية
        </div>
        <input type="file" id="failureRowImageInput" accept="image/*" hidden />
        <div id="failureRowImageError" class="failure-row-image-error">يجب لصق صورة سبب الفشل أولاً.</div>
        <div class="failure-row-image-actions">
            <button type="button" id="failureRowImageSave" class="failure-row-image-save">حفظ</button>
            <button type="button" id="failureRowImageCancel" class="failure-row-image-cancel">إلغاء</button>
        </div>
    </div>
</div>

<script>

    // ============================================================
    // Server-side temporary selections
    // No localStorage/sessionStorage is used here because more than one employee/device may be working.
    // ============================================================
    var pendingFailureReasons = {};
    var pendingDeliveredOrderIds = [];
    var pendingFailureReasonImageFiles = {};
    var pendingFailureReasonImageUrls = {};
    var currentFailureImageOrderId = null;
    var currentFailureImageReason = null;
    var currentFailureImageFile = null;
    var pendingTargetStatus = null;
    var pendingTargetStatusText = null;
    var originalDeliveryCounter = parseInt($('#remainingDeliveryCounter').data('original-count') || '0') || 0;

    function getPendingFailureReasons() {
    return pendingFailureReasons || {};
    }

    function setPendingFailureReasons(value) {
    pendingFailureReasons = value || {};
    }

    function getPendingDeliveredOrderIds() {
    return (pendingDeliveredOrderIds || []).map(String);
    }

    function setPendingDeliveredOrderIds(ids) {
    pendingDeliveredOrderIds = (ids || []).map(String).filter(function (id, index, arr) {
    return id && arr.indexOf(id) === index;
    });
    }

    function removePendingDeliveredOrder(orderId) {
    orderId = String(orderId || '');
    if (!orderId) return;
    setPendingDeliveredOrderIds(getPendingDeliveredOrderIds().filter(function (id) { return String(id) !== orderId; }));
    }

    function removePendingFailureOrders(ids) {
    (ids || []).map(String).forEach(function (id) { delete pendingFailureReasons[id]; delete pendingFailureReasonImageFiles[id]; updateFailureImageButtonState(id); });
    }

    function saveServerSelection(orderId, targetStatus, failureReason, onSuccess, onError, imageFile) {
    var ajaxOptions = {
    url: '/Order/SaveStatusUpdateSelection',
    type: 'POST',
    success: function (result) {
    if (result && result.success) {
    if (result.failureImagePath || result.FailureImagePath) {
    pendingFailureReasonImageUrls[String(orderId)] = result.failureImagePath || result.FailureImagePath;
    }
    if (typeof onSuccess === 'function') onSuccess(result);
    } else {
    showStatusUpdateToast((result && result.message) || 'فشل حفظ التحديد المؤقت', '#dc2626');
    if (typeof onError === 'function') onError(result);
    }
    },
    error: function () {
    showStatusUpdateToast('حدث خطأ أثناء حفظ التحديد المؤقت', '#dc2626');
    if (typeof onError === 'function') onError();
    }
    };

    if (imageFile) {
    var formData = new FormData();
    formData.append('orderId', orderId);
    formData.append('targetStatus', targetStatus);
    formData.append('failureReason', failureReason || '');
    formData.append('failureReasonImageFile', imageFile);
    formData.append('failureReasonImageFile_' + orderId, imageFile);
    formData.append('failedReasonImageFile_' + orderId, imageFile);
    formData.append('failureImageFile_' + orderId, imageFile);
    formData.append('reasonImageFile_' + orderId, imageFile);
    formData.append('imageFile_' + orderId, imageFile);
    ajaxOptions.data = formData;
    ajaxOptions.processData = false;
    ajaxOptions.contentType = false;
    } else {
    ajaxOptions.data = {
    orderId: orderId,
    targetStatus: targetStatus,
    failureReason: failureReason || ''
    };
    }

    $.ajax(ajaxOptions);
    }

    function clearServerSelection(orderId, onSuccess) {
    $.ajax({
    url: '/Order/ClearStatusUpdateSelection',
    type: 'POST',
    data: { orderId: orderId },
    success: function (result) {
    if (result && result.success) {
    if (typeof onSuccess === 'function') onSuccess(result);
    } else {
    showStatusUpdateToast((result && result.message) || 'فشل إلغاء التحديد', '#dc2626');
    }
    },
    error: function () {
    showStatusUpdateToast('حدث خطأ أثناء إلغاء التحديد', '#dc2626');
    }
    });
    }

    function applyServerSelections(selections) {
    var oldFailureReasons = pendingFailureReasons || {};
    var oldFailureFiles = pendingFailureReasonImageFiles || {};
    var oldFailureUrls = pendingFailureReasonImageUrls || {};

    pendingFailureReasons = Object.assign({}, oldFailureReasons);
    pendingFailureReasonImageFiles = Object.assign({}, oldFailureFiles);
    pendingFailureReasonImageUrls = Object.assign({}, oldFailureUrls);
    pendingDeliveredOrderIds = [];

    (selections || []).forEach(function (item) {
    var orderId = String(item.orderId || item.OrderId || '');
    var targetStatus = String(item.targetStatus || item.TargetStatus || '');
    var failureReason = String(item.failureReason || item.FailureReason || '').trim();
    var failureImagePath = String(item.failureImagePath || item.FailureImagePath || '').trim();
    if (!orderId) return;

    if (targetStatus === 'فشل_التسليم') {
    pendingFailureReasons[orderId] = failureReason || pendingFailureReasons[orderId] || '';
    if (failureImagePath) pendingFailureReasonImageUrls[orderId] = failureImagePath;
    } else if (targetStatus === 'تم_التسليم' || targetStatus === 'الطلبات_المعلقة') {
    pendingDeliveredOrderIds.push(orderId);
    }
    });

    setPendingDeliveredOrderIds(pendingDeliveredOrderIds);
    }

    function loadServerSelections(callback) {
    $.ajax({
    url: '/Order/GetStatusUpdateSelections',
    type: 'GET',
    cache: false,
    success: function (result) {
    if (result && result.success) {
    applyServerSelections(result.selections || []);
    }
    },
    complete: function () {
    if (typeof callback === 'function') callback();
    }
    });
    }

    var fallbackFailureReasons = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(failureReasonOptions));

    function showStatusUpdateToast(message, color) {
    var toast = document.createElement('div');
    toast.className = 'status-center-toast';
    toast.textContent = message || '';
    toast.style.background = color || '#18a088';
    document.body.appendChild(toast);

    requestAnimationFrame(function () {
    toast.classList.add('is-visible');
    });

    setTimeout(function () {
    toast.classList.remove('is-visible');
    setTimeout(function () {
    if (toast && toast.parentNode) toast.parentNode.removeChild(toast);
    }, 220);
    }, 2300);
    }

    function escapeHtml(value) {
    return String(value == null ? '' : value)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#039;');
    }

    function getReasonName(reason) {
    if (typeof reason === 'string') return reason;
    return reason?.name || reason?.Name || reason?.text || reason?.Text || reason?.value || reason?.Value || reason?.title || reason?.Title || '';
    }

    function fillFailureSelectOptions($selects, data) {
    var names = [];
    $.each(data || [], function (i, reason) {
    var name = getReasonName(reason);
    if (name && names.indexOf(name) === -1) names.push(name);
    });

    var cleanFallbackReasons = Array.isArray(fallbackFailureReasons) ? fallbackFailureReasons : [];
    names = names.filter(function (name) {
    return name && String(name).trim() !== '' && String(name).indexOf('اختر') === -1;
    });

    cleanFallbackReasons.forEach(function (name) {
    name = String(name || '').trim();
    if (name && names.indexOf(name) === -1) names.push(name);
    });

    if (names.length === 0) {
    names = cleanFallbackReasons;
    }

    $selects.each(function () {
    var $select = $(this);
    var orderId = String($select.data('order-id') || '');
    var preselect = String(pendingFailureReasons[orderId] || $select.attr('data-preselect') || $select.val() || '').trim();

    if ($select.data('select2')) {
    $select.select2('destroy');
    }

    $select.attr('data-failure-ready', 'true');
    $select.empty();
    $select.append('<option value="">اختر سبب الفشل</option>');

    if (preselect && names.indexOf(preselect) === -1) {
    names.push(preselect);
    }

    names.forEach(function (name) {
    $select.append('<option value="' + escapeHtml(name) + '">' + escapeHtml(name) + '</option>');
    });

    if (preselect) {
    $select.val(preselect);
    }
    });

    restorePendingFailureUI();
    }

    function initInlineFailureSelects() {
    var $selects = $('.inline-failure-select').not('[data-failure-ready="true"]');
    if ($selects.length === 0) return;

    $.ajax({
    url: '/DataList/GetAllFailureReasons',
    type: 'GET',
    dataType: 'json',
    cache: false,
    success: function (data) {
    fillFailureSelectOptions($selects, data);
    },
    error: function () {
    fillFailureSelectOptions($selects, fallbackFailureReasons);
    showStatusUpdateToast('تعذر تحميل أسباب الفشل، تم تحميل أسباب افتراضية', '#f59e0b');
    }
    });
    }

    function restorePendingFailureUI() {
    pendingFailureReasons = getPendingFailureReasons();
    Object.keys(pendingFailureReasons || {}).forEach(function (id) {
    var reason = String(pendingFailureReasons[id] || '').trim();
    if (!reason) return;

    var $row = $('tr.order-row[data-order-id="' + id + '"]');
    var $select = $('.inline-failure-select[data-order-id="' + id + '"]');

    if ($select.length) {
    if ($select.find('option[value="' + reason.replace(/"/g, '\\"') + '"]').length === 0) {
    $select.append('<option value="' + escapeHtml(reason) + '">' + escapeHtml(reason) + '</option>');
    }
    $select.val(reason);
    }

    if (pendingFailureReasonImageFiles[String(id)] || pendingFailureReasonImageUrls[String(id)]) {
    $row.addClass('reason-selected');
    $row.find('input[name="selectedOrders"]').prop('checked', true);
    } else {
    $row.removeClass('reason-selected failure-reason-row-active failure-reason-selected-row');
    $row.find('input[name="selectedOrders"]').prop('checked', false);
    updateFailureImageButtonState(id);
    }
    });

    applyCrossPagePendingVisibility();
    updateFailedActionState();
    }

    function applyCrossPagePendingVisibility() {
    var deliveredIds = getPendingDeliveredOrderIds();

    $('tr.order-row').each(function () {
    var $row = $(this);
    var id = String($row.data('order-id') || '');
    var shouldHide = deliveredIds.indexOf(id) !== -1;
    $row.toggle(!shouldHide);
    if (shouldHide) {
    $row.find('input[name="selectedOrders"]').prop('checked', false);
    }
    });

    updateVisibleRowsCounter();
    }

    function updateVisibleRowsCounter() {
    var visibleCount = $('tr.order-row:visible').length;
    $('#ordersTotalCounterTop .orders-total-counter-number').text(visibleCount);
    $('#remainingDeliveryCounter').text(visibleCount).attr('data-original-count', visibleCount);
    originalDeliveryCounter = visibleCount;
    }

    function getSelectedReadyIds() {
    return Object.keys(pendingFailureReasons || {}).filter(function (id) {
    return pendingFailureReasons[id]
    && String(pendingFailureReasons[id]).trim().length > 0
    && (!!pendingFailureReasonImageFiles[String(id)] || !!pendingFailureReasonImageUrls[String(id)]);
    });
    }

    function updateFailedActionState() {
    var readyIds = getSelectedReadyIds();

    $('#updateToFailedDeliveryBtn')
    .toggleClass('is-ready', readyIds.length > 0);

    $('.selected-count-label').text('(' + readyIds.length + ')');
    $('#selectedLiveCounter').text(readyIds.length);

    var remaining = Math.max(originalDeliveryCounter - readyIds.length, 0);
    $('#remainingDeliveryCounter').text(remaining);

    $('tr.order-row').removeClass('reason-selected');

    readyIds.forEach(function (id) {
    $('tr.order-row[data-order-id="' + id + '"]').addClass('reason-selected');
    });
    }

    function updateRepresentativeVisibility() {
    var $rep = $('#DeliveryRepresentativeId');
    if (!$rep.length) return;

    var hasRealOptions = $rep.find('option').filter(function () {
    var v = $(this).val();
    return v !== undefined && v !== null && String(v).trim() !== '' && String(v).trim() !== '-1';
    }).length > 0;

    $('#deliveryRepresentativeFilterCol').toggle(hasRealOptions);
    }

    function updateTopTotalCounterFromResult($result) {
    var totalFromResult = $result.find('#ordersTotalCounterTop .orders-total-counter-number').text().trim();

    if (!totalFromResult) {
    var bottomText = $result.find('.total-items-display').first().text().trim();
    var match = bottomText.match(/\d+/);
    totalFromResult = match ? match[0] : '';
    }

    if (totalFromResult) {
    $('#ordersTotalCounterTop .orders-total-counter-number').text(totalFromResult);
    }
    }

    function loadStatusUpdatePage(page) {
    var data = {
    page: page || 1,
    pageSize: $('#pageSize').val(),
    countryId: $('#CountryId').val(),
    storeId: $('#ManufacturingCompanyId').val(),
    deliverycompanyId: $('#DeliveryCompanyId').val(),
    deliveryrepresentativeId: $('#DeliveryRepresentativeId').val()
    };

    $.ajax({
    url: '/Order/UpdateFailedDelivery',
    type: 'GET',
    data: data,
    success: function (result) {
    var $result = $('<div>').html(result);

    $('#ordersTable').replaceWith($result.find('#ordersTable'));
    if (window.applyStatusUpdateCurrentPageSearch) window.applyStatusUpdateCurrentPageSearch();
    $('#pagination-link').replaceWith($result.find('#pagination-link'));
    $('.total-items-display').text($result.find('.total-items-display').text());

    var newCounter = $result.find('#remainingDeliveryCounter').data('original-count');
    originalDeliveryCounter = parseInt(newCounter || '0') || 0;
    $('#remainingDeliveryCounter').text(originalDeliveryCounter).attr('data-original-count', originalDeliveryCounter);

    updateTopTotalCounterFromResult($result);

    loadServerSelections(function () {
    initInlineFailureSelects();
    restorePendingFailureUI();
    updateFailedActionState();
    updateRepresentativeVisibility();
    hideAllProductsTooltips();
    });
    }
    });
    }

    function resetFailureImageInput() {
    // الصورة بقت مرتبطة بكل صف بجانب دروب داون سبب الفشل، وليست داخل بوب زرار التحديث.
    }

    function setFailurePreview(file) {
    // الصورة بقت مرتبطة بكل صف بجانب دروب داون سبب الفشل، وليست داخل بوب زرار التحديث.
    }

    function updateFailureImageButtonState(orderId) {
    orderId = String(orderId || '');
    var hasImage = !!pendingFailureReasonImageFiles[orderId];
    var $btn = $('.failure-image-inline-btn[data-order-id="' + orderId + '"]');
    $btn.toggleClass('has-image', hasImage);
    $btn.attr('title', hasImage ? 'تم إضافة صورة - اضغطي لتغييرها' : 'إضافة صورة سبب الفشل');
    }

    function resetFailureRowImageModal() {
    currentFailureImageFile = null;
    $('#failureRowImageInput').val('');
    $('#failureRowImageError').hide();
    $('#failureRowImagePasteZone').html('اضغطي هنا ثم Ctrl + V للصق صورة سبب الفشل - الصورة إجبارية');
    }

    function showFailureRowImagePreview(file) {
    if (!file) return;

    if (!file.type || file.type.indexOf('image/') !== 0) {
    $('#failureRowImageError').text('الملف المختار يجب أن يكون صورة.').show();
    return;
    }

    currentFailureImageFile = file;
    $('#failureRowImageError').hide();

    var reader = new FileReader();
    reader.onload = function (event) {
    $('#failureRowImagePasteZone').html('<img src="' + event.target.result + '" alt="صورة سبب الفشل" />');
    };
    reader.readAsDataURL(file);
    }

    function openFailureRowImagePopup(orderId, reason, existingFile) {
    currentFailureImageOrderId = String(orderId || '');
    currentFailureImageReason = String(reason || '').trim();
    resetFailureRowImageModal();

    $('#failureRowImageReason').html('سبب الفشل: <span style="color:#dc2626;">' + escapeHtml(currentFailureImageReason) + '</span>');

    if (existingFile) {
    showFailureRowImagePreview(existingFile);
    }

    $('#failureRowImageBackdrop').addClass('is-visible');
    setTimeout(function () { $('#failureRowImagePasteZone').trigger('focus'); }, 120);
    }

    function closeFailureRowImagePopup() {
    $('#failureRowImageBackdrop').removeClass('is-visible');
    currentFailureImageOrderId = null;
    currentFailureImageReason = null;
    currentFailureImageFile = null;
    }

    function saveFailureRowImageAndSelection() {
    var orderId = String(currentFailureImageOrderId || '');
    if (!orderId) {
    return;
    }

    var savedImageFile = currentFailureImageFile;
    if (!savedImageFile) {
    $('#failureRowImageError').text('صورة سبب الفشل إجبارية. الصقي الصورة Ctrl + V ثم اضغطي حفظ.').show();
    $('#failureRowImagePasteZone').trigger('focus');
    showStatusUpdateToast('صورة سبب الفشل إجبارية', '#dc2626');
    return;
    }

    var reason = String(currentFailureImageReason || '').trim();
    if (!reason) {
    var $reasonSelect = $('.inline-failure-select[data-order-id="' + orderId + '"]');
    reason = String($reasonSelect.val() || '').trim();
    }

    if (!reason) {
    $('#failureRowImageError').text('اختاري سبب الفشل الأول.').show();
    showStatusUpdateToast('اختاري سبب الفشل الأول', '#dc2626');
    return;
    }

    var $row = $('tr.order-row[data-order-id="' + orderId + '"]');
    var $select = $('.inline-failure-select[data-order-id="' + orderId + '"]');

    saveServerSelection(orderId, 'فشل_التسليم', reason, function (result) {
    pendingFailureReasons[orderId] = reason;
    pendingFailureReasonImageFiles[orderId] = savedImageFile;
    if (result && (result.failureImagePath || result.FailureImagePath)) pendingFailureReasonImageUrls[orderId] = result.failureImagePath || result.FailureImagePath;
    removePendingDeliveredOrder(orderId);

    if ($select.length) {
    $select.val(reason);
    }

    $row.addClass('reason-selected');
    $row.find('input[name="selectedOrders"]').prop('checked', true);
    $('#selectAll').prop('checked', false);
    updateFailureImageButtonState(orderId);
    applyCrossPagePendingVisibility();
    updateFailedActionState();
    closeFailureRowImagePopup();
    showStatusUpdateToast('تم حفظ سبب الفشل والصورة', '#18a088');
    }, function () {
    delete pendingFailureReasonImageFiles[orderId];
    delete pendingFailureReasonImageUrls[orderId];
    delete pendingFailureReasonImageUrls[orderId];
    updateFailureImageButtonState(orderId);
    $('#failureRowImageError').text('فشل حفظ الاختيار المؤقت، حاولي مرة أخرى.').show();
    }, savedImageFile);
    }

    function buildReasonsSummary() {
