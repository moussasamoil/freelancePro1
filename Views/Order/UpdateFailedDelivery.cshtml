<script id="status-update-failure-image-required-hard-fix-v18">
    (function () {
    function getBackdrop() {
    return document.getElementById('failureRowImageBackdrop');
    }

    function isPopupVisible() {
    var backdrop = getBackdrop();
    return !!(backdrop && backdrop.classList.contains('is-visible'));
    }

    function hasCurrentPopupImage() {
    return !!window.currentFailureImageFile;
    }

    function forceFocusPasteZone() {
    var zone = document.getElementById('failureRowImagePasteZone');
    if (zone && typeof zone.focus === 'function') {
    setTimeout(function () { zone.focus(); }, 20);
    }
    }

    function blockBackdropClose(event) {
    var backdrop = getBackdrop();
    if (!backdrop || !isPopupVisible()) return;

    if (event.target === backdrop && !hasCurrentPopupImage()) {
    event.preventDefault();
    event.stopPropagation();
    if (event.stopImmediatePropagation) event.stopImmediatePropagation();
    backdrop.classList.add('is-visible');
    forceFocusPasteZone();
    if (typeof window.showStatusUpdateToast === 'function') {
    window.showStatusUpdateToast('صورة سبب الفشل إجبارية، البوب لا يغلق بالضغط خارجها', '#dc2626');
    }
    return false;
    }
    }

    ['click', 'mousedown', 'mouseup', 'pointerdown', 'pointerup', 'touchstart', 'touchend'].forEach(function (eventName) {
    document.addEventListener(eventName, blockBackdropClose, true);
    window.addEventListener(eventName, blockBackdropClose, true);
    });

    document.addEventListener('keydown', function (event) {
    if (!isPopupVisible()) return;
    if ((event.key === 'Escape' || event.keyCode === 27) && !hasCurrentPopupImage()) {
    event.preventDefault();
    event.stopPropagation();
    if (event.stopImmediatePropagation) event.stopImmediatePropagation();
    forceFocusPasteZone();
    if (typeof window.showStatusUpdateToast === 'function') {
    window.showStatusUpdateToast('لا يمكن إغلاق البوب قبل إضافة الصورة', '#dc2626');
    }
    return false;
    }
    }, true);

    function watchBackdrop() {
    var backdrop = getBackdrop();
    if (!backdrop || backdrop.__failureImageRequiredObserverAttached) return;
    backdrop.__failureImageRequiredObserverAttached = true;

    var observer = new MutationObserver(function () {
    if (window.currentFailureImageOrderId && !hasCurrentPopupImage() && !backdrop.classList.contains('is-visible')) {
    backdrop.classList.add('is-visible');
    forceFocusPasteZone();
    }
    });

    observer.observe(backdrop, { attributes: true, attributeFilter: ['class', 'style'] });
    }

    if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', watchBackdrop);
    } else {
    watchBackdrop();
    }
    window.addEventListener('load', watchBackdrop);
    })();
</script>

