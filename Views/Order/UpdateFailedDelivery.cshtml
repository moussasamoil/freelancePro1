        .status-update-inline-history-copy,
        .status-update-inline-history-image {
        border: 1px solid #dbe4ef;
        background: #f8fafc;
        color: #18a088;
        border-radius: 999px;
        min-height: 24px;
        padding: 0 10px;
        font-size: 11px;
        font-weight: 900;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
        }

        .status-update-inline-history-copy:hover,
        .status-update-inline-history-image:hover {
        background: #e9fbe9;
        color: #159447;
        }

        .status-update-report-count-badge {
        pointer-events: none !important;
        }
    </style>

    @if (User.IsInRole("Admin") || User.IsInRole("ExecutiveDirector") || User.IsInRole("FollowUpDepartment") || User.IsInRole("CallCenter"))
    {
        <div class="status-update-header-actions">
            <button type="button" class="status-update-header-report-btn problem has-report-count" data-quick-report-type="0" data-quick-report-title="التبليغ عن مشكلة">
                <span id="statusUpdateMyProblemReportsCount" class="status-update-report-count-badge" title="عدد الإبلاغات التي أرسلتها">0</span>
                <i class="fa-solid fa-triangle-exclamation"></i>
                التبليغ عن مشكلة
            </button>
            <button type="button" class="status-update-header-report-btn edit-note has-report-count" data-quick-report-type="1" data-quick-report-title="تبليغ عن تعديل فوري">
                <span id="statusUpdateMyEditReportsCount" class="status-update-report-count-badge" title="عدد التعديلات الفورية التي أرسلتها">0</span>
                <i class="fa-solid fa-pen-to-square"></i>
                تبليغ عن تعديل فوري
