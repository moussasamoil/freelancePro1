<script id="fix21-failure-image-real-img-final">
    (function () {
    function getFailureImageFile(orderId) {
    orderId = String(orderId || '');
    try {
    if (window.pendingFailureReasonImageFiles && window.pendingFailureReasonImageFiles[orderId]) {
    return window.pendingFailureReasonImageFiles[orderId];
    }
    } catch (e) { }
    try {
    if (typeof pendingFailureReasonImageFiles !== 'undefined' && pendingFailureReasonImageFiles && pendingFailureReasonImageFiles[orderId]) {
    return pendingFailureReasonImageFiles[orderId];
    }
    } catch (e) { }
    return null;
    }

    function escapeAttr(value) {
    return String(value || '')
    .replace(/&/g, '&amp;')
    .replace(/"/g, '&quot;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;');
    }

    function renderRealFailureImage(orderId, dataUrl) {
    orderId = String(orderId || '');
    var btn = document.querySelector('.failure-image-inline-btn[data-order-id="' + orderId + '"]');
    var thumb = document.querySelector('.failure-image-thumb-btn[data-order-id="' + orderId + '"]');
    if (!btn) return;

    if (!dataUrl) {
    btn.classList.remove('has-image');
    btn.removeAttribute('data-full-src');
    btn.style.backgroundImage = '';
    btn.innerHTML = '<i class="fa-solid fa-image"></i>';
    btn.title = 'إضافة صورة سبب الفشل بالنسخ Ctrl + V';
    if (thumb) {
    thumb.classList.remove('is-visible');
    thumb.style.display = 'none';
    var oldImg = thumb.querySelector('img');
    if (oldImg) oldImg.removeAttribute('src');
    }
    return;
    }

    btn.classList.add('has-image');
    btn.setAttribute('data-full-src', dataUrl);
    btn.title = 'اضغطي لعرض صورة الفشل';
    btn.style.backgroundImage = 'none';
    btn.innerHTML = '<img class="failure-preview-img" src="' + escapeAttr(dataUrl) + '" alt="صورة الفشل" />';

    if (thumb) {
    thumb.classList.remove('is-visible');
    thumb.style.display = 'none';
    var thumbImg = thumb.querySelector('img');
    if (thumbImg) thumbImg.src = dataUrl;
    }
    }

    function refreshRealFailureImage(orderId) {
    orderId = String(orderId || '');
    var file = getFailureImageFile(orderId);
    if (!file) {
    renderRealFailureImage(orderId, '');
    return;
    }

    if (file.__failurePreviewDataUrl) {
    renderRealFailureImage(orderId, file.__failurePreviewDataUrl);
    return;
    }

    var reader = new FileReader();
    reader.onload = function (event) {
    var dataUrl = event && event.target ? event.target.result : '';
    try { file.__failurePreviewDataUrl = dataUrl; } catch (e) { }
    renderRealFailureImage(orderId, dataUrl);
    };
    reader.readAsDataURL(file);
    }

    var previousUpdateFailureImageButtonStateFix21 = window.updateFailureImageButtonState;
    window.updateFailureImageButtonState = function (orderId) {
    if (typeof previousUpdateFailureImageButtonStateFix21 === 'function') {
    try { previousUpdateFailureImageButtonStateFix21(orderId); } catch (e) { }
    }
    setTimeout(function () { refreshRealFailureImage(orderId); }, 30);
    };

    document.addEventListener('click', function (event) {
    var btn = event.target.closest && event.target.closest('.failure-image-inline-btn.has-image');
    if (!btn) return;
    var src = btn.getAttribute('data-full-src') || '';
    var img = btn.querySelector('img.failure-preview-img');
    if (!src && img) src = img.getAttribute('src') || '';
    if (!src) return;
    event.preventDefault();
    event.stopPropagation();
    if (event.stopImmediatePropagation) event.stopImmediatePropagation();
    if (window.jQuery) {
    $('#failureImageZoomContent').html('<img src="' + src + '" alt="صورة الفشل" style="max-width:100%;max-height:70vh;border-radius:12px;object-fit:contain;" />');
    $('#failureImageZoomBackdrop').addClass('is-visible').css('display', 'flex');
    }
    }, true);

    document.addEventListener('DOMContentLoaded', function () {
    setTimeout(function () {
    document.querySelectorAll('.failure-image-inline-btn[data-order-id]').forEach(function (btn) {
    refreshRealFailureImage(btn.getAttribute('data-order-id'));
    });
    }, 150);
    });
    })();
</script>

