<script id="fix11-failed-cancel-preview-script">
    (function () {
    window.cancelFailureFromInline = function (event, orderId) {
    if (event) { event.preventDefault(); event.stopPropagation(); }
    orderId = String(orderId || '');
    if (!orderId) return false;
    if (typeof clearServerSelection !== 'function') return false;
    clearServerSelection(orderId, function () {
    delete pendingFailureReasons[orderId];
    delete pendingFailureReasonImageFiles[orderId];
    delete pendingFailureReasonImageUrls[orderId];
    var $row = $('tr.order-row[data-order-id="' + orderId + '"]');
    $row.removeClass('reason-selected');
    $row.find('input[name="selectedOrders"]').prop('checked', false);
    var $select = $('.inline-failure-select[data-order-id="' + orderId + '"]');
    $select.val('');
    if (typeof updateFailureImageButtonState === 'function') updateFailureImageButtonState(orderId);
    if (typeof updateFailedActionState === 'function') updateFailedActionState();
    if (typeof showStatusUpdateToast === 'function') showStatusUpdateToast('تم إلغاء تحديد الطلب', '#dc2626');
    });
    return false;
    };

    window.updateFailureImageButtonState = function (orderId) {
    orderId = String(orderId || '');
    var file = pendingFailureReasonImageFiles ? pendingFailureReasonImageFiles[orderId] : null;
    var hasImage = !!file;
    var $btn = $('.failure-image-inline-btn[data-order-id="' + orderId + '"]');
    var $thumb = $('.failure-image-thumb-btn[data-order-id="' + orderId + '"]');
    var $img = $thumb.find('img');
    $btn.toggleClass('has-image', hasImage);
    $btn.attr('title', hasImage ? 'تم إضافة صورة - Ctrl + V لتغييرها' : 'إضافة صورة سبب الفشل بالنسخ Ctrl + V');
    if (!hasImage) {
    $thumb.removeClass('is-visible');
    $img.attr('src', '');
    return;
    }
    var reader = new FileReader();
    reader.onload = function (e) {
    $img.attr('src', e.target.result);
    $thumb.attr('data-full-src', e.target.result).addClass('is-visible');
    };
    reader.readAsDataURL(file);
    };

    $(document).on('click', '.failure-image-thumb-btn', function (event) {
    event.preventDefault();
    event.stopPropagation();
    var src = $(this).attr('data-full-src') || $(this).find('img').attr('src') || '';
    if (!src) return false;
    $('#failureImageZoomContent').html('<img src="' + src + '" alt="صورة الفشل" style="max-width:100%;max-height:70vh;border-radius:12px;object-fit:contain;" />');
    $('#failureImageZoomBackdrop').addClass('is-visible').css('display', 'flex');
    return false;
    });

    $(document).on('click', '#failureImageZoomClose, #failureImageZoomBackdrop', function (event) {
    if (event.target.id === 'failureImageZoomBackdrop' || event.target.id === 'failureImageZoomClose') {
    $('#failureImageZoomBackdrop').removeClass('is-visible').hide();
    }
    });
    })();
</script>


