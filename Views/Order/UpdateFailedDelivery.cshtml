    })
    .empty();
    $('.failure-image-thumb-btn[data-order-id="' + orderId + '"]').removeClass('is-visible').hide();
    }

    function renderProfileImage(orderId) {
    orderId = String(orderId || '');
    if (!orderId) return;
    var file = getOrderImageFile(orderId);
    if (!file) {
    clearProfileImage(orderId);
    return;
    }
    if (file.__failurePreviewDataUrl) {
    setProfileImage(orderId, file.__failurePreviewDataUrl);
