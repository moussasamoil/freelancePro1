<script id="fix12-failure-single-image-thumb-script">
    (function () {
    function getFailureFile(orderId) {
    try {
    if (typeof pendingFailureReasonImageFiles !== 'undefined' && pendingFailureReasonImageFiles) {
    return pendingFailureReasonImageFiles[String(orderId)] || null;
    }
    } catch (e) { }
    return null;
    }

    function setSingleFailureImageButton(orderId, dataUrl) {
    var $btn = $('.failure-image-inline-btn[data-order-id="' + orderId + '"]');
    var $thumb = $('.failure-image-thumb-btn[data-order-id="' + orderId + '"]');
    $thumb.removeClass('is-visible').hide().find('img').attr('src', '');

    if (!$btn.length) return;
    if (!dataUrl) {
    $btn.removeClass('has-image')
    .removeAttr('data-full-src')
    .css('background-image', '')
    .attr('title', 'إضافة صورة سبب الفشل بالنسخ Ctrl + V')
    .html('<i class="fa-solid fa-image"></i>');
    return;
    }

    $btn.addClass('has-image')
    .attr('data-full-src', dataUrl)
    .attr('title', 'عرض صورة الفشل')
    .css('background-image', 'url(' + dataUrl + ')')
    .empty();
    }

    var previousUpdateFailureImageButtonState = window.updateFailureImageButtonState;
    window.updateFailureImageButtonState = function (orderId) {
    orderId = String(orderId || '');
    var file = getFailureFile(orderId);
    if (!file) {
    setSingleFailureImageButton(orderId, '');
    if (typeof previousUpdateFailureImageButtonState === 'function') {
    try { previousUpdateFailureImageButtonState(orderId); } catch (e) { }
    }
    setSingleFailureImageButton(orderId, '');
    return;
    }

    var reader = new FileReader();
    reader.onload = function (event) {
    setSingleFailureImageButton(orderId, event.target.result || '');
    };
    reader.readAsDataURL(file);
    };

    document.addEventListener('click', function (event) {
    var btn = event.target.closest && event.target.closest('.failure-image-inline-btn.has-image');
    if (!btn) return;
    event.preventDefault();
    event.stopPropagation();
    if (typeof event.stopImmediatePropagation === 'function') event.stopImmediatePropagation();
    var src = btn.getAttribute('data-full-src') || '';
    if (!src) return false;
    if (window.jQuery) {
    $('#failureImageZoomContent').html('<img src="' + src + '" alt="صورة الفشل" style="max-width:100%;max-height:70vh;border-radius:12px;object-fit:contain;" />');
    $('#failureImageZoomBackdrop').addClass('is-visible').css('display', 'flex');
    }
    return false;
    }, true);
    })();
</script>


