<script id="split-status-panel-column-script">
    (function () {
    var params = new URLSearchParams(window.location.search || '');
    if (!params.has('splitPanel')) {
    return;
    }

    document.documentElement.classList.add('split-status-panel');

    var hiddenHeaderTexts = [
    'رقم الوصل',
    'رقم وصل',
    'التاريخ',
    'اخر تحديث',
    'آخر تحديث',
    'الدولة',
    'شركة توصيل',
    'شركة التوصيل'
    ];

    function normalizeArabicText(value) {
    return (value || '')
    .replace(/\s+/g, ' ')
    .replace(/أ|إ|آ/g, 'ا')
    .replace(/ة/g, 'ه')
    .trim();
    }

    function shouldHideHeader(text) {
    var normalized = normalizeArabicText(text);
    return hiddenHeaderTexts.some(function (needle) {
    return normalized.indexOf(normalizeArabicText(needle)) !== -1;
    });
    }

    function hideColumnsInTable(table) {
    if (!table) return;

    var headerCells = Array.prototype.slice.call(table.querySelectorAll('thead th'));
    if (!headerCells.length) return;

    var hiddenIndexes = [];
    headerCells.forEach(function (th, index) {
    var text = (th.textContent || '').trim();
    if (shouldHideHeader(text)) {
    hiddenIndexes.push(index);
    }
    });

    if (!hiddenIndexes.length) return;

    headerCells.forEach(function (th) {
    th.classList.remove('split-panel-hidden-column');
    });

    Array.prototype.slice.call(table.querySelectorAll('tbody tr')).forEach(function (row) {
    Array.prototype.slice.call(row.children).forEach(function (cell) {
    cell.classList.remove('split-panel-hidden-column');
    });
    });

    hiddenIndexes.forEach(function (index) {
    if (headerCells[index]) {
    headerCells[index].classList.add('split-panel-hidden-column');
    }

    Array.prototype.slice.call(table.querySelectorAll('tbody tr')).forEach(function (row) {
    if (row.children[index]) {
    row.children[index].classList.add('split-panel-hidden-column');
    }
    });
    });
    }

    function applySplitPanelTableFix() {
    hideColumnsInTable(document.getElementById('ordersTable'));
    }

    if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', applySplitPanelTableFix);
    } else {
    applySplitPanelTableFix();
    }

    var observer = new MutationObserver(function () {
    window.clearTimeout(window.__splitPanelColumnTimer);
    window.__splitPanelColumnTimer = window.setTimeout(applySplitPanelTableFix, 60);
    });

    observer.observe(document.body, {
    childList: true,
    subtree: true
    });
    })();
</script>


<script id="keep-failure-selections-until-cancel-final-fix">
    (function () {
    // يمنع أي كود قديم من تصفير الاختيارات تلقائيًا. الاختيار لا يروح إلا بزر إلغاء أو بعد التحديث النهائي.
    window.__statusUpdateKeepSelectionsUntilCancel = true;

    function normalizeTempImageUrl(url) {
    url = String(url || '').trim();
    if (!url) return '';
    if (url.indexOf('http://') === 0 || url.indexOf('https://') === 0 || url.indexOf('/') === 0 || url.indexOf('data:') === 0) return url;
    return '/' + url.replace(/^\/+/, '');
    }

    function applyImageUrlToButton(orderId, url) {
    url = normalizeTempImageUrl(url);
    var $btn = $('.failure-image-inline-btn[data-order-id="' + orderId + '"]');
    if (!$btn.length || !url) return;
    $btn.addClass('has-image')
    .attr('data-full-src', url)
    .attr('title', 'عرض صورة الفشل')
    .css('background-image', 'url(' + url + ')')
    .empty();
    }

    var oldUpdateFailureImageButtonState = window.updateFailureImageButtonState;
    window.updateFailureImageButtonState = function (orderId) {
    orderId = String(orderId || '');
    var url = pendingFailureReasonImageUrls && pendingFailureReasonImageUrls[orderId];
    if (url && !(pendingFailureReasonImageFiles && pendingFailureReasonImageFiles[orderId])) {
    applyImageUrlToButton(orderId, url);
    return;
    }
    if (typeof oldUpdateFailureImageButtonState === 'function') {
    oldUpdateFailureImageButtonState(orderId);
    }
    };

    var oldRestorePendingFailureUI = window.restorePendingFailureUI;
    window.restorePendingFailureUI = function () {
    if (typeof oldRestorePendingFailureUI === 'function') {
    oldRestorePendingFailureUI();
    }
    Object.keys(pendingFailureReasons || {}).forEach(function (id) {
    var reason = String(pendingFailureReasons[id] || '').trim();
    var hasImage = !!(pendingFailureReasonImageFiles && pendingFailureReasonImageFiles[id]) || !!(pendingFailureReasonImageUrls && pendingFailureReasonImageUrls[id]);
    if (!reason || !hasImage) return;
    var $row = $('tr.order-row[data-order-id="' + id + '"]');
    $row.addClass('reason-selected').show();
    $row.find('input[name="selectedOrders"]').prop('checked', true);
    var $select = $('.inline-failure-select[data-order-id="' + id + '"]');
    if ($select.length) {
    if ($select.find('option[value="' + reason.replace(/"/g, '\\"') + '"]').length === 0) {
    $select.append('<option value="' + escapeHtml(reason) + '">' + escapeHtml(reason) + '</option>');
    }
    $select.val(reason);
    }
    if (pendingFailureReasonImageUrls && pendingFailureReasonImageUrls[id]) {
    applyImageUrlToButton(id, pendingFailureReasonImageUrls[id]);
    }
    });
    if (typeof updateFailedActionState === 'function') updateFailedActionState();
    };
    })();
</script>


<script id="status-update-current-page-search-script">
    (function () {
    function normalizeSearchText(value) {
    value = String(value == null ? '' : value)
    .replace(/[٠-٩]/g, function (d) { return '٠١٢٣٤٥٦٧٨٩'.indexOf(d); })
    .replace(/[۰-۹]/g, function (d) { return '۰۱۲۳۴۵۶۷۸۹'.indexOf(d); })
    .replace(/[⁦⁧⁨⁩]/g, '')
    .toLowerCase()
    .trim();

    if (value.indexOf('09') === 0) {
    value = value.substring(1);
    }

    return value;
    }

    function applyCurrentPageSearch() {
    var input = document.getElementById('statusUpdateCurrentSearch');
    if (!input) return;

    var query = normalizeSearchText(input.value);
    var rows = Array.prototype.slice.call(document.querySelectorAll('#ordersTable tbody tr.order-row'));
    var visibleCount = 0;

    rows.forEach(function (row) {
    var haystack = normalizeSearchText(row.innerText || row.textContent || '');
    var phoneCells = Array.prototype.slice.call(row.querySelectorAll('[data-copy-text]'))
    .map(function (cell) { return cell.getAttribute('data-copy-text') || ''; })
    .join(' ');
    haystack += ' ' + normalizeSearchText(phoneCells);

    var visible = !query || haystack.indexOf(query) !== -1;
    row.style.display = visible ? '' : 'none';
    if (visible) visibleCount++;
    });

    var empty = document.getElementById('statusUpdateCurrentSearchEmpty');
    if (empty) empty.style.display = query && visibleCount === 0 ? 'block' : 'none';

    if (typeof updateVisibleRowsCounter === 'function') {
    updateVisibleRowsCounter();
    }
    }

    document.addEventListener('input', function (event) {
    if (event.target && event.target.id === 'statusUpdateCurrentSearch') {
    applyCurrentPageSearch();
    }
    }, true);

    window.applyStatusUpdateCurrentPageSearch = applyCurrentPageSearch;
    })();
</script>
