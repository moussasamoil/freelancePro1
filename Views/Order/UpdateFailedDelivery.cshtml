    $(document).on('click', '#failureRowImageSave', saveFailureRowImageAndSelection);
    $(document).on('click', '#failureRowImageCancel', function (event) { event.preventDefault(); event.stopPropagation(); showStatusUpdateToast('يجب إضافة صورة سبب الفشل أولاً', '#dc2626'); });

    $(document).on('mousedown pointerdown', '#failureRowImageBackdrop', function (event) {
