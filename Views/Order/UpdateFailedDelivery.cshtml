<script id="collaborative-failed-status-selection-script">
    (function () {
    var currentUserId = '@(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "")';
    window.statusUpdateCurrentUserId = currentUserId;
    window.statusUpdateSelectionsByOrderId = window.statusUpdateSelectionsByOrderId || {};
    window.pendingFailureReasonImageUrls = window.pendingFailureReasonImageUrls || {};

    function norm(value) {
    return String(value == null ? '' : value);
    }


    function friendlySelectedByName(value) {
    var atSign = String.fromCharCode(64);
    var text = norm(value).trim();
    if (!text) return 'موظف آخر';
    if (text.indexOf(atSign) > -1) {
    text = text.split(atSign)[0]
    .replace(/[._-]+/g, ' ')
    .replace(/\s+/g, ' ')
    .trim();
    }
    return text || 'موظف آخر';
    }

    function getSelValue(sel, lower, upper) {
    if (!sel) return '';
    return sel[lower] != null ? sel[lower] : (sel[upper] != null ? sel[upper] : '');
    }

    function normalizeSelection(item) {
    if (!item) return null;
    var orderId = norm(getSelValue(item, 'orderId', 'OrderId'));
    if (!orderId) return null;
    return {
    orderId: orderId,
    targetStatus: norm(getSelValue(item, 'targetStatus', 'TargetStatus')),
    failureReason: norm(getSelValue(item, 'failureReason', 'FailureReason')).trim(),
    failureImagePath: norm(getSelValue(item, 'failureImagePath', 'FailureImagePath')).trim(),
    selectedByUserId: norm(getSelValue(item, 'selectedByUserId', 'SelectedByUserId')),
    selectedByName: friendlySelectedByName(getSelValue(item, 'selectedByName', 'SelectedByName')),
    selectedAt: getSelValue(item, 'selectedAt', 'SelectedAt'),
    isActive: item.isActive !== false && item.IsActive !== false
    };
    }

    function isMine(sel) {
    if (!sel) return false;
    if (!sel.selectedByUserId) return true;
    return norm(sel.selectedByUserId) === norm(currentUserId);
    }

    function normalizeImagePath(path) {
    path = norm(path).trim();
    if (!path) return '';
    if (path.indexOf('http://') === 0 || path.indexOf('https://') === 0 || path.indexOf('/') === 0) return path;
    return '/' + path.replace(/^\/+/, '');
    }

    function ensureOtherCounter() {
    if (document.getElementById('otherSelectedLiveCounter')) {
    var existingCard = document.getElementById('otherSelectedLiveCounter').closest('.status-update-live-card');
    if (existingCard) existingCard.classList.add('other-employee-live-card');
    return;
    }

    var center = document.querySelector('.status-update-live-counter-center');
    if (!center) return;

    var card = document.createElement('div');
    card.className = 'status-update-live-card other-employee-live-card';
    card.innerHTML =
    '<div class="status-update-live-icon"><i class="fa-solid fa-user-lock"></i></div>' +
    '<div class="status-update-live-number" id="otherSelectedLiveCounter">0</div>' +
    '<div class="status-update-live-label">محدد بواسطة موظف آخر</div>';
    center.appendChild(card);
    }

    function setFailureButtonImage(orderId, imageUrl) {
    imageUrl = normalizeImagePath(imageUrl);
    var btn = document.querySelector('.failure-image-inline-btn[data-order-id="' + orderId + '"]');
    if (!btn) return;

    if (!imageUrl) {
    if (!window.pendingFailureReasonImageFiles || !window.pendingFailureReasonImageFiles[orderId]) {
    btn.classList.remove('has-image');
    btn.removeAttribute('data-full-src');
    btn.style.backgroundImage = '';
    btn.innerHTML = '<i class="fa-solid fa-image"></i>';
    btn.title = 'إضافة صورة سبب الفشل';
    }
    return;
    }

    btn.classList.add('has-image');
    btn.setAttribute('data-full-src', imageUrl);
    btn.title = 'عرض صورة الفشل';
    btn.style.backgroundImage = 'none';
    btn.innerHTML = '<img class="failure-preview-img" src="' + imageUrl.replace(/"/g, '&quot;') + '" alt="صورة الفشل" />';
    }

    function getOwnFailureIds() {
    var ids = [];
    Object.keys(window.statusUpdateSelectionsByOrderId || {}).forEach(function (id) {
    var sel = window.statusUpdateSelectionsByOrderId[id];
    if (!sel || sel.targetStatus !== 'فشل_التسليم' || !isMine(sel)) return;
    if (!sel.failureReason) return;
    if ((window.pendingFailureReasonImageFiles && window.pendingFailureReasonImageFiles[id]) || sel.failureImagePath) {
    ids.push(id);
    }
    });
    return ids;
    }

    function getOtherFailureIds() {
    var ids = [];
    Object.keys(window.statusUpdateSelectionsByOrderId || {}).forEach(function (id) {
    var sel = window.statusUpdateSelectionsByOrderId[id];
    if (sel && sel.targetStatus === 'فشل_التسليم' && !isMine(sel)) ids.push(id);
    });
    return ids;
    }

    window.getSelectedReadyIds = function () {
    return getOwnFailureIds();
    };

    window.applyCrossPagePendingVisibility = function () {
    var hiddenCountChanged = false;

    $('tr.order-row').each(function () {
    var $row = $(this);
    var id = norm($row.data('order-id'));
    var sel = window.statusUpdateSelectionsByOrderId[id];
    var shouldHide = !!(sel && (sel.targetStatus === 'تم_التسليم' || sel.targetStatus === 'الطلبات_المعلقة'));

    $row.toggle(!shouldHide);
    if (shouldHide) {
    hiddenCountChanged = true;
    $row.find('input[name="selectedOrders"]').prop('checked', false);
    }
    });

    if (typeof updateVisibleRowsCounter === 'function') {
    updateVisibleRowsCounter();
    }
    return hiddenCountChanged;
    };

    function addOtherBadge($row, name) {
    if (!$row || !$row.length) return;
    $row.find('.status-selected-by-other-badge').remove();
    $row.attr('data-selected-by-other-name', name || 'موظف آخر');
    $row.attr('title', '');
    }

    function removeOtherBadge($row) {
    if (!$row || !$row.length) return;
    $row.find('.status-selected-by-other-badge').remove();
    $row.removeAttr('data-selected-by-other-name');
    }

    function ensureOtherSelectionTooltipPortal() {
    var portal = document.getElementById('statusSelectedByOtherTooltipPortal');
    if (portal) return portal;

    portal = document.createElement('div');
    portal.id = 'statusSelectedByOtherTooltipPortal';
    portal.className = 'status-selected-by-other-tooltip-portal';

    var title = document.createElement('span');
    title.className = 'status-selected-by-other-tooltip-title';
    title.textContent = 'مستخدم من قبل موظف آخر';

    var name = document.createElement('span');
    name.className = 'status-selected-by-other-tooltip-name';

    portal.appendChild(title);
    portal.appendChild(name);
    document.body.appendChild(portal);
    return portal;
    }

    function showOtherSelectionTooltip(row) {
    if (!row || !row.classList || !row.classList.contains('status-selected-by-other')) return;

    var portal = ensureOtherSelectionTooltipPortal();
    var nameNode = portal.querySelector('.status-selected-by-other-tooltip-name');
    if (nameNode) {
    nameNode.textContent = row.getAttribute('data-selected-by-other-name') || 'موظف آخر';
    }

    portal.classList.add('is-visible');
    var rect = row.getBoundingClientRect();
    var portalRect = portal.getBoundingClientRect();
    var top = rect.top - portalRect.height - 10;
    var left = rect.left + (rect.width / 2) - (portalRect.width / 2);

    if (top < 8) {
    top = rect.bottom + 10;
    portal.style.setProperty('--tooltip-arrow-bottom', 'auto');
    }

    left = Math.max(8, Math.min(left, window.innerWidth - portalRect.width - 8));
    portal.style.top = top + 'px';
    portal.style.left = left + 'px';
    }

    function hideOtherSelectionTooltip() {
    var portal = document.getElementById('statusSelectedByOtherTooltipPortal');
    if (portal) portal.classList.remove('is-visible');
    }

    document.addEventListener('mouseover', function (event) {
    var row = event.target.closest && event.target.closest('tr.status-selected-by-other');
    if (row) showOtherSelectionTooltip(row);
    });

    document.addEventListener('mouseout', function (event) {
    var row = event.target.closest && event.target.closest('tr.status-selected-by-other');
    if (!row) return;
    var next = event.relatedTarget;
    if (next && row.contains(next)) return;
    hideOtherSelectionTooltip();
    });

    window.addEventListener('scroll', hideOtherSelectionTooltip, true);
    window.addEventListener('resize', hideOtherSelectionTooltip);

    function applyCollaborativeFailureRows() {
    ensureOtherCounter();

    $('tr.order-row').each(function () {
    var $row = $(this);
    var id = norm($row.data('order-id'));
    var sel = window.statusUpdateSelectionsByOrderId[id];

    $row.removeClass('status-selected-by-other status-selected-by-me');
    removeOtherBadge($row);
    $row.find('select, input, button').prop('disabled', false);
    $row.find('.select2-selection').attr('aria-disabled', 'false');

    if (!sel || sel.targetStatus !== 'فشل_التسليم') {
    if (!window.pendingFailureReasonImageFiles || !window.pendingFailureReasonImageFiles[id]) {
    if (!sel) {
    $row.removeClass('reason-selected failure-reason-row-active failure-reason-selected-row');
    }
    }
    return;
    }

    var mine = isMine(sel);
    var reason = sel.failureReason || '';
    var $select = $('.inline-failure-select[data-order-id="' + id + '"]');

    $row.show().addClass('reason-selected').toggleClass('status-selected-by-me', mine);
    if ($select.length && reason) {
    if ($select.find('option[value="' + reason.replace(/"/g, '\\"') + '"]').length === 0) {
    $select.append('<option value="' + reason.replace(/"/g, '&quot;') + '">' + reason + '</option>');
    }
    $select.val(reason);
    }
    $row.find('input[name="selectedOrders"]').prop('checked', true);
    if (sel.failureImagePath) {
    setFailureButtonImage(id, sel.failureImagePath);
    }

    if (!mine) {
    $row.addClass('status-selected-by-other');
    addOtherBadge($row, sel.selectedByName);
    $row.find('select, input, button').prop('disabled', true);
    $row.find('.failure-image-inline-btn.has-image').prop('disabled', false);
    $row.find('.select2-selection').attr('aria-disabled', 'true');
    }
    });

    updateFailedActionState();
    }

    window.updateFailedActionState = function () {
    ensureOtherCounter();

    var ownIds = getOwnFailureIds();
    var otherIds = getOtherFailureIds();
    $('#updateToFailedDeliveryBtn').toggleClass('is-ready', ownIds.length > 0);
    $('.selected-count-label').text('(' + ownIds.length + ')');
    $('#selectedLiveCounter').text(ownIds.length);
    $('#otherSelectedLiveCounter').text(otherIds.length);

    var baseCount = parseInt($('#remainingDeliveryCounter').attr('data-original-count') || originalDeliveryCounter || '0') || 0;
    var remaining = Math.max(baseCount - ownIds.length - otherIds.length, 0);
    $('#remainingDeliveryCounter').text(remaining);
    };

    window.applyServerSelections = function (selections) {
    pendingFailureReasons = {};
    pendingDeliveredOrderIds = [];
    window.statusUpdateSelectionsByOrderId = {};
    window.pendingFailureReasonImageUrls = {};

    (selections || []).forEach(function (raw) {
    var sel = normalizeSelection(raw);
    if (!sel || !sel.isActive) return;

    window.statusUpdateSelectionsByOrderId[sel.orderId] = sel;

    if (sel.targetStatus === 'فشل_التسليم') {
    pendingFailureReasons[sel.orderId] = sel.failureReason || 'فشل التسليم';
    if (sel.failureImagePath) {
    window.pendingFailureReasonImageUrls[sel.orderId] = sel.failureImagePath;
    }
    } else if (sel.targetStatus === 'تم_التسليم' || sel.targetStatus === 'الطلبات_المعلقة') {
    if (pendingDeliveredOrderIds.indexOf(sel.orderId) === -1) {
    pendingDeliveredOrderIds.push(sel.orderId);
    }
    }
    });

    serverSelectionsLoaded = true;
    applyCrossPagePendingVisibility();
    applyCollaborativeFailureRows();
    };

    window.loadServerSelections = function (callback) {
    $.ajax({
    url: '/Order/GetStatusUpdateSelections',
    type: 'GET',
    cache: false,
    success: function (result) {
    if (result && result.success) {
    if (result.currentUserId) {
    currentUserId = norm(result.currentUserId);
    window.statusUpdateCurrentUserId = currentUserId;
    }
    applyServerSelections(result.selections || []);
    }
    },
    complete: function () {
    if (typeof callback === 'function') callback();
    applyCollaborativeFailureRows();
    }
    });
    };

    window.saveServerSelection = function (orderId, targetStatus, failureReason, onSuccess, onError) {
    orderId = norm(orderId);
    var existing = window.statusUpdateSelectionsByOrderId[orderId];
    if (existing && !isMine(existing)) {
    showStatusUpdateToast('هذا الطلب محدد بواسطة ' + (existing.selectedByName || 'موظف آخر'), '#dc2626');
    if (typeof onError === 'function') onError(existing);
    return;
    }

    var formData = new FormData();
    formData.append('orderId', orderId);
    formData.append('targetStatus', targetStatus || '');
    formData.append('failureReason', failureReason || '');

    if (targetStatus === 'فشل_التسليم') {
    var file = null;
    try {
    if (norm(currentFailureImageOrderId) === orderId && currentFailureImageFile) file = currentFailureImageFile;
    } catch (e) { }
    if (!file && window.pendingFailureReasonImageFiles && window.pendingFailureReasonImageFiles[orderId]) {
    file = window.pendingFailureReasonImageFiles[orderId];
    }
    if (file) {
    formData.append('failureReasonImageFile', file);
    formData.append('failureReasonImageFile_' + orderId, file);
    formData.append('failureImageFile_' + orderId, file);
    formData.append('reasonImageFile_' + orderId, file);
    formData.append('imageFile_' + orderId, file);
    }
    }

    $.ajax({
    url: '/Order/SaveStatusUpdateSelection',
    type: 'POST',
    data: formData,
    processData: false,
    contentType: false,
    success: function (result) {
    if (result && result.success) {
    var sel = normalizeSelection(result);
    if (sel) {
    window.statusUpdateSelectionsByOrderId[orderId] = sel;
    if (sel.failureImagePath) window.pendingFailureReasonImageUrls[orderId] = sel.failureImagePath;
    }
    if (typeof onSuccess === 'function') onSuccess(result);
    applyCollaborativeFailureRows();
    } else {
    showStatusUpdateToast((result && result.message) || 'فشل حفظ التحديد المؤقت', '#dc2626');
    if (typeof onError === 'function') onError(result);
    loadServerSelections();
    }
    },
    error: function () {
    showStatusUpdateToast('حدث خطأ أثناء حفظ التحديد المؤقت', '#dc2626');
    if (typeof onError === 'function') onError();
    loadServerSelections();
    }
    });
    };

    window.clearServerSelection = function (orderId, onSuccess) {
    orderId = norm(orderId);
    var existing = window.statusUpdateSelectionsByOrderId[orderId];
    if (existing && !isMine(existing)) {
    showStatusUpdateToast('هذا الطلب محدد بواسطة ' + (existing.selectedByName || 'موظف آخر'), '#dc2626');
    return;
    }

    $.ajax({
    url: '/Order/ClearStatusUpdateSelection',
    type: 'POST',
    data: { orderId: orderId },
    success: function (result) {
    if (result && result.success) {
    delete window.statusUpdateSelectionsByOrderId[orderId];
    delete window.pendingFailureReasonImageUrls[orderId];
    if (typeof onSuccess === 'function') onSuccess(result);
    applyCollaborativeFailureRows();
    } else {
    showStatusUpdateToast((result && result.message) || 'فشل إلغاء التحديد', '#dc2626');
    loadServerSelections();
    }
    },
    error: function () {
    showStatusUpdateToast('حدث خطأ أثناء إلغاء التحديد', '#dc2626');
    loadServerSelections();
    }
    });
    };

    window.handleStatusUpdateSelectionChanged = function (payload) {
    var sel = normalizeSelection(payload);
    var orderId = sel ? sel.orderId : norm(payload && (payload.orderId || payload.OrderId));
    if (!orderId) return;

    if (payload && (payload.isActive === false || payload.IsActive === false)) {
    delete window.statusUpdateSelectionsByOrderId[orderId];
    delete window.pendingFailureReasonImageUrls[orderId];
    delete pendingFailureReasons[orderId];
    if (pendingFailureReasonImageFiles) delete pendingFailureReasonImageFiles[orderId];
    delete pendingFailureReasonImageUrls[orderId];
    } else if (sel) {
    window.statusUpdateSelectionsByOrderId[orderId] = sel;
    if (sel.failureImagePath) window.pendingFailureReasonImageUrls[orderId] = sel.failureImagePath;
    if (sel.targetStatus === 'فشل_التسليم') pendingFailureReasons[orderId] = sel.failureReason || 'فشل التسليم';
    }

    applyCrossPagePendingVisibility();
    applyCollaborativeFailureRows();
    };

    window.restorePendingFailureUI = function () {
    applyCrossPagePendingVisibility();
    applyCollaborativeFailureRows();
    };

    document.addEventListener('click', function (event) {
    var row = event.target.closest && event.target.closest('tr.status-selected-by-other');
    if (!row) return;
    var imageBtn = event.target.closest && event.target.closest('.failure-image-inline-btn.has-image');
    if (imageBtn) return;

    var interactive = event.target.closest && event.target.closest('select,input,button,.select2-selection,.row-cancel-failure-btn,.inline-failure-select');
    if (!interactive) return;

    event.preventDefault();
    event.stopPropagation();
    if (event.stopImmediatePropagation) event.stopImmediatePropagation();

    var orderId = row.getAttribute('data-order-id') || '';
    var sel = window.statusUpdateSelectionsByOrderId[orderId];
    showStatusUpdateToast('هذا الطلب محدد بواسطة ' + ((sel && sel.selectedByName) || 'موظف آخر'), '#dc2626');
    return false;
    }, true);

    document.addEventListener('change', function (event) {
    var row = event.target.closest && event.target.closest('tr.status-selected-by-other');
    if (!row) return;
    event.preventDefault();
    event.stopPropagation();
    if (event.stopImmediatePropagation) event.stopImmediatePropagation();
    return false;
    }, true);

    document.addEventListener('DOMContentLoaded', function () {
    ensureOtherCounter();
    setTimeout(function () { loadServerSelections(); }, 100);
    });
    window.addEventListener('load', function () {
    ensureOtherCounter();
    setTimeout(function () { loadServerSelections(); }, 350);
    });
    })();
</script>


