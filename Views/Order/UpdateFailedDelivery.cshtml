    $(document).on('change', '#selectAll', function () {
    showStatusUpdateToast('اختاري سبب الفشل لكل طلب من الدروب داون، وسيتم تحديده تلقائيًا', '#f59e0b');
    $(this).prop('checked', false);
    });

    $(document).on('click', '#updateToFailedDeliveryBtn, #updateToPendingBtn', function () {
    var ids = getSelectedReadyIds();
    var targetStatus = $(this).data('target-status');

    if (ids.length === 0) {
    showStatusUpdateToast('اختاري طلب وسبب فشل أولاً', '#dc2626');
    return;
    }

    var statusText = targetStatus === 'الطلبات_المعلقة' ? 'الطلبات المعلقة' : 'فشل التسليم';
    openStatusUpdateConfirm(targetStatus, statusText, ids.length);
    });

    $(document).on('click', '#statusUpdateConfirmCancel', closeStatusUpdateConfirm);

    $(document).on('click', '#statusUpdateConfirmBackdrop', function (event) {
    if (event.target === this) closeStatusUpdateConfirm();
    });

    $(document).on('change', '#failureReasonImageInput', function () {
    var file = this.files && this.files.length ? this.files[0] : null;
    setFailurePreview(file);
    });

    $(document).on('paste', '#failureImagePasteZone', function (event) {
    var clipboardData = event.originalEvent.clipboardData;
    if (!clipboardData || !clipboardData.items) return;

    for (var i = 0; i < clipboardData.items.length; i++) {
    var item = clipboardData.items[i];

    if (item.type && item.type.indexOf('image/') === 0) {
    var file = item.getAsFile();
    setFailurePreview(file);
    event.preventDefault();
    return;
    }
    }
    });

    $(document).on('click', '#statusUpdateConfirmOk', function () {
    var ids = getSelectedReadyIds();
    var targetStatus = pendingTargetStatus;
    var statusText = pendingTargetStatusText || '';

    if (!targetStatus || ids.length === 0) {
    closeStatusUpdateConfirm();
    return;
    }

    if (targetStatus === 'فشل_التسليم') {
    var missingImageIds = ids.filter(function (id) {
    return !pendingFailureReasonImageFiles[String(id)];
    });

    if (missingImageIds.length > 0) {
    closeStatusUpdateConfirm();
    var firstMissingId = String(missingImageIds[0]);
    var missingReason = pendingFailureReasons[firstMissingId] || $('.inline-failure-select[data-order-id="' + firstMissingId + '"]').val() || '';
    showStatusUpdateToast('لازم تضيفي صورة سبب الفشل لكل الطلبات قبل التحديث', '#dc2626');
    openFailureRowImagePopup(firstMissingId, missingReason, pendingFailureReasonImageFiles[firstMissingId]);
    return;
    }
    }

    var formData = new FormData();
    ids.forEach(function (id) {
    formData.append('ids', id);
    });

    formData.append('orderStatus', targetStatus);
    formData.append('orderReasons', JSON.stringify(pendingFailureReasons));

    if (targetStatus === 'فشل_التسليم') {
    ids.forEach(function (id) {
    var file = pendingFailureReasonImageFiles[String(id)];
    if (!file) return;
    formData.append('failureReasonImageFile_' + id, file);
    formData.append('failedReasonImageFile_' + id, file);
    formData.append('failureImageFile_' + id, file);
    formData.append('reasonImageFile_' + id, file);
    formData.append('imageFile_' + id, file);
    });
    }

    closeStatusUpdateConfirm();
    window.__statusUpdateFinalSubmitStarted = true;
    $('#loadingIndicator').show();

    $.ajax({
    url: '/Order/UpdateStatusForMultiple',
    type: 'POST',
    data: formData,
    processData: false,
    contentType: false,
    success: function (result) {
    if (result && result.success) {
    if (typeof window.showStatusDonePopup === 'function') { window.showStatusDonePopup(statusText, ids.length); } else { showStatusUpdateToast('تم تحديث الطلبات إلى ' + statusText, '#16a34a'); }
    removePendingFailureOrders(ids);
    if (targetStatus === 'فشل_التسليم' || targetStatus === 'الطلبات_المعلقة') {
    ids.forEach(function (id) {
    $('tr.order-row[data-order-id="' + id + '"]').fadeOut(180, function () { $(this).remove(); updateVisibleRowsCounter(); updateFailedActionState(); });
    });
    }
    pendingFailureReasons = getPendingFailureReasons();
    updateFailedActionState();
    } else {
    showStatusUpdateToast((result && result.message) || 'فشل في تحديث الطلبات', '#dc2626');
    }
    },
    error: function () {
    showStatusUpdateToast('حدث خطأ أثناء تحديث الطلبات', '#dc2626');
    },
    complete: function () {
    $('#loadingIndicator').hide();
    }
    });
    });

    $('#ManufacturingCompanyId, #CountryId, #DeliveryCompanyId, #DeliveryRepresentativeId, #pageSize').on('change', function () {
    setTimeout(updateRepresentativeVisibility, 300);
    loadStatusUpdatePage(1);
    });

    $(document).on('click', '.pagination a.page-link', function (event) {
    event.preventDefault();

    if ($(this).closest('.page-item').hasClass('disabled') || $(this).closest('.page-item').hasClass('active')) return;

    var page = parseInt($(this).data('page'));
    if (!page || page < 1) return;

    loadStatusUpdatePage(page);
    });
    });



    function handleStatusUpdateSelectionChanged(payload) {
    if (!payload) return;
    var orderId = String(payload.orderId || payload.OrderId || '');
    var targetStatus = String(payload.targetStatus || payload.TargetStatus || '');
    var failureReason = String(payload.failureReason || payload.FailureReason || '').trim();
    var failureImagePath = String(payload.failureImagePath || payload.FailureImagePath || '').trim();
    var isActive = payload.isActive;
    if (!orderId) return;

    if (isActive === false) {
    delete pendingFailureReasons[orderId];
    delete pendingFailureReasonImageFiles[orderId];
    delete pendingFailureReasonImageUrls[orderId];
    delete pendingFailureReasonImageUrls[orderId];
    removePendingDeliveredOrder(orderId);
    loadStatusUpdatePage(1);
    return;
    }

    if (targetStatus === 'فشل_التسليم') {
    pendingFailureReasons[orderId] = failureReason;
    if (failureImagePath) pendingFailureReasonImageUrls[orderId] = failureImagePath;
    var $row = $('tr.order-row[data-order-id="' + orderId + '"]');
    var $select = $('.inline-failure-select[data-order-id="' + orderId + '"]');
    if ($select.length && failureReason) {
    if ($select.find('option[value="' + failureReason.replace(/"/g, '\\"') + '"]').length === 0) {
    $select.append('<option value="' + escapeHtml(failureReason) + '">' + escapeHtml(failureReason) + '</option>');
    }
    $select.val(failureReason);
    }
    if (pendingFailureReasonImageFiles[String(orderId)] || pendingFailureReasonImageUrls[String(orderId)]) {
    $row.show().addClass('reason-selected');
    $row.find('input[name="selectedOrders"]').prop('checked', true);
    } else {
    $row.show().removeClass('reason-selected failure-reason-row-active failure-reason-selected-row');
    $row.find('input[name="selectedOrders"]').prop('checked', false);
    updateFailureImageButtonState(orderId);
    }
    } else if (targetStatus === 'تم_التسليم' || targetStatus === 'الطلبات_المعلقة') {
    if (getPendingDeliveredOrderIds().indexOf(orderId) === -1) {
    pendingDeliveredOrderIds.push(orderId);
    setPendingDeliveredOrderIds(pendingDeliveredOrderIds);
    }
    $('tr.order-row[data-order-id="' + orderId + '"]').fadeOut(140, function () {
    $(this).hide();
    updateVisibleRowsCounter();
    updateFailedActionState();
    });
    }

    applyCrossPagePendingVisibility();
    updateFailedActionState();
    }

    function initStatusUpdateSelectionSignalR() {
    if (!window.signalR || !window.signalR.HubConnectionBuilder) return;

    var connection = window.orderStatusUpdateSelectionConnection;
    if (!connection) {
    connection = new signalR.HubConnectionBuilder()
    .withUrl('/orderHub')
    .withAutomaticReconnect()
    .build();
    window.orderStatusUpdateSelectionConnection = connection;
    }

    if (!connection.__statusUpdateSelectionListenerAdded) {
    connection.on('OrderStatusUpdateSelectionChanged', handleStatusUpdateSelectionChanged);
    connection.__statusUpdateSelectionListenerAdded = true;
    }

    if (window.signalR.HubConnectionState && connection.state === signalR.HubConnectionState.Disconnected) {
    connection.start().catch(function () { });
    }
    }

    $(document).ready(function () {
    initStatusUpdateSelectionSignalR();
    });

    function normalizeImageSrc(src) {
    if (!src) return '';

    if (src.indexOf('http://') === 0 || src.indexOf('https://') === 0 || src.indexOf('/') === 0) {
    return src;
    }

    return '/' + src.replace(/^\/+/, '');
    }

    function getTooltipCloud(wrap) {
    return wrap ? wrap.querySelector('.products-tooltip-cloud') : null;
    }

    function hideProductsTooltip(wrap) {
    if (!wrap) return;

    wrap.classList.remove('is-tooltip-active');
    var cloud = getTooltipCloud(wrap);

    if (cloud) {
    cloud.hidden = true;
    cloud.style.setProperty('display', 'none', 'important');
    cloud.style.setProperty('opacity', '0', 'important');
    cloud.style.setProperty('visibility', 'hidden', 'important');
    }
    }

    function hideAllProductsTooltips() {
    document.querySelectorAll('.products-tooltip-wrap').forEach(function (wrap) {
    hideProductsTooltip(wrap);
    });
    }

    function showProductsTooltip(wrap) {
    if (!wrap) return;

    var cloud = getTooltipCloud(wrap);

    if (cloud) {
    cloud.hidden = false;
    cloud.style.setProperty('display', 'block', 'important');
    cloud.style.setProperty('opacity', '1', 'important');
    cloud.style.setProperty('visibility', 'visible', 'important');
    }

    wrap.classList.add('is-tooltip-active');
    }

    function renderProducts(wrap, products) {
    var itemsBox = wrap.querySelector('.products-tooltip-items');
    if (!itemsBox) return;

    if (!products || !products.length) {
    wrap.classList.add('no-products');
    itemsBox.innerHTML = '<div class="products-tooltip-empty">لا توجد منتجات مسجلة لهذا الطلب</div>';
    return;
    }

    wrap.classList.remove('no-products');

    itemsBox.innerHTML = products.map(function (product) {
    var imageHtml = product.image
    ? '<img class="product-tooltip-image" src="' + escapeHtml(product.image) + '" alt="' + escapeHtml(product.name) + '" loading="lazy" />'
    : '<span class="product-tooltip-image-placeholder"><i class="fa-solid fa-box-open"></i></span>';

    return '<div class="product-tooltip-row">'
    + imageHtml
    + '<div>'
    + '<div class="product-tooltip-name">' + escapeHtml(product.name || 'منتج') + '</div>'
    + '<div class="product-tooltip-qty">عدد ' + escapeHtml(product.qty || '1') + ' قطعة</div>'
    + '</div>'
    + '</div>';
    }).join('');
    }

    function extractProductsFromDetailsHtml(html) {
    var container = document.createElement('div');
    container.innerHTML = html;

    var rows = Array.prototype.slice.call(container.querySelectorAll('#orderDetails_warehouseData tr'));

    return rows.map(function (row) {
    var cells = row.querySelectorAll('td');
    if (!cells || cells.length === 0) return null;

    var img = row.querySelector('img');
    var image = img ? normalizeImageSrc(img.getAttribute('src')) : '';
    var name = cells[1] ? cells[1].textContent.trim() : '';
    var qty = cells[2] ? cells[2].textContent.trim() : '';

    return {
    image: image,
    name: name || 'منتج',
    qty: qty || '1'
    };
    }).filter(function (item) {
    return item && (item.name || item.image);
    });
    }

    function adjustTooltipDirection(wrap) {
    if (!wrap) return;

    var rect = wrap.getBoundingClientRect();
    if (rect.top < 165) {
    wrap.classList.add('tooltip-open-down');
    } else {
    wrap.classList.remove('tooltip-open-down');
    }
    }

    function loadProductsForTooltip(wrap) {
    if (!wrap || wrap.dataset.productsLoaded === 'true' || wrap.dataset.productsLoading === 'true') return;

    var orderId = wrap.getAttribute('data-order-id');
    var itemsBox = wrap.querySelector('.products-tooltip-items');

    if (!orderId || !itemsBox) return;

    wrap.dataset.productsLoading = 'true';
    wrap.classList.remove('no-products');
    itemsBox.innerHTML = '<div class="products-tooltip-loading">جاري تحميل المنتجات...</div>';

    fetch('/Order/DetailsPartial/' + encodeURIComponent(orderId), {
    headers: { 'X-Requested-With': 'XMLHttpRequest' }
    })
    .then(function (response) {
    if (!response.ok) throw new Error('Failed to load details');
    return response.text();
    })
    .then(function (html) {
    var products = extractProductsFromDetailsHtml(html);
    wrap.dataset.productsLoaded = 'true';
    renderProducts(wrap, products);
    })
    .catch(function () {
    itemsBox.innerHTML = '<div class="products-tooltip-empty">تعذر تحميل المنتجات</div>';
    })
    .finally(function () {
    wrap.dataset.productsLoading = 'false';
    });
    }

    function activateProductsTooltip(wrap) {
    if (!wrap) return;

    adjustTooltipDirection(wrap);
    showProductsTooltip(wrap);
    loadProductsForTooltip(wrap);
    }

    document.addEventListener('mouseover', function (event) {
    var wrap = event.target.closest && event.target.closest('.products-tooltip-wrap');
    if (!wrap) return;

    activateProductsTooltip(wrap);
    }, true);

    document.addEventListener('click', function (event) {
    var wrap = event.target.closest && event.target.closest('.products-tooltip-wrap');

    if (wrap) {
    event.stopPropagation();
    activateProductsTooltip(wrap);
    return;
    }

    hideAllProductsTooltips();
    }, true);

    document.addEventListener('mouseout', function (event) {
    var wrap = event.target.closest && event.target.closest('.products-tooltip-wrap');
    if (!wrap) return;

    var related = event.relatedTarget;
    if (related && wrap.contains(related)) return;

    hideProductsTooltip(wrap);
    }, true);

    window.addEventListener('load', function () {
    hideAllProductsTooltips();
    setTimeout(hideAllProductsTooltips, 250);
    });


    // Polling fallback: يخلي الأجهزة المفتوحة تعرف التحديدات المؤقتة حتى لو SignalR مش متحمل في الصفحة.
    function refreshStatusUpdateSelectionsFromServer() {
    loadServerSelections(function () {
    initInlineFailureSelects();
    restorePendingFailureUI();
    updateFailedActionState();
    });
    }

    function startStatusUpdateSelectionPolling() {
    if (window.__failedSelectionPollingStarted) return;
    window.__failedSelectionPollingStarted = true;
    setInterval(refreshStatusUpdateSelectionsFromServer, 2500);
    document.addEventListener('visibilitychange', function () {
    if (!document.hidden) refreshStatusUpdateSelectionsFromServer();
    });
    }

    $(document).ready(function () {
    startStatusUpdateSelectionPolling();
    });

</script>


