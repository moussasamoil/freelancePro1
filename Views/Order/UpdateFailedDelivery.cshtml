<script id="status-update-copyable-cells-script">
    (function () {
    if (window.__statusUpdateCopyableCellsInitialized) return;
    window.__statusUpdateCopyableCellsInitialized = true;

    function showCopyToast(fieldName) {
    var text = "تم نسخ " + (fieldName || "القيمة");
    var oldToast = document.getElementById('statusUpdateCopyFullWidthToast');
    if (oldToast && oldToast.parentNode) {
    oldToast.parentNode.removeChild(oldToast);
    }

    var toast = document.createElement('div');
    toast.id = 'statusUpdateCopyFullWidthToast';
    toast.className = 'status-update-copy-full-width-toast';
    toast.textContent = text;
    document.body.appendChild(toast);

    window.setTimeout(function () {
    toast.classList.add('is-visible');
    }, 10);

    window.setTimeout(function () {
    toast.classList.remove('is-visible');
    window.setTimeout(function () {
    if (toast && toast.parentNode) {
    toast.parentNode.removeChild(toast);
    }
    }, 220);
    }, 1800);
    }

    function fallbackCopy(text, fieldName) {
    var temp = document.createElement('textarea');
    temp.value = text;
    temp.setAttribute('readonly', 'readonly');
    temp.style.position = 'fixed';
    temp.style.top = '-9999px';
    temp.style.left = '-9999px';
    document.body.appendChild(temp);
    temp.focus();
    temp.select();

    try {
    document.execCommand('copy');
    showCopyToast(fieldName);
    } catch (e) {
    console.error('Copy failed', e);
    }

    document.body.removeChild(temp);
    }

    window.copyStatusUpdateCellValue = function (text, fieldName) {
    if (text === undefined || text === null) return;
    text = String(text).trim();
    if (!text || text === 'null' || text === 'undefined') return;

    if (navigator.clipboard && navigator.clipboard.writeText) {
    navigator.clipboard.writeText(text).then(function () {
    showCopyToast(fieldName);
    }).catch(function () {
    fallbackCopy(text, fieldName);
    });
    } else {
    fallbackCopy(text, fieldName);
    }
    };

    document.addEventListener('click', function (event) {
    var cell = event.target.closest && event.target.closest('.receipt-number-cell.copyable, .phone-cell.copyable');
    if (!cell) return;

    event.preventDefault();
    event.stopPropagation();

    var text = cell.getAttribute('data-copy-text');
    var label = cell.getAttribute('data-copy-label') || 'القيمة';

    if (text === null || text === undefined || text === '') {
    text = cell.innerText || cell.textContent || '';
    }

    window.copyStatusUpdateCellValue(text, label);
    }, true);
    })();
</script>



