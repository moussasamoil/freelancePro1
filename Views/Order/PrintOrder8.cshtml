@model List<lotus_blue.Models.ViewModel.OrderViewModel>
@{
    Layout = "_EmptyLayout";
    ViewData["Title"] = "     فاتورة الطلب  ";

}
@foreach (var Model in Model)
{
    <div class="card container rtl mt-3">
        <div class="card-body">
            <div class="container mb-5 mt-3">
                <div class="row d-flex align-items-baseline">

                    <div class="pe-0" style="width:70%">
                        <p style="color: #7e8d9f;font-size: 12px;">
                            فاتورة >>
                            <strong>@Model.Id</strong>
                        </p>
                    </div>

                    <div class="ps-0 ltr" style="width:30%" class=" ltr">
                        <p style="color: #7e8d9f; font-size: 12px;">
                            @Model.CreatedDate.ToString("yyyy-MM-dd")
                        </p>
                    </div>

                    <hr>
                </div>

                <div class="container">
                    <div class="col-md-12">
                        <div class="text-center">
                            <img src="/static/Lavva.jpg" width="100" height="80" class="ms-0">
                            <h5 class="pt-0">شركة Lavva الألمانية</h5>
                        </div>

                    </div>


                    <div class="row mt-5">
                        <div style="width: 60%;" class=" pe-0">
                            <h5>معلومات المرسل</h5>
                            <ul class="list-unstyled pe-0">
                                <li class="text-muted">
                                    شركة Lavva الألمانية
                                </li>
                                <li class="text-muted">
                                    @Model.State
                                </li>
                                <li class="text-muted">
                                    +905386466764
                                </li>
                                <li class="text-muted">
                                    <span class="badge bg-warning text-black fw-bold">
                                        @if (Model.IsPaid)
                                        {
                                            <span class="fw-bold">تم التحويل حوالة بنكية</span>
                                        }
                                        else
                                        {
                                            <span class="fw-bold">غير مدفوع</span>
                                        }
                                    </span>
                                </li>
                            </ul>
                        </div>
                        <div style="width: 40%;" class="ltr ps-0">
                            <h5>معلومات المستلم</h5>
                            <ul class="list-unstyled pe-0">
                                <li class="text-muted">@Model.Country</li>
                                <li class="text-muted"> <span style="color:#5d9fc5 ;"> زبونه</span></li>
                                <li class="text-muted">@Model.State</li>
                                <li class="text-muted"><i class="fas fa-phone"></i> @Model.TelephoneNumber</li>
                                <li class="text-muted">@Model.Address</li>
                            </ul>
                        </div>
                    </div>


                    <div class="row my-2  justify-content-center">
                        <table class="table table-striped table-borderless">
                            <thead style="background-color:#84B0CA ;" class="text-white">
                                <tr>
                                    <th scope="col">#</th>
                                    <th scope="col">اسم المنتج</th>
                                    <th scope="col">عدد القطع</th>
                                    <th scope="col">الأجمالي</th>
                                </tr>
                            </thead>
                            <tbody>

                                @{
                                    int rowNumber = 1;
                                }
                                @foreach (var warehouse in Model.SelectedWarehouses)
                                {
                                    <tr>
                                        <th scope="row">@(rowNumber++)</th>
                                        <td>@warehouse.WarehouseName</td>
                                        <td>@warehouse.Amount</td>
                                        <td>@Model.TotalPrice @Common.GetCurrencyByCountryName(Model.Country.ToString())</td>
                                    </tr>


                                }



                            </tbody>

                        </table>
                    </div>
                    <div class="row">
                        <div class="col-xl-8">
                        </div>
                        <div class="col-xl-3">

                            <p class="text-black float-start">
                                <span class="fw-bold" style="font-size: 13px;">@Model.TotalPrice</span>

                                <span class="text-black me-3"> السعر الأجمالي </span>
                            </p>
                        </div>
                    </div>
                    <hr>
                    <div class="row">
                        <div class="col-xl-10">
                            <p>شكرا لطلبك من شركة Lavva الألمانية</p>
                        </div>

                    </div>

                </div>
            </div>
        </div>
    </div>
}


<style>
    table thead tr {
    background-color: white !important;
    }

    li,p{
        font-size:11px;
    }

    h5 , th , td{
        font-size:12px
    }

</style>


<script>
    // Function to open the print dialog when the page is loaded
    window.onload = function () {
        window.print();
    };

</script>
