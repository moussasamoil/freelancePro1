    data: data,
    success: function (result) {
    var $result = $('<div>').html(result);

    // 1. Update table
    var $newTable = $result.find('#ordersTable');
    if ($newTable.length === 0) {
    $newTable = $result.find('.table').first();
    }
    if ($newTable.length) {
    if ($('#ordersTable').length) {
    $('#ordersTable').replaceWith($newTable);
    } else {
    $('.table').first().replaceWith($newTable);
    }
    }

    // 2. Update pagination and items count
    $('.pagination').replaceWith($result.find('.pagination'));
    $('.total-items-display').text($result.find('.total-items-display').text());

    // 3. Handle price container
    const tryPriceText = $result.find('.total-price-display-try').text().trim();
    const tryPriceValue = tryPriceText.replace('TRY', '').trim();

    // Remove ALL existing price containers first
    $('.price-container-wrapper').remove();

    if (tryPriceValue !== "0") {
