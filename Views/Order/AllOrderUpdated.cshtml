    location.reload();
    const printUrl = '@Url.Action("PrintOrdersForDelivery", "Pdf")' + '/' + result.orderReportId;
    window.open(printUrl, '_blank');
    } else {
    location.reload();
    const printUrl = '@Url.Action("PrintSelectedOrders", "Order")' + '?ids=' + selectedOrderIds.join(',');
    window.open(printUrl, '_blank');
    }
    },
    '/static/trash-can-regular.svg' // Using trash icon here
    );
    } else {
    $clickedButton.prop('disabled', false);
    $clickedButton.removeClass('disabled');

    showNotification(
    "خطأ: " + (result.message || "فشل في تعديل حالة الطلبات"),
    null,
    '/static/trash-can-regular.svg' // Using trash icon for errors
    );
