    hasFailureReasonFilter = filterValue !== undefined
    && filterValue !== null
    && String(filterValue).trim() !== ''
    && String(filterValue).trim() !== '-1';
    }

    var hasPendingFailureReason = false;
    try {
    hasPendingFailureReason = Object.keys(pendingFailureReasons || {}).some(function (key) {
    return String(pendingFailureReasons[key] || '').trim().length > 0;
    });
    } catch (e) {
    hasPendingFailureReason = false;
    }

    var hasInlineFailureReason = $('#ordersTable tbody tr.order-row[data-inline-failure-active="true"]').length > 0;
    var hasVisibleFailureReason = $('#ordersTable tbody tr.order-row .text-danger').filter(function () {
    return String($(this).text() || '').trim().length > 0;
    }).length > 0;

    if (!hasFailureReasonFilter && !hasPendingFailureReason && !hasInlineFailureReason && !hasVisibleFailureReason) {
    $('#ordersTable').removeClass('failure-reason-filter-active');
    }

