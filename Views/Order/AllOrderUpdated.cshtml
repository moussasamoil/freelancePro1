    // Handle "التقدم للحالة التالية" button click
    $('#advanceFailureStatusBtn').click(function () {
    var $btn = $(this);
    var selectedOrderIds = getSelectedOrderIds();

    if (selectedOrderIds.length === 0) {
    showNotification("الرجاء تحديد طلب واحد على الأقل", null, '/static/info-icon.svg');
    return;
    }

    $btn.prop('disabled', true).addClass('disabled');

    var incompleteStatusValues = [18, 25, 26, 27, 28, 29, 31];
    var currentFilter = parseInt($('#OrderStatusId').val());
    var isIncompleteFilter = incompleteStatusValues.includes(currentFilter);

    if (isIncompleteFilter) {
    // Incomplete statuses: advance directly without modal
    showNotification(
    "هل أنت متأكد من التقدم للحالة التالية لـ " + selectedOrderIds.length + " طلب؟",
    function () {
    $('#loadingIndicator').show();
    $.ajax({
    url: '@Url.Action("AdvanceFailureStatus", "Order")',
    type: 'POST',
    data: { ids: selectedOrderIds },
    success: function (result) {
    if (result.success) {
    localStorage.removeItem('selectedOrderIds');
    localStorage.removeItem('pendingFailureReasons');
    showNotification("تم التقدم للحالة التالية بنجاح", function () { location.reload(); }, '/static/trash-can-regular.svg');
    } else {
