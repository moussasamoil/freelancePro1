    var autoSelectingSingleDeliveryCompany = false;

    function autoSelectSingleDeliveryCompanyIfOnlyOne() {
    var $deliveryCompany = $('#DeliveryCompanyId');

    if (!$deliveryCompany.length || autoSelectingSingleDeliveryCompany) {
    return;
    }

    var countrySelected = hasRealSelectedValue('#CountryId');

    if (!countrySelected) {
    return;
    }

    var $options = getSelectableDeliveryCompanyOptions();

    if ($options.length !== 1) {
    return;
    }

    var onlyValue = String($options.first().val());

    if (String($deliveryCompany.val() || '') === onlyValue) {
    return;
    }

    autoSelectingSingleDeliveryCompany = true;
    $deliveryCompany.val(onlyValue);

    if ($deliveryCompany.data('select2')) {
    $deliveryCompany.trigger('change.select2');
    }

    $deliveryCompany.trigger('change');

    setTimeout(function () {
    autoSelectingSingleDeliveryCompany = false;
    }, 0);
    }

    function scheduleAutoSelectSingleDeliveryCompany() {
