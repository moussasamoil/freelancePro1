    } else if (selectedOrderIds.length === 1) {
    // Single row: show modal for reason confirmation
    var orderId = selectedOrderIds[0];
    var $row = $('tr.order-row input[value="' + orderId + '"]').closest('tr');

    globalOrderId = orderId;
    globalOrderStatus = $row.data('order-status');
    globalAdvanceMode = true;

    $.ajax({
    url: '/Order/FailureReasonModal',
    type: 'GET',
    success: function (data) {
