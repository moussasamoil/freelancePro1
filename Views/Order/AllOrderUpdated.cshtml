<div id="pagination-link" class="mt-0 container-fluid">
    <div class="d-flex justify-content-center align-items-center flex-wrap">

        <p class="text-start pt-2 total-items-display">@Model.PaginationViewModel.TotalItems عدد الطلبات</p>

        <nav aria-label="Page navigation" class="mx-auto nav-nav">
            <div class="d-flex justify-content-center">
                <ul class="pagination p-0">
                    @{
                        int currentPage = Model.PaginationViewModel.CurrentPage;
                        int totalPages = Model.PaginationViewModel.TotalPages;
                        int previousPage = currentPage > 1 ? currentPage - 1 : 1;
                        int nextPage = currentPage < totalPages ? currentPage + 1 : totalPages;
                        var pagesToShow = new System.Collections.Generic.SortedSet<int>();

                        if (totalPages <= 7)
                        {
                            for (int i = 1; i <= totalPages; i++)
                            {
                                pagesToShow.Add(i);
                            }
                        }
                        else
                        {
                            int windowStart;
                            int windowEnd;

                            if (currentPage <= 2)
                            {
                                windowStart = 1;
                                windowEnd = 3;
                            }
                            else if (currentPage >= totalPages - 1)
                            {
                                windowStart = totalPages - 2;
                                windowEnd = totalPages;
                            }
                            else
                            {
                                windowStart = currentPage - 1;
                                windowEnd = currentPage + 1;
                            }

                            for (int i = Math.Max(1, windowStart); i <= Math.Min(totalPages, windowEnd); i++)
                            {
                                pagesToShow.Add(i);
                            }

                            if (currentPage >= totalPages - 1)
                            {
                                for (int i = 1; i <= Math.Min(3, totalPages); i++)
                                {
                                    pagesToShow.Add(i);
                                }
                            }
                            else
                            {
                                for (int i = Math.Max(1, totalPages - 2); i <= totalPages; i++)
                                {
                                    pagesToShow.Add(i);
                                }
                            }
                        }

                        int lastRenderedPage = 0;
                    }

                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                        <a class="page-link pointer" data-page="1" title="أول صفحة" aria-label="أول صفحة">
                            <svg class="pagination-arrow-svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                <path d="M13 6 L19 12 L13 18"></path>
                                <path d="M5 6 L11 12 L5 18"></path>
                            </svg>
                        </a>
                    </li>
                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                        <a class="page-link" data-page="@previousPage" title="الصفحة السابقة" aria-label="الصفحة السابقة">
                            <svg class="pagination-arrow-svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                <path d="M9 6 L15 12 L9 18"></path>
                            </svg>
                        </a>
                    </li>

                    @foreach (var pageNumber in pagesToShow)
                    {
                        if (lastRenderedPage > 0 && pageNumber - lastRenderedPage > 1)
                        {
                            <li class="page-item pagination-ellipsis disabled">
                                <span class="page-link">...</span>
                            </li>
                        }

                        <li class="numbers page-item @(currentPage == pageNumber ? "active" : "")">
                            <a class="page-link" data-page="@pageNumber">@pageNumber</a>
                        </li>

                        lastRenderedPage = pageNumber;
                    }

                    <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                        <a class="page-link" data-page="@nextPage" title="الصفحة التالية" aria-label="الصفحة التالية">
                            <svg class="pagination-arrow-svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                <path d="M15 6 L9 12 L15 18"></path>
                            </svg>
                        </a>
                    </li>
                    <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                        <a class="page-link" data-page="@totalPages" title="آخر صفحة" aria-label="آخر صفحة">
                            <svg class="pagination-arrow-svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                <path d="M11 6 L5 12 L11 18"></path>
                                <path d="M19 6 L13 12 L19 18"></path>
                            </svg>
                        </a>
                    </li>
                </ul>
            </div>
        </nav>



        @if (User.IsInRole("Admin"))
        {
            @if (Model.TotalOrderPriceTRY != "0")
            {
                <div class="price-container-wrapper d-flex justify-content-end mt-2 mt-lg-0" id="priceContainer">
                    @if (@Model.TotalOrderPrice != null)
                    {
                        <div class="custom-shadow ms-3 TotalOrderPrice" style="display:none;">
                            <span class="total-price-display text-green">
                                @Model.TotalOrderPrice
                                @if (Model.SelectedCoutnry != null)
                                {
                                    @Common.GetCurrencyByCountryName(Model.SelectedCoutnry)
                                }
                            </span>
                        </div>
                    }

                    <div class="custom-shadow ms-3">
                        <span class="total-price-display-try text-green">
                            @(Model.TotalOrderPriceTRY)
                            TRY
                        </span>
                    </div>



                    <div class="custom-shadow">
                        <span class="total-price-display-usd text-green">
                            @(Model.TotalOrderPriceDollar)
                            USD
                        </span>
                    </div>


                </div>
            }
        }



    </div>
</div>



