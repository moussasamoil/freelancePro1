    $('#statusChangeReason').select2({
    placeholder: { id: '', text: 'اختر سبب الفشل', image: '/mainicons/circle-exclamation-regular.svg' },
    allowClear: true,
    templateResult: formatOption,
    templateSelection: formatOption,
    dir: "rtl",
    minimumResultsForSearch: 1,
    width: '100%',
    dropdownParent: $('#reasonModal')
    });

    $('#reasonModal').on('shown.bs.modal', function () { document.body.classList.add('modal-open'); });
    $('#reasonModal').on('hidden.bs.modal', function () {
    document.body.classList.remove('modal-open');
    $btn.prop('disabled', false).removeClass('disabled');
    globalAdvanceMode = false;
    });
    $('#reasonModal').modal('show');
    });
    },
    error: function () {
    console.error('Error loading failure reason modal');
    $btn.prop('disabled', false).removeClass('disabled');
    globalAdvanceMode = false;
    }
    });
    } else {
    // Multiple rows: advance directly, inherit reason from previous status
    showNotification(
    "هل أنت متأكد من التقدم للحالة التالية لـ " + selectedOrderIds.length + " طلبات؟",
    function () {
    $('#loadingIndicator').show();
    $.ajax({
    url: '@Url.Action("AdvanceFailureStatus", "Order")',
    type: 'POST',
    data: { ids: selectedOrderIds },
    success: function (result) {
    if (result.success) {
    localStorage.removeItem('selectedOrderIds');
    localStorage.removeItem('pendingFailureReasons');
    showNotification("تم التقدم للحالة التالية بنجاح", function () { location.reload(); }, '/static/trash-can-regular.svg');
    } else {
    showNotification(result.message || "فشل في التقدم للحالة التالية", null, '/static/trash-can-regular.svg');
    }
    },
    error: function (xhr, status, error) {
    var response = xhr.responseText ? JSON.parse(xhr.responseText) : {};
    showNotification("خطأ: " + (response.message || error), null, '/static/trash-can-regular.svg');
    },
    complete: function () {
    $('#loadingIndicator').hide();
    $btn.prop('disabled', false).removeClass('disabled');
    }
    });
    },
    '/static/trash-can-regular.svg'
    );
    $btn.prop('disabled', false).removeClass('disabled');
    }
    });

    // Initialize inline failure reason selects
    function initInlineFailureSelects() {
    var $selects = $('.inline-failure-select').not('[data-select2-id]');
    if ($selects.length === 0) return;
    $.ajax({
    url: '/DataList/GetAllFailureReasons',
    type: 'GET',
    dataType: 'json',
    success: function (data) {
    $selects.each(function () {
    var $select = $(this);
    var preselect = $select.data('preselect');

    $select.append('<option value=""></option>');
    $.each(data, function (i, reason) {
    $select.append('<option value="' + reason.name + '">' + reason.name + '</option>');
    });

    $select.select2({
    placeholder: { id: '', text: 'اختر سبب الفشل', image: '/mainicons/circle-exclamation-regular.svg' },
    allowClear: true,
    templateResult: formatOption,
    templateSelection: formatOption,
    dir: "rtl",
    minimumResultsForSearch: 1,
    width: '180px'
    });
    });
    highlightFailureReasonCells();
    }
    });
    }

    initInlineFailureSelects();

    function restorePendingFailureReasonUI() {
    $.each(pendingFailureReasons, function (orderId, reason) {
    var $tr = $('tr.order-row input[value="' + orderId + '"]').closest('tr');
    if ($tr.length === 0) return;
    var $td = $tr.find('td:has(.inline-failure-select)');
    var $reasonLabel = $td.find('.text-danger');
    if ($reasonLabel.length) {
    $reasonLabel.text(reason).attr('data-copy-text', reason);
    } else {
    $td.find('.clear-reason-btn').before('<div class="text-danger fw-bold copyable" style="font-size:0.85em;cursor:pointer;" data-copy-text="' + reason + '" data-copy-label="سبب الفشل">' + reason + '</div>');
    }
    $tr.data('failure-reason', reason);
    $tr.find('.clear-reason-btn').show();
    $tr.find('input[type="checkbox"]').removeClass('needs-failure-reason').css('cursor', '');
    });
    highlightFailureReasonCells();
    updateFailStatusBtnState();
    applyFailureReasonFilteredTableView();
    }

    function highlightFailureReasonCells() {
    $('.inline-failure-select').each(function () {
    var $tr = $(this).closest('tr');
    var reasonText = ($tr.find('.text-danger').text() || '').trim();

    if (!reasonText) {
    reasonText = String($tr.data('failure-reason') || '').trim();
    }

    var hasFailureReason = reasonText.length > 0;

    $tr.toggleClass('failure', hasFailureReason);
    $tr.toggleClass('failure-reason-row-active', hasFailureReason);

    if (hasFailureReason) {
    $tr.attr('data-inline-failure-active', 'true');
    } else {
    $tr.removeAttr('data-inline-failure-active');
    }
    });
    }


    function resetInlineFailureReasonImageInput($modal) {
    var $pasteBox = $modal.find('.inline-failure-reason-image-paste-box');
    var $fileInput = $modal.find('.inline-failure-reason-image-file');
    var $error = $modal.find('.inline-failure-reason-image-error');

    $fileInput.val('');
    $error.hide();
    $pasteBox.html('اختاري صورة أو اضغطي Ctrl + V للصق صورة سبب الفشل إذا متاحة');
    }

    function openInlineFailureReasonImageOptionalPopup(reason, onConfirm, onCancel) {
    var selectedFile = null;
    var confirmed = false;

    $('#inlineFailureReasonImageModal').remove();

    var modalHtml = ''
    + '<div class="modal fade" id="inlineFailureReasonImageModal" tabindex="-1" role="dialog" aria-hidden="true">'
    + '  <div class="modal-dialog modal-dialog-centered" role="document">'
    + '    <div class="modal-content" dir="rtl" style="border-radius:16px;overflow:hidden;">'
    + '      <div class="modal-header" style="background:#18a088;color:#fff;">'
    + '        <h5 class="modal-title" style="font-weight:800;">صورة سبب فشل الطلب</h5>'
    + '        <button type="button" class="close text-white" data-dismiss="modal" data-bs-dismiss="modal" aria-label="Close" style="border:0;background:transparent;font-size:26px;line-height:1;color:#fff;">&times;</button>'
    + '      </div>'
    + '      <div class="modal-body">'
    + '        <div style="background:#f8fafc;border:1px solid #e5e7eb;border-radius:12px;padding:10px 12px;margin-bottom:12px;color:#334155;font-weight:700;">'
    + '          سبب الفشل: <span style="color:#dc2626;">' + $('<div>').text(reason || '').html() + '</span>'
    + '        </div>'
    + '        <label class="form-label fw-bold">إضافة صورة الفشل <span class="text-muted">(اختياري)</span></label>'
    + '        <div tabindex="0" class="inline-failure-reason-image-paste-box" style="min-height:135px;border:2px dashed #d1d5db;border-radius:12px;background:#f8fafc;display:flex;align-items:center;justify-content:center;text-align:center;color:#64748b;font-weight:700;cursor:pointer;padding:12px;outline:none;">اختاري صورة أو اضغطي Ctrl + V للصق صورة سبب الفشل إذا متاحة</div>'
    + '        <input type="file" class="inline-failure-reason-image-file" accept="image/*" hidden />'
    + '        <div class="inline-failure-reason-image-error text-danger mt-2" style="display:none;font-size:13px;font-weight:700;">الملف المختار يجب أن يكون صورة.</div>'
    + '      </div>'
    + '      <div class="modal-footer" style="gap:8px;justify-content:center;">'
    + '        <button type="button" class="btn btn-secondary inline-failure-reason-image-cancel" data-dismiss="modal" data-bs-dismiss="modal">تراجع</button>'
    + '        <button type="button" class="btn btn-success inline-failure-reason-image-confirm">حفظ</button>'
    + '      </div>'
    + '    </div>'
    + '  </div>'
    + '</div>';

    $('body').append(modalHtml);

    var $modal = $('#inlineFailureReasonImageModal');
    var $pasteBox = $modal.find('.inline-failure-reason-image-paste-box');
    var $fileInput = $modal.find('.inline-failure-reason-image-file');
    var $error = $modal.find('.inline-failure-reason-image-error');

    function showSelectedImage(file) {
    if (!file) return;

    if (!/^image\//i.test(file.type || '')) {
    $error.show();
    return;
    }

    selectedFile = file;
    $error.hide();

    var reader = new FileReader();
    reader.onload = function (event) {
    $pasteBox.html('<img src="' + event.target.result + '" alt="صورة سبب الفشل" style="max-width:100%;max-height:190px;object-fit:contain;border-radius:10px;" />');
    };
    reader.readAsDataURL(file);
    }

    function handlePaste(event) {
    var clipboard = event.clipboardData || (event.originalEvent && event.originalEvent.clipboardData);
    var items = clipboard && clipboard.items;

    if (!items) return;

    for (var i = 0; i < items.length; i++) {
    if (items[i].type && items[i].type.indexOf('image') === 0) {
    event.preventDefault();
    var blob = items[i].getAsFile();

    try {
    var dt = new DataTransfer();
    dt.items.add(blob);
    $fileInput[0].files = dt.files;
    } catch (e) { }

    showSelectedImage(blob);
    return;
    }
    }
    }

    $pasteBox.on('click', function () {
    $fileInput.trigger('click');
    });

    $pasteBox.on('paste', handlePaste);
    $modal.on('paste', handlePaste);

    $fileInput.on('change', function () {
    var file = this.files && this.files[0];
    if (file) showSelectedImage(file);
    });

    $modal.find('.inline-failure-reason-image-confirm').on('click', function () {
    confirmed = true;
    $modal.modal('hide');
    if (typeof onConfirm === 'function') {
    onConfirm(selectedFile);
    }
    });

    $modal.on('hidden.bs.modal', function () {
    if (!confirmed && typeof onCancel === 'function') {
    onCancel();
    }
    $modal.remove();
    });

    $modal.modal('show');

    setTimeout(function () {
    $pasteBox.trigger('focus');
    }, 250);
    }

    function applyInlineFailureReasonUi($select, reason) {
    $select.val(null).trigger('change.select2');

    var $td = $select.closest('td');
    var $tr = $select.closest('tr');
    var $reasonLabel = $td.find('.text-danger');

    if ($reasonLabel.length) {
    $reasonLabel.text(reason).attr('data-copy-text', reason);
    } else {
    $tr.find('.clear-reason-btn').before('<div class="text-danger fw-bold copyable" style="font-size:0.85em;cursor:pointer;" data-copy-text="' + reason + '" data-copy-label="سبب الفشل">' + reason + '</div>');
    }

    $tr.find('.clear-reason-btn').show();
    $tr.data('failure-reason', reason);
    $tr.attr('data-failure-reason', reason);

    var checkbox = $tr.find('input[type="checkbox"]');
    checkbox.removeClass('needs-failure-reason').css('cursor', '');
    applyCheckboxRestrictions();

    if (!checkbox.is(':checked')) {
    checkbox.trigger('click');
    }

    highlightFailureReasonCells();
    updateFailStatusBtnState();
    applyFailureReasonFilteredTableView();
    }

    function buildInlineFailureReasonFormData(orderId, orderStatus, reason, failureReasonImageFile) {
    var formData = new FormData();
    formData.append('id', orderId);
    formData.append('orderStatus', orderStatus);
    formData.append('reason', reason || '');

    if (failureReasonImageFile) {
    formData.append('failureReasonImageFile', failureReasonImageFile);
    formData.append('failedReasonImageFile', failureReasonImageFile);
    formData.append('failureImageFile', failureReasonImageFile);
    formData.append('reasonImageFile', failureReasonImageFile);
    formData.append('imageFile', failureReasonImageFile);
    }

    return formData;
    }

    function submitInlineFailureReasonWithOptionalImage($select, orderId, orderStatus, reason, failureReasonImageFile) {
    $('#loadingIndicator').show();

    var ajaxOptions = {
    url: '/Order/UpdateStatus',
    type: 'POST',
    success: function (result) {
    console.log('[inline-failure-select] UpdateStatus response:', result);
    if (result.success) {
    var toastText = result.action === 'status_changed'
    ? 'تم تغيير حالة الطلب وحفظ سبب الفشل'
    : result.action === 'reason_updated'
    ? 'تم تحديث سبب الفشل'
    : result.action === 'reason_created'
    ? 'تم إضافة سبب الفشل'
    : 'تم حفظ سبب الفشل';
    showNotification(toastText, null, '/static/info-icon.svg');

    applyInlineFailureReasonUi($select, reason);
    $('#loadingIndicator').hide();
    } else {
    showNotification(result.message || 'فشل في تعديل حالة الطلب', null, '/static/trash-can-regular.svg');
    $select.val(null).trigger('change');
    $('#loadingIndicator').hide();
    }
    },
    error: function (xhr, status, error) {
    console.error('[inline-failure-select] AJAX error:', status, error, xhr.responseText);
    showNotification('حدث خطأ أثناء حفظ سبب الفشل', null, '/static/trash-can-regular.svg');
    $('#loadingIndicator').hide();
    }
    };

    if (failureReasonImageFile) {
    ajaxOptions.data = buildInlineFailureReasonFormData(orderId, orderStatus, reason, failureReasonImageFile);
    ajaxOptions.processData = false;
    ajaxOptions.contentType = false;
    } else {
    ajaxOptions.data = { id: orderId, orderStatus: orderStatus, reason: reason };
    }

    $.ajax(ajaxOptions);
    }

    $(document).on('change', '.inline-failure-select', function () {
    var $select = $(this);
    var reason = $select.val();
    var orderId = $select.data('order-id');
    var orderStatus = $select.data('order-status');

    highlightFailureReasonCells();

    if (!reason) {
    if (isInDeliveryFilter()) {
    delete pendingFailureReasons[orderId];
    delete pendingFailureReasonImageFiles[String(orderId)];
    setPendingFailureReasons(pendingFailureReasons);
    var $tr = $select.closest('tr');
    $tr.data('failure-reason', '');
    $tr.attr('data-failure-reason', '');
    $tr.find('.text-danger').text('');
    $tr.find('.clear-reason-btn').hide();
    applyCheckboxRestrictions();
    updateFailStatusBtnState();
    highlightFailureReasonCells();
    applyFailureReasonFilteredTableView();
    }
    return;
    }

    if (!hasCountryAndDeliveryCompanySelected()) {
    showCountryDeliveryRequiredNotification();
    resetInlineFailureSelect($select);
    return;
    }

    openInlineFailureReasonImageOptionalPopup(
    reason,
    function (failureReasonImageFile) {
    if (isInDeliveryFilter()) {
    // Frontend-only path for قيد_التوصيل — reason/image are held until changing to failure status
    pendingFailureReasons[orderId] = reason;
    setPendingFailureReasons(pendingFailureReasons);

    if (failureReasonImageFile) {
    pendingFailureReasonImageFiles[String(orderId)] = failureReasonImageFile;
    } else {
    delete pendingFailureReasonImageFiles[String(orderId)];
    }

    applyInlineFailureReasonUi($select, reason);

    Toastify({
    text: failureReasonImageFile
    ? 'تم تحديد سبب الفشل وإضافة الصورة (سيُرسل عند تغيير الحالة)'
    : 'تم تحديد سبب الفشل (سيُرسل عند تغيير الحالة)',
    duration: 2000,
    gravity: 'bottom',
    position: 'center',
    style: { background: '#ff9800', borderRadius: '8px', fontWeight: 'bold' }
    }).showToast();
    return;
    }

    // Existing AJAX path for failure-class statuses + optional image
    submitInlineFailureReasonWithOptionalImage($select, orderId, orderStatus, reason, failureReasonImageFile);
    },
    function () {
    resetInlineFailureSelect($select);
    }
    );
    });


    });
</script>


<script id="orders-products-tooltip-loader-script">
    (function () {
    var productsTooltipReady = false;
    var firstPointerMoveConsumed = false;

    function escapeHtml(value) {
    return String(value == null ? '' : value)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#039;');
    }

    function normalizeImageSrc(src) {
    if (!src) return '';
    if (src.indexOf('http://') === 0 || src.indexOf('https://') === 0 || src.indexOf('/') === 0) {
    return src;
    }

    return '/' + src.replace(/^\/+/, '');
    }

    function getTooltipCloud(wrap) {
    return wrap ? wrap.querySelector('.products-tooltip-cloud') : null;
    }

    function hideProductsTooltip(wrap) {
    if (!wrap) return;
    wrap.classList.remove('is-tooltip-active');
    var cloud = getTooltipCloud(wrap);
    if (cloud) {
    cloud.hidden = true;
    cloud.style.setProperty('display', 'none', 'important');
    cloud.style.setProperty('opacity', '0', 'important');
    cloud.style.setProperty('visibility', 'hidden', 'important');
    }
    }

    function hideAllProductsTooltips() {
    document.querySelectorAll('.products-tooltip-wrap').forEach(function (wrap) {
    hideProductsTooltip(wrap);
    });
    }

    function showProductsTooltip(wrap) {
    if (!wrap) return;
    var cloud = getTooltipCloud(wrap);
    if (cloud) {
    cloud.hidden = false;
    cloud.style.setProperty('display', 'block', 'important');
    cloud.style.setProperty('opacity', '1', 'important');
    cloud.style.setProperty('visibility', 'visible', 'important');
    }
    wrap.classList.add('is-tooltip-active');
    }

    function renderProducts(wrap, products) {
    var itemsBox = wrap.querySelector('.products-tooltip-items');
    if (!itemsBox) {
    return;
    }

    if (!products || !products.length) {
    wrap.classList.add('no-products');
    itemsBox.innerHTML = '<div class="products-tooltip-empty">لا توجد منتجات مسجلة لهذا الطلب</div>';
    return;
    }

    wrap.classList.remove('no-products');
    itemsBox.innerHTML = products.map(function (product) {
    var imageHtml = product.image
    ? '<img class="product-tooltip-image" src="' + escapeHtml(product.image) + '" alt="' + escapeHtml(product.name) + '" loading="lazy" onerror="this.style.display=\'none\';" />'
    : '<span class="product-tooltip-image-placeholder"><i class="fa-solid fa-box-open"></i></span>';

    return '<div class="product-tooltip-row">'
    + imageHtml
    + '<div>'
    + '<div class="product-tooltip-name">' + escapeHtml(product.name || 'منتج') + '</div>'
    + '<div class="product-tooltip-qty">عدد ' + escapeHtml(product.qty || '1') + ' قطعة</div>'
    + '</div>'
    + '</div>';
    }).join('');
    }

    function extractProductsFromDetailsHtml(html) {
    var container = document.createElement('div');
    container.innerHTML = html;

    var rows = Array.prototype.slice.call(container.querySelectorAll('#orderDetails_warehouseData tr'));

    return rows.map(function (row) {
    var cells = row.querySelectorAll('td');
    var img = row.querySelector('img');
    var image = img ? normalizeImageSrc(img.getAttribute('src')) : '';
    var name = cells[1] ? cells[1].textContent.trim() : '';
    var qty = cells[2] ? cells[2].textContent.trim() : '';

    return {
    image: image,
    name: name || 'منتج',
    qty: qty || '1'
    };
    }).filter(function (item) {
    return item.name || item.image;
    });
    }

    function loadProductsForTooltip(wrap) {
    if (!wrap || wrap.dataset.productsLoaded === 'true' || wrap.dataset.productsLoading === 'true') {
    return;
    }

    var orderId = wrap.getAttribute('data-order-id');
    var itemsBox = wrap.querySelector('.products-tooltip-items');

    if (!orderId || !itemsBox) {
    return;
    }

    wrap.dataset.productsLoading = 'true';
    wrap.classList.remove('no-products');
    itemsBox.innerHTML = '<div class="products-tooltip-loading">جاري تحميل المنتجات...</div>';

    fetch('/Order/DetailsPartial/' + encodeURIComponent(orderId), {
    headers: { 'X-Requested-With': 'XMLHttpRequest' }
    })
    .then(function (response) {
    if (!response.ok) {
    throw new Error('Failed to load details');
    }

    return response.text();
    })
    .then(function (html) {
    var products = extractProductsFromDetailsHtml(html);
    wrap.dataset.productsLoaded = 'true';
    renderProducts(wrap, products);
    })
    .catch(function () {
    itemsBox.innerHTML = '<div class="products-tooltip-empty">تعذر تحميل المنتجات</div>';
    })
    .finally(function () {
    wrap.dataset.productsLoading = 'false';
    });
    }

    function adjustTooltipDirection(wrap) {
    if (!wrap) {
    return;
    }

    var rect = wrap.getBoundingClientRect();
    var header = document.querySelector('.fixed-top, header');
    var headerBottom = header ? header.getBoundingClientRect().bottom : 0;
    var safeTop = Math.max(headerBottom + 125, 165);

    if (rect.top < safeTop) {
    wrap.classList.add('tooltip-open-down');
    } else {
    wrap.classList.remove('tooltip-open-down');
    }
    }

    function activateProductsTooltip(wrap) {
    if (!wrap || !productsTooltipReady) {
    return;
    }

    adjustTooltipDirection(wrap);
    showProductsTooltip(wrap);
    loadProductsForTooltip(wrap);
    }

    function deactivateProductsTooltip(wrap) {
    hideProductsTooltip(wrap);
    }

    function markProductsTooltipReady() {
    if (!firstPointerMoveConsumed) {
    firstPointerMoveConsumed = true;
    hideAllProductsTooltips();
    return;
    }

    productsTooltipReady = true;
    }

    document.addEventListener('mousemove', function (event) {
    markProductsTooltipReady();

    var wrap = event.target.closest && event.target.closest('.products-tooltip-wrap');
    if (!wrap) {
    return;
    }

    activateProductsTooltip(wrap);
    }, true);

    document.addEventListener('mouseover', function (event) {
    if (!productsTooltipReady) {
    hideAllProductsTooltips();
    return;
    }

    var wrap = event.target.closest && event.target.closest('.products-tooltip-wrap');
    if (!wrap) {
    return;
    }

    activateProductsTooltip(wrap);
    }, true);

    document.addEventListener('mouseout', function (event) {
    var wrap = event.target.closest && event.target.closest('.products-tooltip-wrap');

    if (!wrap) {
    return;
    }

    var related = event.relatedTarget;
    if (related && wrap.contains(related)) {
    return;
    }

    deactivateProductsTooltip(wrap);
    }, true);

    document.addEventListener('focusin', function (event) {
    var wrap = event.target.closest && event.target.closest('.products-tooltip-wrap');

    if (!wrap) {
    return;
    }

    productsTooltipReady = true;
    activateProductsTooltip(wrap);
    }, true);

    document.addEventListener('focusout', function (event) {
    var wrap = event.target.closest && event.target.closest('.products-tooltip-wrap');

    if (!wrap) {
    return;
    }

    deactivateProductsTooltip(wrap);
    }, true);

    document.addEventListener('DOMContentLoaded', hideAllProductsTooltips);
    window.addEventListener('load', function () {
    hideAllProductsTooltips();
    setTimeout(hideAllProductsTooltips, 250);
    setTimeout(hideAllProductsTooltips, 900);
    });
    })();
</script>

