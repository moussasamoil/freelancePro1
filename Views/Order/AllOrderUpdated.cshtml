    const priceContainer = `
    <div class="price-container-wrapper d-flex justify-content-end mt-2 mt-lg-0">
    ${$result.find('#priceContainer').html()}
    </div>
    `;

    // Insert after the nav element
    $('.nav-nav').after(priceContainer);
