@if (Model != null)
{
    <table id="ordersTable" class="table  mt-2 mb-0 mb-lg-2 mx-auto width-99">
        <thead>
            <tr>
                <th class="order-select-col">
                    <input type="checkbox" id="selectAll" />
                </th>
                <th>رقم الوصل</th>
                <th class="d-none d-md-table-cell order-customer-name-col">الاسم</th>
                <th>رقم الهاتف</th>
                <th class="d-none d-md-table-cell">التاريخ</th>
                <th class="d-none d-md-table-cell">الدولة</th>
                <th class="d-none d-md-table-cell">المدينة</th>
                <th class="d-none d-md-table-cell">الشركة المصنعة</th>
                <th class="d-none d-md-table-cell">شركة التوصيل</th>
                <th class="d-none d-md-table-cell">اخر تحديث</th>
                <th class="d-none d-md-table-cell"> حالة الطلب </th>

                <th>قيمة المبلغ</th>
                <th class="d-none d-md-table-cell order-message-col">  مراسلة </th>
                <th class="d-none d-lg-table-cell products-tooltip-header">المنتجات</th>
                @if (Model.ShowFailureReasonColumn)
                {
                    <th class="d-none d-md-table-cell">أسباب الفشل</th>
                }

            </tr>
        </thead>
        <tbody>
            @foreach (var order in Model.PaginationViewModel.Items)
            {
                var statusClass = Common.GetOrderStatusClass(order.OrderStatus);
                var orderCountry = order.Country.ToString();
                var stripCountryCodeForDisplay = order.Country == Countries.البحرين
                    || order.Country == Countries.الكويت
                    || order.Country == Countries.سلطنة_عمان
                    || order.Country == Countries.قطر
                    || order.Country == Countries.تونس;
                var phoneDisplay = stripCountryCodeForDisplay
                    ? StripCountryCodeAndLeadingZero(order.TelephoneNumber, orderCountry)
                    : NormalizePhoneForDisplay(order.TelephoneNumber, orderCountry);
                var phoneCopy = (order.Country == Countries.ليبيا || stripCountryCodeForDisplay)
                    ? StripCountryCodeAndLeadingZero(order.TelephoneNumber, orderCountry)
                    : phoneDisplay;

                <tr class="order-row background-white-green pointer" data-url="@Url.Action("details", "order", new { id = order.Id })" data-order-id="@order.Id" data-order-status="@order.OrderStatus" data-failure-reason="@order.FailureReasonDisplay">

                    <td class="order-select-col">
                        <input type="checkbox" name="selectedOrders" value="@order.Id" class="order-checkbox" />
                    </td>
                    <td class="text-green text-nowrap copyable" data-copy-text="*@order.Id" data-copy-label="رقم الوصل">
                        <i class="fa-solid f-s-14 text-green fa-cube me-1"></i> @order.Id
                    </td>

                    <td class="text-nowrap d-none d-md-table-cell order-customer-name-col copyable" data-copy-text="@order.CustomerName" data-copy-label="اسم العميل">@order.CustomerName</td>
                    <td class="phone-cell copyable" data-copy-text="@phoneDisplay" data-copy-label="رقم الهاتف">@phoneDisplay</td>
                    @if (order.OrderStatus == OrderStatusEnum.تم_المعالجة)
                    {
                        <td class="d-none d-md-table-cell copyable" data-copy-text="@(order.FixedOrderDate?.ToString("yyyy-MM-dd"))" data-copy-label="التاريخ">@order.FixedOrderDate?.ToString("yyyy-MM-dd ")</td>
                    }
                    else
                    {
                        <td class="d-none d-md-table-cell copyable" data-copy-text="@order.CreatedDate.ToString("yyyy-MM-dd")" data-copy-label="التاريخ">@order.CreatedDate.ToString("yyyy-MM-dd ")</td>
                    }
                    <td class="text-end d-none d-md-table-cell text-nowrap copyable" data-copy-text="@order.Country" data-copy-label="الدولة">
                        <img loading="lazy" class="pb-1  icon-size-standard" src="@Model.CountryImageUrls[(order.Country.ToString())]" />
                        @order.Country
                    </td>
                    <td class="d-none d-md-table-cell copyable" data-copy-text="@order.State" data-copy-label="المدينة">@order.State</td>

                    <td class="text-end d-none d-md-table-cell pe-5 copyable" data-copy-text="@(order.ManufacturingCompany != null && !string.IsNullOrEmpty(order.ManufacturingCompany.Name) ? order.ManufacturingCompany.Name : Model.StoreNameFromSbS)" data-copy-label="الشركة المصنعة">
                        @if (order.ManufacturingCompany != null && !string.IsNullOrEmpty(order.ManufacturingCompany.Name))
                        {
                            <img loading="lazy" class="pb-1 icon-size-standard" src="@order.ManufacturingCompany.Logo" />
                            @order.ManufacturingCompany.Name
                        }
                        else
                        {
                            <span>@Model.StoreNameFromSbS</span>
                        }
                    </td>
                    <td class="text-end d-none d-md-table-cell copyable" data-copy-text="@order.DeliveryCompany.Name" data-copy-label="شركة التوصيل">
                        <img loading="lazy" class="pb-1 icon-size-standard" src="@order.DeliveryCompany.Logo" />
                        @order.DeliveryCompany.Name
                    </td>
                    <td class="d-none d-md-table-cell copyable" data-copy-text="@(order.LastEditedDate?.ToString("yyyy-MM-dd"))" data-copy-label="اخر تحديث">@order.LastEditedDate?.ToString("yyyy-MM-dd")</td>
                    <td class="text-end text-nowrap copyable order-status-cell" data-copy-text="@(order.OrderStatus.ToString().Replace("_", " "))" data-copy-label="حالة الطلب">
                        <span class="order-status-badge-wrapper">
                            <span class="order-status-badge order-status--@(statusClass.Replace("text-", ""))">
                                @order.OrderStatus.ToString().Replace("_", " ")
                            </span>
                        </span>
                    </td>

                    <td class="text-start text-nowrap copyable @statusClass ltr" data-copy-text="@order.TotalPrice.ToString("N0")" data-copy-label="قيمة المبلغ">
                        @if (order.IsPaid)
                        {
                            <img src="/static/documentgreen.svg" class="fatura" width="15" style="padding-top:7px !important" />
                        }
                        else
                        {
                            <img src="/static/document.svg" class="fatura" width="15" style="padding-top:7px !important" />
                        }
                        @order.TotalPrice.ToString("N0")
                        <span>@Model.CurrencySymbols[(order.Country.ToString())]</span>
                    </td>

                    @{
                        string country = orderCountry;
                        string phoneNumberCode = Common.GetPhoneNumberCodeByCountryStatus(country);
                        string phoneNumber = order.TelephoneNumber; // raw value used for external-link hrefs
                        string phoneNumberUrl = $"https://wa.me/{phoneNumberCode}{phoneNumber}";
                        string telephoneUrl = $"tel:{phoneNumberCode}{phoneNumber}";

                    }
                    <td class="order-message-col">
                        <div class="d-flex">
