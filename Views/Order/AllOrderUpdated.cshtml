    var selectedCountryText = getSelectedOptionText($country)
    .replace(/\s+/g, '')
    .replace(/-/g, '');

    return selectedCountryText.indexOf('ليبيا') !== -1;
    }

    function normalizeLibyaSearchValue(value) {
    value = String(value || '');

    if (!isLibyaCountrySelected()) {
    return value;
    }

    var trimmed = value.trim();

    if (/^0\d+$/.test(trimmed)) {
    return trimmed.replace(/^0+/, '');
    }

    return value;
    }

    function applyLibyaSearchNormalization() {
    if (!isLibyaCountrySelected()) {
    return;
    }

    var currentValue = searchInput.val();
    var normalizedValue = normalizeLibyaSearchValue(currentValue);

    if (currentValue !== normalizedValue) {
    searchInput.val(normalizedValue);
    }
    }

    function getSearchValueForRequest() {
    return normalizeLibyaSearchValue($('#searchInput').val());
