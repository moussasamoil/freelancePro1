    function submitStatusChange() {
    var reason = $('#statusChangeReason').val();
    // Capture globals before modal('hide') resets them via hidden.bs.modal callback
    var isAdvanceMode = globalAdvanceMode;
    var orderId = globalOrderId;
    var orderStatus = globalOrderStatus;
    console.log("submitStatusChange called. reason:", reason, "orderId:", orderId, "status:", orderStatus, "advanceMode:", isAdvanceMode);

    if (!reason || reason.trim() === '') {
    showNotification(
    "الرجاء اختيار سبب الفشل من القائمة.",
    null,
    "/static/trash-can-regular.svg"
    );
    return;
    }

    $('#reasonModal').modal('hide');

    var url = isAdvanceMode
    ? '/Order/AdvanceFailureStatus'
    : '/Order/UpdateStatus';

    var data = isAdvanceMode
    ? { ids: [orderId], reason: reason }
    : { id: orderId, orderStatus: orderStatus, reason: reason };

    console.log("submitStatusChange AJAX url:", url, "data:", JSON.stringify(data));
    $('#loadingIndicator').show();

    $.ajax({
    url: url,
    type: 'POST',
    data: data,
    success: function (result) {
    console.log("AJAX response:", result);
    if (result.success) {
    localStorage.removeItem('selectedOrderIds');
    localStorage.removeItem('pendingFailureReasons');
    location.reload();
    } else {
    showNotification(
    result.message || 'فشل في تعديل حالة الطلب',
    null,
    "/static/trash-can-regular.svg"
    );
    }
    },
    error: function (xhr, status, error) {
    console.error("AJAX error:", status, error);
    showNotification(
    "فشل في تعديل حالة الطلب",
    null,
    "/static/trash-can-regular.svg"
    );
    },
    complete: function () {
    $('#loadingIndicator').hide();
    globalAdvanceMode = false;
    }
    });
    }

