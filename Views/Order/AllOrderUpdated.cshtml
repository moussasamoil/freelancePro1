    var pendingFailureReasonImageFiles = {};

    function isInDeliveryFilter() {
    return parseInt($('#OrderStatusId').val()) === 4;
    }

    function clearPendingReason(btn, evt) {
    if (evt) {
    evt.preventDefault();
    evt.stopPropagation();
    }

    var $btn = $(btn);
    var $tr = $btn.closest('tr');
    var $select = $tr.find('.inline-failure-select');
    var orderId = $select.data('order-id');
    var $checkbox = $tr.find('input[type="checkbox"][name="selectedOrders"]');

    if (orderId !== undefined && orderId !== null) {
    delete pendingFailureReasons[orderId];
    delete pendingFailureReasonImageFiles[String(orderId)];
    setPendingFailureReasons(pendingFailureReasons);
    }

    var selectedOrderIds = [];
    try {
    selectedOrderIds = JSON.parse(localStorage.getItem('selectedOrderIds') || '[]');
    } catch (e) {
    selectedOrderIds = [];
    }

    var orderIdText = orderId !== undefined && orderId !== null
    ? String(orderId)
    : String($checkbox.val() || '');

    selectedOrderIds = selectedOrderIds.filter(function (id) {
    return String(id) !== orderIdText;
    });

    localStorage.setItem('selectedOrderIds', JSON.stringify(selectedOrderIds));

    $tr.data('failure-reason', '');
    $tr.attr('data-failure-reason', '');
    $tr.removeAttr('data-inline-failure-active');
    $tr.removeClass('failure failure-reason-selected-row failure-reason-row-active');
    $tr.find('.text-danger').remove();
    $btn.hide();

    if ($select.length) {
