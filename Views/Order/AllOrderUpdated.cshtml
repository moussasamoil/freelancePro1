    $('#AssignDelegateEmployeeId').on('select2:select', function () {
    var delegateId = $(this).val();
    var selectedIds = getSelectedOrderIds();
    if (!delegateId || delegateId === '-1' || selectedIds.length === 0) return;

    $.ajax({
    url: '@Url.Action("AssignOrdersToDelegate", "Order")',
    type: 'POST',
    data: { orderIds: selectedIds, delegateEmployeeId: delegateId },
    success: function (result) {
    if (result.success) {
    showNotification("تم تعيين الموظف بالنيابة بنجاح", function () { location.reload(); }, '/static/info-icon.svg');
    } else {
    showNotification(result.message || "فشل في تعيين الموظف", null, '/static/info-icon.svg');
    }
    },
    error: function () {
