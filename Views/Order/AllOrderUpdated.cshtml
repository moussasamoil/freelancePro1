    // Handle the dropdown item click event
    function updateFailStatusBtnState() {
    var $failBtn = $(".status-4");
    var $deliverBtn = $(".status-3");

    if (!isInDeliveryFilter()) {
    // Outside قيد_التوصيل filter: original dim/undim logic
    if ($failBtn.is(':hidden')) return;

    var $checkedBoxes = $('input[type="checkbox"][name="selectedOrders"]:checked');
    var hasSelection = $checkedBoxes.length > 0;
    var missingReason = $checkedBoxes.toArray().some(function (cb) {
    var failureReason = $(cb).closest('tr').data('failure-reason');
    return !failureReason || legalFailureReasons.indexOf(failureReason) === -1;
    });
    var shouldBlock = hasSelection && missingReason;

    if (shouldBlock) {
    $failBtn.css({ opacity: '0.3', cursor: 'not-allowed' }).addClass('fail-btn-blocked');
    } else {
    $failBtn.css({ opacity: '', cursor: '' }).removeClass('fail-btn-blocked');
    }
    return;
    }

    // قيد_التوصيل filter: hide/show logic
    var $checkedBoxes = $('input[type="checkbox"][name="selectedOrders"]:checked');
    var hasSelection = $checkedBoxes.length > 0;

    // فشل التسليم: hidden unless every selected order has a valid pending reason
    var allHaveReason = hasSelection && $checkedBoxes.toArray().every(function (cb) {
    var orderId = $(cb).val();
    return pendingFailureReasons[orderId] && legalFailureReasons.indexOf(pendingFailureReasons[orderId]) !== -1;
    });

    if (allHaveReason) {
    $failBtn.show().css({ opacity: '', cursor: '' }).removeClass('fail-btn-blocked');
    } else {
    $failBtn.hide().removeClass('fail-btn-blocked');
    }

    // تم التسليم: hide if any selected order has a pending failure reason
    var anyHasReason = $checkedBoxes.toArray().some(function (cb) {
    var orderId = $(cb).val();
    return !!pendingFailureReasons[orderId];
    });

    if (anyHasReason) {
    $deliverBtn.hide();
    } else {
    // restore original visibility (it's shown by the status switch)
    $deliverBtn.show();
    }
    }

    $(".btn[role='button']").click(function () {
    var $btn = $(this);

    if ($btn.hasClass('fail-btn-blocked')) {
    showAutoNotification('لا يمكن تغيير الحالة — بعض الطلبات المحددة لا تزال بدون سبب فشل', '/mainicons/exclamation mark.svg', '#f5c518', 7);
    return;
    }

    var status = $btn.data("status");

    // Disable the button immediately
    $btn.prop('disabled', true);

    // Add a class to visually indicate it's disabled
    $btn.addClass('disabled');

    // Handle the status click
    handleStatusClick(status, $btn);
