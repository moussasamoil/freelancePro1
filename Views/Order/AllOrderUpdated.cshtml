    function handleStatusClick(newStatus, $clickedButton) {
    const selectedOrderIds = getSelectedOrderIds();

    // Show notification with trash icon (though consider if this is semantically correct)
    showNotification(
    "تم تحديد الحالة: " + newStatus,
    function () {
    let url;
    if (newStatus === "تم_التجهيز") {
    url = '@Url.Action("MarkAsPrepared", "Order")';
    } else {
    url = '@Url.Action("UpdateStatusForMultiple", "Order")';
    }

    $('#loadingIndicator').show();

    var requestData = {
    ids: selectedOrderIds,
