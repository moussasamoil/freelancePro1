    if (isInDeliveryFilter() && Object.keys(pendingFailureReasons).length > 0) {
    multiFormData.append('orderReasons', JSON.stringify(pendingFailureReasons));
    }

    multiFormData.append('failureReasonImageOrderIds', JSON.stringify(pendingImageOrderIds));

    pendingImageOrderIds.forEach(function (orderId) {
    var file = pendingFailureReasonImageFiles[String(orderId)];
    multiFormData.append('failureReasonImageFiles', file);
    multiFormData.append('failedReasonImageFiles', file);
    multiFormData.append('failureImageFiles', file);
    multiFormData.append('reasonImageFiles', file);
    multiFormData.append('imageFiles', file);
    });

    ajaxRequestOptions.data = multiFormData;
    ajaxRequestOptions.processData = false;
    ajaxRequestOptions.contentType = false;
