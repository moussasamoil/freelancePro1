<script>
    var globalOrderId = null;
    var globalOrderStatus = null;
    var globalAdvanceMode = false;

    // ── Click-to-copy: toast + clipboard helper (ported from PrepareForDelivery/Index.cshtml) ──
    function copyToClipboard(text, fieldName) {
    if (text === undefined || text === null) return;
    text = String(text);
    if (!text || text === 'null') return;
    var showSuccess = function () {
    Toastify({
    text: "تم نسخ " + fieldName,
    duration: 2000,
    gravity: "bottom",
    position: "center",
    style: { background: "#2ab149", borderRadius: "8px", fontWeight: "bold" }
    }).showToast();
    };
    if (navigator.clipboard && navigator.clipboard.writeText) {
    navigator.clipboard.writeText(text).then(showSuccess);
    } else {
    var ta = document.createElement('textarea');
    ta.value = text;
    ta.style.position = 'fixed';
    ta.style.opacity = '0';
    document.body.appendChild(ta);
    ta.select();
    document.execCommand('copy');
    document.body.removeChild(ta);
    showSuccess();
    }
    }

    // Delegate click on any .copyable element using capture phase so ancestor
    // inline onclick="event.stopPropagation()" (e.g. on the failure-reason td)
    // cannot block this handler — capture fires top-down before bubble handlers.
    document.addEventListener('click', function (e) {
    var el = e.target.closest('.copyable');
    if (!el) return;
    e.stopPropagation();
    var text = el.dataset.copyText;
    var label = el.dataset.copyLabel || '';
    if (text !== undefined && text !== null && String(text).length > 0) {
    copyToClipboard(text, label);
    }
    }, true);

    // Store original button text for checked-count badge
    function initOriginalTexts() {
    $('#OrderStatus .btn[role="button"], #advanceFailureStatusBtn, #printButton, #printButtonDelivery, #printButtonDelivery2, #DeleteOrderStatuses').each(function () {
    if (!$(this).data('original-text')) {
    var text = $(this).attr('id') === 'advanceFailureStatusBtn'
    ? $('#advanceFailureStatusBtnText').text().trim()
    : $(this).clone().children('span').remove().end().text().trim() || $(this).text().trim();
    $(this).data('original-text', text);
    }
    });
    }

    function updateCheckedCount() {
    var count = $('input[type="checkbox"][name="selectedOrders"]:checked').length;
    var badge = count > 0 ? ' (' + count + ')' : '';

    $('#OrderStatus .btn[role="button"]').each(function () {
    var orig = $(this).data('original-text');
    if (orig) $(this).text(orig + badge);
    });

    var $advBtn = $('#advanceFailureStatusBtn');
    var advOrig = $advBtn.data('original-text');
    if (advOrig) $('#advanceFailureStatusBtnText').text(advOrig + badge);

    $('#printButton, #printButtonDelivery, #printButtonDelivery2, #DeleteOrderStatuses').each(function () {
    var orig = $(this).data('original-text');
    if (orig) $(this).text(orig + badge);
    });
    }
    function getPendingFailureReasons() {
    return JSON.parse(localStorage.getItem('pendingFailureReasons') || '{}');
    }
