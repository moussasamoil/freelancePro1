@model lotus_blue.Models.ViewModel.PaginationViewModel<lotus_blue.Models.ViewModel.OrderReportViewModel>

@{
    ViewData["Title"] = "فواتير شركات التوصيل ";
}


@if (User.IsInRole("Admin"))
{
    <div class="row d-flex justifiy-content-between">
        <div class="col-2" id="RangePicker">
            <div id="selectedFilter">
                <div>
                    <span class="f-s-14" id="selectedDateRange">
                        <!-- Initially, the date range will be updated by JavaScript -->
                        <i class="fa-light fa-calendar-days"></i>
                    </span>
                </div>
            </div>
        </div>

        <div class="col-2">
            <select id="DeliveryCompanyId" class="form-control drop-down-design" required>
            </select>
        </div>

        <div class="col-2">
            <select id="CountryId" name="Country" class="form-control  drop-down-design" required>
              
            </select>
        </div>
        <div class="col-2">
            <select id="ManufacturingCompanyId" class="form-control drop-down-design" required>
            </select>
        </div>

    </div>


    <div class="row mb-3 mt-3">




        <!-- Second column -->
        <div class="col d-flex align-items-center justify-content-end">
            <div class="form-group d-flex align-items-center">
                <label for="pageSize" class="me-2">أظهر:</label>
                <select id="pageSize" name="pageSize" class="form-control me-2">
                    <option value="10">10</option>
                    <option value="25">25</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                </select>
                <label for="pageSize">مدخلات</label>
            </div>
        </div>


    </div>
}
<table class="table">
    <thead>
    <thead>
        <tr>
            <th>الحالة</th>
            <th>قيمة المبلغ </th>

            <th>التاريخ </th>
            <th>رقم الحساب</th>
            <th> الدولة</th>
            <th>اسم شركة التوصيل</th>
            <th>تحميل</th>
        </tr>
    </thead>
    <tbody>
            @foreach (var report in Model.Items)
            {
            <tr>
                <Td>صادر</Td>
                <td>@report.TotalAmount</td>
                <td>@report.GeneratedTime</td>

                <td>@report.Id</td>
                <td>@report.Country</td>
                <td>@report.DeliveryCompanyName</td>
                <td>
                    <button onclick="window.open('@Url.Action("PrintOrdersForDelivery", "Pdf", new { report.Id })', '_blank')" class="btn text-white btn-success">تحميل الفاتورة</button>
                </td>
            </tr>
            }
    </tbody>
</table>



<div id="pagination-link" class="mt-0 container-fluid">
    <div class="d-flex justify-content-between align-items-center">

        <p class="text-start pt-2 total-items-display">@Model.TotalItems عدد الفواتير</p>

        <nav aria-label="Page navigation" class="mx-auto">
            <div class="d-flex justify-content-start">
                <ul class="pagination p-0">
                    <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link pointer" data-page="1">
                            <i class="fa-solid fa-chevron-double-right text-green"></i>
                        </a>
                    </li>
                    <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link" data-page="@(Model.CurrentPage - 1)">
                            <i class="fa-solid fa-chevron-right text-green"></i>
                        </a>
                    </li>

                    @{
                        int startPage = Model.CurrentPage;
                        int endPage = startPage + 2;
                        if (endPage > Model.TotalPages)
                        {
                            endPage = Model.TotalPages;
                        }
                    }

                    @for (int i = startPage; i <= endPage; i++)
                    {
                        <li class="numbers page-item @(Model.CurrentPage == i ? "active" : "")">
                            <a class="page-link" data-page="@i">@i</a>
                        </li>
                    }

                    @if (Model.TotalPages > endPage)
                    {
                        <li class="page-item disabled">
                            <span class="page-link">...</span>
                        </li>

                        @for (int i = Model.TotalPages - 2; i <= Model.TotalPages; i++)
                        {
                            <li class="numbers page-item @(Model.CurrentPage == i ? "active" : "")">
                                <a class="page-link" data-page="@i">@i</a>
                            </li>
                        }
                    }



                    <li class="page-item @(Model.CurrentPage ==  Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" data-page="@(Model.CurrentPage + 1)">
                            <i class="fa-solid fa-chevron-left text-green f-s-18"></i>
                        </a>
                    </li>
                    <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" data-page="@(Model.TotalPages)">
                            <i class="fa-solid fa-chevron-double-left text-green"></i>
                        </a>
                    </li>


                </ul>
            </div>
        </nav>


    </div>
</div>






<style>
    /* Custom pagination styles */
    .search-input {
        height: 2rem !important; /* Adjust the height to your preference */
    }

    .input-group {
        position: relative;
    }

    .icon {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
    }

    .clear-search-icon {
        left: 10px;
        cursor: pointer;
    }

    .search-icon {
        right: 15px;
        position: absolute; /* You can use "relative", "absolute", "fixed", or "sticky" depending on your layout needs */
        z-index: 1;
    }

    .icon.search-icon {
        z-index: 9999 !important; /* Set a high z-index value */
    }

    #searchingshow {
        visibility: hidden;
        z-index: 9999 !important;
    }

    .hidden {
        visibility: hidden !important;
    }

</style>

<script>
    var rangePicker;

    $('#RangePicker').daterangepicker({
        ranges: {
            'اليوم': [moment(), moment()],
            'أمس': [moment().subtract(1, 'days'), moment().subtract(1, 'days')],
            'الأيام السبعة الماضية': [moment().subtract(6, 'days'), moment()],
            'الثلاثين يوما الأخيرة': [moment().subtract(29, 'days'), moment()],
            'هذا الشهر': [moment().startOf('month'), moment().endOf('month')],
            'الشهر الماضي': [moment().subtract(1, 'month').startOf('month'), moment().subtract(1, 'month').endOf('month')]
        },
        "alwaysShowCalendars": true,
        "startDate": moment('2023-11-12'),
        "endDate": moment().endOf('month')
    }, function (start, end, label) {
        // Update the content of the selectedDateRange span with the selected start and end dates
        $('#selectedDateRange').html(start.format('YYYY-MM-DD') + ' إلى ' + end.format('YYYY-MM-DD') + ' <i class="fa-light fa-calendar-days"></i>');
        FetchOrderReports(); // Call FetchOrderReports function after selecting dates
    });

    rangePicker = $('#RangePicker').data('daterangepicker');

    // Update the content of the selectedDateRange span when the page loads
    var start = $('#RangePicker').data('daterangepicker').startDate;
    var end = $('#RangePicker').data('daterangepicker').endDate;
    $('#selectedDateRange').html(start.format('YYYY-MM-DD') + ' إلى ' + end.format('YYYY-MM-DD') + ' <i class="fa-light fa-calendar-days"></i>');


    $('#searchInput').on('input', function () {
        FetchOrderReports();
    });

    $('#pagination-link').on('click', '.page-link', function (e) {
        e.preventDefault(); // Prevent the default link behavior
        var page = $(this).data('page'); // Get the page number from the data-page attribute of the clicked link
        FetchOrderReports(page); // Pass the page number to the FetchOrderReports function
    });



    function FetchOrderReports(page) {
        var deliveryCompanyId = $('#DeliveryCompanyId').val(); // Get the selected delivery company id
        var pageSize = $('#pageSize').val(); // Get the selected page size

        if (!rangePicker) {
            console.error('daterangepicker instance is not initialized');
            return;
        }

        // Get the selected start and end dates
        var startDate = rangePicker.startDate;
        var endDate = rangePicker.endDate;
        var country = $('#CountryId').val();
        var storeId = $('#ManafacturingComapnyId').val();

        $.ajax({
            url: '@Url.Action("OrderReports", "Financial")', // Make sure this points to the correct controller and action
            type: 'GET',
            data: {
                page: page,
                pagesize: pageSize,
                deliveryCompanyIdFilter: deliveryCompanyId,
                startDay: startDate.format('YYYY-MM-DD'),
                endDay: endDate.format('YYYY-MM-DD'),
                countryId: country,
                storeId: storeId

            },
            success: function (result) {
                // Update the HTML of the table and pagination controls
                const newTable = $(result).find('.table').html();
                $('.table').html(newTable);
                const newPagination = $(result).find('.pagination').html();
                $('.pagination').html(newPagination);
                const TotalItems = $(result).find('.total-items-display').html();
                $('.total-items-display').html(TotalItems);

            },
            error: function (xhr, status, error) {
                console.error("An error occurred: " + status + ", " + error);
            }
        });
    }




    $(document).ready(function () {
     
     // Bind change event to the Country select
        $('#ManafacturingComapnyId,#CountryId,#pageSize,#DeliveryCompanyId').change(function () {
            FetchOrderReports(); // Fetch data with updated filters
        });


    
      

   

    });





</script>