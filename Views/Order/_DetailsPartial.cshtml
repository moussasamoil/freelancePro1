@functions {
    Func<OrderStatusHistoryModel, bool> getStatusPredicate(OrderStatusEnum statusEnum)
    {
        return h => Model.ExternalOrderId.HasValue ? h.StatusApi == statusEnum.ToString() : h.Status == statusEnum;
    }
}

<div class="container px-0 px-lg-3 ms-lg-5 me-lg-5">
    <div class="row ms-0 me-0 d-flex justify-content-center align-items-center d-flex flex-column mt-5">
        @{
            // Retrieve and sort the histories by CreatedAt date
            var sortedStatusHistories = Model.OrderStatusHistories
            .Where(history => history.Status.HasValue)
            .OrderByDescending(history => history.CreatedAt)  // Sorting by date descending to show the latest first
            .ToList();

            var loggedInUserId = Model.LoggedInUserId; // Retrieve logged-in user ID from the model

            // Display all status histories without hiding any
            var displayStatusHistories = sortedStatusHistories;

            @foreach (var history in displayStatusHistories)
            {
                var status = (OrderStatusEnum)history.Status;
                var isLatestStatus = history == displayStatusHistories.FirstOrDefault();
                var colorStyle = isLatestStatus ? OrderStatusHelper.StatusColorMapping.GetValueOrDefault(status, "") : "";
                var iconClass = isLatestStatus ? "fa-solid fa-lg fa-circle-check" : "fa-light fa-lg fa-circle-check";

                // Add a data-history-id attribute to the row for easy lookup in JavaScript
                <div class="row mt-2 order-status-history-row" data-history-id="@history.Id">
                    <div class="col-lg-4 col-md-6 col-3 text-start p-0">
                        @if (!User.IsInRole("DeliveryCompany") && !User.IsInRole("DeliveryRepresentative"))
                        {
                            <h6 class="fw-light text-nowrap">@((history?.UserName) ?? "شركة LUXIRA HOLDING التركية")</h6>
                        }
                        else
                        {
                            @if (history.UserId == loggedInUserId)
                            {
                                <h6 class="fw-light text-nowrap">@((history?.UserName) ?? "شركة LUXIRA HOLDING التركية")</h6>
                            }
                            else
                            {
                                <h6 class="fw-light text-nowrap">شركة LUXIRA HOLDING التركية</h6>
                            }
                        }
                        <h6 class="fw-light text-nowrap">@((history?.CreatedAt?.ToString("yyyy/MM/dd")) ?? "غير معروف")</h6>
                        <h6 class="fw-light text-dark text-nowrap">@((history?.CreatedAt?.ToString("HH:mm tt")) ?? "غير معروف")</h6>
                    </div>

                    <div id="statusDiv@(status.ToString().Replace("_", ""))" class="col-lg-2 col-md-2 col-3 vertical-linelocal @(isLatestStatus ? "no-line animateVisibility" : "") text-center statusDiv@history.Id">
                        <i class="@iconClass mb-4" style="@colorStyle"></i>
                    </div>

                    <div class="col-lg-3 col-md-4 col-3 pe-0">
                        <h1 class="f-s-14 size text-nowrap">@status.ToString().Replace("_", " ")</h1>
                        <h6 class="fw-light text-nowrap" style="@(isLatestStatus ? "color: #FF0000;" : "")">@OrderStatusHelper.GetOrderStatusPhrase(status)</h6>
                    </div>

                    @if (User.IsInRole("Admin"))
                    {
                        <div class="col-lg-3 d-flex justify-content-end col-md-4 col-3 pe-0">
                            <label class="ios-switch">
                                <input id="toggleIsHiddenForOrderStatus@history.Id" type="checkbox" @(history.IsHidden ? "checked" : "") data-history-id="@history.Id" class="toggle-is-hidden" />
                                <i></i>
                            </label>
                        </div>
                    }
                </div>
            }
        }
    </div>
</div>


