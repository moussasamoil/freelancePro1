            window.UpdatePaymentStatus = function (orderId, isPaid) {
                if (isPaid) {
                    // Open receipt modal — submit happens from inside the modal's تأكيد button
                    $.ajax({
                        url: '/Order/PaymentReceiptModal',
                        type: 'GET',
                        success: function (data) {
                            $('body > [data-payment-receipt-modal]').remove();
                            var $wrapper = $('<div data-payment-receipt-modal="true"></div>').html(data);
                            $('body').append($wrapper);

                            var $receiptModal = $wrapper.find('#paymentReceiptModal');
                            $receiptModal.css('z-index', 1065);

                            var $paste = $wrapper.find('#paymentReceiptPaste');
                            var $fileInput = $wrapper.find('#paymentReceiptFileInput');

                            $paste.on('click', function () { $fileInput.trigger('click'); });

                            $fileInput.on('change', function () {
                                var file = this.files && this.files[0];
                                if (!file) return;
                                var reader = new FileReader();
                                reader.onload = function (e) {
                                    $paste.empty().append($('<img>').attr('src', e.target.result));
                                };
                                reader.readAsDataURL(file);
                                $wrapper.find('#paymentReceiptError').hide();
                            });

                            $paste.on('paste', function (e) {
                                var items = (e.originalEvent || e).clipboardData && (e.originalEvent || e).clipboardData.items;
                                if (!items) return;
                                for (var i = 0; i < items.length; i++) {
                                    if (items[i].type.indexOf('image') === 0) {
                                        e.preventDefault();
                                        var blob = items[i].getAsFile();
                                        var dt = new DataTransfer();
                                        dt.items.add(blob);
                                        $fileInput[0].files = dt.files;
                                        var reader = new FileReader();
                                        reader.onload = function (ev) {
                                            $paste.empty().append($('<img>').attr('src', ev.target.result));
                                        };
                                        reader.readAsDataURL(blob);
                                        $wrapper.find('#paymentReceiptError').hide();
                                        return;
                                    }
                                }
                            });

                            $receiptModal.on('shown.bs.modal', function () {
                                document.body.classList.add('modal-open');
                                var backdrops = document.querySelectorAll('.modal-backdrop');
                                if (backdrops.length > 1) {
                                    backdrops[backdrops.length - 1].style.zIndex = '1060';
                                }
                            });
                            $receiptModal.on('hidden.bs.modal', function () {
                                document.body.classList.add('modal-open');
                                $wrapper.remove();
                            });

                            window.submitPaymentReceipt = function () {
                                var fileEl = $fileInput[0];
                                if (!fileEl.files || fileEl.files.length === 0) {
                                    $wrapper.find('#paymentReceiptError').show();
                                    return;
                                }
                                var fd = new FormData();
                                fd.append('isPaid', 'true');
                                fd.append('paymentReceiptFile', fileEl.files[0]);
                                $.ajax({
                                    url: '/Order/SetIsPaid/' + orderId,
                                    type: 'POST',
                                    data: fd,
                                    processData: false,
                                    contentType: false,
                                    success: function () {
                                        $receiptModal.modal('hide');
                                        window.invalidateOrder(orderId);
                                        window.refreshModalContent(orderId);
                                        window.refreshOrderTable();
                                    },
                                    error: function (xhr) {
                                        var msg = (xhr.responseJSON && xhr.responseJSON.message) || 'فشل في حفظ صورة الإيصال.';
                                        $wrapper.find('#paymentReceiptError').text(msg).show();
                                    }
                                });
                            };

                            $receiptModal.modal('show');
                        },
                        error: function (xhr, status, error) {
                            console.error('Error loading payment receipt modal: ' + error);
                        }
                    });
                    return;
                }

                showNotification(
                    'هل أنت متأكد من تغيير حالة الطلب؟',
                    function () {
                        $.ajax({
                            url: '/Order/SetIsPaid/' + orderId,
                            type: 'POST',
                            data: { isPaid: isPaid },
                            success: function () {
                                window.invalidateOrder(orderId);
                                window.refreshModalContent(orderId);
                                window.refreshOrderTable();
                            },
                            error: function (error) {
                                console.error('AJAX request failed:', error);
                            }
                        });
                    }
                );
            };

            window.updateOrderApplicationUser = function (orderId, newApplicationUserId) {
                showNotification(
                    'هل أنت متأكد من تعيين هذا الموظف لهذا الطلب؟',
                    function () {
                        $.ajax({
                            url: '/Order/UpdateOrderApplicationUser',
                            type: 'POST',
                            data: { orderId: orderId, newApplicationUserId: newApplicationUserId },
                            success: function () {
                                window.invalidateOrder(orderId);
                                window.refreshModalContent(orderId);
                                window.refreshOrderTable();
                            },
                            error: function (error) {
                                console.error('AJAX request failed:', error);
                            }
                        });
                    }
                );
            };

            window.updateStatus = function (orderId, orderStatusText) {
                if (!orderStatusText) {
                    console.error("orderStatusText is null or undefined.");
                    return;
                }
                var orderStatus = statusEnumMapping[orderStatusText];
                if (!orderStatus) {
                    console.error("Failed to map orderStatusText to orderStatus.");
                    return;
                }
                globalOrderId = orderId;
                globalOrderStatus = orderStatus;

                var statusesRequiringReason = [
                    'فشل_التسليم', 'فشل_التسليم_2', 'فشل_التسليم_3',
                    'فشل_التسليم_4', 'فشل_التسليم_5', 'فشل_التسليم_6', 'فشل_التسليم_7'
                ];

                if (statusesRequiringReason.indexOf(orderStatus) !== -1) {
                    $.ajax({
                        url: '/Order/FailureReasonModal',
                        type: 'GET',
                        success: function (data) {
                            // Remove any previous child modal
                            $('body > [data-child-modal]').remove();

                            var $wrapper = $('<div data-child-modal="true"></div>').html(data);
                            $('body').append($wrapper);

                            var $reasonModal = $wrapper.find('#reasonModal');
                            $reasonModal.css('z-index', 1065);

                            if (!$wrapper.find('#failureReasonImageInput').length) {
                                var failureReasonImageHtml =
                                    '<div class="mt-3 failure-reason-image-wrapper" dir="rtl">' +
                                    '  <label class="form-label fw-bold">صورة سبب فشل الطلب <span class="text-muted">(اختياري)</span></label>' +
                                    '  <div id="failureReasonImagePaste" tabindex="0" class="failure-reason-image-paste-box" style="min-height:130px;border:2px dashed #d1d5db;border-radius:12px;background:#f8fafc;display:flex;align-items:center;justify-content:center;text-align:center;color:#64748b;font-weight:700;cursor:pointer;padding:12px;">' +
                                    '    اختاري صورة أو اضغطي Ctrl + V للصق صورة سبب الفشل إذا متاحة' +
                                    '  </div>' +
                                    '  <input type="file" id="failureReasonImageInput" accept="image/*" style="display:none;" />' +
                                    '  <div id="failureReasonImageError" class="text-danger mt-2" style="display:none;font-size:13px;">الملف المختار يجب أن يكون صورة.</div>' +
                                    '</div>';

                                var $insertAfter = $wrapper.find('#statusChangeReason').closest('.form-group, .mb-3, .col-12, .modal-body').first();

                                if ($insertAfter.length && !$insertAfter.hasClass('modal-body')) {
                                    $insertAfter.after(failureReasonImageHtml);
                                } else {
                                    $reasonModal.find('.modal-body').append(failureReasonImageHtml);
                                }

                                var $failurePaste = $wrapper.find('#failureReasonImagePaste');
                                var $failureFileInput = $wrapper.find('#failureReasonImageInput');

                                function previewFailureReasonImage(file) {
                                    if (!file) return;

                                    if (!/^image\//i.test(file.type || '')) {
                                        $wrapper.find('#failureReasonImageError').show();
                                        return;
                                    }

                                    $wrapper.find('#failureReasonImageError').hide();

                                    var reader = new FileReader();
                                    reader.onload = function (event) {
                                        $failurePaste
                                            .empty()
                                            .append($('<img>').attr('src', event.target.result).attr('alt', 'صورة سبب الفشل').css({
                                                'max-width': '100%',
                                                'max-height': '180px',
                                                'object-fit': 'contain',
                                                'border-radius': '10px'
                                            }));
                                    };
                                    reader.readAsDataURL(file);
                                }

                                $failurePaste.on('click', function () {
                                    $failureFileInput.trigger('click');
                                });

                                $failureFileInput.on('change', function () {
                                    var file = this.files && this.files[0];

                                    if (file) {
                                        previewFailureReasonImage(file);
                                    }
                                });

                                function handleFailureReasonImagePaste(e) {
                                    var clipboardItems = (e.originalEvent || e).clipboardData && (e.originalEvent || e).clipboardData.items;

                                    if (!clipboardItems) return;

                                    for (var i = 0; i < clipboardItems.length; i++) {
                                        if (clipboardItems[i].type && clipboardItems[i].type.indexOf('image') === 0) {
                                            e.preventDefault();

                                            var blob = clipboardItems[i].getAsFile();
                                            var dataTransfer = new DataTransfer();
                                            dataTransfer.items.add(blob);
                                            $failureFileInput[0].files = dataTransfer.files;

                                            previewFailureReasonImage(blob);
                                            return;
                                        }
                                    }
                                }

                                $failurePaste.on('paste', handleFailureReasonImagePaste);
                                $reasonModal.on('paste', handleFailureReasonImagePaste);
                            }

                            fetchFailureReasons('#statusChangeReason', function () {
                                var previousReason = $c.find('#failedReasonText').text().trim();
                                if (previousReason) {
                                    var matchingOption = $wrapper.find('#statusChangeReason option').filter(function () {
                                        return $(this).val() === previousReason;
                                    });
                                    if (matchingOption.length > 0) {
                                        $wrapper.find('#statusChangeReason').val(previousReason);
                                    }
                                }
                                $wrapper.find('#statusChangeReason').select2({
                                    placeholder: { id: '', text: 'اختر سبب الفشل', image: '/mainicons/circle-exclamation-regular.svg' },
                                    allowClear: true,
                                    templateResult: formatOption,
                                    templateSelection: formatOption,
                                    dir: "rtl",
                                    minimumResultsForSearch: 1,
                                    width: '100%',
                                    dropdownParent: $reasonModal
                                });
                                $reasonModal.on('shown.bs.modal', function () {
                                    document.body.classList.add('modal-open');
                                    var backdrops = document.querySelectorAll('.modal-backdrop');
                                    if (backdrops.length > 1) {
                                        backdrops[backdrops.length - 1].style.zIndex = '1060';
                                    }
                                });
                                $reasonModal.on('hidden.bs.modal', function () {
                                    document.body.classList.add('modal-open');
                                    $wrapper.remove();
                                });
                                $reasonModal.modal('show');
                            });
                        },
                        error: function (xhr, status, error) {
                            console.error('Error loading failure reason modal: ' + error);
                        }
                    });
                } else {
                    showNotification(
                        'هل أنت متأكد من تغيير الحالة إلى ' + orderStatusText + '؟',
                        function () { submitStatusChange(); }
                    );
                }
            };

            window.submitStatusChange = function () {
                var reason = '';
                var failureReasonImageFile = null;
                var $reasonModal = $('body > [data-child-modal] #reasonModal');

                if ($reasonModal.length && $reasonModal.is(':visible')) {
                    reason = $reasonModal.find('#statusChangeReason').val() || $('#statusChangeReason').val();

                    if (!reason || reason.trim() === '') {
                        showNotification(
                            "الرجاء اختيار سبب الفشل من القائمة.",
                            function () { hideNotification(); },
                            "/static/trash-can-regular.svg"
                        );
                        return;
                    }

                    var failureImageInput = $reasonModal.find('#failureReasonImageInput')[0];

                    if (failureImageInput && failureImageInput.files && failureImageInput.files.length > 0) {
                        failureReasonImageFile = failureImageInput.files[0];
                    }

                    $reasonModal.modal('hide');
                }

                var ajaxOptions = {
                    url: '/Order/UpdateStatus',
                    type: 'POST',
                    success: function (result) {
                        if (result.success) {
                            hideNotification();
                            window.invalidateOrder(globalOrderId);
                            window.refreshModalContent(globalOrderId);
                            window.refreshOrderTable();
                        } else {
                            showNotification(
                                result.message || 'فشل في تعديل حالة الطلب',
                                function () { hideNotification(); },
                                "/static/trash-can-regular.svg"
                            );
                        }
                    },
                    error: function (xhr, status, error) {
                        console.error("Error occurred during AJAX request:", error);
                        showNotification(
                            "فشل في تعديل حالة الطلب",
                            function () { hideNotification(); },
                            "/static/trash-can-regular.svg"
                        );
                    }
                };

                if (failureReasonImageFile) {
                    var formData = new FormData();
                    formData.append('id', globalOrderId);
                    formData.append('orderStatus', globalOrderStatus);
                    formData.append('reason', reason);

                    // أسماء متعددة لنفس الملف لتوافق أي اسم باراميتر موجود في الكنترولر
                    formData.append('failureReasonImageFile', failureReasonImageFile);
                    formData.append('failedReasonImageFile', failureReasonImageFile);
                    formData.append('failureImageFile', failureReasonImageFile);
                    formData.append('reasonImageFile', failureReasonImageFile);
                    formData.append('imageFile', failureReasonImageFile);

                    var token = $('input[name="__RequestVerificationToken"]').first().val();

                    if (token) {
                        formData.append('__RequestVerificationToken', token);
                    }

                    ajaxOptions.data = formData;
                    ajaxOptions.processData = false;
                    ajaxOptions.contentType = false;
                } else {
                    ajaxOptions.data = {
                        id: globalOrderId,
                        orderStatus: globalOrderStatus,
                        reason: reason
                    };
                }

                $.ajax(ajaxOptions);
            };

            // ---- updateStatusDisplay — called by SignalR handler ----
            window.updateStatusDisplay = function (order) {
                if (!$c || !$c.length) return;
                var cancelButton = $c.find('#cancelButton')[0];
                var processingButton = $c.find('#processingButton')[0];
                var reasonElement = $c.find('#orderDetails_failedReason')[0];

                if (reasonElement) {
                    reasonElement.innerHTML = '';
                    if (order.reason) {
                        var dtElement = document.createElement('dt');
                        dtElement.className = 'mb-1 col-3';
                        dtElement.innerText = 'سبب فشل التسليم';
                        var ddElement = document.createElement('dd');
                        ddElement.className = 'me-5 text-center background-red rounded-pill fw-bold h5 text-nowrap text-white px-5 py-1';
                        ddElement.innerHTML = '<i class="fa-sharp fa-solid fa-circle-exclamation"></i> ' + order.reason;
                        reasonElement.appendChild(dtElement);
                        reasonElement.appendChild(ddElement);
                        reasonElement.style.display = "flex";
                    } else {
                        reasonElement.style.display = "none";
                    }
                }

                if (cancelButton) {
                    if (order.status === 'تم_الإلغاء') {
                        cancelButton.setAttribute("style", "background-color:red!important;");
                        cancelButton.classList.add('text-white');
                    } else {
                        cancelButton.setAttribute("style", "");
                        cancelButton.classList.remove('text-white');
                    }
                }

                if (processingButton) {
                    if (order.status === 'تم_المعالجة') {
                        processingButton.setAttribute("style", "background-color:#45bbea!important;");
                        processingButton.classList.add('text-white');
                    } else {
                        processingButton.setAttribute("style", "");
                        processingButton.classList.remove('text-white');
                    }
                }

                var statusString = order.status;
                var normalizedStatus = statusString.replace("_", "");
                var newRow = document.createElement('div');
                newRow.className = 'row mt-2';

                var userDateInfoDiv = document.createElement('div');
                userDateInfoDiv.className = 'col-lg-4 col-md-6 col-3 text-start p-0';
                userDateInfoDiv.innerHTML =
                    '<h6 class="fw-light text-nowrap">' + (order.userName || "UNKNOWN") + '</h6>' +
                    '<h6 class="fw-light text-nowrap">' + new Date(order.createdAt).toLocaleDateString() + '</h6>' +
                    '<h6 class="fw-light text-dark text-nowrap">' + new Date(order.createdAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) + '</h6>';

                var statusDiv = document.createElement('div');
                statusDiv.id = 'statusDiv' + normalizedStatus + '_' + Date.now();
                statusDiv.className = 'col-lg-2 col-md-2 col-3 vertical-linelocal text-center animateVisibility no-line';
                statusDiv.innerHTML = '<i class="fa-solid fa-lg fa-circle-check mb-4" style="' + (order.colorStyle || '') + '"></i>';

                var statusInfoDiv = document.createElement('div');
                statusInfoDiv.className = 'col-lg-3 col-md-4 col-3 pe-0';
                statusInfoDiv.innerHTML =
                    '<h1 class="f-s-14 size text-nowrap">' + statusString.replace("_", " ") + '</h1>' +
                    '<h6 class="fw-light text-nowrap">' + (order.statusPhrase || "تم الأنتهاء من تجهيز الطلب") + '</h6>';

                newRow.appendChild(userDateInfoDiv);
                newRow.appendChild(statusDiv);
                newRow.appendChild(statusInfoDiv);

                if (isAdmin === true) {
                    var statusInfoSwitchDiv = document.createElement('div');
                    statusInfoSwitchDiv.className = 'col-lg-3 d-flex justify-content-end col-md-4 col-3 pe-0';
                    statusInfoSwitchDiv.innerHTML =
                        '<label class="ios-switch">' +
                        '<input id="toggleIsHiddenForOrderStatus' + order.Id + '" type="checkbox" ' + (order.IsHidden ? "checked" : "") + ' data-history-id="' + order.Id + '" class="toggle-is-hidden" />' +
                        '<i></i></label>';
                    newRow.appendChild(statusInfoSwitchDiv);
                }

                var statusContainer = $c.find('.container > .row')[0];
                if (statusContainer) {
                    var previousStatusDiv = statusContainer.querySelector('.row.mt-2:first-child .col-lg-2');
                    if (previousStatusDiv) {
                        previousStatusDiv.classList.remove('animateVisibility', 'no-line');
                        var previousIcon = previousStatusDiv.querySelector('i');
                        if (previousIcon) {
                            previousIcon.classList.remove('fa-solid');
                            previousIcon.classList.add('fa-light');
                            previousIcon.style.color = '';
                        }
                        previousStatusDiv.classList.add('vertical-linelocal');
                    }
                    statusContainer.insertBefore(newRow, statusContainer.firstChild);
                }
            };

        })();
</script>

