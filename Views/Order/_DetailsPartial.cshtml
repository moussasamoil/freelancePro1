    <script id="details-dropdown-above-buttons-final-script">
        (function () {
            function setImportant(el, prop, value) {
                if (el && el.style) el.style.setProperty(prop, value, 'important');
            }

            function markDropdownOpen(target) {
                if (!target || !target.closest) return;

                var dropdown = target.closest('.dropdown');
                if (!dropdown) return;

                document.querySelectorAll('.split-dropdown-open-top').forEach(function (el) {
                    if (el !== dropdown) el.classList.remove('split-dropdown-open-top');
                });

                dropdown.classList.add('split-dropdown-open-top');
                setImportant(dropdown, 'position', 'relative');
                setImportant(dropdown, 'z-index', '2147483600');
                setImportant(dropdown, 'overflow', 'visible');

                var menu = dropdown.querySelector('.dropdown-menu, .dropdown-menu-employees, .dropdown-menu-ispaid');
                if (menu) {
                    setImportant(menu, 'z-index', '2147483647');
                    setImportant(menu, 'display', 'block');
                    setImportant(menu, 'visibility', 'visible');
                    setImportant(menu, 'opacity', '1');
                    setImportant(menu, 'background', '#fff');
                }

                // Lower all sibling button wrappers while the menu is open.
                var actionRow = dropdown.closest('.d-flex, .row, .container');
                if (actionRow) {
                    actionRow.querySelectorAll('.flex-item-equal, .custom-box-shadow, .open, .btn, button').forEach(function (el) {
                        if (el === dropdown || dropdown.contains(el) || el.contains(dropdown)) return;
                        setImportant(el, 'position', 'relative');
                        setImportant(el, 'z-index', '1');
                    });
                }
            }

            function unmarkDropdown(target) {
                if (!target || !target.closest) return;

                var dropdown = target.closest('.dropdown');
                if (!dropdown) return;

                setTimeout(function () {
                    var menu = dropdown.querySelector('.dropdown-menu, .dropdown-menu-employees, .dropdown-menu-ispaid');
                    if (!menu || !menu.classList.contains('show')) {
                        dropdown.classList.remove('split-dropdown-open-top');
                    }
                }, 120);
            }

            document.addEventListener('show.bs.dropdown', function (event) {
                markDropdownOpen(event.target);
            }, true);

            document.addEventListener('shown.bs.dropdown', function (event) {
                markDropdownOpen(event.target);
                setTimeout(function () { markDropdownOpen(event.target); }, 80);
            }, true);

            document.addEventListener('hide.bs.dropdown', function (event) {
                unmarkDropdown(event.target);
            }, true);

            document.addEventListener('hidden.bs.dropdown', function (event) {
                unmarkDropdown(event.target);
            }, true);

            document.addEventListener('click', function (event) {
                var toggle = event.target && event.target.closest
                    ? event.target.closest('[data-bs-toggle="dropdown"], .dropdown-toggle')
                    : null;

                if (toggle) {
                    markDropdownOpen(toggle);
                    setTimeout(function () { markDropdownOpen(toggle); }, 80);
                    setTimeout(function () { markDropdownOpen(toggle); }, 180);
                }
            }, true);
        })();
    </script>
}

