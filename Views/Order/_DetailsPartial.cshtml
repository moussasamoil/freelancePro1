<script>
        // Order Details Partial — Phase 3
        // Defines initOrderDetails(container) and destroyOrderDetails(container).
        // Called by the modal lifecycle in Index.cshtml after HTML injection via createContextualFragment.
        (function () {
            var isAdmin = @((User.IsInRole("Admin")) ? "true" : "false");
            var orderId = @Model.Id;
            var isSpecialClient = @(Model.IsClientSpecial.ToString().ToLower());

            var statusEnumMapping = {
                'تم_الإلغاء': 'تم_الإلغاء',
                'فشل_التسليم': 'فشل_التسليم',
                'طلب_جديد': 'طلب_جديد',
                'تم_التجهيز': 'تم_التجهيز',
                'قيد_التوصيل': 'قيد_التوصيل',
                'تم_التسليم': 'تم_التسليم',
                'انتظار_المعالجة': 'انتظار_المعالجة',
                'تم_المعالجة': 'تم_المعالجة',
                'أرشيف_المرجع': 'أرشيف_المرجع',
                'الطلبات_المعلقة': 'الطلبات_المعلقة',
                'الطلبات_المرجعة': 'الطلبات_المرجعة',
                'تم_تحديث_الرصيد': 'تم_تحديث_الرصيد',
                'الطلبات_الغير_معرفة': 'الطلبات_الغير_معرفة',
                'الطلبات_الغير_مكتملة': 'الطلبات_الغير_مكتملة',
                'تم_التسليم_المؤقت': 'تم_التسليم_المؤقت',
                'فشل_التسليم_2': 'فشل_التسليم_2',
                'فشل_التسليم_3': 'فشل_التسليم_3',
                'فشل_التسليم_4': 'فشل_التسليم_4',
                'فشل_التسليم_5': 'فشل_التسليم_5',
                'فشل_التسليم_6': 'فشل_التسليم_6',
                'فشل_التسليم_7': 'فشل_التسليم_7',
                'الطلبات_الغير_مكتملة_2': 'الطلبات_الغير_مكتملة_2',
                'الطلبات_الغير_مكتملة_3': 'الطلبات_الغير_مكتملة_3',
                'الطلبات_الغير_مكتملة_4': 'الطلبات_الغير_مكتملة_4',
                'الطلبات_الغير_مكتملة_5': 'الطلبات_الغير_مكتملة_5',
                'الطلبات_الغير_مكتملة_6': 'الطلبات_الغير_مكتملة_6'
            };

            // These are set during init and cleared during destroy
            var globalOrderId, globalOrderStatus;
            var $c; // jQuery-wrapped container passed to initOrderDetails

            // ---- initOrderDetails ----
            // Called by the modal lifecycle (Index.cshtml) after the partial HTML is injected.
            // container = the modal body DOM element.
            window.initOrderDetails = function (container) {
                $c = $(container);

                // Set up print order link
                var printOrderLink = $c.find('#printOrderLink')[0];
                if (printOrderLink) {
                    printOrderLink.href = '/pdf/printorder?ids=' + orderId;
                    printOrderLink.target = '_blank';
                }

                function ensureCopyOptionsStyles() {
                    if (document.getElementById('orderCopyOptionsStyles')) return;

                    var style = document.createElement('style');
                    style.id = 'orderCopyOptionsStyles';
                    style.textContent = `
                                                                            .order-details-partial .copyable {
                                                                                cursor: pointer !important;
                                                                                position: relative !important;
                                                                                display: inline-flex !important;
                                                                                align-items: center !important;
                                                                                justify-content: flex-start !important;
                                                                                gap: 7px !important;
                                                                                max-width: 100% !important;
                                                                                min-height: 28px !important;
                                                                                white-space: normal !important;
                                                                                overflow-wrap: anywhere !important;
                                                                                word-break: break-word !important;
                                                                                vertical-align: middle !important;
                                                                            }

                                                                            .order-details-partial dd.copyable,
                                                                            .order-details-partial td.copyable,
                                                                            .order-details-partial span.copyable {
                                                                                width: auto !important;
                                                                            }

                                                                            .order-details-partial .copy-visible-icon {
                                                                                display: inline-flex !important;
                                                                                align-items: center !important;
                                                                                justify-content: center !important;
                                                                                width: 30px !important;
                                                                                height: 30px !important;
                                                                                min-width: 30px !important;
                                                                                flex: 0 0 30px !important;
                                                                                margin-inline-start: 6px !important;
                                                                                border-radius: 50% !important;
                                                                                background: rgba(24, 160, 136, .16) !important;
                                                                                color: #1d273b !important;
                                                                                opacity: 1 !important;
                                                                                visibility: visible !important;
                                                                                line-height: 1 !important;
                                                                                vertical-align: middle !important;
                                                                                box-shadow: 0 1px 4px rgba(0,0,0,.10) !important;
                                                                                transition: background .15s ease, transform .15s ease !important;
                                                                            }

                                                                            .order-details-partial .copy-visible-icon svg {
                                                                                width: 16px !important;
                                                                                height: 16px !important;
                                                                                display: block !important;
                                                                                fill: currentColor !important;
                                                                            }

                                                                            .order-details-partial .copyable:hover .copy-visible-icon,
                                                                            .order-details-partial .copyable:active .copy-visible-icon {
                                                                                background: rgba(24, 160, 136, .24) !important;
                                                                                transform: scale(1.05) !important;
                                                                            }

                                                                            /* مهم: داخل كروت الـ split view الـ iframe بيتعمله scale،
                                                                               فـ media query مش دايمًا بتشتغل. عشان كده الأيقونة ظاهرة دايمًا. */
                                                                            .order-details-partial .row .copyable,
                                                                            .order-details-partial .d-flex .copyable {
                                                                                flex-wrap: nowrap !important;
                                                                            }

                                                                            .order-details-partial .warehouse-tag.copyable {
                                                                                display: inline-flex !important;
                                                                            }

                                                                            @@media (max-width: 992px) {
                                                                                .order-details-partial .copy-visible-icon {
                                                                                    width: 34px !important;
                                                                                    height: 34px !important;
                                                                                    min-width: 34px !important;
                                                                                    flex-basis: 34px !important;
                                                                                }

                                                                                .order-details-partial .copy-visible-icon svg {
                                                                                    width: 18px !important;
                                                                                    height: 18px !important;
                                                                                }
                                                                            }
                                                                        `;
                    document.head.appendChild(style);
                }

                function ensureCopyNoIconOverrideStyles() {
                    if (document.getElementById('orderCopyNoIconOverrideStyles')) return;

                    var style = document.createElement('style');
                    style.id = 'orderCopyNoIconOverrideStyles';
                    style.textContent = `
                                                                            .order-details-partial .copy-visible-icon {
                                                                                display: none !important;
                                                                            }

                                                                            .order-details-partial .copyable {
                                                                                cursor: pointer !important;
                                                                            }

                                                                            .order-details-partial .copyable-no-icon {
                                                                                padding-inline-end: 0 !important;
                                                                            }
                                                                        `;
                    document.head.appendChild(style);
                }

                ensureCopyNoIconOverrideStyles();

                function decorateCopyOptions() {
                    ensureCopyOptionsStyles();

                    // No visible copy icon is added anymore.
                    // The value/text itself remains clickable and copies normally.
                    $c.find('.copy-visible-icon').remove();
