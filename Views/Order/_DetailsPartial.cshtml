                    var $target = $(this);
                    var text = $target.data('copy-text');
                    var label = $target.data('copy-label') || '';

                    if (text !== undefined && text !== null && String(text).length > 0) {
                        orderDetailsCopyToClipboard(text, label);
                    }
                });


