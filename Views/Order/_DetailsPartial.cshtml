        function findDropdownMenu(button) {
            if (!button || !button.parentElement) return null;
            return button.parentElement.querySelector('.dropdown-menu, .dropdown-menu-employees, .dropdown-menu-ispaid');
        }

        document.addEventListener('show.bs.dropdown', function (event) {
            var button = event.target;
            if (!button || !button.closest || !button.closest('.order-details-partial')) return;

            var menu = findDropdownMenu(button);
            if (!menu) return;

            menu.style.zIndex = '2147483647';
            menu.style.visibility = 'visible';
            menu.style.opacity = '1';

            var isDynamicList =
                button.id === 'dropdownMenuButtonDelivery' ||
                button.id === 'dropdownMenuButtonemployee';

            if (isDynamicList && !menu.children.length) {
                menu.innerHTML = '<li><span class="dropdown-item text-muted">جاري التحميل...</span></li>';
            }
        }, true);
    })();
</script>

