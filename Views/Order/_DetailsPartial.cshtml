<script id="luxira-details-action-tracking-script">
    (function () {
        const canSeeDetailsHistory = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(User.IsInRole("Admin") || User.IsInRole("ExecutiveDirector")));
        const saveUrl = '/OrderMetaActions/Save';
        const reasonStatsUrl = '/OrderMetaActions/ReasonStats';
        const allLogsUrl = '/OrderMetaActions/AllLogs';
        const summaryUrl = '/OrderMetaActions/Summary';
        const detailsOrderId = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Id));

        let pendingAnchor = null;
        let pendingHref = '';
        let pendingOrderId = '';
        let pendingContactType = 'Meta';
        let statsLoaded = false;
        let statsLoading = false;
        let statsContactType = '';

        const modal = document.getElementById('luxiraDetailsActionModal');
        const modalTitle = document.getElementById('luxiraDetailsActionModalTitle');
        const confirmBtn = document.getElementById('luxiraDetailsActionConfirmBtn');
        const cancelBtn = document.getElementById('luxiraDetailsActionCancelBtn');
        const otherInput = document.getElementById('luxiraDetailsOtherText');
        const errorBox = document.getElementById('luxiraDetailsActionError');
        const historyBtn = document.getElementById('luxiraDetailsActionGlobalHistoryBtn');
        const historyModal = document.getElementById('luxiraDetailsActionGlobalHistoryModal');
        const historyClose = document.getElementById('luxiraDetailsActionGlobalHistoryClose');
        const historyBody = document.getElementById('luxiraDetailsActionGlobalHistoryBody');
        const reasonDetailsPanel = document.getElementById('luxiraDetailsReasonDetailsPanel');
        const reasonDetailsBackBtn = document.getElementById('luxiraDetailsReasonDetailsBackBtn');
        const reasonDetailsTitle = document.getElementById('luxiraDetailsReasonDetailsTitle');
        const reasonDetailsBody = document.getElementById('luxiraDetailsReasonDetailsBody');
        const detailsActionCard = modal ? modal.querySelector('.luxira-details-action-modal-card') : null;

        function escapeHtml(value) {
            return String(value || '')
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#039;');
        }

        function getToken() {
            const tokenInput = document.querySelector('#luxiraDetailsActionAntiForgeryForm input[name="__RequestVerificationToken"], input[name="__RequestVerificationToken"]');
            return tokenInput ? tokenInput.value : '';
        }

        function getDisplayReason(log) {
            const rawReason = (log && log.reason) || '';
            const reason = (rawReason === 'متابعة توصيل' || rawReason === 'موافقة') ? 'متابعة التوصيل' : rawReason;
            return reason === 'أخرى' && log && log.otherText ? 'أخرى - ' + log.otherText : reason;
        }

        function getDisplayContactType(log) {
            const value = String((log && (log.contactType || log.linkType || log.buttonType)) || '').toLowerCase();
            const url = String((log && (log.metaUrl || log.url)) || '').toLowerCase();
            return (value.indexOf('whatsapp') >= 0 || value.indexOf('واتساب') >= 0 || url.indexOf('whatsapp') >= 0 || url.indexOf('wa.me') >= 0)
                ? 'واتساب'
                : 'ميتا';
        }

        function getContactTypeFromAnchor(anchor) {
            if (!anchor) return 'Meta';
            const explicitType = String(anchor.getAttribute('data-contact-type') || '').toLowerCase();
            if (explicitType.indexOf('whatsapp') >= 0 || explicitType.indexOf('واتساب') >= 0) return 'WhatsApp';
            if (explicitType.indexOf('meta') >= 0 || explicitType.indexOf('ميتا') >= 0) return 'Meta';

            return anchor.classList && (anchor.classList.contains('receipt-whatsapp-image-button') || anchor.classList.contains('luxira-details-fixed-whatsapp-action'))
                ? 'WhatsApp'
                : 'Meta';
        }

        function getDetailsContactAnchors() {
            return Array.from(document.querySelectorAll('.order-details-partial a.receipt-meta-image-button, .order-details-partial a.receipt-whatsapp-image-button, .order-details-partial a.luxira-details-fixed-whatsapp-action'));
        }

        function ensureDetailsBadgeWrap(anchor) {
            if (!canSeeDetailsHistory || !anchor || typeof window.luxiraOpenContactActionModal === 'function') return null;

            let wrap = anchor.closest('.luxira-details-action-wrap');

            if (!wrap) {
                wrap = document.createElement('span');
                wrap.className = 'luxira-details-action-wrap';
                anchor.parentNode.insertBefore(wrap, anchor);
                wrap.appendChild(anchor);
            }

            const contactType = getContactTypeFromAnchor(anchor);
            wrap.classList.remove('is-meta-action', 'is-whatsapp-action', 'is-fixed-whatsapp-action');
            wrap.classList.add(contactType === 'WhatsApp' ? 'is-whatsapp-action' : 'is-meta-action');
            if (anchor.classList && anchor.classList.contains('luxira-details-fixed-whatsapp-action')) {
                wrap.classList.add('is-fixed-whatsapp-action');
            }

            if (!wrap.querySelector('.luxira-details-action-badge')) {
                const badge = document.createElement('span');
                badge.className = 'luxira-details-action-badge';
                badge.textContent = '0';
                wrap.appendChild(badge);
            }

            return wrap;
        }

        function updateDetailsBadge(anchor, item) {
            if (!canSeeDetailsHistory || !anchor || !item || typeof window.luxiraOpenContactActionModal === 'function') return;

            const wrap = ensureDetailsBadgeWrap(anchor);
            if (!wrap) return;

            const contactType = getContactTypeFromAnchor(anchor);
            const count = contactType === 'WhatsApp'
                ? Number(item.whatsappCount || 0)
                : Number(item.metaCount || 0);

            const badge = wrap.querySelector('.luxira-details-action-badge');
            if (badge) {
                badge.textContent = String(count);
                badge.style.display = count > 0 ? 'inline-flex' : 'none';
            }
        }

        function loadDetailsSummaries() {
            if (!canSeeDetailsHistory || typeof window.luxiraOpenContactActionModal === 'function') return;

            const anchors = getDetailsContactAnchors();
            if (!anchors.length || !detailsOrderId) return;

            anchors.forEach(ensureDetailsBadgeWrap);

            fetch(summaryUrl + '?orderIds=' + encodeURIComponent(String(detailsOrderId)), {
                method: 'GET',
                headers: { 'Accept': 'application/json' },
                cache: 'no-store'
            })
                .then(function (response) { return response.json(); })
                .then(function (result) {
                    if (!result || !result.success || !result.items || !result.items.length) return;
                    anchors.forEach(function (anchor) { updateDetailsBadge(anchor, result.items[0]); });
                })
                .catch(function () { });
        }

        function showError(message) {
            if (!errorBox) return;
            errorBox.innerText = message || '';
            errorBox.style.display = message ? 'block' : 'none';
        }

        function resetModal() {
            closeReasonDetailsPanel();
            showError('');
            document.querySelectorAll('input[name="luxiraDetailsReason"]').forEach(function (radio) {
                radio.checked = radio.value === 'معالجة طلب';
            });
            if (otherInput) {
                otherInput.value = '';
                otherInput.disabled = true;
            }
            if (confirmBtn) {
                confirmBtn.disabled = false;
                confirmBtn.innerText = 'موافقة';
            }
        }

        function getSelectedReason() {
            const selected = document.querySelector('input[name="luxiraDetailsReason"]:checked');
            return selected ? selected.value : '';
        }

        function openRecordedUrl(url) {
            if (!url) return;

            try {
                const opened = window.open(url, '_blank');
                try { if (opened) opened.opener = null; } catch { }

                setTimeout(function () {
                    try { if (opened && !opened.closed) opened.blur(); } catch { }
                    try { window.focus(); } catch { }
                }, 30);

                setTimeout(function () {
                    try { if (opened && !opened.closed) opened.blur(); } catch { }
                    try { window.focus(); } catch { }
                }, 250);

                setTimeout(function () {
                    try { window.focus(); } catch { }
                }, 700);

                if (!opened) {
                    const link = document.createElement('a');
                    link.href = url;
                    link.target = '_blank';
                    link.rel = 'noopener noreferrer';
                    link.style.display = 'none';
                    document.body.appendChild(link);
                    link.click();
                    document.body.removeChild(link);
                    setTimeout(function () { try { window.focus(); } catch { } }, 80);
                }
            } catch {
                try {
                    const link = document.createElement('a');
                    link.href = url;
                    link.target = '_blank';
                    link.rel = 'noopener noreferrer';
                    link.style.display = 'none';
                    document.body.appendChild(link);
                    link.click();
                    document.body.removeChild(link);
                    setTimeout(function () { try { window.focus(); } catch { } }, 80);
                } catch {
                    window.location.href = url;
                }
            }
        }

        function renderReasonStats(items) {
            if (!canSeeDetailsHistory) return;
            document.querySelectorAll('.luxira-details-reason-stats-trigger').forEach(function (trigger) {
                const reason = trigger.getAttribute('data-reason') || '';
                const item = (items || []).find(function (x) { return x.reason === reason; }) || { count: 0, logs: [] };
                const countNode = trigger.querySelector('.luxira-details-reason-count');
                const cloud = trigger.querySelector('.luxira-details-reason-hover-cloud');
                trigger.__luxiraReasonStatsItem = item;
                trigger.classList.add('is-visible');
                if (countNode) countNode.textContent = String(Number(item.count || 0));
                if (!cloud) return;
                let html = '<span class="luxira-details-reason-hover-title">' + escapeHtml(reason) + '</span>';
                if (!item.logs || !item.logs.length) {
                    html += '<span class="luxira-details-reason-hover-empty">لا توجد بيانات</span>';
                } else {
                    item.logs.forEach(function (log) {
                        html += '<span class="luxira-details-reason-log-row">' +
                            '<span class="luxira-details-reason-log-employee">' + escapeHtml(log.employeeName || 'موظف') + '</span>' +
                            '<span class="luxira-details-reason-log-contact">' + escapeHtml(getDisplayContactType(log)) + '</span>' +
                            '<span class="luxira-details-reason-log-reason">طلب رقم ' + escapeHtml(log.orderId || '') + '</span>' +
                            '<span class="luxira-details-reason-log-time">' + escapeHtml(log.clickedAt || '') + '</span>' +
                            '</span>';
                    });
                }
                cloud.innerHTML = html;
            });
        }

        function buildReasonDetailsHtml(reason, item) {
            let html = '';
            const logs = item && item.logs ? item.logs : [];

            if (!logs.length) {
                return '<div class="luxira-details-global-history-empty">لا توجد بيانات</div>';
            }

            logs.forEach(function (log) {
                html += '<div class="luxira-details-reason-log-row">' +
                    '<span class="luxira-details-reason-log-employee">' + escapeHtml(log.employeeName || 'موظف') + '</span>' +
                    '<span class="luxira-details-reason-log-contact">' + escapeHtml(getDisplayContactType(log)) + '</span>' +
                    '<span class="luxira-details-reason-log-reason">طلب رقم ' + escapeHtml(log.orderId || '') + '</span>' +
                    '<span class="luxira-details-reason-log-time">' + escapeHtml(log.clickedAt || '') + '</span>' +
                    '</div>';
            });

            return html;
        }

        function openReasonDetailsPanelFromTrigger(trigger) {
            if (!canSeeDetailsHistory || !trigger || !reasonDetailsPanel) return;

            const reason = trigger.getAttribute('data-reason') || 'تفاصيل السبب';
            const item = trigger.__luxiraReasonStatsItem || { count: 0, logs: [] };

            if (reasonDetailsTitle) {
                reasonDetailsTitle.textContent = reason;
            }

            if (reasonDetailsBody) {
                reasonDetailsBody.innerHTML = buildReasonDetailsHtml(reason, item);
            }

            if (detailsActionCard) {
                detailsActionCard.classList.add('is-showing-reason-details');
            }
        }

        function closeReasonDetailsPanel() {
            if (detailsActionCard) {
                detailsActionCard.classList.remove('is-showing-reason-details');
            }
        }

        function loadReasonStats(force) {
            if (!canSeeDetailsHistory || statsLoading) return;

            const activeContactType = pendingContactType || 'Meta';

            if (statsContactType !== activeContactType) {
                statsLoaded = false;
                statsContactType = activeContactType;
            }

            if (statsLoaded && !force) return;
            statsLoading = true;
            fetch(reasonStatsUrl + '?contactType=' + encodeURIComponent(activeContactType), { method: 'GET', headers: { 'Accept': 'application/json' }, cache: 'no-store' })
                .then(function (response) { return response.json(); })
                .then(function (result) {
                    if (result && result.success && result.items) {
                        renderReasonStats(result.items);
                        statsLoaded = true;
                    }
                })
                .catch(function () { })
                .finally(function () { statsLoading = false; });
        }

        function renderGlobalHistory(items) {
            if (!historyBody) return;
            if (!items || !items.length) {
                historyBody.innerHTML = '<div class="luxira-details-global-history-empty">لا توجد أي إجراءات مسجلة</div>';
                return;
            }
            let html = '';
            items.forEach(function (log) {
                html += '<div class="luxira-details-global-history-row">' +
                    '<div><span class="luxira-details-global-history-order">طلب رقم ' + escapeHtml(log.orderId || '') + '</span></div>' +
                    '<div class="luxira-details-global-history-employee">الموظف: ' + escapeHtml(log.employeeName || 'موظف') + '</div>' +
                    '<div class="luxira-details-global-history-contact">الزر: ' + escapeHtml(getDisplayContactType(log)) + '</div>' +
                    '<div class="luxira-details-global-history-reason">السبب: ' + escapeHtml(getDisplayReason(log)) + '</div>' +
                    '<div class="luxira-details-global-history-time">الوقت: ' + escapeHtml(log.clickedAt || '') + '</div>' +
                    '</div>';
            });
            historyBody.innerHTML = html;
        }

        function openHistoryModal() {
            if (!canSeeDetailsHistory || !historyModal) return;
            if (historyBody) historyBody.innerHTML = '<div class="luxira-details-global-history-empty">جاري تحميل السجل...</div>';
            historyModal.style.display = 'flex';
            fetch(allLogsUrl + '?contactType=' + encodeURIComponent(pendingContactType || 'Meta'), { method: 'GET', headers: { 'Accept': 'application/json' }, cache: 'no-store' })
                .then(function (response) { return response.json(); })
                .then(function (result) {
                    if (!result || !result.success) throw new Error(result && result.message ? result.message : 'تعذر تحميل السجل.');
                    renderGlobalHistory(result.items || []);
                })
                .catch(function (error) {
                    if (historyBody) historyBody.innerHTML = '<div class="luxira-details-global-history-empty">' + escapeHtml(error && error.message ? error.message : 'تعذر تحميل السجل') + '</div>';
                });
        }

        function closeHistoryModal() {
            if (historyModal) historyModal.style.display = 'none';
        }

        function closeModal() {
            closeReasonDetailsPanel();
            if (modal) modal.style.display = 'none';
            pendingAnchor = null;
            pendingHref = '';
            pendingOrderId = '';
            pendingContactType = 'Meta';
        }

        function openModal(anchor) {
            if (!anchor) return;
            pendingAnchor = anchor;
            pendingHref = anchor.getAttribute('href') || '';
            pendingOrderId = anchor.getAttribute('data-order-id') || String(detailsOrderId || '');
            pendingContactType = getContactTypeFromAnchor(anchor);
            if (modalTitle) modalTitle.textContent = pendingContactType === 'WhatsApp' ? 'سبب فتح رابط WhatsApp' : 'سبب فتح رابط Meta';
            if (!pendingHref) {
                showError('الرابط غير موجود.');
                return;
            }
            if (!pendingOrderId) {
                showError('لم يتم التعرف على رقم الطلب.');
                return;
            }
            resetModal();
            loadReasonStats(statsContactType !== pendingContactType);
            if (modal) modal.style.display = 'flex';
        }

        function confirmAction() {
            if (!pendingHref || !pendingOrderId || !pendingAnchor) {
                showError('لم يتم التعرف على الرابط.');
                return;
            }
            const reason = getSelectedReason();
            const otherText = otherInput ? otherInput.value.trim() : '';
            if (!reason) {
                showError('اختاري سبب فتح الرابط.');
                return;
            }
            if (reason === 'أخرى' && !otherText) {
                showError('اكتبي السبب في خانة أخرى.');
                if (otherInput) otherInput.focus();
                return;
            }
            if (confirmBtn) {
                confirmBtn.disabled = true;
                confirmBtn.innerText = 'جاري التسجيل...';
            }
            let openedWindow = null;
            fetch(saveUrl, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': getToken(),
                    'Accept': 'application/json'
                },
                body: JSON.stringify({
                    orderId: Number(pendingOrderId),
                    reason: reason,
                    otherText: otherText,
                    url: pendingHref,
                    contactType: pendingContactType
                })
            })
                .then(function (response) { return response.json(); })
                .then(function (result) {
                    if (!result || !result.success) {
                        if (openedWindow && !openedWindow.closed) openedWindow.close();
                        throw new Error(result && result.message ? result.message : 'حصل خطأ أثناء تسجيل سبب فتح الرابط.');
                    }
                    statsLoaded = false;
                    loadReasonStats(true);
                    if (result.item) {
                        updateDetailsBadge(pendingAnchor, result.item);

                        if (typeof window.luxiraContactActionSummaryByOrderId === 'object' && result.item.orderId) {
                            window.luxiraContactActionSummaryByOrderId[String(result.item.orderId)] = result.item;
                        }

                        if (typeof window.luxiraApplyContactActionBadgesForOrder === 'function') {
                            try { window.luxiraApplyContactActionBadgesForOrder(result.item.orderId); } catch { }
                        }
                    } else {
                        loadDetailsSummaries();
                        requestParentSummaryRefresh();
                    }
                    const hrefToOpen = pendingHref;
                    closeModal();
                    openRecordedUrl(hrefToOpen);
                })
                .catch(function (error) {
                    showError(error && error.message ? error.message : 'حصل خطأ أثناء تسجيل سبب فتح الرابط.');
                    if (confirmBtn) {
                        confirmBtn.disabled = false;
                        confirmBtn.innerText = 'موافقة';
                    }
                });
        }

        document.addEventListener('click', function (event) {
            const anchor = event.target.closest('.order-details-partial a.receipt-meta-image-button, .order-details-partial a.receipt-whatsapp-image-button, .order-details-partial a.luxira-details-fixed-whatsapp-action');
            if (!anchor) return;

            event.preventDefault();
            event.stopPropagation();
            if (typeof event.stopImmediatePropagation === 'function') event.stopImmediatePropagation();

            if (typeof window.luxiraOpenContactActionModal === 'function') {
                window.luxiraOpenContactActionModal(anchor);
                return;
            }

            openModal(anchor);
        }, true);

        document.addEventListener('change', function (event) {
            const radio = event.target.closest('input[name="luxiraDetailsReason"]');
            if (!radio) return;
            const isOther = radio.value === 'أخرى';
            if (otherInput) {
                otherInput.disabled = !isOther;
                if (isOther) otherInput.focus();
                else otherInput.value = '';
            }
            showError('');
        }, true);

        if (confirmBtn) confirmBtn.addEventListener('click', function (event) { event.preventDefault(); confirmAction(); });
        if (cancelBtn) cancelBtn.addEventListener('click', function (event) { event.preventDefault(); closeModal(); });
        if (historyBtn) historyBtn.addEventListener('click', function (event) { event.preventDefault(); event.stopPropagation(); openHistoryModal(); });
        if (historyClose) historyClose.addEventListener('click', function (event) { event.preventDefault(); closeHistoryModal(); });
        if (reasonDetailsBackBtn) reasonDetailsBackBtn.addEventListener('click', function (event) { event.preventDefault(); event.stopPropagation(); closeReasonDetailsPanel(); });

        document.addEventListener('click', function (event) {
            const trigger = event.target.closest('.luxira-details-reason-stats-trigger');
            if (!trigger || !modal || !modal.contains(trigger) || !canSeeDetailsHistory) return;

            event.preventDefault();
            event.stopPropagation();
            if (typeof event.stopImmediatePropagation === 'function') event.stopImmediatePropagation();

            openReasonDetailsPanelFromTrigger(trigger);
        }, true);

        if (modal) modal.addEventListener('click', function (event) { if (event.target === modal) closeModal(); });
        if (historyModal) historyModal.addEventListener('click', function (event) { if (event.target === historyModal) closeHistoryModal(); });

        document.addEventListener('keydown', function (event) {
            if (event.key !== 'Escape') return;
            if (historyModal && historyModal.style.display === 'flex') {
                event.preventDefault();
                closeHistoryModal();
                return;
            }
            if (modal && modal.style.display === 'flex') {
                event.preventDefault();
                closeModal();
            }
        }, true);

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', function () { loadReasonStats(false); });
        } else {
            loadReasonStats(false);
        }
        function requestParentSummaryRefresh() {
            // In the Index page, counters are already loaded for the table row.
            // Apply them immediately to the AJAX-loaded details buttons before doing any delayed refresh.
            if (typeof window.luxiraApplyContactActionBadgesForOrder === 'function') {
                try { window.luxiraApplyContactActionBadgesForOrder(detailsOrderId); } catch { }
            }

            if (typeof window.luxiraRefreshContactActionSummaries !== 'function') return;

            setTimeout(function () {
                try {
                    if (typeof window.luxiraApplyContactActionBadgesForOrder === 'function') {
                        window.luxiraApplyContactActionBadgesForOrder(detailsOrderId);
                    } else {
                        window.luxiraRefreshContactActionSummaries();
                    }
                } catch { }
            }, 30);

            setTimeout(function () {
                try {
                    if (typeof window.luxiraApplyContactActionBadgesForOrder === 'function') {
                        window.luxiraApplyContactActionBadgesForOrder(detailsOrderId);
                    } else {
                        window.luxiraRefreshContactActionSummaries();
                    }
                } catch { }
            }, 250);
        }

        // Apply the Index counters immediately. This is what makes the details badge match the table badge as soon as the details partial appears.
        requestParentSummaryRefresh();

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', function () {
                loadDetailsSummaries();
                requestParentSummaryRefresh();
            });
        } else {
            loadDetailsSummaries();
            requestParentSummaryRefresh();
        }

    })();
</script>


<style id="luxira-details-whatsapp-badge-overlay-final-fix">
    /* Final fix: keep the Details WhatsApp counter attached to the WhatsApp image itself */
    .fixed-bottom,
    .fixed-bottom > div,
    .order-details-partial ~ .fixed-bottom,
    .order-details-partial ~ .fixed-bottom > div {
        overflow: visible !important;
    }

        .fixed-bottom .luxira-details-action-wrap.is-fixed-whatsapp-action,
        .order-details-partial ~ .fixed-bottom .luxira-details-action-wrap.is-fixed-whatsapp-action {
            position: relative !important;
            display: inline-flex !important;
            align-items: center !important;
            justify-content: center !important;
            width: 98px !important;
            min-width: 98px !important;
            max-width: 98px !important;
            height: auto !important;
            min-height: 0 !important;
            padding: 0 !important;
            margin: 0 !important;
            line-height: 0 !important;
            overflow: visible !important;
            vertical-align: top !important;
            isolation: isolate !important;
        }

            .fixed-bottom .luxira-details-action-wrap.is-fixed-whatsapp-action > .luxira-details-fixed-whatsapp-action,
            .order-details-partial ~ .fixed-bottom .luxira-details-action-wrap.is-fixed-whatsapp-action > .luxira-details-fixed-whatsapp-action {
                position: relative !important;
                display: inline-flex !important;
                align-items: center !important;
                justify-content: center !important;
                width: 98px !important;
                min-width: 98px !important;
                max-width: 98px !important;
                height: auto !important;
                padding: 0 !important;
                margin: 0 !important;
                line-height: 0 !important;
                overflow: visible !important;
                text-decoration: none !important;
            }

                .fixed-bottom .luxira-details-action-wrap.is-fixed-whatsapp-action > .luxira-details-fixed-whatsapp-action img,
                .order-details-partial ~ .fixed-bottom .luxira-details-action-wrap.is-fixed-whatsapp-action > .luxira-details-fixed-whatsapp-action img {
                    display: block !important;
                    width: 98px !important;
                    max-width: 98px !important;
                    height: auto !important;
                    margin: 0 !important;
                }

            .fixed-bottom .luxira-details-action-wrap.is-fixed-whatsapp-action > .luxira-details-action-badge,
            .order-details-partial ~ .fixed-bottom .luxira-details-action-wrap.is-fixed-whatsapp-action > .luxira-details-action-badge,
            .fixed-bottom .luxira-details-action-wrap:has(.luxira-details-fixed-whatsapp-action) > .luxira-details-action-badge,
            .order-details-partial ~ .fixed-bottom .luxira-details-action-wrap:has(.luxira-details-fixed-whatsapp-action) > .luxira-details-action-badge {
                position: absolute !important;
                top: -2px !important;
                left: -8px !important;
                right: auto !important;
                bottom: auto !important;
                transform: none !important;
                z-index: 2147483647 !important;
                width: 20px !important;
                height: 20px !important;
                min-width: 20px !important;
                min-height: 20px !important;
                padding: 0 !important;
                border-radius: 999px !important;
                background: #ef4444 !important;
                border: 2px solid #ffffff !important;
                color: #ffffff !important;
                font-size: 10px !important;
                font-weight: 900 !important;
                line-height: 1 !important;
                align-items: center !important;
                justify-content: center !important;
                box-shadow: 0 2px 6px rgba(15, 23, 42, .30) !important;
                pointer-events: none !important;
            }
</style>
<!-- ضيفي البلوك ده في آخر صفحة تفاصيل الطلب فقط -->
<style id="order-details-hide-single-delivery-company-style">
    .order-details-single-delivery-hidden {
        display: none !important;
    }
</style>

<script id="order-details-hide-single-delivery-company-script">
    (function () {
        function normalizeDeliveryCompanies(data) {
            if (Array.isArray(data)) return data;
            if (data && Array.isArray(data.deliveryCompanies)) return data.deliveryCompanies;
            if (data && Array.isArray(data.companies)) return data.companies;
            if (data && Array.isArray(data.items)) return data.items;
            return [];
        }

        function getDeliveryAssignDropdowns(root) {
            var $root = window.jQuery ? $(root || document) : null;
            if (!$root) return $();

            return $root.find('#dropdownMenuButtonDelivery')
                .filter(function () {
                    return ($(this).text() || '').indexOf('تعيين شركة التوصيل') !== -1;
                })
                .closest('.dropdown');
        }

        function setDeliveryAssignVisible(root, visible) {
            var $dropdowns = getDeliveryAssignDropdowns(root);
            if (!$dropdowns.length) return;

            $dropdowns.toggleClass('order-details-single-delivery-hidden', !visible);
            $dropdowns.css('display', visible ? '' : 'none');
        }

        function hideDeliveryAssignIfSingleCompany(root) {
            if (!window.jQuery) return;

            var countryId = '@Model.CountryId';
            var cityId = '@Html.Raw(Model.State)';

            if (!countryId) return;

            $.ajax({
                url: '@Url.Action("GetAllDeliveryCompaniesAndRepresentatives", "Datalist")',
                method: 'GET',
                data: { countryId: countryId, cityId: cityId },
                cache: false,
                success: function (data) {
                    var companies = normalizeDeliveryCompanies(data);

                    if (companies.length === 1) {
                        setDeliveryAssignVisible(root, false);
                    } else {
                        setDeliveryAssignVisible(root, true);
                    }
                }
            });
        }

        var oldInitOrderDetails = window.initOrderDetails;

        window.initOrderDetails = function (container) {
            if (typeof oldInitOrderDetails === 'function') {
                oldInitOrderDetails.apply(this, arguments);
            }

            setTimeout(function () {
                hideDeliveryAssignIfSingleCompany(container || document);
            }, 150);
        };

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', function () {
                setTimeout(function () { hideDeliveryAssignIfSingleCompany(document); }, 150);
            });
        } else {
            setTimeout(function () { hideDeliveryAssignIfSingleCompany(document); }, 150);
        }
    })();
</script>
