            // ---- destroyOrderDetails ----
            // Called by the modal lifecycle (Index.cshtml) before clearing the modal body.
            // Unbinds all namespaced handlers, destroys Select2, removes any appended frames.
            window.destroyOrderDetails = function (container) {
                if (!$c || !$c.length) return;

                // Unbind all handlers registered with the .orderDetails namespace
                $c.find('*').off('.orderDetails');

                // Destroy Select2 instances if present
                $c.find('#statusChangeReason').each(function () {
