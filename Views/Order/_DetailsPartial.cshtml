<script id="order-details-copy-v3-script">
    (function () {
        function showOriginalCopyToast(fieldName) {
            var oldToast = document.getElementById('orderDetailsCopyToast');
            if (oldToast) oldToast.remove();

            var toast = document.createElement('div');
            toast.id = 'orderDetailsCopyToast';
            toast.className = 'order-details-copy-toast';
            toast.innerHTML = '<span class="copy-toast-check">✓</span>تم نسخ ' + (fieldName || '');

            document.body.appendChild(toast);

            setTimeout(function () {
                toast.classList.add('show');
            }, 10);

            setTimeout(function () {
                toast.classList.remove('show');
                setTimeout(function () {
                    if (toast && toast.parentNode) {
                        toast.parentNode.removeChild(toast);
                    }
                }, 220);
            }, 1800);
        }

        function fallbackCopy(text, callback) {
            var ta = document.createElement('textarea');
            ta.value = text;
            ta.setAttribute('readonly', 'readonly');
            ta.style.position = 'fixed';
            ta.style.top = '-1000px';
            ta.style.opacity = '0';
            document.body.appendChild(ta);
            ta.focus();
            ta.select();

            try {
                document.execCommand('copy');
            } catch (err) { }

            document.body.removeChild(ta);

            if (typeof callback === 'function') callback();
        }

        function showCopyMessage(label) {
            var shownInParent = false;

            try {
                if (window.parent && window.parent !== window && typeof window.parent.showSplitCardCopyToastFromFrameWindow === 'function') {
                    shownInParent = window.parent.showSplitCardCopyToastFromFrameWindow(window, label || '');
                }
            } catch (e) { }

            if (!shownInParent) {
                showOriginalCopyToast(label || '');
            }
        }

        function copyText(text, label) {
            if (text === undefined || text === null) return;

            text = String(text);
            if (!text || text === 'null') return;

            var done = function () {
                showCopyMessage(label || '');
            };

            if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(text).then(done).catch(function () {
                    fallbackCopy(text, done);
                });
            } else {
                fallbackCopy(text, done);
            }
        }

        document.addEventListener('click', function (event) {
            var el = event.target && event.target.closest
                ? event.target.closest('.copyable')
                : null;

            if (!el) return;

            var text = el.getAttribute('data-copy-text');
            var label = el.getAttribute('data-copy-label') || '';

            if (text === null || text === undefined || String(text).length === 0) return;

            event.preventDefault();
            event.stopPropagation();

            if (typeof event.stopImmediatePropagation === 'function') {
                event.stopImmediatePropagation();
            }

            copyText(text, label);
        }, true);
    })();
</script>

