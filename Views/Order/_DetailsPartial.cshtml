    <!-- ===== FINAL: only one dropdown open + close dropdowns on outside click ===== -->
    <script id="details-single-dropdown-open-final-script">
        (function () {
            function getToggleForDropdown(dropdown) {
                if (!dropdown) return null;
                return dropdown.querySelector('[data-bs-toggle="dropdown"], .dropdown-toggle');
            }

            function forceCloseDropdown(dropdown) {
                if (!dropdown) return;

                var toggle = getToggleForDropdown(dropdown);
                var menu = dropdown.querySelector('.dropdown-menu, .dropdown-menu-employees, .dropdown-menu-ispaid');

                try {
                    if (window.bootstrap && bootstrap.Dropdown && toggle) {
                        var instance = bootstrap.Dropdown.getInstance(toggle) || bootstrap.Dropdown.getOrCreateInstance(toggle);
                        instance.hide();
                    }
                } catch (e) { }

                dropdown.classList.remove('show', 'split-dropdown-open-top');

                if (toggle) {
                    toggle.classList.remove('show');
                    toggle.setAttribute('aria-expanded', 'false');
                }

                if (menu) {
                    menu.classList.remove('show');
                    menu.style.display = '';
                    menu.style.visibility = '';
                    menu.style.opacity = '';
                }
            }

            function closeAllDropdownsExcept(exceptDropdown) {
                document.querySelectorAll('.order-details-partial .dropdown').forEach(function (dropdown) {
                    if (exceptDropdown && dropdown === exceptDropdown) return;
                    var menu = dropdown.querySelector('.dropdown-menu, .dropdown-menu-employees, .dropdown-menu-ispaid');
                    var toggle = getToggleForDropdown(dropdown);
                    if ((menu && menu.classList.contains('show')) || dropdown.classList.contains('show') || (toggle && toggle.classList.contains('show'))) {
                        forceCloseDropdown(dropdown);
                    }
                });
            }

            document.addEventListener('show.bs.dropdown', function (event) {
                var dropdown = event.target && event.target.closest ? event.target.closest('.dropdown') : null;
                closeAllDropdownsExcept(dropdown);
            }, true);

            document.addEventListener('shown.bs.dropdown', function (event) {
                var dropdown = event.target && event.target.closest ? event.target.closest('.dropdown') : null;
                closeAllDropdownsExcept(dropdown);
            }, true);

            document.addEventListener('click', function (event) {
                var clickedDropdown = event.target && event.target.closest ? event.target.closest('.dropdown') : null;
                var clickedMenuItem = event.target && event.target.closest ? event.target.closest('.dropdown-item') : null;

                if (!clickedDropdown) {
                    closeAllDropdownsExcept(null);
                    return;
                }

                /*
                   If the user chooses an item from a dropdown, close it immediately
                   so it does not stay over the buttons after the action starts.
                */
                if (clickedMenuItem) {
                    setTimeout(function () {
                        closeAllDropdownsExcept(null);
                    }, 60);
                }
            }, true);

            document.addEventListener('keydown', function (event) {
                if (event.key === 'Escape') {
                    closeAllDropdownsExcept(null);
                }
            }, true);

            /*
               When the parent Home page dispatches this event on iframe blur/outside click,
               close any dropdown still open inside this card.
            */
            window.addEventListener('message', function (event) {
                if (event && event.data && event.data.type === 'close-order-card-dropdowns') {
                    closeAllDropdownsExcept(null);
                }
            });
        })();
    </script>
}

