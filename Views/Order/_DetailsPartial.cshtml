    <script id="split-card-custom-confirm-no-overlay-script">
        (function () {
            function setImportant(el, prop, value) {
                if (el && el.style) el.style.setProperty(prop, value, 'important');
            }

            function getFrameWrap() {
                try {
                    var frame = window.frameElement;
                    return frame ? (frame.closest('.modal-multi-order-frame-wrap') || frame.parentElement) : null;
                } catch (e) {
                    return null;
                }
            }

            function getScale() {
                try {
                    var frame = window.frameElement;
                    if (!frame || !frame.getBoundingClientRect) return 1;
                    var rect = frame.getBoundingClientRect();
                    var cssWidth = frame.offsetWidth || parseFloat(frame.style.width) || rect.width || 1;
                    var scale = rect.width / cssWidth;
                    return (!isFinite(scale) || scale <= 0) ? 1 : scale;
                } catch (e) {
                    return 1;
                }
            }

            function getVisibleCenterTop() {
                var wrap = getFrameWrap();
                var scale = getScale();
                var top = 0;
                var height = window.innerHeight || document.documentElement.clientHeight || 520;

                if (wrap) {
                    top = (wrap.scrollTop || 0) / scale;
                    height = (wrap.clientHeight || height) / scale;
                }

                if (!isFinite(top) || top < 0) top = 0;
                if (!isFinite(height) || height < 160) height = 520;

                return top + (height / 2);
            }

            function removeOldAlerts() {
                document.querySelectorAll('.sweet-overlay, .swal2-container, .sweet-alert').forEach(function (el) {
                    el.remove();
                });
            }

            function positionInlineConfirm() {
                var popup = document.getElementById('splitCardInlineConfirm');
                if (!popup) return;
                document.documentElement.style.setProperty('--split-card-confirm-top', getVisibleCenterTop() + 'px');
            }

            function closeInlineConfirm() {
                var popup = document.getElementById('splitCardInlineConfirm');
                if (popup) popup.remove();
            }

            function htmlEncode(value) {
                return String(value == null ? '' : value)
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;')
                    .replace(/"/g, '&quot;')
                    .replace(/'/g, '&#39;');
            }

            window.showNotification = function (message, onConfirm, iconUrl) {
                removeOldAlerts();
                closeInlineConfirm();

                var popup = document.createElement('div');
                popup.id = 'splitCardInlineConfirm';
                popup.innerHTML =
                    '<div class="split-card-confirm-body">' +
                    '<div class="split-card-confirm-icon">!</div>' +
                    '<div class="split-card-confirm-message">' + htmlEncode(message) + '</div>' +
                    '</div>' +
                    '<div class="split-card-confirm-actions">' +
                    '<button type="button" class="split-card-confirm-ok">موافقة</button>' +
                    '<button type="button" class="split-card-confirm-cancel">تراجع</button>' +
                    '</div>';

                document.body.appendChild(popup);
                positionInlineConfirm();

                popup.querySelector('.split-card-confirm-ok').addEventListener('click', function (e) {
                    e.preventDefault();
                    e.stopPropagation();
                    closeInlineConfirm();
                    if (typeof onConfirm === 'function') onConfirm();
                });

                popup.querySelector('.split-card-confirm-cancel').addEventListener('click', function (e) {
                    e.preventDefault();
                    e.stopPropagation();
                    closeInlineConfirm();
                });

                setTimeout(positionInlineConfirm, 0);
                setTimeout(positionInlineConfirm, 80);
                setTimeout(positionInlineConfirm, 200);
            };

            function positionEmployeeDropdown() {
                var menu = document.querySelector('.dropdown-menu-employees.show');
                var button = document.getElementById('dropdownMenuButtonemployee');
                if (!menu || !button) return;

                var btnRect = button.getBoundingClientRect();
                var viewportWidth = window.innerWidth || document.documentElement.clientWidth || 900;
                var wantedWidth = Math.max(220, Math.min(340, menu.scrollWidth || 260));
                var left = Math.max(8, Math.min(btnRect.left - 115, viewportWidth - wantedWidth - 8));
                var top = btnRect.bottom + 4;

                setImportant(menu, 'position', 'fixed');
                setImportant(menu, 'top', top + 'px');
                setImportant(menu, 'left', left + 'px');
                setImportant(menu, 'right', 'auto');
                setImportant(menu, 'bottom', 'auto');
                setImportant(menu, 'transform', 'none');
                setImportant(menu, 'translate', 'none');
                setImportant(menu, 'width', wantedWidth + 'px');
                setImportant(menu, 'min-width', '220px');
                setImportant(menu, 'max-width', '340px');
                setImportant(menu, 'z-index', '2147483647');
                setImportant(menu, 'display', 'block');
                setImportant(menu, 'visibility', 'visible');
                setImportant(menu, 'opacity', '1');
            }

            document.addEventListener('show.bs.dropdown', function (event) {
                if (event.target && event.target.id === 'dropdownMenuButtonemployee') {
                    setTimeout(positionEmployeeDropdown, 0);
                    setTimeout(positionEmployeeDropdown, 80);
                }
            }, true);

            document.addEventListener('shown.bs.dropdown', function (event) {
                if (event.target && event.target.id === 'dropdownMenuButtonemployee') {
                    positionEmployeeDropdown();
                    setTimeout(positionEmployeeDropdown, 80);
                }
            }, true);

            document.addEventListener('click', function () {
                positionInlineConfirm();
                setTimeout(positionInlineConfirm, 80);
                setTimeout(positionEmployeeDropdown, 80);
            }, true);

            var wrap = getFrameWrap();
            if (wrap) wrap.addEventListener('scroll', positionInlineConfirm, { passive: true });

            window.addEventListener('resize', function () {
                positionInlineConfirm();
                positionEmployeeDropdown();
            });

            if (window.MutationObserver && document.body) {
                var observer = new MutationObserver(function () {
                    removeOldAlerts();
                    positionInlineConfirm();
                    positionEmployeeDropdown();
                });
                observer.observe(document.body, { childList: true, subtree: true });
            }

            removeOldAlerts();
        })();
    </script>
}

