                $('#printFrame').remove();

                // Tear down any child modals (moved to body level)
                $('body > [data-child-modal]').each(function () {
                    var $m = $(this).find('.modal');
                    if ($m.length) try { $m.modal('hide'); } catch (e) { }
                    $(this).remove();
                });
                $c.find('#orderDetails-modal-container').empty();

                globalOrderId = undefined;
                globalOrderStatus = undefined;
