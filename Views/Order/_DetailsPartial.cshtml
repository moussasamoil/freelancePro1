    </style>


    <style id="order-details-inner-scroll-fix">
            /* Scroll inside order details content only — not the header/action area */
            .order-details-partial {
                max-height: none !important;
                overflow: hidden !important;
                padding-bottom: 0 !important;
            }

                .order-details-partial > .container-fluid {
                    max-height: calc(100dvh - 58px);
                    overflow: hidden !important;
                    display: flex;
                    flex-direction: column;
                    min-height: 0;
                }

                    /* Header/action section: no scroll here */
                    .order-details-partial > .container-fluid > .row.mb-0 {
                        flex: 0 0 auto;
                        overflow: visible !important;
                    }

                    /* Page body/content section: scroll here only */
                    .order-details-partial > .container-fluid > .row.mt-2 {
                        flex: 1 1 auto;
                        min-height: 0;
                        overflow-y: auto !important;
                        overflow-x: hidden !important;
                        padding-bottom: 18px !important;
                        scrollbar-width: thin;
                        scrollbar-color: #1d273b #e5e7eb;
                    }

                        .order-details-partial > .container-fluid > .row.mt-2::-webkit-scrollbar {
                            width: 9px;
                        }

                        .order-details-partial > .container-fluid > .row.mt-2::-webkit-scrollbar-track {
                            background: #e5e7eb;
                            border-radius: 999px;
                        }

                        .order-details-partial > .container-fluid > .row.mt-2::-webkit-scrollbar-thumb {
                            background: #1d273b;
                            border-radius: 999px;
                        }

            @@supports not (height: 100dvh) {
                .order-details-partial > .container-fluid {
                    max-height: calc(100vh - 58px);
                }
            }

            @@media (max-width: 768px) {
                .order-details-partial > .container-fluid {
                    max-height: calc(100dvh - 48px);
                }
            }
    </style>


    <style id="order-details-header-font-normal-fix">
            /* Header links/titles should be normal weight, not bold */
            #orderDetailsSharedHeader,
            #orderDetailsSharedHeader a,
            #orderDetailsSharedHeader span,
            #orderDetailsSharedHeader div,
            #orderDetailsSharedHeader button,
            #orderDetailsSharedHeader .text-green,
            #orderDetailsSharedHeader .fw-bold,
            .modal-multi-order-action-header,
            .modal-multi-order-action-header a,
            .modal-multi-order-action-header span,
            .modal-multi-order-action-header div,
            .modal-card-header-link,
            .modal-card-header-title,
            .modal-card-header-side {
                font-weight: 400 !important;
            }
    </style>




    <div class="container-fluid">

        <div class="row mb-0">
            <div class="col-lg-4">
                @if (!User.IsInRole("DeliveryCompany") && !User.IsInRole("DeliveryRepresentative"))
                {
                    <h6 class="text-right fw-light">
                        مدخل الطلب :
                        <img id="orderDetails_employeeImage" width="18" height="18" class="b-r-50" src="/@Model.EmployeeImage" />
                        <span id="orderDetails_employeeName">@Model.EmployeeName</span>
                    </h6>

                    @if (Model.CreationDurationSeconds.HasValue)
                    {
                        var _dur = Model.CreationDurationSeconds.Value;
                        var _mm = (_dur / 60).ToString("D2");
                        var _ss = (_dur % 60).ToString("D2");
                        <h6 class="text-right fw-light">مدة إنشاء الطلب : <span id="orderDetails_creationDuration" style="color: red;">@_mm:@_ss</span></h6>
                    }

                    @if (Model.LastEditedBy != null)
                    {
                        @* <h6 class="text-right fw-light">معدل الطلب : <img id="orderDetails_lastEditedByImage" width="18" height="18" src="@Model.lastEditedByImage" /> @Model.LastEditedBy</h6>
 *@                    }
                    @if (Model.FixedbyEmployee != null)
                    {
                        <h6 class="text-right fw-light">معالج الطلب : <img id="orderDetails_fixedByEmployeeImage" width="18" height="18" src="@Model.FixedbyEmployeeImage" /> @Model.FixedbyEmployee </h6>
                    }
                    @if (Model.FromCommentsEmployee != null)
                    {
                        <h6 class="text-right fw-light">من التعليقات : <img id="orderDetails_fromCommentsEmployeeImage" width="18" height="18" src="@Model.FromCommentsEmployeeImage" /> @Model.FromCommentsEmployee </h6>
                    }
                }
                else
                {
                    <h6 class="text-right fw-light">مدخل الطلب : <img id="orderDetails_employeeImage_default" width="18" height="18" class="b-r-50" src="/static//LuxiraLogo.svg" /> MAJESTA GROUP </h6>
                }
            </div>
            <div class="col-lg-8">

                <div class="row ">

                    @{
                        // Show these quick action buttons in the details header for all internal users,
                        // including new/in-progress orders. Previously they were hidden unless the order
                        // was delivered/paid/balance-updated, which made them disappear in split-search cards.
                        var specialClientAndComplaintsStatuses = new[]
                        {
                    OrderStatusEnum.تم_التسليم,
                    OrderStatusEnum.تم_تحديث_الرصيد,
                    OrderStatusEnum.تم_الدفع
                    };
                        var showSpecialAndComplaints = specialClientAndComplaintsStatuses.Contains(Model.OrderStatus);
                    }
                    @if (User.IsInRole("Admin") || User.IsInRole("FollowUpDepartment") || User.IsInRole("ExecutiveDirector"))
                    {

                        <div class="d-flex justify-content-around pe-0 ps-0">

                            @if (!User.IsInRole("FollowUpDepartment"))
                            {
                                <div class="dropdown b-r-8 custom-box-shadow flex-item-equal">
                                    <button id="dropdownMenuButtonemployee" data-bs-toggle="dropdown" aria-expanded="false" class="btn dropdown-toggle ps-4 pe-4 m-0 d-none d-md-table-cell  text-nowrap"> تعيين الموظف</button>
                                    <ul aria-labelledby="dropdownMenuButtonemployee" class="dropdown-menu-employees dropdown-menu h-200-px" style="overflow-y: auto; min-width: 100%;">
                                    </ul>
                                </div>
                            }


                            <div class="dropdown b-r-8 custom-box-shadow me-2 flex-item-equal">
                                <button id="dropdownMenuButtonDelivery" data-bs-toggle="dropdown" aria-expanded="false" class="btn dropdown-toggle d-none d-md-table-cell ps-4 pe-4 d-none d-md-table-cell m-0 text-nowrap">تعيين شركة التوصيل</button>
                                <ul id="deliveryCompaniesDropdown" aria-labelledby="dropdownMenuButtonDelivery" class="dropdown-menu dropdown-menu h-200-px" style="overflow-y: auto; min-width: 100%;">
                                </ul>
                            </div>

                            <div class="dropdown b-r-8 custom-box-shadow me-2 flex-item-equal">
                                <button id="dropdownMenuButtonPostpone" data-bs-toggle="dropdown" aria-expanded="false" class="btn dropdown-toggle d-none d-md-table-cell ps-4 pe-4 d-none d-md-table-cell m-0 text-nowrap">تأجيل الطلب</button>
                                <ul id="postponeDropdown" aria-labelledby="dropdownMenuButtonPostpone" class="dropdown-menu dropdown-menu h-200-px" style="overflow-y: auto; min-width: 100%;">
                                    <li><a class="dropdown-item postpone-option" href="#" data-days="4">4 أيام</a></li>
                                    <li><a class="dropdown-item postpone-option" href="#" data-days="7">7 أيام</a></li>
                                    <li><a class="dropdown-item postpone-option" href="#" data-days="10">10 أيام</a></li>
                                    <li><a class="dropdown-item postpone-option" href="#" data-days="14">14 يوم</a></li>
                                    <li><a class="dropdown-item postpone-option" href="#" data-days="30">30 يوم</a></li>
                                    <li><a class="dropdown-item postpone-option" href="#" data-days="45">45 يوم</a></li>
                                    <li>
                                        <div class="px-2 py-1">
                                            <input type="datetime-local" class="form-control postpone-custom-date" />
                                        </div>
                                    </li>
                                </ul>
                            </div>


                            @if (showSpecialAndComplaints)
                            {
                                <button id="toggleSpecialClientButton"
                                        style="@(Model.IsClientSpecial ? "background-color:#7E30E1!important;" : "")"
                                        class="btn mx-2 me-2 d-none d-md-table-cell togglespecialclient custom-box-shadow ps-4 pe-4 text-nowrap d-none d-md-table-cell flex-item-equal @(Model.IsClientSpecial ? "text-white" : "")">
                                    عميل مميز
                                </button>


                                <button id="toggleComplaintsButton"
                                        style="@(Model.IsComplaints ? "background-color:red!important; color:white!important;" : "")"
                                        class="btn toggleIsComplaints d-none d-md-table-cell custom-box-shadow ps-4 pe-4 text-nowrap flex-item-equal">
                                    شكاوي
                                </button>
                            }




                            <button id="cancelButton"
                                    style="@(Model.OrderStatus == OrderStatusEnum.تم_الإلغاء ? "background-color:red!important;" : "")"
                                    class="btn ps-4 pe-4 cancelButton custom-box-shadow mx-2 b-r-8 text-nowrap flex-item-equal @(Model.OrderStatus == OrderStatusEnum.تم_الإلغاء ? "text-white" : "")"
                                    onclick="updateStatus(@Model.Id, '@OrderStatusEnum.تم_الإلغاء')">
                                إلغاء الطلب
                            </button>


                            @if (User.IsInRole("FollowUpDepartment"))

                            {

                                <button class="btn btn-green ps-4 pe-4 text-nowrap Temporarydeliveredorders me-2 flex-item-equal" onclick="updateStatus(@Model.Id, '@OrderStatusEnum.تم_التسليم_المؤقت')">تم التسليم  المؤقت</button>

                            }

                            @{
                                var followUpLockedForEdit = User.IsInRole("FollowUpDepartment")
                                && (Model.OrderStatus == OrderStatusEnum.تم_التسليم
                                || Model.OrderStatus == OrderStatusEnum.تم_تحديث_الرصيد
                                || Model.OrderStatus == OrderStatusEnum.تم_الدفع);
                            }
                            @if (!followUpLockedForEdit)
                            {
                                <div class="open custom-box-shadow mx-2 b-r-8 flex-item-equal">
                                    <button type="button"
                                            data-url="@Url.Action("EditOrder", "Home", new { orderId = Model.Id })"
                                            data-country="@Model.Country"
                                            data-city="@Model.State"
                                            data-deliverycompanyid="@Model.DeliveryCompanyId"
                                            class="btn  open  ps-4 pe-4 hover-background-gold-v2 hover-text-white    btn-block text-nowrap">
                                        تعديل الطلب
                                    </button>
                                </div>
                            }
                            @{
                                // Get the valid next statuses for this order's current status
                                var validNextStatuses = OrderStatusHelper.GetValidNextStatuses(Model.OrderStatus);

                                // Build display list: show all ordered statuses BUT filter out failure stages
                                // that aren't a valid next transition from the current status
                                var allStatuses = OrderStatusHelper.OrderedStatuses;
                                var orderStatusesToDisplay = allStatuses
                                .Where(s => !OrderStatusHelper.IsFailureStatus(s) || validNextStatuses.Contains(s))
                                .ToList();
                            }

                            <div class="dropdown custom-box-shadow b-r-8   flex-item-equal">
                                <button id="dropdownMenuButton1" data-bs-toggle="dropdown" aria-expanded="false" class="btn dropdown-toggle ps-4 pe-4 m-0  text-nowrap">تعديل حالة الطلب</button>
                                <ul aria-labelledby="dropdownMenuButton1" class="dropdown-menu ltr h-200-px" style="overflow-y: auto;  min-width: 100%;">
                                    @foreach (var status in orderStatusesToDisplay)
                                    {
                                        <li>
                                            <a class="dropdown-item" href="javascript:updateStatus(@Model.Id, '@status')">
                                                <div class="d-flex justify-content-between align-items-center">
                                                    <i class="fa-solid fa-chevron-down" style="color: #511f2b;"></i>
                                                    <span class="text-center flex-grow-1">@status.ToString().Replace("_", " ")</span>
                                                    <span>
                                                        <i class="fa-solid fa-circle" style="@OrderStatusHelper.StatusColorMapping[status]"></i>
                                                    </span>
                                                </div>
                                            </a>
                                        </li>
                                    }
                                </ul>
                            </div>

                            @if (OrderStatusHelper.IsFailureStatus(Model.OrderStatus))
                            {
                                var adminNextFailure = validNextStatuses.FirstOrDefault();
                                var adminFailureLabel = adminNextFailure.ToString().Replace("_", " ");
                                <button class="btn mx-2 btn-red b-r-8 px-md-4 p-2 text-nowrap flex-item-equal"
                                        onclick="updateStatus(@Model.Id, '@adminNextFailure')">
                                    @adminFailureLabel
                                </button>
                            }

                            @if (OrderStatusHelper.IsIncompleteStatus(Model.OrderStatus))
                            {
                                var adminNextIncomplete = validNextStatuses.FirstOrDefault();
                                var adminIncompleteLabel = adminNextIncomplete.ToString().Replace("_", " ");
                                <button class="btn mx-2 btn-red b-r-8 px-md-4 p-2 text-nowrap flex-item-equal"
                                        onclick="updateStatus(@Model.Id, '@adminNextIncomplete')">
                                    @adminIncompleteLabel
                                </button>
                            }

                            <button id="processingButton"
                                    style="@(Model.OrderStatus == OrderStatusEnum.تم_المعالجة ? "background-color:#45bbea!important;" : "")"
                                    class="btn custom-box-shadow b-r-8 mx-2 ps-4 pe-4 btn-light btn-sec text-nowrap flex-item-equal @(Model.OrderStatus == OrderStatusEnum.تم_المعالجة ? "text-white" : "")"
                                    onclick="updateStatus(@Model.Id, '@OrderStatusEnum.تم_المعالجة')">
                                تم معالجة الطلب
                            </button>

                            <button data-url="@Url.Action("ResendOrder", "Home", new { orderId = Model.Id })" class="btn custom-box-shadow b-r-8 Resend text-white btn-green-v2 ps-4 pe-4 text-nowrap flex-item-equal">
                                <span>
                                    <i class="fa-solid fa-repeat ms-1"></i>
                                </span>
                                إعادة إرسال الطلب

                            </button>

                        </div>
                    }





                    @if (User.IsInRole("DeliveryCompany") || User.IsInRole("DeliveryRepresentative"))
                    {
                        var isDelivered = Model.OrderStatus == OrderStatusEnum.تم_التسليم;
                        var isFailure = OrderStatusHelper.IsFailureStatus(Model.OrderStatus);
                        var canMoveToInDelivery = Model.OrderStatus == OrderStatusEnum.تم_التجهيز;

                        <div class="container pe-0 mx-0 d-flex justify-content-center">

                            @if (isDelivered)
                            {
                                // الحالة تم التسليم: لا يمكن تغيير الحالة مطلقاً
                            }
                            else if (isFailure)
                            {
                                // حالات فشل التسليم: يسمح فقط بالتحويل إلى تم التسليم
                                <button class="btn mx-2 btn-green px-md-4 p-2 text-nowrap flex-item-equal" onclick="updateStatus(@Model.Id, '@OrderStatusEnum.تم_التسليم')">تم التسليم</button>
                            }
                            else
                            {
                                <button class="btn mx-2 px-md-4 p-2 btn-blue text-nowrap flex-item-equal" onclick="updateStatus(@Model.Id, '@OrderStatusEnum.تم_التجهيز')">تم التجهيز</button>
                                @if (canMoveToInDelivery)
                                {
                                    <button class="btn mx-2 btn-yellow-v2 p-2 px-md-4 text-nowrap flex-item-equal" onclick="updateStatus(@Model.Id, '@OrderStatusEnum.قيد_التوصيل')">قيد التوصيل</button>
                                }
                                <button class="btn mx-2 btn-green px-md-4 p-2 text-nowrap flex-item-equal" onclick="updateStatus(@Model.Id, '@OrderStatusEnum.تم_التسليم')">تم التسليم</button>
                                <button class="btn mx-2 btn-red px-md-4 p-2 text-nowrap flex-item-equal" onclick="updateStatus(@Model.Id, '@OrderStatusEnum.فشل_التسليم')">فشل التسليم</button>
                            }

                        </div>
                    }

                    @if (User.IsInRole("CallCenter"))
                    {
                        <div class="container d-flex justify-content-end">


                            <div class="dropdown b-r-8 custom-box-shadow ms-2 flex-item-equal">
                                <button id="dropdownMenuButtonDelivery" data-bs-toggle="dropdown" aria-expanded="false" class="btn dropdown-toggle d-none d-md-table-cell ps-3 pe-3 d-none d-md-table-cell m-0 text-nowrap">تعيين شركة التوصيل</button>
                                <ul id="deliveryCompaniesDropdown" aria-labelledby="dropdownMenuButtonDelivery" class="dropdown-menu dropdown-menu h-200-px" style="overflow-y: auto; min-width: 100%;">
                                </ul>
                            </div>

                            <div class="dropdown b-r-8 custom-box-shadow ms-2 flex-item-equal">
                                <button id="dropdownMenuButtonPostpone" data-bs-toggle="dropdown" aria-expanded="false" class="btn dropdown-toggle d-none d-md-table-cell ps-3 pe-3 d-none d-md-table-cell m-0 text-nowrap">تأجيل الطلب</button>
                                <ul id="postponeDropdown" aria-labelledby="dropdownMenuButtonPostpone" class="dropdown-menu dropdown-menu h-200-px" style="overflow-y: auto; min-width: 100%;">
                                    <li><a class="dropdown-item postpone-option" href="#" data-days="4">4 أيام</a></li>
                                    <li><a class="dropdown-item postpone-option" href="#" data-days="7">7 أيام</a></li>
                                    <li><a class="dropdown-item postpone-option" href="#" data-days="10">10 أيام</a></li>
                                    <li><a class="dropdown-item postpone-option" href="#" data-days="14">14 يوم</a></li>
