                function openChildModal(url, modalId) {
                    $.ajax({
                        url: url,
                        type: 'GET',
                        success: function (data) {
                            // Remove any previous instance
                            $('body > [data-child-modal]').remove();

                            // Parse HTML and wrap it so we can move it to body
                            var $wrapper = $('<div data-child-modal="true"></div>').html(data);
                            $('body').append($wrapper);

                            var $modal = $wrapper.find('#' + modalId);
                            // Ensure child modal sits above the details modal
                            $modal.css('z-index', 1065);

                            var editSubmitAttempted = false;
                            var editSavedSuccessfully = false;
                            var ajaxSuccessNamespace = '.orderEditSuccessPopup_' + Date.now();

                            if (modalId === 'Edit') {
                                // Mark intent only when the user clicks the save/edit submit button,
                                // not when they simply close the modal.
                                $wrapper.on('submit.orderEditSuccessPopup', 'form', function () {
                                    editSubmitAttempted = true;
                                });

                                $wrapper.on('click.orderEditSuccessPopup', 'button, input[type="button"], input[type="submit"], a', function () {
                                    var text = $.trim($(this).text() || $(this).val() || '');
                                    var type = String($(this).attr('type') || '').toLowerCase();

                                    if (type === 'submit' || text.indexOf('تعديل') !== -1 || text.indexOf('حفظ') !== -1 || text.indexOf('تحديث') !== -1) {
                                        editSubmitAttempted = true;
                                    }
                                });

                                // If the edit modal submits through jQuery AJAX, this detects a successful POST.
                                $(document).on('ajaxSuccess' + ajaxSuccessNamespace, function (event, xhr, settings) {
                                    if (!$modal.hasClass('show')) return;

                                    var method = String(settings.type || settings.method || 'GET').toUpperCase();
                                    var requestUrl = String(settings.url || '').toLowerCase();

                                    if (method === 'POST' && (
                                        requestUrl.indexOf('edit') !== -1 ||
                                        requestUrl.indexOf('update') !== -1 ||
                                        requestUrl.indexOf('order') !== -1
                                    )) {
                                        editSavedSuccessfully = true;
                                    }
                                });
                            }

                            $modal.modal('show');

                            // On close, clean up the wrapper and refresh the parent modal
                            $modal.on('hidden.bs.modal', function () {
                                $(document).off(ajaxSuccessNamespace);
                                $wrapper.off('.orderEditSuccessPopup');

                                var shouldShowEditSuccess =
                                    modalId === 'Edit' &&
                                    (editSavedSuccessfully || editSubmitAttempted);

                                $wrapper.remove();

                                // Keep body scrollable-locked while the parent details modal is still open
                                document.body.classList.add('modal-open');

                                // Refresh details partial and order table to reflect any changes
                                window.invalidateOrder(orderId);
                                window.refreshModalContent(orderId);
                                window.refreshOrderTable();

                                if (shouldShowEditSuccess) {
                                    setTimeout(function () {
                                        showEditSuccessPopup();
                                    }, 180);
                                }
                            });

                            // Fix backdrop z-index once shown
                            $modal.on('shown.bs.modal', function () {
                                // The latest backdrop is the child modal's
                                var backdrops = document.querySelectorAll('.modal-backdrop');
                                if (backdrops.length > 1) {
                                    backdrops[backdrops.length - 1].style.zIndex = '1060';
                                }
                            });
                        },
                        error: function (xhr, status, error) {
                            console.error('AJAX Error: ' + status + ' - ' + error);
                        }
                    });
                }

