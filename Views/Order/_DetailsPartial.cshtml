    string? libyaWarehouse = null;
    string? libyaLaneDisplay = null, libyaLaneCopy = null;
    string? libyaLocationDisplay = null, libyaLocationCopy = null;
    if (Model.Country == Common.Countries.ليبيا && !string.IsNullOrWhiteSpace(Model.State))
    {
        var city = Model.State.Trim();
        var info = libyaCityMap.TryGetValue(city, out var found) ? found : ("مخزن سوق الجمعه", (string?)null);
        libyaWarehouse = info.Item1;
        if (!string.IsNullOrEmpty(info.Item2))
        {
            var parts = info.Item2.Split(new[] { " المنطقة " }, 2, StringSplitOptions.None);
            libyaLaneDisplay = parts[0];
            libyaLaneCopy = libyaLaneDisplay != null && libyaLaneDisplay.StartsWith("مسار ")
                ? libyaLaneDisplay.Substring("مسار ".Length)
                : libyaLaneDisplay;
            if (parts.Length > 1)
            {
                libyaLocationDisplay = "المنطقة " + parts[1];
                libyaLocationCopy = parts[1];
            }
        }
    }
}

@{
    var isSplitView = string.Equals(Context.Request.Query["splitView"].ToString(), "true", StringComparison.OrdinalIgnoreCase)
        || string.Equals(Context.Request.Query["embed"].ToString(), "true", StringComparison.OrdinalIgnoreCase);
}

@{
    var detailsOrderSourceText = (Model.OrderSource.ToString() ?? "").ToLowerInvariant();
    var detailsIsFacebookOrInstagramOrder = detailsOrderSourceText.Contains("فيس")
        || detailsOrderSourceText.Contains("facebook")
        || detailsOrderSourceText.Contains("انست")
        || detailsOrderSourceText.Contains("instagram")
        || detailsOrderSourceText.Contains("meta");

    var detailsReceiptPhoneCode = Common.GetPhoneNumberCodeByCountryStatus(Model.Country.ToString());
    var detailsReceiptWhatsAppUrl = string.IsNullOrWhiteSpace(Model.TelephoneNumber)
        ? ""
        : $"https://wa.me/{detailsReceiptPhoneCode}{Model.TelephoneNumber}";
}


