    function confirmProblemDeduction() {
    if (!currentOrderId || !deductionOkBtn) return;

    var employeeId = deductionEmployeeSelect ? deductionEmployeeSelect.value : '';
    var amount = deductionAmountInput ? deductionAmountInput.value : '';
    var reason = deductionReasonInput ? deductionReasonInput.value.trim() : '';

    if (!employeeId) { showDeductionError('اختاري الموظف'); return; }
    if (!amount || parseFloat(amount) <= 0) { showDeductionError('ادخلي قيمة الخصم'); return; }
    if (!reason) { showDeductionError('اكتبي تفاصيل الخصم'); return; }

    deductionOkBtn.disabled = true;
    if (deductionCancelBtn) deductionCancelBtn.disabled = true;
    showDeductionError('');

    createProblemPostForDeduction()
    .then(function () {
    var fd = new FormData();
    fd.append('orderId', currentOrderId);
    fd.append('employeeId', employeeId);
    fd.append('amount', amount);
    fd.append('reason', reason);
    fd.append('problemText', pendingDeductionBody);
    appendAntiforgery(fd);

    return fetch('/OrderPosts/CreateProblemDeduction', {
    method: 'POST',
    body: fd,
    credentials: 'same-origin'
    }).then(function (r) {
    if (!r.ok) return r.json().then(function (j) { throw new Error(j.message || 'HTTP ' + r.status); });
    return r.json();
    });
    })
    .then(function () {
