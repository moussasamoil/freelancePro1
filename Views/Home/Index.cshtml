    <script id="investigation-approval-script">
        (function () {
        const orderDetailsModalEl = document.getElementById('orderDetailsModal');
        const orderDetailsBody = document.getElementById('orderDetailsModalBody');

        if (!orderDetailsModalEl || !orderDetailsBody) {
        return;
        }

        const isInvestigationAdmin = @((User.IsInRole("Admin") || User.IsInRole("ExecutiveDirector") || User.IsInRole("FollowUpDepartment")).ToString().ToLowerInvariant());
        const isInvestigationCallCenter = @User.IsInRole("CallCenter").ToString().ToLowerInvariant();
        const isInvestigationPageJs = @((ViewBag.IsInvestigationPage == true).ToString().ToLowerInvariant());

        const approvedDataByOrderId = {};
        const callCenterAutoApprovedOrderIds = new Set();

        function removeCallCenterApprovalMessages() {
        if (!isInvestigationCallCenter) {
        return;
        }

        orderDetailsBody
        .querySelectorAll('[data-investigation-approved-banner="true"], .investigation-approved-banner, [data-investigation-inline-approve="true"], .investigation-inline-approve-btn')
        .forEach(function (el) {
        el.remove();
        });
        }

        if (isInvestigationCallCenter) {
        // للكول سنتر فقط: Refresh كل 24 ساعة
        window.setTimeout(function () {
        window.location.reload();
        }, 24 * 60 * 60 * 1000);
        }

        function getAntiForgeryToken() {
        const formToken = document.querySelector('#investigationAntiForgeryForm input[name="__RequestVerificationToken"]');
        if (formToken && formToken.value) {
        return formToken.value;
        }

        const anyToken = document.querySelector('input[name="__RequestVerificationToken"]');
        return anyToken ? anyToken.value : '';
        }

        function escapeHtml(value) {
        return String(value || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
        }

        function closeInvestigationApprovalSuccessPopup() {
        const existing = document.getElementById('investigationApprovalSuccessPopup');
        if (existing) {
        existing.remove();
        }
        }

        function showInvestigationApprovalSuccessPopup() {
        closeInvestigationApprovalSuccessPopup();

        const popup = document.createElement('div');
        popup.id = 'investigationApprovalSuccessPopup';
        popup.className = 'investigation-approval-success-backdrop';
        popup.innerHTML = ''
        + '<div class="investigation-approval-success-card">'
        + '<div class="investigation-approval-success-check">✓</div>'
        + '<div class="investigation-approval-success-title">تم الاعتماد بنجاح</div>'
        + '<button type="button" class="investigation-approval-success-confirm">تأكيد</button>'
        + '</div>';

        document.body.appendChild(popup);

        const close = function () {
        closeInvestigationApprovalSuccessPopup();
        };

        popup.querySelector('.investigation-approval-success-confirm').addEventListener('click', close);
        popup.addEventListener('click', function (event) {
        if (event.target === popup) {
        close();
        }
        });

        window.setTimeout(close, 3000);
        }

        function safeSelectorValue(value) {
        value = String(value || '');
        if (window.CSS && typeof window.CSS.escape === 'function') {
        return window.CSS.escape(value);
        }

        return value.replace(/\\/g, '\\\\').replace(/"/g, '\\"');
        }

        function getCurrentModalOrderId() {
        return orderDetailsModalEl.dataset.orderId
        || orderDetailsModalEl.dataset.initialOrderId
        || orderDetailsModalEl.dataset.investigationOpenedOrderId
        || '';
        }

        function hasLoadedOrderDetails() {
        return !!orderDetailsBody.querySelector('.order-details-partial');
        }

        function updateDetailsHeaderVisibility() {
        if (hasLoadedOrderDetails()) {
        orderDetailsModalEl.classList.add('investigation-details-loaded');
        orderDetailsModalEl.classList.remove('investigation-details-loading');
        } else {
        orderDetailsModalEl.classList.remove('investigation-details-loaded');
        orderDetailsModalEl.classList.add('investigation-details-loading');
        }

        injectAdminApproveButtonIfNeeded();
        removeCallCenterApprovalMessages();
        }

        function setInvestigationCount(value) {
        const count = Math.max(0, Number(value || 0));

        const pageTotal = document.getElementById('investigationPageTotal');
        if (pageTotal) {
        pageTotal.textContent = String(count);
        }

        const badge = document.getElementById('investigationOrdersCountBadge');
        if (badge) {
        badge.textContent = String(count);
        badge.style.display = count > 0 ? 'inline-flex' : 'none';
        }

        if (typeof window.luxiraSetInvestigationOrdersCount === 'function') {
        window.luxiraSetInvestigationOrdersCount(count);
        }

        try {
        localStorage.setItem('luxiraInvestigationOrdersRemainingCount', String(count));
        localStorage.setItem('luxiraInvestigationOrdersRemainingCountUpdatedAt', String(Date.now()));
        } catch { }
        }

        function decreaseInvestigationCountByOne() {
        const current = Number(document.getElementById('investigationPageTotal')?.textContent || 0);
        setInvestigationCount(current - 1);
        }

        function removeInvestigationRow(orderId) {
        const row = document.querySelector('#ordersTable tbody tr.order-details[data-order-id="' + safeSelectorValue(orderId) + '"]');

        if (!row) {
        return false;
        }

        row.classList.add('investigation-row-removing');

        setTimeout(function () {
        row.remove();

        const tbody = document.querySelector('#ordersTable tbody');
        if (tbody && !tbody.querySelector('tr.order-details')) {
        const tableWrap = document.querySelector('#ordersTable')?.closest('.table-responsive');
        if (tableWrap && !document.getElementById('investigationEmptyMessage')) {
        tableWrap.insertAdjacentHTML(
        'afterend',
        '<div id="investigationEmptyMessage" class="text-center fw-bold mt-3 mb-3" dir="rtl">لا يوجد طلبات قيد التحقق</div>'
        );
        }
        }
        }, 230);

        return true;
        }

        function approveOrder(orderId) {
        const token = getAntiForgeryToken();

        return fetch('/Home/ApproveNewOrderInvestigation?orderId=' + encodeURIComponent(orderId), {
        method: 'POST',
        credentials: 'same-origin',
        headers: {
        'Accept': 'application/json',
        'RequestVerificationToken': token
        }
        })
        .then(function (response) {
        if (!response.ok) {
        throw new Error('HTTP ' + response.status);
        }

        return response.json();
        })
        .then(function (result) {
        if (!result || !result.success) {
        throw new Error(result && result.message ? result.message : 'حصل خطأ أثناء اعتماد الطلب');
