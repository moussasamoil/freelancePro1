<script>
    // ---- OrderPosts wiring (the 3 report modals + the 2 admin header panels) ----
    // Backend: OrderPostsController (Create / List / Edit / Delete / DeleteImage / Panels). Real-time push via OrderHub `newOrderPost`.
    document.addEventListener('DOMContentLoaded', function () {
    var POST_TYPE_PROBLEM = 0;
    var POST_TYPE_EDIT_NOTE = 1;
    var POST_TYPE_ORDER_NOTE = 2;

    // Notification sounds. Problem/EditNote sounds fire on live SignalR push (panel roles only,
    // server-side gated). OrderNote sound fires client-side on ajax success (everyone, incl. CallCenter).
    var ORDER_POST_SOUNDS = {};
    ORDER_POST_SOUNDS[POST_TYPE_PROBLEM] = '/NotificationSound/report-notification.wav';
    ORDER_POST_SOUNDS[POST_TYPE_EDIT_NOTE] = '/NotificationSound/edit-notifcation.wav';
    ORDER_POST_SOUNDS[POST_TYPE_ORDER_NOTE] = '/NotificationSound/order-notes-for-everyone-including-call-center.wav';
    function playOrderPostSound(typeId) {
    var src = ORDER_POST_SOUNDS[typeId];
    if (!src) return;
    try { new Audio(src).play().catch(function () { }); } catch (e) { }
    }

    // Pull the antiforgery token rendered into #orderPostsAntiforgery and append it to every FormData POST.
    function getAntiforgeryToken() {
    var input = document.querySelector('#orderPostsAntiforgery input[name="__RequestVerificationToken"]');
    return input ? input.value : '';
    }
    function appendAntiforgery(fd) {
    var t = getAntiforgeryToken();
    if (t) fd.append('__RequestVerificationToken', t);
    return fd;
    }

    // ----- Bubble template helpers -----
    // DEV: employee avatar SVG is a placeholder — replace with <img object-fit:cover> at 40x40 when ApplicationUser gains an avatar URL.
    var EMPLOYEE_AVATAR_SVG = '<svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 40 40" class="report-employee-avatar">' +
    '<rect width="40" height="40" rx="20" fill="#e9ecef" />' +
    '<circle cx="20" cy="15" r="6" fill="#adb5bd" />' +
    '<path d="M8 34c0-6.6 5.4-12 12-12s12 5.4 12 12" fill="#adb5bd" />' +
    '</svg>';

    function escapeHtml(s) {
    if (s == null) return '';
    return String(s).replace(/[&<>"']/g, function (ch) {
    return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[ch];
    });
    }

    function formatDateTime(iso) {
    // Server posts Istanbul-local DateTime serialized as "2026-05-08T14:32:00".
    // Display as "yyyy-MM-dd HH:mm" without timezone re-conversion.
    if (!iso) return '';
    var s = String(iso).replace('T', ' ');
    var dot = s.indexOf('.');
    if (dot > -1) s = s.substring(0, dot);
    return s.length >= 16 ? s.substring(0, 16) : s;
    }

    // Build one bubble's HTML from a post object returned by /OrderPosts/List.
    // post.images is now [{id, url}, ...]; post.isCurrentUser drives edit button visibility.
    function renderBubble(post, showCheckbox, canDelete, postType) {
    var imagesHtml = '';
    if (post.images && post.images.length) {
    imagesHtml = '<div class="row g-2 mb-2">' + post.images.map(function (img) {
    var url = escapeHtml(img.url);
    // DEV: bubble image opens in new tab; delete X shown only in edit mode via CSS.
    return '<div class="col-6 col-md-4 report-img-col">' +
    '<a href="' + url + '" target="_blank" rel="noopener" class="report-bubble-image-link">' +
    '<img src="' + url + '" class="report-bubble-image" alt="" style="object-fit:cover;" />' +
    '</a>' +
    '<button type="button" class="report-img-delete-btn" data-image-id="' + img.id + '">×</button>' +
    '</div>';
    }).join('') + '</div>';
    }

    // Always render the body element so edit mode has a target to swap in/out.
    var rawBody = post.body || '';
    var bodyHtml = '<p class="mb-0 report-bubble-body" style="white-space:pre-wrap;" data-raw-body="' +
    escapeHtml(rawBody) + '">' + escapeHtml(rawBody) + '</p>';

    // DEV: trash button visible only to roles allowed to delete (Admin, ExecutiveDirector). Server enforces Delete role check.
    var checkboxHtml = '';
    if (showCheckbox && canDelete) {
    checkboxHtml = '<button type="button" class="reports-delete-post-btn mt-1" data-post-id="' + post.id + '" title="حذف">' +
    '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 16 16">' +
    '<path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0V6z"/>' +
    '<path fill-rule="evenodd" d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1v1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4H4.118zM2.5 3V2h11v1h-11z"/>' +
    '</svg>' +
    '</button>';
    }

    // Edit / موافقة / إلغاء — only shown to the post's own author. OrderNote posts are not editable.
    var editHtml = '';
    if (post.isCurrentUser && postType !== POST_TYPE_ORDER_NOTE) {
    editHtml =
    '<button type="button" class="report-edit-btn">تعديل</button>' +
    '<span class="report-edit-actions">' +
    '<button type="button" class="report-save-btn">موافقة</button>' +
    '<button type="button" class="report-cancel-btn">إلغاء</button>' +
    '</span>';
    }

    return '<div class="report-bubble-row d-flex align-items-start mb-3" data-post-id="' + post.id + '">' +
    '<div class="report-employee-col d-flex flex-column align-items-center ms-2">' +
    EMPLOYEE_AVATAR_SVG +
    checkboxHtml +
    '</div>' +
    '<div class="report-bubble flex-grow-1">' +
    '<div class="report-bubble-header d-flex justify-content-between align-items-center mb-1">' +
    '<span class="fw-bold text-green">' + escapeHtml(post.authorName || '') + '</span>' +
    '<span class="d-flex align-items-center gap-1">' +
    editHtml +
    '<span class="text-muted f-s-12">' + escapeHtml(formatDateTime(post.createdAt)) + '</span>' +
    '</span>' +
    '</div>' +
    imagesHtml +
    bodyHtml +
    '</div>' +
    '</div>';
    }

    // ----- Per-modal wiring -----
    document.querySelectorAll('.reports-modal').forEach(function (modal) {
    var attachInput = modal.querySelector('.reports-attach-input');
    var attachPreview = modal.querySelector('.reports-attach-preview');
    var textInput = modal.querySelector('.reports-text-input');
    var submitBtn = modal.querySelector('.reports-submit-btn');
    var conversation = modal.querySelector('.reports-conversation');
    var emptyState = modal.querySelector('.reports-empty');
    var loadingState = modal.querySelector('.reports-loading');
    if (!attachInput || !attachPreview || !textInput || !submitBtn || !conversation) return;

    var postType = parseInt(modal.getAttribute('data-post-type'), 10) || 0;
    var showCheckbox = modal.getAttribute('data-show-checkbox') === '1';
    var deleteConfirm = modal.querySelector('.reports-delete-confirm');
    var clearAllBtn = modal.querySelector('.reports-clear-all-btn');
    var clearAllConfirm = modal.querySelector('.reports-clear-all-confirm');
    var copyToast = modal.querySelector('.reports-copy-toast');
    var historyBtn = modal.querySelector('.reports-deleted-history-btn');
    var historyPanel = modal.querySelector('.reports-deleted-history-panel');
    var historyBody = modal.querySelector('.reports-deleted-history-body');
    var historyCloseBtn = modal.querySelector('.reports-deleted-history-close');
    var historyBackBtn = modal.querySelector('.reports-deleted-history-back');
    var copyAllBtn = modal.querySelector('.reports-copy-all-btn');
    var canFollowUpManageEditNotes = modal.getAttribute('data-followup-edit-note-permission') === '1';
    var canSendProblemDeduction = modal.getAttribute('data-problem-deduction-permission') === '1';
    var deductionConfirm = modal.querySelector('.reports-deduction-confirm');
    var deductionEmployeeSelect = modal.querySelector('.reports-deduction-employee-select');
    var deductionAmountInput = modal.querySelector('.reports-deduction-amount-input');
    var deductionReasonInput = modal.querySelector('.reports-deduction-reason-input');
    var deductionTotalText = modal.querySelector('.reports-deduction-total-text');
    var deductionError = modal.querySelector('.reports-deduction-error');
    var deductionOkBtn = modal.querySelector('.reports-deduction-confirm-ok');
    var deductionCancelBtn = modal.querySelector('.reports-deduction-confirm-cancel');
    var deductionCloseBtn = modal.querySelector('.reports-deduction-confirm-close');
    var pendingDeductionBody = '';
    var pendingDeleteBtn = null;
    var pendingDeleteRow = null;
    var pendingFiles = []; // accumulates paste + browse-picked images (paste doesn't go through attachInput.files)
    var currentOrderId = null;
    var copyToastTimer = null;

    function showCopyToast() {
    if (!copyToast) return;

    copyToast.textContent = 'تم نسخ المحتوى';
    copyToast.classList.add('show');

    if (copyToastTimer) clearTimeout(copyToastTimer);
    copyToastTimer = setTimeout(function () {
    copyToast.classList.remove('show');
    }, 1800);
    }

    function copyReportContent(text) {
    text = (text || '').toString().trim();
    if (!text) return;

    var done = function () {
    showCopyToast();
    };

    if (navigator.clipboard && navigator.clipboard.writeText) {
    navigator.clipboard.writeText(text).then(done).catch(function () {
    var ta = document.createElement('textarea');
    ta.value = text;
    ta.style.position = 'fixed';
    ta.style.opacity = '0';
    document.body.appendChild(ta);
    ta.select();
    document.execCommand('copy');
    document.body.removeChild(ta);
    done();
    });
    } else {
    var ta = document.createElement('textarea');
    ta.value = text;
    ta.style.position = 'fixed';
    ta.style.opacity = '0';
    document.body.appendChild(ta);
    ta.select();
    document.execCommand('copy');
    document.body.removeChild(ta);
    done();
    }
    }

    function getEffectiveCanDelete() {
    var serverCanDelete = modal.getAttribute('data-can-delete') === '1';
    return serverCanDelete || (postType === POST_TYPE_EDIT_NOTE && canFollowUpManageEditNotes) || (postType === POST_TYPE_PROBLEM && canSendProblemDeduction);
    }

    function syncCopyAllButton() {
    if (!copyAllBtn) return;
    var hasPosts = !!conversation.querySelector('.report-bubble-body');
    copyAllBtn.style.display = hasPosts ? 'inline-flex' : 'none';
    }

    function copyAllReportContents() {
    var texts = Array.from(conversation.querySelectorAll('.report-bubble-body'))
    .map(function (el) { return (el.getAttribute('data-raw-body') || el.textContent || '').trim(); })
    .filter(function (text) { return text.length > 0; });

    if (!texts.length) return;
    copyReportContent(texts.join('\n----------------\n'));
    }

    function syncClearAllButton() {
    if (!clearAllBtn) return;

    var hasPosts = !!conversation.querySelector('.report-bubble-row');
    var canDelete = getEffectiveCanDelete();
    clearAllBtn.style.display = hasPosts && canDelete ? 'inline-flex' : 'none';
    syncCopyAllButton();
    }

    function showClearAllConfirm() {
    if (!clearAllConfirm) return;

    clearAllConfirm.classList.add('show');
    clearAllConfirm.setAttribute('aria-hidden', 'false');
    }

    function hideClearAllConfirm() {
    if (!clearAllConfirm) return;

    clearAllConfirm.classList.remove('show');
    clearAllConfirm.setAttribute('aria-hidden', 'true');
    }

    function deletePostById(postId) {
    var fd = new FormData();
    fd.append('id', postId);
    fd.append('type', postType);
    appendAntiforgery(fd);

    return fetch((postType === POST_TYPE_EDIT_NOTE && canFollowUpManageEditNotes) ? '/OrderPosts/DeleteEditNoteWithHistory' : ((postType === POST_TYPE_PROBLEM && canSendProblemDeduction) ? '/OrderPosts/DeletePostWithHistory' : '/OrderPosts/Delete'), {
    method: 'POST',
    body: fd,
    credentials: 'same-origin'
    }).then(function (r) {
    if (!r.ok) throw new Error('HTTP ' + r.status);
    });
    }

    function deleteAllLoadedPosts() {
    var rows = Array.from(conversation.querySelectorAll('.report-bubble-row'));
    var ids = rows.map(function (row) {
    return parseInt(row.getAttribute('data-post-id'), 10);
    }).filter(function (id) {
    return !!id;
    });

    if (!ids.length) {
    hideClearAllConfirm();
    syncClearAllButton();
    return;
    }

    var okBtn = clearAllConfirm ? clearAllConfirm.querySelector('.reports-clear-all-confirm-ok') : null;
    var cancelBtn = clearAllConfirm ? clearAllConfirm.querySelector('.reports-clear-all-confirm-cancel') : null;

    if (okBtn) okBtn.disabled = true;
    if (cancelBtn) cancelBtn.disabled = true;

    Promise.all(ids.map(deletePostById))
    .then(function () {
    hideClearAllConfirm();
    conversation.innerHTML = '';
    if (emptyState) emptyState.style.display = 'block';
    syncClearAllButton();

    if (typeof refreshPanels === 'function') refreshPanels();
    if (currentOrderId && typeof refreshOrderHeaderCounts === 'function') refreshOrderHeaderCounts(currentOrderId);
    })
    .catch(function (err) {
    console.error('OrderPosts.DeleteAll loaded posts failed:', err);
    alert('تعذر مسح الجميع');
    })
    .finally(function () {
    if (okBtn) okBtn.disabled = false;
    if (cancelBtn) cancelBtn.disabled = false;
    });
    }

    if (clearAllBtn) {
    clearAllBtn.addEventListener('click', function () {
    showClearAllConfirm();
    });
    }

    if (clearAllConfirm) {
    clearAllConfirm.querySelector('.reports-clear-all-confirm-ok').addEventListener('click', deleteAllLoadedPosts);
    clearAllConfirm.querySelector('.reports-clear-all-confirm-cancel').addEventListener('click', hideClearAllConfirm);
    clearAllConfirm.querySelector('.reports-clear-all-confirm-close').addEventListener('click', hideClearAllConfirm);
    clearAllConfirm.addEventListener('click', function (event) {
    if (event.target === clearAllConfirm) {
    hideClearAllConfirm();
    }
    });
    }

    function syncPreviewVisibility() {
    attachPreview.style.display = attachPreview.children.length ? 'flex' : 'none';
    }

    // Render a single image file as a removable thumbnail in the preview strip.
    function addImageFile(file) {
    if (!file || !file.type || !file.type.startsWith('image/')) return;
    pendingFiles.push(file);
    var fileRef = file;
    var reader = new FileReader();
    reader.onload = function (e) {
    var thumb = document.createElement('div');
    thumb.className = 'attach-thumb';
    var img = document.createElement('img');
    img.src = e.target.result;
    var rm = document.createElement('button');
    rm.type = 'button';
    rm.className = 'attach-thumb-remove';
    rm.textContent = '×';
    rm.addEventListener('click', function () {
    var idx = pendingFiles.indexOf(fileRef);
    if (idx > -1) pendingFiles.splice(idx, 1);
    thumb.remove();
    syncPreviewVisibility();
    });
    thumb.appendChild(img);
    thumb.appendChild(rm);
    attachPreview.appendChild(thumb);
    syncPreviewVisibility();
    };
    reader.readAsDataURL(file);
    }

    attachInput.addEventListener('change', function () {
    Array.from(attachInput.files || []).forEach(addImageFile);
    attachInput.value = '';
    });

    // Submit button color toggles to #eb981a when textarea has any non-empty text.
    var syncSubmitState = function () {
    submitBtn.classList.toggle('has-text', textInput.value.trim().length > 0);
    };
    textInput.addEventListener('input', syncSubmitState);

    // Enter sends; Shift+Enter inserts a newline.
    textInput.addEventListener('keydown', function (e) {
    if (e.key === 'Enter' && !e.shiftKey && !e.ctrlKey && !e.altKey && !e.metaKey) {
    e.preventDefault();
    if (!submitBtn.disabled) submitBtn.click();
    }
    });

    // Paste-image-into-textarea: clipboard images are intercepted and added to the preview;
    // typed/pasted text passes through to the textarea normally. Mirrors _CreateOrder.cshtml's pattern.
    textInput.addEventListener('paste', function (e) {
    var items = e.clipboardData && e.clipboardData.items;
    if (!items) return;
    var handled = false;
    for (var i = 0; i < items.length; i++) {
    if (items[i].kind === 'file' && items[i].type.indexOf('image/') === 0) {
    var file = items[i].getAsFile();
    if (file) {
    addImageFile(file);
    handled = true;
    }
    }
    }
    if (handled) e.preventDefault();
    });

    function clearComposer() {
    textInput.value = '';
    pendingFiles = [];
    attachPreview.innerHTML = '';
    syncPreviewVisibility();
    syncSubmitState();
