    if ($('#debugQueryWrapper').length) {
    var debugText = $(result).find('#debugQueryWrapper pre').text();
    console.log("[DEBUG] Response SQL query:", debugText || "(no debug query in response)");
    }

    const $ajaxResult = $('<div>').append($.parseHTML(result, document, true));
    const $newTable = $ajaxResult.find('#ordersTable').first();

    if ($newTable.length) {
    if ($('.table-responsive > #ordersTable').length) {
    $('.table-responsive > #ordersTable').replaceWith($newTable.prop('outerHTML'));
    } else if ($('.table-responsive > .table').length) {
