    function showModalSearchLoading(message) {
    closeSplitCardChildModals();

    orderDetailsBody.classList.add('modal-multi-results-active');
    orderDetailsModalEl.classList.add('modal-multi-mode');

    orderDetailsBody.innerHTML = `
    <div class="modal-search-main-loader">
    <div class="modal-search-spinner"></div>
    <div class="modal-search-loader-text">${message || 'جاري تحميل الطلبات...'}</div>
    </div>`;
    }

    function getModalSearchOrderId(item) {
    if (!item) return null;
    return item.id || item.Id || item.orderId || item.OrderId || null;
    }

    function showModalSearchError(message) {
    orderDetailsBody.classList.remove('modal-multi-results-active');
    orderDetailsModalEl.classList.remove('modal-multi-mode');

    orderDetailsBody.innerHTML = `
    <div class="text-center text-muted py-5">
    <p class="fw-bold text-danger mb-2">${message || 'تعذر تحميل تفاصيل الطلب'}</p>
    </div>`;
    }

    function modalSearchEscapeHtml(value) {
    return String(value || '')
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#039;');
    }

    function getModalSearchAntiForgeryToken() {
    const token = document.querySelector('#investigationAntiForgeryForm input[name="__RequestVerificationToken"]')
    || document.querySelector('input[name="__RequestVerificationToken"]');
    return token ? token.value : '';
    }

    function setModalSearchInvestigationCount(value) {
    const count = Math.max(0, Number(value || 0));
    const total = document.getElementById('investigationPageTotal');
    if (total) {
    total.textContent = String(count);
    }

    try {
    localStorage.setItem('luxiraInvestigationOrdersRemainingCount', String(count));
    localStorage.setItem('luxiraInvestigationOrdersRemainingCountUpdatedAt', String(Date.now()));
    } catch { }
    }

    function approveModalSearchInvestigationOrder(orderId) {
    return fetch('/Home/ApproveNewOrderInvestigation?orderId=' + encodeURIComponent(orderId), {
    method: 'POST',
    credentials: 'same-origin',
    headers: {
    'Accept': 'application/json',
    'RequestVerificationToken': getModalSearchAntiForgeryToken()
    }
    })
    .then(function (response) {
    if (!response.ok) {
    throw new Error('HTTP ' + response.status);
    }
    return response.json();
    })
    .then(function (result) {
    if (!result || !result.success) {
    throw new Error(result && result.message ? result.message : 'حصل خطأ أثناء التحقق من الطلب');
    }
    return result;
    });
    }

    function findModalSearchOrderEntryHeader(detailsRoot) {
    if (!detailsRoot) return null;

    const employeeName = detailsRoot.querySelector('#orderDetails_employeeName');
    if (employeeName) return employeeName.closest('h6') || employeeName.closest('.row') || employeeName.parentElement;

    const employeeImage = detailsRoot.querySelector('#orderDetails_employeeImage');
    if (employeeImage) return employeeImage.closest('h6') || employeeImage.closest('.row') || employeeImage.parentElement;

    const defaultEmployeeImage = detailsRoot.querySelector('#orderDetails_employeeImage_default');
    if (defaultEmployeeImage) return defaultEmployeeImage.closest('h6') || defaultEmployeeImage.closest('.row') || defaultEmployeeImage.parentElement;

    const headers = detailsRoot.querySelectorAll('h6, h5, dt, div, span, strong');
    for (let i = 0; i < headers.length; i++) {
    if ((headers[i].textContent || '').includes('مدخل الطلب')) {
    return headers[i].closest('h6') || headers[i].closest('.row') || headers[i];
    }
    }

    return null;
    }

    function injectModalSearchApprovedBanner(orderId, approvedBy) {
    const detailsRoot = orderDetailsBody.querySelector('.order-details-partial') || orderDetailsBody;

    // الكول سنتر لا يظهر له أي رسالة اعتماد أو تحقق داخل تفاصيل الطلب.
    const isModalSearchCallCenter = @User.IsInRole("CallCenter").ToString().ToLowerInvariant();
    if (isModalSearchCallCenter) {
    if (detailsRoot) {
    detailsRoot.querySelectorAll('[data-investigation-approved-banner="true"], .investigation-approved-banner, [data-investigation-inline-approve="true"], .investigation-inline-approve-btn').forEach(function (el) {
    el.remove();
    });
    }
    return;
    }

    if (!detailsRoot || detailsRoot.querySelector('[data-investigation-approved-banner="true"]')) {
    return;
    }

    const banner = ''
    + '<div class="investigation-approved-banner" data-investigation-approved-banner="true">'
    + '<span class="investigation-approved-check">✓</span>'
    + '<span>تم اعتماد الطلب بواسطة ' + modalSearchEscapeHtml(approvedBy || 'غير معروف') + '</span>'
    + '</div>';

    const orderEntryHeader = findModalSearchOrderEntryHeader(detailsRoot);
    if (orderEntryHeader) {
    orderEntryHeader.insertAdjacentHTML('beforebegin', banner);
    return;
    }

    detailsRoot.insertAdjacentHTML('afterbegin', banner);
    }

    function loadSingleModalSearchOrder(orderId, foundCount) {
    if (!orderId) {
    showModalSearchError('رقم الطلب غير صحيح');
    return;
    }

    closeSplitCardChildModals();

    orderDetailsModalEl.dataset.searchMode = 'single';
    orderDetailsModalEl.dataset.orderId = orderId;
    orderDetailsModalEl.dataset.initialOrderId = orderId;
    orderDetailsModalEl.classList.remove('modal-multi-mode');
    orderDetailsBody.classList.remove('modal-multi-results-active');

    orderDetailsBody.innerHTML = `
    <div class="d-flex justify-content-center align-items-center" style="height: 60vh;" id="orderDetailsSpinner">
    <div class="spinner-border text-success" role="status"></div>
    </div>`;

    fetch('/Order/DetailsPartial/' + encodeURIComponent(orderId), {
    credentials: 'same-origin',
    headers: { 'X-Requested-With': 'XMLHttpRequest' },
    cache: 'no-store'
    })
    .then(function (response) {
    if (!response.ok) {
    throw new Error('HTTP ' + response.status);
    }
    return response.text();
    })
    .then(function (html) {
    if (String(orderDetailsModalEl.dataset.orderId) !== String(orderId)) {
    return;
    }

    window.destroyOrderDetails(orderDetailsBody);
    injectPartialHtml(orderDetailsBody, html);
    window.initOrderDetails(orderDetailsBody);
    enhanceOrderDetailsMetaContact(orderDetailsBody, orderId);
    hideOrderDetailsDeliveryDropdownIfSingle(orderDetailsBody, orderId);

    // مهم: البحث داخل بوب تفاصيل الطلب لا يعتمد الطلب تلقائيًا.
    // زر "تم الاعتماد" سيظهر لنفس أدوار قيد التحقق من سكريبت الاعتماد العام.
    showModalSearchFoundPopup(foundCount || 1);
    })
    .catch(function (error) {
    console.error('loadSingleModalSearchOrder failed:', error);
    showModalSearchError(error && error.message ? error.message : 'تم العثور على الطلب لكن تعذر تحميل التفاصيل');
    });
    }

    function runSearch(term) {
    const mySeq = ++reqSeq;

    showModalSearchLoading('جاري البحث وتحميل الطلبات...');

    if (activeModalSearchRequest && activeModalSearchRequest.readyState !== 4) {
    activeModalSearchRequest.abort();
    }

    activeModalSearchRequest = $.ajax({
    url: '/Home/SearchOrders',
    type: 'GET',
    dataType: 'json',
    data: { search: term, limit: 100 },
    success: function (data) {
    if (mySeq !== reqSeq) return;
    if (!bootstrap.Modal.getInstance(modalEl)) return;

    console.log('[modalSearch] response:', data);

    const count = data && typeof data.count === 'number' ? data.count : 0;
    const results = (data && data.results) || [];

    if (count === 0) {
    closeModalSearchFoundPopup();

    orderDetailsBody.classList.remove('modal-multi-results-active');
    orderDetailsModalEl.classList.remove('modal-multi-mode');
    orderDetailsBody.innerHTML = `
    <div class="text-center text-muted py-5">
    <p class="fw-bold mb-0">لا توجد نتائج</p>
    </div>`;
    return;
    }

    const normalizedResults = (typeof window.renderModalMultiOrderResults === 'function') ? results : [];

    if (count === 1 && results.length === 1) {
    const firstId = getModalSearchOrderId(results[0]);
    console.log('[modalSearch] opening id:', firstId);
    if (!firstId) { setStatus('نتيجة غير صالحة'); return; }
    setStatus('');
    loadSingleModalSearchOrder(firstId, count);
    return;
    }

    if (results.length > 1) {
    setStatus('');
    window.renderModalMultiOrderResults(normalizedResults);
    showModalSearchFoundPopup(count);
    return;
    }

    if (results.length === 1) {
    const onlyId = getModalSearchOrderId(results[0]);
    if (!onlyId) { setStatus('نتيجة غير صالحة'); return; }
    setStatus('');
    loadSingleModalSearchOrder(onlyId, count);
    return;
    }

    if (count > 0) {
    showModalSearchError('تم العثور على نتيجة لكن لم يتم إرسال بيانات الطلب من السيرفر');
    setStatus('النتيجة غير قابلة للعرض');
    return;
    }

    closeModalSearchFoundPopup();
    setStatus('لا توجد نتائج قابلة للعرض');
    },
    error: function (xhr, statusText) {
    if (statusText === 'abort') return;
    if (mySeq !== reqSeq) return;
    closeModalSearchFoundPopup();
    setStatus('فشل البحث');
    orderDetailsBody.innerHTML = `
    <div class="text-center text-muted py-5">
    <p class="fw-bold text-danger mb-2">فشل تحميل نتائج البحث</p>
    <button type="button" class="btn btn-outline-success btn-sm" onclick="document.getElementById('modalSearchInput').dispatchEvent(new Event('input'))">
    إعادة المحاولة
    </button>
    </div>`;
    }
    });
    }

    input.addEventListener('input', function () {
    toggleClear();
    clearTimeout(timer);
    const term = input.value.trim();
    if (term.length < 2) {
    setStatus('');
    closeSplitCardChildModals();
    return;
    }
    timer = setTimeout(function () { runSearch(term); }, 80);
    });

    clear.addEventListener('click', function () {
    input.value = '';
    closeModalSearchFoundPopup();
    setStatus('');
    toggleClear();
    clearTimeout(timer);
    reqSeq++;

    closeSplitCardChildModals();

    if (activeModalSearchRequest && activeModalSearchRequest.readyState !== 4) {
    activeModalSearchRequest.abort();
    }
    if (modalEl.dataset.searchMode === 'multi' && typeof window.restoreInitialModalOrder === 'function') {
    window.restoreInitialModalOrder();
    }
    input.focus();
    });

    modalEl.addEventListener('hidden.bs.modal', function () {
    input.value = '';
    closeModalSearchFoundPopup();
    setStatus('');
    toggleClear();
    clearTimeout(timer);
    reqSeq++;

    closeSplitCardChildModals();

    if (activeModalSearchRequest && activeModalSearchRequest.readyState !== 4) {
    activeModalSearchRequest.abort();
    }
    if (modalMultiOrderObserver) {
    modalMultiOrderObserver.disconnect();
    modalMultiOrderObserver = null;
    }
    modalEl.dataset.searchMode = 'single';
    });

