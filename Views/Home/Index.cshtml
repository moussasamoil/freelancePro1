    function deletePost(btn, row) {
    var postId = parseInt(btn.getAttribute('data-post-id'), 10);
    if (!postId) return;
    btn.disabled = true;
    var fd = new FormData();
    fd.append('id', postId);
    fd.append('type', postType);
