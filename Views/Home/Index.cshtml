<script id="split-history-close-header-shift-last-fix-script">
    (function () {
    function closeHistoryPopupFromCard(card, event) {
    if (!card) return false;

    var popup = card.querySelector('.split-card-edit-history-popup');

    if (!popup) return false;

    if (event) {
    event.preventDefault();
    event.stopPropagation();

    if (typeof event.stopImmediatePropagation === 'function') {
    event.stopImmediatePropagation();
    }
    }

    popup.remove();
    card.classList.remove('has-inline-edit-history');

    return true;
    }

    function closeHistoryPopupFromButton(button, event) {
    if (!button) return false;

    var popup = button.closest('.split-card-edit-history-popup');

    if (!popup) return false;

    if (event) {
    event.preventDefault();
    event.stopPropagation();

    if (typeof event.stopImmediatePropagation === 'function') {
    event.stopImmediatePropagation();
    }
    }

    button.removeAttribute('data-bs-dismiss');
    button.removeAttribute('data-bs-toggle');
    button.removeAttribute('data-bs-target');

    var card = popup.closest('.modal-multi-order-card');

    popup.remove();

    if (card) {
    card.classList.remove('has-inline-edit-history');
    }

    return true;
    }

    /*
    Use pointerdown/mousedown/click in capture phase.
    This prevents Bootstrap's data-bs-dismiss and the original card-close handler
    from closing the whole order modal when history is open.
    */
    ['pointerdown', 'mousedown', 'click'].forEach(function (eventName) {
    document.addEventListener(eventName, function (event) {
    var historyBackBtn = event.target && event.target.closest
    ? event.target.closest('#modalMultiOrderGrid .split-card-edit-history-popup .edit-history-back-btn, #modalMultiOrderGrid .split-card-edit-history-popup [data-split-edit-history-close]')
    : null;

    if (historyBackBtn && closeHistoryPopupFromButton(historyBackBtn, event)) {
    return;
    }

    var headerBackBtn = event.target && event.target.closest
    ? event.target.closest('#modalMultiOrderGrid [data-modal-card-action="close"]')
    : null;

    if (!headerBackBtn) return;

    var card = headerBackBtn.closest('.modal-multi-order-card');

    closeHistoryPopupFromCard(card, event);
    }, true);
    });

    document.addEventListener('keydown', function (event) {
    if (event.key !== 'Escape') return;

    var popup = document.querySelector('#modalMultiOrderGrid .split-card-edit-history-popup');

    if (!popup) return;

    var card = popup.closest('.modal-multi-order-card');

    closeHistoryPopupFromCard(card, event);
    }, true);

    /*
    Safety layer after edit history content is rendered:
    remove Bootstrap modal-dismiss attributes from the inline panel back button.
    */
    if (window.MutationObserver) {
    var observer = new MutationObserver(function () {
    document.querySelectorAll('#modalMultiOrderGrid .split-card-edit-history-popup .edit-history-back-btn').forEach(function (btn) {
    btn.removeAttribute('data-bs-dismiss');
    btn.removeAttribute('data-bs-toggle');
    btn.removeAttribute('data-bs-target');
    btn.setAttribute('data-split-edit-history-close', 'true');
    });
    });

    observer.observe(document.body, { childList: true, subtree: true });
    }
    })();
</script>
