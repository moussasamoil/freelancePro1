    return;
    }

    historyBody.innerHTML = items.map(function (item) {
    if (item.kind === 'deduction') {
    var employeeName = escapeHtml(item.employeeName || 'غير معروف');
    var amount = escapeHtml(formatMoneyValue(item.amount));
    var orderTotal = escapeHtml(formatMoneyValue(item.orderTotal));
    var reason = escapeHtml(item.reason || '');
    var createdBy = escapeHtml(item.createdByName || 'غير معروف');
    var createdAtDeduction = escapeHtml(formatDateTime(item.createdAt));
    return '<div class="reports-deduction-history-row">' +
    '<div class="reports-deduction-history-title">خصم على الموظف: ' + employeeName + '</div>' +
