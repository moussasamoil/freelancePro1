    var doc = new DOMParser().parseFromString(html, 'text/html');
    var options = [];

    function pushOption(statusValue, display) {
    statusValue = (statusValue || '').trim();
    display = normalizeText(display || '').replace(/\s+/g, ' ');
    if (!statusValue) return;
    if (statusValue.indexOf(' ') > -1 && statusValue.indexOf('_') === -1) return;
    if (!options.some(function (x) { return x.value === statusValue; })) {
    options.push({ value: statusValue, text: display || statusValue.replace(/_/g, ' ') });
    }
    }

    doc.querySelectorAll(
    '[aria-labelledby="dropdownMenuButton1"] a.dropdown-item,' +
    '#dropdownMenuButton1 + ul a.dropdown-item,' +
    '#dropdownMenuButton1 ~ .dropdown-menu a.dropdown-item,' +
    '[onclick*="updateStatus"],' +
    'a[href*="updateStatus"],' +
    'button[data-status],' +
    'a[data-status]'
    ).forEach(function (el) {
    var statusValue = el.getAttribute('data-status') || '';
    var script = el.getAttribute('onclick') || el.getAttribute('href') || '';
    if (!statusValue && script) {
    var matches = Array.from(script.matchAll(/['"]([^'"]+)['"]/g)).map(function (m) { return m[1]; });
    statusValue = matches.find(function (value) {
    return value && value.indexOf('_') > -1 && !/^https?:/i.test(value);
    }) || '';
    }
    pushOption(statusValue, el.textContent);
    });

