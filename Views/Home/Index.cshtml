    /* ================== GUARANTEED BACKGROUND TAB OPEN BRIDGE ==================
    للتشغيل بنسبة مضمونة: ثبتي Tampermonkey userscript المرفق.
    هذا الكود يرسل طلب فتح الرابط للـ userscript، وهو يفتح التاب بـ active:false.
    لو userscript غير موجود، يعمل fallback عادي داخل المتصفح.
    */
    const LX_BACKGROUND_TAB_MAX_OPEN = 3;
    const LX_BACKGROUND_TAB_ACK_TIMEOUT = 350;
    window.__luxiraOpenTabRequests = window.__luxiraOpenTabRequests || {};
    window.__luxiraLocalMetaTabs = window.__luxiraLocalMetaTabs || [];
    window.__luxiraLocalWhatsAppTabs = window.__luxiraLocalWhatsAppTabs || [];

    function luxiraRandomId() {
    try {
    const arr = new Uint32Array(2);
    crypto.getRandomValues(arr);
    return 'lx-' + Date.now() + '-' + arr[0].toString(16) + '-' + arr[1].toString(16);
    } catch {
    return 'lx-' + Date.now() + '-' + Math.random().toString(16).slice(2);
    }
    }

    function luxiraTabLooksClosed(tab) {
    try {
    if (!tab) return true;
    if (typeof tab.closed === 'boolean') return tab.closed;
    } catch { }
    return false;
    }

    function luxiraCleanupLocalTabs(list) {
    for (let i = list.length - 1; i >= 0; i--) {
    if (!list[i] || luxiraTabLooksClosed(list[i])) {
    list.splice(i, 1);
    }
    }
    }

    function luxiraCloseLocalTabSafe(tab) {
    try {
    if (tab && typeof tab.close === 'function') {
    tab.close();
    }
    } catch { }
    }

    function luxiraEnsureLocalTabRoom(list) {
    luxiraCleanupLocalTabs(list);
    while (list.length >= LX_BACKGROUND_TAB_MAX_OPEN) {
    const oldTab = list.shift();
    luxiraCloseLocalTabSafe(oldTab);
    }
    }

    function luxiraFallbackOpenTab(url, contactType) {
    const cleanUrl = String(url || '').trim();
    if (!cleanUrl) return false;

    const tabList = contactType === 'WhatsApp'
    ? window.__luxiraLocalWhatsAppTabs
    : window.__luxiraLocalMetaTabs;

    luxiraEnsureLocalTabRoom(tabList);

    try {
    const opened = window.open(cleanUrl, '_blank', 'noopener,noreferrer');
    if (!opened) return false;

    tabList.push(opened);

    try { opened.opener = null; } catch { }

    setTimeout(function () {
    try { opened.blur(); } catch { }
    try { window.focus(); } catch { }
    }, 20);

    setTimeout(function () {
    try { opened.blur(); } catch { }
    try { window.focus(); } catch { }
    }, 120);

    setTimeout(function () {
    try { window.focus(); } catch { }
    }, 300);

    return true;
    } catch {
    try {
    const link = document.createElement('a');
    link.href = cleanUrl;
    link.target = '_blank';
    link.rel = 'noopener noreferrer';
    link.style.display = 'none';
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);

    setTimeout(function () {
    try { window.focus(); } catch { }
    }, 80);

    return true;
    } catch {
    return false;
    }
    }
    }

    window.addEventListener('message', function (event) {
    if (event.source !== window) return;

    const data = event.data || {};
    if (!data || data.type !== 'LUXIRA_BACKGROUND_TAB_OPENED_ACK' || !data.requestId) return;

    const pending = window.__luxiraOpenTabRequests[data.requestId];
    if (!pending) return;

    pending.acked = true;
    delete window.__luxiraOpenTabRequests[data.requestId];
    });

    function openRecordedMetaUrl(url) {
    const cleanUrl = String(url || '').trim();
    if (!cleanUrl) return;

    const contactType = pendingContactType === 'WhatsApp' ? 'WhatsApp' : 'Meta';
    const requestId = luxiraRandomId();

    window.__luxiraOpenTabRequests[requestId] = {
    acked: false,
    url: cleanUrl,
    contactType: contactType
    };

    try {
    window.postMessage({
    type: 'LUXIRA_OPEN_BACKGROUND_TAB_REQUEST',
    requestId: requestId,
    url: cleanUrl,
    contactType: contactType
    }, window.location.origin || '*');
    } catch { }

    setTimeout(function () {
    const pending = window.__luxiraOpenTabRequests[requestId];

    if (!pending) {
    try { window.focus(); } catch { }
    return;
    }

    delete window.__luxiraOpenTabRequests[requestId];

    // Fallback لو Tampermonkey مش متثبت أو مش شغال.
    luxiraFallbackOpenTab(cleanUrl, contactType);
    }, LX_BACKGROUND_TAB_ACK_TIMEOUT);

    setTimeout(function () {
    try { window.focus(); } catch { }
    }, 80);
    }

    function confirmMetaAction() {
    if (!pendingMetaHref || !pendingMetaOrderId || !pendingMetaAnchor) {
    showMetaError('لم يتم التعرف على الرابط.');
    return;
    }

    const reason = getSelectedReason();
    const otherText = otherInput ? otherInput.value.trim() : '';

    if (!reason) {
    showMetaError('اختاري سبب فتح الرابط.');
    return;
    }

    if (reason === 'أخرى' && !otherText) {
    showMetaError('اكتبي السبب في خانة أخرى.');
    if (otherInput) otherInput.focus();
    return;
    }

    if (confirmBtn) {
    confirmBtn.disabled = true;
    confirmBtn.innerText = 'جاري التسجيل...';
    }

    let openedWindow = null;

    fetch(saveUrl, {
    method: 'POST',
    headers: {
    'Content-Type': 'application/json',
    'RequestVerificationToken': getAntiForgeryToken(),
    'Accept': 'application/json'
    },
    body: JSON.stringify({
    orderId: Number(pendingMetaOrderId),
    reason: reason,
    otherText: otherText,
    url: pendingMetaHref,
    contactType: pendingContactType
    })
    })
    .then(function (response) {
    return response.json();
    })
    .then(function (result) {
    if (!result || !result.success) {
    if (openedWindow && !openedWindow.closed) {
    openedWindow.close();
    }

    throw new Error(result && result.message ? result.message : 'حصل خطأ أثناء تسجيل سبب فتح الرابط.');
    }

    if (canSeeMetaHistory && result.item) {
    if (result.item.orderId) {
    window.luxiraContactActionSummaryByOrderId[String(result.item.orderId)] = result.item;
    }

    updateMetaSummaryForOrder(result.item.orderId, result.item);
    reasonStatsLoaded = false;
    loadReasonStats(true);
    }

    const hrefToOpen = pendingMetaHref;

    closeMetaModal();

    openRecordedMetaUrl(hrefToOpen);
    })
    .catch(function (error) {
    showMetaError(error && error.message ? error.message : 'حصل خطأ أثناء تسجيل سبب فتح الرابط.');

    if (confirmBtn) {
    confirmBtn.disabled = false;
    confirmBtn.innerText = 'موافقة';
    }
    });
    }

    document.addEventListener('click', function (event) {
    const anchor = event.target.closest(getContactActionSelector());

    if (!anchor) return;

    // في حساب شركة التوصيل أو المندوب: صف المراسلة واتساب فقط ويفتح مباشرة بدون بوب أب السبب.
    if (shouldOpenContactLinkDirectly(anchor)) {
    return;
    }

    event.preventDefault();
    event.stopPropagation();

    if (typeof event.stopImmediatePropagation === 'function') {
    event.stopImmediatePropagation();
    }

    openMetaModal(anchor);
    }, true);

    document.addEventListener('change', function (event) {
    const radio = event.target.closest('input[name="luxiraMetaReason"]');

    if (!radio) return;

    const isOther = radio.value === 'أخرى';

    if (otherInput) {
    otherInput.disabled = !isOther;

    if (isOther) {
    otherInput.focus();
    } else {
    otherInput.value = '';
    }
    }

    showMetaError('');
    }, true);

    if (confirmBtn) {
    confirmBtn.addEventListener('click', function (event) {
    event.preventDefault();
    confirmMetaAction();
    });
    }

    if (cancelBtn) {
    cancelBtn.addEventListener('click', function (event) {
    event.preventDefault();
    closeMetaModal();
    });
    }

    if (globalHistoryBtn) {
    globalHistoryBtn.addEventListener('click', function (event) {
    event.preventDefault();
    event.stopPropagation();
    openGlobalHistoryModal();
    });
    }

    if (globalHistoryCloseBtn) {
    globalHistoryCloseBtn.addEventListener('click', function (event) {
    event.preventDefault();
    closeGlobalHistoryModal();
    });
    }

    if (reasonDetailsBackBtn) {
    reasonDetailsBackBtn.addEventListener('click', function (event) {
    event.preventDefault();
    event.stopPropagation();
    closeReasonDetailsPanel();
    });
    }

    document.addEventListener('click', function (event) {
    const trigger = event.target.closest('.luxira-meta-reason-stats-trigger');
    if (!trigger || !modal || !modal.contains(trigger) || !canSeeMetaHistory) return;

    event.preventDefault();
    event.stopPropagation();
    if (typeof event.stopImmediatePropagation === 'function') {
    event.stopImmediatePropagation();
    }

    openReasonDetailsPanelFromTrigger(trigger);
    }, true);

    if (modal) {
    modal.addEventListener('click', function (event) {
    if (event.target === modal) {
    closeMetaModal();
    }
    });
    }

    if (globalHistoryModal) {
    globalHistoryModal.addEventListener('click', function (event) {
    if (event.target === globalHistoryModal) {
    closeGlobalHistoryModal();
    }
    });
    }

    document.addEventListener('keydown', function (event) {
    if (event.key !== 'Escape') return;

    if (globalHistoryModal && globalHistoryModal.style.display === 'flex') {
    event.preventDefault();
    closeGlobalHistoryModal();
    return;
    }

    if (modal && modal.style.display === 'flex') {
    event.preventDefault();
    closeMetaModal();
    }
    }, true);

    if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', scheduleLoadMetaSummaries);
    } else {
    scheduleLoadMetaSummaries();
    }

    window.addEventListener('load', function () {
    scheduleLoadMetaSummaries();
    loadReasonStats(false);
    });

    if (window.jQuery) {
    $(document).ajaxSuccess(scheduleLoadMetaSummaries);
    }

    if (window.MutationObserver) {
    const tableObserver = new MutationObserver(function () {
    scheduleLoadMetaSummaries();
    });

    tableObserver.observe(document.body, {
    childList: true,
    subtree: true
    });
    }
    })();
</script>


