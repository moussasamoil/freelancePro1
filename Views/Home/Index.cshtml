<script id="split-edit-history-close-and-card-header-final-script">
    (function () {
    function closeInlineEditHistory(closeBtn, event) {
    var popup = closeBtn && closeBtn.closest
    ? closeBtn.closest('#modalMultiOrderGrid .split-card-edit-history-popup')
    : null;

    if (!popup) return false;

    if (event) {
    event.preventDefault();
    event.stopPropagation();

    if (typeof event.stopImmediatePropagation === 'function') {
    event.stopImmediatePropagation();
    }
    }

    var card = popup.closest('.modal-multi-order-card');

    popup.remove();

    if (card) {
    card.classList.remove('has-inline-edit-history');
    }

    return true;
    }

    /*
    Capture phase is intentional:
    the button HTML contains data-bs-dismiss="modal" because the same shell is used
    in the normal details modal. Inside split cards we intercept it before Bootstrap
    receives the click, so it closes only the inline history panel.
    */
    document.addEventListener('click', function (event) {
    var closeBtn = event.target && event.target.closest
    ? event.target.closest('#modalMultiOrderGrid .split-card-edit-history-popup .edit-history-back-btn, #modalMultiOrderGrid .split-card-edit-history-popup [data-split-edit-history-close]')
    : null;

    if (!closeBtn) return;

    closeInlineEditHistory(closeBtn, event);
    }, true);

    document.addEventListener('keydown', function (event) {
    if (event.key !== 'Escape') return;

    var popup = document.querySelector('#modalMultiOrderGrid .split-card-edit-history-popup');
    if (!popup) return;

    var closeBtn = popup.querySelector('.edit-history-back-btn') || popup;
    closeInlineEditHistory(closeBtn, event);
    }, true);
    })();
</script>

