    function toInlineAsciiDigits(value) {
    return String(value || '')
    .replace(/[٠-٩]/g, function (d) { return String('٠١٢٣٤٥٦٧٨٩'.indexOf(d)); })
    .replace(/[۰-۹]/g, function (d) { return String('۰۱۲۳۴۵۶۷۸۹'.indexOf(d)); });
    }

    function padInlineManualDatePart(value) {
    value = parseInt(value, 10);
    return value < 10 ? '0' + value : String(value);
    }

    function normalizeInlineManualDate(value) {
    if (!value) return '';

    var raw = toInlineAsciiDigits(value)
    .trim()
    .replace(/\u200f|\u200e/g, '')
    .replace(/[\/.]/g, '-')
    .replace(/\s+/g, ' ')
    .replace('T', ' ');

    if (!raw) return '';

    var match;
    var year, month, day, hour, minute, second;

    // yyyy-mm-dd  HH:mm
    match = raw.match(/^(\d{4})-(\d{1,2})-(\d{1,2})(?:\s+(\d{1,2})(?::(\d{1,2}))?(?::(\d{1,2}))?)?$/);
    if (match) {
    year = match[1];
    month = match[2];
    day = match[3];
    hour = match[4] || '12';
    minute = match[5] || '00';
    second = match[6] || '00';
    } else {
    // dd-mm-yyyy  HH:mm
    match = raw.match(/^(\d{1,2})-(\d{1,2})-(\d{4})(?:\s+(\d{1,2})(?::(\d{1,2}))?(?::(\d{1,2}))?)?$/);
    if (!match) return '';

    day = match[1];
    month = match[2];
    year = match[3];
    hour = match[4] || '12';
    minute = match[5] || '00';
    second = match[6] || '00';
    }

    var normalized =
    year + '-' +
    padInlineManualDatePart(month) + '-' +
    padInlineManualDatePart(day) + 'T' +
    padInlineManualDatePart(hour) + ':' +
    padInlineManualDatePart(minute) + ':' +
    padInlineManualDatePart(second);

    var d = new Date(normalized);
    if (isNaN(d.getTime())) return '';

    return normalized;
    }

