    const globalHistoryModal = document.getElementById('luxiraMetaActionGlobalHistoryModal');
    const globalHistoryCloseBtn = document.getElementById('luxiraMetaActionGlobalHistoryClose');
    const globalHistoryBody = document.getElementById('luxiraMetaActionGlobalHistoryBody');
