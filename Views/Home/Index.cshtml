        + '</div>';
        }

        function buildAdminApproveButton(orderId) {
        return ''
        + '<button type="button" '
        + 'class="investigation-inline-approve-btn" '
        + 'data-investigation-inline-approve="true" '
        + 'data-order-id="' + escapeHtml(orderId) + '">'
        + 'تم الاعتماد'
        + '</button>';
        }

        function findOrderEntryHeader(detailsRoot) {
        if (!detailsRoot) {
        return null;
        }

        let employeeName = detailsRoot.querySelector('#orderDetails_employeeName');
        if (employeeName) {
        return employeeName.closest('h6') || employeeName.closest('.row') || employeeName.parentElement;
        }

        let employeeImage = detailsRoot.querySelector('#orderDetails_employeeImage');
        if (employeeImage) {
        return employeeImage.closest('h6') || employeeImage.closest('.row') || employeeImage.parentElement;
        }

        let defaultEmployeeImage = detailsRoot.querySelector('#orderDetails_employeeImage_default');
        if (defaultEmployeeImage) {
        return defaultEmployeeImage.closest('h6') || defaultEmployeeImage.closest('.row') || defaultEmployeeImage.parentElement;
        }

        const headers = detailsRoot.querySelectorAll('h6, h5, dt, div, span, strong');
        for (let i = 0; i < headers.length; i++) {
        if ((headers[i].textContent || '').includes('مدخل الطلب')) {
        return headers[i].closest('h6') || headers[i].closest('.row') || headers[i];
        }
        }

        return null;
        }

        function removeOldApproveUi(detailsRoot) {
        if (!detailsRoot) {
        return;
        }

        // لو في بانر قديم ظهر قبل الضغط، أخفيه للأدمن واستبدله بالزر.
        if (isInvestigationAdmin && !orderDetailsModalEl.dataset.investigationApprovedOrderId) {
        detailsRoot.querySelectorAll('[data-investigation-approved-banner="true"]').forEach(function (el) {
        el.remove();
        });
        }

        detailsRoot.querySelectorAll('[data-investigation-inline-approve="true"]').forEach(function (el, index) {
        if (index > 0) {
        el.remove();
        }
        });
        }

        function injectAdminApproveButtonIfNeeded() {
        if (!isInvestigationAdmin || !hasLoadedOrderDetails()) {
        return;
        }

        const orderId = getCurrentModalOrderId();
        if (!orderId) {
        return;
        }

        // بعد الاعتماد يظهر البانر فقط، لا نعيد الزر.
        if (orderDetailsModalEl.dataset.investigationApprovedOrderId === String(orderId)) {
        injectApprovedBannerIfNeeded();
        return;
        }

        const detailsRoot = orderDetailsBody.querySelector('.order-details-partial');
        if (!detailsRoot) {
        return;
        }

        removeOldApproveUi(detailsRoot);

        if (detailsRoot.querySelector('[data-investigation-inline-approve="true"]')) {
        return;
        }

        const orderEntryHeader = findOrderEntryHeader(detailsRoot);

        if (orderEntryHeader) {
        orderEntryHeader.insertAdjacentHTML('beforebegin', buildAdminApproveButton(orderId));
        return;
        }

        detailsRoot.insertAdjacentHTML('afterbegin', buildAdminApproveButton(orderId));
        }

        function injectApprovedBannerIfNeeded() {
        removeCallCenterApprovalMessages();

        const orderId = orderDetailsModalEl.dataset.investigationApprovedOrderId;

        if (!orderId) {
        return;
        }

        // الكول سنتر لا يظهر له "تم الاعتماد من قبل"
        if (isInvestigationCallCenter) {
        return;
        }

        const detailsRoot = orderDetailsBody.querySelector('.order-details-partial');

        if (!detailsRoot) {
        return;
        }

        detailsRoot.querySelectorAll('[data-investigation-inline-approve="true"]').forEach(function (el) {
        el.remove();
        });

        if (detailsRoot.querySelector('[data-investigation-approved-banner="true"]')) {
        return;
        }

        const orderEntryHeader = findOrderEntryHeader(detailsRoot);

        if (orderEntryHeader) {
        orderEntryHeader.insertAdjacentHTML('beforebegin', buildApprovedBanner(orderId));
        return;
        }

        detailsRoot.insertAdjacentHTML('afterbegin', buildApprovedBanner(orderId));
        }

        function openDetails(orderId) {
        orderDetailsModalEl.dataset.investigationOpenedOrderId = orderId;

        // نحفظ أن الطلب اتفتح من صفحة قيد التحقق، عشان لو حالته اتغيرت يفضل ظاهر لحد تم الاعتماد.
        if (isInvestigationPageJs && isInvestigationAdmin && typeof window.markOrderOpenedFromInvestigationPage === 'function') {
        window.markOrderOpenedFromInvestigationPage(orderId);
        }

        if (typeof window.openOrderDetails === 'function') {
        window.openOrderDetails(orderId);
        } else {
        window.location.href = '/Order/Details/' + encodeURIComponent(orderId);
        }
        }

        function handleApprovedResult(orderId, result, removeRowNow) {
        approvedDataByOrderId[String(orderId)] = {
        approvedBy: result.approvedBy || 'غير معروف',
        remainingCount: result.remainingCount
        };

        orderDetailsModalEl.dataset.investigationApprovedOrderId = orderId;
        orderDetailsModalEl.dataset.investigationApprovedBy = result.approvedBy || 'غير معروف';
        orderDetailsModalEl.dataset.investigationRemainingCount = result.remainingCount;

        if (Number.isFinite(Number(result.remainingCount))) {
        setInvestigationCount(result.remainingCount);
        } else if (removeRowNow) {
        decreaseInvestigationCountByOne();
        }

        if (removeRowNow) {
        removeInvestigationRow(orderId);
        }
        }

        function markOpenedForCallCenterAndOpen(orderId, row) {
        if (row) {
        row.style.pointerEvents = 'none';
        row.style.opacity = '.65';
        }

        const markPromise = (typeof window.markOrderOpenedFromInvestigationPage === 'function')
        ? window.markOrderOpenedFromInvestigationPage(orderId)
        : Promise.resolve({ success: true });

        markPromise
        .then(function (result) {
        if (row) {
        row.style.pointerEvents = '';
        row.style.opacity = '';
        }

        if (result && Number.isFinite(Number(result.remainingCount))) {
        setInvestigationCount(result.remainingCount);
        } else {
        decreaseInvestigationCountByOne();
        }

        removeInvestigationRow(orderId);
        openDetails(orderId);
        })
        .catch(function (error) {
        if (row) {
        row.style.pointerEvents = '';
        row.style.opacity = '';
        }

        alert(error && error.message ? error.message : 'حصل خطأ أثناء فتح الطلب');
        });
        }

        function autoApproveLoadedOrderForCallCenter() {
        // تم إلغاء الاعتماد التلقائي للكول سنتر.
        // فتح الطلب يسجّل أنه اتفتح ويخفيه من جدول الموظف فقط، بدون إنشاء Approval.
        return;
        }

        function approveCurrentOrderForAdmin(button) {
        if (!isInvestigationAdmin) {
        return;
        }

        const orderId = getCurrentModalOrderId();

        if (!orderId) {
        return;
        }

        if (button) {
        button.disabled = true;
        button.textContent = 'جاري الاعتماد...';
        }

        approveOrder(orderId)
        .then(function (result) {
        handleApprovedResult(orderId, result, false);

        const detailsRoot = orderDetailsBody.querySelector('.order-details-partial');
        if (detailsRoot) {
        detailsRoot.querySelectorAll('[data-investigation-inline-approve="true"]').forEach(function (el) {
        el.remove();
        });
        }

        injectApprovedBannerIfNeeded();
        showInvestigationApprovalSuccessPopup();
        })
        .catch(function (error) {
        if (button) {
        button.disabled = false;
        button.textContent = 'تم الاعتماد';
        }

        alert(error && error.message ? error.message : 'حصل خطأ أثناء اعتماد الطلب');
        });
        }

        orderDetailsBody.addEventListener('click', function (event) {
        const button = event.target.closest('[data-investigation-inline-approve="true"]');

        if (!button) {
        return;
        }

        event.preventDefault();
        event.stopPropagation();

        approveCurrentOrderForAdmin(button);
        }, true);

        const bodyObserver = new MutationObserver(function () {
        updateDetailsHeaderVisibility();
        injectAdminApproveButtonIfNeeded();
        injectApprovedBannerIfNeeded();
        removeCallCenterApprovalMessages();
        autoApproveLoadedOrderForCallCenter();
        });

        bodyObserver.observe(orderDetailsBody, {
        childList: true,
        subtree: false
        });

        orderDetailsModalEl.addEventListener('show.bs.modal', function () {
        orderDetailsModalEl.classList.add('investigation-details-loading');
        orderDetailsModalEl.classList.remove('investigation-details-loaded');
        });

        orderDetailsModalEl.addEventListener('shown.bs.modal', function () {
        updateDetailsHeaderVisibility();
        injectAdminApproveButtonIfNeeded();
        injectApprovedBannerIfNeeded();
        removeCallCenterApprovalMessages();
        autoApproveLoadedOrderForCallCenter();
        });

        document.addEventListener('click', function (event) {
        if (!isInvestigationPageJs) {
        return;
        }

        const row = event.target.closest('#ordersTable tbody tr.order-details[data-order-id]');

        if (!row) {
        return;
        }

        if (event.target.closest('a, button, .btn, .fatura, .dropdown, .copyable, .order-row-actions-shell, .order-row-actions-cell')) {
        return;
        }

        event.preventDefault();
        event.stopPropagation();

        if (typeof event.stopImmediatePropagation === 'function') {
        event.stopImmediatePropagation();
        }

        const orderId = row.getAttribute('data-order-id');

        if (!orderId) {
        return;
        }

        orderDetailsModalEl.dataset.investigationOpenedOrderId = orderId;

        // Admin: يفتح فقط، والاعتماد من زر "تم الاعتماد" مكان العلامة الخضراء
        if (isInvestigationAdmin) {
        openDetails(orderId);
        return;
        }

        // CallCenter: يسجل أن الطلب اتفتح ويختفي من جدول الموظف فقط، بدون اعتماد.
        if (isInvestigationCallCenter) {
        markOpenedForCallCenterAndOpen(orderId, row);
        return;
        }

        // أي دور آخر يفتح التفاصيل فقط، ولا يعتمد إلا من زر تم الاعتماد.
        openDetails(orderId);
        }, true);

        orderDetailsModalEl.addEventListener('hidden.bs.modal', function () {
        const approvedOrderId = orderDetailsModalEl.dataset.investigationApprovedOrderId;

        if (isInvestigationPageJs && approvedOrderId && !isInvestigationCallCenter) {
        const remainingCount = orderDetailsModalEl.dataset.investigationRemainingCount;
        const removed = removeInvestigationRow(approvedOrderId);

        if (remainingCount !== undefined && remainingCount !== null && remainingCount !== '') {
        setInvestigationCount(remainingCount);
        } else if (removed) {
        decreaseInvestigationCountByOne();
        }
        }

        delete orderDetailsModalEl.dataset.investigationOpenedOrderId;
        delete orderDetailsModalEl.dataset.investigationApprovedOrderId;
        delete orderDetailsModalEl.dataset.investigationApprovedBy;
        delete orderDetailsModalEl.dataset.investigationRemainingCount;

        orderDetailsModalEl.classList.remove('investigation-details-loaded');
        orderDetailsModalEl.classList.remove('investigation-details-loading');
        });
        })();
    </script>
}

