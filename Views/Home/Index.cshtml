    $('#ordersTable tbody').empty();
    }

    $('#ordersTable').hide();
    }

    const $newPagination = $ajaxResult.find('#pagination-link .pagination').first();

    if ($newPagination.length) {
    $('#pagination-link .pagination').replaceWith($newPagination.prop('outerHTML'));
    $('#pagination-link .pagination').show();
    } else {
    $('#pagination-link .pagination').empty();
    }

    // CallCenter no-filter mode hides nav/total-items/page-size via inline display:none.
    // After AJAX, sync those inline styles from the server response so transitions in/out work.
    $('.nav-nav').attr('style', $ajaxResult.find('.nav-nav').attr('style') || '');
    const $newPageSizeWrap = $ajaxResult.find('#pageSize').closest('.form-group');
    $('#pageSize').closest('.form-group').attr('style', $newPageSizeWrap.attr('style') || '');

    // 1. Handle TotalOrderPrice (foreign currency)
    const totalOrderPriceElement = $ajaxResult.find('.TotalOrderPrice').closest('.custom-shadow');
