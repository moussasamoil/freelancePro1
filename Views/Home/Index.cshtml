<script id="split-card-top-order-badge-final-script">
    (function () {
    var badgeUpdateScheduled = false;
    var badgeObserver = null;

    function updateSplitCardBadgesNow() {
    badgeUpdateScheduled = false;

    var grid = document.getElementById('modalMultiOrderGrid');
    if (!grid) return;

    var cards = Array.from(grid.querySelectorAll('.modal-multi-order-card'));

    cards.forEach(function (card, index) {
    var badge = card.querySelector('.split-card-order-badge');

    if (!badge) {
    badge = document.createElement('div');
    badge.className = 'split-card-order-badge';
    badge.innerHTML = '<span class="label">طلب:</span><span class="num"></span>';
    card.appendChild(badge);
    }

    var num = badge.querySelector('.num');
    if (num) {
    num.textContent = String(index + 1);
    }
    });
    }

    function scheduleBadgeUpdate() {
    if (badgeUpdateScheduled) return;

    badgeUpdateScheduled = true;

    if (window.requestAnimationFrame) {
    window.requestAnimationFrame(updateSplitCardBadgesNow);
    } else {
    setTimeout(updateSplitCardBadgesNow, 0);
    }
    }

    function attachBadgeObserverToModalGrid() {
    var grid = document.getElementById('modalMultiOrderGrid');
    if (!grid || grid.__splitCardBadgeObserverAttached) return;

    grid.__splitCardBadgeObserverAttached = true;

    if (window.MutationObserver) {
    badgeObserver = new MutationObserver(function () {
    scheduleBadgeUpdate();
    });

    /*
    Important:
    Observe only the split-card modal grid, not the whole body.
    Observing the whole body was slowing/hanging Home search AJAX updates.
    */
    badgeObserver.observe(grid, {
    childList: true,
    subtree: true
    });
    }

    scheduleBadgeUpdate();
    }

    document.addEventListener('DOMContentLoaded', function () {
    attachBadgeObserverToModalGrid();
    scheduleBadgeUpdate();
    });

    window.addEventListener('resize', scheduleBadgeUpdate);

    document.addEventListener('click', function () {
    setTimeout(function () {
    attachBadgeObserverToModalGrid();
    scheduleBadgeUpdate();
    }, 0);
    setTimeout(scheduleBadgeUpdate, 120);
    }, true);

    attachBadgeObserverToModalGrid();
    scheduleBadgeUpdate();
    })();
</script>

