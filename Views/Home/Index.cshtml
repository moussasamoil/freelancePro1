    } else if (actionName === 'employee' || actionName === 'delivery') {
    $box = $target.closest('.dropdown, .custom-box-shadow, .flex-item-equal');
    } else {
    $box = $target.closest('.dropdown, .custom-box-shadow, .flex-item-equal');
