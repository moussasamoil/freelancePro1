    }
    <div class="custom-shadow ms-3">
    <span class="total-price-display-try text-green">
    ${$ajaxResult.find('.total-price-display-try').html()}
    </span>
    </div>
    <div class="custom-shadow">
    <span class="total-price-display-usd text-green">
    ${$ajaxResult.find('.total-price-display-usd').html()}
    </span>
    </div>
    </div>
    `;

    // Insert after the nav element
    $('.nav-nav').after(priceContainer);
    }

    const $newTotalItems = $ajaxResult.find('.total-items-display');
    console.log("New total items:", $newTotalItems.text());
    // Sync both text and inline style so the element shows/hides when transitioning
    // in or out of CallCenter no-filter mode.
    $('.total-items-display')
    .text($newTotalItems.text())
    .attr('style', $newTotalItems.attr('style') || '');

    if ($('#ordersTable tbody tr').length === 0) {
    console.log("No data - showing placeholder");
    $('#noDataPlaceholder').attr('style', 'height: 50vh !important;');
    $('#noorders').removeClass('hidden').addClass('visible');

    } else {
    $('#noDataPlaceholder').attr('style', 'display:none !important; height: 50vh !important;');
    $('#pagination-link').show();
    }

    // Update debug query panel if present
    var $newDebugWrapper = $ajaxResult.find('#debugQueryWrapper');
    if ($('#debugQueryWrapper').length) {
    if ($newDebugWrapper.length) {
    $('#debugQueryWrapper').replaceWith($newDebugWrapper);
    } else {
