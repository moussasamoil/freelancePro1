    conversation.addEventListener('click', function (e) {
    var bodyForCopy = e.target.closest('.report-bubble-body');

    if (bodyForCopy && !bodyForCopy.closest('.report-bubble-row.editing')) {
    e.preventDefault();
    e.stopPropagation();
    copyReportContent(bodyForCopy.getAttribute('data-raw-body') || bodyForCopy.textContent || '');
    return;
    }

    var delPostBtn = e.target.closest('.reports-delete-post-btn');
    if (delPostBtn) {
    if (deleteConfirm) {
    pendingDeleteBtn = delPostBtn;
    pendingDeleteRow = delPostBtn.closest('.report-bubble-row');
    deleteConfirm.style.display = 'flex';
    } else {
    deletePost(delPostBtn, delPostBtn.closest('.report-bubble-row'));
