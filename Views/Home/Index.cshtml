<script async>

    var isAdminorExcutiveDirector = @Html.Raw(isAdminorExcutiveDirector.ToString().ToLower());
    var isDeliveryRole = @Html.Raw(isDeliveryRole.ToString().ToLower());
    var initialcountry = '@Html.Raw(initialCountry)'; // Ensure this is treated as a string
    console.log(isAdminorExcutiveDirector + "not admin");

    var selectedCountry = $('#CountryId').val() || null;


    $(document).ready(function () {
    // Adding a 2-second delay before calling all the functions
    setTimeout(function () {
    fetchDataByCountry();
    fetchDataByEmployeeFinancial();
    fetchDataByMyExistingsEmployee();
    fetchDataByCountry();
    fetchDataByEmployeeFinancial();
    fetchLast10operations();
    fetchLast10operationsEmployee();
    fetchmypayments();
    FetchOnGoingAccount();
    }, 2000); // 2 seconds delay before all calls
    });


    // حساباتي لشركات التوصيل والمندوبين
    function FetchOnGoingAccount() {
    // مدفوعاتي
    $.ajax({
    url: '/ApiCollectionJson/OnGoingAccountDeliveryCompany',
    type: 'GET',

    success: function (data) {
    appendDatapaymentsOnGoing(data);

    },
    error: function (error) {
    console.log("Error fetching data:", error);
    }
    });
    }

    // append حساباتي لشركات التوصيل
    function appendDatapaymentsOnGoing(data) {
    var container = $('#DeliveryOptionsSelect');
    container.empty(); // Clear previous data

    data.forEach(function (item) {

    var div = $(
    `<div class="row drop-down-design" value="">
    <div class="col text-end">${item.deliveryCompany.name}</div>
    <div class="col text-start ps-0 pe-0">
    <span style="font-size:26px !important;">${item.onGoingAccountDeliveryCompanyPrice}</span>
    <span  style="font-size:10px;">${item.currency}  </span>

    <i class="fa-duotone fa-chevron-left"></i>

    <span   style="font-size:11px; display: block; padding-left:8px;">    الحساب الجاري </span>
    </div>

    </div>`
    );

    container.append(div);
    });
    }


    //  مدفوعاتي لشركات التوصيل والمندوبين
    function fetchmypayments() {
    // مدفوعاتي
    $.ajax({
    url: '/ApiCollectionJson/PaidAccountsDeliveryCompany',
    type: 'GET',
    success: function (data) {
    appendDatapayments(data);

    },
    error: function (error) {
    console.log("Error fetching data:", error);
    }
    });
    }


    // append مدفوعاتي لشركات التوصيل والمندوبين
    function appendDatapayments(data) {
    var container = $('#MyAccountPaymentsselect');
    container.empty(); // Clear previous data

    data.forEach(function (item) {

    var div = $(
    `<div class="row drop-down-design" value="">
    <div class="col text-end">${item.deliveryCompany.name}</div>
    <div class="col text-start ps-0 pe-0">
    <span style="font-size:26px !important;">${item.paidOrdersDeliveryCompanyPrice}</span>
    <span  style="font-size:10px;">${item.currency}  </span>

    <i class="fa-duotone fa-chevron-left"></i>

    <span   style="font-size:11px; display: block; padding-left:8px;">    الحساب المدفوع </span>
    </div>

    </div>`
    );

    container.append(div);
    });
    }

    // حساباتي ومودواتي  للادمن
    function fetchDataByCountry() {

    // AJAX request with countryId as a parameter
    $.ajax({
    url: '/ApiCollectionJson/OrderByCountry',
    type: 'GET',
    data: { countryId: selectedCountry }, // Pass countryId as a parameter
    success: function (data) {
    appendDataExistings(data);
    appendData(data);
    },
    error: function (error) {
    console.log("Error fetching data:", error);
    }
    });
    }

    // حساباتي للموظفين
    function fetchDataByEmployeeFinancial() {
    $.ajax({
    url: '/ApiCollectionJson/CalculateAdjustedSalary',
    type: 'GET',
    success: function (data) {
    appendDataFinancialEmployee(data);
    },
    error: function (error) {
    console.log("Error fetching data:", error);
    }
    });

    }

    // موجوداتي للموظفين
    function fetchDataByMyExistingsEmployee() {
    // موجوداتي
    $.ajax({
    url: '/ApiCollectionJson/ExistingsForEmployess',
    type: 'GET',
    success: function (data) {
    appendDataExistingsEmployee(data);
    },
    error: function (error) {
    console.log("Error fetching data:", error);
    }
    });

    }

    // اخر 10 عمليات ادمن شركات توصيل مندوبين
    function fetchLast10operations() {
    $.ajax({
    url: '/ApiCollectionJson/GetOrderReports',
    type: 'GET',
    success: function (data) {
    appendLast10Reports(data); // Use the appendLast10Reports function
    },
    error: function (error) {
    console.log("Error fetching data:", error);
    }
    });
    }

    // اخر 10 عمليات موظفين
    function fetchLast10operationsEmployee() {
    $.ajax({
    url: '/ApiCollectionJson/Last10EmployeeTransactions',
    type: 'GET',
    success: function (data) {
    appendLast10ReportsEmployee(data); // Use the appendLast10Reports function
    },
    error: function (error) {
    console.log("Error fetching data:", error);
    }
    });
    }

    // Append last 10 reports
    // اخر 10 عمليات للادمن شركات التوصيل المندوبين
    function appendLast10Reports(data) {
    var container = $('#Last10operationsOptionsselect');
    container.empty(); // Clear previous data

    data.forEach(function (item) {
    var totalPrice = item.totalAmount;
    var currency = totalPrice.split(" ")[0];
    var amount = totalPrice.split(" ")[1];

    var div = $(
    `<div class="row mt-0 py-2" style="border-bottom: 1px solid rgba(143, 142, 142, 0.318);" data-order-id="${item.id}">

