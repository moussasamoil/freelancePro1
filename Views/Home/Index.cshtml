    if (toggle) {
    toggle.classList.remove('show');
    toggle.setAttribute('aria-expanded', 'false');
    }

    if (menu) {
    menu.classList.remove('show');
    menu.style.display = '';
    menu.style.visibility = '';
    menu.style.opacity = '';
    }
    }

    function closeAllDropdownsExcept(exceptDropdown) {
    doc.querySelectorAll('.order-details-partial .dropdown').forEach(function (dropdown) {
    if (exceptDropdown && dropdown === exceptDropdown) return;
    var menu = dropdown.querySelector('.dropdown-menu, .dropdown-menu-employees, .dropdown-menu-ispaid');
    var toggle = getToggleForDropdown(dropdown);
    if ((menu && menu.classList.contains('show')) || dropdown.classList.contains('show') || (toggle && toggle.classList.contains('show'))) {
    forceCloseDropdown(dropdown);
    }
    });
    }

    iframe.__closeOrderCardDropdowns = function () {
    closeAllDropdownsExcept(null);
    };

    doc.addEventListener('show.bs.dropdown', function (event) {
    var dropdown = event.target && event.target.closest ? event.target.closest('.dropdown') : null;

    /*
    Close dropdowns in all other cards first, then keep only
    the current dropdown open in this card.
    */
    closeDropdownsInAllCards(iframe);
    closeAllDropdownsExcept(dropdown);
    }, true);

    doc.addEventListener('shown.bs.dropdown', function (event) {
    var dropdown = event.target && event.target.closest ? event.target.closest('.dropdown') : null;
    closeDropdownsInAllCards(iframe);
    closeAllDropdownsExcept(dropdown);
    }, true);

    doc.addEventListener('click', function (event) {
    var clickedDropdown = event.target && event.target.closest ? event.target.closest('.dropdown') : null;
    var clickedMenuItem = event.target && event.target.closest ? event.target.closest('.dropdown-item') : null;

    if (!clickedDropdown) {
    closeAllDropdownsExcept(null);
    return;
    }

    if (clickedMenuItem) {
    setTimeout(function () {
    closeAllDropdownsExcept(null);
    }, 60);
    }
    }, true);

    doc.addEventListener('keydown', function (event) {
    if (event.key === 'Escape') {
    closeAllDropdownsExcept(null);
    }
    }, true);
    }

    function closeDropdownsInAllCards(exceptIframe) {
    document.querySelectorAll('#modalMultiOrderGrid .modal-multi-order-frame-wrap iframe').forEach(function (iframe) {
    if (exceptIframe && iframe === exceptIframe) return;

    if (typeof iframe.__closeOrderCardDropdowns === 'function') {
    iframe.__closeOrderCardDropdowns();
    return;
    }

    try {
    if (iframe.contentWindow) {
    iframe.contentWindow.postMessage({ type: 'close-order-card-dropdowns' }, '*');
    }
    } catch (e) { }
    });
    }

    function scanIframes() {
    document.querySelectorAll('#modalMultiOrderGrid .modal-multi-order-frame-wrap iframe').forEach(installSingleDropdownBehavior);
    }

    document.addEventListener('load', function (event) {
    if (event.target && event.target.matches && event.target.matches('#modalMultiOrderGrid .modal-multi-order-frame-wrap iframe')) {
    setTimeout(function () { installSingleDropdownBehavior(event.target); }, 0);
    setTimeout(function () { installSingleDropdownBehavior(event.target); }, 120);
    }
    }, true);

    /*
    Click anywhere outside the card iframe closes every card dropdown.
    This covers clicks in the Home page, modal background, headers,
    and other cards.
    */
    document.addEventListener('mousedown', function (event) {
    var insideCardFrame = event.target && event.target.closest
    ? event.target.closest('#modalMultiOrderGrid .modal-multi-order-frame-wrap iframe')
    : null;

    if (!insideCardFrame) {
    closeDropdownsInAllCards(null);
    }
    }, true);

    document.addEventListener('click', function (event) {
    var insideCardFrame = event.target && event.target.closest
    ? event.target.closest('#modalMultiOrderGrid .modal-multi-order-frame-wrap iframe')
    : null;

    if (!insideCardFrame) {
    closeDropdownsInAllCards(null);
    }

    setTimeout(scanIframes, 80);
    }, true);

    document.addEventListener('keydown', function (event) {
    if (event.key === 'Escape') {
    closeDropdownsInAllCards(null);
    }
    }, true);

    if (window.MutationObserver) {
    var observer = new MutationObserver(scanIframes);
    observer.observe(document.body, { childList: true, subtree: true });
    }

    scanIframes();
    setInterval(scanIframes, 500);
    })();
</script>

