    </style>

    <script id="callcenter-commission-script">
        (function () {
        const popup = document.getElementById('callCenterCommissionGiftPopup');
        const orderNode = document.getElementById('callCenterCommissionGiftOrderId');
        const shippingCodeNode = document.getElementById('callCenterCommissionGiftShippingCode');
        const closeBtn = document.getElementById('callCenterCommissionGiftClose');
        const confirmBtn = document.getElementById('callCenterCommissionGiftConfirm');
        const shownStoragePrefix = 'luxiraCallCenterCommissionGiftShown:';

        function showCommissionGiftPopup(orderId, shippingCode, markAsSeen) {
        if (!popup) return;

        const cleanOrderId = orderId || '';
        const cleanShippingCode = shippingCode || ('*' + cleanOrderId);

        if (orderNode) orderNode.textContent = cleanOrderId;
        if (shippingCodeNode) shippingCodeNode.textContent = cleanShippingCode;

        popup.style.display = 'flex';

        if (markAsSeen && cleanOrderId) {
        try {
        localStorage.setItem(shownStoragePrefix + cleanOrderId, '1');
        } catch { }
        }
        }

        function hideCommissionGiftPopup() {
        if (popup) {
        popup.style.display = 'none';
        }
        }

        document.addEventListener('click', function (event) {
        const badge = event.target.closest && event.target.closest('.callcenter-commission-badge');

        if (!badge) return;

        event.preventDefault();
        event.stopPropagation();

        if (badge.getAttribute('data-commission-state') !== 'due') {
        return;
        }

        showCommissionGiftPopup(
        badge.getAttribute('data-order-id') || '',
        badge.getAttribute('data-shipping-code') || '',
        true
        );
        }, true);

        if (closeBtn) closeBtn.addEventListener('click', hideCommissionGiftPopup);
        if (confirmBtn) confirmBtn.addEventListener('click', hideCommissionGiftPopup);
        if (popup) {
        popup.addEventListener('click', function (event) {
        if (event.target === popup) {
        hideCommissionGiftPopup();
        }
        });
        }

        function showFirstUnseenDueCommissionPopup() {
        const dueBadges = Array.from(document.querySelectorAll('.callcenter-commission-badge[data-commission-state="due"]'));

        for (const badge of dueBadges) {
        const orderId = badge.getAttribute('data-order-id') || '';
        if (!orderId) continue;

        try {
        if (localStorage.getItem(shownStoragePrefix + orderId) === '1') {
        continue;
        }
        } catch { }

        showCommissionGiftPopup(
        orderId,
        badge.getAttribute('data-shipping-code') || '',
        true
        );
        break;
        }
        }

        if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', function () {
        setTimeout(showFirstUnseenDueCommissionPopup, 450);
        });
        } else {
        setTimeout(showFirstUnseenDueCommissionPopup, 450);
        }

        const table = document.getElementById('ordersTable');
        if (table && window.MutationObserver) {
        const observer = new MutationObserver(function () {
        setTimeout(showFirstUnseenDueCommissionPopup, 250);
        });

        observer.observe(table, { childList: true, subtree: true });
        }
        })();
    </script>
}


