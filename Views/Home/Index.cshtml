    box-shadow: 0 1px 4px #d7a969;
    }

    /* Style for the dropdown */
    .dropdown-content {
    padding-left: 0 !important;
    padding-right: 0 !important;
    display: none;
    position: absolute;
    background-color: white;
    border: 1px solid #ccc;
    top: 29px;
    left: 5px;
    border-bottom: 1px solid #ccc; /* Add this line to make the border-bottom full width */
    max-height: 920px; /* Set the maximum height to 200px */
    width: 290px;
    overflow-y: auto; /* Add a vertical scrollbar when content exceeds the height */
    /* Style the scrollbar */
    direction: rtl; /* Reverse the direction to make it appear on the left */
    border-radius: 8px; /* Apply border radius of 8px to all corners */
    }


    .dropdown-content a {
    color: red !important;
    padding-left: 10px;
    padding-right: 10px
    }

    /* The .dropdown-content rule above forces all anchors inside header dropdowns to red.
    Lead contact buttons are anchors, so we restore their proper colors here. */
    .dropdown-content a.lead-contact-btn {
    color: #fff !important;
    }

    .custom-width {
    flex: 1 0 200px; /* Adjust the width as needed */
    }

    /* iPad/tablet (between md and lg-up): force 3 columns per row.
    Without this, .custom-width's flex-basis would let a 4th item wrap to a
    full-width row of its own, leaving an ugly stretched 4th cell. */
    @@media (min-width: 768px) and (max-width: 1199.98px) {
    .custom-width {
    flex: 0 0 calc(33.333% - 0.5rem);
    max-width: calc(33.333% - 0.5rem);
    }
    }

