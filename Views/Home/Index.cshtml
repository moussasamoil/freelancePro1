    function measureModalMultiOrderIframeContentHeight(doc, minHeight) {
    if (!doc || !doc.body || !doc.documentElement) return minHeight;

    const win = doc.defaultView || window;
    const ignoredSelector = [
    'script',
    'style',
    'link',
    'meta',
    'noscript',
    '.modal',
    '.modal-backdrop',
    '.toastify',
    '.toastify-center',
    '.dropdown-menu',
    '.ui-datepicker',
    '.flatpickr-calendar',
    '.select2-container',
    '[aria-hidden="true"]'
    ].join(',');

    const contentRoot = doc.querySelector('.order-details-partial:not(#orderDetailsSharedHeader)')
    || doc.querySelector('.order-details-partial')
    || doc.querySelector('#orderDetailsContent')
    || doc.querySelector('#orderDetailsContainer')
    || doc.querySelector('main')
    || doc.body;

    let maxBottom = 0;

    function isActuallyVisible(el) {
    if (!el || el.nodeType !== 1) return false;
    if (el.matches && el.matches(ignoredSelector)) return false;
    if (el.closest && el.closest(ignoredSelector)) return false;

    const style = win.getComputedStyle ? win.getComputedStyle(el) : null;
    if (!style) return false;
    if (style.display === 'none' || style.visibility === 'hidden') return false;
    if (style.position === 'fixed') return false;

    const rect = el.getBoundingClientRect();
    if (!rect) return false;
    if (rect.width <= 0 && rect.height <= 0) return false;

    return true;
    }

    function includeElement(el) {
    if (!isActuallyVisible(el)) return;

    const rect = el.getBoundingClientRect();
    const style = win.getComputedStyle(el);

    // Ignore off-screen helper layers that can falsely increase scrollHeight.
    if (rect.bottom < -20 || rect.top > 20000) return;

    const marginBottom = parseFloat(style.marginBottom || '0') || 0;
    maxBottom = Math.max(maxBottom, rect.bottom + marginBottom);
    }

    includeElement(contentRoot);
    contentRoot.querySelectorAll('*').forEach(includeElement);

    const bodyRect = doc.body.getBoundingClientRect();
    const bodyTop = bodyRect && isFinite(bodyRect.top) ? bodyRect.top : 0;
    let measured = Math.ceil(maxBottom - bodyTop + 10);

    if (!measured || measured < 1) {
    measured = Math.max(
    minHeight,
    doc.documentElement.clientHeight || 0,
    doc.body.clientHeight || 0
    );
    }

    return Math.max(minHeight, measured);
    }

    function fitModalMultiOrderIframe(iframe) {
    if (!iframe) return;

    const frameWrap = iframe.closest('.modal-multi-order-frame-wrap');
    if (!frameWrap) return;

    const availableWidth = Math.max(frameWrap.clientWidth || 0, 1);
    const availableHeight = Math.max(frameWrap.clientHeight || 0, 1);

    /*
    Keep the grey iframe scrollbar removed from the source, but do NOT
    depend on document scrollHeight because hidden modals / full-height
    helper layers can make it much taller than the real order data.
    We measure the visible content bottom instead, so the card scroll ends
    exactly at the last visible data row without extra empty space.
    */
    const designWidth = Math.max(880, availableWidth);
    const scale = Math.min(1, availableWidth / designWidth);
    const minUnscaledHeight = Math.max(Math.ceil(availableHeight / scale), 1);

    iframe.setAttribute('scrolling', 'no');
    iframe.style.width = designWidth + 'px';
    iframe.style.height = minUnscaledHeight + 'px';
    iframe.style.transform = 'scale(' + scale + ')';
    iframe.style.transformOrigin = 'top right';
    iframe.style.position = 'absolute';
    iframe.style.top = '0';
    iframe.style.right = '0';
    iframe.style.border = '0';
    iframe.style.background = '#ffffff';
    iframe.style.overflow = 'hidden';

    let contentHeight = minUnscaledHeight;

    try {
    const doc = iframe.contentDocument || (iframe.contentWindow && iframe.contentWindow.document);

    if (doc && doc.documentElement && doc.body) {
    doc.documentElement.style.overflowX = 'hidden';
    doc.documentElement.style.overflowY = 'hidden';
    doc.body.style.overflowX = 'hidden';
    doc.body.style.overflowY = 'hidden';
    doc.body.style.maxWidth = '100%';
    doc.body.style.minHeight = '0';
    ensureSplitOrderIframeStyles(doc);
    ensureSplitOrderDropdownLayerFix(doc);

    contentHeight = measureModalMultiOrderIframeContentHeight(doc, minUnscaledHeight);
    }
    } catch (e) {
    // Same-origin access can fail in rare browser cases; keep the safe fallback height.
    }

    let spacer = frameWrap.querySelector('.modal-multi-order-iframe-spacer');
    if (!spacer) {
    spacer = document.createElement('div');
    spacer.className = 'modal-multi-order-iframe-spacer';
    spacer.setAttribute('aria-hidden', 'true');
    frameWrap.insertBefore(spacer, iframe);
    }

    const scaledHeight = Math.max(Math.ceil(contentHeight * scale), availableHeight);

    iframe.style.height = Math.ceil(contentHeight) + 'px';

    spacer.style.display = 'block';
    spacer.style.width = '100%';
    spacer.style.height = scaledHeight + 'px';
    spacer.style.pointerEvents = 'none';
    spacer.style.visibility = 'hidden';

    frameWrap.style.overflowY = scaledHeight > availableHeight + 2 ? 'auto' : 'hidden';
    frameWrap.style.overflowX = 'hidden';
    }

    function setupModalMultiOrderIframeAutoResize(iframe) {
    if (!iframe || iframe.__modalMultiOrderAutoResizeReady) return;
    iframe.__modalMultiOrderAutoResizeReady = true;

    const refit = function () {
    fitModalMultiOrderIframe(iframe);
    injectSplitOrderSequenceIntoIframe(iframe);
    };

    try {
    const doc = iframe.contentDocument || (iframe.contentWindow && iframe.contentWindow.document);
    if (doc && doc.body && window.MutationObserver) {
    const observer = new MutationObserver(function () {
    window.requestAnimationFrame(refit);
