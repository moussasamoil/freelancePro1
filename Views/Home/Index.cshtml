<script id="home-split-card-no-overlay-popup-fallback-script">
    (function () {
    var activeCard = null;

    function setImportant(el, prop, value) {
    if (el && el.style) el.style.setProperty(prop, value, 'important');
    }

    function getCardRect(card) {
    if (!card || !card.getBoundingClientRect) return null;
    var rect = card.getBoundingClientRect();
    var vw = window.innerWidth || document.documentElement.clientWidth || 1200;
    var vh = window.innerHeight || document.documentElement.clientHeight || 800;

    var left = Math.max(rect.left, 8);
    var right = Math.min(rect.right, vw - 8);
    var top = Math.max(rect.top, 8);
    var bottom = Math.min(rect.bottom, vh - 8);

    return {
    left: left,
    top: top,
    width: Math.max(right - left, 260),
    height: Math.max(bottom - top, 220),
    centerX: left + Math.max(right - left, 260) / 2,
    centerY: top + Math.max(bottom - top, 220) / 2
    };
    }

    function styleHostAlert() {
    var alertEl = document.querySelector('body > .sweet-alert');
    var overlay = document.querySelector('body > .sweet-overlay');

    if (!activeCard || !document.body.contains(activeCard)) return;

    if (overlay) {
    overlay.style.setProperty('display', 'none', 'important');
    overlay.style.setProperty('visibility', 'hidden', 'important');
    overlay.style.setProperty('opacity', '0', 'important');
    overlay.style.setProperty('pointer-events', 'none', 'important');
    }

    if (!alertEl) return;

    var rect = getCardRect(activeCard);
    if (!rect) return;

    document.body.classList.add('split-card-alert-active');

    setImportant(alertEl, 'position', 'fixed');
    setImportant(alertEl, 'left', rect.centerX + 'px');
    setImportant(alertEl, 'top', rect.centerY + 'px');
    setImportant(alertEl, 'right', 'auto');
    setImportant(alertEl, 'bottom', 'auto');
    setImportant(alertEl, 'transform', 'translate(-50%, -50%)');
    setImportant(alertEl, 'margin', '0');
    setImportant(alertEl, 'width', Math.min(340, rect.width - 28) + 'px');
    setImportant(alertEl, 'max-width', (rect.width - 24) + 'px');
    setImportant(alertEl, 'overflow', 'visible');
    setImportant(alertEl, 'z-index', '2147483647');

    alertEl.querySelectorAll('h2, p, .lead, .swal-text, .swal-title').forEach(function (el) {
    setImportant(el, 'display', 'block');
    setImportant(el, 'visibility', 'visible');
    setImportant(el, 'opacity', '1');
    setImportant(el, 'white-space', 'normal');
    setImportant(el, 'word-break', 'normal');
    setImportant(el, 'overflow-wrap', 'break-word');
    setImportant(el, 'overflow', 'visible');
    setImportant(el, 'max-height', 'none');
    setImportant(el, 'line-height', '1.6');
    setImportant(el, 'text-align', 'center');
    });
    }

    function rememberCardFromIframe(iframe) {
    if (!iframe || !iframe.closest) return;
    var card = iframe.closest('.modal-multi-order-card');
    if (!card) return;

    activeCard = card;
    styleHostAlert();
    setTimeout(styleHostAlert, 0);
    setTimeout(styleHostAlert, 80);
    setTimeout(styleHostAlert, 200);
    }

    function installIntoIframe(iframe) {
    if (!iframe || iframe.__splitCardNoOverlayBound) return;

    var doc;
    try {
    doc = iframe.contentDocument || (iframe.contentWindow && iframe.contentWindow.document);
    } catch (e) {
    return;
    }

    if (!doc || !doc.body) return;
    iframe.__splitCardNoOverlayBound = true;

    doc.addEventListener('click', function () {
    rememberCardFromIframe(iframe);
    }, true);

    doc.addEventListener('mousedown', function () {
    rememberCardFromIframe(iframe);
    }, true);
    }

    function scan() {
    document.querySelectorAll('#modalMultiOrderGrid .modal-multi-order-frame-wrap iframe').forEach(installIntoIframe);
    styleHostAlert();
    }

    document.addEventListener('load', function (event) {
    if (event.target && event.target.matches && event.target.matches('#modalMultiOrderGrid .modal-multi-order-frame-wrap iframe')) {
    setTimeout(function () { installIntoIframe(event.target); }, 0);
    setTimeout(function () { installIntoIframe(event.target); }, 120);
    }
    }, true);

    document.addEventListener('scroll', styleHostAlert, true);
    window.addEventListener('resize', styleHostAlert);

    if (window.MutationObserver) {
    var observer = new MutationObserver(scan);
    observer.observe(document.body, { childList: true, subtree: true });
    }

    scan();
    setInterval(scan, 400);
    })();
</script>

