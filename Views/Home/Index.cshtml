<script>
    // Click-to-copy: toast + clipboard helper (ported from Order/Index.cshtml)
    function normalizeLibyaPhoneCopyText(text, fieldName, sourceElement) {
    var value = String(text == null ? '' : text).trim();
    var label = String(fieldName || '');

    if (!value || label.indexOf('الهاتف') === -1) {
    return value;
    }

    var countryName = '';
    try {
    var row = sourceElement && sourceElement.closest ? sourceElement.closest('[data-country-name]') : null;
    countryName = row && row.dataset ? (row.dataset.countryName || '') : '';
    } catch (error) {
    countryName = '';
    }

    var cleaned = value.replace(/[^\d+]/g, '');
    var isLibyaCountry = countryName === 'ليبيا' || countryName === 'Libya';
    var looksLikeLibyaNumber = /^(?:\+?218|00218)?0?9\d{7,9}$/.test(cleaned);

    if (!isLibyaCountry && !looksLikeLibyaNumber) {
    return value;
    }

    if (cleaned.indexOf('00218') === 0) {
    cleaned = cleaned.substring(5);
    } else if (cleaned.indexOf('+218') === 0) {
    cleaned = cleaned.substring(4);
    } else if (cleaned.indexOf('218') === 0) {
    cleaned = cleaned.substring(3);
    }

    if (cleaned.charAt(0) === '0') {
    cleaned = cleaned.substring(1);
    }

    return cleaned || value;
    }

    function copyToClipboard(text, fieldName, sourceElement) {
    if (text === undefined || text === null) return;
    text = normalizeLibyaPhoneCopyText(String(text), fieldName, sourceElement);
    if (!text || text === 'null') return;
    var showSuccess = function () {
    Toastify({
    text: "تم نسخ " + fieldName,
    duration: 2000,
    gravity: "bottom",
    position: "center",
    style: { background: "#2ab149", borderRadius: "8px", fontWeight: "bold" }
    }).showToast();
    };
    if (navigator.clipboard && navigator.clipboard.writeText) {
    navigator.clipboard.writeText(text).then(showSuccess);
    } else {
    var ta = document.createElement('textarea');
    ta.value = text;
    ta.style.position = 'fixed';
    ta.style.opacity = '0';
    document.body.appendChild(ta);
    ta.select();
    document.execCommand('copy');
    document.body.removeChild(ta);
    showSuccess();
    }
    }

    // Capture-phase delegation so row click handlers (which call openOrderDetails)
    // don't swallow the copy on cells that are both .copyable and inside .order-details.
    document.addEventListener('click', function (e) {
    var el = e.target.closest('.copyable');
    if (!el) return;

    // Important:
    // Order Details has its own copy handler and toast.
    // Do not handle clicks inside details here, otherwise the toast fires multiple times.
    if (el.closest('.order-details-partial')) {
    return;
    }

    e.preventDefault();
    e.stopPropagation();

    if (typeof e.stopImmediatePropagation === 'function') {
    e.stopImmediatePropagation();
    }

    var text = el.dataset.copyText;
    var label = el.dataset.copyLabel || '';
    if (text !== undefined && text !== null && String(text).length > 0) {
    copyToClipboard(text, label, el);
    }
    }, true);
</script>

