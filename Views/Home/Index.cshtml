    case 'postpone':
    return $cache.find('#dropdownMenuButtonPostpone').filter(function () { return !this.disabled; }).first();
    case 'status':
    return $cache.find('#dropdownMenuButton1').filter(function () { return !this.disabled; }).first();
    case 'employee':
    return $cache.find('#dropdownMenuButtonemployee').filter(function () { return !this.disabled; }).first();
    case 'delivery':
    return $cache.find('#dropdownMenuButtonDelivery').filter(function () { return !this.disabled; }).first();
    default:
