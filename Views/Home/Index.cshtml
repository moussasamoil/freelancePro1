    function formatMoneyValue(value) {
    var number = parseFloat(value || 0);
    if (!isFinite(number)) number = 0;
    return number.toFixed(2).replace(/\.00$/, '');
    }

    function openDeductionConfirm(body) {
    if (!deductionConfirm || !currentOrderId) return;
