    document.addEventListener('wheel', repositionAllSplitEditHistoryPopups, true);
    document.addEventListener('touchmove', repositionAllSplitEditHistoryPopups, true);

    window.openSplitCardEditHistory = function (orderId, card) {
    if (!orderId || !card) return;

    var popupId = 'splitEditHistoryPopup_' + orderId;
    var existing = document.getElementById(popupId);

    if (existing) {
    positionSplitEditHistoryPopup(existing, card);
