</script>


@section Scripts {
    <script async>
        // life time signal R
        function formatDate(dateString) {
        var date = new Date(dateString);
        var year = date.getFullYear();
        var month = ('0' + (date.getMonth() + 1)).slice(-2); // Month is 0-indexed
        var day = ('0' + date.getDate()).slice(-2);
        var hours = ('0' + date.getHours()).slice(-2);
        var minutes = ('0' + date.getMinutes()).slice(-2);

        return `${year}-${month}-${day} ${hours}:${minutes}`;
        }

        var isAdminorExcutiveDirector = @Html.Raw(Json.Serialize(User.IsInRole("Admin") || User.IsInRole("ExecutiveDirector")));
        var isDelivery = @Html.Raw(Json.Serialize(User.IsInRole("DeliveryCompany") || User.IsInRole("DeliveryRepresentative")));
        var isCallCenterJs = @Html.Raw(Json.Serialize(User.IsInRole("CallCenter")));
        var isFollowUpDepartmentJs = @Html.Raw(Json.Serialize(User.IsInRole("FollowUpDepartment")));
        var canSeeSalesIndicatorMiniJs = @Html.Raw(Json.Serialize(User.IsInRole("Admin") || User.IsInRole("ExecutiveDirector") || User.IsInRole("FollowUpDepartment")));
        var canUseInlineOrderAdminActionsJs = @Html.Raw(Json.Serialize(User.IsInRole("Admin") || User.IsInRole("ExecutiveDirector") || User.IsInRole("CallCenter") || User.IsInRole("FollowUpDepartment")));
        var canUseInlinePaymentActionJs = @Html.Raw(Json.Serialize(User.IsInRole("Admin") || User.IsInRole("ExecutiveDirector") || User.IsInRole("CallCenter") || User.IsInRole("FollowUpDepartment")));
        var canUseInlineDeliveryStatusActionJs = @Html.Raw(Json.Serialize(User.IsInRole("DeliveryCompany") || User.IsInRole("DeliveryRepresentative")));
        var canUseInlineAssignEmployeeActionJs = @Html.Raw(Json.Serialize(User.IsInRole("Admin") || User.IsInRole("ExecutiveDirector")));
        var canUseInlineAssignDeliveryActionJs = canUseInlineOrderAdminActionsJs;
        var canUseInlineProcessedActionJs = canUseInlineOrderAdminActionsJs;
        var showInlineCallCenterTempDeliveryActionJs = isCallCenterJs;
        var showInlineResendOrderActionJs = isCallCenterJs;
        var phoneCodesByCountry = @Html.Raw(Json.Serialize(Common.PhoneNumberCodesByCountry.ToDictionary(kv => kv.Key.ToString(), kv => kv.Value)));
        var stripCountryCodeCountries = ['البحرين', 'الكويت', 'سلطنة_عمان', 'قطر'];

        function normalizePhoneForDisplay(raw, countryName) {
        if (!raw) return '';
        var cleaned = String(raw).replace(/[-\s]/g, '');
        if (!cleaned) return '';
        var code = phoneCodesByCountry[countryName];
        if (!code) return cleaned;
        var digits = code.replace(/^\+/, '');
        if (cleaned.indexOf('00' + digits) === 0) return '+' + cleaned.substring(2);
        if (cleaned.indexOf('+' + digits) === 0) return cleaned;
        if (cleaned.charAt(0) === '0') return '+' + digits + cleaned.substring(1);
        return '+' + digits + cleaned;
        }

        function stripCountryCodeAndLeadingZero(raw, countryName) {
        if (!raw) return '';
        var cleaned = String(raw).replace(/[-\s]/g, '');
        if (!cleaned) return '';
        var code = phoneCodesByCountry[countryName];
        var digits = code ? code.replace(/^\+/, '') : '';
        if (digits) {
        if (cleaned.indexOf('00' + digits) === 0) cleaned = cleaned.substring(2 + digits.length);
        else if (cleaned.indexOf('+' + digits) === 0) cleaned = cleaned.substring(1 + digits.length);
        }
        if (cleaned.charAt(0) === '0') cleaned = cleaned.substring(1);
        return cleaned;
        }

        function phoneForDisplay(raw, countryName) {
        return stripCountryCodeCountries.indexOf(countryName) >= 0
        ? stripCountryCodeAndLeadingZero(raw, countryName)
        : normalizePhoneForDisplay(raw, countryName);
        }

        function phoneForCopy(raw, countryName) {
        return countryName === 'ليبيا'
        ? stripCountryCodeAndLeadingZero(raw, countryName)
        : phoneForDisplay(raw, countryName);
        }


        function getInlineOrderStatusText(order) {
        if (!order) return '';

        var candidates = [
        order.OrderStatusString,
        order.orderStatusString,
        order.OrderStatusText,
        order.orderStatusText,
        order.OrderStatus,
        order.orderStatus,
        order.Status,
        order.status
        ];

        for (var i = 0; i < candidates.length; i++) {
        if (candidates[i] !== undefined && candidates[i] !== null && String(candidates[i]).trim() !== '') {
        return String(candidates[i]).trim().replace(/\s+/g, '_');
        }
        }

        return '';
        }

        function inlineStatusIsOneOf(statusText, lockedStatuses) {
        statusText = String(statusText || '').trim().replace(/\s+/g, '_');
        return lockedStatuses.indexOf(statusText) >= 0;
        }

        function inlineStatusIsFailureStatus(statusText) {
        return inlineStatusIsOneOf(statusText, [
        'فشل_التسليم',
        'فشل_التسليم_2',
        'فشل_التسليم_3',
        'فشل_التسليم_4',
        'فشل_التسليم_5',
        'فشل_التسليم_6',
        'فشل_التسليم_7'
        ]);
        }

        function pushInlineDirectStatusButton(buttons, orderId, statusValue, statusText, extraClass) {
        buttons.push('<button type="button" class="order-table-action-btn ' + (extraClass || 'order-table-action-status-direct') + '" data-order-table-action="status-direct" data-order-id="' + escapeInlineHtml(orderId) + '" data-status-value="' + escapeInlineHtml(statusValue) + '" data-status-text="' + escapeInlineHtml(statusText) + '" onclick="event.stopPropagation();" onmousedown="event.stopPropagation();">' + escapeInlineHtml(statusText) + '</button>');
        }

        function renderInlineOrderActionsCell(orderOrId) {
        var order = (typeof orderOrId === 'object' && orderOrId !== null) ? orderOrId : null;
        var orderId = order ? (order.Id || order.id) : orderOrId;
        var orderStatusText = getInlineOrderStatusText(order);
        var buttons = [];
        var inlineCountryId = order ? (order.CountryId || order.countryId || order.CountryID || order.countryID || order.Country || order.country || order.CountryString || order.countryString || '') : '';
        var inlineCityText = order ? (order.State || order.state || order.City || order.city || '') : '';

        // Same external permissions as the details page:
        // CallCenter must NOT see edit when the order is already prepared / in delivery / delivered / balance updated / paid.
        var editLockedForCallCenterJs = isCallCenterJs && inlineStatusIsOneOf(orderStatusText, [
        'تم_التجهيز',
        'قيد_التوصيل',
        'تم_التسليم',
        'تم_تحديث_الرصيد',
        'تم_الدفع'
        ]);

        var editLockedForFollowUpJs = isFollowUpDepartmentJs && inlineStatusIsOneOf(orderStatusText, [
        'تم_التسليم',
        'تم_تحديث_الرصيد',
        'تم_الدفع'
        ]);

        var canShowEditActionJs = canUseInlineOrderAdminActionsJs
        && !editLockedForCallCenterJs
        && !editLockedForFollowUpJs;

        if (canUseInlineAssignEmployeeActionJs) {
        buttons.push('<button type="button" class="order-table-action-btn order-table-action-employee" data-order-table-action="employee" data-order-id="' + escapeInlineHtml(orderId) + '" onclick="event.stopPropagation();" onmousedown="event.stopPropagation();">تعيين موظف</button>');
        }

        if (canUseInlineAssignDeliveryActionJs) {
        buttons.push('<button type="button" class="order-table-action-btn order-table-action-delivery" data-order-table-action="delivery" data-order-id="' + escapeInlineHtml(orderId) + '" data-country-id="' + escapeInlineHtml(inlineCountryId) + '" data-city="' + escapeInlineHtml(inlineCityText) + '" data-delivery-db-pending="1" style="display:none;" onclick="event.stopPropagation();" onmousedown="event.stopPropagation();">تعيين شركة توصيل</button>');
        }

        if (canUseInlineProcessedActionJs) {
        buttons.push('<button type="button" class="order-table-action-btn order-table-action-processed" data-order-table-action="processed" data-order-id="' + escapeInlineHtml(orderId) + '" onclick="event.stopPropagation();" onmousedown="event.stopPropagation();">تم المعالجة</button>');
        }

        if (canShowEditActionJs) {
        buttons.push('<button type="button" class="order-table-action-btn order-table-action-edit" data-order-table-action="edit" data-order-id="' + orderId + '" onclick="event.stopPropagation();" onmousedown="event.stopPropagation();">تعديل طلب</button>');
        }

        if (canUseInlinePaymentActionJs) {
        buttons.push('<button type="button" class="order-table-action-btn order-table-action-payment" data-order-table-action="payment" data-order-id="' + orderId + '" onclick="event.stopPropagation();" onmousedown="event.stopPropagation();">حالة دفع</button>');
        }

        if (canUseInlineOrderAdminActionsJs) {
        buttons.push('<button type="button" class="order-table-action-btn order-table-action-cancel" data-order-table-action="cancel" data-order-id="' + orderId + '" onclick="event.stopPropagation();" onmousedown="event.stopPropagation();">إلغاء طلب</button>');
        buttons.push('<button type="button" class="order-table-action-btn order-table-action-postpone" data-order-table-action="postpone" data-order-id="' + orderId + '" onclick="event.stopPropagation();" onmousedown="event.stopPropagation();">تأجيل طلب</button>');
        }

        if (showInlineCallCenterTempDeliveryActionJs) {
        pushInlineDirectStatusButton(buttons, orderId, 'تم_التسليم_المؤقت', 'تسليم مؤقت', 'order-table-action-temporary-delivered');
        }

        if (showInlineResendOrderActionJs) {
        buttons.push('<button type="button" class="order-table-action-btn order-table-action-resend" data-order-table-action="resend" data-order-id="' + escapeInlineHtml(orderId) + '" onclick="event.stopPropagation();" onmousedown="event.stopPropagation();">إعادة إرسال الطلب</button>');
        }

        if (canUseInlineOrderAdminActionsJs && !isCallCenterJs) {
        buttons.push('<button type="button" class="order-table-action-btn order-table-action-status" data-order-table-action="status" data-order-id="' + escapeInlineHtml(orderId) + '" onclick="event.stopPropagation();" onmousedown="event.stopPropagation();">حالة طلب</button>');
        } else if (canUseInlineDeliveryStatusActionJs) {
        var inlineDeliveryIsDeliveredJs = inlineStatusIsOneOf(orderStatusText, ['تم_التسليم']);
        var inlineDeliveryIsFailureJs = inlineStatusIsFailureStatus(orderStatusText);
        var inlineDeliveryCanMoveToInDeliveryJs = inlineStatusIsOneOf(orderStatusText, ['تم_التجهيز']);

        if (inlineDeliveryIsDeliveredJs) {
        buttons.push('<button type="button" class="order-table-action-btn order-table-action-delivered is-disabled" disabled onclick="event.stopPropagation();" onmousedown="event.stopPropagation();">تم التسليم</button>');
        } else if (inlineDeliveryIsFailureJs) {
        pushInlineDirectStatusButton(buttons, orderId, 'تم_التسليم', 'تم التسليم', 'order-table-action-delivered');
        } else {
        pushInlineDirectStatusButton(buttons, orderId, 'تم_التجهيز', 'تم التجهيز', 'order-table-action-prepared');

        if (inlineDeliveryCanMoveToInDeliveryJs) {
        pushInlineDirectStatusButton(buttons, orderId, 'قيد_التوصيل', 'قيد التوصيل', 'order-table-action-in-delivery');
        }

        pushInlineDirectStatusButton(buttons, orderId, 'تم_التسليم', 'تم التسليم', 'order-table-action-delivered');
        pushInlineDirectStatusButton(buttons, orderId, 'فشل_التسليم', 'فشل التسليم', 'order-table-action-failed');
        }
        }

        if (!buttons.length) {
        return '<td class="d-none d-lg-table-cell order-row-actions-cell"><span class="order-row-actions-empty">-</span></td>';
        }

        return '<td class="d-none d-lg-table-cell order-row-actions-cell" onclick="event.stopPropagation();" onmousedown="event.stopPropagation();" onpointerdown="event.stopPropagation();">'
        + '<div class="order-row-actions-shell" data-order-id="' + orderId + '" data-actions-count="' + buttons.length + '" style="--inline-actions-count:' + buttons.length + ';" onclick="event.stopPropagation();" onmousedown="event.stopPropagation();" onpointerdown="event.stopPropagation();">'
        + '<button type="button" class="order-row-actions-toggle" aria-expanded="false" aria-label="إظهار الإجراءات" title="إظهار الإجراءات"><span class="actions-toggle-text" aria-hidden="true">&#8249;</span></button>'
        + '<div class="order-row-actions-panel" aria-label="إجراءات الطلب">' + buttons.join('') + '</div>'
        + '</div>'
        + '</td>';
        }


        // Function to dynamically add an order to the table
        function getHomeOrderDeliveryCostValue(order) {
        if (!order) {
        return 0;
        }

        const keys = [
        'DeliveryCost', 'deliveryCost',
        'DeliveryPrice', 'deliveryPrice',
        'DeliveryFee', 'deliveryFee',
        'DeliveryFees', 'deliveryFees',
        'ShippingCost', 'shippingCost',
        'ShippingPrice', 'shippingPrice',
        'ShippingFee', 'shippingFee',
        'DeliveryAmount', 'deliveryAmount',
        'DeliveryCostAmount', 'deliveryCostAmount',
        'DeliveryPriceAmount', 'deliveryPriceAmount',
        'OrderDeliveryCost', 'orderDeliveryCost',
        'OrderDeliveryPrice', 'orderDeliveryPrice',
        'ReceiptDeliveryCost', 'receiptDeliveryCost',
        'ReceiptDeliveryPrice', 'receiptDeliveryPrice'
        ];

        for (const key of keys) {
        if (Object.prototype.hasOwnProperty.call(order, key) && order[key] !== null && order[key] !== undefined && String(order[key]).trim() !== '') {
        return order[key];
        }
        }

        return 0;
        }

        function formatHomeMoneyValue(value) {
        if (value === null || value === undefined) {
        return '0';
        }

        const text = String(value).trim();

        if (!text) {
        return '0';
        }

        const cleaned = text
        .replace(/,/g, '')
        .replace(/LYD|TRY|IQD|JOD|USD|EGP/gi, '')
        .trim();

        const numberValue = Number(cleaned);

        if (!Number.isNaN(numberValue)) {
        return numberValue.toLocaleString('en-US', { maximumFractionDigits: 0 });
        }

        return text;
        }

        function renderHomeDeliveryCostBadge(order) {
        const deliveryCost = getHomeOrderDeliveryCostValue(order);
        const formattedDeliveryCost = formatHomeMoneyValue(deliveryCost);
        const currency = order.Currency || '';
        const orderId = order && order.Id ? order.Id : '';

        return `
        <span class="home-delivery-cost-badge" title="تكلفة التوصيل" data-order-id="${orderId}" data-delivery-cost-direct="true" data-delivery-cost-value="${deliveryCost}">
        <i class="fa-solid fa-truck-fast"></i>
        <span>${formattedDeliveryCost}</span>
        <span>${currency}</span>
        </span>
        `;
        }

        function getSalesIndicatorIcon(state) {
        state = String(state || '').trim();
        if (state === 'minimum') return '↓';
        if (state === 'middle') return '→';
        if (state === 'basic') return '↑';
        if (state === 'above-basic') return '✓';
        return '—';
        }

        function renderSalesIndicatorCallCenterCell(indicator, orderId) {
        indicator = indicator || {};
        const state = indicator.state || indicator.State || '';
        const text = indicator.text || indicator.Text || 'لا يوجد مؤشر بيع';
        const cssState = state ? state : 'none';
        const icon = getSalesIndicatorIcon(state);
        return `<td class="text-center text-nowrap sales-indicator-cell" data-sales-indicator-order-id="${orderId}" onclick="event.stopPropagation();" onmousedown="event.stopPropagation();">
        <span class="sales-indicator-callcenter-badge sales-indicator-${cssState}" title="${escapeInlineHtml(text)}">
        <span class="sales-indicator-symbol">${icon}</span>
        <span class="sales-indicator-label">${escapeInlineHtml(text)}</span>
        </span>
        </td>`;
        }

        function renderSalesIndicatorMini(indicator, orderId) {
        indicator = indicator || {};
        const state = indicator.state || indicator.State || '';
        const text = indicator.text || indicator.Text || 'لا يوجد مؤشر بيع';
        if (!state) {
        return `<span class="sales-indicator-admin-mini-placeholder" data-sales-indicator-mini-placeholder-order-id="${orderId}" aria-hidden="true"></span>`;
        }
        const icon = getSalesIndicatorIcon(state);
        return `<span class="sales-indicator-admin-mini sales-indicator-${state}" data-sales-indicator-mini-order-id="${orderId}" title="${escapeInlineHtml(text)}">${icon}</span>`;
        }

        function refreshSalesIndicatorForOrder(orderId) {
        if (!orderId || (!isCallCenterJs && !canSeeSalesIndicatorMiniJs)) return;
        fetch('/Home/GetOrderSalesIndicator?orderId=' + encodeURIComponent(orderId), { method: 'GET', cache: 'no-store' })
        .then(function (response) { return response.json(); })
        .then(function (result) {
        if (!result || result.success === false) return;

        if (isCallCenterJs) {
        const cell = document.querySelector('[data-sales-indicator-order-id="' + orderId + '"]');
        if (cell) {
        const state = result.state || '';
        const cssState = state ? state : 'none';
        const text = result.text || 'لا يوجد مؤشر بيع';
        cell.innerHTML = `<span class="sales-indicator-callcenter-badge sales-indicator-${cssState}" title="${escapeInlineHtml(text)}"><span class="sales-indicator-symbol">${getSalesIndicatorIcon(state)}</span><span class="sales-indicator-label">${escapeInlineHtml(text)}</span></span>`;
        }
        }

        if (canSeeSalesIndicatorMiniJs) {
        const priceCell = document.querySelector('#ordersTable tbody tr[data-order-id="' + orderId + '"] .home-price-cell .home-order-price-stack');
        if (priceCell) {
        const existingMini = priceCell.querySelector('[data-sales-indicator-mini-order-id="' + orderId + '"], [data-sales-indicator-mini-placeholder-order-id="' + orderId + '"]');
        if (existingMini) existingMini.remove();
        const miniHtml = renderSalesIndicatorMini(result, orderId);
        const totalPriceLine = priceCell.querySelector('.home-order-total-price');
        if (totalPriceLine) {
        totalPriceLine.insertAdjacentHTML('afterend', miniHtml);
        } else {
        priceCell.insertAdjacentHTML('beforeend', miniHtml);
        }
        }
        }
        })
        .catch(function () { });
        }

        function addOrderToTable(orderJson) {
        const orderObject = JSON.parse(orderJson);
        const order = orderObject.Order;
        const username = orderObject.Username;
        const manufacturingCompanyName = orderObject.ManufacturingCompanyName;
        const deliveryCompanyName = orderObject.Deliverycompanyname;
        const manufacturingCompanyLogoPath = orderObject.ManufacturingCompanyimage || "static/DefaultImage.svg";
        const deliveryLogoPath = orderObject.Deliverycompanyimage || "static/DefaultImage.svg";

        // Construct the HTML for the new row
        let newRowHtml = `
        <tr class="pointer order-details" data-order-id="${order.Id}" style="cursor: pointer;">
        <td class="text-green text-nowrap"><i class="fa-solid f-s-14 text-green fa-cube d-inline-block"></i> ${order.Id}</td>
        ${isAdminorExcutiveDirector ? `<td class="text-nowrap">${username || 'N/A'}</td>` : ''}
        <td class="text-nowrap">${order.CustomerName}</td>
        <td class="phone-cell copyable" data-copy-text="${escapeInlineHtml(phoneForCopy(order.TelephoneNumber, order.CountryString))}" data-copy-label="رقم الهاتف">${escapeInlineHtml(phoneForDisplay(order.TelephoneNumber, order.CountryString))}</td>
        <td>${order.CreatedDate}</td>
        ${!isDelivery ? `<td class="text-center text-nowrap home-country-col"><img loading="lazy" class="pb-1 icon-size-standard" src="${order.CountryImageUrl}" alt="Country Image">${order.CountryString}</td>` : ''}
        <td>${order.State}</td>
        ${!isDelivery ? `<td><img loading="lazy" class="pb-1 icon-size-standard" src="${order.OrderSourceImageUrl}" alt="Social Media Icon">${order.OrderSourceString}</td>` : ''}
        ${!isDelivery ? `<td>${order.SourceName}</td>` : ''}
        <td class="text-end pe-5">
        <img loading="lazy" class="pb-1 icon-size-standard" src="${manufacturingCompanyLogoPath}" alt="Manufacturing Company Logo">
        ${manufacturingCompanyName}
        </td>
        ${renderInlineOrderActionsCell(order)}
        <td class="d-none d-lg-table-cell products-tooltip-cell text-center">
        <div class="products-tooltip-wrap" data-order-id="${order.Id}" data-products-loaded="false">
        <span class="products-store-trigger" aria-label="المنتجات"><svg class="products-store-svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M4 9.5 5.2 4h13.6L20 9.5v1.2c0 .9-.55 1.7-1.35 2.05V20h-3.9v-4.2h-5.5V20h-3.9v-7.25A2.25 2.25 0 0 1 4 10.7V9.5Zm2.8-3.7-.75 3.4h11.9l-.75-3.4H6.8Zm.25 7.35V18.2h1.55V14h6.8v4.2h1.55v-5.05c-.65-.05-1.25-.35-1.65-.82-.42.5-1.05.83-1.77.83-.7 0-1.32-.31-1.73-.8-.42.49-1.04.8-1.74.8-.72 0-1.35-.33-1.77-.83-.31.36-.75.64-1.24.77Z" />
        </svg></span>
        <div class="products-tooltip-cloud">
        <div class="products-tooltip-title">المنتجات داخل الطلب</div>
        <div class="products-tooltip-items"><div class="products-tooltip-loading">مرري هنا لتحميل المنتجات...</div></div>
        </div>
        </div>
        </td>
        ${!isDelivery ? `<td class="text-end"><img loading="lazy" class="pb-1 icon-size-standard" src="${deliveryLogoPath}" alt="Delivery Company Logo">${deliveryCompanyName}</td>` : ''}
        <td>${order.LastEditedDate}</td>
        <td class="text-end text-nowrap">
        <span class="order-status-badge order-status--blue">
        ${(order.OrderStatusString || '').replace(/_/g, ' ')}
        </span>
        </td>
        ${isCallCenterJs ? `<td class="text-center text-nowrap callcenter-commission-cell" onclick="event.stopPropagation();" onmousedown="event.stopPropagation();"><button type="button" class="callcenter-commission-badge callcenter-commission-pending" data-commission-state="pending" data-order-id="${order.Id}" data-shipping-code="*${order.Id}" onclick="event.stopPropagation();" onmousedown="event.stopPropagation();" title="عمولة قيد الاعتماد">عمولة قيد الاعتماد</button></td>` : ''}
        ${isCallCenterJs ? renderSalesIndicatorCallCenterCell(null, order.Id) : ''}
        <td class="text-start ltr text-blue home-price-cell">
        <span class="home-order-price-stack${canSeeSalesIndicatorMiniJs ? ' home-order-price-stack-admin' : ''}">
        <span class="home-order-total-price">
        <img src="/static/document.svg" width="15" style="padding-top:7px !important">
        <span>${order.TotalPrice}</span>
        <span>${order.Currency}</span>
        </span>
        ${canSeeSalesIndicatorMiniJs ? renderSalesIndicatorMini(null, order.Id) : ''}
        ${renderHomeDeliveryCostBadge(order)}
        </span>
        </td>
        </tr>
        `;

        // Append the new row HTML to the table
        document.querySelector('#ordersTable tbody').insertAdjacentHTML('afterbegin', newRowHtml);
        if (typeof window.applyDirectHomeDeliveryCosts === 'function') {
        window.applyDirectHomeDeliveryCosts();
        }
        refreshSalesIndicatorForOrder(order.Id);
        }

    </script>
}




<script id="orders-products-tooltip-loader-script">
    (function () {
    function escapeHtml(value) {
    return String(value || '')
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#039;');
    }

    function normalizeImageSrc(src) {
    src = (src || '').trim();
    if (!src) return '';
    if (/^(https?:)?\/\//i.test(src) || src.charAt(0) === '/') return src;
    return '/' + src.replace(/^\/+/, '');
    }

    function renderProducts(wrap, products) {
    var itemsBox = wrap.querySelector('.products-tooltip-items');
    if (!itemsBox) return;

    if (!products || !products.length) {
    wrap.classList.add('no-products');
    itemsBox.innerHTML = '<div class="products-tooltip-empty">لا توجد منتجات مسجلة لهذا الطلب</div>';
    return;
    }

    wrap.classList.remove('no-products');
    itemsBox.innerHTML = products.map(function (product) {
    var imageHtml = product.image
    ? '<img class="product-tooltip-image" src="' + escapeHtml(product.image) + '" alt="' + escapeHtml(product.name) + '" loading="lazy" onerror="this.style.display=\'none\';" />'
    : '<span class="product-tooltip-image-placeholder"><i class="fa-solid fa-box-open"></i></span>';

    return '<div class="product-tooltip-row">'
    + imageHtml
    + '<div>'
    + '<div class="product-tooltip-name">' + escapeHtml(product.name || 'منتج') + '</div>'
    + '<div class="product-tooltip-qty">عدد ' + escapeHtml(product.qty || '1') + ' قطعة</div>'
    + '</div>'
    + '</div>';
    }).join('');
    }

    function extractProductsFromDetailsHtml(html) {
    var container = document.createElement('div');
    container.innerHTML = html;

    var rows = Array.prototype.slice.call(container.querySelectorAll('#orderDetails_warehouseData tr'));
    return rows.map(function (row) {
    var cells = row.querySelectorAll('td');
    var img = row.querySelector('img');
    var image = img ? normalizeImageSrc(img.getAttribute('src')) : '';
    var name = cells[1] ? cells[1].textContent.trim() : '';
    var qty = cells[2] ? cells[2].textContent.trim() : '';

    return {
    image: image,
    name: name || 'منتج',
    qty: qty || '1'
    };
    }).filter(function (item) {
    return item.name || item.image;
    });
    }

    function loadProductsForTooltip(wrap) {
    if (!wrap || wrap.dataset.productsLoaded === 'true' || wrap.dataset.productsLoading === 'true') return;

    var orderId = wrap.getAttribute('data-order-id');
    var itemsBox = wrap.querySelector('.products-tooltip-items');
    if (!orderId || !itemsBox) return;

    wrap.dataset.productsLoading = 'true';
    wrap.classList.remove('no-products');
    itemsBox.innerHTML = '<div class="products-tooltip-loading">جاري تحميل المنتجات...</div>';

    fetch('/Order/DetailsPartial/' + encodeURIComponent(orderId), {
    headers: { 'X-Requested-With': 'XMLHttpRequest' }
    })
    .then(function (response) {
    if (!response.ok) throw new Error('Failed to load details');
    return response.text();
    })
    .then(function (html) {
    var products = extractProductsFromDetailsHtml(html);
    wrap.dataset.productsLoaded = 'true';
    renderProducts(wrap, products);
    })
    .catch(function () {
    itemsBox.innerHTML = '<div class="products-tooltip-empty">تعذر تحميل المنتجات</div>';
    })
    .finally(function () {
    wrap.dataset.productsLoading = 'false';
    });
    }

    function adjustTooltipDirection(wrap) {
    if (!wrap) return;
    var rect = wrap.getBoundingClientRect();
    var header = document.querySelector('.fixed-top, header');
    var headerBottom = header ? header.getBoundingClientRect().bottom : 0;
    var safeTop = Math.max(headerBottom + 125, 165);

    if (rect.top < safeTop) {
    wrap.classList.add('tooltip-open-down');
    } else {
    wrap.classList.remove('tooltip-open-down');
    }
    }

    document.addEventListener('mouseover', function (event) {
    var wrap = event.target.closest && event.target.closest('.products-tooltip-wrap');
    if (!wrap) return;
    adjustTooltipDirection(wrap);
    loadProductsForTooltip(wrap);
    }, true);

    document.addEventListener('focusin', function (event) {
    var wrap = event.target.closest && event.target.closest('.products-tooltip-wrap');
    if (!wrap) return;
    adjustTooltipDirection(wrap);
    loadProductsForTooltip(wrap);
    }, true);
    })();
</script>

