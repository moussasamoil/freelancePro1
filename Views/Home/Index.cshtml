    function getVisibleInlineActionButtons(shell) {
    if (!shell) return [];

    return Array.from(shell.querySelectorAll('.order-table-action-btn')).filter(function (button) {
    if (!button) return false;
    if (button.disabled) return false;
    if (button.getAttribute('data-delivery-force-hidden') === '1') return false;
    if (button.style && button.style.display === 'none') return false;

    var computedStyle = window.getComputedStyle ? window.getComputedStyle(button) : null;

    // مهم:
    // لا نتحقق من visibility هنا، لأن البانل نفسه بيكون hidden وهو مقفول،
    // وده كان بيخلي كل أزرار الإجراءات تتحسب مخفية بالغلط.
    // المطلوب إننا نخفي زر تعيين شركة التوصيل فقط لما عدد الشركات <= 1،
    // ونسيب باقي أزرار الإجراءات زي ما هي.
    if (computedStyle && computedStyle.display === 'none') {
    return false;
    }

    return true;
    });
    }

    function refreshInlineRowActionsCount(shell) {
    if (!shell) return;

    var visibleButtons = getVisibleInlineActionButtons(shell);
    var visibleCount = visibleButtons.length;
    var cell = shell.closest('.order-row-actions-cell');
    var placeholder = cell ? cell.querySelector('.order-row-actions-empty-generated') : null;

    shell.setAttribute('data-actions-count', String(visibleCount));
    shell.style.setProperty('--inline-actions-count', String(Math.max(visibleCount, 1)));

    if (visibleCount <= 0) {
    shell.style.display = 'none';

    if (cell && !placeholder) {
    placeholder = document.createElement('span');
    placeholder.className = 'order-row-actions-empty order-row-actions-empty-generated';
    placeholder.textContent = '-';
    cell.appendChild(placeholder);
    }

    if (shell.classList.contains('is-open')) {
    closeInlineRowActionsShell(shell);
    }

    return;
    }

    shell.style.display = '';

    if (placeholder) {
    placeholder.remove();
    }

    if (shell.classList.contains('is-open')) {
    var row = shell.closest('tr');
    if (row) {
    row.style.setProperty('--inline-actions-shift', getInlineActionsShift(shell) + 'px');
    }
    }
    }

    function setInlineAssignDeliveryButtonVisibility(button, companies) {
    if (!button) return;

    companies = normalizeInlineDeliveryCompanyItems(companies);
    var shouldShow = companies.length > 1;
    var shell = button.closest('.order-row-actions-shell');

    button.setAttribute('data-delivery-company-count', String(companies.length));
    button.removeAttribute('data-delivery-db-pending');

    if (shouldShow) {
    button.removeAttribute('data-delivery-force-hidden');
    button.style.display = '';
    } else {
    // المطلوب: إخفاء/إزالة خيار "تعيين شركة توصيل" نفسه من صف الإجراءات فقط.
    // لا نخفي باقي أزرار الإجراءات ولا الـ action shell كله طالما فيه أزرار أخرى.
    button.setAttribute('data-delivery-force-hidden', '1');
    button.remove();
    }

    refreshInlineRowActionsCount(shell);
    }

    function refreshInlineDeliveryAssignButtons(scope) {
    scope = scope || document;

    var buttons = Array.from(scope.querySelectorAll('.order-table-action-delivery[data-order-table-action="delivery"]'));

    buttons.forEach(function (button) {
    if (button.getAttribute('data-delivery-visibility-loading') === '1') {
    return;
    }

    var countryId = button.getAttribute('data-country-id') || '';
    var cityId = button.getAttribute('data-city') || '';

    if (!countryId) {
    setInlineAssignDeliveryButtonVisibility(button, []);
    return;
    }

    button.setAttribute('data-delivery-visibility-loading', '1');

    loadInlineDeliveryCompaniesForOrder(countryId, cityId).then(function (companies) {
    setInlineAssignDeliveryButtonVisibility(button, companies);
    }).catch(function () {
    setInlineAssignDeliveryButtonVisibility(button, []);
    }).finally(function () {
    button.removeAttribute('data-delivery-visibility-loading');
    });
    });
    }

    window.refreshInlineDeliveryAssignButtons = refreshInlineDeliveryAssignButtons;

    if (!window.__inlineDeliveryAssignVisibilityObserverBound) {
    window.__inlineDeliveryAssignVisibilityObserverBound = true;

    document.addEventListener('DOMContentLoaded', function () {
    refreshInlineDeliveryAssignButtons(document);

    if (window.MutationObserver) {
    var refreshTimer = null;
    var observer = new MutationObserver(function (mutations) {
    var shouldRefresh = mutations.some(function (mutation) {
    return Array.from(mutation.addedNodes || []).some(function (node) {
    return node && node.nodeType === 1 && (
    node.matches && node.matches('.order-table-action-delivery, tr, tbody')
    || node.querySelector && node.querySelector('.order-table-action-delivery')
    );
    });
    });

    if (!shouldRefresh) return;

    window.clearTimeout(refreshTimer);
    refreshTimer = window.setTimeout(function () {
    refreshInlineDeliveryAssignButtons(document);
    }, 120);
    });

    observer.observe(document.body, {
    childList: true,
    subtree: true
    });
    }
    });
    }


