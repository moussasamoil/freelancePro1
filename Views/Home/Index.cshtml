    + '      ' + badge
    + '    </div>'
    + '  </div>'
    + '  <span class="dot"></span>'
    + '</article>';
    }

    var SVG_DEFS = ''
    + '<svg width="0" height="0" style="position:absolute" aria-hidden="true">'
    + '  <defs><symbol id="user-icon" viewBox="0 0 24 24">'
    + '    <path fill="currentColor" d="M12 12a5 5 0 1 0-5-5 5 5 0 0 0 5 5zm0 2c-3.33 0-10 1.67-10 5v3h20v-3c0-3.33-6.67-5-10-5z"/>'
    + '  </symbol></defs>'
    + '</svg>';

    function shell(innerHtml, count) {
    return SVG_DEFS
    + '<section class="history-panel">'
    + '  <header class="panel-header">'
    + '    <button type="button" class="edit-history-back-btn" data-bs-dismiss="modal">رجوع</button>'
    + '    <div class="panel-title-wrap">'
    + '      <svg width="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"'
    + '           stroke-width="2" stroke-linecap="round" stroke-linejoin="round">'
    + '        <path d="M3 12a9 9 0 1 0 3-6.7L3 8" />'
    + '        <polyline points="3 3 3 8 8 8" />'
    + '        <line x1="12" y1="7" x2="12" y2="12" />'
    + '        <line x1="12" y1="12" x2="15" y2="14" />'
    + '      </svg>'
    + '      <h1>سجل التعديلات</h1>'
    + '    </div>'
    + '  </header>'
    + '  <div class="panel-meta">'
    + '    <div class="total-edits"><span>إجمالي التعديلات</span><span class="count">' + (count || 0) + '</span></div>'
    + '  </div>'
    + '  <div class="timeline"><div class="entries">' + innerHtml + '</div></div>'
    + '</section>';
    }

    function showLoading() {
    bodyEl.innerHTML = shell('<div style="padding:24px;text-align:center;color:#6b7280;font-size:13px;">جاري التحميل...</div>', 0);
    }

    function showError(msg) {
    bodyEl.innerHTML = shell('<div style="padding:24px;text-align:center;color:#dc2626;font-size:13px;">' + esc(msg) + '</div>', 0);
    }

    function showEmpty() {
    bodyEl.innerHTML = shell('<div style="padding:24px;text-align:center;color:#6b7280;font-size:13px;">لا توجد تعديلات</div>', 0);
    }

    function render(entries) {
    if (!entries || entries.length === 0) { showEmpty(); return; }
    // Mark the first entry (most recent change) as the current one for the badge.
    entries[0].current = true;
    // Count total individual field changes across all edit sessions (excluding creation entry).
    var totalChanges = entries.reduce(function (sum, e) {
    if (e.info) return sum;
    return sum + (e.changes && e.changes.length ? e.changes.length : 0);
    }, 0);
    var entriesHtml = entries.map(renderEntry).join('');
    bodyEl.innerHTML = shell(entriesHtml, totalChanges);
    }

    function load(orderId) {
    showLoading();
    fetch('/EditHistory/OrderChanges?id=' + encodeURIComponent(orderId), {
    headers: { 'Accept': 'application/json' },
    credentials: 'same-origin'
    })
    .then(function (r) {
    if (!r.ok) throw new Error('HTTP ' + r.status);
    return r.json();
    })
    .then(function (data) {
    console.log('[EditHistory] response for order ' + orderId + ':', data);
    render(data && data.entries);
    })
    .catch(function (err) { showError('تعذر تحميل سجل التعديلات'); });
    }

    function renderEditHistoryHtml(entries) {
    if (!entries || entries.length === 0) {
    return shell('<div style="padding:24px;text-align:center;color:#6b7280;font-size:13px;">لا توجد تعديلات</div>', 0);
    }

    entries[0].current = true;

    var totalChanges = entries.reduce(function (sum, e) {
    if (e.info) return sum;
    return sum + (e.changes && e.changes.length ? e.changes.length : 0);
    }, 0);

    return shell(entries.map(renderEntry).join(''), totalChanges);
    }

    function getNextSplitEditPopupZIndex() {
    var highest = 2147482600;

    document.querySelectorAll('.split-card-edit-history-popup').forEach(function (el) {
    var z = parseInt(window.getComputedStyle(el).zIndex || '0', 10);
    if (z >= highest) highest = z + 1;
    });

    return highest;
    }

