    function loadPosts() {
    if (!currentOrderId) return;
    setLoading(true);
    conversation.innerHTML = '';
    syncClearAllButton();
    if (emptyState) emptyState.style.display = 'none';
    var listUrl = (postType === POST_TYPE_EDIT_NOTE && canFollowUpManageEditNotes)
    ? '/OrderPosts/ListFollowUpEditNotes?orderId=' + encodeURIComponent(currentOrderId) + '&type=' + postType
    : '/OrderPosts/List?orderId=' + encodeURIComponent(currentOrderId) + '&type=' + postType;
    fetch(listUrl, {
    credentials: 'same-origin'
    })
    .then(function (r) { if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); })
    .then(function (data) {
    var posts = (data && data.posts) || [];
    var canDelete = !!(data && data.canDelete);
    var effectiveCanDelete = canDelete || (postType === POST_TYPE_EDIT_NOTE && canFollowUpManageEditNotes);
    modal.setAttribute('data-can-delete', effectiveCanDelete ? '1' : '0');

    if (posts.length === 0) {
    if (emptyState) emptyState.style.display = 'block';
    } else {
    conversation.innerHTML = posts.map(function (p) { return renderBubble(p, showCheckbox, effectiveCanDelete, postType); }).join('');
    }

    syncClearAllButton();
    })
    .catch(function (err) { console.error('OrderPosts.List failed:', err); })
    .finally(function () { setLoading(false); });
