@if (canSeeInvestigationOrdersCount)
{
    <script id="investigation-orders-count-script">
        (function () {
        const badge = document.getElementById('investigationOrdersCountBadge');

        if (!badge) {
        return;
        }

        function setInvestigationOrdersBadgeValue(value) {
        const count = Number(value || 0);
        const safeCount = Number.isFinite(count) && count >= 0 ? count : 0;

        badge.textContent = safeCount;
        badge.style.display = safeCount > 0 ? 'inline-flex' : 'none';
        }

        function refreshInvestigationOrdersCount() {
        fetch('/Home/GetNewOrdersUnderInvestigationCount', {
        method: 'GET',
        headers: {
        'Accept': 'application/json'
        },
        cache: 'no-store'
        })
        .then(function (response) {
        if (!response.ok) {
        throw new Error('Failed to load investigation orders count');
        }

        return response.json();
        })
        .then(function (result) {
        if (!result || result.success === false) {
        badge.style.display = 'none';
        return;
        }

        setInvestigationOrdersBadgeValue(result.count ?? 0);
        })
        .catch(function () {
        badge.style.display = 'none';
        });
        }

        if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', refreshInvestigationOrdersCount);
        } else {
        refreshInvestigationOrdersCount();
        }

        window.luxiraSetInvestigationOrdersCount = setInvestigationOrdersBadgeValue;
        window.refreshInvestigationOrdersCount = refreshInvestigationOrdersCount;

        window.addEventListener('storage', function (event) {
        if (event.key !== 'luxiraInvestigationOrdersRemainingCount') {
        return;
        }

        setInvestigationOrdersBadgeValue(event.newValue);
        });
        })();
    </script>
}

@if (canSeeDownloadOrdersCount)
{
    <script id="download-orders-remaining-count-script">
        (function () {
        const badge = document.getElementById('downloadOrdersRemainingCountBadge');

        if (!badge) {
        return;
        }

        function setDownloadOrdersBadgeValue(value) {
        const count = Number(value || 0);

        badge.textContent = Number.isFinite(count) && count >= 0 ? count : 0;
        badge.style.display = 'inline-flex';
        }

        function refreshDownloadOrdersRemainingCount() {
        /*
        نستخدم نفس الـ endpoint الذي تستخدمه صفحة تنزيل الطلبات داخليًا.
        كده الرقم الموجود على زر تنزيل الطلبات في صفحة الـ Index يساوي نفس رقم
        "باقي الطلبات" داخل صفحة /PrepareForDelivery، بدل الاعتماد على endpoint مختلف.
        */
        fetch('/PrepareForDelivery/GetFilteredQueue', {
        method: 'GET',
        headers: {
        'Accept': 'application/json'
        },
        cache: 'no-store'
        })
        .then(function (response) {
        if (!response.ok) {
        throw new Error('Failed to load PrepareForDelivery queue count');
        }

        return response.json();
        })
        .then(function (result) {
        if (!result || result.success === false) {
        return;
        }

        var sameCountAsPreparePage =
        result.remainingDownloadsCount ??
        result.remainingDownloadCount ??
        (Array.isArray(result.orders) ? result.orders.length : 0);

        setDownloadOrdersBadgeValue(sameCountAsPreparePage);
        })
        .catch(function () {
        badge.style.display = 'none';
        });
        }

        if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', refreshDownloadOrdersRemainingCount);
        } else {
        refreshDownloadOrdersRemainingCount();
        }

        window.refreshDownloadOrdersRemainingCount = refreshDownloadOrdersRemainingCount;
        })();
    </script>
}

<div class="d-flex mb-3   mt-3 justify-content-between mx-auto align-items-center width-99 investigation-hide-original-ui">

