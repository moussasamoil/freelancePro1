    (function () {
    const input = document.getElementById('modalSearchInput');
    const clear = document.getElementById('modalSearchClear');
    const status = document.getElementById('modalSearchStatus');
    const modalEl = orderDetailsModalEl;
    if (!input || !clear || !status || !modalEl) return;

    let timer = null;
    let reqSeq = 0; // guard against out-of-order AJAX responses
    let activeModalSearchRequest = null;
    let modalSearchFoundAutoCloseTimer = null;

    function toggleClear() {
    clear.style.visibility = input.value.length > 0 ? 'visible' : 'hidden';
    }

    function setStatus(msg) {
    status.textContent = msg || '';
    }

    function closeModalSearchFoundPopup() {
    if (modalSearchFoundAutoCloseTimer) {
    clearTimeout(modalSearchFoundAutoCloseTimer);
    modalSearchFoundAutoCloseTimer = null;
    }

    const oldPopup = document.getElementById('modalSearchFoundPopup');
    if (oldPopup) {
    oldPopup.remove();
    }
    }

    function showModalSearchFoundPopup(count) {
    closeModalSearchFoundPopup();

    const popup = document.createElement('div');
    popup.id = 'modalSearchFoundPopup';
    popup.className = 'modal-search-found-popup-backdrop';
