    <script id="login-welcome-voice-script">
        (function () {
            const welcomeText = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(loginWelcomeText));
            const playButton = document.getElementById('loginWelcomeVoiceButton');
            const welcomeMessage = document.getElementById('loginWelcomeMessage');

            let hasStarted = false;
            let hasFinished = false;
            let isTrying = false;
            let homePageFullyLoaded = false;

            function clearWelcomeCookie() {
                document.cookie = 'LoginWelcomeText=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/';
            }

            function showWelcomeMessage() {
                if (!welcomeMessage) return;

                welcomeMessage.classList.add('is-visible');

                setTimeout(function () {
                    welcomeMessage.classList.remove('is-visible');
                }, 5200);
            }

            function showPlayButton() {
                if (hasStarted || hasFinished || !playButton) return;
                playButton.classList.add('is-visible');
            }

            function hidePlayButton() {
                if (!playButton) return;
                playButton.classList.remove('is-visible');
            }

            function getBestArabicVoice() {
                if (!window.speechSynthesis || !window.speechSynthesis.getVoices) {
                    return null;
                }

                const voices = window.speechSynthesis.getVoices() || [];

                return voices.find(v => v.lang && v.lang.toLowerCase() === 'ar-eg')
                    || voices.find(v => v.lang && v.lang.toLowerCase() === 'ar-sa')
                    || voices.find(v => v.lang && v.lang.toLowerCase() === 'ar-sy')
                    || voices.find(v => v.lang && v.lang.toLowerCase().startsWith('ar'))
                    || null;
            }

            function createUtterance(text, volume) {
                const utterance = new SpeechSynthesisUtterance(text);
                utterance.lang = 'ar-EG';
                utterance.rate = 0.82;
                utterance.pitch = 1;
                utterance.volume = volume;
                utterance.voice = getBestArabicVoice();
                return utterance;
            }

            function speakRealText() {
                const utterance = createUtterance(welcomeText, 1);

                utterance.onstart = function () {
                    hasStarted = true;
                    isTrying = false;
                    hidePlayButton();
                    clearWelcomeCookie();
                };

                utterance.onend = function () {
                    hasFinished = true;
                    isTrying = false;
                    hidePlayButton();
                    clearWelcomeCookie();
                };

                utterance.onerror = function () {
                    hasStarted = false;
                    hasFinished = false;
                    isTrying = false;
                    showPlayButton();
                };

                window.speechSynthesis.speak(utterance);
            }

            function speakWelcome(fromUserAction) {
                if (!homePageFullyLoaded && !fromUserAction) return;
                if (hasStarted || hasFinished || isTrying) return;

                showWelcomeMessage();

                if (!window.speechSynthesis || !window.SpeechSynthesisUtterance) {
                    showPlayButton();
                    return;
                }

                isTrying = true;

                try {
                    window.speechSynthesis.cancel();

                    /*
                        بعض المتصفحات بتقص أول جزء من الجملة العربية عند بداية النطق.
                        لذلك نعمل utterance قصير بصوت شبه مكتوم، وبعده ننطق الرسالة كاملة.
                    */
                    const primer = createUtterance('أهلاً', 0.01);

                    primer.onend = function () {
                        setTimeout(speakRealText, 180);
                    };

                    primer.onerror = function () {
                        setTimeout(speakRealText, 180);
                    };

                    window.speechSynthesis.speak(primer);

                    setTimeout(function () {
                        isTrying = false;

                        if (!hasStarted && !window.speechSynthesis.speaking && !window.speechSynthesis.pending) {
                            showPlayButton();
                        }
                    }, fromUserAction ? 1800 : 2600);
                } catch (error) {
                    hasStarted = false;
                    hasFinished = false;
                    isTrying = false;
                    showPlayButton();
                }
            }

            if (playButton) {
                playButton.addEventListener('click', function (event) {
                    event.preventDefault();
                    event.stopPropagation();
                    speakWelcome(true);
                });
            }

            if (window.speechSynthesis && window.speechSynthesis.onvoiceschanged !== undefined) {
                window.speechSynthesis.onvoiceschanged = function () {
                    if (homePageFullyLoaded && !hasStarted && !hasFinished) {
                        setTimeout(function () {
                            speakWelcome(false);
                        }, 500);
                    }
                };
            }

            window.addEventListener('load', function () {
                homePageFullyLoaded = true;

                setTimeout(function () {
                    speakWelcome(false);
                }, 1600);

                setTimeout(function () {
                    if (!hasStarted && !hasFinished) {
                        showPlayButton();
                    }
                }, 4200);
            });
        })();
    </script>
}

@{
    /*
        لو الحساب الحالي مفتوح من خلال Admin Switch فلا نطلب صورة/سؤال تسجيل حضور.
        الموظف إذا دخل Login عادي بنفسه يظل مطلوب منه تسجيل حضور حسب طريقة البصمة المختارة له.
    */
    /*
        Admin Switch:
        لو الأدمن دخل بحساب موظف من خلال التنقل بين الحسابات،
        لا نطلب صورة/سؤال تسجيل حضور نهائيًا.
        مهم: لا نحذف Cookie الخاصة بالـ Admin Switch هنا لأنها تثبت إن السيشن Admin Switch أثناء التنقل.
    */
    var isAdminSwitchSession =
        User.HasClaim("IsAdminSwitchSession", "true") ||
        User.HasClaim("IsSwitchedAccount", "true") ||
        User.Claims.Any(c =>
            (
                c.Type == "OriginalAdminUserId" ||
                c.Type == "OriginalUserId" ||
                c.Type == "OriginalAdminEmail" ||
                c.Type == "OriginalUserEmail" ||
                c.Type == "SwitchedByUserId" ||
                c.Type == "SwitchedFromUserId" ||
                c.Type == "AdminSwitchUserId" ||
                c.Type == "AdminSwitchOriginalUserId" ||
                c.Type == "ImpersonatorUserId" ||
                c.Type == "ImpersonatedByUserId"
            ) && !string.IsNullOrWhiteSpace(c.Value)) ||
        (Context.Request.Cookies.TryGetValue("LuxiraAdminSwitchLogin", out var adminSwitchLoginCookie)
            && adminSwitchLoginCookie == "1") ||
        (Context.Request.Cookies.TryGetValue("LuxiraSwitchedAccount", out var switchedAccountCookie)
            && switchedAccountCookie == "1") ||
        (Context.Request.Cookies.TryGetValue("AdminSwitchLogin", out var adminSwitchCookie)
            && adminSwitchCookie == "1") ||
        (Context.Request.Cookies.TryGetValue("IsAdminSwitchSession", out var adminSwitchSessionCookie)
            && adminSwitchSessionCookie == "1");

    if (isAdminSwitchSession)
    {
        TempData.Remove("RequireCheckInFaceCapture");
        Context.Response.Cookies.Delete("LuxiraRequireCheckInFaceCapture");

        // لا نحذف LuxiraAdminSwitchLogin هنا حتى يظل التنقل بين الحسابات بدون صورة حضور.
    }

    var skipCheckInFaceCapture =
        isAdminSwitchSession ||
        User.IsInRole("Admin") ||
        User.IsInRole("DeliveryCompany") ||
        User.IsInRole("DeliveryRepresentative") ||
        User.IsInRole("OrderPreparer");

    var hasPendingCheckInFaceCaptureCookie =
        Context.Request.Cookies.TryGetValue("LuxiraRequireCheckInFaceCapture", out var pendingCheckInFaceCaptureCookie)
        && pendingCheckInFaceCaptureCookie == "1";

    /*
        أي موظف غير مستثنى يفتح الهوم في يوم جديد يتم عمل Check مباشر من السيرفر.
        لو لا يوجد حضور مكتمل اليوم، تظهر الصورة/السؤال فورًا حتى لو دخل قبل بداية الشيفت بنصف ساعة.
        مثال: لو الشيفت 08:00 وفتح 07:30، يأخذ صورة الدخول فورًا ولا ينتظر 08:00.
    */
    var shouldPersistPendingCheckInFaceCaptureCookie =
        (TempData["RequireCheckInFaceCapture"]?.ToString() == "1" || hasPendingCheckInFaceCaptureCookie) &&
        !skipCheckInFaceCapture;

    var requireCheckInFaceCapture = !skipCheckInFaceCapture && !isAdminSwitchSession;

    /*
        مهم:
        لو تسجيل الحضور مطلوب، نثبت علامة في Cookie قبل عرض الصفحة.
        كده لو الموظف عمل Refresh قبل ما يصور أو يجاوب السؤال، الشاشة تظهر تاني ومش تختفي.
        العلامة دي لا يتم حذفها إلا بعد ما السيرفر يؤكد إن الحضور اتسجل.
    */
    if (shouldPersistPendingCheckInFaceCaptureCookie)
    {
        Context.Response.Cookies.Append(
            "LuxiraRequireCheckInFaceCapture",
            "1",
            new Microsoft.AspNetCore.Http.CookieOptions
            {
                Path = "/",
                HttpOnly = false,
                IsEssential = true,
                SameSite = Microsoft.AspNetCore.Http.SameSiteMode.Lax,
                Secure = Context.Request.IsHttps,
                Expires = DateTimeOffset.UtcNow.AddHours(12)
            });
    }

    var checkInIpAddress = TempData["CheckInIpAddress"]?.ToString() ?? "";
    var checkInLocation = TempData["CheckInLocation"]?.ToString() ?? "";
}

<script id="admin-switch-remove-attendance-modal-guard">
    (function () {
        var isAdminSwitchSession = @((isAdminSwitchSession ? "true" : "false").ToLowerInvariant());

        if (!isAdminSwitchSession) {
            return;
        }

        try {
            document.cookie = 'LuxiraRequireCheckInFaceCapture=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/';
        } catch (e) { }

        function removeAttendanceCapturePopupsForAdminSwitch() {
            var faceBackdrop = document.getElementById('postLoginFaceBackdrop');
            var questionBackdrop = document.getElementById('postLoginQuestionBackdrop');

            if (faceBackdrop) faceBackdrop.remove();
            if (questionBackdrop) questionBackdrop.remove();
        }

        removeAttendanceCapturePopupsForAdminSwitch();

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', removeAttendanceCapturePopupsForAdminSwitch);
        }

        window.addEventListener('load', removeAttendanceCapturePopupsForAdminSwitch);
        setTimeout(removeAttendanceCapturePopupsForAdminSwitch, 300);
        setTimeout(removeAttendanceCapturePopupsForAdminSwitch, 1000);
    })();
</script>


