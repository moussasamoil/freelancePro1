    function repositionAllSplitEditHistoryPopups() {
    document.querySelectorAll('.split-card-edit-history-popup').forEach(function (popup) {
    var orderId = popup.dataset.cardOrderId || popup.getAttribute('data-order-id');
    if (!orderId) return;

