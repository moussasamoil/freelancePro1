    // ---- Inline edit ----
    function enterEditMode(row) {
    row.classList.add('editing');
    var bodyEl = row.querySelector('.report-bubble-body');
    var rawBody = bodyEl ? (bodyEl.getAttribute('data-raw-body') || '') : '';
    var ta = document.createElement('textarea');
    ta.className = 'form-control report-edit-textarea mt-1';
    ta.value = rawBody;
    if (bodyEl) {
    bodyEl.style.display = 'none';
    bodyEl.parentNode.insertBefore(ta, bodyEl.nextSibling);
    }
    ta.focus();
    }

    function exitEditMode(row) {
    row.classList.remove('editing');
    var ta = row.querySelector('.report-edit-textarea');
    if (ta) ta.remove();
    var bodyEl = row.querySelector('.report-bubble-body');
    if (bodyEl) bodyEl.style.display = '';
    }

    function saveEdit(row) {
    var postId = parseInt(row.getAttribute('data-post-id'), 10);
    if (!postId) return;
    var ta = row.querySelector('.report-edit-textarea');
    var newBody = ta ? ta.value.trim() : '';
    var saveBtn = row.querySelector('.report-save-btn');
    var cancelBtn = row.querySelector('.report-cancel-btn');
    if (saveBtn) saveBtn.disabled = true;
    if (cancelBtn) cancelBtn.disabled = true;
    var fd = new FormData();
    fd.append('id', postId);
    if (newBody) fd.append('body', newBody);
    appendAntiforgery(fd);
    fetch('/OrderPosts/Edit', {
    method: 'POST',
    body: fd,
    credentials: 'same-origin'
    })
    .then(function (r) {
    if (!r.ok) return r.json().then(function (j) { throw new Error(j.message || 'HTTP ' + r.status); });
    return r.json();
    })
    .then(function (data) {
    var bodyEl = row.querySelector('.report-bubble-body');
    if (bodyEl) {
    var updated = data.body || '';
    bodyEl.setAttribute('data-raw-body', updated);
    bodyEl.textContent = updated;
