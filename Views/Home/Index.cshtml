    var uniqueItems = [];

    items.forEach(function (item) {
    if (!item) return;

    var id = item.id || item.Id || item.deliveryCompanyId || item.DeliveryCompanyId || item.value || item.Value;

    if (id === undefined || id === null || String(id).trim() === '') {
