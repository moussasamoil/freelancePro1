@if (isInvestigationPage)
{
    <script id="open-empty-order-details-search-script">
        (function () {
        function openEmptyOrderDetailsSearch() {
        var modalEl = document.getElementById('orderDetailsModal');
        var modalBody = document.getElementById('orderDetailsModalBody');
        var searchInput = document.getElementById('modalSearchInput');

        if (!modalEl || !modalBody) {
        return;
        }

        if (typeof window.closeAllInlineRowActions === 'function') {
        window.closeAllInlineRowActions();
        }

        if (typeof window.destroyOrderDetails === 'function') {
        try {
        window.destroyOrderDetails(modalBody);
        } catch (error) { }
        }

        delete modalEl.dataset.orderId;
        delete modalEl.dataset.initialOrderId;
        modalEl.dataset.searchMode = 'single';
        modalEl.classList.remove('modal-multi-mode');
        modalBody.classList.remove('modal-multi-results-active');
        modalBody.innerHTML = '';

        if (searchInput) {
        searchInput.value = '';
        }

        var focusSearch = function () {
        if (searchInput) {
        searchInput.focus();
        }
        modalEl.removeEventListener('shown.bs.modal', focusSearch);
        };

        modalEl.addEventListener('shown.bs.modal', focusSearch);

        if (window.bootstrap && bootstrap.Modal) {
        bootstrap.Modal.getOrCreateInstance(modalEl).show();
        } else if (window.jQuery) {
        window.jQuery(modalEl).modal('show');
        }
        }

        window.openEmptyOrderDetailsSearch = openEmptyOrderDetailsSearch;

        document.addEventListener('click', function (event) {
        var btn = event.target.closest ? event.target.closest('#openEmptyOrderDetailsSearchBtn') : null;
        if (!btn) {
        return;
        }

        event.preventDefault();
        event.stopPropagation();
        openEmptyOrderDetailsSearch();
        }, true);
        })();
    </script>
}

@functions {
    // postType: 0=Problem (التبليغ عن مشكلة), 1=EditNote (تبليغ عن تعديل فوري), 2=OrderNote (ملاحظة الطلب).
    // showCheckbox: bubble ack-checkboxes appear only when both true AND viewer is Admin (rendered client-side).
    void RenderReportsModal(string modalId, string title, bool showCheckbox, string placeholder, int postType, string confirmMessage = "")
    {
        <div class="modal rtl fade reports-modal" id="@modalId" tabindex="-1" aria-hidden="true"
             data-post-type="@postType" data-show-checkbox="@(showCheckbox ? "1" : "0")"
             data-followup-edit-note-permission="@((postType == 1 && (User.IsInRole("Admin") || User.IsInRole("ExecutiveDirector") || User.IsInRole("FollowUpDepartment"))) ? "1" : "0")"
             data-problem-deduction-permission="@((postType == 0 && (User.IsInRole("Admin") || User.IsInRole("ExecutiveDirector"))) ? "1" : "0")">
            @if (!string.IsNullOrEmpty(confirmMessage))
            {
                <div class="reports-delete-confirm" style="position: fixed; inset: 0; z-index: 99999; display: none; background: rgba(33,37,41,0.55); align-items: center; justify-content: center;">
                    <div style="background-color:white; min-width:280px; max-width:400px;" class="flex-column b-r-8 d-flex justify-content-center">
                        <div class="">
                            <div class="text-center pt-3">
                                <img src="/static/trash-can-regular.svg" width="50">
                            </div>
                            <p class="text-center pb-3 px-3" style="white-space:normal;overflow-wrap:anywhere;word-break:break-word;">@confirmMessage</p>
                        </div>
                        <div class="border-top">
                            <div class="row" style="margin:0;">
                                <div class="col-6 py-2 text-center text-green-v2 text-decoration-underline reports-delete-confirm-ok" style="cursor:pointer;">
                                    موافقه
                                </div>
                                <div class="col-6 py-2 text-center border-right text-grey-v2 text-decoration-underline reports-delete-confirm-cancel" style="cursor:pointer;">
                                    تراجع
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <div class="reports-clear-all-confirm" aria-hidden="true">
                <div class="reports-clear-all-confirm-box">
                    <button type="button" class="reports-clear-all-confirm-close" aria-label="إغلاق">×</button>

                    <div class="reports-clear-all-confirm-icon" aria-hidden="true">
                        <svg width="38" height="38" viewBox="0 0 24 24" fill="none">
                            <path d="M9 3.75H15L15.75 5.25H20.25" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
                            <path d="M3.75 5.25H20.25" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
                            <path d="M6.75 8.25L7.35 19.05C7.42 20.18 8.34 21.05 9.47 21.05H14.53C15.66 21.05 16.58 20.18 16.65 19.05L17.25 8.25" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
                            <path d="M10.25 10.75V17.25" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
                            <path d="M13.75 10.75V17.25" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
                        </svg>
                    </div>

                    <div class="reports-clear-all-confirm-title">مسح جميع المحتوى</div>
                    <div class="reports-clear-all-confirm-message">هل أنت متأكد من مسح الجميع؟</div>

                    <div class="reports-clear-all-confirm-actions">
                        <button type="button" class="reports-clear-all-confirm-ok">تأكيد</button>
                        <button type="button" class="reports-clear-all-confirm-cancel">لا</button>
                    </div>
                </div>
            </div>


            @if (postType == 0 && (User.IsInRole("Admin") || User.IsInRole("ExecutiveDirector")))
            {
                <div class="reports-deduction-confirm" aria-hidden="true">
                    <div class="reports-deduction-confirm-box">
                        <button type="button" class="reports-deduction-confirm-close" aria-label="إغلاق">×</button>
                        <div class="reports-deduction-confirm-icon">!</div>
                        <div class="reports-deduction-confirm-title">تأكيد الخصم على الموظف</div>
                        <div class="reports-deduction-confirm-note">اختاري الموظف وقيمة الخصم قبل التأكيد.</div>

                        <div class="reports-deduction-field">
                            <label>الموظف</label>
                            <select class="reports-deduction-employee-select"></select>
                        </div>

                        <div class="reports-deduction-field">
                            <label>قيمة الخصم</label>
                            <input type="number" min="0" step="0.01" class="reports-deduction-amount-input" />
                            <small class="reports-deduction-total-text"></small>
                        </div>

                        <div class="reports-deduction-field">
                            <label>تفاصيل الخصم</label>
                            <textarea class="reports-deduction-reason-input" rows="4"></textarea>
                        </div>

                        <div class="reports-deduction-error" style="display:none;"></div>

                        <div class="reports-deduction-actions">
                            <button type="button" class="reports-deduction-confirm-ok">تأكيد</button>
                            <button type="button" class="reports-deduction-confirm-cancel">إلغاء</button>
                        </div>
                    </div>
                </div>
            }

            <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
                <div class="modal-content background-white-green" style="max-height:600px;">
                    <div class="modal-header reports-modal-header">
                        <button type="button" class="btn head-16 text-green" data-bs-dismiss="modal" aria-label="Close">تراجع</button>

                        <div class="reports-modal-title-wrap">
                            <button type="button" class="reports-clear-all-btn" title="مسح الجميع" style="display:none;">
                                <svg width="19" height="19" viewBox="0 0 24 24" fill="none">
                                    <path d="M9 3.75H15L15.75 5.25H20.25" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
                                    <path d="M3.75 5.25H20.25" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
                                    <path d="M6.75 8.25L7.35 19.05C7.42 20.18 8.34 21.05 9.47 21.05H14.53C15.66 21.05 16.58 20.18 16.65 19.05L17.25 8.25" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
                                    <path d="M10.25 10.75V17.25" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
                                    <path d="M13.75 10.75V17.25" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
                                </svg>
                            </button>
                            <h5 class="modal-title head text-center m-0">@title</h5>
                        </div>

                        <div class="reports-header-left-actions">
                            @if (postType == 1 || (postType == 0 && (User.IsInRole("Admin") || User.IsInRole("ExecutiveDirector"))))
                            {
                                @if (postType == 1)
                                {
                                    <button type="button" class="btn head-16 text-green reports-copy-all-btn" title="نسخ كل التعديلات" style="display:none;">نسخ الكل</button>
                                }
                                <button type="button" class="btn head-16 text-green reports-deleted-history-btn" title="سجل التعديلات">سجل التعديلات</button>
                            }
                            <button type="button" class="btn head-16 text-green" data-bs-dismiss="modal" aria-label="Close">إغلاق</button>
                        </div>
                    </div>
                    <div class="modal-body">
                        @* DEV: bubbles are rendered client-side from /OrderPosts/List, ordered newest-first (top = most recent). *@
                        <div class="reports-conversation"></div>
                        <div class="reports-loading text-center py-3" style="display:none;">
                            <div class="spinner-border spinner-border-sm text-success" role="status"></div>
                        </div>
                    </div>

                    <div class="reports-copy-toast" aria-live="polite">تم نسخ المحتوى</div>

                    @if (postType == 1 || (postType == 0 && (User.IsInRole("Admin") || User.IsInRole("ExecutiveDirector"))))
                    {
                        <div class="reports-deleted-history-panel" aria-hidden="true">
                            <div class="reports-deleted-history-card">
                                <div class="reports-deleted-history-header">
                                    <button type="button" class="reports-deleted-history-back">رجوع</button>
                                    <h5>سجل التعديلات</h5>
                                    <button type="button" class="reports-deleted-history-close" aria-label="إغلاق">×</button>
                                </div>
                                <div class="reports-deleted-history-body">
                                    <div class="reports-deleted-history-empty">جاري تحميل السجل...</div>
                                </div>
                            </div>
                        </div>
                    }

                    <div class="modal-footer p-2 flex-column align-items-stretch">
                        <div class="reports-attach-preview" style="display:none;"></div>
                        @* DEV: paste images directly into the textarea (Ctrl+V) — same pattern as _CreateOrder.cshtml. The hidden file input is the FormData carrier. *@
                        <textarea class="form-control reports-text-input" rows="6" placeholder="@placeholder"></textarea>
                        <input type="file" class="reports-attach-input" accept="image/*" multiple hidden />
                        <button type="button" class="btn reports-submit-btn w-100 mt-2">@((postType == 0 && (User.IsInRole("Admin") || User.IsInRole("ExecutiveDirector"))) ? "ارسال الخصم ع الموظف" : "إرسال")</button>
                    </div>
                </div>
            </div>
        </div>
    }
}

