    }

    // 2. Handle TRY and USD prices
    const tryPriceText = $ajaxResult.find('.total-price-display-try').text().trim();
    const tryPriceValue = parseFloat(tryPriceText.replace('TRY', '').trim()) || 0;

    // Remove existing price container
    $('#priceContainer').remove();

