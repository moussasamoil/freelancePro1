<script id="orders-inline-actions-script-v2">
    (function () {
    function stopTableEvent(e) {
    if (!e) return;
    e.preventDefault();
    e.stopPropagation();
    if (typeof e.stopImmediatePropagation === 'function') {
    e.stopImmediatePropagation();
    }
    }

    function showTableActionToast(message) {
    if (window.Toastify) {
    Toastify({
    text: message,
    duration: 2200,
    gravity: "bottom",
    position: "center",
    style: {
    background: "#129838",
    borderRadius: "8px",
    fontWeight: "400"
    }
    }).showToast();
    return;
    }

    alert(message);
    }

    function forceClearHomeModalOverlay() {
    // لا تقفل إجراءات الصف هنا.
    // المطلوب أن تفضل مفتوحة أثناء فتح/إغلاق المودالات،
    // وتتقفل فقط بعد نجاح العملية فعليًا داخل afterInlineOrderAction أو ajaxSuccess.
    window.setTimeout(function () {
    var visibleModal = document.querySelector('.modal.show');

    if (!visibleModal) {
    document.querySelectorAll('.modal-backdrop').forEach(function (backdrop) {
    backdrop.remove();
    });

    document.body.classList.remove('modal-open');
    document.body.classList.remove('inline-real-details-action-open');
    document.body.style.removeProperty('overflow');
    document.body.style.removeProperty('padding-right');
    document.body.style.removeProperty('padding-left');
    }
    }, 80);
    }

    window.forceClearHomeModalOverlay = forceClearHomeModalOverlay;

    document.addEventListener('hidden.bs.modal', function (e) {
    var target = e.target;
    if (!target || !target.classList || !target.classList.contains('modal')) return;

    if (target.closest('#modal-container')
    || target.closest('#inlineOrderActionsModalHost')
    || target.closest('#inlineDetailsActionPopupHost')
    || target.closest('[data-payment-receipt-modal]')) {
    forceClearHomeModalOverlay();
    }
    }, true);

    document.addEventListener('click', function (e) {
    var closer = e.target.closest('[data-bs-dismiss="modal"], [data-dismiss="modal"], .btn-close, .close');
    if (!closer) return;

    var modal = closer.closest('.modal');
    if (!modal) return;

    if (modal.closest('#modal-container')
    || modal.closest('#inlineOrderActionsModalHost')
    || modal.closest('#inlineDetailsActionPopupHost')
    || modal.closest('[data-payment-receipt-modal]')) {
    window.setTimeout(forceClearHomeModalOverlay, 350);
    }
    }, true);

    function normalizeText(value) {
    return String(value || "")
    .replace(/\s+/g, " ")
    .replace(/[ـ]/g, "")
    .trim();
    }

    function escapeInlineHtml(value) {
    return String(value === null || value === undefined ? '' : value)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
    }

    function isActuallyClickable(el) {
    if (!el || el.disabled) return false;

    var style = window.getComputedStyle(el);
    if (!style || style.display === "none" || style.visibility === "hidden" || style.opacity === "0") {
    return false;
    }

    return true;
    }

    function findBySelectors(root, selectors) {
    for (var i = 0; i < selectors.length; i++) {
    var found = Array.from(root.querySelectorAll(selectors[i])).filter(isActuallyClickable);
    if (found.length) return found[0];
    }

    return null;
    }

    function findButtonByText(root, textList) {
    var elements = Array.from(root.querySelectorAll('button, a, [role="button"]')).filter(isActuallyClickable);

    return elements.find(function (el) {
    var txt = normalizeText(el.textContent);
    return textList.some(function (needle) {
    return txt.indexOf(needle) !== -1;
    });
    }) || null;
    }

    function findDetailsActionTarget(root, actionName) {
    switch (actionName) {
    case "edit":
    return findBySelectors(root, [
    'button[data-url*="EditOrder"]',
    '[data-url*="EditOrder"]',
    '.open button[data-url]',
    '.open [data-url]'
    ]) || findButtonByText(root, ["تعديل الطلب", "تعديل طلب"]);

    case "payment":
    return findBySelectors(root, [
    '#dropdownMenuButtonispaid',
    '[aria-controls="dropdownMenuButtonispaid"]'
    ]) || findButtonByText(root, ["حالة الدفع", "حاله الدفع", "حالة دفع"]);

    case "cancel":
    return findBySelectors(root, [
    '#cancelButton',
    '.cancelButton'
    ]) || findButtonByText(root, ["إلغاء الطلب", "الغاء الطلب", "إلغاء طلب"]);

    case "postpone":
    return findBySelectors(root, [
    '#dropdownMenuButtonPostpone',
    '[aria-controls="postponeDropdown"]'
    ]) || findButtonByText(root, ["تأجيل الطلب", "تأجيل طلب"]);

    case "status":
    return findBySelectors(root, [
    '#dropdownMenuButton1',
    '[aria-labelledby="dropdownMenuButton1"]'
    ]) || findButtonByText(root, ["تعديل حالة الطلب", "حالة الطلب", "حالة طلب"]);

    case "employee":
    return findBySelectors(root, [
    '#dropdownMenuButtonemployee',
    '[aria-labelledby="dropdownMenuButtonemployee"]'
    ]) || findButtonByText(root, ["تعيين الموظف", "تعيين موظف"]);

    case "delivery":
    return findBySelectors(root, [
    '#dropdownMenuButtonDelivery',
    '[aria-labelledby="dropdownMenuButtonDelivery"]'
    ]) || findButtonByText(root, ["تعيين شركة التوصيل", "تعيين شركة توصيل"]);

    default:
    return null;
    }
    }

    function ensureInlineActionsModalHost() {
    var host = document.getElementById('inlineOrderActionsModalHost');
    if (!host) {
    host = document.createElement('div');
    host.id = 'inlineOrderActionsModalHost';
    document.body.appendChild(host);
    }
    return host;
    }

    function showBootstrapModalFromHtml(html) {
    var host = ensureInlineActionsModalHost();
    host.innerHTML = html;
    var modalEl = host.querySelector('.modal');
    if (!modalEl) return null;

    modalEl.addEventListener('hidden.bs.modal', function () {
    host.innerHTML = '';
    forceClearHomeModalOverlay();
    }, { once: true });

    if (window.bootstrap && bootstrap.Modal) {
    bootstrap.Modal.getOrCreateInstance(modalEl).show();
    } else if (window.jQuery) {
    $(modalEl).modal('show');
    }

    return modalEl;
    }

    function confirmInlineOrderAction(message, onConfirm, iconPath) {
    if (typeof window.showNotification === 'function') {
    window.showNotification(message, onConfirm, iconPath || '/static/trash-can-regular.svg');
    return;
    }

    if (window.confirm(message)) {
    onConfirm();
    }
    }

    function afterInlineOrderAction(orderId) {
    if (typeof window.hideNotification === 'function') {
    window.hideNotification();
    }
    if (typeof window.invalidateOrder === 'function') {
    window.invalidateOrder(orderId);
    }
    if (typeof window.refreshOrderTable === 'function') {
    window.refreshOrderTable({ force: true });
    } else if (typeof window.homeLoadData === 'function') {
    window.homeLoadData(typeof currentPage !== 'undefined' ? currentPage : 1);
    }

    // بعد نجاح العملية فعليًا، اقفل إجراءات الصف.
    window.setTimeout(function () {
    if (typeof window.closeAllInlineRowActions === 'function') {
    window.closeAllInlineRowActions();
    }
    }, 120);
    }

    function openDirectEditOrderPopup(orderId) {
    var $container = $('#modal-container');
    if (!$container.length) {
    $('body').append('<div id="modal-container"></div>');
    $container = $('#modal-container');
    }

    $.ajax({
    url: '/Home/EditOrder',
    type: 'GET',
    data: { orderId: orderId },
    success: function (data) {
    $container.html(data);
    var modalEl = $container.find('.modal').first()[0];
    if (!modalEl) {
    showTableActionToast('تعذر فتح نافذة تعديل الطلب.');
    return;
    }

    modalEl.addEventListener('hidden.bs.modal', function () {
    $container.empty();
    forceClearHomeModalOverlay();
    }, { once: true });

    if (window.jQuery) {
    $container.off('hidden.bs.modal.inlineEditCleanup')
    .on('hidden.bs.modal.inlineEditCleanup', '.modal', function () {
    window.setTimeout(function () {
    $container.empty();
    forceClearHomeModalOverlay();
    }, 80);
    });
    }

    if (window.bootstrap && bootstrap.Modal) {
    bootstrap.Modal.getOrCreateInstance(modalEl).show();
    } else if (window.jQuery) {
    $(modalEl).modal('show');
    }
    },
    error: function () {
    showTableActionToast('تعذر تحميل نافذة تعديل الطلب.');
    }
    });
    }

    function submitInlinePaymentReceipt(orderId, $wrapper, $receiptModal, $fileInput) {
    var fileEl = $fileInput[0];
    if (!fileEl.files || fileEl.files.length === 0) {
    $wrapper.find('#paymentReceiptError').show();
    return;
    }

    var fd = new FormData();
    fd.append('isPaid', 'true');
    fd.append('paymentReceiptFile', fileEl.files[0]);

    $.ajax({
    url: '/Order/SetIsPaid/' + encodeURIComponent(orderId),
    type: 'POST',
    data: fd,
    processData: false,
    contentType: false,
    success: function () {
    if (window.bootstrap && bootstrap.Modal) {
    var instance = bootstrap.Modal.getInstance($receiptModal[0]);
    if (instance) instance.hide();
    } else {
    $receiptModal.modal('hide');
    }
    afterInlineOrderAction(orderId);
    },
    error: function (xhr) {
    var msg = (xhr.responseJSON && xhr.responseJSON.message) || 'فشل في حفظ صورة الإيصال.';
    $wrapper.find('#paymentReceiptError').text(msg).show();
    }
    });
    }

    function openInlinePaymentReceiptPopup(orderId) {
    $.ajax({
    url: '/Order/PaymentReceiptModal',
    type: 'GET',
    success: function (data) {
    $('body > [data-payment-receipt-modal]').remove();
    var $wrapper = $('<div data-payment-receipt-modal="true"></div>').html(data);
    $('body').append($wrapper);

    var $receiptModal = $wrapper.find('#paymentReceiptModal');
    if (!$receiptModal.length) {
    showTableActionToast('تعذر فتح نافذة إيصال الدفع.');
    return;
    }

    $receiptModal.css('z-index', 2147483640);

    var $paste = $wrapper.find('#paymentReceiptPaste');
    var $fileInput = $wrapper.find('#paymentReceiptFileInput');

    $paste.on('click', function () { $fileInput.trigger('click'); });

    $fileInput.on('change', function () {
    var file = this.files && this.files[0];
    if (!file) return;
    var reader = new FileReader();
    reader.onload = function (e) {
    $paste.empty().append($('<img>').attr('src', e.target.result));
    };
    reader.readAsDataURL(file);
    $wrapper.find('#paymentReceiptError').hide();
    });

    $paste.on('paste', function (e) {
    var items = (e.originalEvent || e).clipboardData && (e.originalEvent || e).clipboardData.items;
    if (!items) return;
    for (var i = 0; i < items.length; i++) {
    if (items[i].type.indexOf('image') === 0) {
    e.preventDefault();
    var blob = items[i].getAsFile();
    var dt = new DataTransfer();
    dt.items.add(blob);
    $fileInput[0].files = dt.files;
    var reader = new FileReader();
    reader.onload = function (ev) {
    $paste.empty().append($('<img>').attr('src', ev.target.result));
    };
    reader.readAsDataURL(blob);
    $wrapper.find('#paymentReceiptError').hide();
    return;
    }
    }
    });

    window.submitPaymentReceipt = function () {
    submitInlinePaymentReceipt(orderId, $wrapper, $receiptModal, $fileInput);
    };

    $receiptModal.on('hidden.bs.modal', function () {
    $wrapper.remove();
    forceClearHomeModalOverlay();
    });

    if (window.bootstrap && bootstrap.Modal) {
    bootstrap.Modal.getOrCreateInstance($receiptModal[0]).show();
    } else {
    $receiptModal.modal('show');
    }
    },
    error: function () {
    showTableActionToast('تعذر تحميل نافذة إيصال الدفع.');
    }
    });
    }

    function setInlinePaymentStatus(orderId, isPaid) {
    if (isPaid) {
    openInlinePaymentReceiptPopup(orderId);
    return;
    }

    confirmInlineOrderAction('هل أنت متأكد من تغيير حالة الدفع إلى غير مدفوع؟', function () {
    $.ajax({
    url: '/Order/SetIsPaid/' + encodeURIComponent(orderId),
    type: 'POST',
    data: { isPaid: false },
    success: function () {
    afterInlineOrderAction(orderId);
    },
    error: function () {
    showTableActionToast('فشل في تعديل حالة الدفع.');
    }
    });
    });
    }

    function openDirectPaymentPopup(orderId) {
    var html = ''
    + '<div class="modal fade inline-order-action-modal" tabindex="-1" aria-hidden="true">'
    + '  <div class="modal-dialog modal-dialog-centered">'
    + '    <div class="modal-content" dir="rtl">'
    + '      <div class="modal-header">'
    + '        <h5 class="modal-title">حالة الدفع</h5>'
    + '        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>'
    + '      </div>'
    + '      <div class="modal-body">'
    + '        <div class="d-grid gap-2">'
    + '          <button type="button" class="btn btn-success inline-payment-paid">تم التحويل حوالة بنكية</button>'
    + '          <button type="button" class="btn btn-danger inline-payment-unpaid">غير مدفوع</button>'
    + '        </div>'
    + '      </div>'
    + '    </div>'
    + '  </div>'
    + '</div>';

    var modalEl = showBootstrapModalFromHtml(html);
    if (!modalEl) return;

    modalEl.querySelector('.inline-payment-paid').addEventListener('click', function () {
    if (window.bootstrap && bootstrap.Modal) {
    bootstrap.Modal.getInstance(modalEl).hide();
    } else {
    $(modalEl).modal('hide');
    }
    setInlinePaymentStatus(orderId, true);
    });

    modalEl.querySelector('.inline-payment-unpaid').addEventListener('click', function () {
    if (window.bootstrap && bootstrap.Modal) {
    bootstrap.Modal.getInstance(modalEl).hide();
    } else {
    $(modalEl).modal('hide');
    }
    setInlinePaymentStatus(orderId, false);
    });
    }

    function getInlineInvestigationAntiForgeryToken() {
    var formToken = document.querySelector('#investigationAntiForgeryForm input[name="__RequestVerificationToken"]');
    if (formToken && formToken.value) {
    return formToken.value;
    }

    var anyToken = document.querySelector('input[name="__RequestVerificationToken"]');
    return anyToken ? anyToken.value : '';
    }

    function markOrderOpenedFromInvestigationPage(orderId) {
    var isInvestigationMode = @((ViewBag.IsInvestigationPage == true).ToString().ToLowerInvariant());

    if (!isInvestigationMode || !orderId) {
    return Promise.resolve({ success: true });
    }

    return fetch('/Home/MarkOrderOpenedForInvestigation?orderId=' + encodeURIComponent(orderId), {
    method: 'POST',
    credentials: 'same-origin',
    headers: {
    'Accept': 'application/json',
    'RequestVerificationToken': getInlineInvestigationAntiForgeryToken()
    }
    })
    .then(function (response) {
    if (!response.ok) {
    throw new Error('HTTP ' + response.status);
    }
    return response.json();
    })
    .catch(function (error) {
    console.warn('MarkOrderOpenedForInvestigation failed:', error);
    return { success: false };
    });
    }

    window.markOrderOpenedFromInvestigationPage = markOrderOpenedFromInvestigationPage;

    function updateInlineOrderStatus(orderId, statusText, reason) {
    markOrderOpenedFromInvestigationPage(orderId).finally(function () {
    $.ajax({
    url: '/Order/UpdateStatus',
    type: 'POST',
    data: {
    id: orderId,
    orderStatus: statusText,
    reason: reason || ''
    },
    success: function (result) {
    if (result && result.success === false) {
    showTableActionToast(result.message || 'فشل في تعديل حالة الطلب.');
    return;
    }
    afterInlineOrderAction(orderId);
    },
    error: function () {
    showTableActionToast('فشل في تعديل حالة الطلب.');
    }
    });
    });
    }

    function updateInlineOrderStatusWithFailureReasonImage(orderId, statusText, reason, failureReasonImageFile) {
    if (!failureReasonImageFile) {
    updateInlineOrderStatus(orderId, statusText, reason || '');
    return;
    }

    markOrderOpenedFromInvestigationPage(orderId).finally(function () {
    var fd = new FormData();
    fd.append('id', orderId);
    fd.append('orderStatus', statusText);
    fd.append('reason', reason || '');

    // أسماء متعددة لنفس الملف لتوافق أي اسم باراميتر موجود في الكنترولر
    fd.append('failureReasonImageFile', failureReasonImageFile);
    fd.append('failedReasonImageFile', failureReasonImageFile);
    fd.append('failureImageFile', failureReasonImageFile);
    fd.append('reasonImageFile', failureReasonImageFile);
    fd.append('imageFile', failureReasonImageFile);

    var token = getInlineInvestigationAntiForgeryToken();
    if (token) {
    fd.append('__RequestVerificationToken', token);
    }

    $.ajax({
    url: '/Order/UpdateStatus',
    type: 'POST',
    data: fd,
    processData: false,
    contentType: false,
    success: function (result) {
    if (result && result.success === false) {
    showTableActionToast(result.message || 'فشل في تعديل حالة الطلب.');
    return;
    }
    afterInlineOrderAction(orderId);
    },
    error: function () {
    showTableActionToast('فشل في تعديل حالة الطلب.');
    }
    });
    });
    }

    function openInlineFailureReasonPopup(orderId, statusText, displayText) {
    var selectedFile = null;

    var html = ''
    + '<div class="modal fade inline-order-action-modal inline-failure-reason-modal" tabindex="-1" aria-hidden="true">'
    + '  <div class="modal-dialog modal-dialog-centered">'
    + '    <div class="modal-content" dir="rtl">'
    + '      <div class="modal-header">'
    + '        <h5 class="modal-title">سبب فشل التسليم</h5>'
    + '        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>'
    + '      </div>'
    + '      <div class="modal-body">'
    + '        <label class="form-label fw-bold">سبب الفشل</label>'
    + '        <select id="inlineFailureReasonSelect" class="form-control drop-down-design inline-failure-reason-select"></select>'
    + '        <div class="inline-failure-reason-error text-danger mt-2" style="display:none;font-size:13px;font-weight:700;">الرجاء اختيار سبب الفشل من القائمة.</div>'
    + '        <div class="mt-3">'
    + '          <label class="form-label fw-bold">صورة سبب فشل الطلب <span class="text-muted">(اختياري)</span></label>'
    + '          <div tabindex="0" class="inline-failure-reason-image-paste-box" style="min-height:130px;border:2px dashed #d1d5db;border-radius:12px;background:#f8fafc;display:flex;align-items:center;justify-content:center;text-align:center;color:#64748b;font-weight:700;cursor:pointer;padding:12px;">اختاري صورة أو اضغطي Ctrl + V للصق صورة سبب الفشل إذا متاحة</div>'
    + '          <input type="file" class="inline-failure-reason-image-file" accept="image/*" hidden />'
    + '          <div class="inline-failure-reason-image-error text-danger mt-2" style="display:none;font-size:13px;font-weight:700;">الملف المختار يجب أن يكون صورة.</div>'
    + '        </div>'
    + '        <button type="button" class="btn btn-success w-100 mt-3 inline-failure-reason-confirm">تأكيد</button>'
    + '      </div>'
    + '    </div>'
    + '  </div>'
    + '</div>';

    var modalEl = showBootstrapModalFromHtml(html);
    if (!modalEl) return;

    var reasonSelect = modalEl.querySelector('#inlineFailureReasonSelect');
    var reasonError = modalEl.querySelector('.inline-failure-reason-error');
    var pasteBox = modalEl.querySelector('.inline-failure-reason-image-paste-box');
    var fileInput = modalEl.querySelector('.inline-failure-reason-image-file');
    var imageError = modalEl.querySelector('.inline-failure-reason-image-error');
    var confirmBtn = modalEl.querySelector('.inline-failure-reason-confirm');

    if (typeof fetchFailureReasons === 'function') {
    fetchFailureReasons('#inlineFailureReasonSelect', function () {
    if (window.jQuery && $.fn && $.fn.select2) {
    $('#inlineFailureReasonSelect').select2({
    placeholder: 'اختر سبب الفشل',
    allowClear: true,
    dir: 'rtl',
    width: '100%',
    dropdownParent: $(modalEl)
    });
    }
    });
    } else {
    reasonSelect.innerHTML = '<option value="">اختر سبب الفشل</option>';
    }

    function showSelectedFailureImage(file) {
    if (!file) return;

    if (!/^image\//i.test(file.type || '')) {
    if (imageError) imageError.style.display = 'block';
    return;
    }

    selectedFile = file;
    if (imageError) imageError.style.display = 'none';

