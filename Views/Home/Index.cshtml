    $(document).ready(function () {


    initializeLitepicker('.custom-datepicker', loadData);


    // ----- Order Details Modal (Phase 2) -----
    const orderDetailsModalEl = document.getElementById('orderDetailsModal');
    const orderDetailsBody = document.getElementById('orderDetailsModalBody');


    function normalizeOrderDetailsDeliveryCompanyItems(data) {
    var source = [];

    if (Array.isArray(data)) {
    source = data;
    } else if (data && Array.isArray(data.data)) {
    source = data.data;
    } else if (data && Array.isArray(data.items)) {
    source = data.items;
    } else if (data && Array.isArray(data.deliveryCompanies)) {
    source = data.deliveryCompanies;
    }

    var seen = {};

    return source.map(function (item) {
    if (!item) return null;

    var id = item.id || item.Id || item.deliveryCompanyId || item.DeliveryCompanyId || item.value || item.Value;
    var name = item.name || item.Name || item.text || item.Text || item.displayName || item.DisplayName || id;

    if (id === undefined || id === null || String(id).trim() === '') return null;

    return {
    id: String(id),
    name: String(name || id)
    };
    }).filter(function (item) {
    if (!item) return false;
    if (seen[item.id]) return false;
    seen[item.id] = true;
    return true;
    });
    }

    function getOrderDetailsDeliveryBox(root) {
    if (!root) return null;

    var button = root.querySelector('#dropdownMenuButtonDelivery')
    || root.querySelector('[aria-labelledby="dropdownMenuButtonDelivery"]')
    || Array.prototype.slice.call(root.querySelectorAll('button, a, [role="button"]')).filter(function (el) {
    var text = (el.textContent || '').replace(/\s+/g, ' ').trim();
    return text.indexOf('تعيين شركة التوصيل') !== -1 || text.indexOf('تعيين شركة توصيل') !== -1;
    })[0];

    if (!button) return null;

    return button.closest('.dropdown, .custom-box-shadow, .flex-item-equal, .open') || button;
    }

    function hideOrderDetailsDeliveryDropdownIfSingle(root, orderId) {
    if (!root) return;

    var button = root.querySelector('#dropdownMenuButtonDelivery')
    || Array.prototype.slice.call(root.querySelectorAll('button, a, [role="button"]')).filter(function (el) {
    var text = (el.textContent || '').replace(/\s+/g, ' ').trim();
    return text.indexOf('تعيين شركة التوصيل') !== -1 || text.indexOf('تعيين شركة توصيل') !== -1;
    })[0];

    if (!button || button.getAttribute('data-single-delivery-checking') === '1') return;

    var rowButton = null;
    var safeOrderId = String(orderId || '');

    if (safeOrderId && window.CSS && CSS.escape) {
    rowButton = document.querySelector('.order-table-action-delivery[data-order-id="' + CSS.escape(safeOrderId) + '"]');
    }

    var source = rowButton || button.closest('[data-country-id]') || root.querySelector('[data-country-id]');
    var countryId = source ? (source.getAttribute('data-country-id') || source.getAttribute('data-country') || '') : '';
    var cityId = source ? (source.getAttribute('data-city') || source.getAttribute('data-state') || '') : '';

    if (!countryId) return;

    button.setAttribute('data-single-delivery-checking', '1');

    $.ajax({
    url: '/Datalist/GetAllDeliveryCompaniesAndRepresentatives',
    type: 'GET',
    data: {
    countryId: countryId,
    cityId: ''
    },
    success: function (data) {
    var items = normalizeOrderDetailsDeliveryCompanyItems(data);

    if (items.length <= 1) {
    var box = getOrderDetailsDeliveryBox(root);
    var menu = root.querySelector('.dropdown-menu[aria-labelledby="dropdownMenuButtonDelivery"]')
    || root.querySelector('[aria-labelledby="dropdownMenuButtonDelivery"]');

    button.setAttribute('data-single-delivery-hidden', '1');
    button.style.setProperty('display', 'none', 'important');

    if (menu) {
    menu.style.setProperty('display', 'none', 'important');
    }

    if (box) {
    box.setAttribute('data-single-delivery-hidden', '1');
    box.style.setProperty('display', 'none', 'important');
    }
    }
    },
    complete: function () {
    button.removeAttribute('data-single-delivery-checking');
    }
    });
    }

    document.addEventListener('click', function (event) {
    var button = event.target && event.target.closest ? event.target.closest('#dropdownMenuButtonDelivery, [aria-labelledby="dropdownMenuButtonDelivery"]') : null;
    if (!button) return;

    var hiddenButton = button.closest('[data-single-delivery-hidden="1"]') || (button.getAttribute('data-single-delivery-hidden') === '1' ? button : null);
    if (!hiddenButton) return;

    event.preventDefault();
    event.stopPropagation();
    if (typeof event.stopImmediatePropagation === 'function') event.stopImmediatePropagation();
    }, true);

    // initOrderDetails / destroyOrderDetails are defined by the partial script itself.
    // Provide no-op fallbacks so the modal lifecycle is safe before the partial loads.
    if (typeof window.initOrderDetails !== 'function') window.initOrderDetails = function () { };
    if (typeof window.destroyOrderDetails !== 'function') window.destroyOrderDetails = function () { };

    if (typeof CSS === 'undefined' || typeof CSS.escape !== 'function') {
    window.CSS = window.CSS || {};
    CSS.escape = function (value) {
    return String(value).replace(/["\\]/g, '\\$&');
    };
    }

    let activeSplitCardModal = null;
    let activeSplitCardElement = null;

    function positionModalInsideCard(modalEl, card) {
    if (!modalEl || !card) return;

    const rect = card.getBoundingClientRect();

    activeSplitCardModal = modalEl;
    activeSplitCardElement = card;

    modalEl.classList.add('split-card-scoped-modal');
    modalEl.style.setProperty('--split-card-top', rect.top + 'px');
    modalEl.style.setProperty('--split-card-left', rect.left + 'px');
    modalEl.style.setProperty('--split-card-width', rect.width + 'px');
    modalEl.style.setProperty('--split-card-height', rect.height + 'px');

    document.body.classList.add('split-card-modal-active');
    orderDetailsModalEl.classList.add('has-split-card-popup');
    }

    function repositionActiveSplitCardModal() {
    if (activeSplitCardModal && activeSplitCardElement && activeSplitCardModal.classList.contains('show')) {
    positionModalInsideCard(activeSplitCardModal, activeSplitCardElement);
    }
    }

    window.addEventListener('resize', repositionActiveSplitCardModal);
    document.addEventListener('scroll', repositionActiveSplitCardModal, true);
    document.addEventListener('wheel', repositionActiveSplitCardModal, true);
    document.addEventListener('touchmove', repositionActiveSplitCardModal, true);

    function clearSplitCardModalScope(modalEl) {
