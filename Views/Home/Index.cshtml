    iframe.__modalMultiOrderAutoResizeObserver = observer;
    }
    } catch (e) {
    // Ignore and keep the normal load/resize refit path.
    }

    window.setTimeout(refit, 80);
    window.setTimeout(refit, 250);
    window.setTimeout(refit, 650);
    }

