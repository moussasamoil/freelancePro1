    '<div class="reports-deduction-history-meta"><span>تم بواسطة: ' + createdBy + '</span><span>' + createdAtDeduction + '</span></div>' +
    '<div class="reports-deduction-history-reason">' + reason + '</div>' +
    '</div>';
    }

    var body = escapeHtml(item.body || '');
    var author = escapeHtml(item.authorName || 'غير معروف');
    var deletedBy = escapeHtml(item.deletedByName || 'غير معروف');
    var createdAt = escapeHtml(formatDateTime(item.createdAt));
    var deletedAt = escapeHtml(formatDateTime(item.deletedAt));
    return '<div class="reports-deleted-history-row">' +
    '<div class="reports-deleted-history-meta"><span class="reports-deleted-history-author">' + author + '</span><span>تاريخ الحذف: ' + deletedAt + '</span></div>' +
    '<div class="reports-deleted-history-meta"><span>تاريخ الإرسال: ' + createdAt + '</span><span>حذف بواسطة: ' + deletedBy + '</span></div>' +
    '<div class="reports-deleted-history-text" data-raw-body="' + body + '" title="اضغط للنسخ">' + body + '</div>' +
    '</div>';
    }).join('');
    }

    function openDeletedHistoryPanel() {
    if (!historyPanel || !historyBody || !currentOrderId) return;

    historyPanel.classList.add('show');
    historyPanel.setAttribute('aria-hidden', 'false');
    historyBody.innerHTML = '<div class="reports-deleted-history-empty">جاري تحميل السجل...</div>';

