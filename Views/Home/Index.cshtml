    function openRealDetailsActionFromTable(orderId, actionName, actionButton) {
    if (!orderId || !actionName) return;

    if (actionName === 'employee') {
    openInlineEmployeeAssignPopup(orderId);
    return;
    }

    if (actionName === 'delivery') {
    var countryId = actionButton ? actionButton.getAttribute('data-country-id') : '';
    var cityId = actionButton ? actionButton.getAttribute('data-city') : '';
    openInlineDeliveryAssignPopup(orderId, countryId, cityId);
    return;
    }

    if (actionName === 'status-direct') {
    var statusValue = actionButton ? (actionButton.getAttribute('data-status-value') || '') : '';
    var statusText = actionButton ? (actionButton.getAttribute('data-status-text') || actionButton.textContent || statusValue) : statusValue;
    if (!statusValue) {
    showTableActionToast('لم يتم تحديد حالة الطلب.');
    return;
    }
    changeInlineOrderStatusWithConfirm(orderId, statusValue, statusText);
    return;
    }

    // تعديل الطلب: نفس مودال التعديل الأصلي المستخدم داخل تفاصيل الطلب.
    if (actionName === 'edit') {
    openDirectEditOrderPopup(orderId);
    return;
    }

    // إلغاء الطلب: يشغل نفس تأكيد الإلغاء الأصلي، بدون فتح تفاصيل الطلب.
    if (actionName === 'cancel') {
    triggerOriginalDetailsActionHidden(orderId, actionName);
    return;
    }

    // حالة الدفع: لا نستخدم Dropdown تفاصيل الطلب هنا لأن بعض النسخ
    // بتعمل match بالغلط مع Dropdown تعيين الموظف. افتحي Popup الدفع المباشر.
    if (actionName === 'payment') {
    openDirectPaymentPopup(orderId);
    return;
    }

    // تأجيل الطلب وحالة الطلب: افتحيهم من الجدول في مودال صغير أبيض
    // بدل ما ننقل Dropdown التفاصيل ونخاطر إنه يختفي أو يفتح بشكل غير مضبوط.
    if (actionName === 'postpone') {
    openDirectPostponePopup(orderId);
    return;
    }

    if (actionName === 'status') {
    openDirectStatusPopup(orderId);
    return;
    }

    if (actionName === 'processed') {
    openInlineProcessingImagePopup(orderId);
    return;
    }

    if (actionName === 'resend') {
    changeInlineOrderStatusWithConfirm(orderId, 'طلب_جديد', 'إعادة إرسال الطلب');
    return;
    }

    var loader = document.createElement('div');
    loader.style.position = 'absolute';
    loader.style.left = '-99999px';
    loader.style.top = '-99999px';
    loader.style.width = '1px';
    loader.style.height = '1px';
    loader.style.overflow = 'hidden';
    document.body.appendChild(loader);

    $.ajax({
    url: '/Order/DetailsPartial/' + encodeURIComponent(orderId),
    type: 'GET',
    success: function (html) {
    injectInlineDetailsHtml(loader, html);
    var $loader = $(loader);
    var partial = $loader.find('.order-details-partial')[0] || loader;

    var $target = getRealDetailsActionTarget($loader, actionName);
    if (!$target.length) {
    loader.remove();
    showTableActionToast('الإجراء غير متاح لهذا الطلب.');
    return;
    }

    var $box = getRealDetailsActionBox($target, actionName);
    if (!$box.length) {
    loader.remove();
    showTableActionToast('الإجراء غير متاح لهذا الطلب.');
    return;
    }

    // Move the exact DetailsPartial action control into a small visible modal,
    // then initialise the details script on that visible content.
    showInlineDetailsActionModal(orderId, actionName, $box, $target);
    loader.remove();
    },
    error: function () {
    try { loader.remove(); } catch (e) { }
    showTableActionToast('تعذر تحميل الإجراء.');
    }
    });
    }

    function openTableActionDirectly(orderId, actionName, actionButton) {
    if (!orderId || !actionName) return;
    openRealDetailsActionFromTable(orderId, actionName, actionButton);
    }

    function updateInlineActionArrow(shell) {
    if (!shell) return;

    var toggleText = shell.querySelector('.actions-toggle-text');
    var toggleButton = shell.querySelector('.order-row-actions-toggle');
    var isOpen = shell.classList.contains('is-open');

    if (toggleText) {
    toggleText.innerHTML = isOpen ? '&#8250;' : '&#8249;';
    }

    if (toggleButton) {
    toggleButton.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
    toggleButton.setAttribute('title', isOpen ? 'الإجراءات مفتوحة' : 'إظهار الإجراءات');
    toggleButton.setAttribute('aria-label', isOpen ? 'الإجراءات مفتوحة' : 'إظهار الإجراءات');
    }
    }


    function getInlineActionsShift(shell) {
    if (!shell) return 430;

    var panel = shell.querySelector('.order-row-actions-panel');
    if (panel && panel.offsetWidth > 0) {
    return panel.offsetWidth;
    }

    var count = parseInt(shell.getAttribute('data-actions-count') || shell.style.getPropertyValue('--inline-actions-count') || '5', 10);
    if (!count || count < 1) count = 5;

    var actionBtnWidth = window.matchMedia && window.matchMedia('(max-width: 1400px)').matches ? 78 : 86;
    return count * actionBtnWidth;
    }

    function openInlineRowActionsShell(shell) {
    if (!shell) return;

    document.querySelectorAll('.order-row-actions-shell.is-open').forEach(function (openShell) {
    if (openShell !== shell) {
    closeInlineRowActionsShell(openShell);
    }
    });

    shell.classList.add('is-open');
    updateInlineActionArrow(shell);

    var row = shell.closest('tr');
    if (row) {
    row.classList.add('row-actions-open');
    row.style.setProperty('--inline-actions-shift', getInlineActionsShift(shell) + 'px');
    }
    }

    function closeInlineRowActionsShell(shell) {
    if (!shell) return;

    shell.classList.remove('is-open');
    shell.removeAttribute('data-inline-action-busy');
    updateInlineActionArrow(shell);

    var row = shell.closest('tr');
    if (row) {
    row.classList.remove('row-actions-open');
    row.style.removeProperty('--inline-actions-shift');
    }
    }

    function closeAllInlineRowActions() {
    document.querySelectorAll('.order-row-actions-shell.is-open').forEach(function (openShell) {
    closeInlineRowActionsShell(openShell);
    });

    if (document.activeElement && document.activeElement.blur) {
    document.activeElement.blur();
    }
    }

    window.closeAllInlineRowActions = closeAllInlineRowActions;

    // لا نقفل إجراءات الصف بمجرد إغلاق أي مودال.
    // القفل يتم فقط بعد نجاح العملية فعليًا، أو يدويًا من نفس السهم.
    ['pointerdown', 'mousedown', 'touchstart'].forEach(function (eventName) {
    document.addEventListener(eventName, function (e) {
    if (!e.target.closest('.order-row-actions-cell, .order-row-actions-shell, .order-table-action-btn, .order-row-actions-toggle')) return;
    e.stopPropagation();
    if (typeof e.stopImmediatePropagation === 'function') {
    e.stopImmediatePropagation();
    }
    }, true);
    });


    // إغلاق إجراءات الصف بعد نجاح العملية فقط.
    // يغطي عمليات التعديل التي تتم من مودال منفصل ولا تمر دائمًا عبر afterInlineOrderAction.
    if (window.jQuery && !window.__inlineOrderActionsSuccessCloseHookBound) {
    window.__inlineOrderActionsSuccessCloseHookBound = true;

    $(document).ajaxSuccess(function (event, xhr, settings, response) {
    var url = (settings && settings.url ? settings.url : '').toLowerCase();

    var isOrderActionSuccess =
    url.indexOf('/order/edit') !== -1 ||
    url.indexOf('/order/updatestatus') !== -1 ||
    url.indexOf('/order/postponeorder') !== -1 ||
    url.indexOf('/order/setispaid') !== -1 ||
    url.indexOf('/order/transferorderwarehouse') !== -1 ||
    url.indexOf('/order/updateorderapplicationuser') !== -1 ||
    url.indexOf('/home/editorder') !== -1;

    if (!isOrderActionSuccess) return;

    if (response && response.success === false) return;

    window.setTimeout(function () {
    if (typeof window.closeAllInlineRowActions === 'function') {
    window.closeAllInlineRowActions();
    }
    }, 250);
    });
    }

    document.addEventListener('click', function (e) {
    var toggle = e.target.closest('.order-row-actions-toggle');
    if (!toggle) return;

    stopTableEvent(e);

    var shell = toggle.closest('.order-row-actions-shell');
    if (!shell) return;

    // لو مفتوحة بالفعل، اقفلها يدويًا عادي طالما المستخدم لم يختار عملية.
    // لو اختار عملية وفتح مودال، المودال نفسه سيقفل الإجراءات بعد الإغلاق/النجاح.
    if (shell.classList.contains('is-open')) {
    closeInlineRowActionsShell(shell);
    return;
    }

    openInlineRowActionsShell(shell);
    }, true);

    document.addEventListener('click', function (e) {
    var actionButton = e.target.closest('.order-table-action-btn');
    if (!actionButton) return;

    stopTableEvent(e);

    var orderId = actionButton.getAttribute('data-order-id');
    var actionName = actionButton.getAttribute('data-order-table-action');

    // لا نقفل إجراءات الصف هنا.
    // المطلوب إنها تفضل مفتوحة لحد ما بوب أب العملية يتقفل أو العملية تنجح.
    var shell = actionButton.closest('.order-row-actions-shell');
    if (shell) {
    shell.setAttribute('data-inline-action-busy', 'true');
    openInlineRowActionsShell(shell);
    }

    window.setTimeout(function () {
    openTableActionDirectly(orderId, actionName, actionButton);
    }, 20);
    }, true);

    document.addEventListener('click', function (e) {
    // لا تقفل الإجراءات بالضغط خارجها.
    // هتتقفل بعد إغلاق بوب أب العملية فقط.
    if (e.target.closest('.order-row-actions-shell, #inlineRealDetailsActionHost')) return;
    });
    })();
</script>

