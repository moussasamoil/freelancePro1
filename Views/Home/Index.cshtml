    fetch((postType === POST_TYPE_EDIT_NOTE && canFollowUpManageEditNotes) ? '/OrderPosts/DeleteEditNoteWithHistory' : ((postType === POST_TYPE_PROBLEM && canSendProblemDeduction) ? '/OrderPosts/DeletePostWithHistory' : '/OrderPosts/Delete'), {
    method: 'POST',
    body: fd,
