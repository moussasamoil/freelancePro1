    clearComposer();
    loadPosts();
    if (typeof refreshPanels === 'function') refreshPanels();
    if (currentOrderId && typeof refreshOrderHeaderCounts === 'function') refreshOrderHeaderCounts(currentOrderId);
    showDeductionSuccessPopup('تم إرسال الخصم على الموظف');
