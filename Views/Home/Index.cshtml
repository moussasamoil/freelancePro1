    }

    $('.table-responsive > .table').hide();
    $('#pagination-link').hide();
    $('#noDataPlaceholder').attr('style', 'height: 50vh !important;');

    }
    });
    }

    // Expose for any later dynamic scripts/fixes without duplicating the original logic.
    window.homeLoadData = loadData;


