    // ----- ملاحظة الطلب chat modal (OrderNote — postType=2) -----
    // Wires the chat-shell partial to /OrderPosts/Create|List for OrderNote posts.
    // Visual: own posts right (sent/green), others' left (received/gray); oldest top, newest bottom.
    (function () {
    var modal = document.getElementById('orderNotesDummyModal');
    if (!modal) return;
    var messagesEl = modal.querySelector('#ondMessages');
    var inputEl = modal.querySelector('#ondComposerInput');
    var sendBtn = modal.querySelector('#ondSendBtn');
    var attachPreview = modal.querySelector('#ondAttachPreview');
    var storeImg = modal.querySelector('#ondStoreImage');
    var storeName = modal.querySelector('#ondStoreName');
    var sourceLabel = modal.querySelector('#ondSourceLabel');
    var pendingFiles = [];
    var currentOrderId = null;

    function fmtTime(iso) {
    if (!iso) return '';
    var s = String(iso).replace('T', ' ');
    var dot = s.indexOf('.');
    if (dot > -1) s = s.substring(0, dot);
    return s.length >= 16 ? s.substring(11, 16) : s;
    }

    function syncPreviewVisibility() {
    attachPreview.style.display = attachPreview.children.length ? 'flex' : 'none';
    }

    function addImageFile(file) {
    if (!file || !file.type || !file.type.startsWith('image/')) return;
    pendingFiles.push(file);
    var fileRef = file;
    var reader = new FileReader();
    reader.onload = function (e) {
    var thumb = document.createElement('div');
    thumb.className = 'ond-attach-thumb';
    var img = document.createElement('img');
    img.src = e.target.result;
    var rm = document.createElement('button');
    rm.type = 'button';
    rm.className = 'ond-attach-thumb-remove';
    rm.textContent = '×';
    rm.addEventListener('click', function () {
    var idx = pendingFiles.indexOf(fileRef);
    if (idx > -1) pendingFiles.splice(idx, 1);
    thumb.remove();
    syncPreviewVisibility();
    });
    thumb.appendChild(img);
    thumb.appendChild(rm);
    attachPreview.appendChild(thumb);
    syncPreviewVisibility();
    };
    reader.readAsDataURL(file);
    }

    // Enter sends; Shift+Enter inserts a newline.
    inputEl.addEventListener('keydown', function (e) {
    if (e.key === 'Enter' && !e.shiftKey && !e.ctrlKey && !e.altKey && !e.metaKey) {
    e.preventDefault();
    if (!sendBtn.disabled) sendBtn.click();
    }
    });

    inputEl.addEventListener('paste', function (e) {
    var items = e.clipboardData && e.clipboardData.items;
    if (!items) return;
    var handled = false;
    for (var i = 0; i < items.length; i++) {
    if (items[i].kind === 'file' && items[i].type.indexOf('image/') === 0) {
    var file = items[i].getAsFile();
    if (file) { addImageFile(file); handled = true; }
    }
    }
    if (handled) e.preventDefault();
    });

    function clearComposer() {
    inputEl.value = '';
    pendingFiles = [];
    attachPreview.innerHTML = '';
    syncPreviewVisibility();
    }

    function scrollToBottom() {
    messagesEl.scrollTop = messagesEl.scrollHeight;
    }

    function renderBubble(post) {
    var side = post.isCurrentUser ? 'right' : 'left';
    var bubbleCls = post.isCurrentUser ? 'sent' : 'received';
    var imagesHtml = '';
    if (post.images && post.images.length) {
    imagesHtml = '<div class="ond-bubble-images">' + post.images.map(function (img) {
    var url = escapeHtml(img.url);
    return '<a href="' + url + '" target="_blank" rel="noopener"><img src="' + url + '" alt="" /></a>';
    }).join('') + '</div>';
    }
    var bodyHtml = post.body ? escapeHtml(post.body) : '';
    return '<div class="ond-row ' + side + '" data-post-id="' + post.id + '">' +
    '<div class="ond-meta">' +
    '<span class="ond-meta-name">' + escapeHtml(post.authorName || '') + '</span>' +
    '<span>' + escapeHtml(fmtTime(post.createdAt)) + '</span>' +
    '</div>' +
    imagesHtml +
    (bodyHtml ? '<div class="ond-bubble ' + bubbleCls + ' group-end">' + bodyHtml + '</div>' : '') +
    '</div>';
    }

    function applyOrderHeader(order) {
    if (!order) {
    storeImg.src = '';
    storeImg.style.visibility = 'hidden';
    storeName.textContent = '';
    sourceLabel.textContent = '';
    return;
    }
    if (order.storeImage) {
    storeImg.src = order.storeImage;
    storeImg.style.visibility = 'visible';
    } else {
    storeImg.src = '';
    storeImg.style.visibility = 'hidden';
    }
    storeName.textContent = order.storeName || '';
    sourceLabel.textContent = order.sourceLabel || '';
    }

    function loadPosts() {
    if (!currentOrderId) return;
    messagesEl.innerHTML = '<div class="ond-empty">جاري التحميل...</div>';
    fetch('/OrderPosts/List?orderId=' + encodeURIComponent(currentOrderId) + '&type=' + POST_TYPE_ORDER_NOTE, {
    credentials: 'same-origin'
    })
    .then(function (r) { if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); })
    .then(function (data) {
    applyOrderHeader(data && data.order);
    var posts = (data && data.posts) || [];
    // List() returns newest-first — reverse so oldest sits at top, newest at bottom.
    posts = posts.slice().reverse();
    if (posts.length === 0) {
    messagesEl.innerHTML = '<div class="ond-empty">لا توجد ملاحظات بعد</div>';
    return;
    }
    messagesEl.innerHTML = posts.map(renderBubble).join('');
    scrollToBottom();
    })
    .catch(function (err) {
    console.error('OrderPosts.List (notes chat) failed:', err);
    messagesEl.innerHTML = '<div class="ond-empty">تعذر التحميل</div>';
    });
    }

    modal.addEventListener('show.bs.modal', function () {
    var detailsEl = document.getElementById('orderDetailsModal');
    currentOrderId = detailsEl ? detailsEl.dataset.orderId : null;
    clearComposer();
    loadPosts();
    });

    sendBtn.addEventListener('click', function () {
    if (!currentOrderId) return;
    var body = inputEl.value.trim();
    if (!body && pendingFiles.length === 0) return;

    var fd = new FormData();
    fd.append('orderId', currentOrderId);
    fd.append('type', POST_TYPE_ORDER_NOTE);
    if (body) fd.append('body', body);
    pendingFiles.forEach(function (f) { fd.append('images', f); });
    appendAntiforgery(fd);

    sendBtn.disabled = true;
    fetch('/OrderPosts/Create', {
    method: 'POST',
    body: fd,
    credentials: 'same-origin'
    })
    .then(function (r) {
    if (!r.ok) return r.json().then(function (j) { throw new Error(j.message || 'HTTP ' + r.status); });
    return r.json();
    })
    .then(function () {
    clearComposer();
    loadPosts();
    if (typeof refreshOrderHeaderCounts === 'function') refreshOrderHeaderCounts(currentOrderId);
    playOrderPostSound(POST_TYPE_ORDER_NOTE);
    })
    .catch(function (err) {
    console.error('OrderPosts.Create (notes chat) failed:', err);
    alert(err.message || 'فشل إرسال الملاحظة');
    })
    .finally(function () { sendBtn.disabled = false; });
    });
    })();

    // ----- Header panels (الإبلاغات / التعديلات المطلوبة) -----
    // Each panel shows ONE card per order with at least one un-acknowledged post of that type, latest message snippet.
    // Search filters by order ID only (per spec).
    var panelDefs = [
    { type: POST_TYPE_PROBLEM, rootId: 'reportsDropdown', triggerId: 'reportsTrigger', key: 'problem', icon: '/static/report-icon.png' },
    { type: POST_TYPE_EDIT_NOTE, rootId: 'editNotesDropdown', triggerId: 'editNotesTrigger', key: 'editNote', icon: '/static/order-edit-requests-icon.png' }
    ];

    function renderPanelGroups(rootEl, groups, def) {
    // Keep the existing search-shadow-wrapper (1st child) intact; replace anything after it.
    while (rootEl.children.length > 1) rootEl.removeChild(rootEl.lastChild);

    (groups || []).forEach(function (g) {
    var wrapper = document.createElement('div');
    wrapper.className = 'date-group-wrapper f-s-14 mt-2';
    var header = document.createElement('p');
    header.className = 'text-green me-3';
    header.textContent = g.date;
    wrapper.appendChild(header);

    var container = document.createElement('div');
    container.className = 'shadowed-container';

    (g.cards || []).forEach(function (c, idx) {
    var row = document.createElement('div');
    row.className = 'row bell-card pointer' + (idx < g.cards.length - 1 ? ' shadowed-container-border-bottom' : '');
    row.setAttribute('data-order-id', c.orderId);

    // Click opens the order-details modal — same UX as the bell-icon notifications panel.
    row.addEventListener('click', function () {
    if (typeof window.openOrderDetails === 'function') {
    window.openOrderDetails(c.orderId);
    // Close the dropdown so the modal isn't visually behind it.
    rootEl.style.display = 'none';
    }
    });

    var col1 = document.createElement('div');
    col1.className = 'col-2 d-flex justify-content-start align-items-center pe-0';
    col1.innerHTML = '<img src="' + (def && def.icon ? def.icon : '/static/reports-icon.jpg') + '" style="max-width:19px;max-height:19px;padding-right:6px;box-sizing:unset;" />';

    var col2 = document.createElement('div');
    col2.className = 'col-10 ps-0';
    col2.innerHTML =
    '<p class="f-s-14">' + escapeHtml(c.country || '') + '</p>' +
    '<p class="f-s-14">طلب رقم ' + escapeHtml(String(c.orderId)) + '</p>' +
    '<p class="f-s-14">' + escapeHtml(formatDateTime(c.createdAt)) + '</p>' +
    '<p class="f-s-14">' + escapeHtml((c.authorName ? c.authorName + ' — ' : '') + (c.snippet || '')) + '</p>';

    row.appendChild(col1);
    row.appendChild(col2);
    container.appendChild(row);
    });

    wrapper.appendChild(container);
    rootEl.appendChild(wrapper);
    });

    if (!groups || groups.length === 0) {
    var empty = document.createElement('div');
    empty.className = 'text-center text-muted py-3';
    empty.textContent = 'لا توجد عناصر';
    rootEl.appendChild(empty);
    }
    }

    function applyPanelSearch(rootEl, query) {
    var q = (query || '').trim();
    rootEl.querySelectorAll('.date-group-wrapper').forEach(function (group) {
    var visibleInGroup = 0;
    group.querySelectorAll('[data-order-id]').forEach(function (card) {
    var match = !q || String(card.getAttribute('data-order-id')).indexOf(q) !== -1;
    card.style.display = match ? '' : 'none';
    if (match) visibleInGroup++;
    });
    group.style.display = visibleInGroup > 0 ? '' : 'none';
    });
    }

    function refreshPanels() {
    // Skip the request entirely if neither panel exists (non-admin pages).
    var anyPanel = panelDefs.some(function (p) { return document.getElementById(p.rootId); });
    if (!anyPanel) return;

    fetch('/OrderPosts/Panels', { credentials: 'same-origin' })
    .then(function (r) { if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); })
    .then(function (data) {
    panelDefs.forEach(function (def) {
    var root = document.getElementById(def.rootId);
    var trigger = document.getElementById(def.triggerId);
    if (!root) return;
    var panel = (data && data[def.key]) || { count: 0, groups: [] };
    renderPanelGroups(root, panel.groups, def);
    if (trigger) {
    var badge = trigger.querySelector('.dummy-count-badge');
    if (badge) {
    if (panel.count > 0) {
    badge.textContent = panel.count;
    badge.style.display = '';
    } else {
    badge.textContent = '';
    badge.style.display = 'none';
    }
    }
    }
    // Reapply current search filter so a SignalR refresh doesn't drop the user's query.
    var searchInput = document.getElementById(def.key === 'problem' ? 'reportsSearch' : 'editNotesSearch');
    if (searchInput && searchInput.value) applyPanelSearch(root, searchInput.value);
    });
    })
    .catch(function (err) { console.error('OrderPosts.Panels failed:', err); });
    }

    // Wire search inputs (order-id only). The existing reportsSearchClear / editNotesSearchClear icons
    // toggle visibility via the existing handler; we hook only the filter behavior here.
    ['reports', 'editNotes'].forEach(function (key) {
    var input = document.getElementById(key + 'Search');
    var rootId = key === 'reports' ? 'reportsDropdown' : 'editNotesDropdown';
    if (!input) return;
    input.addEventListener('input', function () {
    var root = document.getElementById(rootId);
    if (root) applyPanelSearch(root, input.value);
    });
    });

    // ----- Order-details header per-order badges -----
    // Mirrors the home-page header badges but scoped to the currently-open order.
    function setHeaderBadge(id, count) {
    var el = document.getElementById(id);
    if (!el) return;
    if (count > 0) {
    el.textContent = count;
    el.style.display = '';
    } else {
    el.textContent = '';
    el.style.display = 'none';
    }
    }

    function refreshOrderHeaderCounts(orderId) {
    if (!orderId) return;
    fetch('/OrderPosts/OrderCounts?orderId=' + encodeURIComponent(orderId), { credentials: 'same-origin' })
    .then(function (r) { if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); })
    .then(function (data) {
    // Drop late responses if the user already navigated to a different order.
    var details = document.getElementById('orderDetailsModal');
    if (!details || String(details.dataset.orderId) !== String(orderId)) return;
    setHeaderBadge('orderDetailsHeaderProblemBadge', data.problem || 0);
    setHeaderBadge('orderDetailsHeaderEditNoteBadge', data.editNote || 0);
    setHeaderBadge('orderDetailsHeaderOrderNoteBadge', data.orderNote || 0);
    })
    .catch(function (err) { console.error('OrderPosts.OrderCounts failed:', err); });
    }

    var orderDetailsModalElForCounts = document.getElementById('orderDetailsModal');
    if (orderDetailsModalElForCounts) {
    orderDetailsModalElForCounts.addEventListener('show.bs.modal', function () {
    // Reset badges before the new fetch so previous order's counts don't linger.
    setHeaderBadge('orderDetailsHeaderProblemBadge', 0);
    setHeaderBadge('orderDetailsHeaderEditNoteBadge', 0);
    setHeaderBadge('orderDetailsHeaderOrderNoteBadge', 0);
    refreshOrderHeaderCounts(this.dataset.orderId);
    });
    }

    // Initial fetch on page load + SignalR push refresh.
    refreshPanels();
    if (typeof connection !== 'undefined' && connection && typeof connection.on === 'function') {
    connection.on('newOrderPost', function (orderId, type) {
    refreshPanels();
    // Live notification sound — server only sends this event to OrderPostListeners
    // (Admin/FollowUpDepartment/ExecutiveDirector) and never for OrderNote, so no
    // client-side role gate is needed here.
    playOrderPostSound(parseInt(type, 10));
    // If the order-details modal is open on the affected order, refresh its header badges too.
    var details = document.getElementById('orderDetailsModal');
    if (details && String(details.dataset.orderId) === String(orderId)) {
    refreshOrderHeaderCounts(orderId);
    }
    });
    }
    });
</script>


@if (isInvestigationPage || User.IsInRole("Admin") || User.IsInRole("ExecutiveDirector") || User.IsInRole("FollowUpDepartment"))
{
