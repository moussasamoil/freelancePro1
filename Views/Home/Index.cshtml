    <div class="table-responsive">
        <table class="table  mt-2 mb-0 mb-lg-2 mx-auto width-99" id="ordersTable">
            <thead>
                <tr>
                    <th>رقم الوصل</th>
                    @if (User.IsInRole("Admin") || User.IsInRole("ExecutiveDirector"))
                    {
                        <th class="d-none d-xl-table-cell">اسم الموظف</th>
                    }
                    <th class="d-none d-xl-table-cell">اسم الزبون</th>
                    <th>رقم الهاتف</th>
                    <th class="d-none d-md-table-cell">تاريخ الأنشاء</th>
                    @if (!User.IsInRole("DeliveryCompany") && !User.IsInRole("DeliveryRepresentative"))
                    {
                        <th class="d-none d-md-table-cell home-country-col">الدولة</th>
                    }
                    <th class="d-none d-md-table-cell">المدينة</th>
                    @if (!User.IsInRole("DeliveryCompany") && !User.IsInRole("DeliveryRepresentative"))
                    {
                        <th class="d-none d-xl-table-cell">نوع الصفحة</th>
                        <th class="d-none d-xl-table-cell">اسم الصفحة</th>
                    }
                    <th class="d-none d-md-table-cell">المتجر</th>

                    @if (!User.IsInRole("DeliveryCompany") && !User.IsInRole("DeliveryRepresentative"))
                    {
                        <th class="d-none d-xl-table-cell">شركة التوصيل</th>
                    }
                    <th class="d-none d-md-table-cell">اخر تحديث</th>
                    <th>حالة الطلب</th>
                    @if (User.IsInRole("CallCenter"))
                    {
                        <th>عمولاتي</th>
                        <th>مؤشر البيع</th>
                    }
                    @* @if (User.IsInRole("Admin"))
                {
                <th>سعر التوصيل</th>
                } *@
                    <th>قيمة المبلغ</th>
                    <th class="d-none d-md-table-cell">مراسلة</th>

                    <th class="d-none d-lg-table-cell">المنتجات</th>
                    <th class="d-none d-lg-table-cell order-row-actions-header">الإجراءات</th>
                </tr>
            </thead>
            <tbody>
                @{
                    var homeOrderPinDisplayIndex = 0;
                    var previouslyDelayedOrderIds = ViewBag.PreviouslyDelayedOrderIds as System.Collections.Generic.IEnumerable<int>
                        ?? System.Linq.Enumerable.Empty<int>();
                    var previouslyDelayedOrderIdSet = new System.Collections.Generic.HashSet<int>(previouslyDelayedOrderIds);
                }
                @foreach (var order in Model.PaginationViewModel.Items)
                {
                    var statusClass = Common.GetOrderStatusClass(order.OrderStatus);

                    var homeCountryKey = order.Country.ToString();
                    var homeCountryImageUrl = (Model.CountryImageUrls != null && Model.CountryImageUrls.ContainsKey(homeCountryKey))
                    ? Model.CountryImageUrls[homeCountryKey]
                    : null;

                    var homeOrderSourceKey = order.OrderSource.ToString();
                    var homeOrderSourceImageUrl = (Model.SocialMediaIconUrls != null && Model.SocialMediaIconUrls.ContainsKey(homeOrderSourceKey))
                    ? Model.SocialMediaIconUrls[homeOrderSourceKey]
                    : null;

                    @* DEAD: homePhoneCopy stripped country code on copy; phone now copies the displayed value. *@
                    @* var homeOrderCountryName = order.Country.ToString();
            var homeStripCountryCode = ShouldStripCountryCodeForDisplay(order.Country) || order.Country == Common.Countries.ليبيا;
            var homePhoneCopy = homeStripCountryCode
            ? StripCountryCodeAndLeadingZero(order.TelephoneNumber, homeOrderCountryName)
            : NormalizePhoneForDisplay(order.TelephoneNumber, homeOrderCountryName); *@
                    var homePhoneDisplay = PhoneForDisplay(order.TelephoneNumber, order.Country);
                    var homePhoneCopy = order.Country == Common.Countries.ليبيا
                        ? StripCountryCodeAndLeadingZero(order.TelephoneNumber, order.Country.ToString())
                        : homePhoneDisplay;
                    string homeOrderCountry = order.Country.ToString();
                    string homePhoneCode = Common.GetPhoneNumberCodeByCountryStatus(homeOrderCountry);
                    string homePhoneNumber = order.TelephoneNumber;
                    string homeWhatsappUrl = $"https://wa.me/{homePhoneCode}{homePhoneNumber}";
                    string homeOrderSourceText = order.OrderSource.ToString();
                    bool isMeta = order.OrderSource == OrderSourceEnum.فيسبوك
                    || order.OrderSource == OrderSourceEnum.انستغرام
                    || homeOrderSourceText.Contains("ميتا")
                    || homeOrderSourceText.Contains("Meta");
                    int processedFlowCount = GetProcessedFlowCount(order);
                    var homeDeliveryCost = GetHomeOrderDeliveryCost(order);
                    var homeCurrencySymbol = Model.CurrencySymbols[(order.Country.ToString())];
                    bool orderWasProcessedInFlow = order.OrderStatus == OrderStatusEnum.تم_المعالجة || order.FixedOrderDate.HasValue || processedFlowCount > 0;
                    if (orderWasProcessedInFlow && processedFlowCount < 1)
                    {
                        processedFlowCount = 1;
                    }

                    bool orderWasPreviouslyDelayed =
                        order.OrderStatus == OrderStatusEnum.طلب_جديد
                        && (previouslyDelayedOrderIdSet.Contains(order.Id) || OrderHasPreviouslyDelayedStatus(order));

                    bool canUseInlineOrderAdminActions = User.IsInRole("Admin")
                    || User.IsInRole("ExecutiveDirector")
                    || User.IsInRole("CallCenter")
                    || User.IsInRole("FollowUpDepartment");

                    bool canUseOrderPinAction = User.IsInRole("Admin")
                    || User.IsInRole("ExecutiveDirector")
                    || User.IsInRole("FollowUpDepartment")
                    || User.IsInRole("CallCenter");

                    bool canUseInlineDeliveryStatusAction = User.IsInRole("DeliveryCompany")
                    || User.IsInRole("DeliveryRepresentative");

                    bool inlineEditLockedForCallCenter = User.IsInRole("CallCenter")
                    && (order.OrderStatus == OrderStatusEnum.تم_التجهيز
                    || order.OrderStatus == OrderStatusEnum.قيد_التوصيل
                    || order.OrderStatus == OrderStatusEnum.تم_التسليم
                    || order.OrderStatus == OrderStatusEnum.تم_تحديث_الرصيد
                    || order.OrderStatus == OrderStatusEnum.تم_الدفع);

                    bool inlineEditLockedForFollowUp = User.IsInRole("FollowUpDepartment")
                    && (order.OrderStatus == OrderStatusEnum.تم_التسليم
                    || order.OrderStatus == OrderStatusEnum.تم_تحديث_الرصيد
                    || order.OrderStatus == OrderStatusEnum.تم_الدفع);

                    bool showInlineEditAction = canUseInlineOrderAdminActions
                    && !inlineEditLockedForCallCenter
                    && !inlineEditLockedForFollowUp;

                    bool showInlinePaymentAction = canUseInlineOrderAdminActions;
                    bool showInlineCancelAction = canUseInlineOrderAdminActions;
                    bool showInlinePostponeAction = canUseInlineOrderAdminActions;

                    // في الكول سنتر: بدل زر "حالة طلب" نعرض زر "تسليم مؤقت" مباشر.
                    // باقي صلاحيات الإدارة والمتابعة يظل عندهم زر "حالة طلب" كما هو.
                    bool showInlineCallCenterTempDeliveryAction = User.IsInRole("CallCenter");
                    bool showInlineResendOrderAction = User.IsInRole("CallCenter");
                    bool showInlineStatusAction = canUseInlineOrderAdminActions && !User.IsInRole("CallCenter");
                    var inlineDeliveryCurrentStatusText = order.OrderStatus.ToString();
                    bool inlineDeliveryIsDelivered = inlineDeliveryCurrentStatusText == "تم_التسليم";
                    bool inlineDeliveryIsFailureStatus = inlineDeliveryCurrentStatusText == "فشل_التسليم"
                    || inlineDeliveryCurrentStatusText == "فشل_التسليم_2"
                    || inlineDeliveryCurrentStatusText == "فشل_التسليم_3"
                    || inlineDeliveryCurrentStatusText == "فشل_التسليم_4"
                    || inlineDeliveryCurrentStatusText == "فشل_التسليم_5"
                    || inlineDeliveryCurrentStatusText == "فشل_التسليم_6"
                    || inlineDeliveryCurrentStatusText == "فشل_التسليم_7";
                    bool inlineDeliveryCanMoveToInDelivery = inlineDeliveryCurrentStatusText == "تم_التجهيز";

                    int inlineDeliveryStatusActionsCount = 0;
                    if (canUseInlineDeliveryStatusAction && !canUseInlineOrderAdminActions)
                    {
                        inlineDeliveryStatusActionsCount = inlineDeliveryIsDelivered
                        ? 1
                        : (inlineDeliveryIsFailureStatus ? 1 : (inlineDeliveryCanMoveToInDelivery ? 4 : 3));
                    }
                    bool showInlineDeliveryDirectStatusActions = inlineDeliveryStatusActionsCount > 0;

                    // نفس أزرار تفاصيل الطلب داخل إجراءات الاندكس.
                    bool showInlineAssignEmployeeAction = User.IsInRole("Admin") || User.IsInRole("ExecutiveDirector");
                    bool showInlineAssignDeliveryAction = canUseInlineOrderAdminActions;
                    bool showInlineProcessedAction = canUseInlineOrderAdminActions;

                    bool showAnyInlineOrderAction = canUseOrderPinAction
                    || showInlineAssignEmployeeAction
                    || showInlineAssignDeliveryAction
                    || showInlineProcessedAction
                    || showInlineEditAction
                    || showInlinePaymentAction
                    || showInlineCancelAction
                    || showInlinePostponeAction
                    || showInlineCallCenterTempDeliveryAction
                    || showInlineResendOrderAction
                    || showInlineStatusAction
                    || showInlineDeliveryDirectStatusActions;

                    int inlineOrderActionsCount = 0;
                    if (canUseOrderPinAction) inlineOrderActionsCount++;
                    if (showInlineAssignEmployeeAction) inlineOrderActionsCount++;
                    if (showInlineAssignDeliveryAction) inlineOrderActionsCount++;
                    if (showInlineProcessedAction) inlineOrderActionsCount++;
                    if (showInlineEditAction) inlineOrderActionsCount++;
                    if (showInlinePaymentAction) inlineOrderActionsCount++;
                    if (showInlineCancelAction) inlineOrderActionsCount++;
                    if (showInlinePostponeAction) inlineOrderActionsCount++;
                    if (showInlineCallCenterTempDeliveryAction) inlineOrderActionsCount++;
                    if (showInlineResendOrderAction) inlineOrderActionsCount++;
                    if (showInlineStatusAction) inlineOrderActionsCount++;
                    inlineOrderActionsCount += inlineDeliveryStatusActionsCount;

                    var callCenterCommissionState = GetCallCenterCommissionState(order.OrderStatus);
                    var callCenterCommissionText = GetCallCenterCommissionText(order.OrderStatus);
                    var salesIndicatorState = (order.SalesIndicatorState ?? string.Empty).Trim();
                    var salesIndicatorText = string.IsNullOrWhiteSpace(order.SalesIndicatorText) ? "لا يوجد مؤشر بيع" : order.SalesIndicatorText;
                    var salesIndicatorClass = string.IsNullOrWhiteSpace(salesIndicatorState) ? "none" : salesIndicatorState;
                    var salesIndicatorIcon = "—";
                    if (salesIndicatorState == "minimum")
                    {
                        salesIndicatorIcon = "↓";
                    }
                    else if (salesIndicatorState == "middle")
                    {
                        salesIndicatorIcon = "→";
                    }
                    else if (salesIndicatorState == "basic")
                    {
                        salesIndicatorIcon = "↑";
                    }
                    else if (salesIndicatorState == "above-basic")
                    {
                        salesIndicatorIcon = "✓";
                    }
                    var hasSalesIndicator = !string.IsNullOrWhiteSpace(salesIndicatorState);
                    var canSeeSalesIndicatorMiniForCurrentUser =
                        User.IsInRole("Admin") ||
                        User.IsInRole("ExecutiveDirector") ||
                        User.IsInRole("FollowUpDepartment");
                    bool isOrderPinnedForDisplay = canUseOrderPinAction && order.IsPinned;
                    bool isOrderAutoPinnedForDisplay = false;
                    homeOrderPinDisplayIndex++;

                    <tr class="pointer order-details @(isOrderPinnedForDisplay ? "order-row-pinned" : "")"
                        data-order-id="@order.Id"
                        data-is-pinned="@((order.IsPinned ? "true" : "false"))"
                        data-auto-pinned="@((isOrderAutoPinnedForDisplay ? "true" : "false"))"
                        data-order-source="@homeOrderSourceText"
                        data-phone-display="@homePhoneDisplay"
                        data-whatsapp-url="@homeWhatsappUrl"
                        data-chat-url="@order.chatUrl"
                        data-country-name="@homeOrderCountry"
                        data-country-image="@homeCountryImageUrl">
                        <td class="text-green text-nowrap copyable" data-copy-text="*@order.Id" data-copy-label="رقم الوصل">
                            <i class="fa-solid f-s-14 text-green fa-cube d-inline-block"></i>
