                <button type="button" id="employeeErrorModalClose" class="employee-error-modal-close">×</button>
            </div>
            <div class="employee-error-modal-body">
                <input type="hidden" id="employeeErrorId" value="" />

                <label for="employeeErrorEmployeeId">الموظف</label>
                <select id="employeeErrorEmployeeId" class="form-control"></select>

                <label for="employeeErrorText">الخطأ</label>
                <textarea id="employeeErrorText" class="form-control" rows="4" placeholder="اكتبي الخطأ هنا..."></textarea>

                <label for="employeeErrorImageFile">صورة الخطأ</label>
                <input type="file" id="employeeErrorImageFile" class="form-control" accept="image/*" />
                <img id="employeeErrorImagePreview" class="employee-error-image-preview" alt="صورة الخطأ" />
            </div>
            <div class="employee-error-modal-actions">
                <button type="button" id="employeeErrorSaveBtn" class="employee-error-save-btn">حفظ</button>
                <button type="button" id="employeeErrorCancelBtn" class="employee-error-cancel-btn">إلغاء</button>
            </div>
        </div>
    </div>

    <script id="employee-errors-panel-script">
        (function () {
        var currentEmployeeErrorImageFile = null;
        var employeesLoaded = false;

        function escapeEmployeeErrorHtml(value) {
        return String(value == null ? '' : value)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
        }

        function showEmployeeErrorToast(message, isError) {
        if (typeof Toastify === 'function') {
        Toastify({
        text: message,
        duration: 3000,
        gravity: 'bottom',
        position: 'center',
        style: {
        background: isError ? '#dc3545' : '#18a088',
        borderRadius: '8px',
        fontWeight: 'bold'
        }
        }).showToast();
        return;
        }
        alert(message);
        }

        function getEmployeeErrorsBody() {
        return document.getElementById('employeeErrorsPanelBody');
        }

        function updateEmployeeErrorsBadge(count) {
        var badge = document.getElementById('employeeErrorsCountBadge');
        if (!badge) return;
        var safeCount = Number(count || 0);
        badge.textContent = safeCount;
        badge.style.display = safeCount > 0 ? 'inline-flex' : 'none';
        }

        function renderEmployeeErrorsList(items) {
        var body = getEmployeeErrorsBody();
        if (!body) return;

        if (!items || !items.length) {
        body.innerHTML = '<div class="employee-errors-empty">لا توجد أخطاء موظفين مسجلة</div>';
        updateEmployeeErrorsBadge(0);
        return;
        }

        updateEmployeeErrorsBadge(items.length);
        body.innerHTML = items.map(function (item) {
        var image = item.imageUrl
        ? '<img src="/' + escapeEmployeeErrorHtml(String(item.imageUrl).replace(/^\/+/, '')) + '" class="employee-error-image" alt="صورة الخطأ" onclick="window.open(this.src, \'_blank\')" />'
        : '';

        return '<div class="employee-error-card" data-id="' + item.id + '">'
        + '<div class="employee-error-card-top">'
        + '<div class="employee-error-info">'
        + '<div class="employee-error-employee-name"><i class="fa-solid fa-user"></i> ' + escapeEmployeeErrorHtml(item.employeeName || 'بدون موظف') + '</div>'
        + '<div class="employee-error-text">' + escapeEmployeeErrorHtml(item.errorText || '') + '</div>'
        + '<div class="employee-error-date">' + escapeEmployeeErrorHtml(item.createdAt || '') + '</div>'
        + '</div>'
        + image
        + '</div>'
        + '<div class="employee-error-actions">'
        + '<button type="button" class="employee-error-action-btn employee-error-edit-btn" data-action="edit" data-id="' + item.id + '" title="تعديل"><i class="fa-solid fa-pen"></i></button>'
        + '<button type="button" class="employee-error-action-btn employee-error-delete-btn" data-action="delete" data-id="' + item.id + '" title="حذف"><i class="fa-solid fa-trash-can"></i></button>'
        + '</div>'
        + '</div>';
        }).join('');
        }

        function loadEmployeeErrorsPanel() {
        var body = getEmployeeErrorsBody();
        if (body) body.innerHTML = '<div class="employee-errors-loading">جاري تحميل أخطاء الموظفين...</div>';

        fetch('/EmployeeErrors/Panel', { headers: { 'Accept': 'application/json' }, cache: 'no-store' })
        .then(function (response) { return response.json(); })
        .then(function (result) {
        if (!result || !result.success) {
        throw new Error(result && result.message ? result.message : 'فشل تحميل أخطاء الموظفين');
        }
        renderEmployeeErrorsList(result.items || []);
        })
        .catch(function (error) {
        if (body) body.innerHTML = '<div class="employee-errors-empty">' + escapeEmployeeErrorHtml(error.message) + '</div>';
        });
        }

        function loadEmployeeErrorsHistory(kind) {
        var body = getEmployeeErrorsBody();
        if (!body) return;

        body.innerHTML = '<div class="employee-errors-loading">جاري التحميل...</div>';
        var url = kind === 'deleted' ? '/EmployeeErrors/DeletedHistory' : '/EmployeeErrors/EditHistory';

        fetch(url, { headers: { 'Accept': 'application/json' }, cache: 'no-store' })
        .then(function (response) { return response.json(); })
        .then(function (result) {
        if (!result || !result.success) throw new Error(result && result.message ? result.message : 'فشل تحميل السجل');

        var rows = result.items || [];
        var title = kind === 'deleted' ? 'سجل المحذوفات' : 'سجل التعديلات';
        var html = '<div class="employee-errors-panel-header">'
        + '<button type="button" id="employeeErrorHistoryBackBtn" class="employee-error-back-btn"><i class="fa-solid fa-arrow-right"></i> رجوع</button>'
        + '<span style="color:#18a088;font-size:12px;font-weight:900;">' + title + '</span>'
        + '</div>';

        if (!rows.length) {
        html += '<div class="employee-errors-empty">لا يوجد سجل</div>';
        } else {
        html += rows.map(function (item) {
        var image = item.imageUrl
        ? '<img src="/' + escapeEmployeeErrorHtml(String(item.imageUrl).replace(/^\/+/, '')) + '" class="employee-error-image" alt="صورة" onclick="window.open(this.src, \'_blank\')" />'
        : '';

        var text = kind === 'deleted'
        ? (item.errorText || '')
        : ('قبل: ' + (item.oldErrorText || '') + '\nبعد: ' + (item.newErrorText || ''));

        return '<div class="employee-error-card">'
        + '<div class="employee-error-card-top">'
        + '<div class="employee-error-info">'
        + '<div class="employee-error-employee-name"><i class="fa-solid fa-user"></i> ' + escapeEmployeeErrorHtml(item.employeeName || 'بدون موظف') + '</div>'
        + '<div class="employee-error-text">' + escapeEmployeeErrorHtml(text) + '</div>'
        + '<div class="employee-error-date">' + escapeEmployeeErrorHtml(item.createdAt || item.deletedAt || '') + '</div>'
        + '</div>' + image + '</div></div>';
        }).join('');
        }

        body.innerHTML = html;
        })
        .catch(function (error) {
        body.innerHTML = '<div class="employee-errors-empty">' + escapeEmployeeErrorHtml(error.message) + '</div>';
        });
        }

        function loadActiveEmployees(callback) {
        var select = document.getElementById('employeeErrorEmployeeId');
        if (!select) return;

        if (employeesLoaded) {
        if (callback) callback();
        return;
        }

        fetch('/EmployeeErrors/ActiveEmployees', { headers: { 'Accept': 'application/json' }, cache: 'no-store' })
        .then(function (response) { return response.json(); })
        .then(function (result) {
        if (!result || !result.success) throw new Error('فشل تحميل الموظفين');
        select.innerHTML = '<option value="">اختاري الموظف</option>' + (result.items || []).map(function (employee) {
        return '<option value="' + employee.id + '">' + escapeEmployeeErrorHtml(employee.name) + '</option>';
        }).join('');
        employeesLoaded = true;
        if (callback) callback();
        })
        .catch(function () {
        showEmployeeErrorToast('فشل تحميل الموظفين', true);
        });
        }

        function openEmployeeErrorModal(item) {
        loadActiveEmployees(function () {
        var backdrop = document.getElementById('employeeErrorModalBackdrop');
        var title = document.getElementById('employeeErrorModalTitle');
        var idInput = document.getElementById('employeeErrorId');
        var employeeSelect = document.getElementById('employeeErrorEmployeeId');
        var textInput = document.getElementById('employeeErrorText');
        var fileInput = document.getElementById('employeeErrorImageFile');
        var preview = document.getElementById('employeeErrorImagePreview');

        currentEmployeeErrorImageFile = null;
        if (fileInput) fileInput.value = '';

        if (item) {
        title.textContent = 'تعديل خطأ موظف';
        idInput.value = item.id || '';
        employeeSelect.value = item.employeeId || '';
        textInput.value = item.errorText || '';
        if (item.imageUrl) {
        preview.src = '/' + String(item.imageUrl).replace(/^\/+/, '');
        preview.style.display = 'block';
        } else {
        preview.src = '';
        preview.style.display = 'none';
        }
        } else {
        title.textContent = 'إضافة خطأ موظف';
        idInput.value = '';
        employeeSelect.value = '';
        textInput.value = '';
        preview.src = '';
        preview.style.display = 'none';
        }

        backdrop.style.display = 'flex';
        });
        }

        function closeEmployeeErrorModal() {
        var backdrop = document.getElementById('employeeErrorModalBackdrop');
        if (backdrop) backdrop.style.display = 'none';
        }

        function saveEmployeeError() {
        var id = document.getElementById('employeeErrorId').value;
        var employeeId = document.getElementById('employeeErrorEmployeeId').value;
        var errorText = document.getElementById('employeeErrorText').value;
        var fileInput = document.getElementById('employeeErrorImageFile');
        var imageFile = currentEmployeeErrorImageFile || (fileInput && fileInput.files && fileInput.files[0]);

        if (!employeeId) {
        showEmployeeErrorToast('اختاري الموظف أولاً', true);
        return;
        }

        if (!errorText || !errorText.trim()) {
        showEmployeeErrorToast('اكتبي الخطأ أولاً', true);
        return;
        }

        var formData = new FormData();
        formData.append('employeeId', employeeId);
        formData.append('errorText', errorText);
        if (imageFile) formData.append('imageFile', imageFile);
        if (id) formData.append('id', id);

        fetch(id ? '/EmployeeErrors/Update' : '/EmployeeErrors/Create', {
        method: 'POST',
        body: formData
        })
        .then(function (response) { return response.json(); })
        .then(function (result) {
        if (!result || !result.success) throw new Error(result && result.message ? result.message : 'فشل الحفظ');
        closeEmployeeErrorModal();
        loadEmployeeErrorsPanel();
        showEmployeeErrorToast('تم الحفظ بنجاح', false);
        })
        .catch(function (error) {
        showEmployeeErrorToast(error.message, true);
        });
        }

        function loadEmployeeErrorForEdit(id) {
        fetch('/EmployeeErrors/Get?id=' + encodeURIComponent(id), { headers: { 'Accept': 'application/json' }, cache: 'no-store' })
        .then(function (response) { return response.json(); })
        .then(function (result) {
        if (!result || !result.success) throw new Error(result && result.message ? result.message : 'فشل تحميل الخطأ');
        openEmployeeErrorModal(result.item);
        })
        .catch(function (error) { showEmployeeErrorToast(error.message, true); });
        }

        function deleteEmployeeError(id) {
        if (!confirm('هل أنت متأكد من حذف هذا الخطأ؟')) return;
        var formData = new FormData();
        formData.append('id', id);
        fetch('/EmployeeErrors/Delete', { method: 'POST', body: formData })
        .then(function (response) { return response.json(); })
        .then(function (result) {
        if (!result || !result.success) throw new Error(result && result.message ? result.message : 'فشل الحذف');
        loadEmployeeErrorsPanel();
        showEmployeeErrorToast('تم الحذف', false);
        })
        .catch(function (error) { showEmployeeErrorToast(error.message, true); });
        }

        function deleteAllEmployeeErrors() {
        if (!confirm('هل أنت متأكد من حذف جميع أخطاء الموظفين؟')) return;
        fetch('/EmployeeErrors/DeleteAll', { method: 'POST' })
        .then(function (response) { return response.json(); })
        .then(function (result) {
        if (!result || !result.success) throw new Error(result && result.message ? result.message : 'فشل حذف الجميع');
        loadEmployeeErrorsPanel();
        showEmployeeErrorToast('تم حذف الجميع', false);
        })
        .catch(function (error) { showEmployeeErrorToast(error.message, true); });
        }

        document.addEventListener('click', function (event) {
        var trigger = event.target.closest && event.target.closest('#employeeErrorsTrigger');
        if (trigger) {
        event.preventDefault();
        var dropdown = document.getElementById('employeeErrorsDropdown');
        if (!dropdown) return;

        ['notificationDropdown', 'reportsDropdown', 'editNotesDropdown', 'leadsDropdown'].forEach(function (id) {
        var el = document.getElementById(id);
        if (el) el.style.display = 'none';
        });

        dropdown.style.display = dropdown.style.display === 'none' || !dropdown.style.display ? 'block' : 'none';
        if (dropdown.style.display === 'block') loadEmployeeErrorsPanel();
        return;
        }

        if (event.target.closest && event.target.closest('#employeeErrorAddBtn')) {
        openEmployeeErrorModal(null);
        return;
        }

        if (event.target.closest && event.target.closest('#employeeErrorDeleteAllBtn')) {
        deleteAllEmployeeErrors();
        return;
        }

        if (event.target.closest && event.target.closest('#employeeErrorEditHistoryBtn')) {
        loadEmployeeErrorsHistory('edit');
        return;
        }

        if (event.target.closest && event.target.closest('#employeeErrorDeletedHistoryBtn')) {
        loadEmployeeErrorsHistory('deleted');
        return;
        }

        if (event.target.closest && event.target.closest('#employeeErrorHistoryBackBtn')) {
        loadEmployeeErrorsPanel();
        return;
        }

        var actionBtn = event.target.closest && event.target.closest('.employee-error-action-btn');
        if (actionBtn) {
        var id = actionBtn.getAttribute('data-id');
        var action = actionBtn.getAttribute('data-action');
        if (action === 'edit') loadEmployeeErrorForEdit(id);
        if (action === 'delete') deleteEmployeeError(id);
        return;
        }
        });

        ['employeeErrorModalClose', 'employeeErrorCancelBtn'].forEach(function (id) {
        var btn = document.getElementById(id);
        if (btn) btn.addEventListener('click', closeEmployeeErrorModal);
        });

        var saveBtn = document.getElementById('employeeErrorSaveBtn');
        if (saveBtn) saveBtn.addEventListener('click', saveEmployeeError);

        var fileInput = document.getElementById('employeeErrorImageFile');
        if (fileInput) {
        fileInput.addEventListener('change', function () {
        var file = this.files && this.files[0];
        var preview = document.getElementById('employeeErrorImagePreview');
        currentEmployeeErrorImageFile = file || null;
        if (file && preview) {
        preview.src = URL.createObjectURL(file);
        preview.style.display = 'block';
        }
        });
        }
        })();
    </script>
}
