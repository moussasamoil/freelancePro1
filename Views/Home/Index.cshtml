<script id="investigation-opened-by-hover-cloud-always-script">
    (function () {
        function ensureTooltipPortal() {
            var portal = document.getElementById('investigationOpenedTooltipPortal');

            if (portal) {
                return portal;
            }

            portal = document.createElement('div');
            portal.id = 'investigationOpenedTooltipPortal';
            portal.innerHTML = '<span class="investigation-tooltip-title">وقت اعتماد الطلب</span><span class="investigation-tooltip-time"></span>';
            document.body.appendChild(portal);
            return portal;
        }

        function showInvestigationTooltip(target) {
            if (!target) return;

            var timeText = target.getAttribute('data-investigation-opened-at') || 'لا يوجد وقت مسجل';
            var portal = ensureTooltipPortal();
            var timeNode = portal.querySelector('.investigation-tooltip-time');

            if (timeNode) {
                timeNode.textContent = timeText;
            }

            portal.classList.add('is-visible');

            var rect = target.getBoundingClientRect();
            var portalRect = portal.getBoundingClientRect();
            var top = rect.top - portalRect.height - 10;
            var left = rect.left + (rect.width / 2) - (portalRect.width / 2);

            if (top < 8) {
                top = rect.bottom + 10;
            }

            left = Math.max(8, Math.min(left, window.innerWidth - portalRect.width - 8));

            portal.style.top = top + 'px';
            portal.style.left = left + 'px';
        }

        function hideInvestigationTooltip() {
            var portal = document.getElementById('investigationOpenedTooltipPortal');

            if (portal) {
                portal.classList.remove('is-visible');
            }
        }

        document.addEventListener('mouseover', function (event) {
            var badge = event.target.closest && event.target.closest('.investigation-opened-by-name[data-investigation-opened-at]');
            if (badge) {
                showInvestigationTooltip(badge);
            }
        });

        document.addEventListener('mouseout', function (event) {
            var badge = event.target.closest && event.target.closest('.investigation-opened-by-name[data-investigation-opened-at]');
            if (badge) {
                hideInvestigationTooltip();
            }
        });

        document.addEventListener('focusin', function (event) {
            var badge = event.target.closest && event.target.closest('.investigation-opened-by-name[data-investigation-opened-at]');
            if (badge) {
                showInvestigationTooltip(badge);
            }
        });

        document.addEventListener('focusout', function (event) {
            var badge = event.target.closest && event.target.closest('.investigation-opened-by-name[data-investigation-opened-at]');
            if (badge) {
                hideInvestigationTooltip();
            }
        });

        document.addEventListener('touchstart', function (event) {
            var badge = event.target.closest && event.target.closest('.investigation-opened-by-name[data-investigation-opened-at]');
            if (badge) {
                showInvestigationTooltip(badge);
                setTimeout(hideInvestigationTooltip, 2500);
            }
        }, { passive: true });

        window.addEventListener('scroll', hideInvestigationTooltip, true);
        window.addEventListener('resize', hideInvestigationTooltip);
    })();
</script>
