<script id="history-pixel-final-v3-script">
    (function () {
    function fallbackCopy(text, done) {
    var ta = document.createElement('textarea');
    ta.value = text;
    ta.style.position = 'fixed';
    ta.style.opacity = '0';
    ta.style.top = '-1000px';
    document.body.appendChild(ta);
    ta.focus();
    ta.select();

    try {
    document.execCommand('copy');
    } catch (e) { }

    document.body.removeChild(ta);
    if (typeof done === 'function') done();
    }

    function findFrameByWindow(childWindow) {
    var frames = document.querySelectorAll('#modalMultiOrderGrid .modal-multi-order-card iframe');

    for (var i = 0; i < frames.length; i++) {
    try {
    if (frames[i].contentWindow === childWindow) return frames[i];
    } catch (e) { }
    }

    return null;
    }

    function showCardCopyToast(card, label) {
    if (!card) return false;

    var oldToast = card.querySelector('.split-card-copy-toast');
    if (oldToast) oldToast.remove();

    var toast = document.createElement('div');
    toast.className = 'split-card-copy-toast';
    toast.innerHTML = '<span style="display:inline-flex;align-items:center;justify-content:center;width:20px;height:20px;margin-inline-end:8px;border-radius:50%;background:rgba(255,255,255,.22);">✓</span>تم نسخ ' + (label || '');

    card.appendChild(toast);

    setTimeout(function () {
    toast.classList.add('show');
    }, 10);

    setTimeout(function () {
    toast.classList.remove('show');
    setTimeout(function () {
    if (toast && toast.parentNode) toast.parentNode.removeChild(toast);
    }, 220);
    }, 1800);

    return true;
    }

    window.showSplitCardCopyToastFromFrameWindow = function (childWindow, label) {
    var frame = findFrameByWindow(childWindow);
    var card = frame ? frame.closest('.modal-multi-order-card') : null;

    return showCardCopyToast(card, label);
    };

    function copyTextForFrame(frame, text, label) {
    text = normalizeLibyaPhoneCopyText(String(text == null ? '' : text), label, null);
    if (!text || text === 'null') return;

    var card = frame ? frame.closest('.modal-multi-order-card') : null;

    var done = function () {
    if (!showCardCopyToast(card, label || '') && window.Toastify) {
    Toastify({
    text: 'تم نسخ ' + (label || ''),
    duration: 2000,
    gravity: 'bottom',
    position: 'center',
    style: { background: '#2ab149', borderRadius: '8px', fontWeight: 'bold' }
    }).showToast();
    }
    };

    if (navigator.clipboard && navigator.clipboard.writeText) {
    navigator.clipboard.writeText(text).then(done).catch(function () {
    fallbackCopy(text, done);
    });
    } else {
    fallbackCopy(text, done);
    }
    }

    function installCopyAndStyleIntoFrame(frame) {
    if (!frame) return;

    try {
    var doc = frame.contentDocument || (frame.contentWindow && frame.contentWindow.document);
    if (!doc || !doc.body) return;

    if (!doc.getElementById('split-card-copy-and-scroll-style') && doc.head) {
    var style = doc.createElement('style');
    style.id = 'split-card-copy-and-scroll-style';
    style.textContent = [
    'html, body, .order-details-partial, .order-details-partial > .container-fluid, .order-details-partial > .container-fluid > .row.mt-2 {',
    'scrollbar-width: none !important;',
    '-ms-overflow-style: none !important;',
    '}',
    'html::-webkit-scrollbar, body::-webkit-scrollbar, .order-details-partial::-webkit-scrollbar, .order-details-partial > .container-fluid::-webkit-scrollbar, .order-details-partial > .container-fluid > .row.mt-2::-webkit-scrollbar {',
    'display: none !important;',
    'width: 0 !important;',
    'height: 0 !important;',
    '}'
    ].join('\\n');

    doc.head.appendChild(style);
    }

    if (doc.__splitCardCopyInstalledV3) return;
    doc.__splitCardCopyInstalledV3 = true;

    doc.addEventListener('click', function (event) {
    var el = event.target && event.target.closest
    ? event.target.closest('.copyable')
    : null;

    if (!el) return;

    var text = el.getAttribute('data-copy-text');
    var label = el.getAttribute('data-copy-label') || '';

    if (text === null || text === undefined || String(text).length === 0) return;

    event.preventDefault();
    event.stopPropagation();

    if (typeof event.stopImmediatePropagation === 'function') {
    event.stopImmediatePropagation();
    }

    copyTextForFrame(frame, text, label);
    }, true);
    } catch (e) { }
    }

    function installAllFrames() {
    document
    .querySelectorAll('#modalMultiOrderGrid .modal-multi-order-card iframe')
    .forEach(function (frame) {
    installCopyAndStyleIntoFrame(frame);
    });
    }

    document.addEventListener('load', function (event) {
    if (event.target && event.target.tagName === 'IFRAME') {
    setTimeout(function () { installCopyAndStyleIntoFrame(event.target); }, 0);
    setTimeout(function () { installCopyAndStyleIntoFrame(event.target); }, 200);
    }
    }, true);

    document.addEventListener('click', function () {
    setTimeout(installAllFrames, 0);
    setTimeout(installAllFrames, 200);
    setTimeout(installAllFrames, 600);
    }, true);

    if (window.MutationObserver) {
    var observer = new MutationObserver(function () {
    installAllFrames();
    });

    observer.observe(document.body, { childList: true, subtree: true });
    }

    installAllFrames();
    setTimeout(installAllFrames, 300);
    setTimeout(installAllFrames, 1000);
    })();
</script>

