<script>

    document.addEventListener("DOMContentLoaded", function () {


    $("#notificationBell").click(function () {
    $("#notificationDropdown").toggle();
    })

    // Dummy panels — wired only to their own triggers, no fetch / no SignalR.
    $("#reportsTrigger").click(function (e) {
    e.preventDefault();
    $("#reportsDropdown").toggle();
    });
    $("#editNotesTrigger").click(function (e) {
    e.preventDefault();
    $("#editNotesDropdown").toggle();
    });
    $("#leadsTrigger").click(function (e) {
    e.preventDefault();
    var $dd = $("#leadsDropdown");
    $dd.toggle();
    if ($dd.is(":visible")) refreshLeadsPanel();
    });

    // ----- Leads (الطلبات المحتملة) header panel -----
    // Cards rendered into #leadsDropdown. Card icon = trash (only clickable for creator/Admin).
    // No card-body click action — only the trash button and WhatsApp/Meta button do anything.
    // Local helpers (escapeHtml/formatDateTime/appendAntiforgery are defined inside the OrderPosts
    // DOMContentLoaded closure earlier in the file and aren't visible from this script block).
    function leadEscapeHtml(s) {
    if (s == null) return '';
    return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
    }
    function leadFormatDateTime(iso) {
    if (!iso) return '';
    var s = String(iso).replace('T', ' ');
    var dot = s.indexOf('.');
    if (dot > -1) s = s.substring(0, dot);
    return s.length >= 16 ? s.substring(0, 16) : s;
    }
    function leadAppendAntiforgery(fd) {
    var input = document.querySelector('#orderPostsAntiforgery input[name="__RequestVerificationToken"]');
    if (input && input.value) fd.append('__RequestVerificationToken', input.value);
    return fd;
    }

    function renderLeadCards(rootEl, groups) {
    // Keep search-shadow-wrapper (1st child) intact; replace anything after it.
    while (rootEl.children.length > 1) rootEl.removeChild(rootEl.lastChild);

    (groups || []).forEach(function (g) {
    var wrapper = document.createElement('div');
    wrapper.className = 'date-group-wrapper f-s-14 mt-2';
    var header = document.createElement('p');
    header.className = 'text-green me-3';
    header.textContent = g.date;
    wrapper.appendChild(header);

    var container = document.createElement('div');
    container.className = 'shadowed-container';

    (g.cards || []).forEach(function (c, idx) {
    var row = document.createElement('div');
    row.className = 'row bell-card lead-card' + (idx < g.cards.length - 1 ? ' shadowed-container-border-bottom' : '');
    row.style.paddingBottom = '6px';
    row.setAttribute('data-lead-id', c.id);
    row.setAttribute('data-source-name', c.sourceName || '');
    row.setAttribute('data-phone', c.phoneNumber || '');
    row.setAttribute('data-chat-url', c.chatUrl || '');

    // Col1: trash icon (only clickable for owner/admin). Same size+padding as the icons in
    // the reports/editNotes panels — see renderPanelGroups in this file for the reference style.
    var col1 = document.createElement('div');
    col1.className = 'col-2 d-flex justify-content-start align-items-center pe-0';
    if (c.canDelete) {
    col1.innerHTML = '<img src="/static/trash-can-regular.svg" class="lead-trash" style="max-width:18px;max-height:18px;padding-right:6px;box-sizing:unset;cursor:pointer;" title="حذف" />';
    } else {
    col1.innerHTML = '<img src="/static/trash-can-regular.svg" style="max-width:18px;max-height:18px;padding-right:6px;box-sizing:unset;opacity:0.25;" />';
    }

    // Col2: page name, source, phone/URL, date, contact button.
    var col2 = document.createElement('div');
    col2.className = 'col-10 ps-0';

    // Contact button — match the home page's order column (Meta logo for FB/IG, WhatsApp green for واتساب) but smaller.
    // Home reference: Views/Home/Index.cshtml lines ~1322-1334 (isMeta ternary).
    var isWhatsApp = c.orderSource === 4; // OrderSourceEnum.واتساب
    var isMeta = c.orderSource === 1 || c.orderSource === 2; // فيسبوك / انستغرام
    var contactBtnHtml = '';
    if (isWhatsApp && c.phoneNumber) {
    var waUrl = 'https://wa.me/' + encodeURIComponent(c.phoneNumber);
    contactBtnHtml = '<a target="_blank" href="' + waUrl + '" class="whatsapp-btn-custom lead-contact-btn">' +
    '<span class="whatsapp-logo-icon" aria-hidden="true">
    < svg viewBox = "0 0 448 512" focusable = "false" >
    <path d="M380.9 97.1C339 55.1 283.2 32 223.9 32 101.5 32 1.9 131.6 1.9 254c0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zM223.9 438.7c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z" > </path>
    < /svg>
    < /span><span>WhatsApp</span > </a>';
    } else if (!isWhatsApp && c.chatUrl) {
    contactBtnHtml = '<a target="_blank" href="' + leadEscapeHtml(c.chatUrl) + '" class="order-meta-btn lead-contact-btn">' +
    '<img src="/socialmediaicons/Meta_Platforms_Inc._logo.svg" alt="Meta" /></a>';
    }

    var detailLine = isWhatsApp
    ? (c.phoneNumber ? leadEscapeHtml(c.phoneNumber) : '')
    : (c.chatUrl ? leadEscapeHtml(c.chatUrl) : '');

    col2.innerHTML =
    '<p class="f-s-14 mb-0">' + leadEscapeHtml(c.sourceName || '') + '</p>' +
    '<p class="f-s-14 mb-0" style="word-break:break-all;">' + detailLine + '</p>' +
    '<p class="f-s-14 mb-1">' + leadEscapeHtml(leadFormatDateTime(c.createdAt)) + '</p>' +
    contactBtnHtml;

    row.appendChild(col1);
    row.appendChild(col2);
    container.appendChild(row);
    });

    wrapper.appendChild(container);
    rootEl.appendChild(wrapper);
    });

    if (!groups || groups.length === 0) {
    var empty = document.createElement('div');
    empty.className = 'text-center text-muted py-3';
    empty.textContent = 'لا توجد طلبات محتملة';
    rootEl.appendChild(empty);
    }
    }

    function applyLeadSearch(rootEl, query) {
    var q = (query || '').trim().toLowerCase();
    rootEl.querySelectorAll('.date-group-wrapper').forEach(function (group) {
    var visibleInGroup = 0;
    group.querySelectorAll('.lead-card').forEach(function (card) {
    var name = (card.getAttribute('data-source-name') || '').toLowerCase();
    var phone = (card.getAttribute('data-phone') || '').toLowerCase();
    var match = !q || name.indexOf(q) !== -1 || phone.indexOf(q) !== -1;
    card.style.display = match ? '' : 'none';
    if (match) visibleInGroup++;
    });
    group.style.display = visibleInGroup > 0 ? '' : 'none';
    });
    }

    function refreshLeadsPanel() {
    var root = document.getElementById('leadsDropdown');
    var trigger = document.getElementById('leadsTrigger');
    if (!root) return;

    fetch('/Lead/Panel', { credentials: 'same-origin' })
    .then(function (r) { if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); })
    .then(function (data) {
    renderLeadCards(root, (data && data.groups) || []);
    if (trigger) {
    var badge = trigger.querySelector('.dummy-count-badge');
    if (badge) {
    if (data && data.count > 0) {
    badge.textContent = data.count;
    badge.style.display = '';
    } else {
    badge.textContent = '';
    badge.style.display = 'none';
    }
    }
    }
    var searchInput = document.getElementById('leadsSearch');
    if (searchInput && searchInput.value) applyLeadSearch(root, searchInput.value);
    })
    .catch(function (err) { console.error('Lead.Panel failed:', err); });
    }

    // Trash click → confirm via showNotification → POST /Lead/Delete.
    $("#leadsDropdown").on('click', '.lead-trash', function (e) {
    e.stopPropagation();
    var $card = $(this).closest('.lead-card');
    var leadId = $card.attr('data-lead-id');
    if (!leadId) return;
    showNotification(
    'هل أنت متأكد من حذف هذا الطلب المحتمل؟',
    function () {
    var fd = new FormData();
    fd.append('id', leadId);
    leadAppendAntiforgery(fd);
    fetch('/Lead/Delete', {
    method: 'POST',
    body: fd,
    credentials: 'same-origin'
    })
    .then(function (r) {
    if (!r.ok) throw new Error('HTTP ' + r.status);
    return r.json();
    })
    .then(function () { refreshLeadsPanel(); })
    .catch(function (err) {
    console.error('Lead.Delete failed:', err);
    alert('فشل حذف الطلب المحتمل');
    });
    },
    '/static/trash-can-regular.svg'
    );
    });

    // Leads panel search input — filter by SourceName or PhoneNumber.
    (function () {
    var input = document.getElementById('leadsSearch');
    var clear = document.getElementById('leadsSearchClear');
    var root = document.getElementById('leadsDropdown');
    if (!input || !clear || !root) return;
