        ?? new System.Collections.Generic.Dictionary<int, string>();

    var investigationOpenedAt = ViewBag.InvestigationOpenedAt as System.Collections.Generic.IDictionary<int, string>
        ?? new System.Collections.Generic.Dictionary<int, string>();

    var investigationEmployees = ViewBag.InvestigationEmployees as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>
        ?? System.Linq.Enumerable.Empty<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>();

    var selectedInvestigationEmployeeId = ViewBag.SelectedInvestigationEmployeeId as string ?? string.Empty;

    var loginWelcomeText = TempData["LoginWelcomeText"] as string;

    if (string.IsNullOrWhiteSpace(loginWelcomeText)
        && Context.Request.Cookies.TryGetValue("LoginWelcomeText", out var loginWelcomeCookieText)
        && !string.IsNullOrWhiteSpace(loginWelcomeCookieText))
    {
        loginWelcomeText = System.Net.WebUtility.UrlDecode(loginWelcomeCookieText);
    }

