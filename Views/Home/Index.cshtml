    function timeSince(date) {
    var seconds = Math.floor((new Date() - new Date(date)) / 1000);

    var interval = seconds / 31536000;
    if (interval > 1) {
    return "قبل " + Math.floor(interval) + (Math.floor(interval) > 1 ? " سنوات" : " سنة");
    }
    interval = seconds / 2592000;
    if (interval > 1) {
    return "قبل " + Math.floor(interval) + (Math.floor(interval) > 1 ? " أشهر" : " شهر");
    }
    interval = seconds / 86400;
    if (interval > 1) {
    return "قبل " + Math.floor(interval) + (Math.floor(interval) > 1 ? " أيام" : " يوم");
    }
    interval = seconds / 3600;
    if (interval > 1) {
    return "قبل " + Math.floor(interval) + (Math.floor(interval) > 1 ? " ساعات" : " ساعة");
    }
    interval = seconds / 60;
    if (interval > 1) {
    return "قبل " + Math.floor(interval) + (Math.floor(interval) > 1 ? " دقائق" : " دقيقة");
    }
    return "قبل " + Math.floor(seconds) + (Math.floor(seconds) > 1 ? " ثواني" : " ثانية");
    }

