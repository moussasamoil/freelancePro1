    }

    // Call fetchFailedOrders to update the notification count after data load
    window.fetchFailedOrders(); // Now fetchFailedOrders is globally accessible


    },
    error: function (xhr) {
    if (xhr && (xhr.status === 0 || xhr.statusText === 'abort')) {
    return;
    }

    console.log("AJAX request failed", xhr.status, xhr.statusText);
    if ($('#debugQueryWrapper').length) {
