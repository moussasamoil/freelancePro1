<script id="sync-processed-count-from-details-card">
    (function () {
    var processedCountCache = Object.create(null);
    var syncTimer = null;

    function normalizeDigits(text) {
    if (!text) return '';
    return String(text)
    .replace(/[٠-٩]/g, function (d) { return String('٠١٢٣٤٥٦٧٨٩'.indexOf(d)); })
    .replace(/[۰-۹]/g, function (d) { return String('۰۱۲۳۴۵۶۷۸۹'.indexOf(d)); });
    }

    function readIntegerFromText(text) {
    var normalized = normalizeDigits(text || '');
    var match = normalized.match(/\d+/);
    if (!match) return null;
    var value = parseInt(match[0], 10);
    return isNaN(value) || value < 1 ? null : value;
    }

    // DetailsPartial renders the processed row as:
    // #orderDetails_orderStatus = "تم المعالجة" then the next rounded pill contains Model.FixedOrderTimes.
    function extractFixedOrderTimesFromDetailsHtml(html) {
    if (!html) return null;

    var doc = new DOMParser().parseFromString(html, 'text/html');
    var statusEl = doc.querySelector('#orderDetails_orderStatus');

    if (!statusEl || statusEl.textContent.indexOf('تم') === -1 || statusEl.textContent.indexOf('معالجة') === -1) {
    return null;
    }

    var current = statusEl.nextElementSibling;
    while (current) {
    var count = readIntegerFromText(current.textContent);
    if (count !== null) return count;
    current = current.nextElementSibling;
    }

    var row = statusEl.closest('.d-flex, .row, div');
    if (row) {
    var candidates = Array.from(row.querySelectorAll('div, span, dd'));
    for (var i = 0; i < candidates.length; i++) {
    var el = candidates[i];
    if (el === statusEl || (el.contains && el.contains(statusEl))) continue;
    var text = (el.textContent || '').trim();
    if (!text || text.indexOf('تم') > -1 || text.indexOf('معالجة') > -1 || text.indexOf('حالة') > -1) continue;
    var value = readIntegerFromText(text);
    if (value !== null) return value;
    }
    }

    return null;
    }

    function applyProcessedCount(orderId, count) {
    if (!orderId || !count || count < 1) return;

    document.querySelectorAll('#ordersTable .processed-count-badge[data-order-id="' + orderId + '"]').forEach(function (badge) {
    badge.textContent = String(count);
    badge.setAttribute('data-details-count', String(count));
    badge.setAttribute('data-details-sync', 'done');
    });
    }

    function syncOneProcessedBadge(badge) {
    var orderId = badge.getAttribute('data-order-id');
    if (!orderId) return;

    if (processedCountCache[orderId]) {
    applyProcessedCount(orderId, processedCountCache[orderId]);
    return;
    }

    if (badge.getAttribute('data-details-sync') === 'loading') return;
    badge.setAttribute('data-details-sync', 'loading');

    fetch('/Order/DetailsPartial/' + encodeURIComponent(orderId), {
    credentials: 'same-origin',
    headers: { 'X-Requested-With': 'XMLHttpRequest' }
    })
    .then(function (response) {
    if (!response.ok) throw new Error('HTTP ' + response.status);
    return response.text();
    })
    .then(function (html) {
    var count = extractFixedOrderTimesFromDetailsHtml(html);
    if (count && count > 0) {
    processedCountCache[orderId] = count;
    applyProcessedCount(orderId, count);
    } else {
    badge.setAttribute('data-details-sync', 'done');
    }
    })
    .catch(function () {
    badge.removeAttribute('data-details-sync');
    });
    }

    function syncProcessedCountsFromDetails() {
    var badges = Array.from(document.querySelectorAll('#ordersTable .processed-count-badge[data-order-id]'));
    badges.forEach(syncOneProcessedBadge);
    }

    function scheduleProcessedCountSync() {
    if (syncTimer) clearTimeout(syncTimer);
    syncTimer = setTimeout(syncProcessedCountsFromDetails, 120);
    }

    document.addEventListener('DOMContentLoaded', function () {
    scheduleProcessedCountSync();

    var table = document.getElementById('ordersTable');
    if (!table || !window.MutationObserver) return;

    var observer = new MutationObserver(function () {
    scheduleProcessedCountSync();
    });

    observer.observe(table, { childList: true, subtree: true });
    });

    window.syncProcessedCountsFromDetails = syncProcessedCountsFromDetails;
    })();
</script>

<script id="home-delivery-cost-batch-from-order-controller">
    (function () {
    if (window.__homeDeliveryCostBatchFromOrderController) {
    return;
    }

    window.__homeDeliveryCostBatchFromOrderController = true;

    var syncTimer = null;
    var inFlight = false;
    var lastSignature = '';
    var deliveryCostCache = {};

    function parseMoneyNumber(value) {
    var cleaned = String(value === null || value === undefined ? '' : value)
    .replace(/\s+/g, ' ')
    .replace(/,/g, '')
    .replace(/LYD|TRY|IQD|JOD|USD|EGP/gi, '')
    .trim();

    if (!cleaned) {
    return 0;
    }

    var numberValue = Number(cleaned);
    return Number.isNaN(numberValue) ? 0 : numberValue;
    }

    function formatMoneyNoDecimals(value) {
    return parseMoneyNumber(value).toLocaleString('en-US', { maximumFractionDigits: 0 });
    }

    function getRows() {
    return Array.from(document.querySelectorAll('#ordersTable tbody tr.order-details[data-order-id]'));
    }

    function getRowOrderId(row) {
    return row ? (row.getAttribute('data-order-id') || '').trim() : '';
    }

    function getCurrencyFromRow(row) {
    var currencyEl = row ? row.querySelector('.home-order-total-price span:last-child') : null;
    return currencyEl ? (currencyEl.textContent || '').trim() : '';
    }

    function getPriceStack(row) {
    return row ? row.querySelector('.home-price-cell .home-order-price-stack') : null;
    }

    function ensureDeliveryCostBadge(row) {
    var stack = getPriceStack(row);

    if (!stack) {
    return null;
    }

    var badge = row.querySelector('.home-delivery-cost-badge');

    if (!badge) {
    badge = document.createElement('span');
    badge.className = 'home-delivery-cost-badge';
    badge.title = 'تكلفة التوصيل';
    badge.innerHTML = '<i class="fa-solid fa-truck-fast"></i><span>0</span><span></span>';
    stack.appendChild(badge);
    }

    badge.style.display = 'inline-flex';
    badge.setAttribute('data-delivery-cost-direct', 'true');
    badge.setAttribute('data-order-id', getRowOrderId(row));

    return badge;
    }

    function renderDeliveryCost(row, cost) {
    var badge = ensureDeliveryCostBadge(row);

    if (!badge) {
    return;
    }

    var numericCost = parseMoneyNumber(cost);
    var currency = getCurrencyFromRow(row);

    badge.removeAttribute('data-delivery-cost-loading');
    badge.setAttribute('data-delivery-cost-loaded', '1');
    badge.setAttribute('data-delivery-cost-value', String(numericCost));

    badge.innerHTML = '<i class="fa-solid fa-truck-fast"></i><span>'
    + formatMoneyNoDecimals(numericCost)
    + '</span><span>'
    + currency
    + '</span>';
    }

    function getInitialBadgeCost(row) {
    var badge = row ? row.querySelector('.home-delivery-cost-badge') : null;

    if (!badge) {
    return 0;
    }

    var explicitValue = badge.getAttribute('data-delivery-cost-value');
    return parseMoneyNumber(explicitValue !== null ? explicitValue : badge.textContent);
    }

    function normalizeInitialBadges() {
    getRows().forEach(function (row) {
    renderDeliveryCost(row, getInitialBadgeCost(row));
    });
    }

    function applyDeliveryCostItems(items) {
    var map = {};

    (items || []).forEach(function (item) {
    if (!item) {
    return;
    }

    var orderId = String(item.orderId || item.OrderId || '').trim();
    var cost = item.deliveryCost;

    if (cost === undefined) {
    cost = item.DeliveryCost;
    }

    if (orderId) {
    map[orderId] = parseMoneyNumber(cost);
    deliveryCostCache[orderId] = map[orderId];
    }
    });

    getRows().forEach(function (row) {
    var orderId = getRowOrderId(row);

    if (!orderId) {
    return;
    }

    var cost = Object.prototype.hasOwnProperty.call(map, orderId)
    ? map[orderId]
    : (Object.prototype.hasOwnProperty.call(deliveryCostCache, orderId) ? deliveryCostCache[orderId] : getInitialBadgeCost(row));

    renderDeliveryCost(row, cost);
    });
    }

    function syncDeliveryCosts() {
    var rows = getRows();
    var ids = rows
    .map(getRowOrderId)
    .filter(function (id, index, arr) {
    return id && arr.indexOf(id) === index;
    });

    if (!ids.length) {
    return;
    }

    normalizeInitialBadges();

    var signature = ids.join(',');

    if (inFlight || (signature === lastSignature && ids.every(function (id) {
    return Object.prototype.hasOwnProperty.call(deliveryCostCache, id);
    }))) {
    return;
    }

    lastSignature = signature;
    inFlight = true;

    fetch('/Order/DeliveryCostsByOrderIds?ids=' + encodeURIComponent(signature), {
    method: 'GET',
    credentials: 'same-origin',
    headers: {
    'Accept': 'application/json',
    'X-Requested-With': 'XMLHttpRequest'
    },
    cache: 'no-store'
    })
    .then(function (response) {
    if (!response.ok) {
    throw new Error('HTTP ' + response.status);
    }

    return response.json();
    })
    .then(function (result) {
    if (!result || result.success === false) {
    return;
    }

    applyDeliveryCostItems(result.items || result.Items || []);
    })
    .catch(function (error) {
    console.warn('Delivery cost batch sync failed', error);
    })
    .finally(function () {
    inFlight = false;
    });
    }

    function scheduleDeliveryCostSync() {
    if (syncTimer) {
    clearTimeout(syncTimer);
    }

    syncTimer = setTimeout(syncDeliveryCosts, 120);
    }

    document.addEventListener('DOMContentLoaded', function () {
    scheduleDeliveryCostSync();

    var tableBody = document.querySelector('#ordersTable tbody');

    if (!tableBody || !window.MutationObserver) {
    return;
    }

    var observer = new MutationObserver(function () {
    scheduleDeliveryCostSync();
    });

    observer.observe(tableBody, { childList: true });
    });

    window.syncHomeDeliveryCostBadgesFromOrderController = syncDeliveryCosts;
    })();
</script>


<script id="luxira-header-panels-open-fallback-fix">
    (function () {
    if (window.__luxiraHeaderPanelsOpenFallbackFixBound) {
    return;
    }

    window.__luxiraHeaderPanelsOpenFallbackFixBound = true;

    function escapeHeaderPanelHtml(value) {
    return String(value === null || value === undefined ? '' : value)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
    }

    function formatHeaderPanelDateTime(value) {
    if (!value) return '';
    var text = String(value).replace('T', ' ');
    var dotIndex = text.indexOf('.');
    if (dotIndex > -1) {
    text = text.substring(0, dotIndex);
    }
    return text.length >= 16 ? text.substring(0, 16) : text;
    }

    function getHeaderPanelDefinitions() {
    return [
    {
    key: 'problem',
    rootId: 'reportsDropdown',
    triggerId: 'reportsTrigger',
    searchId: 'reportsSearch',
    icon: '/static/report-icon.png'
    },
    {
    key: 'editNote',
    rootId: 'editNotesDropdown',
    triggerId: 'editNotesTrigger',
    searchId: 'editNotesSearch',
    icon: '/static/order-edit-requests-icon.png'
    }
    ];
    }

    function closeOtherHeaderDropdowns(openRootId) {
    [
    'notificationDropdown',
    'reportsDropdown',
    'editNotesDropdown',
    'leadsDropdown'
    ].forEach(function (id) {
    if (id === openRootId) return;
    var el = document.getElementById(id);
    if (el) {
    el.style.display = 'none';
    }
    });
    }

    function setHeaderPanelBadge(triggerId, count) {
    var trigger = document.getElementById(triggerId);
    if (!trigger) return;

    var badge = trigger.querySelector('.dummy-count-badge');
    if (!badge) return;

    count = Number(count || 0);

    if (count > 0) {
    badge.textContent = count;
    badge.style.display = '';
    } else {
    badge.textContent = '';
    badge.style.display = 'none';
    }
    }

    function clearHeaderPanelCards(rootEl) {
    if (!rootEl) return;

    while (rootEl.children.length > 1) {
    rootEl.removeChild(rootEl.lastChild);
    }
    }

    function renderHeaderPanelGroups(rootEl, groups, def) {
    clearHeaderPanelCards(rootEl);

    if (!groups || !groups.length) {
    var empty = document.createElement('div');
    empty.className = 'text-center text-muted py-3';
    empty.textContent = 'لا توجد عناصر';
    rootEl.appendChild(empty);
    return;
    }

    groups.forEach(function (group) {
    var wrapper = document.createElement('div');
    wrapper.className = 'date-group-wrapper f-s-14 mt-2';

    var header = document.createElement('p');
    header.className = 'text-green me-3';
    header.textContent = group.date || '';
    wrapper.appendChild(header);

    var container = document.createElement('div');
    container.className = 'shadowed-container';

    (group.cards || []).forEach(function (card, index) {
    var row = document.createElement('div');
    row.className = 'row bell-card pointer' + (index < (group.cards || []).length - 1 ? ' shadowed-container-border-bottom' : '');
    row.setAttribute('data-order-id', card.orderId || '');
    row.setAttribute('data-search-text', String(card.orderId || ''));

    row.innerHTML = ''
    + '<div class="col-2 d-flex justify-content-start align-items-center pe-0">'
    + '    <img src="' + escapeHeaderPanelHtml(def.icon) + '" style="max-width:19px;max-height:19px;padding-right:6px;box-sizing:unset;" />'
    + '</div>'
    + '<div class="col-10 ps-0">'
    + '    <p class="f-s-14">' + escapeHeaderPanelHtml(card.country || '') + '</p>'
    + '    <p class="f-s-14">طلب رقم ' + escapeHeaderPanelHtml(card.orderId || '') + '</p>'
    + '    <p class="f-s-14">' + escapeHeaderPanelHtml(formatHeaderPanelDateTime(card.createdAt)) + '</p>'
    + '    <p class="f-s-14">' + escapeHeaderPanelHtml((card.authorName ? card.authorName + ' — ' : '') + (card.snippet || '')) + '</p>'
    + '</div>';

    row.addEventListener('click', function (event) {
    event.preventDefault();
    event.stopPropagation();

    if (typeof window.openOrderDetails === 'function' && card.orderId) {
    window.openOrderDetails(card.orderId);
    rootEl.style.display = 'none';
    }
    });

    container.appendChild(row);
    });

    wrapper.appendChild(container);
    rootEl.appendChild(wrapper);
    });
    }

    function applyHeaderPanelSearch(rootEl, query) {
    if (!rootEl) return;

    var q = String(query || '').trim();

    rootEl.querySelectorAll('.date-group-wrapper').forEach(function (group) {
    var visibleCount = 0;

    group.querySelectorAll('[data-order-id]').forEach(function (card) {
    var orderId = String(card.getAttribute('data-order-id') || '');
    var isVisible = !q || orderId.indexOf(q) !== -1;

    card.style.display = isVisible ? '' : 'none';

    if (isVisible) {
    visibleCount++;
    }
    });

    group.style.display = visibleCount > 0 ? '' : 'none';
    });
    }

    function refreshHeaderPanelsFallback() {
    var hasAnyPanel = getHeaderPanelDefinitions().some(function (def) {
    return document.getElementById(def.rootId);
    });

    if (!hasAnyPanel) return;

    fetch('/OrderPosts/Panels', {
    credentials: 'same-origin',
    cache: 'no-store'
    })
    .then(function (response) {
    if (!response.ok) {
    throw new Error('HTTP ' + response.status);
    }

    return response.json();
    })
    .then(function (data) {
    getHeaderPanelDefinitions().forEach(function (def) {
    var root = document.getElementById(def.rootId);
    if (!root) return;

    var panel = (data && data[def.key]) || { count: 0, groups: [] };

    renderHeaderPanelGroups(root, panel.groups || [], def);
    setHeaderPanelBadge(def.triggerId, panel.count || 0);

    var input = document.getElementById(def.searchId);
    if (input && input.value) {
    applyHeaderPanelSearch(root, input.value);
    }
    });
    })
    .catch(function (error) {
    console.error('Header panels fallback refresh failed:', error);
    });
    }

    function toggleHeaderPanel(def, event) {
    if (event) {
    event.preventDefault();
    event.stopPropagation();

    if (typeof event.stopImmediatePropagation === 'function') {
    event.stopImmediatePropagation();
    }
    }

    var root = document.getElementById(def.rootId);
    if (!root) return;

    var isCurrentlyVisible = root.style.display !== 'none' && root.style.display !== '';

    closeOtherHeaderDropdowns(def.rootId);

    root.style.display = isCurrentlyVisible ? 'none' : 'block';

    if (!isCurrentlyVisible) {
    refreshHeaderPanelsFallback();

    var input = document.getElementById(def.searchId);
    if (input) {
    window.setTimeout(function () {
    try {
    input.focus();
    } catch (_) { }
    }, 80);
    }
    }
    }

    function bindHeaderPanelOpenFix() {
    getHeaderPanelDefinitions().forEach(function (def) {
    var trigger = document.getElementById(def.triggerId);
    var root = document.getElementById(def.rootId);
    var input = document.getElementById(def.searchId);
    var clearBtn = document.getElementById(def.searchId + 'Clear');

    if (trigger && !trigger.dataset.headerPanelFallbackBound) {
    trigger.dataset.headerPanelFallbackBound = '1';

    trigger.addEventListener('click', function (event) {
    toggleHeaderPanel(def, event);
    }, true);
    }

    if (input && root && !input.dataset.headerPanelSearchFallbackBound) {
    input.dataset.headerPanelSearchFallbackBound = '1';

    input.addEventListener('input', function () {
    applyHeaderPanelSearch(root, input.value);

    if (clearBtn) {
    clearBtn.style.visibility = input.value ? 'visible' : 'hidden';
    }
    });
    }

    if (clearBtn && input && root && !clearBtn.dataset.headerPanelClearFallbackBound) {
    clearBtn.dataset.headerPanelClearFallbackBound = '1';

    clearBtn.addEventListener('click', function (event) {
    event.preventDefault();
    event.stopPropagation();
    input.value = '';
    clearBtn.style.visibility = 'hidden';
    applyHeaderPanelSearch(root, '');
    input.focus();
    });
    }
    });
    }

    document.addEventListener('click', function (event) {
    getHeaderPanelDefinitions().forEach(function (def) {
    var root = document.getElementById(def.rootId);
    var trigger = document.getElementById(def.triggerId);

    if (!root || !trigger) return;

    if (!root.contains(event.target) && !trigger.contains(event.target)) {
    root.style.display = 'none';
    }
    });
    });

    if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function () {
    bindHeaderPanelOpenFix();
    refreshHeaderPanelsFallback();
    });
    } else {
    bindHeaderPanelOpenFix();
    refreshHeaderPanelsFallback();
    }

    window.addEventListener('load', function () {
    bindHeaderPanelOpenFix();
    });

    window.refreshHeaderPanelsFallback = refreshHeaderPanelsFallback;
    })();
</script>

<script id="luxira-top-panels-returns-leads-open-fix">
    (function () {
    if (window.__luxiraTopPanelsReturnsLeadsOpenFixBound) {
    return;
    }

    window.__luxiraTopPanelsReturnsLeadsOpenFixBound = true;

    const dropdownIds = [
    'notificationDropdown',
    'reportsDropdown',
    'editNotesDropdown',
    'leadsDropdown'
    ];

    function getEl(id) {
    return document.getElementById(id);
    }

    function isVisible(el) {
    if (!el) return false;
    return el.style.display !== 'none' && el.style.display !== '';
    }

    function setVisible(el, visible) {
    if (!el) return;
    el.style.display = visible ? 'block' : 'none';
    }

    function closeAllTopDropdownsExcept(exceptId) {
    dropdownIds.forEach(function (id) {
    if (id === exceptId) return;
    const el = getEl(id);
    if (el) {
    el.style.display = 'none';
    }
    });
    }

    function stopTopPanelEvent(event) {
    if (!event) return;
    event.preventDefault();
    event.stopPropagation();

    if (typeof event.stopImmediatePropagation === 'function') {
    event.stopImmediatePropagation();
    }
    }

    function showDropdownLoading(root, text) {
    if (!root) return;

    if (root.children.length === 0) {
    const loading = document.createElement('div');
    loading.className = 'text-center text-muted py-3';
    loading.textContent = text || 'جاري التحميل...';
    root.appendChild(loading);
    return;
    }
    }

    function safeRefreshReturnsPanel() {
    if (typeof window.fetchFailedOrders === 'function') {
    try {
    window.fetchFailedOrders();
    } catch (error) {
    console.error('fetchFailedOrders failed:', error);
    }
    }
    }

    function leadEscapeHtml(value) {
    return String(value || '')
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#039;');
    }

    function leadFormatDateTime(value) {
    if (!value) return '';

    try {
    const date = new Date(value);
    if (Number.isNaN(date.getTime())) return String(value);

    return date.toLocaleString('ar-EG', {
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
    hour: '2-digit',
    minute: '2-digit'
    });
    } catch {
    return String(value);
    }
    }

    function clearCardsAfterSearchWrapper(root) {
    if (!root) return;

    while (root.children.length > 1) {
    root.removeChild(root.lastChild);
    }
    }

    function renderLeadsPanelFallback(root, groups) {
    if (!root) return;

    clearCardsAfterSearchWrapper(root);

    if (!groups || !groups.length) {
    const empty = document.createElement('div');
    empty.className = 'text-center text-muted py-3';
    empty.textContent = 'لا توجد طلبات محتملة';
    root.appendChild(empty);
    return;
    }

    groups.forEach(function (group) {
    const wrapper = document.createElement('div');
    wrapper.className = 'date-group-wrapper f-s-14 mt-2';

    const header = document.createElement('p');
    header.className = 'text-green me-3';
    header.textContent = group.date || '';
    wrapper.appendChild(header);

    const container = document.createElement('div');
    container.className = 'shadowed-container';

    (group.cards || []).forEach(function (card, index) {
    const row = document.createElement('div');
    row.className = 'row bell-card pointer lead-card' + (index < (group.cards || []).length - 1 ? ' shadowed-container-border-bottom' : '');
    row.setAttribute('data-lead-id', card.id || card.leadId || '');
    row.setAttribute('data-source-name', card.sourceName || '');
    row.setAttribute('data-phone', card.phoneNumber || '');

    const contactValue = card.phoneNumber || card.chatUrl || '';

    row.innerHTML = ''
    + '<div class="col-2 d-flex justify-content-start align-items-center pe-0">'
    + '    <img src="/static/trash-can-regular.svg" style="max-width:18px;max-height:18px;padding-right:6px;box-sizing:unset;" />'
    + '</div>'
    + '<div class="col-10 ps-0">'
    + '    <p class="f-s-14 mb-0">' + leadEscapeHtml(card.sourceName || '') + '</p>'
    + '    <p class="f-s-14 mb-0" style="word-break:break-all;">' + leadEscapeHtml(contactValue) + '</p>'
    + '    <p class="f-s-14 mb-1">' + leadEscapeHtml(leadFormatDateTime(card.createdAt)) + '</p>'
    + '</div>';

    container.appendChild(row);
    });

    wrapper.appendChild(container);
    root.appendChild(wrapper);
    });
    }

    function applyLeadsSearchFallback(root, query) {
    if (!root) return;

    const q = String(query || '').trim().toLowerCase();

    root.querySelectorAll('.date-group-wrapper').forEach(function (group) {
    let visibleCount = 0;

    group.querySelectorAll('.lead-card').forEach(function (card) {
    const sourceName = String(card.getAttribute('data-source-name') || '').toLowerCase();
    const phone = String(card.getAttribute('data-phone') || '').toLowerCase();
    const isVisible = !q || sourceName.indexOf(q) !== -1 || phone.indexOf(q) !== -1;

    card.style.display = isVisible ? '' : 'none';

    if (isVisible) {
    visibleCount++;
    }
    });

    group.style.display = visibleCount > 0 ? '' : 'none';
    });
    }

    function setLeadsBadge(count) {
    const trigger = getEl('leadsTrigger');
    if (!trigger) return;

    const badge = trigger.querySelector('.dummy-count-badge');
    if (!badge) return;

    count = Number(count || 0);

    if (count > 0) {
    badge.textContent = count;
    badge.style.display = '';
    } else {
    badge.textContent = '';
    badge.style.display = 'none';
    }
    }

    function safeRefreshLeadsPanel() {
    if (typeof window.refreshLeadsPanel === 'function') {
    try {
    window.refreshLeadsPanel();
    return;
    } catch (error) {
    console.error('refreshLeadsPanel failed:', error);
    }
    }

    const root = getEl('leadsDropdown');
    if (!root) return;

    fetch('/Lead/Panel', {
    credentials: 'same-origin',
    cache: 'no-store'
    })
    .then(function (response) {
    if (!response.ok) {
    throw new Error('HTTP ' + response.status);
    }

    return response.json();
    })
    .then(function (data) {
    renderLeadsPanelFallback(root, (data && data.groups) || []);
    setLeadsBadge(data && data.count ? data.count : 0);

    const searchInput = getEl('leadsSearch');
    if (searchInput && searchInput.value) {
    applyLeadsSearchFallback(root, searchInput.value);
    }
    })
    .catch(function (error) {
    console.error('Lead panel fallback failed:', error);
    });
    }

    function bindReturnsPanel() {
    const trigger = getEl('notificationBell');
    const root = getEl('notificationDropdown');

    if (!trigger || !root || trigger.dataset.returnsPanelOpenFixBound === '1') {
    return;
    }

    trigger.dataset.returnsPanelOpenFixBound = '1';

    trigger.addEventListener('click', function (event) {
    stopTopPanelEvent(event);

    const shouldOpen = !isVisible(root);
    closeAllTopDropdownsExcept('notificationDropdown');
    setVisible(root, shouldOpen);

    if (shouldOpen) {
    showDropdownLoading(root, 'جاري تحميل الرواجع...');
    safeRefreshReturnsPanel();
    setVisible(root, true);
    }
    }, true);
    }

    function bindLeadsPanel() {
    const trigger = getEl('leadsTrigger');
    const root = getEl('leadsDropdown');

    if (!trigger || !root || trigger.dataset.leadsPanelOpenFixBound === '1') {
    return;
    }

    trigger.dataset.leadsPanelOpenFixBound = '1';

    trigger.addEventListener('click', function (event) {
    stopTopPanelEvent(event);

    const shouldOpen = !isVisible(root);
    closeAllTopDropdownsExcept('leadsDropdown');
    setVisible(root, shouldOpen);

    if (shouldOpen) {
    showDropdownLoading(root, 'جاري تحميل الطلبات المحتملة...');
    safeRefreshLeadsPanel();
    setVisible(root, true);

    const input = getEl('leadsSearch');
    if (input) {
    window.setTimeout(function () {
    try {
    input.focus();
    } catch (_) { }
    }, 80);
    }
    }
    }, true);

    const input = getEl('leadsSearch');
    const clear = getEl('leadsSearchClear');

    if (input && clear && !input.dataset.leadsSearchOpenFixBound) {
    input.dataset.leadsSearchOpenFixBound = '1';

    input.addEventListener('input', function () {
    clear.style.visibility = input.value.trim() !== '' ? 'visible' : 'hidden';

    if (typeof window.applyLeadSearch === 'function') {
    try {
    window.applyLeadSearch(root, input.value);
    return;
    } catch (_) { }
    }

    applyLeadsSearchFallback(root, input.value);
    });

    clear.addEventListener('click', function (event) {
    event.preventDefault();
    event.stopPropagation();
    input.value = '';
    clear.style.visibility = 'hidden';

    if (typeof window.applyLeadSearch === 'function') {
    try {
    window.applyLeadSearch(root, '');
    return;
    } catch (_) { }
    }

    applyLeadsSearchFallback(root, '');
    input.focus();
    });
    }
    }

    document.addEventListener('click', function (event) {
    dropdownIds.forEach(function (dropdownId) {
    const root = getEl(dropdownId);
    if (!root) return;

    let triggerId = '';

    if (dropdownId === 'notificationDropdown') triggerId = 'notificationBell';
    if (dropdownId === 'reportsDropdown') triggerId = 'reportsTrigger';
    if (dropdownId === 'editNotesDropdown') triggerId = 'editNotesTrigger';
    if (dropdownId === 'leadsDropdown') triggerId = 'leadsTrigger';

    const trigger = getEl(triggerId);

    if (trigger && !root.contains(event.target) && !trigger.contains(event.target)) {
    root.style.display = 'none';
    }
    });
    });

    function bindAllTopPanelFixes() {
    bindReturnsPanel();
    bindLeadsPanel();
    }

    if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', bindAllTopPanelFixes);
    } else {
    bindAllTopPanelFixes();
    }

    window.addEventListener('load', function () {
    bindAllTopPanelFixes();
    safeRefreshLeadsPanel();
    });
    })();
</script>

<script id="luxira-create-order-source-ad-safe-final-patch">
    (function () {
    if (window.__luxiraCreateOrderSourceAdSafeFinalPatchBound) {
    return;
    }

    window.__luxiraCreateOrderSourceAdSafeFinalPatchBound = true;

    var sourcePickerModeUntil = 0;

    function normalizeLuxiraText(value) {
    return String(value || '')
    .replace(/[\u064B-\u065F\u0670]/g, '')
    .replace(/[إأآا]/g, 'ا')
    .replace(/ى/g, 'ي')
    .replace(/ة/g, 'ه')
    .replace(/\s+/g, ' ')
    .trim()
    .toLowerCase();
    }

    function isCreateOrderOpen() {
    var createModal = document.getElementById('Create');
    return !!(createModal && (createModal.classList.contains('show') || createModal.offsetParent !== null));
    }

    function getCreateOrderRoot() {
    return document.getElementById('Create') || document.getElementById('modal-container') || document;
    }

    function isAllowedSourceText(text, value) {
    var normalized = normalizeLuxiraText((text || '') + ' ' + (value || ''));

    return normalized.indexOf('واتساب') >= 0
    || normalized.indexOf('وتساب') >= 0
    || normalized.indexOf('whatsapp') >= 0
    || normalized.indexOf('whats app') >= 0
    || normalized.indexOf('فيسبوك') >= 0
    || normalized.indexOf('فيس بوك') >= 0
    || normalized.indexOf('facebook') >= 0
    || normalized === 'fb'
    || normalized.indexOf('انستغرام') >= 0
    || normalized.indexOf('انستجرام') >= 0
    || normalized.indexOf('انستقرام') >= 0
    || normalized.indexOf('انست') >= 0
    || normalized.indexOf('instagram') >= 0
    || normalized.indexOf('insta') >= 0;
    }

    function isPlaceholderSource(text, value) {
    var normalizedText = normalizeLuxiraText(text);
    var normalizedValue = String(value || '').trim();

    return normalizedValue === ''
    || normalizedValue === '0'
    || normalizedValue === '-1'
    || normalizedText === ''
    || normalizedText.indexOf('اختر') >= 0
    || normalizedText.indexOf('اختار') >= 0
    || normalizedText.indexOf('select') >= 0;
    }

    function looksLikeSourceLabelText(text) {
    var normalized = normalizeLuxiraText(text);
    return normalized.indexOf('نوع الصفحه') >= 0
    || normalized.indexOf('نوع صفحه') >= 0
    || normalized.indexOf('order source') >= 0
    || normalized.indexOf('ordersource') >= 0;
    }

    function isInsideSourceArea(element) {
    if (!element || !isCreateOrderOpen()) {
    return false;
    }

    if (element.matches && element.matches('select[id*="OrderSource"], select[name*="OrderSource"], [data-field*="OrderSource"], [data-name*="OrderSource"]')) {
    return true;
    }

    var current = element;
    var depth = 0;

    while (current && current !== document.body && depth < 8) {
    var marker = [
    current.id || '',
    current.name || '',
    current.getAttribute ? (current.getAttribute('data-field') || '') : '',
    current.getAttribute ? (current.getAttribute('data-name') || '') : '',
    current.getAttribute ? (current.getAttribute('aria-label') || '') : '',
    current.textContent || ''
    ].join(' ');

    if (looksLikeSourceLabelText(marker)) {
    return true;
    }

    current = current.parentElement;
    depth++;
    }

    return false;
    }

    function enableSourcePickerMode() {
    sourcePickerModeUntil = Date.now() + 3500;
    setTimeout(applyCreateOrderSourceAndAdPatch, 30);
    setTimeout(applyCreateOrderSourceAndAdPatch, 160);
    setTimeout(applyCreateOrderSourceAndAdPatch, 420);
    setTimeout(applyCreateOrderSourceAndAdPatch, 900);
    }

    function hideElement(element) {
    if (!element || !element.style) {
    return;
    }

    element.dataset.luxiraHiddenBySourceFilter = '1';
    element.style.setProperty('display', 'none', 'important');
    element.setAttribute('aria-hidden', 'true');
    }

    function showElement(element) {
    if (!element || !element.style) {
    return;
    }

    if (element.dataset.luxiraHiddenBySourceFilter === '1') {
    element.style.removeProperty('display');
    element.removeAttribute('aria-hidden');
    delete element.dataset.luxiraHiddenBySourceFilter;
    }
    }

    function filterNativeSourceSelects() {
    var root = getCreateOrderRoot();
    var selects = Array.from(root.querySelectorAll('select')).filter(function (select) {
    var marker = [select.id || '', select.name || '', select.getAttribute('data-field') || '', select.getAttribute('data-name') || ''].join(' ');
    if (normalizeLuxiraText(marker).indexOf('ordersource') >= 0) {
    return true;
    }

    var smallContainer = select.closest('.form-group, .mb-3, .mb-2, .col-12, .col-lg, .col-md, .col-sm, .input-group, .custom-inpage-dropdown, .selected-company');
    return smallContainer && looksLikeSourceLabelText(smallContainer.textContent || '');
    });

    selects.forEach(function (select) {
    var options = Array.from(select.options || []);
    if (!options.length) {
    return;
    }

    var hasAllowed = options.some(function (option) {
    return isAllowedSourceText(option.textContent, option.value);
    });

    if (!hasAllowed) {
    return;
    }

    options.forEach(function (option) {
    var keep = isPlaceholderSource(option.textContent, option.value) || isAllowedSourceText(option.textContent, option.value);
    option.hidden = !keep;
    option.disabled = !keep;
    });

    if (select.selectedOptions && select.selectedOptions.length && select.selectedOptions[0].disabled) {
    var firstAllowed = options.find(function (option) {
    return !option.disabled && !isPlaceholderSource(option.textContent, option.value);
    }) || options.find(function (option) {
    return !option.disabled;
    });

    if (firstAllowed) {
    select.value = firstAllowed.value;
    select.dispatchEvent(new Event('change', { bubbles: true }));
    }
    }
    });
    }

    function getDirectOptionItem(element) {
    if (!element) {
    return null;
    }

    return element.closest('.dropdown-item, .drop-down-design, [role="option"], li, a, button, label, .card, .col, .col-6, .col-md-4, .col-lg-3, .source-item, .order-source-item, .source-card, .select2-results__option') || element;
    }

    function filterOptionsInsideSourceContainers() {
    var root = getCreateOrderRoot();
    var sourceContainers = [];

    Array.from(root.querySelectorAll('label, span, div, p, h1, h2, h3, h4, h5, h6')).forEach(function (label) {
    if (!looksLikeSourceLabelText(label.textContent || '')) {
    return;
    }

    var container = label.closest('.form-group, .mb-3, .mb-2, .col-12, .col-lg, .col-md, .col-sm, .input-group, .custom-inpage-dropdown, .card, .row, .modal-body');
    if (container) {
    sourceContainers.push(container);
    }
    });

    sourceContainers.forEach(function (container) {
    var candidates = Array.from(container.querySelectorAll('.dropdown-item, .drop-down-design, [role="option"], li, a, button, label, .card, .source-card, .order-source-item, .source-item, [data-value], [data-id]'));

    candidates.forEach(function (candidate) {
    if (!candidate || candidate.closest('select')) {
    return;
    }

    var text = candidate.textContent || '';
    var value = candidate.getAttribute('data-value') || candidate.getAttribute('data-id') || candidate.getAttribute('value') || '';

    if (isAllowedSourceText(text, value) || isPlaceholderSource(text, value)) {
    showElement(candidate);
    } else if (text.trim() !== '') {
    hideElement(candidate);
    }
    });
    });
    }

    function filterOpenSourcePickerPopup() {
    if (Date.now() > sourcePickerModeUntil) {
    return;
    }

    var popupSelectors = [
    '.select2-container--open .select2-results__options',
    '.select2-results__options',
    '.dropdown-menu.show',
    '.dropdown.show .dropdown-menu',
    '.swal2-popup',
    '.swal2-container',
    '.modal.show .dropdown-menu',
    '#Create .dropdown',
    '#Create .modal-body'
    ];

    Array.from(document.querySelectorAll(popupSelectors.join(','))).forEach(function (popup) {
    if (!popup) {
    return;
    }

    var candidates = Array.from(popup.querySelectorAll('.select2-results__option, .dropdown-item, .drop-down-design, [role="option"], li, a, button, label, .card, .source-card, .order-source-item, .source-item, [data-value], [data-id]'));

    if (!candidates.length) {
    candidates = Array.from(popup.children || []);
    }

    var visibleTextCandidates = candidates.filter(function (item) {
    return item && (item.textContent || '').trim() !== '';
    });

    var allowedCount = visibleTextCandidates.filter(function (item) {
    var text = item.textContent || '';
    var value = item.getAttribute('data-value') || item.getAttribute('data-id') || item.getAttribute('value') || '';
    return isAllowedSourceText(text, value);
    }).length;

    // لا نلمس أي Popup إلا لو فعلاً فيه اختيارات واتساب/فيس/انستا أو المستخدم فاتح نوع الصفحة.
    if (allowedCount < 1) {
    return;
    }

    visibleTextCandidates.forEach(function (item) {
    var optionItem = getDirectOptionItem(item);
    var text = optionItem.textContent || '';
    var value = optionItem.getAttribute('data-value') || optionItem.getAttribute('data-id') || optionItem.getAttribute('value') || '';
    var keep = isAllowedSourceText(text, value) || isPlaceholderSource(text, value);

    if (keep) {
    showElement(optionItem);
    } else {
    hideElement(optionItem);
    }
    });
    });
    }

    function findAdPickerContainer() {
    var roots = [];
    var createModal = document.getElementById('Create');

    if (createModal) {
    roots.push(createModal);
    }

    Array.from(document.querySelectorAll('.swal2-popup, .swal2-container, .modal.show, .modal-body')).forEach(function (root) {
    roots.push(root);
    });

    for (var r = 0; r < roots.length; r++) {
    var root = roots[r];
    if (!root) continue;

    var text = normalizeLuxiraText(root.textContent || '');
    var hasNoAd = text.indexOf('بدون اعلان') >= 0;
    var hasAdText = text.indexOf('اعلان الطلب') >= 0 || text.indexOf('صوره اعلان') >= 0 || text.indexOf('صورة اعلان') >= 0;
    var hasMultipleImages = root.querySelectorAll('img').length >= 2;

    if (hasNoAd || (hasAdText && hasMultipleImages)) {
    var exactNoAd = Array.from(root.querySelectorAll('button, a, label, div, span')).find(function (el) {
    return normalizeLuxiraText(el.textContent || '').indexOf('بدون اعلان') >= 0;
    });

    if (exactNoAd) {
    var container = exactNoAd.closest('.swal2-popup, .modal-content, .modal-body, .dropdown-menu, .card, .row, .d-flex, .justify-content-center') || root;
    return container;
    }

    return root;
    }
    }

    return null;
    }

    function addChooseAdTitle() {
    var container = findAdPickerContainer();
    if (!container || container.querySelector('.luxira-choose-ad-title')) {
    return;
    }

    var title = document.createElement('div');
    title.className = 'luxira-choose-ad-title';
    title.textContent = 'اختار الاعلان';
    title.style.cssText = 'width:100%;text-align:center;font-weight:700;font-size:14px;color:#111827;margin:0 0 8px 0;direction:rtl;';

    container.insertBefore(title, container.firstChild);
    }

    function applyCreateOrderSourceAndAdPatch() {
    if (!isCreateOrderOpen()) {
    return;
    }

    filterNativeSourceSelects();
    filterOptionsInsideSourceContainers();
    filterOpenSourcePickerPopup();
    addChooseAdTitle();
    }

    window.luxiraApplyCreateOrderSourceAndAdPatch = applyCreateOrderSourceAndAdPatch;

    document.addEventListener('pointerdown', function (event) {
    if (isInsideSourceArea(event.target)) {
    enableSourcePickerMode();
    }
    }, true);

    document.addEventListener('click', function (event) {
    if (isInsideSourceArea(event.target)) {
    enableSourcePickerMode();
    }

    setTimeout(applyCreateOrderSourceAndAdPatch, 80);
    setTimeout(applyCreateOrderSourceAndAdPatch, 260);
    }, true);

    document.addEventListener('shown.bs.modal', function (event) {
    if (event.target && event.target.id === 'Create') {
    setTimeout(applyCreateOrderSourceAndAdPatch, 80);
    setTimeout(applyCreateOrderSourceAndAdPatch, 350);
    setTimeout(applyCreateOrderSourceAndAdPatch, 900);
    }
    }, true);

    if (window.jQuery) {
    $(document).ajaxSuccess(function (event, xhr, settings) {
    var url = String(settings && settings.url ? settings.url : '').toLowerCase();
    if (url.indexOf('/home/createorder') !== -1) {
    setTimeout(applyCreateOrderSourceAndAdPatch, 120);
    setTimeout(applyCreateOrderSourceAndAdPatch, 450);
    setTimeout(applyCreateOrderSourceAndAdPatch, 1000);
    }
    });
    }

    if (window.MutationObserver) {
    var observer = new MutationObserver(function () {
    if (!isCreateOrderOpen()) {
    return;
    }

    setTimeout(applyCreateOrderSourceAndAdPatch, 60);
    });

    observer.observe(document.body, {
    childList: true,
    subtree: true
    });
    }
    })();
</script>


