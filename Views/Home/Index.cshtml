@functions {
    // Countries whose phones should display and copy as the bare national number
    // (no country code, no leading 0).
    static bool ShouldStripCountryCodeForDisplay(Common.Countries c)
    {
        return c == Common.Countries.البحرين
            || c == Common.Countries.الكويت
            || c == Common.Countries.سلطنة_عمان
            || c == Common.Countries.قطر
            || c == Common.Countries.تونس;
    }

    // Normalize a stored phone number to local-dialing form "0<national>"
    // (e.g. Iraq 07xxxxxxxx, Turkey 05xxxxxxxxx, UAE 05xxxxxxxx).
    // Used for countries whose local format INCLUDES a leading 0.
    // For countries without a leading 0 (Qatar, Oman, Bahrain, Kuwait, Tunisia)
    // use StripCountryCodeAndLeadingZero instead.
    static string NormalizePhoneForDisplay(string raw, string countryName)
    {
        if (string.IsNullOrWhiteSpace(raw)) return raw ?? string.Empty;
        var cleaned = new string(raw.Where(c => c != '-' && !char.IsWhiteSpace(c)).ToArray());
        if (string.IsNullOrEmpty(cleaned)) return string.Empty;

        string code = Common.GetPhoneNumberCodeByCountryStatus(countryName);
        if (string.IsNullOrEmpty(code) || code == "Country not found" || code == "Invalid country name")
            return cleaned;

        string digits = code.TrimStart('+');

        // Strip international prefixes so we're left with national digits.
        if (cleaned.StartsWith("00" + digits))
            cleaned = cleaned.Substring(2 + digits.Length);
        else if (cleaned.StartsWith("+" + digits))
            cleaned = cleaned.Substring(1 + digits.Length);

        // Local-dialing form: single leading 0.
        if (!cleaned.StartsWith("0"))
            cleaned = "0" + cleaned;

        return cleaned;
    }

    // Strip both the country code and any leading 0 — yields bare national subscriber digits.
    static string StripCountryCodeAndLeadingZero(string raw, string countryName)
    {
        if (string.IsNullOrWhiteSpace(raw)) return raw ?? string.Empty;
        var cleaned = new string(raw.Where(c => c != '-' && !char.IsWhiteSpace(c)).ToArray());
        if (string.IsNullOrEmpty(cleaned)) return string.Empty;

        string code = Common.GetPhoneNumberCodeByCountryStatus(countryName);
        string digits = string.IsNullOrEmpty(code) ? string.Empty : code.TrimStart('+');

        if (!string.IsNullOrEmpty(digits))
        {
            if (cleaned.StartsWith("00" + digits)) cleaned = cleaned.Substring(2 + digits.Length);
            else if (cleaned.StartsWith("+" + digits)) cleaned = cleaned.Substring(1 + digits.Length);
        }
        if (cleaned.StartsWith("0")) cleaned = cleaned.Substring(1);
        return cleaned;
    }

    static string PhoneForDisplay(string raw, Common.Countries country)
    {
        var name = country.ToString();
        return ShouldStripCountryCodeForDisplay(country)
            ? StripCountryCodeAndLeadingZero(raw, name)
            : NormalizePhoneForDisplay(raw, name);
    }


    // Reads how many times the order was processed/fixed.
    // Details page uses Model.FixedOrderTimes, so this must be checked first.
    static int GetProcessedFlowCount(object order)
    {
        if (order == null) return 0;

        var type = order.GetType();
        string[] directCountProps = new[]
        {
            "FixedOrderTimes", "fixedOrderTimes",
            "FixedOrderTime", "fixedOrderTime",
            "FixedOrdersTimes", "fixedOrdersTimes",
            "ProcessedCount", "processedCount",
            "FixedOrderCount", "fixedOrderCount",
            "FixedOrdersCount", "fixedOrdersCount",
            "FixedAndDeliveredCount", "fixedAndDeliveredCount",
            "ProcessedTimes", "processedTimes",
            "FixedTimes", "fixedTimes",
            "OrderProcessedCount", "orderProcessedCount",
            "ProcessingCount", "processingCount",
            "ProcessedOrdersCount", "processedOrdersCount"
        };

        foreach (var propName in directCountProps)
        {
            var prop = type.GetProperty(propName);
            if (prop == null) continue;

            var value = prop.GetValue(order);
            if (value == null) continue;

            try
            {
                var count = System.Convert.ToInt32(value);
                if (count > 0) return count;
            }
            catch { }
        }

        string[] processedFlagProps = new[]
        {
            "IsFixedBefore", "isFixedBefore",
            "IsProcessed", "isProcessed",
            "WasProcessed", "wasProcessed",
            "IsProcessedBefore", "isProcessedBefore",
            "IsFixed", "isFixed"
        };

        foreach (var propName in processedFlagProps)
        {
            var prop = type.GetProperty(propName);
            if (prop == null) continue;

            var value = prop.GetValue(order);
            if (value == null) continue;

            try
            {
                if (System.Convert.ToBoolean(value)) return 1;
            }
            catch { }
        }

        string[] historyProps = new[]
        {
            "OrderHistories", "OrderHistory",
            "OrderLogs", "Logs",
            "OrderStatusHistories", "StatusHistories",
            "OrderUpdates", "Updates",
            "OrderPosts", "Posts",
            "Histories"
        };

        foreach (var propName in historyProps)
        {
            var prop = type.GetProperty(propName);
            if (prop == null) continue;

            var collection = prop.GetValue(order) as System.Collections.IEnumerable;
            if (collection == null || collection is string) continue;

            int count = 0;
            foreach (var item in collection)
            {
                if (item == null) continue;
                var itemType = item.GetType();
                string[] statusProps = new[]
                {
                    "OrderStatus", "Status", "NewStatus", "OldStatus",
                    "StatusText", "Action", "ActionName", "Title", "Body", "Description"
                };

                foreach (var statusPropName in statusProps)
                {
                    var statusProp = itemType.GetProperty(statusPropName);
                    if (statusProp == null) continue;

                    var statusValue = statusProp.GetValue(item)?.ToString() ?? string.Empty;
                    if (statusValue.Contains("تم_المعالجة")
                        || statusValue.Contains("تم المعالجة")
                        || statusValue.Contains("FixedAndDelivered")
                        || statusValue.Contains("Fixed"))
                    {
                        count++;
                        break;
                    }
                }
            }

            if (count > 0) return count;
        }

        var fixedDateProp = type.GetProperty("FixedOrderDate") ?? type.GetProperty("fixedOrderDate");
        var fixedDateValue = fixedDateProp?.GetValue(order);
        return fixedDateValue == null ? 0 : 1;
    }

    // Reads the delivery cost for the order shown in the Home/Index table.
    // Details page uses DeliveryCost, while some list/DTO objects may expose DeliveryPrice.
    static decimal? GetHomeOrderDeliveryCost(object order)
    {
        if (order == null) return null;

        var type = order.GetType();

        string[] deliveryCostProps = new[]
        {
            "DeliveryCost", "deliveryCost",
            "DeliveryPrice", "deliveryPrice",
            "DeliveryFee", "deliveryFee",
            "DeliveryFees", "deliveryFees",
            "ShippingCost", "shippingCost",
            "ShippingPrice", "shippingPrice",
            "ShippingFee", "shippingFee",
            "DeliveryAmount", "deliveryAmount",
            "DeliveryCostAmount", "deliveryCostAmount",
            "DeliveryPriceAmount", "deliveryPriceAmount",
            "OrderDeliveryCost", "orderDeliveryCost",
            "OrderDeliveryPrice", "orderDeliveryPrice",
            "ReceiptDeliveryCost", "receiptDeliveryCost",
            "ReceiptDeliveryPrice", "receiptDeliveryPrice"
        };

        foreach (var propName in deliveryCostProps)
        {
            var prop = type.GetProperty(propName);
            if (prop == null) continue;

            var value = prop.GetValue(order);
            if (value == null) continue;

            try
            {
                if (value is decimal decimalValue)
                {
                    return decimalValue;
                }

                if (value is double doubleValue)
                {
                    return Convert.ToDecimal(doubleValue);
                }

                if (value is float floatValue)
                {
                    return Convert.ToDecimal(floatValue);
                }

                var text = value.ToString();

                if (string.IsNullOrWhiteSpace(text))
                {
                    continue;
                }

                text = text
                    .Replace(",", "")
                    .Replace("LYD", "", StringComparison.OrdinalIgnoreCase)
                    .Replace("TRY", "", StringComparison.OrdinalIgnoreCase)
                    .Replace("IQD", "", StringComparison.OrdinalIgnoreCase)
                    .Replace("JOD", "", StringComparison.OrdinalIgnoreCase)
                    .Replace("USD", "", StringComparison.OrdinalIgnoreCase)
                    .Replace("EGP", "", StringComparison.OrdinalIgnoreCase)
                    .Trim();

                if (decimal.TryParse(text, NumberStyles.Any, CultureInfo.InvariantCulture, out var invariantValue))
                {
                    return invariantValue;
                }

                if (decimal.TryParse(text, NumberStyles.Any, CultureInfo.CurrentCulture, out var currentValue))
                {
                    return currentValue;
                }
            }
            catch
            {
                // Keep scanning the other possible property names.
            }
        }

        return null;
    }


    private static string NormalizeCommissionStatusText(object? value)
    {
        var text = value?.ToString() ?? string.Empty;

        return text
            .Trim()
            .Replace('أ', 'ا')
            .Replace('إ', 'ا')
            .Replace('آ', 'ا')
            .Replace('ة', 'ه');
    }

    private static bool CommissionStatusEqualsAny(string status, string[] statuses)
    {
        foreach (var item in statuses)
        {
            if (string.Equals(status, item, StringComparison.OrdinalIgnoreCase))
            {
                return true;
            }
        }

        return false;
    }

    private static string GetCallCenterCommissionState(object? orderStatus)
    {
        var status = NormalizeCommissionStatusText(orderStatus);

        var dueStatuses = new[]
        {
            "تم_التسليم",
            "تم_تحديث_الرصيد",
            "تم_الدفع"
        };

        var pendingStatuses = new[]
        {
            "طلب_جديد",
            "تم_التجهيز",
            "قيد_التوصيل",
            "تم_المعالجه",
            "تم_التسليم_المؤقت",
            "الطلبات_المؤجله",
            "الطلبات_الغير_مكتمله",
            "الطلبات_الغير_مكتمله",
            "غير_مكتمله",
            "غير مكتمله",
            "الطلبات الغير مكتمله"
        };

        var notDueStatuses = new[]
        {
            "انتظار_معالجه",
            "انتظار المعالجه",
            "الطلبات_المرجعيه",
            "الطلبات المرجعيه",
            "تم_الالغاء",
            "تم الالغاء",
            "ارشيف_المرجع",
            "ارشيف المرجع"
        };

        if (CommissionStatusEqualsAny(status, dueStatuses))
        {
            return "due";
        }

        if (status.StartsWith("فشل_التسليم", StringComparison.OrdinalIgnoreCase) ||
            status.StartsWith("فشل التسليم", StringComparison.OrdinalIgnoreCase) ||
            CommissionStatusEqualsAny(status, notDueStatuses))
        {
            return "not-due";
        }

        if (CommissionStatusEqualsAny(status, pendingStatuses))
        {
            return "pending";
        }

        return "pending";
    }

    private static string GetCallCenterCommissionText(object? orderStatus)
    {
        var state = GetCallCenterCommissionState(orderStatus);

        if (state == "due")
        {
            return "عمولة مستحقة";
        }

        if (state == "not-due")
        {
            return "عمولة غير مستحقة";
        }

        return "عمولة قيد الاعتماد";
    }

    private static bool ReadBooleanFlagFromObject(object? source, params string[] propertyNames)
    {
        if (source == null)
        {
            return false;
        }

        var type = source.GetType();

        foreach (var propertyName in propertyNames)
        {
            var prop = type.GetProperty(propertyName);
            if (prop == null)
            {
                continue;
            }

            var value = prop.GetValue(source);
            if (value == null)
            {
                continue;
            }

            try
            {
                if (value is bool boolValue)
                {
                    return boolValue;
                }

                if (value is int intValue)
                {
                    return intValue > 0;
                }

                if (bool.TryParse(value.ToString(), out var parsedBool))
                {
                    return parsedBool;
                }

                if (int.TryParse(value.ToString(), out var parsedInt))
                {
                    return parsedInt > 0;
                }
            }
            catch
            {
            }
        }

        return false;
    }

    private static bool OrderHasPreviouslyDelayedStatus(object? order)
    {
        if (order == null)
        {
            return false;
        }

        if (ReadBooleanFlagFromObject(
                order,
                "WasPreviouslyPostponed",
                "WasPostponedBefore",
                "WasPreviouslyDelayed",
                "WasDelayedBefore",
                "IsPreviouslyPostponed",
                "IsPreviouslyDelayed",
                "HasPreviousPostponedStatus",
                "HasPreviousDelayedStatus",
                "PreviouslyPostponed",
                "PreviouslyDelayed"))
        {
            return true;
        }

        var type = order.GetType();

        foreach (var collectionName in new[]
        {
            "OrderStatusHistories",
            "StatusHistories",
            "OrderHistories",
            "Histories",
            "OrderLogs",
            "Logs"
        })
        {
            var prop = type.GetProperty(collectionName);
            if (prop == null)
            {
                continue;
            }

            var collection = prop.GetValue(order) as System.Collections.IEnumerable;
            if (collection == null || collection is string)
            {
                continue;
            }

            foreach (var item in collection)
            {
                if (item == null)
                {
                    continue;
                }

                var itemType = item.GetType();

                foreach (var statusPropertyName in new[]
                {
                    "Status",
                    "OrderStatus",
                    "NewStatus",
                    "OldStatus",
                    "StatusText",
                    "Action",
                    "Description"
                })
                {
                    var statusProp = itemType.GetProperty(statusPropertyName);
                    if (statusProp == null)
                    {
                        continue;
                    }

                    var statusText = statusProp.GetValue(item)?.ToString() ?? string.Empty;

                    if (statusText.Contains("الطلبات_المؤجلة")
                        || statusText.Contains("الطلبات المؤجلة")
                        || statusText.Contains("الطلبات_المؤجله")
                        || statusText.Contains("الطلبات المؤجله"))
                    {
                        return true;
                    }
                }
            }
        }

        return false;
    }
}

