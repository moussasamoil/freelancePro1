    function getAntiForgeryToken() {
    const tokenInput = document.querySelector('#luxiraMetaActionAntiForgeryForm input[name="__RequestVerificationToken"], input[name="__RequestVerificationToken"]');
    return tokenInput ? tokenInput.value : '';
    }

    function escapeHtml(value) {
    return String(value || '')
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#039;');
    }

    function getDisplayReason(log) {
    if (!log) return '';
    const rawReason = (log && log.reason) || '';
    const reason = (rawReason === 'متابعة توصيل' || rawReason === 'موافقة') ? 'متابعة التوصيل' : rawReason;
    return reason === 'أخرى' && log.otherText
    ? 'أخرى - ' + log.otherText
    : reason;
    }


    function getDisplayContactType(log) {
    const value = String((log && (log.contactType || log.linkType || log.buttonType)) || '').toLowerCase();
    const url = String((log && (log.metaUrl || log.url)) || '').toLowerCase();

    if (value.indexOf('whatsapp') >= 0 || value.indexOf('واتساب') >= 0 || url.indexOf('whatsapp') >= 0 || url.indexOf('wa.me') >= 0) {
    return 'واتساب';
    }

    return 'ميتا';
    }

    function normalizeLuxiraCountryName(value) {
