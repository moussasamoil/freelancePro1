<script id="luxira-order-pin-action-script">
    (function () {
    const canUsePinning = @(User.IsInRole("Admin") || User.IsInRole("ExecutiveDirector") || User.IsInRole("FollowUpDepartment") || User.IsInRole("CallCenter") ? "true" : "false");

    if (!canUsePinning) {
    return;
    }

    let pinNotificationTimer = null;

    function ensurePinNotification() {
    let backdrop = document.getElementById('pinCenterNotificationBackdrop');

    if (backdrop) {
    return backdrop;
    }

    backdrop = document.createElement('div');
    backdrop.id = 'pinCenterNotificationBackdrop';
    backdrop.className = 'pin-center-notification-backdrop';
    backdrop.innerHTML =
    '<div class="pin-center-notification-card" role="alertdialog" aria-modal="true">' +
    '<div class="pin-center-notification-icon">✓</div>' +
    '<div class="pin-center-notification-message"></div>' +
    '<button type="button" class="pin-center-notification-ok">تأكيد</button>' +
    '</div>';

    document.body.appendChild(backdrop);

    const okButton = backdrop.querySelector('.pin-center-notification-ok');
    if (okButton) {
    okButton.addEventListener('click', hidePinMessage);
    }

    backdrop.addEventListener('click', function (event) {
    if (event.target === backdrop) {
    hidePinMessage();
    }
    });

    return backdrop;
    }

    function hidePinMessage() {
    const backdrop = document.getElementById('pinCenterNotificationBackdrop');

    if (pinNotificationTimer) {
    clearTimeout(pinNotificationTimer);
    pinNotificationTimer = null;
    }

    if (backdrop) {
    backdrop.classList.remove('is-visible', 'is-success', 'is-error');
    }
    }

    function showPinMessage(message, isSuccess) {
    const backdrop = ensurePinNotification();
    const messageBox = backdrop.querySelector('.pin-center-notification-message');
    const icon = backdrop.querySelector('.pin-center-notification-icon');

    if (messageBox) {
    messageBox.textContent = message || '';
    }

    if (icon) {
    icon.textContent = isSuccess ? '✓' : '!';
    }

    backdrop.classList.remove('is-success', 'is-error');
    backdrop.classList.add(isSuccess ? 'is-success' : 'is-error', 'is-visible');

    if (pinNotificationTimer) {
    clearTimeout(pinNotificationTimer);
    }

    pinNotificationTimer = setTimeout(hidePinMessage, 3000);
    }

    function setPinButtonLoading(button, isLoading) {
    if (!button) return;

    button.disabled = isLoading;
    button.style.opacity = isLoading ? ".65" : "";
    button.style.pointerEvents = isLoading ? "none" : "";

    const textNode = button.querySelector('.order-pin-text');
    if (textNode) {
    if (isLoading) {
    textNode.setAttribute('data-old-text', textNode.textContent || '');
    textNode.textContent = 'جاري الحفظ...';
    } else {
    const oldText = textNode.getAttribute('data-old-text');
    if (oldText) {
    textNode.textContent = oldText;
    textNode.removeAttribute('data-old-text');
    }
    }
    }
    }

    function applyPinStateToButton(button, isPinned) {
    if (!button) return;

    const textNode = button.querySelector('.order-pin-text');

    button.classList.toggle('is-pinned', !!isPinned);
    button.setAttribute('data-is-pinned', isPinned ? 'true' : 'false');
    button.setAttribute('aria-pressed', isPinned ? 'true' : 'false');
    button.setAttribute('title', isPinned ? 'إلغاء تثبيت الطلب' : 'تثبيت الطلب');

    if (textNode) {
    textNode.textContent = isPinned ? 'مثبت' : 'تثبيت';
    }
    }

    function updatePinnedOrderRowWithoutReload(orderId, isPinned) {
    const row = document.querySelector('#ordersTable tbody tr[data-order-id="' + orderId + '"]');
    if (!row) return;

    row.classList.toggle('order-row-pinned', !!isPinned);
    row.setAttribute('data-is-pinned', isPinned ? 'true' : 'false');
    row.setAttribute('data-auto-pinned', 'false');

    const idCell = row.querySelector('td:first-child');
    if (idCell) {
    let pinIcon = idCell.querySelector('.order-pinned-id-icon');

    if (isPinned && !pinIcon) {
    pinIcon = document.createElement('span');
    pinIcon.className = 'order-pinned-id-icon';
    pinIcon.setAttribute('aria-hidden', 'true');
    pinIcon.innerHTML = '<svg class="pin-gray-svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M16.35 3.35a1.2 1.2 0 0 1 1.7 0l2.6 2.6a1.2 1.2 0 0 1 0 1.7l-1.9 1.9 1.05 4.2a1.15 1.15 0 0 1-.3 1.08l-.68.68a1.15 1.15 0 0 1-1.42.17l-4.25-2.43-3.18 3.18.18 2.55a1.1 1.1 0 0 1-.32.86l-.95.95a1.1 1.1 0 0 1-1.72-.22l-1.45-2.73-2.73-1.45a1.1 1.1 0 0 1-.22-1.72l.95-.95a1.1 1.1 0 0 1 .86-.32l2.55.18 3.18-3.18-2.43-4.25a1.15 1.15 0 0 1 .17-1.42l.68-.68a1.15 1.15 0 0 1 1.08-.3l4.2 1.05 1.9-1.9Z"/></svg>';
    idCell.appendChild(document.createTextNode(' '));
    idCell.appendChild(pinIcon);
    }

    if (!isPinned && pinIcon) {
    pinIcon.remove();
    }
    }

    if (isPinned) {
    const tbody = row.parentElement;
    if (tbody && tbody.firstElementChild !== row) {
    tbody.insertBefore(row, tbody.firstElementChild);
    }
    }
    }

    document.addEventListener('click', async function (event) {
    const pinButton = event.target.closest && event.target.closest('.order-table-action-pin[data-order-id]');

    if (!pinButton) {
    return;
    }

    event.preventDefault();
    event.stopPropagation();

    if (typeof event.stopImmediatePropagation === 'function') {
    event.stopImmediatePropagation();
    }

    const orderId = parseInt(pinButton.getAttribute('data-order-id') || '0', 10);

    if (!orderId) {
    showPinMessage('رقم الطلب غير صحيح', false);
    return;
    }

    setPinButtonLoading(pinButton, true);

    try {
    const response = await fetch('/Home/ToggleOrderPin', {
    method: 'POST',
    headers: {
    'Content-Type': 'application/json',
    'Accept': 'application/json'
    },
    body: JSON.stringify({ orderId: orderId })
    });

    const result = await response.json();

    if (!response.ok || !result || !result.success) {
    throw new Error(result && result.message ? result.message : 'حدث خطأ أثناء تثبيت الطلب');
    }

    const newPinState = result.isPinned === true;
    applyPinStateToButton(pinButton, newPinState);
    updatePinnedOrderRowWithoutReload(orderId, newPinState);
    showPinMessage(newPinState ? 'تم تثبيت الطلب' : 'تم إلغاء تثبيت الطلب', true);
    setPinButtonLoading(pinButton, false);
    } catch (error) {
    showPinMessage(error && error.message ? error.message : 'حدث خطأ أثناء تثبيت الطلب', false);
    setPinButtonLoading(pinButton, false);
    }
    }, true);
    })();
</script>

