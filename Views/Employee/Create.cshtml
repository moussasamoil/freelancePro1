        font-size: 18px;
    }

    .employee-file-input {
        display: none;
    }

    .employee-file-preview {
        margin-top: 8px;
        max-width: 135px;
        max-height: 95px;
        border-radius: 10px;
        border: 1px solid #e5e7eb;
        object-fit: cover;
        display: none;
    }

    .store-permission-select + .select2-container {
        width: 100% !important;
    }

    .select2-container--default .select2-selection--multiple {
        padding: 5px 8px !important;
        display: flex !important;
        align-items: center !important;
        min-height: 44px !important;
    }

        .select2-container--default .select2-selection--multiple .select2-selection__choice {
            background: #d6dbe6 !important;
            border: 1px solid #939fb7 !important;
            border-radius: 999px !important;
            color: #1c273c !important;
            font-weight: 800 !important;
            padding: 3px 9px !important;
            margin-top: 4px !important;
        }

    .select2-dropdown {
        border: 1px solid #111827 !important;
        border-radius: 12px !important;
        overflow: hidden !important;
        direction: rtl !important;
    }

    .select2-results__option {
        border-bottom: 1px solid #111827 !important;
        font-weight: 900 !important;
        padding: 10px 12px !important;
    }

        .select2-results__option:last-child {
            border-bottom: 0 !important;
        }

    .select2-option-image {
        width: 24px;
        height: 24px;
        border-radius: 50%;
        object-fit: cover;
        margin-left: 8px;
        border: 1px solid #dbe3ea;
        vertical-align: middle;
    }


    .employee-paste-zone {
        position: relative;
        min-height: 46px !important;
        white-space: nowrap;
        overflow: hidden;
    }

        .employee-paste-zone:focus {
            box-shadow: 0 0 0 2px rgba(24, 160, 136, 0.18), 0px 0px 4px rgba(0, 0, 0, 0.2) !important;
        }

    .employee-file-browse-btn {
        border: 0;
        border-radius: 999px;
        background: rgba(24, 160, 136, 0.12);
        color: #1d273b;
        font-size: 12px;
        font-weight: 900;
        padding: 4px 10px;
        flex: 0 0 auto;
        cursor: pointer;
    }

    .store-permission-select.select2-hidden-accessible {
        display: none !important;
        visibility: hidden !important;
        position: absolute !important;
        width: 1px !important;
        height: 1px !important;
        opacity: 0 !important;
    }

    .store-permission-select + .select2-container {
        width: 100% !important;
        display: block !important;
    }

        .store-permission-select + .select2-container .select2-selection--multiple {
            min-height: 44px !important;
            height: 44px !important;
            border-radius: 8px !important;
            border: 0 !important;
            background-color: #ffffff !important;
            box-shadow: 0px 0px 4px rgba(0, 0, 0, 0.2) !important;
            display: flex !important;
            align-items: center !important;
            padding: 0 14px !important;
            overflow: hidden !important;
            cursor: pointer !important;
        }

        .store-permission-select + .select2-container .select2-selection__rendered {
            width: 100% !important;
            height: 100% !important;
            padding: 0 !important;
            margin: 0 !important;
            display: flex !important;
            align-items: center !important;
            overflow: hidden !important;
        }

        .store-permission-select + .select2-container .select2-selection__choice,
        .store-permission-select + .select2-container .select2-search,
        .store-permission-select + .select2-container .select2-search--inline,
        .store-permission-select + .select2-container .select2-search__field {
            display: none !important;
            width: 0 !important;
            height: 0 !important;
            opacity: 0 !important;
            margin: 0 !important;
            padding: 0 !important;
        }

    .store-select-summary {
        width: 100%;
        display: flex;
        align-items: center;
        gap: 7px;
        color: #64748b;
        font-size: 15px;
        font-weight: 800;
        overflow: hidden;
        white-space: nowrap;
        text-overflow: ellipsis;
        pointer-events: none;
    }

        .store-select-summary.has-values {
            color: #111827;
            font-weight: 900;
        }

        .store-select-summary img {
            width: 22px;
            height: 22px;
            min-width: 22px;
            border-radius: 50%;
            object-fit: cover;
            border: 1px solid #dbe3ea;
        }

        .store-select-summary .summary-text {
            overflow: hidden;
            white-space: nowrap;
            text-overflow: ellipsis;
        }

    .store-permission-select + .select2-container .select2-selection--multiple::after {
        content: "⌄";
        color: #1d273b;
        font-size: 18px;
        font-weight: 900;
        margin-right: auto;
        line-height: 1;
    }

    .store-select2-controls {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 8px;
        background: #f8fafc;
        border-bottom: 1px solid #111827;
        direction: rtl;
    }

    .store-select2-control-btn {
        flex: 1;
        border: 0;
        border-radius: 999px;
        min-height: 31px;
        font-size: 12px;
        font-weight: 900;
        color: #ffffff;
        cursor: pointer;
    }

    .store-select2-select-all {
        background: #1d273b;
    }

    .store-select2-clear-all {
        background: #64748b;
    }


    /* Custom one-input store permissions dropdown */
    .store-permission-select-native {
        display: none !important;
    }

    .store-permission-picker {
        position: relative;
        width: 100%;
    }

    .store-permission-trigger {
        width: 100%;
        height: 44px;
        min-height: 44px;
        border: 0 !important;
        border-radius: 8px !important;
        background: #ffffff !important;
        box-shadow: 0px 0px 4px rgba(0, 0, 0, 0.2) !important;
        color: #111827 !important;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        padding: 0 14px;
        cursor: pointer;
        text-align: right;
        direction: rtl;
        font-size: 15px;
        font-weight: 800;
        overflow: hidden;
    }

        .store-permission-trigger:focus,
        .store-permission-picker.open .store-permission-trigger {
            outline: none !important;
            box-shadow: 0 0 0 2px rgba(24, 160, 136, 0.18), 0px 0px 4px rgba(0, 0, 0, 0.2) !important;
        }

    .store-permission-summary {
        flex: 1 1 auto;
        min-width: 0;
        display: inline-flex;
        align-items: center;
        gap: 7px;
        overflow: hidden;
        white-space: nowrap;
        text-overflow: ellipsis;
        color: #64748b;
    }

        .store-permission-summary.has-values {
            color: #111827;
            font-weight: 900;
        }

        .store-permission-summary img {
            width: 22px;
            height: 22px;
            min-width: 22px;
            border-radius: 50%;
            object-fit: cover;
            border: 1px solid #dbe3ea;
        }

    .store-permission-summary-text {
        overflow: hidden;
        white-space: nowrap;
        text-overflow: ellipsis;
    }

    .store-permission-arrow {
        flex: 0 0 auto;
        color: #1d273b;
        font-size: 18px;
        font-weight: 900;
        line-height: 1;
        transition: transform .15s ease;
    }

    .store-permission-picker.open .store-permission-arrow {
        transform: rotate(180deg);
    }

    .store-permission-menu {
        display: none;
        position: absolute;
        top: calc(100% + 6px);
        right: 0;
        left: 0;
        z-index: 9999;
        background: #ffffff;
        border: 1px solid #111827;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 10px 25px rgba(15, 23, 42, 0.18);
        direction: rtl;
    }

    .store-permission-picker.open .store-permission-menu {
        display: block;
    }

    .store-permission-actions-row {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 8px;
        background: #f8fafc;
        border-bottom: 1px solid #111827;
    }

    .store-action-btn {
        flex: 1 1 0;
        min-height: 31px;
        border: 0;
        border-radius: 999px;
        color: #ffffff;
        font-size: 12px;
        font-weight: 900;
        cursor: pointer;
    }

    .store-action-select-all {
        background: #1d273b;
    }

    .store-action-clear-all {
        background: #64748b;
    }

    .store-permission-options {
        max-height: 260px;
        overflow-y: auto;
        overflow-x: hidden;
    }

    .store-permission-option {
        display: flex !important;
        align-items: center;
        gap: 8px;
        min-height: 42px;
        padding: 9px 12px;
        margin: 0 !important;
        border-bottom: 1px solid #111827;
        color: #111827;
        font-size: 14px;
        font-weight: 900 !important;
        cursor: pointer;
        background: #ffffff;
    }

        .store-permission-option:last-child {
            border-bottom: 0;
        }

        .store-permission-option:hover {
            background: #f1f5f9;
        }

    .store-permission-checkbox {
        display: none;
    }

    .store-check-circle {
        width: 17px;
        height: 17px;
        min-width: 17px;
        border-radius: 50%;
        border: 2px solid #cbd5e1;
        background: #ffffff;
        position: relative;
    }

    .store-permission-checkbox:checked + .store-check-circle {
        border-color: #1d273b;
        background: #1d273b;
    }

        .store-permission-checkbox:checked + .store-check-circle::after {
            content: "";
            position: absolute;
            top: 3px;
            left: 3px;
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: #ffffff;
        }

    .store-option-image {
        width: 24px;
        height: 24px;
        min-width: 24px;
        border-radius: 50%;
        object-fit: cover;
        border: 1px solid #dbe3ea;
    }

    .store-option-name {
        overflow: hidden;
        white-space: nowrap;
        text-overflow: ellipsis;
    }


    .employee-country-select {
        direction: rtl;
        text-align: right;
        cursor: pointer;
    }



    .employee-attendance-options-card {
        border: 1px solid #e9eaec;
        background: #f8fafc;
        border-radius: 14px;
        padding: 14px;
        height: 100%;
    }

    .employee-attendance-options-title {
        color: #1d273b;
        font-size: 15px;
        font-weight: 900;
        margin-bottom: 10px;
    }

    .weekly-off-days-grid {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .weekly-off-day-option {
        position: relative;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 34px;
        padding: 6px 12px;
        border-radius: 999px;
        border: 1px solid #cbd5e1;
        background: #ffffff;
        color: #334155;
        font-size: 13px;
        font-weight: 900;
        cursor: pointer;
        user-select: none;
    }

        .weekly-off-day-option input {
            display: none;
        }

        .weekly-off-day-option:has(input:checked) {
            background: rgba(24, 160, 136, 0.12);
            color: #1c273c;
            border-color: #1d273b;
        }

    .btn-submit-employee {
        background: #1d273b;
        color: #ffffff;
        border: 0;
        border-radius: 999px;
        min-height: 44px;
        padding: 8px 32px;
        font-weight: 900;
        box-shadow: 0 8px 18px rgba(15, 23, 42, 0.12);
    }


    /* Required fields stay required, but without red border/hover or red stars. */
    .required-star {
        display: none !important;
    }

    .employee-create-page.was-validated .form-control:required:invalid,
    .employee-create-page .form-control.input-validation-error,
    .employee-create-page .form-control.employee-required-error,
    .employee-create-page .form-control.is-required-missing,
    .employee-create-page input:required:invalid,
    .employee-create-page select:required:invalid {
        border: 0 !important;
        box-shadow: 0px 0px 4px rgba(0, 0, 0, 0.2) !important;
    }

    .employee-create-page .form-group.has-required-error label,
    .employee-create-page .form-group.has-required-error .control-label {
        color: #334155 !important;
    }

    .employee-create-page .required-error-text,
    .employee-create-page .form-group.has-required-error .required-error-text {
        display: none !important;
    }

    .employee-create-page .form-group.has-required > label::after,
    .employee-create-page label.required-label::after {
        content: "" !important;
        display: none !important;
    }

    .employee-create-error-alert {
        display: none;
        margin-bottom: 14px;
        padding: 10px 14px;
        border-radius: 12px;
        background: rgba(220, 38, 38, 0.08);
        border: 1px solid rgba(220, 38, 38, 0.22);
        color: #dc2626;
        font-size: 15px;
        font-weight: 900;
        text-align: right;
    }

</style>

<div class="employee-create-page">
    <div class="employee-create-title">إنشاء موظف جديد</div>

    <div class="employee-create-card">
        <form id="employeeCreateForm" asp-controller="Employee" asp-action="Create" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div id="employeeCreateErrorAlert" class="employee-create-error-alert" style="display:none;">من فضلك كمّلي الحقول المطلوبة باللون الأحمر.</div>
            <div asp-validation-summary="All" class="text-danger employee-validation-summary"></div>

            <div class="row mt-2">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="Name" class="control-label"></label>
                        <input asp-for="Name" class="form-control" required />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="row mt-2">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="Nationality" class="control-label"></label>
                        <input asp-for="Nationality" class="form-control" required />
                        <span asp-validation-for="Nationality" class="text-danger"></span>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="PhoneNumber" class="control-label"></label>
                        <input asp-for="PhoneNumber" class="form-control" required />
                        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="row mt-2">
                <div class="col-md-6">
                    <div class="form-group">
                        <label for="EmployeeCountry" class="control-label">الدولة</label>
                        <select name="country" id="EmployeeCountry" class="form-control employee-country-select" required>
                            <option value="">اختاري الدولة</option>
                            <option value="Egypt" selected="@(IsCountrySelected("Egypt") ? "selected" : null)">🇪🇬 مصر</option>
                            <option value="Turkey" selected="@(IsCountrySelected("Turkey") ? "selected" : null)">🇹🇷 تركيا</option>
                            <option value="Iraq" selected="@(IsCountrySelected("Iraq") ? "selected" : null)">🇮🇶 العراق</option>
                            <option value="Jordan" selected="@(IsCountrySelected("Jordan") ? "selected" : null)">🇯🇴 الأردن</option>
                            <option value="Libya" selected="@(IsCountrySelected("Libya") ? "selected" : null)">🇱🇾 ليبيا</option>
                            <option value="Kuwait" selected="@(IsCountrySelected("Kuwait") ? "selected" : null)">🇰🇼 الكويت</option>
                            <option value="Qatar" selected="@(IsCountrySelected("Qatar") ? "selected" : null)">🇶🇦 قطر</option>
                            <option value="Oman" selected="@(IsCountrySelected("Oman") ? "selected" : null)">🇴🇲 عمان</option>
                            <option value="Bahrain" selected="@(IsCountrySelected("Bahrain") ? "selected" : null)">🇧🇭 البحرين</option>
                            <option value="Tunisia" selected="@(IsCountrySelected("Tunisia") ? "selected" : null)">🇹🇳 تونس</option>
                        </select>
                        <span class="text-danger" data-valmsg-for="country"></span>
                    </div>
                </div>
            </div>


            <div class="row mt-2">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="Cv" class="control-label"></label>
                        <input type="file" name="cvFile" class="form-control-file" accept="application/pdf" />
                        <span asp-validation-for="Cv" class="text-danger"></span>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="Img" class="control-label"></label>
                        <input type="file" name="imgFile" class="form-control-file image-upload" accept="image/*" />
                        <span asp-validation-for="Img" class="text-danger"></span>
                        <img id="logoImage" class="image-upload img-fluid" src="" alt="Uploaded Logo" style="display: none; max-width: 200px; max-height: 150px;" />
                    </div>
                </div>
            </div>

            <div class="row mt-2">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="IdNumber" class="control-label"></label>
                        <input asp-for="IdNumber" class="form-control" required />
                        <span asp-validation-for="IdNumber" class="text-danger"></span>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="Address" class="control-label"></label>
                        <input asp-for="Address" class="form-control" required />
                        <span asp-validation-for="Address" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="row mt-2">
                <div class="col-md-6">
                    <div class="form-group">
                        <label>صورة البطاقة - وش</label>
                        <div class="employee-file-trigger employee-paste-zone" tabindex="0" role="textbox" aria-label="اضف صورة البطاقة وش" data-input-id="IdCardFrontFile">
                            <span class="employee-file-placeholder" data-placeholder-for="IdCardFrontFile">اضف صورة البطاقة وش أو اضغطي Ctrl+V</span>
                            <button type="button" class="employee-file-browse-btn" data-browse-input="IdCardFrontFile">اختيار ملف</button>
                            <i class="fa-solid fa-id-card employee-file-icon"></i>
                        </div>
                        <input type="file" name="idCardFrontFile" id="IdCardFrontFile" class="employee-file-input employee-id-card-input" accept="image/*" />
                        <img id="IdCardFrontPreview" class="employee-file-preview" alt="صورة البطاقة وش" />
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-group">
                        <label>صورة البطاقة - ظهر</label>
                        <div class="employee-file-trigger employee-paste-zone" tabindex="0" role="textbox" aria-label="اضف صورة البطاقة ظهر" data-input-id="IdCardBackFile">
                            <span class="employee-file-placeholder" data-placeholder-for="IdCardBackFile">اضف صورة البطاقة ظهر أو اضغطي Ctrl+V</span>
                            <button type="button" class="employee-file-browse-btn" data-browse-input="IdCardBackFile">اختيار ملف</button>
                            <i class="fa-solid fa-id-card-clip employee-file-icon"></i>
                        </div>
                        <input type="file" name="idCardBackFile" id="IdCardBackFile" class="employee-file-input employee-id-card-input" accept="image/*" />
                        <img id="IdCardBackPreview" class="employee-file-preview" alt="صورة البطاقة ظهر" />
                    </div>
                </div>
            </div>

            <div class="row mt-2">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="Salary" class="control-label"></label>
                        <input asp-for="Salary" class="form-control" required />
                        <span asp-validation-for="Salary" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="row mt-2">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="Email" class="control-label"></label>
                        <input asp-for="Email" class="form-control" required />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="Password" class="control-label"></label>
                        <input asp-for="Password" type="password" class="form-control" required />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="row mt-2">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="ConfirmPassword" class="control-label"></label>
                        <input asp-for="ConfirmPassword" type="password" class="form-control" required />
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="row mt-2">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="Gender" class="control-label"></label>
                        <select asp-for="Gender" class="form-control">
                            <option value="false">ذكر</option>
                            <option value="true">انثى</option>
                        </select>
                        <span asp-validation-for="Gender" class="text-danger"></span>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-group">
                        <label for="Role" class="control-label">الصلاحيات</label>
                        <select asp-for="Role" class="form-control" id="Role" required>
                            <option value="">اختار الصلاحية</option>
                            @if (Model.Roles != null)
                            {
                                foreach (var roleName in Model.Roles as List<string>)
                                {
                                    <option value="@roleName">@roleName</option>
                                }
                            }
                        </select>
                    </div>
                </div>
                <div class="col-md-6" id="CheckInVerificationMethodWrapper">
                    <div class="form-group">
                        <label class="control-label" for="CheckInVerificationMethod">بصمة دخول</label>
                        <select id="CheckInVerificationMethod"
                                name="checkInVerificationMethod"
                                class="form-control"
                                required>
                            @{
                                var currentCheckInMethod = (ViewBag.CheckInVerificationMethod?.ToString() ?? "Photo").Trim();
                            }
                            @if (string.Equals(currentCheckInMethod, "Question", StringComparison.OrdinalIgnoreCase))
                            {
                                <option value="Photo">تسجيل بصورة</option>
                                <option value="Question" selected>تسجيل بسؤال</option>
                            }
                            else
                            {
                                <option value="Photo" selected>تسجيل بصورة</option>
                                <option value="Question">تسجيل بسؤال</option>
                            }
                        </select>
                        <div class="required-error-text">هذا الحقل مطلوب</div>
                        <small class="text-muted d-block mt-1">لو اخترتي تسجيل بسؤال، الموظف هيظهر له سؤال إجباري عند أول Login بدل تصوير الحضور.</small>
                    </div>
                </div>
            </div>


            <div class="row mt-2">
                <div class="col-md-8">
                    <div class="form-group employee-attendance-options-card">
                        <div class="employee-attendance-options-title">عطلة أسبوعية</div>
                        <div class="weekly-off-days-grid">
                            <label class="weekly-off-day-option"><input type="checkbox" name="weeklyOffDays" value="Saturday" @(IsWeeklyOffSelected("Saturday") ? "checked" : "") /> السبت</label>
                            <label class="weekly-off-day-option"><input type="checkbox" name="weeklyOffDays" value="Sunday" @(IsWeeklyOffSelected("Sunday") ? "checked" : "") /> الأحد</label>
                            <label class="weekly-off-day-option"><input type="checkbox" name="weeklyOffDays" value="Monday" @(IsWeeklyOffSelected("Monday") ? "checked" : "") /> الاثنين</label>
                            <label class="weekly-off-day-option"><input type="checkbox" name="weeklyOffDays" value="Tuesday" @(IsWeeklyOffSelected("Tuesday") ? "checked" : "") /> الثلاثاء</label>
                            <label class="weekly-off-day-option"><input type="checkbox" name="weeklyOffDays" value="Wednesday" @(IsWeeklyOffSelected("Wednesday") ? "checked" : "") /> الأربعاء</label>
                            <label class="weekly-off-day-option"><input type="checkbox" name="weeklyOffDays" value="Thursday" @(IsWeeklyOffSelected("Thursday") ? "checked" : "") /> الخميس</label>
                            <label class="weekly-off-day-option"><input type="checkbox" name="weeklyOffDays" value="Friday" @(IsWeeklyOffSelected("Friday") ? "checked" : "") /> الجمعة</label>
                        </div>
                        <small class="text-muted d-block mt-2">الأيام المختارة هنا لا يتم إنشاء غياب تلقائي فيها لو الموظف لم يدخل.</small>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="form-group employee-attendance-options-card">
                        <label class="control-label" for="ApplyShiftAccess">بلوك</label>
                        <select id="ApplyShiftAccess" name="applyShiftAccess" class="form-control">
                            @if (applyShiftAccess)
                            {
                                <option value="true" selected>نعم - يطبق Access Shift</option>
                                <option value="false">لا - دخول وخروج في أي وقت</option>
                            }
                            else
                            {
                                <option value="true">نعم - يطبق Access Shift</option>
                                <option value="false" selected>لا - دخول وخروج في أي وقت</option>
                            }
                        </select>
                        <small class="text-muted d-block mt-2">لو اخترتي لا، الموظف مش هيتمنع من الدخول أو الخروج خارج وقت الدوام.</small>
                    </div>
                </div>
            </div>

            <div class="row mt-2">
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="control-label" for="ShiftStartTime">وقت بداية الدوام</label>
                        <input type="time" id="ShiftStartTime" name="shiftStartTime" class="form-control" required />
                        <span class="text-danger" data-valmsg-for="shiftStartTime"></span>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-group">
                        <label class="control-label" for="ShiftEndTime">وقت نهاية الدوام</label>
                        <input type="time" id="ShiftEndTime" name="shiftEndTime" class="form-control" required />
                        <span class="text-danger" data-valmsg-for="shiftEndTime"></span>
                    </div>
                </div>
            </div>

            <div class="row mt-2">
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="control-label" for="AllowedIpAddress">IP الشبكة - اختياري</label>
                        <input type="text"
                               id="AllowedIpAddress"
                               name="allowedIpAddress"
                               class="form-control"
                               placeholder="اختياري - مثال: 41.46.62.13" />
                        <small class="text-muted d-block mt-1">لو فاضي، أول Login للموظف هيحفظ IP الشبكة تلقائيًا.</small>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-group">
                        <label class="control-label" for="ShiftNotes">ملاحظات الدوام - اختياري</label>
                        <input type="text"
                               id="ShiftNotes"
                               name="shiftNotes"
                               class="form-control"
                               placeholder="ملاحظات اختيارية" />
                    </div>
                </div>
            </div>

            <div class="row mt-2">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="DisplayName" class="control-label"></label>
                        <input asp-for="DisplayName" class="form-control" required />
                        <span asp-validation-for="DisplayName" class="text-danger"></span>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-group">
                        <label class="control-label" for="SelectedManufacturingCompanyIds">صلاحيات المتاجر</label>
                        <select id="SelectedManufacturingCompanyIds"
                                name="SelectedManufacturingCompanyIds"
                                class="store-permission-select-native"
                                multiple="multiple"
                                data-placeholder="اختاري المتاجر التي يمكن للموظف رؤيتها">
                            @foreach (var store in stores)
                            {
                                var image = !string.IsNullOrWhiteSpace(store.ImageUrl)
                                ? "/" + store.ImageUrl.TrimStart('/')
                                : "/static/building-regular.svg";

                                <option value="@store.Id" data-image="@image">@store.Name</option>
                            }
                        </select>

                        <div class="store-permission-picker" id="StorePermissionPicker">
                            <button type="button" class="store-permission-trigger" id="StorePermissionTrigger">
                                <span class="store-permission-summary" id="StorePermissionSummary">اختاري المتاجر التي يمكن للموظف رؤيتها</span>
                                <span class="store-permission-arrow">⌄</span>
                            </button>

                            <div class="store-permission-menu" id="StorePermissionMenu">
                                <div class="store-permission-actions-row">
                                    <button type="button" class="store-action-btn store-action-select-all">تحديد الكل</button>
                                    <button type="button" class="store-action-btn store-action-clear-all">إلغاء التحديد</button>
                                </div>

                                <div class="store-permission-options">
                                    @foreach (var store in stores)
                                    {
                                        var image = !string.IsNullOrWhiteSpace(store.ImageUrl)
                                        ? "/" + store.ImageUrl.TrimStart('/')
                                        : "/static/building-regular.svg";

                                        <label class="store-permission-option">
                                            <input type="checkbox" class="store-permission-checkbox" value="@store.Id" />
                                            <span class="store-check-circle"></span>
                                            <img src="@image" class="store-option-image" onerror="this.remove();" />
                                            <span class="store-option-name">@store.Name</span>
                                        </label>
                                    }
                                </div>
                            </div>
                        </div>
                        <small class="text-muted d-block mt-1">يمكن اختيار أكثر من متجر مثل FLARE أو أي متجر آخر.</small>
                    </div>
                </div>
            </div>

            <div class="form-group mt-3">
                <input type="submit" value="موافقة" class="btn btn-submit-employee" />
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        (function () {
            var excludedRoles = ['Admin', 'DeliveryCompany', 'DeliveryRepresentative', 'OrderPreparer'];
            var form = document.getElementById('employeeCreateForm');
            var page = document.querySelector('.employee-create-page');
            var roleSelect = document.getElementById('Role');
            var checkInWrapper = document.getElementById('CheckInVerificationMethodWrapper');
            var checkInSelect = document.getElementById('CheckInVerificationMethod');
            var alertBox = document.getElementById('employeeCreateErrorAlert');

            function isExcludedRole(role) {
                role = (role || '').trim().toLowerCase();
                return excludedRoles.some(function (item) {
                    return item.toLowerCase() === role;
                });
            }

            function applyCheckInMethodVisibility() {
                if (!roleSelect || !checkInSelect) return;

                if (isExcludedRole(roleSelect.value)) {
                    checkInSelect.value = 'Photo';
                    checkInSelect.removeAttribute('required');
                    checkInSelect.classList.remove('employee-required-error', 'is-required-missing');

                    if (checkInWrapper && checkInWrapper.style) {
                        checkInWrapper.style.display = 'none';
                    }
                } else {
                    checkInSelect.setAttribute('required', 'required');

                    if (checkInWrapper && checkInWrapper.style) {
                        checkInWrapper.style.display = '';
                    }
                }
            }

            function addRequiredStarsAndMessages() {
                if (!form) return;

                form.querySelectorAll('[required]').forEach(function (field) {
                    var group = field.closest('.form-group');
                    if (!group) return;

                    if (!group.querySelector('.required-error-text')) {
                        var message = document.createElement('div');
                        message.className = 'required-error-text';
                        message.textContent = 'هذا الحقل مطلوب';
                        group.appendChild(message);
                    }
                });
            }

            function isFieldVisible(field) {
                if (!field) return false;
                if (field.type === 'hidden') return false;
                var wrapper = field.closest('[style*="display: none"], [style*="display:none"]');
                if (wrapper) return false;
                return true;
            }

            function markRequiredFields() {
                if (!form) return true;

                applyCheckInMethodVisibility();

                var ok = true;
                form.querySelectorAll('[required]').forEach(function (field) {
                    var group = field.closest('.form-group');
                    var value = (field.value || '').toString().trim();
                    var missing = isFieldVisible(field) && value.length === 0;

                    if (missing) {
                        ok = false;
                        field.classList.add('employee-required-error', 'is-required-missing');
                        if (group) group.classList.add('has-required-error');
                    } else {
                        field.classList.remove('employee-required-error', 'is-required-missing');
                        if (group) group.classList.remove('has-required-error');
                    }
                });

                if (alertBox) {
                    alertBox.style.display = ok ? 'none' : 'block';
                }

                return ok;
            }

            addRequiredStarsAndMessages();
            applyCheckInMethodVisibility();

            if (roleSelect) {
                roleSelect.addEventListener('change', function () {
                    applyCheckInMethodVisibility();
                    if (page && page.classList.contains('was-validated')) {
                        markRequiredFields();
                    }
                });
            }

            if (form) {
                form.addEventListener('submit', function (event) {
                    if (page) page.classList.add('was-validated');

                    if (!markRequiredFields()) {
                        event.preventDefault();
                        event.stopPropagation();
                        var firstInvalid = form.querySelector('.employee-required-error, .is-required-missing, .input-validation-error');
                        if (firstInvalid && firstInvalid.scrollIntoView) {
                            firstInvalid.scrollIntoView({ behavior: 'smooth', block: 'center' });
                            setTimeout(function () { try { firstInvalid.focus(); } catch (e) { } }, 250);
                        }
                    }
                });

                form.querySelectorAll('[required]').forEach(function (field) {
                    ['input', 'change', 'blur'].forEach(function (eventName) {
                        field.addEventListener(eventName, function () {
                            if (page && page.classList.contains('was-validated')) {
                                markRequiredFields();
                            }
                        });
                    });
                });
            }
        })();
    </script>

    <script>
        $(function () {
            var $storeSelect = $('#SelectedManufacturingCompanyIds');

            function initCustomStorePermissionPicker() {
                var $picker = $('#StorePermissionPicker');
                var $trigger = $('#StorePermissionTrigger');
                var $summary = $('#StorePermissionSummary');
                var $menu = $('#StorePermissionMenu');
                var $checkboxes = $picker.find('.store-permission-checkbox');

                if (!$picker.length || !$trigger.length || !$summary.length || !$storeSelect.length) {
                    return;
                }

                function syncSelectFromCheckboxes() {
                    var values = $checkboxes.filter(':checked').map(function () {
                        return this.value;
                    }).get();

                    $storeSelect.find('option').each(function () {
                        this.selected = values.indexOf(this.value) !== -1;
                    });

                    $storeSelect.trigger('change');
                    updateSummaryFromCheckboxes();
                }

                function updateSummaryFromCheckboxes() {
                    var checked = $checkboxes.filter(':checked');
                    $summary.empty().removeClass('has-values');

                    if (!checked.length) {
                        $summary.append('<span class="store-permission-summary-text">اختاري المتاجر التي يمكن للموظف رؤيتها</span>');
                        return;
                    }

                    $summary.addClass('has-values');

                    checked.slice(0, 3).each(function () {
                        var imageUrl = $(this).closest('.store-permission-option').find('.store-option-image').attr('src');
                        if (imageUrl) {
                            $summary.append('<img src="' + imageUrl + '" alt="" onerror="this.remove();" />');
                        }
                    });

                    var text = checked.length === 1
                        ? checked.first().closest('.store-permission-option').find('.store-option-name').text()
                        : 'تم اختيار ' + checked.length + ' متجر';

                    $summary.append('<span class="store-permission-summary-text">' + text + '</span>');
                }

                $trigger.on('click', function (e) {
                    e.preventDefault();
                    e.stopPropagation();
                    $picker.toggleClass('open');
                });

                $menu.on('click', function (e) {
                    e.stopPropagation();
                });

                $checkboxes.on('change', syncSelectFromCheckboxes);

                $picker.find('.store-action-select-all').on('click', function (e) {
                    e.preventDefault();
                    $checkboxes.prop('checked', true);
                    syncSelectFromCheckboxes();
                });

                $picker.find('.store-action-clear-all').on('click', function (e) {
                    e.preventDefault();
                    $checkboxes.prop('checked', false);
                    syncSelectFromCheckboxes();
                });

                $(document).on('click', function () {
                    $picker.removeClass('open');
                });

                syncSelectFromCheckboxes();
            }

            function getPreviewByInputId(inputId) {
                return $('#' + inputId.replace('File', 'Preview'));
            }

            function getPlaceholderByInputId(inputId) {
                return $('[data-placeholder-for="' + inputId + '"]');
            }

            function defaultPlaceholder(inputId) {
                return inputId === 'IdCardFrontFile'
                    ? 'اضف صورة البطاقة وش أو اضغطي Ctrl+V'
                    : 'اضف صورة البطاقة ظهر أو اضغطي Ctrl+V';
            }

            function setImageFile(input, file) {
                if (!input || !file || !file.type || file.type.indexOf('image/') !== 0) {
                    return;
                }

                try {
                    var dataTransfer = new DataTransfer();
                    dataTransfer.items.add(file);
                    input.files = dataTransfer.files;
                } catch (e) {
                    alert('المتصفح لا يدعم لصق الصورة مباشرة هنا، اختاري الصورة كملف.');
                    return;
                }

                var label = getPlaceholderByInputId(input.id);
                var preview = getPreviewByInputId(input.id);

                label.text(file.name || 'تم لصق الصورة');

                var reader = new FileReader();
                reader.onload = function (event) {
                    preview.attr('src', event.target.result).show();
                };
                reader.readAsDataURL(file);
            }

            $('.employee-file-browse-btn').on('click', function (e) {
                e.preventDefault();
                e.stopPropagation();

                var inputId = $(this).data('browse-input');
                var input = document.getElementById(inputId);
                if (input) input.click();
            });

            $('.employee-paste-zone').on('click focus', function () {
                $(this).focus();
            });

            $('.employee-paste-zone').on('paste', function (event) {
                event.preventDefault();

                var originalEvent = event.originalEvent || event;
                var clipboardData = originalEvent.clipboardData || window.clipboardData;
                if (!clipboardData || !clipboardData.items) return;

                var imageFile = null;
                for (var i = 0; i < clipboardData.items.length; i++) {
                    var item = clipboardData.items[i];
                    if (item.type && item.type.indexOf('image/') === 0) {
                        imageFile = item.getAsFile();
                        break;
                    }
                }

                if (!imageFile) return;

                var inputId = $(this).data('input-id');
                var input = document.getElementById(inputId);
                setImageFile(input, imageFile);
            });

            $('.employee-id-card-input').on('change', function () {
                var input = this;
                var file = input.files && input.files.length ? input.files[0] : null;
                var label = getPlaceholderByInputId(input.id);
                var preview = getPreviewByInputId(input.id);

                if (!file) {
                    label.text(defaultPlaceholder(input.id));
                    preview.hide().attr('src', '');
                    return;
                }

                setImageFile(input, file);
            });

            $('input[name="imgFile"]').on('change', function () {
                var file = this.files && this.files.length ? this.files[0] : null;
                var img = document.getElementById('logoImage');
                if (!file || !img) return;

                var reader = new FileReader();
                reader.onload = function (event) {
                    img.src = event.target.result;
                    img.style.display = 'block';
                };
                reader.readAsDataURL(file);
            });

            initCustomStorePermissionPicker();
        });
    </script>
}
