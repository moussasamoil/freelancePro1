@model lotus_blue.Models.ViewModel.EmployeeViewModel
@using lotus_blue.Models
@using System
@using System.Linq

@{
    ViewData["Title"] = "إنشاء موظف جديد";

    var stores = ViewBag.ManufacturingCompanies as List<ManufacturingCompany>
        ?? new List<ManufacturingCompany>();

    string selectedEmployeeCountry = Convert.ToString(ViewBag.EmployeeCountry) ?? "";

    bool IsCountrySelected(string country)
    {
        return string.Equals(selectedEmployeeCountry, country, StringComparison.OrdinalIgnoreCase);
    }

    string weeklyOffDaysText = Convert.ToString(ViewBag.WeeklyOffDays) ?? "";
    var selectedWeeklyOffDays = weeklyOffDaysText
        .Split(',', StringSplitOptions.RemoveEmptyEntries)
        .Select(day => day.Trim())
        .Where(day => !string.IsNullOrWhiteSpace(day))
        .ToHashSet(StringComparer.OrdinalIgnoreCase);

    bool IsWeeklyOffSelected(string day)
    {
        return selectedWeeklyOffDays.Contains(day);
    }

    object applyShiftAccessObject = ViewBag.ApplyShiftAccess;
    bool applyShiftAccess = true;

    if (applyShiftAccessObject is bool applyShiftAccessValue)
    {
        applyShiftAccess = applyShiftAccessValue;
    }
    else if (bool.TryParse(Convert.ToString(applyShiftAccessObject), out var parsedApplyShiftAccess))
    {
        applyShiftAccess = parsedApplyShiftAccess;
    }
}

<style>
    .employee-create-page {
        direction: rtl;
        padding: 18px 22px;
    }

    .employee-create-title {
        background: #F5F5F5;
        color: #f28e02;
        border-radius: 14px;
        padding: 14px 18px;
        font-size: 21px;
        font-weight: 900;
        margin-bottom: 16px;
        border-bottom: 1px solid #94a3b8;
    }

    .employee-create-card {
        background: #ffffff;
        border: 1px solid #e9eaec;
        box-shadow: 0 6px 18px rgba(15, 23, 42, 0.06);
        border-radius: 18px;
        padding: 18px;
    }

    .form-group label,
    .control-label {
        font-weight: 800;
        color: #334155;
        margin-bottom: 7px;
    }

    .form-control,
    .employee-file-trigger,
    .select2-container--default .select2-selection--multiple {
        min-height: 44px !important;
        border-radius: 8px !important;
        border: 0 !important;
        background-color: #ffffff !important;
        box-shadow: 0px 0px 4px rgba(0, 0, 0, 0.2) !important;
        color: #111827 !important;
        font-size: 15px !important;
        font-weight: 700 !important;
        outline: none !important;
    }

    .employee-file-trigger {
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        padding: 9px 14px;
        cursor: pointer;
        text-decoration: none;
    }

    .employee-file-placeholder {
        color: #64748b;
        font-weight: 800;
    }

    .employee-file-icon {
