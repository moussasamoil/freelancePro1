@using lotus_blue.Models.ViewModel
@using System.Collections.Generic
@model PaginationViewModel<EmployeeViewModel>

@{
    ViewData["Title"] = " الموظفين"; // Set the title in Arabic

    var mobileAccessMap = ViewBag.EmployeeMobileOrTabletAccessMap as Dictionary<int, bool>
        ?? new Dictionary<int, bool>();
}


<div class="row mb-3">

    <div class="col-lg-6">
        <select id="EmployeeId" class="form-control drop-down-design">
        </select>
    </div>

    <!-- Second column -->
    <div class="col-lg-6 d-flex align-items-center justify-content-end">
        <div class="form-group d-flex align-items-center">
            <label for="pageSize" class="me-2">أظهر:</label>
            <select id="pageSize" name="pageSize" class="form-control me-2">
                <option value="10">10</option>
                <option value="25">25</option>
                <option value="50">50</option>
                <option value="100">100</option>
            </select>
            <label for="pageSize">مدخلات</label>
        </div>
    </div>


</div>


<table id="table" class="table">
    <thead>
        <tr>
            <th>#</th>
            <th>اسم الموظف</th>
            <th>المسمى الوظيفي</th>
            <th>الجنسية</th>
            <th>رقم الهاتف</th>
            <th>الإجراءات</th>
            <th>الفعالية</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var employee in Model.Items)
        {
            var allowMobileOrTabletLogin = mobileAccessMap.ContainsKey(employee.Id) && mobileAccessMap[employee.Id];

            <tr>
                <td>@employee.Id</td>
                <td>@employee.Name</td>
                <td>@employee.JobTitle</td>
                <td>@employee.Nationality</td>
                <td>@employee.PhoneNumber</td>
                <td>
                    <div class="d-inline-flex">

                        <a href="@Url.Action("Details", new { id = employee.Id })" class="btn btn-outline-success btn-sm">التفاصيل</a>

                        <a href="@Url.Action("Edit", new { id = employee.Id })" class="btn me-4 btn-yellow-v3 btn-sm">تعديل</a>

                    </div>
                </td>


                <td>
                    <div class="form-check form-switch">
                        <input class="form-check-input shown-checkbox" type="checkbox" id="IsShown-@employee.Id" data-employee-id="@employee.Id" @(employee.IsShown ? "checked" : "")>
                        <label class="form-check-label" for="IsShown-@employee.Id">  الظهور</label>
                    </div>
                    <div class="form-check form-switch">
                        <input class="form-check-input active-checkbox" type="checkbox" id="IsActive-@employee.Id" data-employee-id="@employee.Id" @(employee.IsActive ? "checked" : "")>
                        <label class="form-check-label" for="IsActive-@employee.Id"> مفعل</label>
                    </div>
                    <div class="form-check form-switch">
                        <input class="form-check-input mobile-tablet-checkbox" type="checkbox" id="AllowMobileOrTabletLogin-@employee.Id" data-employee-id="@employee.Id" @(allowMobileOrTabletLogin ? "checked" : "")>
                        <label class="form-check-label" for="AllowMobileOrTabletLogin-@employee.Id">موبايل / آيباد</label>
                    </div>
                </td>

            </tr>
        }
    </tbody>
</table>
<!-- Display pagination controls -->
<div id="pagination-link" class="mt-0 container-fluid">
    <div class="d-flex justify-content-between align-items-center">

        <p class="text-start pt-2 total-items-display">@Model.TotalItems عدد الموظفين</p>

        <nav aria-label="Page navigation" class="mx-auto">
            <div class="d-flex justify-content-start">
                <ul class="pagination p-0">
                    <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link pointer" data-page="1">
                            <i class="fa-solid fa-chevron-double-right text-green"></i>
                        </a>
                    </li>
                    <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link" data-page="@(Model.CurrentPage - 1)">
                            <i class="fa-solid fa-chevron-right text-green"></i>
                        </a>
                    </li>

                    @{
                        int startPage = Model.CurrentPage;
                        int endPage = startPage + 2;
                        if (endPage > Model.TotalPages)
                        {
                            endPage = Model.TotalPages;
                        }
                    }

                    @for (int i = startPage; i <= endPage; i++)
                    {
                        <li class="numbers page-item @(Model.CurrentPage == i ? "active" : "")">
                            <a class="page-link" data-page="@i">@i</a>
                        </li>
                    }

                    @if (Model.TotalPages > endPage)
                    {
                        <li class="page-item disabled">
                            <span class="page-link">...</span>
                        </li>

                        @for (int i = Model.TotalPages - 2; i <= Model.TotalPages; i++)
                        {
                            <li class="numbers page-item @(Model.CurrentPage == i ? "active" : "")">
                                <a class="page-link" data-page="@i">@i</a>
                            </li>
                        }
                    }



                    <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" data-page="@(Model.CurrentPage + 1)">
                            <i class="fa-solid fa-chevron-left text-green f-s-18"></i>
                        </a>
                    </li>
                    <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" data-page="@(Model.TotalPages)">
                            <i class="fa-solid fa-chevron-double-left text-green"></i>
                        </a>
                    </li>


                </ul>
            </div>
        </nav>


    </div>
</div>

<script>


    $(document).ready(function () {
        // Function to load employee data based on filters and pagination
        function loadPage(page) {
            const pageSize = $('#pageSize').val();
            const employeeId = $('#EmployeeId').val();

            $.ajax({
                url: '/employee',
                type: 'GET',
                data: {
                    employeeId: employeeId,
                    pageSize: pageSize,
                    page: page
                },
                success: function (response) {
                    $('#table').html($(response).find('#table').html());
                    $('.pagination').html($(response).find('.pagination').html());
                },
                error: function (error) {
                    console.log(error);
                }
            });
        }

        // Bind change event to EmployeeId and pageSize select elements
        $('#EmployeeId, #pageSize').change(function () {
            loadPage(1); // Load first page when filter changes
        });

        // Bind click event to pagination links
        $(document).on('click', '.pagination a.page-link', function (event) {
            event.preventDefault();
            const page = $(this).data('page');
            loadPage(page);
        });

        var globalEmployeeId; // Declare the global variable

        $(document).on('change', '.active-checkbox, .shown-checkbox, .mobile-tablet-checkbox', function () {
            globalEmployeeId = $(this).data('employee-id');
            var isChecked = $(this).is(':checked');

            if ($(this).hasClass('active-checkbox')) {
                $.post('/Employee/SetIsActive', { Id: globalEmployeeId, isActive: isChecked })
                    .done(function (response) {
                        if (response.success) {
                            console.log("Active status updated successfully.");
                        } else {
                            console.error("Error updating active status:", response.message);
                        }
                    })
                    .fail(function (xhr, status, error) {
                        console.error("Request failed:", status, error);
                    });
            } else if ($(this).hasClass('shown-checkbox')) {
                $.post('/Employee/SetIsShown', { Id: globalEmployeeId, isShown: isChecked })
                    .done(function (response) {
                        if (response.success) {
                            console.log("Shown status updated successfully.");
                        } else {
                            console.error("Error updating shown status:", response.message);
                        }
                    })
                    .fail(function (xhr, status, error) {
                        console.error("Request failed:", status, error);
                    });
            } else if ($(this).hasClass('mobile-tablet-checkbox')) {
                $.post('/Employee/SetAllowMobileOrTabletLogin', { Id: globalEmployeeId, isAllowed: isChecked })
                    .done(function (response) {
                        if (response.success) {
                            console.log("Mobile/tablet access updated successfully.");
                        } else {
                            console.error("Error updating mobile/tablet access:", response.message);
                        }
                    })
                    .fail(function (xhr, status, error) {
                        console.error("Request failed:", status, error);
                    });
            }
        });
    });


</script>
