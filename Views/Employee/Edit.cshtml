@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        $(function () {
            var $storeSelect = $('#SelectedManufacturingCompanyIds');

            function formatStoreOption(option) {
                if (!option.id) {
                    return option.text;
                }

                var imageUrl = $(option.element).data('image');
                var imageTag = imageUrl
                    ? '<img src="' + imageUrl + '" class="select2-option-image" onerror="this.remove();" />'
                    : '';

                return $('<span>' + imageTag + option.text + '</span>');
            }

            function updateStoreSummary() {
                var $container = $storeSelect.next('.select2-container');
                var $rendered = $container.find('.select2-selection__rendered');

                if (!$rendered.length) {
                    return;
                }

                var selectedOptions = $storeSelect.find('option:selected').filter(function () {
                    return !!this.value;
                });

                $rendered.find('.store-select-summary').remove();

                var $summary = $('<span class="store-select-summary"></span>');

                if (!selectedOptions.length) {
                    $summary.append('<span class="summary-text">اختاري المتاجر التي يمكن للموظف رؤيتها</span>');
                } else {
                    $summary.addClass('has-values');

                    selectedOptions.slice(0, 3).each(function () {
                        var imageUrl = $(this).data('image');
                        if (imageUrl) {
                            $summary.append('<img src="' + imageUrl + '" alt="" onerror="this.remove();" />');
                        }
                    });

                    var text = selectedOptions.length === 1
                        ? selectedOptions.first().text()
                        : 'تم اختيار ' + selectedOptions.length + ' متجر';

                    $summary.append('<span class="summary-text">' + text + '</span>');
                }

                $rendered.prepend($summary);
            }

            function addStoreDropdownControls() {
                var $dropdown = $('.select2-container--open .select2-dropdown');

                if (!$dropdown.length || $dropdown.find('.store-select2-controls').length) {
                    return;
                }

                var $controls = $(
                    '<div class="store-select2-controls">' +
                    '<button type="button" class="store-select2-control-btn store-select2-select-all">تحديد الكل</button>' +
                    '<button type="button" class="store-select2-control-btn store-select2-clear-all">إلغاء التحديد</button>' +
                    '</div>'
                );

                $dropdown.prepend($controls);
            }

            if (false && $.fn.select2) {
                if ($storeSelect.data('select2')) {
                    $storeSelect.select2('destroy');
                }

                $storeSelect.select2({
                    templateResult: formatStoreOption,
                    templateSelection: function () { return ''; },
                    dir: 'rtl',
                    width: '100%',
                    closeOnSelect: false,
                    placeholder: ''
                });

                updateStoreSummary();

                $storeSelect.on('change select2:select select2:unselect', function () {
                    setTimeout(updateStoreSummary, 0);
                });

                $storeSelect.on('select2:open', function () {
                    setTimeout(addStoreDropdownControls, 0);
                });

                $(document).on('click', '.store-select2-select-all', function (e) {
                    e.preventDefault();
                    e.stopPropagation();

                    var allValues = $storeSelect.find('option').map(function () {
                        return this.value;
                    }).get().filter(Boolean);

                    $storeSelect.val(allValues).trigger('change');
                    setTimeout(addStoreDropdownControls, 0);
                });

                $(document).on('click', '.store-select2-clear-all', function (e) {
                    e.preventDefault();
                    e.stopPropagation();

                    $storeSelect.val(null).trigger('change');
                    setTimeout(addStoreDropdownControls, 0);
                });
            }


            function initCustomStorePermissionPicker() {
                var $picker = $('#StorePermissionPicker');
                var $trigger = $('#StorePermissionTrigger');
                var $summary = $('#StorePermissionSummary');
                var $menu = $('#StorePermissionMenu');
                var $checkboxes = $picker.find('.store-permission-checkbox');

                function syncSelectFromCheckboxes() {
                    var values = $checkboxes.filter(':checked').map(function () {
                        return this.value;
                    }).get();

                    $storeSelect.find('option').each(function () {
                        this.selected = values.indexOf(this.value) !== -1;
                    });

                    $storeSelect.trigger('change');
                    updateSummaryFromCheckboxes();
                }

                function updateSummaryFromCheckboxes() {
                    var checked = $checkboxes.filter(':checked');
                    $summary.empty().removeClass('has-values');

                    if (!checked.length) {
                        $summary.append('<span class="store-permission-summary-text">اختاري المتاجر التي يمكن للموظف رؤيتها</span>');
                        return;
                    }

                    $summary.addClass('has-values');

                    checked.slice(0, 3).each(function () {
                        var imageUrl = $(this).closest('.store-permission-option').find('.store-option-image').attr('src');
                        if (imageUrl) {
                            $summary.append('<img src="' + imageUrl + '" alt="" onerror="this.remove();" />');
                        }
                    });

                    var text = checked.length === 1
                        ? checked.first().closest('.store-permission-option').find('.store-option-name').text()
                        : 'تم اختيار ' + checked.length + ' متجر';

                    $summary.append('<span class="store-permission-summary-text">' + text + '</span>');
                }

                $trigger.on('click', function (e) {
                    e.preventDefault();
                    e.stopPropagation();
                    $picker.toggleClass('open');
                });

                $menu.on('click', function (e) {
                    e.stopPropagation();
                });

                $checkboxes.on('change', syncSelectFromCheckboxes);

                $picker.find('.store-action-select-all').on('click', function (e) {
                    e.preventDefault();
                    $checkboxes.prop('checked', true);
                    syncSelectFromCheckboxes();
                });

                $picker.find('.store-action-clear-all').on('click', function (e) {
                    e.preventDefault();
                    $checkboxes.prop('checked', false);
                    syncSelectFromCheckboxes();
                });

                $(document).on('click', function () {
                    $picker.removeClass('open');
                });

                updateSummaryFromCheckboxes();
            }

            initCustomStorePermissionPicker();



            function syncCheckInVerificationMethodByRole() {
                var roleSelect = document.getElementById('Role');
                var wrapper = document.getElementById('CheckInVerificationMethodRow');
                var methodSelect = document.getElementById('CheckInVerificationMethod');

                if (!roleSelect || !wrapper || !methodSelect) {
                    return;
                }

                var role = (roleSelect.value || '').trim();
                var shouldHide = role === 'Admin'
                    || role === 'DeliveryCompany'
                    || role === 'DeliveryRepresentative'
                    || role === 'OrderPreparer';

                if (shouldHide) {
                    wrapper.style.display = 'none';
                    methodSelect.value = 'Photo';
                } else {
                    wrapper.style.display = '';
                }
            }

            $('#Role').on('change', syncCheckInVerificationMethodByRole);
            syncCheckInVerificationMethodByRole();

            function getPreviewByInputId(inputId) {
                return $('#' + inputId.replace('File', 'Preview'));
            }

            function getPlaceholderByInputId(inputId) {
                return $('[data-placeholder-for="' + inputId + '"]');
            }

            function defaultPlaceholder(inputId) {
                return inputId === 'IdCardFrontFile'
                    ? 'اضف صورة البطاقة وش أو اضغطي Ctrl+V'
                    : 'اضف صورة البطاقة ظهر أو اضغطي Ctrl+V';
            }

            function setImageFile(input, file) {
                if (!input || !file) {
                    return;
                }

                if (!file.type || file.type.indexOf('image/') !== 0) {
                    return;
                }

                try {
                    var dataTransfer = new DataTransfer();
                    dataTransfer.items.add(file);
                    input.files = dataTransfer.files;
                } catch (e) {
                    alert('المتصفح لا يدعم لصق الصورة مباشرة هنا، اختاري الصورة كملف.');
                    return;
                }

                var label = getPlaceholderByInputId(input.id);
                var preview = getPreviewByInputId(input.id);

                label.text(file.name || 'تم لصق الصورة');

                var reader = new FileReader();
                reader.onload = function (event) {
                    preview.attr('src', event.target.result).show();
                };
                reader.readAsDataURL(file);
            }

            $('.employee-file-browse-btn').on('click', function (e) {
                e.preventDefault();
                e.stopPropagation();

                var inputId = $(this).data('browse-input');
                $('#' + inputId).trigger('click');
            });

            $('.employee-paste-zone').on('click focus', function () {
                $(this).focus();
            });

            $('.employee-paste-zone').on('paste', function (event) {
                event.preventDefault();

                var originalEvent = event.originalEvent || event;
                var clipboardData = originalEvent.clipboardData || window.clipboardData;

                if (!clipboardData || !clipboardData.items) {
                    return;
                }

                var imageFile = null;

                for (var i = 0; i < clipboardData.items.length; i++) {
                    var item = clipboardData.items[i];

                    if (item.type && item.type.indexOf('image/') === 0) {
                        imageFile = item.getAsFile();
                        break;
                    }
                }

                if (!imageFile) {
                    return;
                }

                var inputId = $(this).data('input-id');
                var input = document.getElementById(inputId);

                setImageFile(input, imageFile);
            });

            $('.employee-id-card-input').on('change', function () {
                var input = this;
                var file = input.files && input.files.length ? input.files[0] : null;
                var label = getPlaceholderByInputId(input.id);
                var preview = getPreviewByInputId(input.id);

                if (!file) {
                    label.text(defaultPlaceholder(input.id));
                    preview.hide().attr('src', '');
                    return;
                }

                setImageFile(input, file);
            });
        });
    </script>
}
