@model lotus_blue.Models.ViewModel.EmployeeViewModel
@using lotus_blue.Models
@using System
@using System.Linq

@{
    ViewData["Title"] = "تعديل الموظف";

    var stores = ViewBag.ManufacturingCompanies as List<ManufacturingCompany>
        ?? new List<ManufacturingCompany>();

    var selectedStoreIds = Model.SelectedManufacturingCompanyIds ?? new List<int>();

    var employeeImage = !string.IsNullOrWhiteSpace(Model.Img)
        ? "/" + Model.Img.TrimStart('/')
        : "";

    var idCardFrontImage = !string.IsNullOrWhiteSpace(Model.IdCardFrontImage)
        ? "/" + Model.IdCardFrontImage.TrimStart('/')
        : "";

    var idCardBackImage = !string.IsNullOrWhiteSpace(Model.IdCardBackImage)
        ? "/" + Model.IdCardBackImage.TrimStart('/')
        : "";

    var successMessage = TempData["SuccessMessage"]?.ToString();

    string selectedEmployeeCountry = Convert.ToString(ViewBag.EmployeeCountry) ?? "";

    bool IsCountrySelected(string country)
    {
        return string.Equals(selectedEmployeeCountry, country, StringComparison.OrdinalIgnoreCase);
    }

    string weeklyOffDaysText = Convert.ToString(ViewBag.WeeklyOffDays) ?? "";
    var selectedWeeklyOffDays = weeklyOffDaysText
        .Split(',', StringSplitOptions.RemoveEmptyEntries)
        .Select(day => day.Trim())
        .Where(day => !string.IsNullOrWhiteSpace(day))
        .ToHashSet(StringComparer.OrdinalIgnoreCase);

    bool IsWeeklyOffSelected(string day)
    {
        return selectedWeeklyOffDays.Contains(day);
    }

    object applyShiftAccessObject = ViewBag.ApplyShiftAccess;
    bool applyShiftAccess = true;

    if (applyShiftAccessObject is bool applyShiftAccessValue)
    {
        applyShiftAccess = applyShiftAccessValue;
    }
    else if (bool.TryParse(Convert.ToString(applyShiftAccessObject), out var parsedApplyShiftAccess))
    {
        applyShiftAccess = parsedApplyShiftAccess;
    }
}

<style>
    .employee-create-page {
        direction: rtl;
        padding: 18px 22px;
    }

    .employee-create-title {
        background: #F5F5F5;
        color: #f28e02;
        border-radius: 14px;
        padding: 14px 18px;
        font-size: 21px;
        font-weight: 900;
        margin-bottom: 16px;
        border-bottom: 1px solid #94a3b8;
    }

    .employee-create-card {
        background: #ffffff;
        border: 1px solid #e9eaec;
        box-shadow: 0 6px 18px rgba(15, 23, 42, 0.06);
        border-radius: 18px;
        padding: 18px;
    }

    .form-group label,
    .control-label {
        font-weight: 800;
        color: #334155;
        margin-bottom: 7px;
    }

    .form-control,
    .employee-file-trigger,
    .select2-container--default .select2-selection--multiple {
        min-height: 44px !important;
        border-radius: 8px !important;
        border: 0 !important;
        background-color: #ffffff !important;
        box-shadow: 0px 0px 4px rgba(0, 0, 0, 0.2) !important;
        color: #111827 !important;
        font-size: 15px !important;
        font-weight: 700 !important;
        outline: none !important;
    }

    .employee-file-trigger {
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        padding: 9px 14px;
        cursor: pointer;
        text-decoration: none;
    }

    .employee-file-placeholder {
        color: #64748b;
        font-weight: 800;
    }

    .employee-file-icon {
        color: #1d273b;
        font-size: 18px;
    }

    .employee-file-input {
        display: none;
    }

    .employee-file-preview {
        margin-top: 8px;
        max-width: 135px;
        max-height: 95px;
        border-radius: 10px;
        border: 1px solid #e5e7eb;
        object-fit: cover;
        display: none;
    }

    .store-permission-select + .select2-container {
        width: 100% !important;
    }

    .select2-container--default .select2-selection--multiple {
        padding: 5px 8px !important;
        display: flex !important;
        align-items: center !important;
        min-height: 44px !important;
    }

        .select2-container--default .select2-selection--multiple .select2-selection__choice {
            background: #d6dbe6 !important;
            border: 1px solid #939fb7 !important;
            border-radius: 999px !important;
            color: #1c273c !important;
            font-weight: 800 !important;
            padding: 3px 9px !important;
            margin-top: 4px !important;
        }

    .select2-dropdown {
        border: 1px solid #111827 !important;
        border-radius: 12px !important;
        overflow: hidden !important;
        direction: rtl !important;
    }

    .select2-results__option {
        border-bottom: 1px solid #111827 !important;
        font-weight: 900 !important;
        padding: 10px 12px !important;
    }

        .select2-results__option:last-child {
            border-bottom: 0 !important;
        }

    .select2-option-image {
        width: 24px;
        height: 24px;
        border-radius: 50%;
        object-fit: cover;
        margin-left: 8px;
        border: 1px solid #dbe3ea;
        vertical-align: middle;
    }


    .employee-paste-zone {
        position: relative;
        min-height: 46px !important;
        white-space: nowrap;
        overflow: hidden;
    }

        .employee-paste-zone:focus {
            box-shadow: 0 0 0 2px rgba(24, 160, 136, 0.18), 0px 0px 4px rgba(0, 0, 0, 0.2) !important;
        }

    .employee-file-browse-btn {
        border: 0;
        border-radius: 999px;
        background: rgba(24, 160, 136, 0.12);
        color: #1d273b;
        font-size: 12px;
        font-weight: 900;
        padding: 4px 10px;
        flex: 0 0 auto;
        cursor: pointer;
    }

    .store-permission-select.select2-hidden-accessible {
        display: none !important;
        visibility: hidden !important;
        position: absolute !important;
        width: 1px !important;
        height: 1px !important;
        opacity: 0 !important;
    }

    .store-permission-select + .select2-container {
        width: 100% !important;
        display: block !important;
    }

        .store-permission-select + .select2-container .select2-selection--multiple {
            min-height: 44px !important;
            height: 44px !important;
            border-radius: 8px !important;
            border: 0 !important;
            background-color: #ffffff !important;
            box-shadow: 0px 0px 4px rgba(0, 0, 0, 0.2) !important;
            display: flex !important;
            align-items: center !important;
            padding: 0 14px !important;
            overflow: hidden !important;
            cursor: pointer !important;
        }

        .store-permission-select + .select2-container .select2-selection__rendered {
            width: 100% !important;
            height: 100% !important;
            padding: 0 !important;
            margin: 0 !important;
            display: flex !important;
            align-items: center !important;
            overflow: hidden !important;
        }

        .store-permission-select + .select2-container .select2-selection__choice,
        .store-permission-select + .select2-container .select2-search,
        .store-permission-select + .select2-container .select2-search--inline,
        .store-permission-select + .select2-container .select2-search__field {
            display: none !important;
            width: 0 !important;
            height: 0 !important;
            opacity: 0 !important;
            margin: 0 !important;
            padding: 0 !important;
        }

    .store-select-summary {
        width: 100%;
        display: flex;
        align-items: center;
        gap: 7px;
        color: #64748b;
        font-size: 15px;
        font-weight: 800;
        overflow: hidden;
        white-space: nowrap;
        text-overflow: ellipsis;
        pointer-events: none;
    }

        .store-select-summary.has-values {
            color: #111827;
            font-weight: 900;
        }

        .store-select-summary img {
            width: 22px;
            height: 22px;
            min-width: 22px;
            border-radius: 50%;
            object-fit: cover;
            border: 1px solid #dbe3ea;
        }

        .store-select-summary .summary-text {
            overflow: hidden;
            white-space: nowrap;
            text-overflow: ellipsis;
        }

    .store-permission-select + .select2-container .select2-selection--multiple::after {
        content: "⌄";
        color: #1d273b;
        font-size: 18px;
        font-weight: 900;
        margin-right: auto;
        line-height: 1;
    }

    .store-select2-controls {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 8px;
        background: #f8fafc;
        border-bottom: 1px solid #111827;
        direction: rtl;
    }

    .store-select2-control-btn {
        flex: 1;
        border: 0;
        border-radius: 999px;
        min-height: 31px;
        font-size: 12px;
        font-weight: 900;
        color: #ffffff;
        cursor: pointer;
    }

    .store-select2-select-all {
        background: #1d273b;
    }

    .store-select2-clear-all {
        background: #64748b;
    }


    /* Custom one-input store permissions dropdown */
    .store-permission-select-native {
        display: none !important;
    }

    .store-permission-picker {
        position: relative;
        width: 100%;
    }

    .store-permission-trigger {
        width: 100%;
        height: 44px;
        min-height: 44px;
        border: 0 !important;
        border-radius: 8px !important;
        background: #ffffff !important;
        box-shadow: 0px 0px 4px rgba(0, 0, 0, 0.2) !important;
        color: #111827 !important;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        padding: 0 14px;
        cursor: pointer;
        text-align: right;
        direction: rtl;
        font-size: 15px;
        font-weight: 800;
        overflow: hidden;
    }

        .store-permission-trigger:focus,
        .store-permission-picker.open .store-permission-trigger {
            outline: none !important;
            box-shadow: 0 0 0 2px rgba(24, 160, 136, 0.18), 0px 0px 4px rgba(0, 0, 0, 0.2) !important;
        }

    .store-permission-summary {
        flex: 1 1 auto;
        min-width: 0;
        display: inline-flex;
        align-items: center;
        gap: 7px;
        overflow: hidden;
        white-space: nowrap;
        text-overflow: ellipsis;
        color: #64748b;
    }

        .store-permission-summary.has-values {
            color: #111827;
            font-weight: 900;
        }

        .store-permission-summary img {
            width: 22px;
            height: 22px;
            min-width: 22px;
            border-radius: 50%;
            object-fit: cover;
            border: 1px solid #dbe3ea;
        }

    .store-permission-summary-text {
        overflow: hidden;
        white-space: nowrap;
        text-overflow: ellipsis;
    }

    .store-permission-arrow {
        flex: 0 0 auto;
        color: #1d273b;
        font-size: 18px;
        font-weight: 900;
        line-height: 1;
        transition: transform .15s ease;
    }

    .store-permission-picker.open .store-permission-arrow {
        transform: rotate(180deg);
    }

    .store-permission-menu {
        display: none;
        position: absolute;
        top: calc(100% + 6px);
        right: 0;
        left: 0;
        z-index: 9999;
        background: #ffffff;
        border: 1px solid #111827;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 10px 25px rgba(15, 23, 42, 0.18);
        direction: rtl;
    }

    .store-permission-picker.open .store-permission-menu {
        display: block;
    }

    .store-permission-actions-row {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 8px;
        background: #f8fafc;
        border-bottom: 1px solid #111827;
    }

    .store-action-btn {
        flex: 1 1 0;
        min-height: 31px;
        border: 0;
        border-radius: 999px;
        color: #ffffff;
        font-size: 12px;
        font-weight: 900;
        cursor: pointer;
    }

    .store-action-select-all {
        background: #1d273b;
    }

    .store-action-clear-all {
        background: #64748b;
    }

    .store-permission-options {
        max-height: 260px;
        overflow-y: auto;
        overflow-x: hidden;
    }

    .store-permission-option {
        display: flex !important;
        align-items: center;
        gap: 8px;
        min-height: 42px;
        padding: 9px 12px;
        margin: 0 !important;
        border-bottom: 1px solid #111827;
        color: #111827;
        font-size: 14px;
        font-weight: 900 !important;
        cursor: pointer;
        background: #ffffff;
    }

        .store-permission-option:last-child {
            border-bottom: 0;
        }

        .store-permission-option:hover {
            background: #f1f5f9;
        }

    .store-permission-checkbox {
        display: none;
    }

    .store-check-circle {
        width: 17px;
        height: 17px;
        min-width: 17px;
        border-radius: 50%;
        border: 2px solid #cbd5e1;
        background: #ffffff;
        position: relative;
    }

    .store-permission-checkbox:checked + .store-check-circle {
        border-color: #1d273b;
        background: #1d273b;
    }

        .store-permission-checkbox:checked + .store-check-circle::after {
            content: "";
            position: absolute;
            top: 3px;
            left: 3px;
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: #ffffff;
        }

    .store-option-image {
        width: 24px;
        height: 24px;
        min-width: 24px;
        border-radius: 50%;
        object-fit: cover;
        border: 1px solid #dbe3ea;
    }

    .store-option-name {
        overflow: hidden;
        white-space: nowrap;
        text-overflow: ellipsis;
    }


    .employee-country-select {
        direction: rtl;
        text-align: right;
        cursor: pointer;
    }



    .employee-attendance-options-card {
        border: 1px solid #e9eaec;
        background: #f8fafc;
        border-radius: 14px;
        padding: 14px;
        height: 100%;
    }

    .employee-attendance-options-title {
        color: #1d273b;
        font-size: 15px;
        font-weight: 900;
        margin-bottom: 10px;
    }

    .weekly-off-days-grid {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .weekly-off-day-option {
        position: relative;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 34px;
        padding: 6px 12px;
        border-radius: 999px;
        border: 1px solid #cbd5e1;
        background: #ffffff;
        color: #334155;
        font-size: 13px;
        font-weight: 900;
        cursor: pointer;
        user-select: none;
    }

        .weekly-off-day-option input {
            display: none;
        }

        .weekly-off-day-option:has(input:checked) {
            background: rgba(24, 160, 136, 0.12);
            color: #1c273c;
            border-color: #1d273b;
        }

    .btn-submit-employee {
        background: #1d273b;
        color: #ffffff;
        border: 0;
        border-radius: 999px;
        min-height: 44px;
        padding: 8px 32px;
        font-weight: 900;
        box-shadow: 0 8px 18px rgba(15, 23, 42, 0.12);
    }
</style>

<div class="employee-create-page">
    <div class="employee-create-title">تعديل الموظف</div>

    <div class="employee-create-card">
        <form asp-action="Edit" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="Cv" />
            <input type="hidden" asp-for="Img" />
            <input type="hidden" asp-for="IdCardFrontImage" />
            <input type="hidden" asp-for="IdCardBackImage" />

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="row mt-2">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="Name" class="control-label"></label>
                        <input asp-for="Name" class="form-control" required />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="row mt-2">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="Nationality" class="control-label"></label>
                        <input asp-for="Nationality" class="form-control" required />
                        <span asp-validation-for="Nationality" class="text-danger"></span>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="PhoneNumber" class="control-label"></label>
                        <input asp-for="PhoneNumber" class="form-control" required />
                        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="row mt-2">
                <div class="col-md-6">
                    <div class="form-group">
                        <label for="EmployeeCountry" class="control-label">الدولة</label>
                        <select name="country" id="EmployeeCountry" class="form-control employee-country-select" required>
                            <option value="">اختاري الدولة</option>
                            <option value="Egypt" selected="@(IsCountrySelected("Egypt") ? "selected" : null)">🇪🇬 مصر</option>
                            <option value="Turkey" selected="@(IsCountrySelected("Turkey") ? "selected" : null)">🇹🇷 تركيا</option>
                            <option value="Iraq" selected="@(IsCountrySelected("Iraq") ? "selected" : null)">🇮🇶 العراق</option>
                            <option value="Jordan" selected="@(IsCountrySelected("Jordan") ? "selected" : null)">🇯🇴 الأردن</option>
                            <option value="Libya" selected="@(IsCountrySelected("Libya") ? "selected" : null)">🇱🇾 ليبيا</option>
                            <option value="Kuwait" selected="@(IsCountrySelected("Kuwait") ? "selected" : null)">🇰🇼 الكويت</option>
                            <option value="Qatar" selected="@(IsCountrySelected("Qatar") ? "selected" : null)">🇶🇦 قطر</option>
                            <option value="Oman" selected="@(IsCountrySelected("Oman") ? "selected" : null)">🇴🇲 عمان</option>
                            <option value="Bahrain" selected="@(IsCountrySelected("Bahrain") ? "selected" : null)">🇧🇭 البحرين</option>
                            <option value="Tunisia" selected="@(IsCountrySelected("Tunisia") ? "selected" : null)">🇹🇳 تونس</option>
                        </select>
                        <span class="text-danger" data-valmsg-for="country"></span>
                    </div>
                </div>
            </div>


            <div class="row mt-2">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="Cv" class="control-label"></label>
                        <input type="file" name="CvFile" class="form-control-file" accept="application/pdf" />
                        <span asp-validation-for="Cv" class="text-danger"></span>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="Img" class="control-label"></label>
                        <input type="file" name="ImgFile" class="form-control-file image-upload" accept="image/*" />
                        <span asp-validation-for="Img" class="text-danger"></span>
                        @if (!string.IsNullOrWhiteSpace(employeeImage))
                        {
                            <img id="logoImage" class="image-upload img-fluid" src="@employeeImage" alt="صورة الموظف" style="display:block; max-width: 200px; max-height: 150px; border-radius: 10px; margin-top: 8px;" />
                        }
                        else
                        {
                            <img id="logoImage" class="image-upload img-fluid" src="" alt="صورة الموظف" style="display:none; max-width: 200px; max-height: 150px; border-radius: 10px; margin-top: 8px;" />
                        }
                    </div>
                </div>
            </div>

            <div class="row mt-2">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="IdNumber" class="control-label"></label>
                        <input asp-for="IdNumber" class="form-control" required />
                        <span asp-validation-for="IdNumber" class="text-danger"></span>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="Address" class="control-label"></label>
                        <input asp-for="Address" class="form-control" required />
                        <span asp-validation-for="Address" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="row mt-2">
                <div class="col-md-6">
                    <div class="form-group">
                        <label>صورة البطاقة - وش</label>
                        <div class="employee-file-trigger employee-paste-zone" tabindex="0" role="textbox" aria-label="اضف صورة البطاقة وش" data-input-id="IdCardFrontFile">
                            <span class="employee-file-placeholder" data-placeholder-for="IdCardFrontFile">اضف صورة البطاقة وش أو اضغطي Ctrl+V</span>
                            <button type="button" class="employee-file-browse-btn" data-browse-input="IdCardFrontFile">اختيار ملف</button>
                            <i class="fa-solid fa-id-card employee-file-icon"></i>
                        </div>
                        <input type="file" name="IdCardFrontFile" id="IdCardFrontFile" class="employee-file-input employee-id-card-input" accept="image/*" />
                        <img id="IdCardFrontPreview" class="employee-file-preview" src="@idCardFrontImage" alt="صورة البطاقة وش" style="@(string.IsNullOrWhiteSpace(idCardFrontImage) ? "" : "display:block;")" />
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-group">
                        <label>صورة البطاقة - ظهر</label>
                        <div class="employee-file-trigger employee-paste-zone" tabindex="0" role="textbox" aria-label="اضف صورة البطاقة ظهر" data-input-id="IdCardBackFile">
                            <span class="employee-file-placeholder" data-placeholder-for="IdCardBackFile">اضف صورة البطاقة ظهر أو اضغطي Ctrl+V</span>
                            <button type="button" class="employee-file-browse-btn" data-browse-input="IdCardBackFile">اختيار ملف</button>
                            <i class="fa-solid fa-id-card-clip employee-file-icon"></i>
                        </div>
                        <input type="file" name="IdCardBackFile" id="IdCardBackFile" class="employee-file-input employee-id-card-input" accept="image/*" />
                        <img id="IdCardBackPreview" class="employee-file-preview" src="@idCardBackImage" alt="صورة البطاقة ظهر" style="@(string.IsNullOrWhiteSpace(idCardBackImage) ? "" : "display:block;")" />
                    </div>
                </div>
            </div>

            <div class="row mt-2">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="Salary" class="control-label"></label>
                        <input asp-for="Salary" class="form-control" required />
                        <span asp-validation-for="Salary" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="row mt-2">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="Email" class="control-label"></label>
                        <input asp-for="Email" class="form-control" required />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="NewPassword" class="control-label">كلمة مرور جديدة</label>
                        <input asp-for="NewPassword" type="password" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="NewPassword" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="row mt-2">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="ConfirmNewPassword" class="control-label">تأكيد كلمة المرور الجديدة</label>
                        <input asp-for="ConfirmNewPassword" type="password" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="ConfirmNewPassword" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="row mt-2">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="Gender" class="control-label"></label>
                        <select asp-for="Gender" class="form-control">
                            <option value="false">ذكر</option>
                            <option value="true">انثى</option>
                        </select>
                        <span asp-validation-for="Gender" class="text-danger"></span>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-group">
                        <label for="Role" class="control-label">الصلاحيات</label>
                        <select asp-for="Role" class="form-control" id="Role">
                            <option value="">اختار الصلاحية</option>
                            @if (Model.Roles != null)
                            {
                                foreach (var roleName in Model.Roles as List<string>)
                                {
                                    if (string.Equals(Model.Role, roleName, StringComparison.OrdinalIgnoreCase))
                                    {
                                        <option value="@roleName" selected>@roleName</option>
                                    }
                                    else
                                    {
                                        <option value="@roleName">@roleName</option>
                                    }
                                }
                            }
                        </select>
                    </div>
                </div>
            </div>



            @{
                var currentCheckInVerificationMethod = (ViewBag.CheckInVerificationMethod as string) ?? "Photo";
                var hideCheckInMethodForRole = string.Equals(Model.Role, "Admin", StringComparison.OrdinalIgnoreCase)
                    || string.Equals(Model.Role, "DeliveryCompany", StringComparison.OrdinalIgnoreCase)
                    || string.Equals(Model.Role, "DeliveryRepresentative", StringComparison.OrdinalIgnoreCase)
                    || string.Equals(Model.Role, "OrderPreparer", StringComparison.OrdinalIgnoreCase);
            }

            <div class="row mt-2" id="CheckInVerificationMethodRow" style="@(hideCheckInMethodForRole ? "display:none;" : "")">
                <div class="col-md-6">
                    <div class="form-group">
