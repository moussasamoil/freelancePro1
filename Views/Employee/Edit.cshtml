            </div>

            <div class="row mt-2">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="IsShown" class="control-label">إظهار الموظف في السيستم</label>
                        <select asp-for="IsShown" class="form-control">
                            <option value="true">ظاهر</option>
                            <option value="false">مخفي</option>
                        </select>
                        <span asp-validation-for="IsShown" class="text-danger"></span>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="IsActive" class="control-label">تفعيل الحساب</label>
                        <select asp-for="IsActive" class="form-control">
                            <option value="true">مفعل</option>
                            <option value="false">غير مفعل</option>
                        </select>
                        <span asp-validation-for="IsActive" class="text-danger"></span>
                    </div>
                </div>
