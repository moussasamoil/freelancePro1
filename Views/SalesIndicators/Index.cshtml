@using lotus_blue.Models
@model lotus_blue.Models.ViewModel.SalesIndicatorViewModel
@{
    ViewData["Title"] = "مؤشرات البيع";
    Layout = "_MainLayout";
    var successMessage = TempData["SuccessMessage"] as string;
    var successTitle = TempData["SuccessTitle"] as string;
    if (string.IsNullOrWhiteSpace(successTitle) && !string.IsNullOrWhiteSpace(successMessage))
    {
        successTitle = successMessage.Contains("حفظ") ? "تم الحفظ بنجاح" :
            successMessage.Contains("حذف") ? "تم الحذف بنجاح" : "تم التعديل بنجاح";
    }
    var errorMessage = TempData["ErrorMessage"] as string;
}


@functions {
    static string SalesIndicatorImageUrl(string? raw, string fallback = "/static/DefaultImage.svg")
    {
        if (string.IsNullOrWhiteSpace(raw))
        {
            return fallback;
        }

        var value = raw.Trim().Replace("\\", "/");

        if (value.StartsWith("~/", System.StringComparison.OrdinalIgnoreCase))
        {
            value = value.Substring(1);
        }

        if (value.StartsWith("http://", System.StringComparison.OrdinalIgnoreCase)
            || value.StartsWith("https://", System.StringComparison.OrdinalIgnoreCase)
            || value.StartsWith("data:", System.StringComparison.OrdinalIgnoreCase))
        {
            return value;
        }

        return "/" + value.TrimStart('/');
    }

    static string SalesIndicatorCountryImageUrl(Common.Countries country)
    {
        return SalesIndicatorImageUrl(
            Common.GetImageUrlByCountryName(country.ToString()),
            "/static/earth-americas-sharp-solid.svg");
    }
}

