@section Scripts {

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var editPopup = document.getElementById('salesIndicatorEditPopup');

            if (!window.CSS) { window.CSS = {}; }
            if (!window.CSS.escape) { window.CSS.escape = function (value) { return String(value).replace(/[^a-zA-Z0-9_\-]/g, '\\$&'); }; }

            function closeAllCustomDropdowns(exceptElement) {
                document.querySelectorAll('.sales-indicators-page .min-sale-custom-select.open').forEach(function (selectWrap) {
                    if (exceptElement && selectWrap === exceptElement) {
                        return;
                    }

                    selectWrap.classList.remove('open');
                });
            }

            function refreshCustomSelect(selectWrap) {
                if (!selectWrap) return;

                var targetSelector = selectWrap.getAttribute('data-target');
                var placeholder = selectWrap.getAttribute('data-placeholder') || 'اختار';
                var hiddenInput = document.querySelector(targetSelector);
                var value = hiddenInput ? (hiddenInput.value || '').toString() : '';
                var textEl = selectWrap.querySelector('.min-sale-custom-text');
                var imageEl = selectWrap.querySelector('.min-sale-custom-image');

                selectWrap.querySelectorAll('.min-sale-custom-option').forEach(function (option) {
                    option.classList.remove('selected');
                });

                if (!value) {
                    selectWrap.classList.remove('has-value');
                    if (textEl) textEl.textContent = placeholder;
                    if (imageEl) imageEl.setAttribute('src', '');
                    return;
                }

                var selectedOption = selectWrap.querySelector('.min-sale-custom-option[data-value="' + CSS.escape(value) + '"]');

                if (!selectedOption) {
                    selectWrap.classList.remove('has-value');
                    if (textEl) textEl.textContent = placeholder;
                    if (imageEl) imageEl.setAttribute('src', '');
                    return;
                }

                selectedOption.classList.add('selected');
                selectWrap.classList.add('has-value');
                if (textEl) textEl.textContent = selectedOption.getAttribute('data-text') || selectedOption.textContent.trim();
                if (imageEl) imageEl.setAttribute('src', selectedOption.getAttribute('data-image') || '');
            }

            function refreshCustomSelectByTarget(targetSelector) {
                document.querySelectorAll('.sales-indicators-page .min-sale-custom-select[data-target="' + targetSelector + '"]').forEach(function (selectWrap) {
                    refreshCustomSelect(selectWrap);
                });
            }

            document.querySelectorAll('.sales-indicators-page .min-sale-custom-select').forEach(function (selectWrap) {
                refreshCustomSelect(selectWrap);
            });

            document.querySelectorAll('.sales-indicators-page .min-sale-custom-trigger').forEach(function (trigger) {
                trigger.addEventListener('click', function (event) {
                    event.preventDefault();
                    event.stopPropagation();

                    var selectWrap = trigger.closest('.min-sale-custom-select');
                    var isOpen = selectWrap.classList.contains('open');

                    closeAllCustomDropdowns(selectWrap);

                    if (isOpen) {
                        selectWrap.classList.remove('open');
                    } else {
                        selectWrap.classList.add('open');
                    }
                });
            });

            document.querySelectorAll('.sales-indicators-page .min-sale-custom-option').forEach(function (option) {
                option.addEventListener('click', function (event) {
                    event.preventDefault();
                    event.stopPropagation();

                    var selectWrap = option.closest('.min-sale-custom-select');
                    var targetSelector = selectWrap.getAttribute('data-target');
                    var hiddenInput = document.querySelector(targetSelector);

                    if (hiddenInput) {
                        hiddenInput.value = option.getAttribute('data-value') || '';
                        hiddenInput.dispatchEvent(new Event('change', { bubbles: true }));
                    }

                    refreshCustomSelect(selectWrap);
                    selectWrap.classList.remove('open');
                });
            });

            document.addEventListener('click', function () {
                closeAllCustomDropdowns(null);
            });

            document.addEventListener('keydown', function (event) {
                if (event.key === 'Escape') {
                    closeAllCustomDropdowns(null);
                    closeEditPopup();
                }
            });

            function setField(id, value) {
                var el = document.getElementById(id);
                if (!el) return;

                el.value = value || '';
                el.dispatchEvent(new Event('change', { bubbles: true }));
                refreshCustomSelectByTarget('#' + id);
            }

            function openEditPopup(button) {
                setField('Edit_Id', button.getAttribute('data-id'));
                setField('Edit_Country', button.getAttribute('data-country'));
                setField('Edit_MainWarehouseId', button.getAttribute('data-main-warehouse-id'));
                setField('Edit_MinimumSellingFrom', button.getAttribute('data-minimum-selling-from'));
                setField('Edit_MinimumSellingTo', button.getAttribute('data-minimum-selling-to'));
                setField('Edit_BasicSellingFrom', button.getAttribute('data-basic-selling-from'));
                setField('Edit_BasicSellingTo', button.getAttribute('data-basic-selling-to'));
                setField('Edit_MiddleSellingFrom', button.getAttribute('data-middle-selling-from'));
                setField('Edit_MiddleSellingTo', button.getAttribute('data-middle-selling-to'));

                if (editPopup) {
                    editPopup.style.display = 'flex';
                    document.body.classList.add('sales-indicators-modal-open');
                    refreshCustomSelectByTarget('#Edit_Country');
                    refreshCustomSelectByTarget('#Edit_MainWarehouseId');
                }
            }

            function closeEditPopup() {
                if (editPopup) {
                    editPopup.style.display = 'none';
                    document.body.classList.remove('sales-indicators-modal-open');
                    closeAllCustomDropdowns(null);
                }
            }

            document.querySelectorAll('.js-open-sales-edit-popup').forEach(function (button) {
                button.addEventListener('click', function () {
                    openEditPopup(button);
                });
            });

            var closeButton = document.getElementById('salesIndicatorEditClose');
            var cancelButton = document.getElementById('salesIndicatorEditCancel');
            if (closeButton) closeButton.addEventListener('click', closeEditPopup);
            if (cancelButton) cancelButton.addEventListener('click', closeEditPopup);

            if (editPopup) {
                editPopup.addEventListener('click', function (e) {
                    if (e.target === editPopup) closeEditPopup();
                });
            }

            document.querySelectorAll('[data-sales-popup-close]').forEach(function (button) {
                button.addEventListener('click', function () {
                    var popupId = button.getAttribute('data-sales-popup-close');
                    var popup = document.getElementById(popupId);
                    if (popup) popup.style.display = 'none';
                });
            });
        });
    </script>
    <partial name="_ValidationScriptsPartial" />
}
