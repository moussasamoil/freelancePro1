@using lotus_blue.Models
@model lotus_blue.ViewModels.ProductMinimumSellingPriceViewModel

@{
    var isEdit = Model.Id > 0;
    var pageHeaderTitle = isEdit ? "تعديل الحد الأدنى للبيع" : "إنشاء الحد الأدنى للبيع";

    ViewData["Title"] = pageHeaderTitle;
    ViewBag.Title = pageHeaderTitle;
    ViewBag.PageTitle = pageHeaderTitle;
    ViewBag.HeaderTitle = pageHeaderTitle;

    var stores = ViewBag.Stores as List<lotus_blue.Models.ManufacturingCompany> ?? new List<lotus_blue.Models.ManufacturingCompany>();
    var mainProducts = ViewBag.MainProducts as List<lotus_blue.Models.MainWarehouse> ?? new List<lotus_blue.Models.MainWarehouse>();

    var formAction = isEdit ? "Edit" : "Create";
}

@functions {
    static string MinSaleImageUrl(string? raw, string fallback = "/static/box-open-regular.svg")
    {
        if (string.IsNullOrWhiteSpace(raw))
        {
            return fallback;
        }

        var value = raw.Trim().Replace("\\", "/");

        if (value.StartsWith("~/", System.StringComparison.OrdinalIgnoreCase))
        {
            value = value.Substring(1);
        }

        if (value.StartsWith("http://", System.StringComparison.OrdinalIgnoreCase)
            || value.StartsWith("https://", System.StringComparison.OrdinalIgnoreCase)
            || value.StartsWith("data:", System.StringComparison.OrdinalIgnoreCase))
        {
            return value;
        }

        return "/" + value.TrimStart('/');
    }

    static string MinSaleCountryImage(lotus_blue.Models.Common.Countries country)
    {
        return MinSaleImageUrl(
            lotus_blue.Models.Common.GetImageUrlByCountryName(country.ToString()),
            "/static/earth-americas-sharp-solid.svg");
    }
}

