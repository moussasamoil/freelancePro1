<a asp-action="Index" class="min-sale-layout-back-link">عرض الحد الأدنى للبيع</a>

<div class="min-sale-page">
    <div class="min-sale-card">
        <div class="min-sale-card-header">
            @pageHeaderTitle
        </div>

        <div class="min-sale-card-body">
            <form asp-action="@formAction" id="createProductMinSaleForm" method="post">
                @Html.AntiForgeryToken()

                @if (isEdit)
                {
                    <input asp-for="Id" type="hidden" />
                }

                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="form-grid">
                    <div class="form-group">
                        <label asp-for="Country">الدولة</label>
                        <input asp-for="Country" type="hidden" id="countryDropdown" class="min-sale-hidden-field" />

                        <div class="min-sale-custom-select" data-target="#countryDropdown" data-placeholder="اختار البلد">
                            <button type="button" class="min-sale-custom-trigger">
                                <span class="min-sale-custom-trigger-main">
                                    <img class="min-sale-custom-image" src="" alt="" />
                                    <span class="min-sale-custom-text">اختار البلد</span>
                                </span>
                                <span class="min-sale-custom-arrow">▾</span>
                            </button>

                            <div class="min-sale-custom-menu">
                                <div class="min-sale-custom-options">
                                    @foreach (Common.Countries country in Enum.GetValues(typeof(Common.Countries)))
                                    {
                                        <button type="button"
                                                class="min-sale-custom-option"
                                                data-value="@((int)country)"
                                                data-text="@country"
                                                data-image="@MinSaleCountryImage(country)">
                                            <img src="@MinSaleCountryImage(country)" alt="" onerror="this.remove();" />
                                            <span>@country</span>
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>

                        <span asp-validation-for="Country" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="ManufacturingCompanyId">المتجر</label>
                        <input asp-for="ManufacturingCompanyId" type="hidden" id="manufacturingCompanyDropdown" class="min-sale-hidden-field" />

                        <div class="min-sale-custom-select" data-target="#manufacturingCompanyDropdown" data-placeholder="اسم المتجر">
                            <button type="button" class="min-sale-custom-trigger">
                                <span class="min-sale-custom-trigger-main">
                                    <img class="min-sale-custom-image" src="" alt="" />
                                    <span class="min-sale-custom-text">اسم المتجر</span>
                                </span>
                                <span class="min-sale-custom-arrow">▾</span>
                            </button>

                            <div class="min-sale-custom-menu">
                                <div class="min-sale-custom-options">
                                    @foreach (var store in stores)
                                    {
                                        var storeImage = MinSaleImageUrl(store.ImageUrl, "/static/building-regular.svg");

                                        <button type="button"
                                                class="min-sale-custom-option"
                                                data-value="@store.Id"
                                                data-text="@store.Name"
                                                data-image="@storeImage">
                                            <img src="@storeImage" alt="" onerror="this.remove();" />
                                            <span>@store.Name</span>
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>

                        <span asp-validation-for="ManufacturingCompanyId" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="MainWarehouseId">المنتج الرئيسي</label>
                        <input asp-for="MainWarehouseId" type="hidden" id="mainProductDropdown" class="min-sale-hidden-field" />

                        <div class="min-sale-custom-select" data-target="#mainProductDropdown" data-placeholder="اسم المنتج الرئيسي">
                            <button type="button" class="min-sale-custom-trigger">
                                <span class="min-sale-custom-trigger-main">
                                    <img class="min-sale-custom-image" src="" alt="" />
                                    <span class="min-sale-custom-text">اسم المنتج الرئيسي</span>
                                </span>
                                <span class="min-sale-custom-arrow">▾</span>
                            </button>

                            <div class="min-sale-custom-menu">
                                <div class="min-sale-custom-options">
                                    @foreach (var product in mainProducts)
                                    {
                                        var productImage = MinSaleImageUrl(product.ImageUrl, "/static/box-open-regular.svg");

                                        <button type="button"
                                                class="min-sale-custom-option"
                                                data-value="@product.Id"
                                                data-text="@product.Name"
                                                data-image="@productImage">
                                            <img src="@productImage" alt="" onerror="this.remove();" />
                                            <span>@product.Name</span>
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>

                        <span asp-validation-for="MainWarehouseId" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="MinimumSellingPrice">الحد الأدنى للبيع</label>
                        <input asp-for="MinimumSellingPrice"
                               class="form-control"
                               type="number"
                               step="0.01"
                               min="0"
                               placeholder="اكتب السعر" />
                        <span asp-validation-for="MinimumSellingPrice" class="text-danger"></span>
                    </div>
                </div>

                <div class="actions-row">
                    <button type="submit" class="btn-save">موافقة</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div id="minSaleErrorPopup" class="min-sale-error-overlay" aria-hidden="true">
    <div class="min-sale-error-popup" role="alertdialog" aria-modal="true" aria-labelledby="minSaleErrorTitle">
        <button type="button" class="min-sale-error-close" data-close-min-sale-error aria-label="إغلاق">×</button>

        <div class="min-sale-error-icon" aria-hidden="true">
            <svg width="34" height="34" viewBox="0 0 24 24" fill="none">
                <path d="M12 3.25L22 20.25H2L12 3.25Z" fill="currentColor" opacity="0.16"></path>
                <path d="M12 3.25L22 20.25H2L12 3.25Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"></path>
                <path d="M12 8.4V13.2" stroke="currentColor" stroke-width="2.1" stroke-linecap="round"></path>
                <path d="M12 17.05H12.01" stroke="currentColor" stroke-width="3" stroke-linecap="round"></path>
            </svg>
        </div>

        <div id="minSaleErrorTitle" class="min-sale-error-title">تنبيه</div>
        <div id="minSaleErrorText" class="min-sale-error-message"></div>

        <div class="min-sale-error-actions">
            <button type="button" class="min-sale-error-ok" data-close-min-sale-error>موافق</button>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        $(function () {
            function escapeHtml(value) {
                return $('<div/>').text(value || '').html();
            }

            function normalizeErrorText(value) {
                return (value || '').replace(/\s+/g, ' ').trim();
            }

            function uniqueMessages(messages) {
                var seen = {};
                var output = [];

                messages.forEach(function (message) {
                    var text = normalizeErrorText(message);

                    if (text && !seen[text]) {
                        seen[text] = true;
                        output.push(text);
                    }
                });

                return output;
            }

            function showMinSaleErrorPopup(messages) {
                var cleanMessages = uniqueMessages(Array.isArray(messages) ? messages : [messages]);
                var popup = $('#minSaleErrorPopup');
                var textBox = $('#minSaleErrorText');

                if (!cleanMessages.length) {
                    cleanMessages = ['برجاء مراجعة البيانات المطلوبة.'];
                }

                textBox.html(cleanMessages.map(function (message) {
                    return '<div>' + escapeHtml(message) + '</div>';
                }).join(''));

                popup.addClass('show').attr('aria-hidden', 'false');
            }

            function hideMinSaleErrorPopup() {
                $('#minSaleErrorPopup').removeClass('show').attr('aria-hidden', 'true');
            }

            function closeAllCustomDropdowns(except) {
                $('.min-sale-custom-select').not(except || null).removeClass('open');
            }

            function refreshCustomSelect($selectWrap) {
                var targetSelector = $selectWrap.data('target');
                var placeholder = $selectWrap.data('placeholder') || 'اختار';
                var $hiddenInput = $(targetSelector);
                var value = ($hiddenInput.val() || '').toString();
                var $text = $selectWrap.find('.min-sale-custom-text');
                var $image = $selectWrap.find('.min-sale-custom-image');

                $selectWrap.find('.min-sale-custom-option').removeClass('selected');

                if (!value) {
                    $selectWrap.removeClass('has-value');
                    $text.text(placeholder);
                    $image.attr('src', '');
                    return;
                }

                var $option = $selectWrap.find('.min-sale-custom-option[data-value="' + value + '"]').first();

                if (!$option.length) {
                    $selectWrap.removeClass('has-value');
                    $text.text(placeholder);
                    $image.attr('src', '');
                    return;
                }

                $option.addClass('selected');
                $selectWrap.addClass('has-value');
                $text.text($option.data('text') || $.trim($option.text()));
                $image.attr('src', $option.data('image') || '');
            }

            $('.min-sale-custom-select').each(function () {
                refreshCustomSelect($(this));
            });

            $('.min-sale-custom-trigger').on('click', function (event) {
                event.preventDefault();
                event.stopPropagation();

                var $selectWrap = $(this).closest('.min-sale-custom-select');
                var isOpen = $selectWrap.hasClass('open');

                closeAllCustomDropdowns($selectWrap);

                if (!isOpen) {
                    $selectWrap.addClass('open');
                } else {
                    $selectWrap.removeClass('open');
                }
            });

            $('.min-sale-custom-option').on('click', function (event) {
                event.preventDefault();
                event.stopPropagation();

                var $option = $(this);
                var $selectWrap = $option.closest('.min-sale-custom-select');
                var targetSelector = $selectWrap.data('target');

                $(targetSelector)
                    .val($option.data('value'))
                    .trigger('change')
                    .valid();

                refreshCustomSelect($selectWrap);
                $selectWrap.removeClass('open');
            });

            $(document).on('click', function () {
                closeAllCustomDropdowns();
            });

            $(document).on('keydown', function (event) {
                if (event.key === 'Escape') {
                    closeAllCustomDropdowns();
                    hideMinSaleErrorPopup();
                }
            });

            $('[data-close-min-sale-error]').on('click', hideMinSaleErrorPopup);

            $('#minSaleErrorPopup').on('click', function (event) {
                if (event.target === this) {
                    hideMinSaleErrorPopup();
                }
            });

            function collectInlineValidationMessages() {
                var messages = [];

                $('.validation-summary-errors li, .validation-summary-errors, .field-validation-error, .text-danger').each(function () {
                    var message = normalizeErrorText($(this).text());

                    if (message) {
                        messages.push(message);
                    }
                });

                return uniqueMessages(messages);
            }

            function collectManualFormMessages() {
                var messages = [];
                var minimumPriceValue = $('[name="MinimumSellingPrice"]').val();

                if (!$('#countryDropdown').val()) {
                    messages.push('يرجى اختيار البلد.');
                }

                if (!$('#manufacturingCompanyDropdown').val()) {
                    messages.push('يرجى اختيار متجر.');
                }

                if (!$('#mainProductDropdown').val()) {
                    messages.push('يرجى اختيار المنتج الرئيسي.');
                }

                if (!minimumPriceValue || !isFinite(Number(minimumPriceValue)) || Number(minimumPriceValue) <= 0) {
                    messages.push('يرجى إدخال الحد الأدنى للبيع بشكل صحيح.');
                }

                return uniqueMessages(messages);
            }

            $('#createProductMinSaleForm').on('submit', function (e) {
                var messages = collectManualFormMessages();
                var form = $(this);

                if (form.data('validator')) {
                    var isValid = form.valid();

                    if (!isValid && form.data('validator').errorList) {
                        form.data('validator').errorList.forEach(function (error) {
                            messages.push(error.message);
                        });
                    }
                }

                messages = uniqueMessages(messages.concat(collectInlineValidationMessages()));

                if (messages.length) {
                    e.preventDefault();
                    e.stopPropagation();
                    showMinSaleErrorPopup(messages);
                    return false;
                }
            });

            var serverMessages = collectInlineValidationMessages();

            if (serverMessages.length) {
                showMinSaleErrorPopup(serverMessages);
            }
        });
    </script>
}
