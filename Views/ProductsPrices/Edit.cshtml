@model lotus_blue.Models.ViewModel.ProductsPricesViewModel

@{
    ViewData["Title"] = "تعديل سعر المنتج";
}

<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit" enctype="multipart/form-data">
            <div class="form-group">
                <label asp-for="ProductName" class="control-label"> اسم المنتج</label>
                <input asp-for="ProductName" class="form-control" />
                <span asp-validation-for="ProductName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ProductPrice" class="control-label"> سعر المنتج</label>
                <input asp-for="ProductPrice" class="form-control" />
                <span asp-validation-for="ProductPrice" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Country" class="control-label"> الدولة</label>
                <select asp-for="Country" class="form-control" asp-items="@(Html.GetEnumSelectList<lotus_blue.Models.Common.Countries>())"></select>
                <span asp-validation-for="Country" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="SelectedManufacturingCompanyId" class="control-label">شركة التصنيع</label>
                <select asp-for="SelectedManufacturingCompanyId" class="form-control" id="manufacturingCompaniesDropdown">
                    <option value="">-- اختر شركة --</option>
                </select>
                <span asp-validation-for="SelectedManufacturingCompanyId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ProductImage" class="control-label"> صورة المنتج</label>
                <input asp-for="ProductImage" type="file" class="form-control" />
                <span asp-validation-for="ProductImage" class="text-danger"></span>
            </div>
            <div class="form-group mt-3 d-lg-inline-flex">
                <input type="submit" value="حفظ" class="btn btn-primary" />
                <a class="btn btn-secondary me-3" asp-action="Index">العودة إلى القائمة</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $.ajax({
                url: '/DataList/GetAllStores',
                type: 'GET',
                success: function (data) {
                    var dropdown = $('#manufacturingCompaniesDropdown');
                    dropdown.empty();
                    dropdown.append('<option value="">-- اختر شركة --</option>');
                    $.each(data, function (index, company) {
                        dropdown.append('<option value="' + company.id + '">' + company.name + '</option>');
                    });

                    // Set the selected value if it exists
                    var selectedValue = '@Model.SelectedManufacturingCompanyId';
                    if (selectedValue) {
                        dropdown.val(selectedValue);
                    }
                },
                error: function () {
                    alert('فشل في استرجاع الشركات.');
                }
            });
        });
    </script>
}
