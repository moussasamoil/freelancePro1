@model lotus_blue.Models.ViewModel.PaginationViewModel<lotus_blue.Models.ViewModel.ExchangeRateViewModel>

@{
    ViewData["Title"] = "أسعار الصرف";
}

<div class="row mb-3">



    <!-- Second column -->
    <div class="col-lg d-flex align-items-center justify-content-end">
        <div class="form-group d-flex align-items-center">
            <label for="pageSize" class="me-2">أظهر:</label>
            <select id="pageSize" name="pageSize" class="form-control me-2">
                <option value="10">10</option>
                <option value="25">25</option>
                <option value="50">50</option>
                <option value="100">100</option>
            </select>
            <label for="pageSize">مدخلات</label>
        </div>
    </div>

</div>
<table id="table" class="table">
    <thead>
        <tr>
            <th>البلد</th>
            <th>العملة</th>
            <th>شراء مقابل الدولار</th>
            <th>بيع مقابل الدولار</th>
            @if (User.IsInRole("Admin"))
            {
                <th>الإجراءات</th>
            }
        </tr>
    </thead>
    <tbody>
        @foreach (var rate in Model.Items)
        {
            <tr>
                <td>
                    <img width="25" height="25" src="@rate.CountryFlagUrl" alt="@rate.Country" />

                    @rate.Country</td>
                <td>@rate.Currency</td>
                <td>@rate.BuyToUSD</td>
                <td>@rate.SellToUSD</td>
                @if (User.IsInRole("Admin"))
                {
                    <td>
                        <div class="d-inline-flex">
                            <a asp-action="Edit" asp-route-id="@rate.Id" class="btn btn-yellow-v3">تعديل</a>
                           
                        </div>
                    </td>
                }
            </tr>
        }
    </tbody>
</table>

<!-- Display pagination controls -->
<div id="pagination-link" class="mt-0 container-fluid">
    <div class="d-flex justify-content-between align-items-center">

        <p class="text-start pt-2 total-items-display">@Model.TotalItems عدد الدول</p>

        <nav aria-label="Page navigation" class="mx-auto">
            <div class="d-flex justify-content-start">
                <ul class="pagination p-0">
                    <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link pointer" data-page="1">
                            <i class="fa-solid fa-chevron-double-right text-green"></i>
                        </a>
                    </li>
                    <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link" data-page="@(Model.CurrentPage - 1)">
                            <i class="fa-solid fa-chevron-right text-green"></i>
                        </a>
                    </li>

                    @{
                        int startPage = Model.CurrentPage;
                        int endPage = startPage + 2;
                        if (endPage > Model.TotalPages)
                        {
                            endPage = Model.TotalPages;
                        }
                    }

                    @for (int i = startPage; i <= endPage; i++)
                    {
                        <li class="numbers page-item @(Model.CurrentPage == i ? "active" : "")">
                            <a class="page-link" data-page="@i">@i</a>
                        </li>
                    }

                    @if (Model.TotalPages > endPage)
                    {
                        <li class="page-item disabled">
                            <span class="page-link">...</span>
                        </li>

                        @for (int i = Model.TotalPages - 2; i <= Model.TotalPages; i++)
                        {
                            <li class="numbers page-item @(Model.CurrentPage == i ? "active" : "")">
                                <a class="page-link" data-page="@i">@i</a>
                            </li>
                        }
                    }



                    <li class="page-item @(Model.CurrentPage ==  Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" data-page="@(Model.CurrentPage + 1)">
                            <i class="fa-solid fa-chevron-left text-green f-s-18"></i>
                        </a>
                    </li>
                    <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" data-page="@(Model.TotalPages)">
                            <i class="fa-solid fa-chevron-double-left text-green"></i>
                        </a>
                    </li>


                </ul>
            </div>
        </nav>


    </div>
</div>

@section Scripts {

    <script>
        $(document).ready(function () {


            $('#pageSize').change(function () {
                loadPage(1);
            });
        });

        function loadPage(page) {
            const pageSize = $('#pageSize').val();  // Get the page size from an input field with id 'pageSize'

            $.ajax({
                url: '/ExchangeRate',
                type: 'GET',
                data: {
                    pageSize: pageSize,  // Number of items per page
                    page: page
                },
                success: function (response) {
                    $('#table').html($(response).find('#table').html());
                    $('.pagination').html($(response).find('.pagination').html());
                },
                error: function (error) {
                    console.log(error);
                }
            });
        }

        // Event listener for pagination links
        $(document).on('click', '.pagination a.page-link', function (event) {
            event.preventDefault(); // Prevent the default action of clicking on a link

            // Extract the page number from the data-page attribute of the clicked element
            const page = $(this).data('page');

            // Call fetchData function with the extracted page number
            loadPage(page);
        });
    </script>
}