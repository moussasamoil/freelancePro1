@model lotus_blue.Models.ViewModel.ExchangeRateViewModel
@{
    ViewData["Title"] = "إنشاء سعر صرف";
}
<h2>إنشاء سعر الصرف</h2>

<form asp-action="Create">
    <div class="form-group">
        <label asp-for="Country" class="control-label">العملة</label>
        <select asp-for="Country" class="form-control">
            @foreach (var country in Enum.GetNames(typeof(lotus_blue.Models.Common.Countries)))
            {
                <option value="@country">@country</option>
            }
        </select>
        <span asp-validation-for="Country" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="BuyToUSD" class="control-label">شراء مقابل الدولار</label>
        <input asp-for="BuyToUSD" class="form-control" />
        <span asp-validation-for="BuyToUSD" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="SellToUSD" class="control-label">بيع مقابل الدولار</label>
        <input asp-for="SellToUSD" class="form-control" />
        <span asp-validation-for="SellToUSD" class="text-danger"></span>
    </div>

    <div class="form-group">
        <input type="submit" value="موافقة" class="btn btn-success" />
        <a asp-action="Index" class="btn btn-secondary">العودة إلى القائمة</a>
    </div>
</form>
