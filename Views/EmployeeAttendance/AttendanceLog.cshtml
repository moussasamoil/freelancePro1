    <script>
        (function () {
        const wantedTitle = 'إدارة  الموظفين';
        const assignWorkTimesUrl = '/Employee';
        const assignWorkTimesText = 'اداره الموظفين ';
        const assignWorkTimesLinkId = 'topAssignWorkTimesLink';
        const attendanceHeaderLinksId = 'topAttendanceHeaderLinks';

        function replaceEmployeeManagementTitle() {
        const oldTitles = ['ادارة الموظفين', 'إدارة الموظفين', 'اداره الموظفين', 'إداره الموظفين'];
        document.title = wantedTitle;

        const walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT, {
        acceptNode: function (node) {
        const value = (node.nodeValue || '').trim();

        if (oldTitles.includes(value)) {
        return NodeFilter.FILTER_ACCEPT;
        }

        return NodeFilter.FILTER_REJECT;
        }
        });

        const nodesToReplace = [];
        let currentNode;

        while (currentNode = walker.nextNode()) {
        nodesToReplace.push(currentNode);
        }

        nodesToReplace.forEach(function (node) {
        node.nodeValue = node.nodeValue.replace(/إدارة الموظفين|ادارة الموظفين|إداره الموظفين|اداره الموظفين/g, wantedTitle);
        });
        }

        function createHeaderLink(text, url, id) {
        const link = document.createElement('a');
        if (id) {
        link.id = id;
        }
        link.href = url;
        link.className = 'top-assign-work-times-link';
        link.textContent = text;
        return link;
        }

        function createAssignWorkTimesLink() {
        const container = document.createElement('div');
        container.id = attendanceHeaderLinksId;
        container.className = 'top-attendance-header-links';
        container.appendChild(createHeaderLink(assignWorkTimesText, assignWorkTimesUrl, assignWorkTimesLinkId));
        container.appendChild(createHeaderLink('إضافة موظف', '/Employee/Create'));
        container.appendChild(createHeaderLink('إنشاء مكافآت وخصومات', '/EmployeeTransactions/create'));
        container.appendChild(createHeaderLink('عرض مكافآت وخصومات', '/EmployeeTransactions'));
        return container;
        }

        function isInsideAttendancePageContent(node) {
        return node && node.parentElement && node.parentElement.closest('.attendance-log-full-page');
        }

        function ensureAssignWorkTimesLinkBesideHeaderTitle() {
        const existingLink = document.getElementById(assignWorkTimesLinkId);

        if (existingLink) {
        return;
        }

        const walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT, {
        acceptNode: function (node) {
        const value = (node.nodeValue || '').trim();
        const parent = node.parentElement;

        if (!parent) {
        return NodeFilter.FILTER_REJECT;
        }

        if (parent.closest('script, style, .attendance-log-full-page, #' + assignWorkTimesLinkId)) {
        return NodeFilter.FILTER_REJECT;
        }

        if (isInsideAttendancePageContent(node)) {
        return NodeFilter.FILTER_REJECT;
        }

        return value === wantedTitle
        ? NodeFilter.FILTER_ACCEPT
        : NodeFilter.FILTER_REJECT;
        }
        });

        const titleNode = walker.nextNode();

        if (!titleNode || !titleNode.parentNode) {
        return;
        }

        const headerParent = titleNode.parentElement;

        if (headerParent) {
        headerParent.style.position = 'relative';
        headerParent.style.minHeight = headerParent.style.minHeight || '36px';
        }

        const link = createAssignWorkTimesLink();
        titleNode.parentNode.appendChild(link);
        }

        function applyHeaderTitleUpdates() {
        replaceEmployeeManagementTitle();
        ensureAssignWorkTimesLinkBesideHeaderTitle();
        }

        document.addEventListener('DOMContentLoaded', function () {
        applyHeaderTitleUpdates();
        setTimeout(applyHeaderTitleUpdates, 100);
        setTimeout(applyHeaderTitleUpdates, 500);
        setTimeout(applyHeaderTitleUpdates, 1200);
        });
        })();
    </script>

    <script>
        (function () {
        const filterForm = document.getElementById('attendanceFilterForm');
        const dateInput = document.getElementById('custom-datepicker');
        const startInput = document.getElementById('startDate');
        const endInput = document.getElementById('endDate');
        const autoPeriodInput = document.getElementById('useAutoPeriodInput');
        const pageRoot = document.querySelector('.attendance-log-full-page');
        let submitTimer = null;
        let isRefreshingAttendanceTable = false;

        function disableAutoPeriodBecauseUserSelectedOldRange() {
        if (autoPeriodInput) {
        autoPeriodInput.value = 'false';
        }
        }

        function buildAttendanceFilterUrl() {
        const url = new URL('/EmployeeAttendance/AttendanceLog', window.location.origin);

        if (filterForm) {
        const formData = new FormData(filterForm);

        formData.forEach(function (value, key) {
        const textValue = String(value || '').trim();

        if (textValue !== '') {
        url.searchParams.set(key, textValue);
        }
        });
        }

        return url.toString();
        }

        function updateSelectedEmployeeUiToAll() {
        const hiddenInput = document.getElementById('employeeIdInput');
        const selectedText = document.getElementById('selectedEmployeeText');
        const selectedImage = document.getElementById('selectedEmployeeImage');
        const selectedPlaceholder = document.getElementById('selectedEmployeePlaceholder');

        if (hiddenInput) hiddenInput.value = '';
        if (selectedText) selectedText.innerText = 'كل الموظفين';
        if (selectedImage) {
        selectedImage.removeAttribute('src');
        selectedImage.style.display = 'none';
        }
        if (selectedPlaceholder) selectedPlaceholder.style.display = 'inline-flex';

        document.querySelectorAll('.employee-option').forEach(function (item) {
        item.classList.toggle('active', (item.getAttribute('data-value') || '') === '');
        });
        }

        function loadAttendanceCurrenciesForCurrentRows() {
        const rows = Array.from(document.querySelectorAll('tr.attendance-data-row[data-log-id]'));
        const ids = rows
        .map(function (row) { return row.getAttribute('data-log-id'); })
        .filter(function (id) { return id && id.trim() !== '' && parseInt(id, 10) > 0; });

        if (!ids.length) {
        return;
        }

        fetch('/EmployeeAttendance/GetAttendanceLogCurrencies?ids=' + encodeURIComponent(ids.join(',')), {
        method: 'GET',
        headers: { 'Accept': 'application/json' },
        cache: 'no-store',
        credentials: 'same-origin'
        })
        .then(function (response) { return response.json(); })
        .then(function (result) {
        if (!result || !result.success || !result.currencies) {
        return;
        }

        Object.keys(result.currencies).forEach(function (id) {
        const currency = (result.currencies[id] || '').trim();
        document.querySelectorAll('[data-currency-for="' + id + '"]').forEach(function (span) {
        span.innerText = currency ? '- ' + currency : '';
        });
        });
        })
        .catch(function () { });
        }

        function updateSelectAllAfterTableRefresh() {
        const selectAll = document.getElementById('selectAllAttendanceRecords');
        if (selectAll) {
        selectAll.checked = false;
        selectAll.indeterminate = false;
        }
        }

        async function refreshAttendanceLogTableOnly(url, pushState) {
        if (isRefreshingAttendanceTable) {
        return;
        }

        isRefreshingAttendanceTable = true;

        if (pageRoot) {
        pageRoot.classList.add('is-attendance-table-loading');
        }

        try {
        const response = await fetch(url, {
        method: 'GET',
        headers: { 'X-Requested-With': 'XMLHttpRequest' },
        cache: 'no-store',
        credentials: 'same-origin'
        });

        const html = await response.text();
        const parser = new DOMParser();
        const doc = parser.parseFromString(html, 'text/html');

        const newTbody = doc.querySelector('#attendanceTable tbody');
        const currentTbody = document.querySelector('#attendanceTable tbody');
        if (newTbody && currentTbody) {
        currentTbody.innerHTML = newTbody.innerHTML;
        }

        const newSummary = doc.querySelector('.attendance-summary-grid');
        const currentSummary = document.querySelector('.attendance-summary-grid');
        if (newSummary && currentSummary) {
        currentSummary.innerHTML = newSummary.innerHTML;
        }

        const newCount = doc.querySelector('.attendance-log-count');
        const currentCount = document.querySelector('.attendance-log-count');
        if (newCount && currentCount) {
        currentCount.innerHTML = newCount.innerHTML;
        }

        const newTrashBody = doc.querySelector('#attendanceTrashBody');
        const currentTrashBody = document.querySelector('#attendanceTrashBody');
        if (newTrashBody && currentTrashBody) {
        currentTrashBody.innerHTML = newTrashBody.innerHTML;
        }

        updateSelectAllAfterTableRefresh();
        loadAttendanceCurrenciesForCurrentRows();

        if (pushState !== false) {
        window.history.pushState({}, '', url);
        }
        } catch (error) {
        if (filterForm) {
        filterForm.submit();
        }
        } finally {
        isRefreshingAttendanceTable = false;

        if (pageRoot) {
        pageRoot.classList.remove('is-attendance-table-loading');
        }
        }
        }

        function submitAttendanceFilterForm() {
        if (!filterForm) {
        return;
        }

        if (submitTimer) {
        clearTimeout(submitTimer);
        }

        submitTimer = setTimeout(function () {
        refreshAttendanceLogTableOnly(buildAttendanceFilterUrl(), true);
        }, 80);
        }

        window.submitAttendanceLogFilter = submitAttendanceFilterForm;
        window.refreshAttendanceLogTableOnly = refreshAttendanceLogTableOnly;
        window.loadAttendanceLogCurrencies = loadAttendanceCurrenciesForCurrentRows;

        if (filterForm) {
        filterForm.addEventListener('submit', function (event) {
        event.preventDefault();
        submitAttendanceFilterForm();
        });
        }

        document.addEventListener('click', function (event) {
        const resetLink = event.target.closest('.reset-btn');
        if (!resetLink) {
        return;
        }

        event.preventDefault();

        if (startInput) startInput.value = '';
        if (endInput) endInput.value = '';
        if (autoPeriodInput) autoPeriodInput.value = 'true';
        if (dateInput) dateInput.value = '';
        updateSelectedEmployeeUiToAll();

        refreshAttendanceLogTableOnly('/EmployeeAttendance/AttendanceLog?useAutoPeriod=true', true);
        });

        function initializeAttendanceDateFilter() {
        if (!dateInput) {
        return;
        }

        if (typeof initializeLitepicker === 'function') {
        initializeLitepicker('.custom-datepicker', function () {
        disableAutoPeriodBecauseUserSelectedOldRange();
        submitAttendanceFilterForm();
        });
        return;
        }

        // Fallback: keep the field usable if the shared datepicker script is not loaded.
        dateInput.removeAttribute('readonly');
        dateInput.addEventListener('change', function () {
        disableAutoPeriodBecauseUserSelectedOldRange();
        const value = (dateInput.value || '').trim();
        const parts = value.split(' - ');

        if (parts.length >= 2) {
        if (startInput) startInput.value = parts[0].trim();
        if (endInput) endInput.value = parts[1].trim();
        } else if (parts.length === 1 && parts[0]) {
        if (startInput) startInput.value = parts[0].trim();
        if (endInput) endInput.value = parts[0].trim();
        }

        submitAttendanceFilterForm();
        });
        }

        if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initializeAttendanceDateFilter);
        } else {
        initializeAttendanceDateFilter();
        }

        loadAttendanceCurrenciesForCurrentRows();
        })();
    </script>

    <script>
        (function () {
        const autoPeriodInput = document.getElementById('useAutoPeriodInput');

        if (!autoPeriodInput || String(autoPeriodInput.value).toLowerCase() !== 'true') {
        return;
        }

        function getNextTenAm() {
        const now = new Date();
        const nextTen = new Date(now.getFullYear(), now.getMonth(), now.getDate(), 10, 0, 0, 0);

        if (now >= nextTen) {
        nextTen.setDate(nextTen.getDate() + 1);
        }

        return nextTen;
        }

        function reloadAutoPeriodAtTen() {
        const nextTen = getNextTenAm();
        const delay = Math.max(1000, nextTen.getTime() - Date.now());

        setTimeout(function () {
        const url = new URL(window.location.href);
        url.searchParams.set('useAutoPeriod', 'true');
        url.searchParams.delete('fromDate');
        url.searchParams.delete('toDate');
        window.location.href = url.toString();
        }, delay);
        }

        reloadAutoPeriodAtTen();
        })();
    </script>

    <script>
        (function () {
        const dropdown = document.getElementById('employeeCustomDropdown');
        const button = document.getElementById('selectedEmployeeButton');
        const selectedText = document.getElementById('selectedEmployeeText');
        const selectedImage = document.getElementById('selectedEmployeeImage');
        const selectedPlaceholder = document.getElementById('selectedEmployeePlaceholder');
        const hiddenInput = document.getElementById('employeeIdInput');
        const options = Array.from(document.querySelectorAll('.employee-option'));

        if (!dropdown || !button || !selectedText || !hiddenInput) {
        return;
        }

        function closeDropdown() {
        dropdown.classList.remove('open');
        }

        function toggleDropdown() {
        dropdown.classList.toggle('open');
        }

        button.addEventListener('click', function (event) {
        event.preventDefault();
        event.stopPropagation();
        toggleDropdown();
        });

        button.addEventListener('keydown', function (event) {
        if (event.key === 'Enter' || event.key === ' ') {
        event.preventDefault();
        toggleDropdown();
        }

        if (event.key === 'Escape') {
        closeDropdown();
        }
        });

        options.forEach(function (option) {
        option.addEventListener('click', function (event) {
        event.preventDefault();
        event.stopPropagation();

        const value = option.getAttribute('data-value') || "";
        const text = option.getAttribute('data-text') || "كل الموظفين";
        const image = option.getAttribute('data-image') || "";

        hiddenInput.value = value;
        selectedText.innerText = text;

        if (selectedImage && selectedPlaceholder) {
        if (image) {
        selectedImage.src = image;
        selectedImage.alt = text;
        selectedImage.style.display = 'inline-block';
        selectedPlaceholder.style.display = 'none';
        } else {
        selectedImage.removeAttribute('src');
        selectedImage.alt = text;
        selectedImage.style.display = 'none';
        selectedPlaceholder.style.display = 'inline-flex';
        }
        }

        options.forEach(function (item) {
        item.classList.remove('active');
        });

        option.classList.add('active');

        closeDropdown();

        if (typeof window.submitAttendanceLogFilter === 'function') {
        window.submitAttendanceLogFilter();
        } else {
        const filterForm = document.getElementById('attendanceFilterForm');
        if (filterForm) {
        filterForm.submit();
        }
        }
        });
        });

        document.addEventListener('click', function (event) {
        if (!dropdown.contains(event.target)) {
        closeDropdown();
        }
        });
        })();
    </script>

    <script>
        (function () {
        const imageBackdrop = document.getElementById('attendanceImagePopupBackdrop');
        const imagePopupImg = document.getElementById('attendanceImagePopupImg');
        const imagePopupTitle = document.getElementById('attendanceImagePopupTitle');
        const imagePopupTime = document.getElementById('attendanceImagePopupTime');
        const imagePopupClose = document.getElementById('attendanceImagePopupClose');

        function openImagePopup(imageSrc, imageTitle, imageTime) {
        if (!imageBackdrop || !imagePopupImg || !imagePopupTitle || !imagePopupTime) {
        return;
        }

        imagePopupImg.src = imageSrc || "";
        imagePopupTitle.innerText = imageTitle || "صورة التسجيل";
        imagePopupTime.innerText = imageTime || "";
        imageBackdrop.style.display = "flex";
        }

        function closeImagePopup() {
        if (!imageBackdrop) {
        return;
        }

        imageBackdrop.style.display = "none";

        if (imagePopupImg) {
        imagePopupImg.src = "";
        }
        }

        document.addEventListener('click', function (event) {
        const image = event.target.closest('.attendance-image-click');
        if (!image) {
        return;
        }

        openImagePopup(
        image.getAttribute('data-image-src'),
        image.getAttribute('data-image-title'),
        image.getAttribute('data-image-time')
        );
        });

        if (imagePopupClose) {
        imagePopupClose.addEventListener('click', closeImagePopup);
        }

        if (imageBackdrop) {
        imageBackdrop.addEventListener('click', function (event) {
        if (event.target === imageBackdrop) {
        closeImagePopup();
        }
        });
        }

        document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape') {
        closeImagePopup();
        }
        });
        })();
    </script>

