    <script>
        (function () {
        const tooltip = document.getElementById('attendanceIpCloudTooltip');

        if (!tooltip) {
        return;
        }

        function showIpTooltip(target) {
        const text = target.getAttribute('data-ip-history') || '';

        if (!text.trim()) {
        return;
        }

        tooltip.innerText = text;
        tooltip.style.display = 'block';

        const rect = target.getBoundingClientRect();
        const tipRect = tooltip.getBoundingClientRect();
        let left = rect.left + (rect.width / 2) - (tipRect.width / 2);
        let top = rect.top - tipRect.height - 14;

        if (top < 8) {
        top = rect.bottom + 14;
        }

        if (left < 8) {
        left = 8;
        }

        if (left + tipRect.width > window.innerWidth - 8) {
        left = window.innerWidth - tipRect.width - 8;
        }

        tooltip.style.left = left + 'px';
        tooltip.style.top = top + 'px';
        }

        function hideIpTooltip() {
        tooltip.style.display = 'none';
        tooltip.innerText = '';
        }

        document.addEventListener('mouseover', function (event) {
        const item = event.target.closest('.attendance-ip-hover.has-ip-history');
        if (item) {
        showIpTooltip(item);
        }
        });

        document.addEventListener('mouseout', function (event) {
        const item = event.target.closest('.attendance-ip-hover.has-ip-history');
        if (item) {
        hideIpTooltip();
        }
        });

        document.addEventListener('focusin', function (event) {
        const item = event.target.closest('.attendance-ip-hover.has-ip-history');
        if (item) {
        showIpTooltip(item);
        }
        });

        document.addEventListener('focusout', function (event) {
        const item = event.target.closest('.attendance-ip-hover.has-ip-history');
        if (item) {
        hideIpTooltip();
        }
        });

        window.addEventListener('scroll', hideIpTooltip, true);
        window.addEventListener('resize', hideIpTooltip);
        })();
    </script>

    <script>
        (function () {
