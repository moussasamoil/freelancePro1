                }



            .shift-block-cell {
                min-width: 86px;
                text-align: center;
            }

            .attendance-inline-block-switch {
                margin: 0 auto;
            }

            .shift-block-empty {
                color: #94a3b8;
                font-size: 14px;
                font-weight: 800 !important;
            }

            @@media print {
                @@page {
                    size: A4 landscape;
                    margin: 8mm;
                }

                body * {
                    visibility: hidden !important;
                }

                #printArea,
                #printArea * {
                    visibility: visible !important;
                }

                #printArea {
                    position: absolute;
                    top: 0;
                    right: 0;
                    left: 0;
                    width: 100%;
                    direction: rtl;
                    display: block !important;
                }

                    #printArea table {
                        width: 100% !important;
                    }
            }

            .attendance-log-full-page,
            .attendance-log-full-page * {
                font-weight: 400 !important;
            }
    </style>

    <div class="attendance-log-page">

        <div class="attendance-filter-card">
            <div class="attendance-filter-title">فلترة وسحب الكشف</div>

            <form id="attendanceFilterForm" method="get" asp-controller="EmployeeAttendance" asp-action="AttendanceLog" autocomplete="off">
                <div class="row g-3 align-items-end">
                    <div class="col-12 col-md-6 col-xl-3">
                        <label class="form-label">اسم الموظف</label>

                        <input type="hidden" name="employeeId" id="employeeIdInput" value="@filterEmployeeId" />

                        <div class="employee-custom-dropdown" id="employeeCustomDropdown">
                            <div class="selected-employee" id="selectedEmployeeButton" role="button" tabindex="0">
                                @if (!string.IsNullOrWhiteSpace(selectedEmployeeImage))
                                {
                                    <img src="@selectedEmployeeImage"
                                         id="selectedEmployeeImage"
                                         class="selected-employee-image"
                                         alt="@selectedEmployeeText"
                                         onerror="this.style.display='none'; document.getElementById('selectedEmployeePlaceholder').style.display='inline-flex';" />

                                    <span id="selectedEmployeePlaceholder" class="selected-employee-placeholder" style="display:none;">
                                        <i class="fa-light fa-user"></i>
                                    </span>
                                }
                                else
                                {
                                    <img src=""
                                         id="selectedEmployeeImage"
                                         class="selected-employee-image"
                                         alt="@selectedEmployeeText"
                                         style="display:none;" />

                                    <span id="selectedEmployeePlaceholder" class="selected-employee-placeholder">
                                        <i class="fa-light fa-users"></i>
                                    </span>
                                }
                                <span class="selected-employee-text" id="selectedEmployeeText">@selectedEmployeeText</span>
                                <i class="fa-duotone fa-chevron-down selected-employee-icon"></i>
                            </div>

                            <div class="employee-options-dropdown" id="employeeOptionsDropdown">
                                <div class="employee-option @(string.IsNullOrWhiteSpace(filterEmployeeId) ? "active" : "")"
                                     data-value=""
                                     data-text="كل الموظفين"
                                     data-image="">
                                    <span class="employee-option-placeholder">
                                        <i class="fa-light fa-users"></i>
                                    </span>
                                    <span class="employee-option-name">كل الموظفين</span>
                                </div>

                                @if (employees != null && employees.Any())
                                {
                                    foreach (var employee in employees)
                                    {
                                        var employeeImage = employee.Group?.Name ?? "";
                                        var activeClass = employee.Value == filterEmployeeId ? "active" : "";

                                        <div class="employee-option @activeClass"
                                             data-value="@employee.Value"
                                             data-text="@employee.Text"
                                             data-image="@employeeImage">
                                            @if (!string.IsNullOrWhiteSpace(employeeImage))
                                            {
                                                <img src="@employeeImage"
                                                     class="employee-option-image"
                                                     alt="@employee.Text"
                                                     onerror="this.style.display='none'; this.nextElementSibling.style.display='inline-flex';" />

                                                <span class="employee-option-placeholder" style="display:none;">
                                                    <i class="fa-light fa-user"></i>
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="employee-option-placeholder">
                                                    <i class="fa-light fa-user"></i>
                                                </span>
                                            }

                                            <span class="employee-option-name">@employee.Text</span>
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-md-6 col-xl-3">
                        <label class="form-label">مدة التاريخ</label>
                        <input type="hidden" name="fromDate" id="startDate" value="@filterFromDate" />
                        <input type="hidden" name="toDate" id="endDate" value="@filterToDate" />
                        <input type="hidden" name="useAutoPeriod" id="useAutoPeriodInput" value="@(isAutoPeriodFilter ? "true" : "false")" />
                        <input id="custom-datepicker"
                               class="form-control attendance-filter-input custom-datepicker attendance-date-range-input"
                               placeholder="فلتر حسب التاريخ"
                               value="@attendanceDateRangeText"
                               readonly />
                    </div>

                    <div class="col-12 col-md-6 col-xl-3 d-flex gap-2 flex-wrap">
                        <a href="/EmployeeAttendance/AttendanceLog" class="reset-btn">إلغاء الفلتر</a>
                        <button type="button" id="printSelectedRecordsBtn" class="print-selected-btn">سحب الكشف</button>
                    </div>
                </div>
            </form>
        </div>

        <form id="shiftBlockAntiForgeryForm" method="post" style="display:none;">
            @Html.AntiForgeryToken()
        </form>

        <div id="shiftBlockMessage" class="shift-block-message"></div>

        <div class="attendance-summary-grid">
            <div class="attendance-summary-card attendance-summary-present">
                <span class="attendance-summary-label">حاضر</span>
                <span class="attendance-summary-count">@presentCount</span>
            </div>
            <div class="attendance-summary-card attendance-summary-absent">
                <span class="attendance-summary-label">غائب</span>
                <span class="attendance-summary-count">@absentCount</span>
            </div>
            <div class="attendance-summary-card attendance-summary-late">
                <span class="attendance-summary-label">متأخر</span>
                <span class="attendance-summary-count">@lateCount</span>
            </div>
            <div class="attendance-summary-card attendance-summary-disciplined">
                <span class="attendance-summary-label">منضبط</span>
                <span class="attendance-summary-count">@disciplinedCount</span>
            </div>
            <button type="button" id="attendanceTrashBtn" class="attendance-summary-card attendance-summary-trash">
                <span class="attendance-summary-label">سلة محذوفات</span>
                <span class="attendance-summary-count">🗑</span>
            </button>
        </div>

        <div class="attendance-log-card">
            <div class="attendance-log-header">
                <span>سجلات اوقات دوام الموظفين</span>
                <span class="attendance-log-count">
                    عدد السجلات: @(attendanceLogs?.Count ?? 0)
                </span>
            </div>

            <div class="table-responsive">
                <table id="attendanceTable" class="table attendance-table">
                    <thead>
                        <tr>
                            <th>
                                <input type="checkbox"
                                       id="selectAllAttendanceRecords"
                                       class="record-select-checkbox"
                                       title="تحديد كل السجلات" />
                            </th>
                            <th>صورة الدخول</th>
                            <th>صورة الخروج</th>
                            <th>اسم الموظف</th>
                            <th>التاريخ</th>
                            <th>وقت الدخول</th>
                            <th>وقت الخروج</th>
                            <th>بداية الشيفت</th>
                            <th>نهاية الشيفت</th>
                            <th>حالة الحضور</th>
                            <th>بلوك</th>
                            <th>خصم اليوم</th>
                            <th>سلف اليوم</th>
                            <th>مكافآت اليوم</th>
                            <th>سبب الخصم / التأخير</th>
                            <th>IP / الموقع</th>
                            <th>الإجراءات</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (attendanceLogs != null && attendanceLogs.Any())
                        {
                            foreach (var item in attendanceLogs)
                            {
                                var isAutoAbsentRow = item.IsSyntheticAbsentRow;
                                var hasCheckInImage = !string.IsNullOrWhiteSpace(item.FaceImagePath);
                                var hasCheckOutImage = !string.IsNullOrWhiteSpace(item.CheckOutFaceImagePath);

                                var checkInImagePath = !hasCheckInImage
                                ? "/static/circle-user-solid.svg"
                                : item.FaceImagePath;

                                var checkOutImagePath = !hasCheckOutImage
                                ? "/static/circle-user-solid.svg"
                                : item.CheckOutFaceImagePath;

                                var ipTextClass = item.IsCheckInIpChanged ? "attendance-ip-changed" : "";
                                var ipHistoryTitle = item.CheckInIpHistoryTooltip ?? "";
                                var ipHoverClass = string.IsNullOrWhiteSpace(ipHistoryTitle) ? "attendance-ip-hover" : "attendance-ip-hover has-ip-history";

                                var statusClass = item.IsAbsent
                                ? "status-absent"
                                : item.LateMinutes == null
                                ? "status-no-shift"
                                : item.LateMinutes > 0
                                ? "status-late"
                                : "status-present";

                                var statusText = item.IsAbsent
                                ? "غائب"
                                : item.LateMinutes == null
                                ? "بدون شيفت"
                                : item.LateMinutes > 0
                                ? "متأخر"
                                : "منضبط";

                                var attendanceDateText = item.CheckInAt.ToString("yyyy/MM/dd");

                                // Display times with Arabic AM/PM suffix (ص / م), while keeping raw 24h values for edit inputs.
                                // لو الإدارة مسحت وقت الدخول أو صورة الدخول، نخلي وقت الدخول فاضي لحد ما الموظف يصور دخول مرة تانية.
                                var rawCheckInTimeText = isAutoAbsentRow || !hasCheckInImage ? "" : item.CheckInAt.ToString("HH:mm");
                                var rawCheckOutTimeText = item.CheckOutAt.HasValue && hasCheckOutImage
                                ? item.CheckOutAt.Value.ToString("HH:mm")
                                : "";

                                var checkInTimeText = isAutoAbsentRow || !hasCheckInImage ? "-" : FormatArabicAmPm(item.CheckInAt);
                                var checkOutTimeText = item.CheckOutAt.HasValue && hasCheckOutImage
                                ? FormatArabicAmPm(item.CheckOutAt.Value)
                                : "-";

                                var checkInFullTimeText = isAutoAbsentRow || !hasCheckInImage ? "-" : FormatArabicAmPmFull(item.CheckInAt);
                                var checkOutFullTimeText = item.CheckOutAt.HasValue && hasCheckOutImage
                                ? FormatArabicAmPmFull(item.CheckOutAt.Value)
                                : "-";

                                var shiftStartDisplayText = FormatArabicAmPmFromText(item.ShiftStartTimeText);
                                var shiftEndDisplayText = FormatArabicAmPmFromText(item.ShiftEndTimeText);

                                var isLateRow = !item.IsAbsent && item.LateMinutes.HasValue && item.LateMinutes.Value > 0;
                                var isDisciplinedRow = !item.IsAbsent && item.LateMinutes.HasValue && item.LateMinutes.Value == 0;
                                var attendanceDateClass = isLateRow ? "attendance-time-late" : "";
                                var checkInTimeClass = isLateRow ? "attendance-time-late" : (isDisciplinedRow ? "attendance-time-disciplined" : "");
                                var checkOutTimeClass = isLateRow ? "attendance-time-late" : (isDisciplinedRow && item.CheckOutAt.HasValue ? "attendance-time-disciplined" : "");

                                var dailyDeductionText = transactionDeductionAmountMap.ContainsKey(item.Id)
                                ? transactionDeductionAmountMap[item.Id]
                                : "0.00";

                                var advanceAmountText = advanceAmountMap.ContainsKey(item.Id)
                                ? advanceAmountMap[item.Id]
                                : "0.00";

                                var bonusAmountText = bonusAmountMap.ContainsKey(item.Id)
                                ? bonusAmountMap[item.Id]
                                : "0.00";

                                var currencyText = attendanceCurrencyMap.ContainsKey(item.Id)
                                ? attendanceCurrencyMap[item.Id]
                                : "";

                                var editReasonText = string.IsNullOrWhiteSpace(item.SuggestedLateReason)
                                ? (string.IsNullOrWhiteSpace(item.LateReason) ? "" : item.LateReason)
                                : item.SuggestedLateReason;

                                var editDeductionText = item.SuggestedDeductionAmount.ToString("0.00");

                                var checkInEditTimeText = isAutoAbsentRow && !string.IsNullOrWhiteSpace(item.ShiftStartTimeText) && item.ShiftStartTimeText != "-"
                                ? item.ShiftStartTimeText
                                : rawCheckInTimeText;
                                var checkOutEditTimeText = item.CheckOutAt.HasValue && hasCheckOutImage
                                ? item.CheckOutAt.Value.ToString("HH:mm")
                                : "";
                                var shiftBlockRowForEmployee = shiftBlockRows == null
                                ? null
                                : shiftBlockRows.FirstOrDefault(s =>
                                    (s.EmployeeName ?? "").Trim() == (item.EmployeeName ?? "").Trim());
                                <tr class="attendance-data-row"
                                    data-log-id="@item.Id"
                                    data-is-auto-absent="@(isAutoAbsentRow ? "true" : "false")"
                                    data-check-in-time="@checkInEditTimeText"
                                    data-check-out-time="@checkOutEditTimeText"
                                    data-deduction-amount="@editDeductionText"
                                    data-current-deduction-amount="@dailyDeductionText"
                                    data-advance-amount="@advanceAmountText"
                                    data-bonus-amount="@bonusAmountText"
                                    data-shift-start="@item.ShiftStartTimeText"
                                    data-shift-end="@item.ShiftEndTimeText"
                                    data-late-reason="@editReasonText">
                                    <td>
                                        @if (!isAutoAbsentRow)
                                        {
                                            <input type="checkbox" class="record-select-checkbox" value="@item.Id" />
                                        }
                                        else
                                        {
                                            <span class="shift-block-empty">-</span>
                                        }
                                    </td>

                                    <td>
                                        @if (!isAutoAbsentRow)
                                        {
                                            <img src="@checkInImagePath"
                                                 class="employee-photo attendance-image-click"
                                                 alt="صورة الدخول"
                                                 data-image-src="@checkInImagePath"
                                                 data-image-title="صورة تسجيل الدخول"
                                                 data-image-time="وقت تسجيل الدخول: @checkInFullTimeText" />
                                        }
                                        else
                                        {
                                            <span class="shift-block-empty">-</span>
                                        }
                                    </td>

                                    <td>
                                        @if (!isAutoAbsentRow)
                                        {
                                            <img src="@checkOutImagePath"
                                                 class="employee-photo attendance-image-click"
                                                 alt="صورة الخروج"
                                                 data-image-src="@checkOutImagePath"
                                                 data-image-title="صورة تسجيل الخروج"
                                                 data-image-time="وقت تسجيل الخروج: @checkOutFullTimeText" />
                                        }
                                        else
                                        {
                                            <span class="shift-block-empty">-</span>
                                        }
                                    </td>

                                    <td class="employee-cell">
                                        <span class="employee-name">
                                            @(string.IsNullOrWhiteSpace(item.EmployeeName) ? "بدون اسم" : item.EmployeeName)
                                        </span>
                                    </td>

                                    <td class="date-cell @attendanceDateClass">@attendanceDateText</td>
                                    <td class="time-cell @checkInTimeClass">@checkInTimeText</td>
                                    <td class="time-cell @checkOutTimeClass">@checkOutTimeText</td>
                                    <td class="shift-cell">@shiftStartDisplayText</td>
                                    <td class="shift-cell">@shiftEndDisplayText</td>

                                    <td class="status-cell">
                                        <span class="status-pill @statusClass">
                                            @statusText
                                        </span>
                                    </td>

                                    <td class="shift-block-cell">
                                        @if (shiftBlockRowForEmployee != null)
                                        {
                                            <label class="shift-block-switch attendance-inline-block-switch"
                                                   title="الأخضر يعني غير بلوك، والرصاصي يعني الموظف متبلك">
                                                <input type="checkbox"
                                                       class="shift-block-toggle"
                                                       data-shift-id="@shiftBlockRowForEmployee.ShiftId"
                                                @(shiftBlockRowForEmployee.IsLoginBlocked ? "checked" : "") />
                                                <span class="shift-block-slider"></span>
                                            </label>
                                        }
                                        else
                                        {
                                            <span class="shift-block-empty">-</span>
                                        }
                                    </td>

                                    <td class="deduction-cell">
                                        <span class="attendance-money-with-currency">
                                            <span>@dailyDeductionText</span>
                                            <span class="attendance-currency-text" data-currency-for="@item.Id">@(string.IsNullOrWhiteSpace(currencyText) ? "" : "- " + currencyText)</span>
                                        </span>
                                    </td>

                                    <td class="advance-cell">
                                        <span class="attendance-money-with-currency">
                                            <span>@advanceAmountText</span>
                                            <span class="attendance-currency-text" data-currency-for="@item.Id">@(string.IsNullOrWhiteSpace(currencyText) ? "" : "- " + currencyText)</span>
                                        </span>
                                    </td>

                                    <td class="bonus-cell">
                                        <span class="attendance-money-with-currency">
                                            <span>@bonusAmountText</span>
                                            <span class="attendance-currency-text" data-currency-for="@item.Id">@(string.IsNullOrWhiteSpace(currencyText) ? "" : "- " + currencyText)</span>
                                        </span>
                                    </td>

                                    <td class="reason-cell">
                                        @(string.IsNullOrWhiteSpace(item.LateReason) ? "-" : item.LateReason)
                                    </td>

                                    <td class="ip-location-cell">
                                        <div class="ip-location-box">
                                            <div class="ip-location-line">
                                                <span class="ip-location-label">IP:</span>
                                                <span dir="ltr" class="@ipHoverClass @ipTextClass" data-ip-history="@ipHistoryTitle">@(string.IsNullOrWhiteSpace(item.CheckInIpAddress) ? "-" : item.CheckInIpAddress)</span>
                                            </div>
                                            <div class="ip-location-line">
                                                <span class="ip-location-label">الموقع:</span>
                                                <span>@(string.IsNullOrWhiteSpace(item.CheckInLocation) ? "-" : item.CheckInLocation)</span>
                                            </div>
                                        </div>
                                    </td>

                                    <td class="attendance-actions-cell">
                                        <div class="attendance-row-actions">
                                            <button type="button" class="attendance-print-row-btn" data-log-id="@item.Id">سجل حركة</button>
                                            <button type="button" class="attendance-edit-row-btn">تعديل</button>
                                            <button type="button" class="attendance-delete-row-btn" data-log-id="@item.Id">حذف</button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="17" class="empty-row">
                                    لا توجد سجلات حضور حتى الآن
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div id="attendanceSelectionAlert" class="attendance-alert-backdrop">
        <div class="attendance-alert-box">
            <div class="attendance-alert-body">
                <div class="attendance-alert-icon">!</div>
                <div class="attendance-alert-title">تنبيه</div>
                <div id="attendanceSelectionAlertMessage" class="attendance-alert-message">
                    يجب اختيار سجل واحد على الأقل
                </div>
            </div>

            <div class="attendance-alert-footer">
                <button type="button" id="attendanceSelectionAlertConfirm" class="attendance-alert-confirm">
                    تأكيد
                </button>
            </div>
        </div>
    </div>

    <div id="attendanceImagePopupBackdrop" class="attendance-image-popup-backdrop">
        <div class="attendance-image-popup">
            <div class="attendance-image-popup-header">
                <span id="attendanceImagePopupTitle">صورة التسجيل</span>
                <button type="button" id="attendanceImagePopupClose" class="attendance-image-popup-close">×</button>
            </div>

            <div class="attendance-image-popup-body">
                <img id="attendanceImagePopupImg" src="" alt="صورة التسجيل" class="attendance-image-popup-img" />
                <div id="attendanceImagePopupTime" class="attendance-image-popup-time"></div>
            </div>
        </div>
    </div>

    <form id="attendanceRowAntiForgeryForm" method="post" style="display:none;">
        @Html.AntiForgeryToken()
    </form>

    <div id="attendanceEditPopupBackdrop" class="attendance-edit-popup-backdrop">
        <div class="attendance-edit-popup">
            <div class="attendance-edit-popup-header">
                <div class="attendance-edit-header-main">
                    <span>تعديل سجل الدوام</span>
                    <button type="button" id="attendanceEditHistoryToggle" class="attendance-edit-history-toggle-btn" aria-expanded="false">
                        سجل التعديلات
                    </button>
                </div>
                <button type="button" id="attendanceEditPopupClose" class="attendance-edit-popup-close">×</button>
            </div>

            <div class="attendance-edit-popup-body">
                <input type="hidden" id="attendanceEditLogId" />

                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <label class="attendance-edit-label">وقت الدخول</label>
                        <div class="attendance-edit-time-control">
                            <input type="time" id="attendanceEditCheckInTime" class="attendance-edit-input" />
                            <button type="button" class="attendance-clear-time-btn" data-clear-time-target="attendanceEditCheckInTime">مسح</button>
                        </div>
                        <div class="attendance-edit-clear-note">عند مسح وقت الدخول سيتم طلب صورة دخول من الموظف مرة أخرى.</div>
                    </div>

                    <div class="col-12 col-md-6">
                        <label class="attendance-edit-label">وقت الخروج</label>
                        <div class="attendance-edit-time-control">
                            <input type="time" id="attendanceEditCheckOutTime" class="attendance-edit-input" />
                            <button type="button" class="attendance-clear-time-btn" data-clear-time-target="attendanceEditCheckOutTime">مسح</button>
                        </div>
                        <div class="attendance-edit-clear-note">عند مسح وقت الخروج سيتم طلب صورة خروج من الموظف مرة أخرى.</div>
                    </div>

                    <div class="col-12 col-md-6">
                        <label class="attendance-edit-label">الخصم</label>
                        <input type="number" step="0.01" min="0" id="attendanceEditDeductionAmount" class="attendance-edit-input" />
                    </div>

                    <div class="col-12 col-md-6">
                        <label class="attendance-edit-label">السلف</label>
                        <input type="number" step="0.01" min="0" id="attendanceEditAdvanceAmount" class="attendance-edit-input" />
                    </div>

                    <div class="col-12 col-md-6">
                        <label class="attendance-edit-label">المكافأة</label>
                        <input type="number" step="0.01" min="0" id="attendanceEditBonusAmount" class="attendance-edit-input" />
                    </div>

                    <div class="col-12">
                        <label class="attendance-edit-label">السبب</label>
                        <textarea id="attendanceEditLateReason" class="attendance-edit-input"></textarea>
                    </div>
                </div>

                <div id="attendanceEditShiftInfo" class="attendance-edit-shift-info">
                    <div class="attendance-edit-shift-time-edit">
                        <label class="attendance-edit-label mb-0">بداية الدوام لهذا اليوم فقط</label>
                        <input type="time" id="attendanceEditShiftStartTime" class="attendance-edit-input attendance-edit-shift-time-input" />
                    </div>
                    <div class="attendance-edit-shift-time-edit">
                        <label class="attendance-edit-label mb-0">نهاية الدوام لهذا اليوم فقط</label>
                        <input type="time" id="attendanceEditShiftEndTime" class="attendance-edit-input attendance-edit-shift-time-input" />
                    </div>
                    <span class="attendance-edit-shift-note">تعديل الدوام هنا يؤثر على هذا السجل / اليوم فقط، ولا يغير شيفت الموظف الأساسي.</span>
                    <span style="display:none;">بداية الدوام: <strong id="attendanceEditShiftStart">-</strong></span>
                    <span style="display:none;">نهاية الدوام: <strong id="attendanceEditShiftEnd">-</strong></span>
