@using System.Collections.Generic
@using System.Linq
@using System.Globalization
@using Microsoft.AspNetCore.Mvc.Rendering
@using Crm_LotusBlue.Controllers
@{
    ViewData["Title"] = "إدارة تسجيل الدوام";
    ViewBag.Title = "إدارة تسجيل الدوام";
    ViewBag.PageTitle = "إدارة تسجيل الدوام";
    ViewBag.HeaderTitle = "إدارة تسجيل الدوام";

    var attendanceLogs = ViewBag.AttendanceLogs as List<EmployeeAttendanceLogRow>;
    var shiftBlockRows = ViewBag.EmployeeShiftBlockRows as List<EmployeeShiftBlockRow>;
    var employees = ViewBag.Employees as List<SelectListItem>;
    var filterEmployeeId = ViewBag.FilterEmployeeId?.ToString() ?? "";
    var filterFromDate = ViewBag.FilterFromDate as string ?? "";
    var filterToDate = ViewBag.FilterToDate as string ?? "";
    var transactionDeductionAmountMap = ViewBag.TransactionDeductionAmountMap as Dictionary<int, string> ?? new Dictionary<int, string>();
    var advanceAmountMap = ViewBag.AdvanceAmountMap as Dictionary<int, string> ?? new Dictionary<int, string>();
    var bonusAmountMap = ViewBag.BonusAmountMap as Dictionary<int, string> ?? new Dictionary<int, string>();
    var attendanceCurrencyMap = ViewBag.AttendanceCurrencyMap as Dictionary<int, string> ?? new Dictionary<int, string>();
    var presentCount = ViewBag.PresentCount as int? ?? 0;
    var absentCount = ViewBag.AbsentCount as int? ?? 0;
    var lateCount = ViewBag.LateCount as int? ?? 0;
    var disciplinedCount = ViewBag.DisciplinedCount as int? ?? 0;
    var selectedEmployeeText = "كل الموظفين";
    var selectedEmployeeImage = "";
    var isAutoPeriodFilter = ViewBag.IsAutoPeriodFilter is bool autoPeriodValue && autoPeriodValue;
    var attendanceDateRangeText = "";

    if (!string.IsNullOrWhiteSpace(filterFromDate) && !string.IsNullOrWhiteSpace(filterToDate))
    {
        attendanceDateRangeText = $"{filterFromDate} - {filterToDate}";
    }
    else if (!string.IsNullOrWhiteSpace(filterFromDate))
    {
        attendanceDateRangeText = filterFromDate;
    }
    else if (!string.IsNullOrWhiteSpace(filterToDate))
    {
        attendanceDateRangeText = filterToDate;
    }

    if (employees != null && !string.IsNullOrWhiteSpace(filterEmployeeId))
    {
        var selectedEmployee = employees.FirstOrDefault(e => e.Value == filterEmployeeId);

        if (selectedEmployee != null)
        {
            selectedEmployeeText = selectedEmployee.Text;
            selectedEmployeeImage = selectedEmployee.Group?.Name ?? "";
        }
    }
    if (attendanceLogs != null)
    {
        presentCount = attendanceLogs.Count(x => !x.IsAbsent && x.LateMinutes.HasValue);
        absentCount = attendanceLogs.Count(x => x.IsAbsent);
        lateCount = attendanceLogs.Count(x => !x.IsAbsent && x.LateMinutes.HasValue && x.LateMinutes.Value > 0);
        disciplinedCount = attendanceLogs.Count(x => !x.IsAbsent && x.LateMinutes.HasValue && x.LateMinutes.Value == 0);
    }
}


@functions {
    private static string FormatArabicAmPm(DateTime value)
    {
        return value.ToString("hh:mm", CultureInfo.InvariantCulture) + " " + (value.Hour < 12 ? "ص" : "م");
    }

    private static string FormatArabicAmPmFull(DateTime value)
    {
        return value.ToString("yyyy/MM/dd hh:mm", CultureInfo.InvariantCulture) + " " + (value.Hour < 12 ? "ص" : "م");
    }

    private static string FormatArabicAmPmFromText(string? timeText)
    {
        if (string.IsNullOrWhiteSpace(timeText))
        {
            return "-";
        }

        var cleanTimeText = timeText.Trim();

        if (cleanTimeText == "-" || cleanTimeText.Contains("ص") || cleanTimeText.Contains("م"))
        {
            return cleanTimeText;
        }

        if (TimeSpan.TryParse(cleanTimeText, out var timeValue))
        {
            var dateTime = DateTime.Today.Add(timeValue);
            return dateTime.ToString("hh:mm", CultureInfo.InvariantCulture) + " " + (timeValue.Hours < 12 ? "ص" : "م");
        }

        return cleanTimeText;
    }
}

