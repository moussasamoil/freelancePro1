        setTimeout(function () {
        selectionAlert.style.display = 'none';
        }, 2500);
        }

        function hideAttendanceEditHistoryBlock() {
        if (historyBlock) {
        historyBlock.classList.remove('is-visible');
        }
        if (historyToggle) {
        historyToggle.classList.remove('is-active');
        historyToggle.setAttribute('aria-expanded', 'false');
        }
        }

        function toggleAttendanceEditHistoryBlock() {
        if (!historyBlock || !historyToggle) {
        return;
        }

        const willShow = !historyBlock.classList.contains('is-visible');
        historyBlock.classList.toggle('is-visible', willShow);
        historyToggle.classList.toggle('is-active', willShow);
        historyToggle.setAttribute('aria-expanded', willShow ? 'true' : 'false');
        }

        if (historyToggle) {
        historyToggle.addEventListener('click', function (event) {
        event.preventDefault();
        toggleAttendanceEditHistoryBlock();
        });
        }


        document.addEventListener('click', function (event) {
        const clearButton = event.target.closest('.attendance-clear-time-btn[data-clear-time-target]');
        if (!clearButton) {
        return;
        }

        event.preventDefault();
        const targetId = clearButton.getAttribute('data-clear-time-target') || '';
        const targetInput = document.getElementById(targetId);
        if (targetInput) {
        targetInput.value = '';
        targetInput.dispatchEvent(new Event('input', { bubbles: true }));
        targetInput.dispatchEvent(new Event('change', { bubbles: true }));
        }
        });

        function escapeAttendanceEditHistoryHtml(value) {
        return String(value || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
        }

        function setAttendanceEditHistoryLoading() {
        if (historyCount) {
        historyCount.innerText = '0';
        }

        if (historyList) {
        historyList.innerHTML = '<div class="attendance-edit-history-loading">جاري تحميل سجل التعديلات...</div>';
        }
        }

        function renderAttendanceEditHistory(items, totalCount) {
        if (historyCount) {
        historyCount.innerText = String(totalCount || 0);
        }

        if (!historyList) {
        return;
        }

        if (!items || !items.length) {
        historyList.innerHTML = '<div class="attendance-edit-history-empty">لا يوجد سجل تعديلات حتى الآن</div>';
        return;
        }

        historyList.innerHTML = items.map(function (item) {
        const changes = (item.changes || []).map(function (change) {
        return '<div class="attendance-edit-history-change">' +
        '<span class="attendance-edit-history-field">' + escapeAttendanceEditHistoryHtml(change.fieldName) + '</span>' +
        '<span class="attendance-edit-history-old">' + escapeAttendanceEditHistoryHtml(change.oldValue) + '</span>' +
        '<span class="attendance-edit-history-arrow">بعد</span>' +
        '<span class="attendance-edit-history-new">' + escapeAttendanceEditHistoryHtml(change.newValue) + '</span>' +
        '</div>';
        }).join('');

        return '<div class="attendance-edit-history-item">' +
        '<div class="attendance-edit-history-top">' +
        '<div class="attendance-edit-history-user"><div>' + escapeAttendanceEditHistoryHtml(item.editorName) + '</div><div class="attendance-edit-history-meta">' + escapeAttendanceEditHistoryHtml(item.changesCount) + ' تعديلات</div><div class="attendance-edit-history-meta">الدوام: ' + escapeAttendanceEditHistoryHtml(item.shiftStart) + ' - ' + escapeAttendanceEditHistoryHtml(item.shiftEnd) + '</div></div>' +
        '<div class="attendance-edit-history-time"><div>' + escapeAttendanceEditHistoryHtml(item.time) + '</div><div class="attendance-edit-history-date">' + escapeAttendanceEditHistoryHtml(item.date) + '</div></div>' +
        '</div>' + changes + '</div>';
        }).join('');
        }

        async function loadAttendanceEditHistory(logId) {
        setAttendanceEditHistoryLoading();

        if (!logId) {
        renderAttendanceEditHistory([], 0);
        return;
        }

        try {
        const response = await fetch('/EmployeeAttendance/AttendanceEditHistory?id=' + encodeURIComponent(logId), {
        method: 'GET',
        headers: { 'Accept': 'application/json' },
        cache: 'no-store'
        });

        const result = await response.json();

        if (result && result.success) {
        if (shiftStartText && result.shiftStart) {
        shiftStartText.innerText = result.shiftStart;
        }
        if (shiftStartInput && result.shiftStart) {
        shiftStartInput.value = result.shiftStart === '-' ? '' : result.shiftStart;
        }
        if (shiftEndText && result.shiftEnd) {
        shiftEndText.innerText = result.shiftEnd;
        }
        if (shiftEndInput && result.shiftEnd) {
        shiftEndInput.value = result.shiftEnd === '-' ? '' : result.shiftEnd;
        }
        renderAttendanceEditHistory(result.items || [], result.totalCount || 0);
        return;
        }

        renderAttendanceEditHistory([], 0);
        } catch (error) {
        if (historyList) {
        historyList.innerHTML = '<div class="attendance-edit-history-empty">تعذر تحميل سجل التعديلات</div>';
        }
        }
        }

        function openEditPopup(row) {
        if (!row || !editBackdrop) {
        return;
        }

        idInput.value = row.getAttribute('data-log-id') || '';
        checkInInput.value = row.getAttribute('data-check-in-time') || '';
        checkOutInput.value = row.getAttribute('data-check-out-time') || '';
        deductionInput.value = String(row.getAttribute('data-deduction-amount') || '0.00').replace(/,/g, '');
        advanceInput.value = String(row.getAttribute('data-advance-amount') || '0.00').replace(/,/g, '');
        if (bonusInput) {
        bonusInput.value = String(row.getAttribute('data-bonus-amount') || '0.00').replace(/,/g, '');
        }
        reasonInput.value = row.getAttribute('data-late-reason') || '';

        var rowShiftStart = row.getAttribute('data-shift-start') || '';
        var rowShiftEnd = row.getAttribute('data-shift-end') || '';

        if (shiftStartText) {
        shiftStartText.innerText = rowShiftStart || '-';
        }

        if (shiftEndText) {
        shiftEndText.innerText = rowShiftEnd || '-';
        }

        if (shiftStartInput) {
        shiftStartInput.value = rowShiftStart === '-' ? '' : rowShiftStart;
        }

        if (shiftEndInput) {
        shiftEndInput.value = rowShiftEnd === '-' ? '' : rowShiftEnd;
        }

        hideAttendanceEditHistoryBlock();
        loadAttendanceEditHistory(idInput.value);

        editBackdrop.style.display = 'flex';
        }

        function closeEditPopup() {
        if (editBackdrop) {
        editBackdrop.style.display = 'none';
        }
        }

        document.addEventListener('click', function (event) {
        const button = event.target.closest('.attendance-edit-row-btn');
        if (!button) {
        return;
        }

        event.preventDefault();
        openEditPopup(button.closest('tr.attendance-data-row'));
        });

        const deleteConfirmBackdrop = document.getElementById('attendanceDeleteConfirmBackdrop');
        const confirmDeleteBtn = document.getElementById('attendanceConfirmDeleteBtn');
        const cancelDeleteBtn = document.getElementById('attendanceCancelDeleteBtn');
        const successStatusBackdrop = document.getElementById('attendanceSuccessStatusBackdrop');
        const successStatusTitle = document.getElementById('attendanceSuccessStatusTitle');
        let pendingDeleteButton = null;
        let pendingDeleteLogId = '';

        function showSuccessStatus(message) {
        if (!successStatusBackdrop || !successStatusTitle) {
        showMessage(message);
        return;
        }

        successStatusTitle.innerText = message;
        successStatusBackdrop.style.display = 'flex';

        setTimeout(function () {
        successStatusBackdrop.style.display = 'none';
        }, 1200);
        }

        function openDeleteConfirmPopup(button) {
        const logId = button.getAttribute('data-log-id') || '';

        if (!logId) {
        showMessage('لم يتم العثور على رقم السجل');
        return;
        }

        pendingDeleteButton = button;
        pendingDeleteLogId = logId;

        if (deleteConfirmBackdrop) {
        deleteConfirmBackdrop.style.display = 'flex';
        }
        }

        function closeDeleteConfirmPopup() {
        if (deleteConfirmBackdrop) {
        deleteConfirmBackdrop.style.display = 'none';
        }

        pendingDeleteButton = null;
        pendingDeleteLogId = '';

        if (confirmDeleteBtn) {
        confirmDeleteBtn.disabled = false;
        confirmDeleteBtn.innerText = 'تأكيد';
        }
        }

        document.addEventListener('click', function (event) {
        const button = event.target.closest('.attendance-delete-row-btn');
        if (!button) {
        return;
        }

        event.preventDefault();
        openDeleteConfirmPopup(button);
        });

        if (cancelDeleteBtn) {
        cancelDeleteBtn.addEventListener('click', closeDeleteConfirmPopup);
        }

        if (deleteConfirmBackdrop) {
        deleteConfirmBackdrop.addEventListener('click', function (event) {
        if (event.target === deleteConfirmBackdrop) {
        closeDeleteConfirmPopup();
        }
        });
        }

        if (confirmDeleteBtn) {
        confirmDeleteBtn.addEventListener('click', async function () {
        if (!pendingDeleteLogId || !pendingDeleteButton) {
        showMessage('لم يتم العثور على رقم السجل');
        closeDeleteConfirmPopup();
        return;
        }

        confirmDeleteBtn.disabled = true;
        confirmDeleteBtn.innerText = 'جاري الحذف...';
        pendingDeleteButton.disabled = true;

        try {
        const response = await fetch('/EmployeeAttendance/DeleteAttendanceLogRow', {
        method: 'POST',
        headers: {
        'Content-Type': 'application/json',
        'RequestVerificationToken': getAntiForgeryToken()
        },
        body: JSON.stringify({ id: parseInt(pendingDeleteLogId, 10) })
        });

        const result = await response.json();

        if (result && result.success) {
        const row = pendingDeleteButton.closest('tr.attendance-data-row');
        if (row) {
        row.remove();
        }

        closeDeleteConfirmPopup();
        showSuccessStatus(result.message || 'تم النقل لسلة المحذوفات');
        setTimeout(function () { window.refreshAttendanceLogTableOnly ? window.refreshAttendanceLogTableOnly(window.location.href, false) : window.location.reload(); }, 900);
        return;
        }

        pendingDeleteButton.disabled = false;
        confirmDeleteBtn.disabled = false;
        confirmDeleteBtn.innerText = 'تأكيد';
        showMessage(result && result.message ? result.message : 'تعذر حذف السجل');
        } catch (error) {
        pendingDeleteButton.disabled = false;
        confirmDeleteBtn.disabled = false;
        confirmDeleteBtn.innerText = 'تأكيد';
        showMessage('حدث خطأ أثناء حذف السجل');
        }
        });
        }

        if (editClose) {
        editClose.addEventListener('click', closeEditPopup);
        }

        if (cancelBtn) {
        cancelBtn.addEventListener('click', closeEditPopup);
        }

        if (editBackdrop) {
        editBackdrop.addEventListener('click', function (event) {
        if (event.target === editBackdrop) {
        closeEditPopup();
        }
        });
        }

        if (saveBtn) {
        saveBtn.addEventListener('click', async function () {
        const payload = {
        id: parseInt(idInput.value || '0', 10),
        checkInTime: checkInInput.value || '',
        checkOutTime: checkOutInput.value || '',
        clearCheckInTime: !checkInInput.value,
        clearCheckOutTime: !checkOutInput.value,
        shiftStartTime: shiftStartInput ? (shiftStartInput.value || '') : '',
        shiftEndTime: shiftEndInput ? (shiftEndInput.value || '') : '',
        deductionAmount: parseFloat(deductionInput.value || '0'),
        advanceAmount: parseFloat(advanceInput.value || '0'),
        bonusAmount: parseFloat(bonusInput ? (bonusInput.value || '0') : '0'),
        lateReason: reasonInput.value || ''
        };

        if (!payload.id) {
        showMessage('لم يتم العثور على رقم السجل');
        return;
        }

        if ((payload.shiftStartTime && !payload.shiftEndTime) || (!payload.shiftStartTime && payload.shiftEndTime)) {
        showMessage('يجب إدخال بداية ونهاية الدوام معًا');
        return;
        }

        saveBtn.disabled = true;
        saveBtn.innerText = 'جاري الموافقة...';

        try {
        const response = await fetch('/EmployeeAttendance/UpdateAttendanceLogRow', {
        method: 'POST',
        headers: {
        'Content-Type': 'application/json',
        'RequestVerificationToken': getAntiForgeryToken()
        },
        body: JSON.stringify(payload)
        });

        const responseText = await response.text();
        let result = null;

        try {
        result = responseText ? JSON.parse(responseText) : null;
        } catch (parseError) {
        result = null;
        }

        if (response.ok && result && result.success) {
        closeEditPopup();
        showSuccessStatus('تم التعديل');
        setTimeout(function () { window.refreshAttendanceLogTableOnly ? window.refreshAttendanceLogTableOnly(window.location.href, false) : window.location.reload(); }, 900);
        return;
        }

        if (result && result.message) {
        showMessage(result.message);
        } else {
        showMessage('تعذر تعديل السجل - كود الخطأ: ' + response.status + (responseText ? (' - ' + responseText.substring(0, 180)) : ''));
        }
        } catch (error) {
        showMessage('حدث خطأ أثناء تعديل السجل: ' + (error && error.message ? error.message : ''));
        } finally {
        saveBtn.disabled = false;
        saveBtn.innerText = 'موافقة';
        }
        });
        }
        })();
    </script>


    <script>
        (function () {
        const trashBtn = document.getElementById('attendanceTrashBtn');
        const trashBackdrop = document.getElementById('attendanceTrashBackdrop');
        const trashClose = document.getElementById('attendanceTrashClose');
        const trashBody = document.getElementById('attendanceTrashBody');
        const restoreAllBtn = document.getElementById('attendanceRestoreAllBtn');

        if (!trashBtn || !trashBackdrop || !trashBody) {
        return;
        }

        function getAntiForgeryTokenForTrash() {
        const tokenInput = document.querySelector('#attendanceRowAntiForgeryForm input[name="__RequestVerificationToken"]');
        return tokenInput ? tokenInput.value : '';
        }

        function setTrashLoading() {
        trashBody.innerHTML = '<div class="attendance-trash-empty">جاري تحميل المحذوفات...</div>';
        if (restoreAllBtn) {
        restoreAllBtn.style.display = 'none';
        restoreAllBtn.disabled = false;
        restoreAllBtn.innerText = 'استرداد الكل';
        }
        }

        function escapeHtml(value) {
        return String(value === undefined || value === null ? '' : value)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
        }

        function renderTrashItems(items) {
        items = Array.isArray(items) ? items : [];

        if (!items.length) {
        trashBody.innerHTML = '<div class="attendance-trash-empty">لا توجد سجلات محذوفة</div>';
        if (restoreAllBtn) restoreAllBtn.style.display = 'none';
        return;
        }

        trashBody.innerHTML = items.map(function (item) {
        return '<div class="attendance-trash-item" data-trash-id="' + escapeHtml(item.id) + '">' +
        '<div class="attendance-trash-info">' +
        '<div class="attendance-trash-name">' + escapeHtml(item.employeeName || 'بدون اسم') + '</div>' +
        '<div>التاريخ: ' + escapeHtml(item.date || '-') + ' | الدخول: ' + escapeHtml(item.checkInTime || '-') + ' | الخروج: ' + escapeHtml(item.checkOutTime || '-') + '</div>' +
        '<div>الخصم: ' + escapeHtml(item.deductionAmount || '0.00') + ' | السبب: ' + escapeHtml(item.reason || '-') + '</div>' +
        '<div>تاريخ الحذف: ' + escapeHtml(item.deletedAt || '-') + '</div>' +
        '</div>' +
        '<button type="button" class="attendance-trash-restore-btn" data-trash-id="' + escapeHtml(item.id) + '">استرداد</button>' +
        '</div>';
        }).join('');

        if (restoreAllBtn) restoreAllBtn.style.display = 'inline-flex';
        }

        async function loadTrashItems() {
        setTrashLoading();

        try {
        const response = await fetch('/EmployeeAttendance/DeletedAttendanceLogs', {
        method: 'GET',
        headers: { 'Accept': 'application/json' },
        cache: 'no-store'
        });

        const result = await response.json();

        if (!result || !result.success) {
        trashBody.innerHTML = '<div class="attendance-trash-empty">تعذر تحميل المحذوفات</div>';
        return;
        }

        renderTrashItems(result.items || []);
        } catch (error) {
        trashBody.innerHTML = '<div class="attendance-trash-empty">حدث خطأ أثناء تحميل المحذوفات</div>';
        }
        }

        function openTrashPopup() {
        trashBackdrop.style.display = 'flex';
        loadTrashItems();
        }

        function closeTrashPopup() {
        trashBackdrop.style.display = 'none';
        }

        trashBtn.addEventListener('click', openTrashPopup);

        if (trashClose) {
        trashClose.addEventListener('click', closeTrashPopup);
        }

        trashBackdrop.addEventListener('click', function (event) {
        if (event.target === trashBackdrop) {
        closeTrashPopup();
        }
        });

        trashBody.addEventListener('click', async function (event) {
        const button = event.target.closest('.attendance-trash-restore-btn');
        if (!button) return;

        const id = parseInt(button.getAttribute('data-trash-id') || '0', 10);
        if (!id) return;

        button.disabled = true;
        button.innerText = 'جاري الاسترداد...';

        try {
        const response = await fetch('/EmployeeAttendance/RestoreAttendanceLogRow', {
        method: 'POST',
        headers: {
        'Content-Type': 'application/json',
        'RequestVerificationToken': getAntiForgeryTokenForTrash()
        },
        body: JSON.stringify({ id: id })
        });

        const result = await response.json();

        if (result && result.success) {
        if (typeof showSuccessStatus === 'function') {
        showSuccessStatus(result.message || 'تم استرداد السجل');
        }
        setTimeout(function () { window.refreshAttendanceLogTableOnly ? window.refreshAttendanceLogTableOnly(window.location.href, false) : window.location.reload(); }, 800);
        return;
        }

        button.disabled = false;
        button.innerText = 'استرداد';
        alert(result && result.message ? result.message : 'تعذر استرداد السجل');
        } catch (error) {
        button.disabled = false;
        button.innerText = 'استرداد';
        alert('حدث خطأ أثناء استرداد السجل');
        }
        });

        if (restoreAllBtn) {
        restoreAllBtn.addEventListener('click', async function () {
        restoreAllBtn.disabled = true;
        restoreAllBtn.innerText = 'جاري الاسترداد...';

        try {
        const response = await fetch('/EmployeeAttendance/RestoreAllDeletedAttendanceLogs', {
        method: 'POST',
        headers: { 'RequestVerificationToken': getAntiForgeryTokenForTrash() }
        });

        const result = await response.json();

        if (result && result.success) {
        if (typeof showSuccessStatus === 'function') {
        showSuccessStatus(result.message || 'تم استرداد الكل');
        }
        setTimeout(function () { window.refreshAttendanceLogTableOnly ? window.refreshAttendanceLogTableOnly(window.location.href, false) : window.location.reload(); }, 800);
        return;
        }

        restoreAllBtn.disabled = false;
        restoreAllBtn.innerText = 'استرداد الكل';
        alert(result && result.message ? result.message : 'تعذر استرداد الكل');
        } catch (error) {
        restoreAllBtn.disabled = false;
        restoreAllBtn.innerText = 'استرداد الكل';
        alert('حدث خطأ أثناء استرداد الكل');
        }
        });
        }
        })();
    </script>

    <script>
        (function () {
        const printBtn = document.getElementById('printSelectedRecordsBtn');
        const table = document.getElementById('attendanceTable');
        const selectAllCheckbox = document.getElementById('selectAllAttendanceRecords');

        if (!printBtn || !table) {
        return;
        }

        function getRowCheckboxes() {
        return Array.from(table.querySelectorAll('tbody tr.attendance-data-row input.record-select-checkbox'));
        }

        function updateSelectAllState() {
        if (!selectAllCheckbox) {
        return;
        }

        const rowCheckboxes = getRowCheckboxes();
        const checkedCount = rowCheckboxes.filter(function (checkbox) {
        return checkbox.checked;
        }).length;

        selectAllCheckbox.checked = rowCheckboxes.length > 0 && checkedCount === rowCheckboxes.length;
        selectAllCheckbox.indeterminate = checkedCount > 0 && checkedCount < rowCheckboxes.length;
        }

        if (selectAllCheckbox) {
        selectAllCheckbox.addEventListener('change', function () {
        const rowCheckboxes = getRowCheckboxes();

        rowCheckboxes.forEach(function (checkbox) {
        checkbox.checked = selectAllCheckbox.checked;
        });

        updateSelectAllState();
        });
        }

        getRowCheckboxes().forEach(function (checkbox) {
        checkbox.addEventListener('change', updateSelectAllState);
        });

        updateSelectAllState();

        const selectionAlert = document.getElementById('attendanceSelectionAlert');
        const selectionAlertMessage = document.getElementById('attendanceSelectionAlertMessage');
        const selectionAlertConfirm = document.getElementById('attendanceSelectionAlertConfirm');
        let selectionAlertTimer = null;

        function closeAttendanceSelectionAlert() {
        if (selectionAlert) {
        selectionAlert.style.display = 'none';
        }

        if (selectionAlertTimer) {
        clearTimeout(selectionAlertTimer);
        selectionAlertTimer = null;
        }
        }

        function showAttendanceSelectionAlert(message) {
        if (!selectionAlert) {
        alert(message);
        return;
        }

        if (selectionAlertMessage) {
        selectionAlertMessage.innerText = message;
        }

        selectionAlert.style.display = 'flex';

        if (selectionAlertTimer) {
        clearTimeout(selectionAlertTimer);
        }

        selectionAlertTimer = setTimeout(closeAttendanceSelectionAlert, 3000);
        }

        if (selectionAlertConfirm) {
        selectionAlertConfirm.addEventListener('click', closeAttendanceSelectionAlert);
        }

        printBtn.addEventListener('click', function (event) {
        event.preventDefault();

        const selectedIds = getRowCheckboxes()
        .filter(function (checkbox) {
        return checkbox.checked;
        })
        .map(function (checkbox) {
        return checkbox.value;
        })
        .filter(function (value) {
        return value && value.trim() !== '';
        });

        if (selectedIds.length === 0) {
        showAttendanceSelectionAlert('يجب اختيار سجل واحد على الأقل قبل سحب الكشف');
        return;
        }

        const pdfUrl = '/Pdf/PrintAttendanceLog?ids=' + encodeURIComponent(selectedIds.join(','));
        window.open(pdfUrl, '_blank');
        });

        document.addEventListener('click', function (event) {
        const button = event.target.closest('.attendance-print-row-btn');
        if (!button) {
        return;
        }

        event.preventDefault();
        event.stopPropagation();

        const logId = button.getAttribute('data-log-id') || '';

        if (!logId || logId.trim() === '' || parseInt(logId, 10) <= 0) {
        showAttendanceSelectionAlert('لم يتم العثور على رقم السجل');
        return;
        }

        const pdfUrl = '/Pdf/PrintAttendanceLog?ids=' + encodeURIComponent(logId);
        window.open(pdfUrl, '_blank');
        });
        })();

        (function setupShiftBlockToggles() {
        const toggles = Array.from(document.querySelectorAll('.shift-block-toggle'));
        const messageBox = document.getElementById('shiftBlockMessage');
        const tokenInput = document.querySelector('#shiftBlockAntiForgeryForm input[name="__RequestVerificationToken"]');

        function showShiftBlockMessage(message, type) {
        if (!messageBox) {
        return;
        }

        messageBox.textContent = message || '';
        messageBox.className = 'shift-block-message ' + (type === 'error' ? 'error' : 'success');

        window.setTimeout(function () {
        if (messageBox) {
        messageBox.className = 'shift-block-message';
        messageBox.textContent = '';
        }
        }, 3500);
        }

        function setShiftBlockRowState(shiftId, isBlocked, noteText) {
        const status = document.querySelector('[data-shift-block-status="' + shiftId + '"]');
        const note = document.querySelector('[data-shift-block-note="' + shiftId + '"]');

        document.querySelectorAll('.shift-block-toggle[data-shift-id="' + shiftId + '"]').forEach(function (rowToggle) {
        rowToggle.checked = isBlocked;
        });

        if (status) {
        status.textContent = isBlocked ? 'بلوك' : 'مفتوح';
        status.classList.toggle('is-blocked', isBlocked);
        status.classList.toggle('is-open', !isBlocked);
        }

        if (note) {
        note.textContent = noteText || '-';
        }
        }

        document.addEventListener('change', async function (event) {
        const toggle = event.target.closest('.shift-block-toggle');
        if (!toggle) {
        return;
        }
        const shiftId = parseInt(toggle.getAttribute('data-shift-id') || '0', 10);
        const newBlockedState = toggle.checked;
        const previousState = !newBlockedState;

        if (!shiftId) {
        toggle.checked = previousState;
        showShiftBlockMessage('لم يتم العثور على الشيفت المطلوب', 'error');
        return;
        }

        toggle.disabled = true;

        try {
        const response = await fetch('/EmployeeAttendance/ToggleEmployeeLoginBlock', {
        method: 'POST',
        cache: 'no-store',
        credentials: 'same-origin',
        headers: {
        'Content-Type': 'application/json',
        'Accept': 'application/json',
        'RequestVerificationToken': tokenInput ? tokenInput.value : ''
        },
        body: JSON.stringify({
        shiftId: shiftId,
        isBlocked: newBlockedState
        })
        });

        const result = await response.json();

        if (!response.ok || !result || result.success === false) {
        throw new Error(result && result.message ? result.message : 'فشل تحديث حالة البلوك');
        }

        toggle.checked = result.isBlocked === true;

        const noteText = result.isBlocked
        ? 'تم عمل بلوك يدوي من الإدارة'
        : (result.adminUnblockedUntil ? ('مسموح حتى ' + result.adminUnblockedUntil) : 'تم فك البلوك يدويًا');

        setShiftBlockRowState(shiftId, result.isBlocked === true, noteText);
        showShiftBlockMessage(result.message || 'تم تحديث حالة البلوك بنجاح', 'success');

        if (result.refreshAttendanceLog === true || result.isBlocked === true) {
        window.setTimeout(function () {
        window.refreshAttendanceLogTableOnly ? window.refreshAttendanceLogTableOnly(window.location.href, false) : window.location.reload();
        }, 650);
        }
        } catch (error) {
        toggle.checked = previousState;
        showShiftBlockMessage(error && error.message ? error.message : 'فشل تحديث حالة البلوك', 'error');
        } finally {
        toggle.disabled = false;
        }
        });
        })();

        // تم إيقاف التحديث التلقائي لجدول تسجيل الدوام.
        // الجدول يلود مرة واحدة فقط، وأي تعديل جديد يظهر عند عمل Refresh يدوي للصفحة.
        // سبب الإلغاء: منع الوميض/إعادة تحميل الجدول كل 5 ثواني.


    </script>

</div>
