                    font-weight: 600;
                    border-bottom: 1px solid #e9eaec;
                }

            .employee-name-cell {
                color: #1d273b !important;
                font-weight: 900 !important;
            }

            .shift-start-cell {
                color: #1d273b !important;
                font-weight: 900 !important;
            }

            .shift-end-cell {
                color: #dc2626 !important;
                font-weight: 900 !important;
            }

            .work-shift-table tbody tr:hover {
                background: #f8fafc;
            }

            .shift-status-active {
                color: #2ab149;
                background: rgba(42, 177, 73, 0.12);
                padding: 5px 14px;
                border-radius: 999px;
                font-weight: 800;
                display: inline-block;
            }

            .shift-status-inactive {
                color: #64748b;
                background: rgba(100, 116, 139, 0.12);
                padding: 5px 14px;
                border-radius: 999px;
                font-weight: 800;
                display: inline-block;
            }

            .empty-row {
                color: #64748b;
                font-weight: 700;
                padding: 22px !important;
            }

            .attendance-success-popup-backdrop {
                position: fixed;
                inset: 0;
                background: rgba(15, 23, 42, 0.35);
                display: flex;
                align-items: center;
                justify-content: center;
                z-index: 9999;
                padding: 16px;
            }

            .attendance-success-popup {
                width: 100%;
                max-width: 420px;
                background: #ffffff;
                border-radius: 18px;
                box-shadow: 0 18px 40px rgba(15, 23, 42, 0.20);
                overflow: hidden;
                text-align: center;
                animation: attendancePopupFadeIn 0.20s ease-out;
            }

            .attendance-success-popup-body {
                padding: 26px 22px 18px;
            }

            .attendance-success-popup-icon {
                width: 68px;
                height: 68px;
                margin: 0 auto 14px;
                border-radius: 50%;
                background: rgba(42, 177, 73, 0.12);
                display: flex;
                align-items: center;
                justify-content: center;
            }

            .attendance-success-popup-check {
                width: 34px;
                height: 34px;
                display: block;
                fill: rgb(42, 177, 73);
            }

            .attendance-success-popup-title {
                margin: 0;
                font-size: 28px;
                line-height: 1.4;
                font-weight: 700;
                color: rgb(42, 177, 73);
            }

            .attendance-success-popup-footer {
                border-top: 1px solid #e5e7eb;
                padding: 0;
            }

            .attendance-success-popup-btn {
                width: 100%;
                min-height: 56px;
                border: 0;
                background: #ffffff;
                color: #f28e02 !important;
                font-size: 24px;
                font-weight: 700;
            }

                .attendance-success-popup-btn:hover {
                    background: rgba(242, 142, 2, 0.08);
                    color: #f28e02 !important;
                }

            @@keyframes attendancePopupFadeIn {
                from {
                    opacity: 0;
                    transform: scale(0.96);
                }

                to {
                    opacity: 1;
                    transform: scale(1);
