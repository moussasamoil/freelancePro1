    </style>

    <div class="work-shift-page">
        <div class="work-shift-card">
            <div class="work-shift-header">تعيين أوقات الدوام</div>

            <div class="work-shift-body">
                @if (!string.IsNullOrWhiteSpace(errorMessage))
                {
                    <div class="error-box">@errorMessage</div>
                }

                <form asp-controller="EmployeeAttendance" asp-action="AssignWorkTimes" method="post">
                    @Html.AntiForgeryToken()

                    <div class="row g-3 align-items-end">
                        <div class="col-12 col-md-6 col-xl-3">


                            <input type="hidden" name="employeeId" id="employeeIdInput" required />

                            <div class="employee-custom-dropdown" id="employeeCustomDropdown">
                                <div class="selected-employee" id="selectedEmployeeButton" role="button" tabindex="0">
                                    <span class="selected-employee-text" id="selectedEmployeeText">اختر الموظف</span>
                                    <i class="fa-duotone fa-chevron-down selected-employee-icon"></i>
                                </div>

                                <div class="employee-options-dropdown" id="employeeOptionsDropdown">
                                    @if (employees != null && employees.Any())
                                    {
                                        foreach (var employee in employees)
                                        {
                                            var employeeImage = employee.Group?.Name ?? "";

                                            <div class="employee-option"
                                                 data-value="@employee.Value"
                                                 data-text="@employee.Text">
                                                @if (!string.IsNullOrWhiteSpace(employeeImage))
                                                {
                                                    <img src="@employeeImage"
                                                         class="employee-option-image"
                                                         alt="@employee.Text"
                                                         onerror="this.style.display='none'; this.nextElementSibling.style.display='inline-flex';" />

                                                    <span class="employee-option-placeholder" style="display:none;">
                                                        <i class="fa-light fa-user"></i>
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="employee-option-placeholder">
                                                        <i class="fa-light fa-user"></i>
                                                    </span>
                                                }

                                                <span class="employee-option-name">@employee.Text</span>
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <div class="employee-option" data-value="" data-text="لا يوجد موظفين">
                                            <span class="employee-option-placeholder">
                                                <i class="fa-light fa-user"></i>
                                            </span>
                                            <span class="employee-option-name">لا يوجد موظفين</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-md-6 col-xl-3">
                            <label class="form-label-custom">وقت بداية الدوام</label>
                            <input type="time" name="shiftStartTime" class="form-control form-control-custom" required />
                        </div>

                        <div class="col-12 col-md-6 col-xl-3">
                            <label class="form-label-custom">وقت نهاية الدوام</label>
                            <input type="time" name="shiftEndTime" class="form-control form-control-custom" required />
                        </div>

                        <div class="col-12 col-md-6 col-xl-3">

                            <input type="text"
                                   name="allowedIpAddress"
                                   class="form-control form-control-custom"
                                   placeholder="ادخل IP الموظف يدويًا - اختياري مثل: 41.46.62.13" />
                        </div>

                        <div class="col-12">

                            <textarea name="notes"
                                      class="form-control form-control-custom"
                                      rows="3"
                                      placeholder="ملاحظات اختيارية"></textarea>
                        </div>

                        <div class="col-12 text-center mt-3">
                            <button type="submit" class="save-shift-btn">حفظ الدوام</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <div class="work-shift-table-card">
            <div class="work-shift-header">آخر أوقات دوام تم تعيينها</div>

            <div class="table-responsive">
                <table class="table work-shift-table">
                    <thead>
                        <tr>
                            <th>الموظف</th>
                            <th>وقت بداية الدوام</th>
                            <th>وقت نهاية الدوام</th>
                            <th>IP الموظف</th>
                            <th>ملاحظات</th>
                            <th>الحالة</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (recentShifts != null && recentShifts.Any())
                        {
                            foreach (var shift in recentShifts)
                            {
                                <tr>
                                    <td class="employee-name-cell">@shift.EmployeeName</td>
                                    <td class="shift-start-cell">@shift.ShiftStartTime.ToString(@"hh\:mm")</td>
                                    <td class="shift-end-cell">@shift.ShiftEndTime.ToString(@"hh\:mm")</td>
                                    <td>@(string.IsNullOrWhiteSpace(shift.AllowedIpAddress) ? "-" : shift.AllowedIpAddress)</td>
                                    <td>@(string.IsNullOrWhiteSpace(shift.Notes) ? "-" : shift.Notes)</td>
                                    <td>
                                        @if (shift.IsActive)
                                        {
                                            <span class="shift-status-active">نشط</span>
                                        }
                                        else
                                        {
                                            <span class="shift-status-inactive">غير نشط</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="empty-row">لا توجد بيانات حتى الآن</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <script>
            (function () {
                const dropdown = document.getElementById('employeeCustomDropdown');
                const button = document.getElementById('selectedEmployeeButton');
                const selectedText = document.getElementById('selectedEmployeeText');
                const hiddenInput = document.getElementById('employeeIdInput');
                const options = Array.from(document.querySelectorAll('.employee-option'));

                if (!dropdown || !button || !selectedText || !hiddenInput) {
                    return;
                }

                function closeDropdown() {
                    dropdown.classList.remove('open');
                }

                function toggleDropdown() {
                    dropdown.classList.toggle('open');
                }

                button.addEventListener('click', function (event) {
                    event.preventDefault();
                    event.stopPropagation();
                    toggleDropdown();
                });

                button.addEventListener('keydown', function (event) {
                    if (event.key === 'Enter' || event.key === ' ') {
                        event.preventDefault();
                        toggleDropdown();
                    }

                    if (event.key === 'Escape') {
                        closeDropdown();
                    }
                });

                options.forEach(function (option) {
                    option.addEventListener('click', function (event) {
                        event.preventDefault();
                        event.stopPropagation();

                        const value = option.getAttribute('data-value') || "";
                        const text = option.getAttribute('data-text') || "اختاري الموظف";

                        if (!value) {
                            return;
                        }

                        hiddenInput.value = value;
                        selectedText.innerText = text;

                        options.forEach(function (item) {
                            item.classList.remove('active');
                        });

                        option.classList.add('active');

                        closeDropdown();
                    });
                });

                document.addEventListener('click', function (event) {
                    if (!dropdown.contains(event.target)) {
                        closeDropdown();
                    }
                });
            })();
    </script>

    <script>
            (function () {
                function replaceEmployeeManagementTitle() {
                    const wantedTitle = 'تعيين أوقات الدوام';
                    const oldTitles = ['ادارة الموظفين', 'إدارة الموظفين', 'اداره الموظفين', 'إداره الموظفين'];

                    document.title = wantedTitle;

                    const targetSelectors = [
                        'h1',
                        'h2',
                        'h3',
                        '.page-title',
                        '.header-title',
                        '.navbar-title',
                        '.top-title',
                        '.title',
                        '.page-header',
                        '.headerbar',
                        '.headerbar *',
                        'header',
                        'header *',
                        '.navbar',
                        '.navbar *'
                    ];

                    targetSelectors.forEach(function (selector) {
                        document.querySelectorAll(selector).forEach(function (element) {
                            const currentText = (element.textContent || '').trim();

                            if (oldTitles.includes(currentText)) {
                                element.textContent = wantedTitle;
                            }
                        });
                    });

                    const walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT, {
                        acceptNode: function (node) {
                            const value = (node.nodeValue || '').trim();

                            if (oldTitles.includes(value)) {
                                return NodeFilter.FILTER_ACCEPT;
                            }

                            return NodeFilter.FILTER_REJECT;
                        }
                    });

                    const nodesToReplace = [];
                    let currentNode;

                    while (currentNode = walker.nextNode()) {
                        nodesToReplace.push(currentNode);
                    }

                    nodesToReplace.forEach(function (node) {
                        node.nodeValue = node.nodeValue.replace(/إدارة الموظفين|ادارة الموظفين|إداره الموظفين|اداره الموظفين/g, wantedTitle);
                    });
                }

                function ensureAttendanceLogTopLink() {
                    const linkId = 'topAttendanceLogLink';

                    if (document.getElementById(linkId)) {
                        return;
                    }

                    const link = document.createElement('a');
                    link.id = linkId;
                    link.className = 'top-attendance-log-link';
                    link.href = '/EmployeeAttendance/AttendanceLog';
                    link.textContent = 'سجل أوقات الدوام';
                    link.setAttribute('aria-label', 'سجل أوقات الدوام');

                    document.body.appendChild(link);
                }

                document.addEventListener('DOMContentLoaded', function () {
                    replaceEmployeeManagementTitle();
                    ensureAttendanceLogTopLink();

                    setTimeout(function () {
                        replaceEmployeeManagementTitle();
                        ensureAttendanceLogTopLink();
                    }, 100);

                    setTimeout(function () {
                        replaceEmployeeManagementTitle();
                        ensureAttendanceLogTopLink();
                    }, 500);

                    setTimeout(function () {
                        replaceEmployeeManagementTitle();
                        ensureAttendanceLogTopLink();
                    }, 1200);
                });

                if (window.MutationObserver) {
                    const observer = new MutationObserver(function () {
                        replaceEmployeeManagementTitle();
                        ensureAttendanceLogTopLink();
                    });

                    document.addEventListener('DOMContentLoaded', function () {
                        observer.observe(document.body, {
                            childList: true,
                            subtree: true,
                            characterData: true
                        });
                    });
                }
            })();
    </script>

</div>

@if (!string.IsNullOrWhiteSpace(successMessage))
{
    <div id="attendanceSuccessPopup" class="attendance-success-popup-backdrop">
        <div class="attendance-success-popup">
            <div class="attendance-success-popup-body">
                <div class="attendance-success-popup-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" class="attendance-success-popup-check">
                        <path d="M9.1 16.6 4.9 12.4 3.5 13.8 9.1 19.4 21 7.5 19.6 6.1z"></path>
                    </svg>
                </div>

                <p class="attendance-success-popup-title">تم تعيين الدوام</p>
            </div>

            <div class="attendance-success-popup-footer">
                <button type="button" id="attendanceSuccessPopupBtn" class="attendance-success-popup-btn">تأكيد</button>
            </div>
        </div>
    </div>

    <script>
        (function () {
            var popup = document.getElementById('attendanceSuccessPopup');
            var confirmBtn = document.getElementById('attendanceSuccessPopupBtn');
            var autoCloseTimer;

            function closePopup() {
                if (!popup) return;

                popup.style.display = 'none';

                if (autoCloseTimer) {
                    clearTimeout(autoCloseTimer);
                }
            }

            if (confirmBtn) {
                confirmBtn.addEventListener('click', closePopup);
            }

            autoCloseTimer = setTimeout(closePopup, 3000);
        })();
    </script>
}
