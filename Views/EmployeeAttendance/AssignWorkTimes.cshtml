            .error-box {
                background: rgba(239, 68, 68, 0.10);
                color: #dc2626;
                border: 1px solid rgba(239, 68, 68, 0.25);
                border-radius: 12px;
                padding: 12px 16px;
                margin-bottom: 16px;
                font-weight: 700;
            }

            .table-responsive {
                width: 100%;
                max-width: 100%;
                overflow-x: auto;
