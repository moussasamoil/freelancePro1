@model lotus_blue.Models.ViewModel.OrderEditChangesViewModel

<div class="edit-changes-modal" dir="rtl">
    <div class="edit-changes-modal__header">
        <a class="edit-changes-modal__back" href="javascript:history.back()">
            <i class="fa-regular fa-chevron-right"></i> رجوع
        </a>
        <div class="edit-changes-modal__title">سجل التعديلات</div>
        <div class="edit-changes-modal__icon">
            <i class="fa-light fa-clock-rotate-left"></i>
        </div>
    </div>

    <div class="edit-changes-modal__body">
        @if (!Model.EditGroups.Any())
        {
            <div class="edit-changes-empty">لا توجد تعديلات لعرضها</div>
        }
        else
        {
            foreach (var group in Model.EditGroups)
            {
                <div class="edit-group">
                    <div class="edit-group__meta">
                        <span class="edit-group__num">تعديل رقم @group.EditNumber</span>
                        <span class="edit-group__by">@group.EditedBy</span>
                        <span class="edit-group__date">@group.EditedAt.ToString("yyyy/MM/dd HH:mm")</span>
                    </div>

                    <table class="edit-group__table">
                        <thead>
                            <tr>
                                <th>الحقل</th>
                                <th>قبل</th>
                                <th>بعد</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var change in group.Changes)
                            {
                                <tr>
                                    <td class="edit-group__field">@change.FieldLabel</td>
                                    <td class="edit-group__before">@(string.IsNullOrEmpty(change.Before) ? "—" : change.Before)</td>
                                    <td class="edit-group__after">@(string.IsNullOrEmpty(change.After) ? "—" : change.After)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
    </div>
</div>
