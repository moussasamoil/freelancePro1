@model lotus_blue.Models.ViewModel.HomeViewModel
@using lotus_blue.Services
@inject DynamicCommon dynamicommon

@{
    ViewData["Title"] = "";
    Layout = "_NoHeaderLayout";
    // Get the countryId from the query string
    string countryName = ViewContext.HttpContext.Request.Query["countryName"];
    string storeName = ViewContext.HttpContext.Request.Query["storeName"];

    string faviconUrl = "~/favicon.svg"; // Default favicon
    string image = "null";
    string name = "";
    int width = 25;
    int height = 25;
    if (!string.IsNullOrEmpty(countryName))
    {
        ViewData["Title"] = countryName;
        faviconUrl = Common.GetImageUrlByCountryName(countryName); // Call method correctly without @
        image = Common.GetImageUrlByCountryName(countryName);
        name = countryName;
    }
    else
    {
        // Check if employeeName is available
        string employeeId = ViewContext.HttpContext.Request.Query["employeeId"];

        string employeeName = ViewContext.HttpContext.Request.Query["employeeName"];
        if (!string.IsNullOrEmpty(employeeName))
        {
            ViewData["Title"] = employeeName;
            faviconUrl = await dynamicommon.GetEmployeeImageByNameAsync(employeeId);
            image = faviconUrl;
            name = employeeName;
        }
        else if (!string.IsNullOrEmpty(storeName))
        {
            // Convert storeId to an int
            if (int.TryParse(ViewContext.HttpContext.Request.Query["storeId"], out int storeId))
            {
                faviconUrl = await dynamicommon.GetImageForStore(storeId);
                image = await dynamicommon.GetSecondImageForStore(storeId);
                if (storeId == 1)
                {
                    width = 200;
                    height = 110;
                }
                if (storeId == 2)
                {
                    width = 200;
                    height = 80;
                }
                if (storeId == 4)
                {
                    width = 200;
                    height = 70;
                }
            }
            ViewData["Title"] = storeName;
        }
    }
    ViewData["FaviconUrl"] = faviconUrl; // Set ViewData
}

