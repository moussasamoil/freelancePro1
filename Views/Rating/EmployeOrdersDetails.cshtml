else
{
    <p>No orders found for this employee.</p>
}



<!-- Display pagination controls -->
<div id="pagination-link" class="mt-0 container-fluid">
    <div class="d-flex justify-content-center align-items-center flex-wrap">

        <p class="text-start pt-2 total-items-display">@Model.PaginationViewModel.TotalItems عدد الطلبات</p>

        <nav aria-label="Page navigation" class="mx-auto">
            <div class="d-flex justify-content-start">
                <ul class="pagination p-0">
                    <li class="page-item @(Model.PaginationViewModel.CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link pointer" data-page="1">
                            <i class="fa-solid fa-chevron-double-right text-green"></i>
                        </a>
                    </li>
                    <li class="page-item @(Model.PaginationViewModel.CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link" data-page="@(Model.PaginationViewModel.CurrentPage - 1)">
                            <i class="fa-solid fa-chevron-right text-green"></i>
                        </a>
                    </li>

                    @{
                        int startPage = Model.PaginationViewModel.CurrentPage;
                        int endPage = startPage + 2;
                        if (endPage > Model.PaginationViewModel.TotalPages)
                        {
                            endPage = Model.PaginationViewModel.TotalPages;
                        }
                    }

                    @for (int i = startPage; i <= endPage; i++)
                    {
                        <li class="numbers page-item @(Model.PaginationViewModel.CurrentPage == i ? "active" : "")">
                            <a class="page-link" data-page="@i">@i</a>
                        </li>
                    }

                    @if (Model.PaginationViewModel.TotalPages > endPage)
                    {
                        <li class="page-item disabled">
                            <span class="page-link">...</span>
                        </li>

                        @for (int i = Model.PaginationViewModel.TotalPages - 2; i <= Model.PaginationViewModel.TotalPages; i++)
                        {
                            <li class="numbers page-item @(Model.PaginationViewModel.CurrentPage == i ? "active" : "")">
                                <a class="page-link" data-page="@i">@i</a>
                            </li>
                        }
                    }



                    <li class="page-item @(Model.PaginationViewModel.CurrentPage ==  Model.PaginationViewModel.TotalPages ? "disabled" : "")">
                        <a class="page-link" data-page="@(Model.PaginationViewModel.CurrentPage + 1)">
                            <i class="fa-solid fa-chevron-left text-green f-s-18"></i>
                        </a>
                    </li>
                    <li class="page-item @(Model.PaginationViewModel.CurrentPage == Model.PaginationViewModel.TotalPages ? "disabled" : "")">
                        <a class="page-link" data-page="@(Model.PaginationViewModel.TotalPages)">
                            <i class="fa-solid fa-chevron-double-left text-green"></i>
                        </a>
                    </li>


                </ul>
            </div>
        </nav>



        @if (User.IsInRole("Admin"))
        {

            <div class="d-flex justify-content-end">
                @if (@Model.TotalOrderPrice != null)
                {
                    <div class="custom-shadow ms-3 TotalOrderPrice" style="display:none;">
                        <span class="total-price-display text-green">
                            @Model.TotalOrderPrice
                            @if (Model.SelectedCoutnry != null)
                            {
                                @Common.GetCurrencyByCountryName(Model.SelectedCoutnry)
                            }
                        </span>
                    </div>
                }

                <div class="custom-shadow">
                    <span class="total-price-display-try text-green">
                        @(Model.TotalOrderPriceTRY)

                        TRY

                    </span>
                </div>
                <div class="custom-shadow">
                    <span class="total-price-display-usd text-green">
                        @(Model.TotalOrderPriceDollar)

                        USD

                    </span>
                </div>
            </div>
        }
    </div>
</div>


<style>
    .icon-size-standard {
        width: 18px;
        height: 18px;
    }

    /* Set a fixed height for table rows */
    table#ordersTable tbody tr {
        height: 50px; /* Adjust as needed for the fixed height */
        overflow: hidden;
    }

        /* Allow rows to expand beyond the fixed height if needed */
        table#ordersTable tbody tr.expanded {
            height: auto;
        }

        /* Apply ellipsis for content that overflows in fixed height rows */
        table#ordersTable tbody tr td {
            white-space: nowrap;
            text-overflow: ellipsis;
            overflow: hidden;
        }

        /* Ensure rows with more content can expand when needed */
        table#ordersTable tbody tr.expanded td {
            white-space: normal;
            overflow: visible;
        }


</style>




<script>


    $(document).ready(function () {

        initializeLitepicker('.custom-datepicker', loadData);


        $('#printButton').click(function (event) {
            const allOrderIds = $('#allOrderIds').val();
            if (allOrderIds) {
                var url = '@Url.Action("PrintSelectedOrders", "Order")?ids=' + allOrderIds;
                window.open(url, '_blank');
            } else {
                alert("No orders found to print.");
            }
        });

        $('.order-details').click(function () {
            // Get the order ID from the data attribute
            var orderId = $(this).data('order-id');
            // Redirect to the order details page with the order ID
            window.location.href = '/Order/Details/' + orderId; // Replace '/Order/Details/' with your actual details page URL
        });




        // Event listener for dropdown changes
        $('#pageSize,#EmployeeId, #CountryId, #OrderSourceId, #GenderId,#ManufacturingCompanyId,#WorkShift,#ProductId').on('change', function () {
            loadData();
        });


    });




    // Function to load data
    function loadData() {
        // Extract the current query parameters from the URL
        const urlParams = new URLSearchParams(window.location.search);

        // Extract existing parameters
        let params = {
            startDate: urlParams.get('startDate'),
            endDate: urlParams.get('endDate'),
            employeeId: urlParams.get('employeeId'),
            productId: urlParams.get('productId'),
            storeId: urlParams.get('storeId'),
            ordersourceId: urlParams.get('ordersourceId'),
            workshift: urlParams.get('workshift'),
            genderId: urlParams.get('genderId'),
            isFixed: urlParams.get('isFixed'),
            isOffer: urlParams.get('isOffer'),
            isDiscount: urlParams.get('isDiscount'),
            isEmployeebonus: urlParams.get('isEmployeebonus'),
            isComments: urlParams.get('isComments'),
            isMale: urlParams.get('isMale'),
            isFemale: urlParams.get('isFemale'),
            countryId: urlParams.get('countryId'),
            warehouseId: urlParams.get('warehouseId'),
            sourceId: urlParams.get('sourceId'),
            isDeliverd: urlParams.get('isDeliverd')

        };
        // Get the selected page size from the dropdown
        const pageSize = $('#pageSize').val();

        // Update parameters based on filter changes
        if ($('#EmployeeId').val()) {
            params.employeeId = $('#EmployeeId').val();
        }
        if ($('#GenderId').val()) {
            params.genderId = $('#GenderId').val();
        }
        if ($('#ProductId').val()) {
            params.productId = $('#ProductId').val();
        }
        if ($('#ManufacturingCompanyId').val()) {
            params.storeId = $('#ManufacturingCompanyId').val();
        }
        if ($('#OrderSourceId').val()) {
            params.ordersourceId = $('#OrderSourceId').val();
        }
        if ($('#CountryId').val()) {
            params.countryId = $('#CountryId').val();
        }
        if ($('#WorkShift').val()) {
            params.workshift = $('#WorkShift').val();
        }
        const startDate = document.getElementById('startDate').value;
        const endDate = document.getElementById('endDate').value;

        if (startDate) {
            params.startDate = startDate;
        }
        if (endDate) {
            params.endDate = endDate;
        }

      

        // Make an AJAX request with the current query parameters and page size
        $.ajax({
            url: '/Rating/EmployeOrdersDetails',
            type: 'GET',
            data: {
                page: 1, // Always load the first page when page size changes
                pageSize: pageSize, // Add the page size here

                // Use params object properties here
                startDate: params.startDate,
                endDate: params.endDate,
                employeeId: params.employeeId,
                productId: params.productId,
                storeId: params.storeId,
                ordersourceId: params.ordersourceId,
                workshift: params.workshift,
                genderId: params.genderId,
                isFixed: params.isFixed,
                isOffer: params.isOffer,
                isDiscount: params.isDiscount,
                isEmployeebonus: params.isEmployeebonus,
                isComments: params.isComments,
                isMale: params.isMale,
                isFemale: params.isFemale,
                countryId: params.countryId,
            
            },
            success: function (response) {
                // Parse the response HTML to extract the orders table and pagination link
                var parsedHtml = $(response);

                // Extract the orders table HTML
                var ordersTableHtml = parsedHtml.find('#ordersTable').html();

                // Extract the pagination link HTML
                var paginationLinkHtml = parsedHtml.find('#pagination-link').html();
             
                // Update the respective elements with the extracted HTML
                $('#ordersTable').html(ordersTableHtml);
                $('#pagination-link').html(paginationLinkHtml);
                $('#total').html($(response).find('#total').html());

            },
            error: function (xhr, status, error) {
                // Handle errors
            }
        });
    }

    // Bind an event listener to the pagination links
    $(document).on('click', '.pagination a.page-link', function (event) {
        event.preventDefault(); // Still prevent the default action
        // Extract the page number from the data-page attribute instead of the href
        const page = $(this).data('page');

        // Call the loadData function with the extracted page number
        loadData(page);
    });


</script>