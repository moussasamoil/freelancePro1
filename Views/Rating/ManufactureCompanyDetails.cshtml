@model lotus_blue.Models.ViewModel.Rating.ManufacturingOrderSummaryViewModel
@using lotus_blue.Models
@using lotus_blue.Services
@inject CurrencyExchangeService CurrencyExchangeServiceInstance
@inject GetCurrentTimeInIstanbul Currenttime

@{

    ViewData["Title"] = "تقيم الحملات الأعلانية حسبة الشركات المصنعة";

    var firstFourPlatformNames = Enum.GetNames(typeof(OrderSourceEnum))
        .Where(name => name != "سناب_شات")
        .Take(3);

    DateTime now = Currenttime.GetIstanbulTimeWithOffset();

    // Check if the current time is before 11 AM
    if (now.Hour < 11)
    {
        // If before 11 AM, consider it as the previous day
        now = now.AddDays(-1);
    }

    // Set the start time to 11 AM of the determined date
    DateTime startDateTime = new DateTime(now.Year, now.Month, now.Day, 11, 0, 0);

    // Calculate end time which is exactly 1 day after start time
    DateTime endDateTime = startDateTime.AddDays(1);

}



