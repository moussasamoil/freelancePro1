                                        <p class="mb-0 mx-2 text-nowrap pt-1">USD: @totalSumUSD</p>
                                        <p class="mb-0 text-nowrap pt-1">@Common.GetCurrencyByCountryName(countryInfo.Country.ToString()): @totalSumIQD</p>
                                    </div>
                                }
                            </div>
                        </div>
                    }


                </div>
            </div>
        </div>
