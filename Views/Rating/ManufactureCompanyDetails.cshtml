</div>



<script>

    $(document).ready(function () {

        initializeLitepicker('.custom-datepicker', updateManufactureCompanyData);

        // Event listener for dropdown changes
        $('#EmployeeId, #CountryId, #OrderSourceId, #GenderId,#ManufacturingCompanyId,#WorkShift,#ProductId').on('change', function () {
            updateManufactureCompanyData();
        });


    });

    function updateManufactureCompanyData() {
        // Get the selected start and end dates
        const startDate = document.getElementById('startDate').value;
        const endDate = document.getElementById('endDate').value;

        const selectedDateRange = $('#selectedDateRange').text();
        const employeeId = $('#EmployeeId').val(); // Get selected employee Id
        const selectedCountry = $('#CountryId').val(); // Get selected countryId
        const currentSource = $('#OrderSourceId').val(); // Get selected order source
        const selectedGender = $('#GenderId').val(); // Get selected genderId
        const selectedStore = $('#ManufacturingCompanyId').val(); // Get selected genderId
        const workshift = $('#WorkShift').val(); // Get selected genderId
        const warehouseId = $('#ProductId').val(); // Get selected employee Id

     
        var countryId = $('#CountryId').val();


        $.ajax({
            url: '/Rating/ManufactureCompanyDetails',
            type: 'GET',
            traditional: true, // This will handle the list correctly

            data: {
                employeeId: employeeId,
                countryId: selectedCountry,
                orderSourceId: currentSource,
                genderId: selectedGender,
                storeId: selectedStore,
                startDay: startDate,
                endDay: endDate,
                workshift: workshift,
                mainwarehouseId: warehouseId  // Corrected syntax
            },
            success: function (result) {
                // Update the table and rating section with the result
                $('#result').html($(result).find('#result').html());
                $('#total').html($(result).find('#total').html());

            }
        });
    }

    function navigateToPage(isFixed, isOffer, isDiscount, isEmployeebonus, isComments, isMale, isFemale, employeeId, employeeName, countryId, countryName, storeId, storeName, ordersourceId) {
       // var startDate = rangePicker.startDate.format('YYYY-MM-DD');
      //  var endDate = rangePicker.endDate.format('YYYY-MM-DD');
        employeeId = $('#EmployeeId').val() || employeeId || "";
        const genderId = $('#GenderId').val();
        storeId = $('#ManufacturingCompanyId').val() || storeId || "";
        const workshift = $('#WorkShift').val();
        startDate = document.getElementById('startDate').value;
        endDate = document.getElementById('endDate').value;
        // Construct the query string
        let queryString = `?startDate=${startDate}&endDate=${endDate}&employeeId=${employeeId}&ordersourceId=${ordersourceId}&genderId=${genderId}&storeId=${storeId}&workshift=${workshift}`;

        // Add the isFixed parameter if it's true
        if (isFixed) {
            queryString += '&isFixed=true';
        }
        if (employeeName) {
            queryString += `&employeeName=${employeeName}`;
        }
        if (storeName) {
            queryString += `&storeName=${storeName}`;
        }
        if (countryName) {
            queryString += `&countryName=${countryName}`;
        }
        // Add the isOffers parameter if it's true
        if (isOffer) {
            queryString += '&IsOffer=true';
        }
        if (isDiscount) {
            queryString += '&isDiscount=true';
        }
        if (isEmployeebonus) {
            queryString += '&isEmployeebonus=true';
        }
        if (isComments) {
            queryString += '&isComments=true';
        }
        if (isMale) {
            queryString += `&isMale=true`;
        }
        if (isFemale) {
            queryString += `&isFemale=true`;
        }
        if (countryId) {
            queryString += `&countryId=${countryId}`;
        }
        // Add the ordersourceId parameter
        if (ordersourceId) {
            queryString += `&ordersourceId=${ordersourceId}`;
        }

        // Redirect to the desired page with the query string
        window.open('/Rating/EmployeOrdersDetails' + queryString, '_blank');
    }

    $(document).on('click', '.ordersDiv', function (event) {
        // Prevent the click event from propagating to its parent elements
        event.stopPropagation();

        navigateToPage(false, false, false, false, false, false, false, null, null);
    });


    $(document).on('click', '.processedDiv', function (event) {
        // Prevent the click event from propagating to the parent element
        event.stopPropagation();



        // Call navigateToPage function with the employeeId and isFixed parameter
        navigateToPage(true, false, false, false, false, false, false, null, null);
    });

    $(document).on('click', '.offersDiv', function (event) {
        // Prevent the click event from propagating to the parent element
        event.stopPropagation();


        // Call navigateToPage function with the employeeId and isOffer parameter
        navigateToPage(false, true, false, false, false, false, false, null, null);
    })

    $(document).on('click', '.discountdiv', function (event) {
        event.stopPropagation();



        // Call navigateToPage function with the employeeId and isFixed parameter
        navigateToPage(false, false, true, false, false, false, false, null, null);
    });


    $(document).on('click', '.employeebonusdiv', function (event) {
        event.stopPropagation();


        // Call navigateToPage function with the employeeId and isFixed parameter
        navigateToPage(false, false, false, true, false, false, false, null, null);
    });

    $(document).on('click', '.productcountdiv', function (event) {
        event.stopPropagation();

        // Call navigateToPage function with the employeeId and isFixed parameter
        navigateToPage(false, false, false, false, false, false, false, null, null);
    });


    $(document).on('click', '.commentsdiv', function (event) {
        event.stopPropagation();



        // Call navigateToPage function with the employeeId and isFixed parameter
        navigateToPage(false, false, false, false, true, false, false, null, null);
    });

    $(document).on('click', '.malediv', function (event) {
        event.stopPropagation();



        // Call navigateToPage function with the employeeId and isFixed parameter
        navigateToPage(false, false, false, false, false, true, false, null, null);
    });

    $(document).on('click', '.femalediv', function (event) {
        event.stopPropagation();


        // Call navigateToPage function with the employeeId and isFixed parameter
        navigateToPage(false, false, false, false, false, false, true, null, null);
    });

    $(document).on('click', '.store-data', function (event) {
        event.stopPropagation();

        // Retrieve the storeId from the data attribute
        var storeId = $(this).data('store-id');
        var storeName = $(this).data('store-name');

        // Call navigateToPage function with the storeId parameter
        navigateToPage(false, false, false, false, false, false, false, null, null, null, null, storeId, storeName);
    });

    $(document).on('click', '.source-info', function (event) {
        event.stopPropagation();

        // Retrieve the parent element with country data
        var parentDiv = $(this).closest('div[data-country-name][data-country-id][data-store-id]');
        var countryName = parentDiv.data('country-name');
        var countryId = parentDiv.data('country-id');
        var storeId = parentDiv.closest('.mt-4').find('.store-data').data('store-id'); // Adjusted to find store-data
        var ordersourceId = $(this).data('source-id');
        console.log(storeId);

        // Call navigateToPage function with the appropriate parameters
        navigateToPage(false, false, false, false, false, false, false, null, null, countryId, countryName, storeId, null, ordersourceId);
    });

    $(document).on('click', '.country-info', function (event) {
        // Check if the clicked element is not a .source-info element
        if (!$(event.target).closest('.source-info').length) {
            var countryName = $(this).data('country-name');
            var countryId = $(this).data('country-id');
            var storeId = $(this).closest('.mt-4').find('.store-data').data('store-id'); // Adjusted to find store-data
            console.log(storeId);

            // Call navigateToPage function with the country parameters
            navigateToPage(false, false, false, false, false, false, false, null, null, countryId, countryName, storeId, null, null);
        }
    });



</script>

