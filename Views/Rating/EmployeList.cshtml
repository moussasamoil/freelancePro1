    // Retrieve selected countryId and order source values from dropdowns
    var selectedCountry = $('#CountryId').val(); // Make sure this is correctly set up
    var orderSource = $('#OrderSourceId').val();

    var url = `/Rating/EmployeOrdersDetails?selectedDateRange=${encodeURIComponent(selectedDateRangeText)}&selectedCountry=${encodeURIComponent(selectedCountry)}&orderStatusGroup=${encodeURIComponent(orderStatusGroup)}&ordersource=${encodeURIComponent(orderSource)}`;
    window.location.href = url;
