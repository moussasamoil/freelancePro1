    // Function to handle the AJAX request
    function navigateToPage(isFixed, isOffer , isDiscount , isEmployeebonus ,isComments, isMale, isFemale,employeeId,employeeName ,countryId,countryName,storeId,storeName) {

    startDate = document.getElementById('startDate').value;
    endDate = document.getElementById('endDate').value;

    employeeId = $('#EmployeeId').val() || employeeId ||""  ;
    const ordersourceId = $('#OrderSourceId').val();
    const genderId = $('#GenderId').val();
    storeId = $('#ManufacturingCompanyId').val() || storeId  ||"" ;
    const workshift = $('#WorkShift').val();

    // Construct the query string
    let queryString = `?startDate=${startDate}&endDate=${endDate}&employeeId=${employeeId}&ordersourceId=${ordersourceId}&genderId=${genderId}&storeId=${storeId}&workshift=${workshift}`;

    // Add the isFixed parameter if it's true
    if (isFixed) {
    queryString += '&isFixed=true';
    }
    if (employeeName) {
    queryString += `&employeeName=${employeeName}`;
    }
    if(storeName){
    queryString += `&storeName=${storeName}`;
    }
    if(countryName){
    queryString += `&countryName=${countryName}`;
    }
    // Add the isOffers parameter if it's true
    if (isOffer) {
    queryString += '&IsOffer=true';
    }
    if (isDiscount) {
    queryString += '&isDiscount=true';
    }
    if (isEmployeebonus) {
    queryString += '&isEmployeebonus=true';
    }
    if (isComments) {
    queryString += '&isComments=true';
    }
    if (isMale) {
    queryString += `&isMale=true`;
    }
    if (isFemale) {
    queryString += `&isFemale=true`;
    }
    if (countryId) {
    queryString += `&countryId=${countryId}`;
    }

                  

    // Redirect to the desired page with the query string
    window.open('/Rating/EmployeOrdersDetails' + queryString, '_blank');
    }

         
