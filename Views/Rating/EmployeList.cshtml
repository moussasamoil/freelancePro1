    // Function to handle the AJAX request
    function updateEmployeeData() {

    const startDate = document.getElementById('startDate').value;
    const endDate = document.getElementById('endDate').value;

    console.log("Sending AJAX request with dates:", startDate, endDate);

    const selectedDateRange = $('#selectedDateRange').text();
    const employeeId = $('#EmployeeId').val(); // Get selected employee Id
    const selectedCountry = $('#CountryId').val(); // Get selected countryId
    const currentSource = $('#OrderSourceId').val(); // Get selected order source
    const selectedGender = $('#GenderId').val(); // Get selected genderId
    const selectedStore = $('#ManufacturingCompanyId').val(); // Get selected genderId
    const workshift=$('#WorkShift').val(); // Get selected genderId
    const warehouseId = $('#ProductId').val(); // Get selected employee Id

                       
    var countryId = $('#CountryId').val();


    $.ajax({
    url: '/Rating/Employelist',
    type: 'GET',
    data: {
    employeeId: employeeId,
    countryId: selectedCountry,
    orderSourceId: currentSource,
    genderId: selectedGender,
    storeId: selectedStore,
    startDay: startDate,
    endDay: endDate,
    workshift:workshift,
    mainwarehouseId: warehouseId  // Corrected syntax
    },
    success: function (result) {
    // Update the table and rating section with the result
    $('#employeeTableBody').html($(result).find('#employeeTableBody').html());
    $('#Rating').html($(result).find('#Rating').html());
    $('#total').html($(result).find('#total').html());
    $('#employeedata').html($(result).find('#employeedata').html());
    $('#countrydata').html($(result).find('#countrydata').html());
    $('#storedata').html($(result).find('#storedata').html());

    setTimeout(loadMetaActionCountsForEmployees, 50);
    setTimeout(loadInvestigationCountsForEmployees, 80);
    setTimeout(loadNoAdCountsForEmployees, 110);
    setTimeout(loadEmployeeStatusGroupCountsForEmployees, 140);

    }
    });
    }



    $('div').on('click', '.filter-orders', function () {
    var selectedDateRangeText = $('#selectedDateRange').text();
