    function loadEmployeeStatusGroupCountsForEmployees() {
    resetEmployeeStatusGroupCounts();

    if ($('.employee-meta-actions-rating').length === 0) {
    return;
    }

    $.ajax({
    url: '/Rating/EmployeeOrderStatusGroupSummary',
    type: 'GET',
    data: getNoAdRatingFilters(),
    success: function (response) {
    if (!response || response.success !== true || !response.items) {
    return;
    }

    response.items.forEach(function (row) {
    const $panel = findEmployeeMetaPanel(row);
    if (!$panel || $panel.length === 0) {
    return;
    }

    if (row.statusGroup) {
    const group = String(row.statusGroup || '').toLowerCase();
    const count = row.count || 0;

    if (group === 'delivered') {
    $panel.find('.delivered-status-count').text(count);
    } else if (group === 'failed') {
    $panel.find('.failed-status-count').text(count);
    } else if (group === 'delayed') {
    $panel.find('.delayed-status-count').text(count);
    }

    return;
    }

    $panel.find('.delivered-status-count').text(row.deliveredCount || 0);
    $panel.find('.failed-status-count').text(row.failedCount || 0);
    $panel.find('.delayed-status-count').text(row.delayedCount || 0);
    });
    }
    });
    }

