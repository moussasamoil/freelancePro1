    function findEmployeeMetaPanel(row) {
    const employeeId = row.employeeId ? String(row.employeeId) : '';
    const userId = row.userId ? String(row.userId) : '';
    const employeeName = row.employeeName ? String(row.employeeName).trim() : '';

    let $panel = $();

    $('.employee-meta-actions-rating').each(function () {
    const $current = $(this);
    const currentId = String($current.data('meta-employee-id') || '');
    const currentName = String($current.data('meta-employee-name') || '').trim();

    if ((employeeId && currentId === employeeId)
    || (userId && currentId === userId)
    || (employeeName && currentName === employeeName)) {
    $panel = $current;
    return false;
    }
    });

    return $panel;
    }

    function loadMetaActionCountsForEmployees() {
    resetMetaActionRatingCounts();

    if ($('.employee-meta-actions-rating').length === 0) {
    return;
    }

    const dates = getMetaActionDateFilters();

    $.ajax({
    url: '/OrderMetaActions/RatingSummary',
    type: 'GET',
    data: {
    startDate: dates.startDate,
    endDate: dates.endDate
    },
    success: function (response) {
    if (!response || response.success !== true || !response.items) {
    return;
    }

    response.items.forEach(function (row) {
    const $panel = findEmployeeMetaPanel(row);
    if (!$panel || $panel.length === 0) {
    return;
    }

    const reason = row.reason || '';
    const count = row.count || 0;

    const $item = $panel.find('.meta-action-rating-item').filter(function () {
    return String($(this).data('meta-action') || '') === reason;
    });

    $item.find('.meta-action-count').text(count);
    });
    }
    });
    }

