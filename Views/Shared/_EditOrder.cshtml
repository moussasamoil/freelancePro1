            // ============================================================
            // NUMERIC INPUT NORMALIZER
            // يحافظ على الكتابة والنسخ واللصق بشكل طبيعي بدون منع Ctrl+V.
            // ============================================================
            function normalizeNumberTextInput(input, allowDecimal) {
                var $input = $(input);
                var oldValue = $input.val() || '';
                var value = toAsciiDigits(oldValue);

                if (allowDecimal) {
                    value = value.replace(/[^0-9.]/g, '');
                    var firstDotIndex = value.indexOf('.');
                    if (firstDotIndex !== -1) {
                        value = value.substring(0, firstDotIndex + 1) + value.substring(firstDotIndex + 1).replace(/\./g, '');
                    }
                } else {
                    value = value.replace(/[^0-9]/g, '');
                }

                if (value !== oldValue) {
                    $input.val(value);
                }
            }

            $modalRoot.on('input', '#TotalPrice, #DeliveryPrice', function () {
                normalizeNumberTextInput(this, true);
                $(this).removeClass('error');
            });

            $modalRoot.on('paste', '#TotalPrice, #DeliveryPrice', function () {
                var input = this;
                setTimeout(function () {
                    normalizeNumberTextInput(input, true);
                    $(input).trigger('input');
                }, 0);
            });

