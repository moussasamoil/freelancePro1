            // ============================================================
            // BOOTSTRAP BLOCK — seed JS state from server-rendered model
            // ============================================================
            selectedStoreId = @(Model.ManufacturingCompanyId.HasValue ? Model.ManufacturingCompanyId.Value.ToString() : "null");

            allWarehouseOptions = @Html.Raw(Json.Serialize(Model.AvailableWarehouses ?? new List<WarehouseOptionVm>()));
            warehouseOptions = allWarehouseOptions.slice();

            allCampaigns = @Html.Raw(Json.Serialize(Model.AvailableCampaigns ?? new List<CampaignOptionVm>()));

            $c('campaignDropdown').data('touched', true);

            updatePhoneNumberValidation(@Html.Raw(Json.Serialize(Model.Country.ToString())));
            // Restore phone value that updatePhoneNumberValidation clears
            $c('TelephoneNumber').val(@Html.Raw(Json.Serialize(Model.TelephoneNumber)));
            $c('TelephoneNumber').data('country', @Html.Raw(Json.Serialize(Model.Country.ToString())));

            toggleSourceNameInput();
            // toggleSourceNameInput() may have wiped #ChatUrl when its source-detection
            // ran before .val() reflected the server-rendered selection. Restore the
            // value from the server model unconditionally after the toggle.
            $c('ChatUrl').val(@Html.Raw(Json.Serialize(Model.chatUrl ?? "")));
            toggleCampaignVisibility();
            toggleProductVisibility();
            // Seed the campaign gallery from server data. Without this, the gallery
            // stays empty until the user touches the store dropdown — which is what
            // triggers populateCampaignDropdown() → renderCampaignGallery().
            renderCampaignGallery();

            // Seed success state on all pre-filled dropdowns from server model
            ['orderSourceDropdown', 'manufacturingCompanyDropdown', 'cityDropdown', 'deliveryPartyDropdown', 'campaignDropdown', 'IsPaid'].forEach(function (id) {
                var $dd = $c(id);
                if ($dd.val()) removeErrorClassAndMessage($dd);
            });

            // Ensure product picker is enabled and reflects the seeded warehouse pool.
            // Server-prerendered product rows must be subtracted from the pool so they
            // don't appear as still-selectable options in the dropdown.
            var prerenderedIds = $c('selectedProductsList')
                .find('.appended-warehouse-row')
                .map(function () { return String($(this).data('warehouse-id')); })
                .get();
            warehouseOptions = warehouseOptions.filter(function (w) {
                return prerenderedIds.indexOf(String(w.id)) === -1;
            });
            productDropdownSelect.prop('disabled', false);
            populateFirstWarehouseDropdown();
            reindexWarehouseRows();

            runTotalPriceValidation();
            updateSubmitButtonState();

            // Run every field's validator once on load so prefilled values get the same
            // error/success spinner treatment they'd get from a user touching+bluring them.
            // The input handlers gate spinner UI behind `event.type === 'input'`, so we
            // dispatch 'blur' (which they also listen to and which falls through to the
            // success/error path without the input-only gating).
            $modalRoot.find('#CustomerName, #Address, #ChatUrl, #SourceName, #TelephoneNumber, #TotalPrice')
                .each(function () { $(this).triggerHandler('blur'); });
            // Select2 dropdowns validate on `select2:close`; firing it directly runs the
            // same empty-vs-valid check without opening the picker.
            $modalRoot.find('#countryDropdown, #cityDropdown, #orderSourceDropdown, #manufacturingCompanyDropdown, #deliveryPartyDropdown, #campaignDropdown, #productDropdown, #GenderDropdown, #IsPaid')
                .each(function () { $(this).trigger('select2:close'); });

            // ============================================================
            // PHOTO / RECEIPT PASTE FIELD VALIDATION (mirrors text-input pattern)
            // ============================================================
            function validatePasteField($field, message) {
                var $container = $field.closest('.form-group');
                $field.removeClass('error success');
                $container.next('.required-message').remove();
                if ($field.find('img').length > 0) {
                    $field.addClass('success');
                } else {
                    $field.addClass('error');
                    $container.after('<div class="required-message">' + message + '</div>');
                }
            }
            function validateOrderPhoto() {
                validatePasteField($('#OrderPhotoPaste'), 'يرجى إرفاق صورة الحجز.');
            }
            function validatePaymentReceipt() {
                // Receipt only required when IsPaid is true; otherwise clear any state.
                var $field = $('#PaymentReceiptPaste');
                if ($c('IsPaid').val() !== 'true') {
                    $field.removeClass('error success');
                    $field.closest('.form-group').next('.required-message').remove();
                    return;
                }
                validatePasteField($field, 'يرجى إرفاق صورة إيصال الحوالة البنكية.');
            }
            validateOrderPhoto();
            validatePaymentReceipt();

            // ---- Order photo: hardened via attachPasteImageField. Paste, drag-and-drop,
            // ---- and a MutationObserver all funnel into the same commit-File path,
            // ---- so the hidden #OrderPhotoFile is reliably populated regardless of
            // ---- which mechanism actually delivered the image.
            orderPhotoField = attachPasteImageField({
                $field: $c('OrderPhotoPaste'),
                fileInputId: 'OrderPhotoFile',
                onCommit: function () { validateOrderPhoto(); updateSubmitButtonState(); },
                onClear: function () { validateOrderPhoto(); updateSubmitButtonState(); }
            });

            // ============================================================
            // PAYMENT STATUS → RECEIPT VISIBILITY (edit form — never required)
            // ============================================================
            // First option ("تم التحويل حوالة بنكية" = paid) reveals the
            // receipt paste row. Any other choice clears and hides it.
            $c('IsPaid').on('change', function () {
                if ($(this).val() === 'true') {
                    $c('paymentReceiptRow').show();
                } else {
                    $c('paymentReceiptRow').hide();
                    $c('PaymentReceiptPaste').empty().removeClass('success');
                    var rf = document.getElementById('PaymentReceiptFile');
                    if (rf) rf.value = '';
                }
                validatePaymentReceipt();
            });

            // ============================================================
            // PAYMENT RECEIPT PASTE — hardened via attachPasteImageField.
            // ============================================================
            paymentReceiptField = attachPasteImageField({
                $field: $c('PaymentReceiptPaste'),
                fileInputId: 'PaymentReceiptFile',
                onCommit: function () { validatePaymentReceipt(); updateSubmitButtonState(); },
                onClear: function () { validatePaymentReceipt(); updateSubmitButtonState(); }
            });

            // ============================================================
            // FORM SUBMIT — posts to Order/Edit/{id}; success just closes modal
            // ============================================================
            $c('editOrderForm').submit(function (event) {
                // Belt-and-braces: re-hydrate the hidden file inputs from any
                // data:-URL <img> still in the paste fields, in case DataTransfer
                // assignment silently no-op'd during paste/drop.
                if (orderPhotoField) orderPhotoField.rescueIfNeeded();
                if (paymentReceiptField) paymentReceiptField.rescueIfNeeded();
                const country = $c('countryDropdown').val();
                const phoneNumber = $c('TelephoneNumber').val();
                const phoneCheck = validatePhone(country, phoneNumber);
                var deliveryPartyValue = $c('deliveryPartyDropdown').val();
                var cityDropdown = $c('cityDropdown');
                var sourceName = $c('SourceName').val();
                var customerName = $c('CustomerName').val();
                var address = $c('Address').val();
                var chaturl = $c('ChatUrl').val();
                if (!sourceName) {
                    $c('SourceName').addClass('error');
                } else {
                    $c('SourceName').removeClass('error');
                }
                if (!customerName) {
                    $c('CustomerName').addClass('error');
                } else {
                    $c('CustomerName').removeClass('error');
                }
                if (!address) {
                    $c('Address').addClass('error');
                } else {
                    $c('Address').removeClass('error');
                }
                if (!chaturl) {
                    $c('ChatUrl').addClass('error');
                } else {
                    $c('ChatUrl').removeClass('error');
                }
                $c('submitButton').prop('disabled', true);
                setTimeout(function () {
                    $c('submitButton').prop('disabled', false);
                }, 40000);
                if (!deliveryPartyValue) {
                    showFormError("الرجاء اختيار طرف التوصيل.");
                    event.preventDefault();
                    return false;
                }
                if ($c('orderSourceDropdown').val() === "2" && containsCapitalOrArabicLetters($c('SourceName').val())) {
                    showFormError('لايمكنك اختيار انستغرام , أدخل اسم صفحة صحيح .');
                    event.preventDefault();
                    return false;
                }
                if (!phoneCheck.valid) {
                    showFormError('يرجى إدخال رقم هاتف صحيح.');
                    event.preventDefault();
                    return false;
                }
                if (cityDropdown.val() === "" || cityDropdown.val() === "المدينة") {
                    showFormError("الرجاء اختيار المدينة.");
                    event.preventDefault();
                    return false;
                }
                if ($c('selectedProductsList').find('.appended-warehouse-row').length === 0) {
                    showFormError("يجب إختيار مستودع واحد على الأقل.");
                    event.preventDefault();
                    return false;
                }
                const customerNameResult = validateCustomerNameForCountry();
                if (!customerNameResult.ok) {
                    showFormError(customerNameResult.message);
                    event.preventDefault();
                    return false;
                }
                if ($c('countryDropdown').val() === 'تركيا' && !validateAddressLatin()) {
                    showFormError('يُسمح فقط بالأحرف اللاتينية والتركية والأرقام والرموز في عناوين طلبات تركيا.');
                    event.preventDefault();
                    return false;
                }
                if ($c('orderSourceDropdown').val() !== "4" && !validateChatUrlAscii()) {
                    event.preventDefault();
                    return false;
                }

                if (!productMinimumSellingPriceIsValid || $c('TotalPrice').hasClass('error')) {
                    var productMinimumMessage = productMinimumSellingPriceMessage || 'السعر أقل من الحد الأدنى لسعر البيع.';
                    showFormError(productMinimumMessage);
                    runTotalPriceValidation();
                    event.preventDefault();
                    return false;
                }
                // Payment receipt is required when payment status is "paid". Either a freshly
                // pasted file (#PaymentReceiptFile) or an existing saved receipt (kept as the
                // <img> already inside #PaymentReceiptPaste) satisfies the rule.
                if ($c('IsPaid').val() === 'true') {
                    var receiptInput = document.getElementById('PaymentReceiptFile');
                    var hasNewReceipt = receiptInput && receiptInput.files && receiptInput.files.length > 0;
                    var hasExistingReceipt = $('#PaymentReceiptPaste').find('img').length > 0;
                    if (!hasNewReceipt && !hasExistingReceipt) {
                        showFormError('يرجى لصق صورة إيصال الحوالة بنكية.');
                        $('#PaymentReceiptPaste').addClass('error');
                        event.preventDefault();
                        return false;
                    }
                    $('#PaymentReceiptPaste').removeClass('error');
                }
                var $campaign = $c('campaignDropdown');
                if ($campaign.data('touched') !== true) {
                    addErrorClassAndMessage($campaign, 'يرجى اختيار الإعلان أو "بدون إعلان".');
                    showFormError('يرجى اختيار الإعلان أو "بدون إعلان".');
                    event.preventDefault();
                    return false;
                }
                // Sentinel "none" → submit as empty so server stores null CampaignId
                if ($campaign.val() === 'none') {
                    $campaign.find('option[value="none"]').val('');
                    $campaign.val('');
                }
                $c('productDropdown').prop('disabled', true);
                var formData = new FormData(this);
                var cfg = COUNTRY_PHONE_CONFIG[country];
                var normalizedPhone = phoneCheck.cleaned;
                if (cfg) {
                    var code = cfg.code;
                    if (normalizedPhone.startsWith('00' + code)) {
                        normalizedPhone = '0' + normalizedPhone.slice(('00' + code).length);
                    } else if (normalizedPhone.startsWith('+' + code)) {
                        normalizedPhone = '0' + normalizedPhone.slice(('+' + code).length);
                    } else if (country === 'ليبيا' && /^9\d{8}$/.test(normalizedPhone)) {
                        // Libya accepts local form with or without leading 0; canonicalize to "09…" on submit.
                        normalizedPhone = '0' + normalizedPhone;
                    }
                }
                formData.set('TelephoneNumber', normalizedPhone);
                $.ajax({
                    type: "POST",
                    url: '@Url.Action("Edit", "Order", new { id = Model.Id })',
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function (response) {
                        if (response.message) {
                            var errorMessage = response.message;
                            $modalRoot.find('.message').text(errorMessage);
                            $c('failedmessageEdit').removeClass('hidden').css('display', 'block');
                            $c('overlay').show();
                        } else {
                            // Just close — _DetailsPartial's hidden.bs.modal handler refreshes the parent.
                            $modalRoot.modal('hide');
                        }
                    },
                    error: function (xhr, status, error) {
                        console.error("AJAX Error:", status, error);

                        var errorMessage = "حدث خطأ أثناء التعديل. الرجاء المحاولة مرة أخرى.";

                        try {
                            var response = xhr.responseJSON || JSON.parse(xhr.responseText || "{}");
                            errorMessage = response.message || errorMessage;
                        } catch (e) {
                            if (xhr.responseText) {
                                errorMessage = xhr.responseText;
                            }
                        }

                        // تظهر الرسالة داخل الفورم فوق زر تأكيد التعديل بدل الـ popup/overlay.
                        showFormError(errorMessage);

                        $c('submitButton').prop('disabled', false);
                        $c('overlay').hide();
                        $c('failedmessageEdit').addClass('hidden').hide();
                    }
                });
                event.preventDefault();
            });

            // ============================================================
            // SELECT2 CLEANUP — destroy instances on modal close to prevent
            // orphaned containers when the next AJAX-injected open arrives.
            // ============================================================
            $modalRoot.on('hidden.bs.modal', function () {
                $modalRoot.find('.select2-hidden-accessible').each(function () {
                    try { $(this).select2('destroy'); } catch (e) { }
                });
            });
        });
    })();
</script>


<style>
    /* تعطيل البوب أب القديم نهائيًا عشان مايغطيش المدخلات ولا يمنع Ctrl+V */
    .legacy-popup-error-disabled,
    #failedmessage.legacy-popup-error-disabled,
    #failedmessageEdit.legacy-popup-error-disabled {
        display: none !important;
        pointer-events: none !important;
        visibility: hidden !important;
    }

    /* رسالة الخطأ الجديدة تظهر فوق زر التأكيد مباشرة */
    .form-inline-error-message {
        margin: 12px auto 14px auto !important;
        max-width: 92% !important;
    }
</style>
