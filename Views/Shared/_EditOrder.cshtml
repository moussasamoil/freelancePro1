            // ============================================================
            // SUBMIT BUTTON STATE + FINAL FORM VALIDATION / SUBMIT
            // ============================================================
            function areInputsValid() {
                var isWhatsApp = $c('orderSourceDropdown').val() === "4";
                const inputIDs = [
                    'countryDropdown',
                    'cityDropdown',
                    'orderSourceDropdown',
                    'manufacturingCompanyDropdown',
                    'deliveryPartyDropdown',
                    'TelephoneNumber',
                    'CustomerName',
                    'Address',
                ];
                if (!isWhatsApp) {
                    inputIDs.push('ChatUrl');
                }
                const areStandardInputsValid = inputIDs.every(id => {
                    const value = $c(id).val();
                    return value !== '' && value != null;
                });
                const totalPriceValue = $c('TotalPrice').val().trim();
                const isTotalPriceValid = totalPriceValue !== '' && !isNaN(parseFloat(totalPriceValue)) && isFinite(totalPriceValue);
                const hasProduct = $c('selectedProductsList').find('.appended-warehouse-row').filter(function () {
                    const id = parseInt($(this).find('input[name$=".WarehouseId"]').val(), 10);
                    const amt = parseInt($(this).find('input.amount').val(), 10);
                    return id > 0 && amt > 0;
                }).length > 0;
                // Photo: a freshly pasted file OR a pre-loaded saved image satisfies the rule.
                var photoInput = document.getElementById('OrderPhotoFile');
                const hasNewPhoto = !!(photoInput && photoInput.files && photoInput.files.length > 0);
                const hasExistingPhoto = $('#OrderPhotoPaste').find('img').length > 0;
                const photoOk = hasNewPhoto || hasExistingPhoto;
                // Receipt: required when IsPaid==true. Either a new paste or pre-loaded saved receipt counts.
                var receiptOk = true;
                if ($c('IsPaid').val() === 'true') {
                    var receiptInput = document.getElementById('PaymentReceiptFile');
                    const hasNewReceipt = !!(receiptInput && receiptInput.files && receiptInput.files.length > 0);
                    const hasExistingReceipt = $('#PaymentReceiptPaste').find('img').length > 0;
                    receiptOk = hasNewReceipt || hasExistingReceipt;
                }
                const productMinimumOk = productMinimumSellingPriceIsValid && !$c('TotalPrice').hasClass('error');

                return areStandardInputsValid && isTotalPriceValid && productMinimumOk && hasProduct && photoOk && receiptOk;
            }
            function updateSubmitButtonState() {
                const isValid = areInputsValid();
                if (showDebugQuery) {
                    console.log(`[DEBUG] updateSubmitButtonState() - isValid: ${isValid}`);
                }
                $c('submitButton').prop('disabled', !isValid);
            }
            $modalRoot.find('#TotalPrice,#TelephoneNumber,#deliveryPartyDropdown,#CustomerName,#Address,#ChatUrl,#campaignDropdown,#countryDropdown,#cityDropdown,#orderSourceDropdown,#manufacturingCompanyDropdown,#IsPaid').on('input change', function () {
                updateSubmitButtonState();
