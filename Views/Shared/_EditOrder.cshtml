<script>
    //# sourceURL=_EditOrder.js
    (function () {
        // ============================================================
        // STATE & CONSTANTS
        // ============================================================
        var $modalRoot = $('#Edit');
        function $c(id) { return $modalRoot.find('#' + id.replace(/^#/, '')); }

        var showDebugQuery = false;
        var warehouseOptions = [];
        var allWarehouseOptions = [];
        var storesData = [];
        var selectedStoreId = null;
        var allCampaigns = [];
        var citiesByCountry = @Html.Raw(Json.Serialize(lotus_blue.Models.Common.CitiesByCountry));
        var phoneCodesByCountry = @Html.Raw(Json.Serialize(lotus_blue.Models.Common.PhoneNumberCodesByCountry.ToDictionary(kv => kv.Key.ToString(), kv => kv.Value)));
        var modelState = @Html.Raw(Json.Serialize(Model?.State));
        var $currentRowToDelete;
        var productDropdownSelect;
        var productMinimumSellingPriceIsValid = true;
        var productMinimumSellingPriceMessage = '';
        var productMinimumSellingPriceXhr;
        var productMinimumSellingPriceTimer;

        function normalizePhoneForDisplay(raw, countryName) {
            if (!raw) return '';
            var cleaned = String(raw).replace(/[-\s]/g, '');
            if (!cleaned) return '';
            var code = phoneCodesByCountry[countryName];
            if (!code) return cleaned;
            var digits = code.replace(/^\+/, '');
            if (cleaned.indexOf('00' + digits) === 0) return '+' + cleaned.substring(2);
            if (cleaned.indexOf('+' + digits) === 0) return cleaned;
            if (cleaned.charAt(0) === '0') return '+' + digits + cleaned.substring(1);
            return '+' + digits + cleaned;
        }

        // =========================================================================
        // PASTE-IMAGE FIELD HARDENING (used by #OrderPhotoPaste and #PaymentReceiptPaste)
        // =========================================================================
        // A MutationObserver on the contenteditable is the source of truth: any new
        // <img> child triggers reconciliation against the hidden file input; removing
        // it clears the input. This survives the cases where paste/input events don't
        // fire (img-only DOM mutations, embedded webviews where clipboardData.items
        // is null, browsers whose default contenteditable paste inserts blob: <img>
        // directly). Replaces the older `input keyup`-driven cleanup that silently
        // nuked the file input whenever an intermediate DOM state had no <img>.
        //
        // rescueIfNeeded() is called at submit time to hydrate the file input
        // synchronously from any data:-URL <img> still in the field, covering the
        // environments where DataTransfer assignment quietly no-ops.
        //
        // Note: on edit, the field is pre-loaded with <img src="/saved.jpg"> for
        // existing photos. The observer doesn't fire for initial children, and
        // rescue is a no-op for http(s)/relative srcs — those are kept server-side
        // via the ExistingPhotoUrl / ExistingPaymentReceiptUrl hidden inputs.
        function attachPasteImageField(opts) {
            var $field = opts.$field;
            var fileInputId = opts.fileInputId;
            var onCommit = opts.onCommit || function () {};
            var onClear = opts.onClear || function () {};
            var imgStyle = 'max-height:120px;max-width:100%;object-fit:contain;';

            if (!$field || $field.length === 0) return null;
            var fileInput = document.getElementById(fileInputId);
            if (!fileInput) return null;
            var fieldEl = $field[0];
            var suppressMutation = false;

            function dataUrlToFile(dataUrl, filename) {
                try {
                    var arr = dataUrl.split(',');
                    var mimeMatch = arr[0].match(/:(.*?);/);
                    if (!mimeMatch) return null;
                    var mime = mimeMatch[1];
                    var bstr = atob(arr[1]);
                    var n = bstr.length;
                    var u8 = new Uint8Array(n);
                    while (n--) u8[n] = bstr.charCodeAt(n);
                    return new File([u8], filename, { type: mime });
                } catch (err) { return null; }
            }
            function setFileInput(file) {
                try {
                    var dt = new DataTransfer();
                    dt.items.add(file);
                    fileInput.files = dt.files;
                } catch (err) {
                    // Some embedded webviews block DataTransfer assignment; the File
                    // still lives on $field.data so submit-time rescue can re-try.
                }
                $field.data('committedFile', file);
            }
            function commitFile(file) {
                setFileInput(file);
                var reader = new FileReader();
                reader.onload = function (ev) {
                    suppressMutation = true;
                    $field.html('<img src="' + ev.target.result + '" style="' + imgStyle + '" />');
                    $field.addClass('success').removeClass('error');
                    setTimeout(function () { suppressMutation = false; }, 0);
                    onCommit(file);
                };
                reader.readAsDataURL(file);
            }
            function rescueFromImg(img) {
                var src = img.getAttribute('src') || '';
                if (src.indexOf('data:') === 0) {
                    var f = dataUrlToFile(src, 'pasted-image.png');
                    if (f) commitFile(f);
                } else if (src.indexOf('blob:') === 0) {
                    fetch(src).then(function (r) { return r.blob(); }).then(function (blob) {
                        var f = new File([blob], 'pasted-image.png', { type: blob.type || 'image/png' });
                        commitFile(f);
                    }).catch(function () {});
                }
                // http(s)/relative srcs are saved DB images on edit; the controller
                // keeps them via Existing*Url when no new file is uploaded.
            }
            function clearAll() {
                try { fileInput.value = ''; } catch (e) {}
                $field.removeData('committedFile');
                $field.removeClass('success');
                onClear();
            }

            var observer = new MutationObserver(function () {
                if (suppressMutation) return;
                var $img = $field.find('img').first();
                if ($img.length === 0) {
                    if ((fileInput.files && fileInput.files.length > 0) || $field.data('committedFile')) {
                        clearAll();
                    } else {
                        $field.removeClass('success');
                        onClear();
                    }
                    return;
                }
                if (fileInput.files && fileInput.files.length > 0) return;
                rescueFromImg($img[0]);
            });
            observer.observe(fieldEl, { childList: true, subtree: true, attributes: true, attributeFilter: ['src'] });

            $field.on('paste.pasteField', function (e) {
                var orig = e.originalEvent || e;
                var items = orig.clipboardData && orig.clipboardData.items;
                if (!items) return; // Let browser default run; observer reconciles.
                var hasText = false;
                for (var i = 0; i < items.length; i++) {
                    if (items[i].kind === 'file' && items[i].type.indexOf('image/') === 0) {
                        e.preventDefault();
                        var file = items[i].getAsFile();
                        if (file) commitFile(file);
                        return;
                    }
                    if (items[i].kind === 'string') hasText = true;
                }
                if (hasText) e.preventDefault();
            });

            return {
                rescueIfNeeded: function () {
                    if (fileInput.files && fileInput.files.length > 0) return;
                    var saved = $field.data('committedFile');
                    if (saved) {
                        try {
                            var dt = new DataTransfer();
                            dt.items.add(saved);
                            fileInput.files = dt.files;
                            return;
                        } catch (e) {}
                    }
                    var $img = $field.find('img').first();
                    if ($img.length === 0) return;
                    var src = $img.attr('src') || '';
                    if (src.indexOf('data:') !== 0) return;
                    var f = dataUrlToFile(src, 'pasted-image.png');
                    if (!f) return;
                    try {
                        var dt2 = new DataTransfer();
                        dt2.items.add(f);
                        fileInput.files = dt2.files;
                    } catch (e) {}
                }
            };
        }

        $(function () {
            var orderPhotoField = null;
            var paymentReceiptField = null;
            productDropdownSelect = $c('productDropdown');

            // ============================================================
            // SELECT2 INIT & GENERIC DROPDOWN ERROR HELPERS
            // ============================================================
            function formatOption(option) {
                var imageUrl = $(option.element).data('image');
                var imageTag = imageUrl ? '<img src="' + imageUrl + '" class="img-flag" style="margin-right: 5px; width: 14px; height: 14px;" />' : '';
                return $('<span>' + imageTag + option.text + '</span>');
            }
            function initAllSelect2Dropdowns() {
                $modalRoot.find('#orderSourceDropdown, #manufacturingCompanyDropdown, #cityDropdown, #deliveryPartyDropdown, #productDropdown, #GenderDropdown, #IsPaid,#campaignDropdown').each(function () {
                    var $dropdown = $(this);
                    $dropdown.select2({
                        templateResult: formatOption,
                        templateSelection: formatOption,
                        dropdownParent: $('#Edit'),
                        dir: "rtl",
                        minimumResultsForSearch: 1,
                    });
                    $dropdown.on('select2:close', function () {
                        // The product picker is a special case: its value is reset to the
                        // placeholder after each pick, so emptiness doesn't mean "nothing chosen".
                        // Treat any appended product row as a valid selection.
                        if ($dropdown.attr('id') === 'productDropdown'
                            && $c('selectedProductsList').find('.appended-warehouse-row').length > 0) {
                            removeErrorClassAndMessage($dropdown);
                            return;
                        }
                        if (!$dropdown.val()) {
                            addErrorClassAndMessage($dropdown, getErrorMessage($dropdown));
                        } else {
                            removeErrorClassAndMessage($dropdown);
                        }
                    });
                });
            }
            initAllSelect2Dropdowns();

            // "بدون إعلان" is a conscious choice; never opening the dropdown is not.
            $c('campaignDropdown').on('select2:open change', function () {
                $(this).data('touched', true);
            });

            // Update gallery when campaign selection changes
            $c('campaignDropdown').on('change', function () {
                var selectedValue = $(this).val();
                $modalRoot.find('.campaign-card').removeClass('selected');
                // 'none' is the بدون إعلان sentinel — the card with data-campaign-id="none"
                // should receive the selected state (and ✓ badge) just like any real campaign.
                if (selectedValue && selectedValue !== '') {
                    $modalRoot.find('.campaign-card[data-campaign-id="' + selectedValue + '"]').addClass('selected');
                }
            });

            // Render campaign gallery when campaigns are available
            function renderCampaignGallery() {
                var filtered = getFilteredCampaigns();
                var $gallery = $c('campaignGallery');
                var $wrap = $c('campaignGalleryWrap');

                if (!filtered || filtered.length === 0) {
                    $wrap.hide();
                    return;
                }

                var galleryHtml = '';
                var currentValue = $c('campaignDropdown').val();

                // Real campaigns first (reversed so newest appear first); the
                // "no selection" card is appended at the end of the gallery.
                filtered.slice().reverse().forEach(function (campaign) {
                    var isSelected = currentValue === String(campaign.id);
                    galleryHtml += '<div class="campaign-card' + (isSelected ? ' selected' : '') + '" data-campaign-id="' + campaign.id + '" onclick="selectCampaignFromGalleryEdit(' + campaign.id + ')">' +
                        '<div class="campaign-card-img-wrap">' +
                        '<img src="' + (campaign.imageUrl || '/mainicons/fallback_product.svg') + '" alt="' + campaign.name + '" onerror="this.onerror=null; this.src=\'/mainicons/fallback_product.svg\';" />' +
                        '</div>' +
                        '<div class="campaign-card-name">' + campaign.name + '</div>' +
                        '<div class="campaign-card-badge">&#x2713;</div>' +
                        '</div>';
                });

                // "no selection" card last — value is the 'none' sentinel that matches
                // the static <option value="none">بدون إعلان</option>, so picking it
                // is a real, conscious choice.
                var isNoSelectionSelected = currentValue === 'none';
                galleryHtml += '<div class="campaign-card' + (isNoSelectionSelected ? ' selected' : '') + '" data-campaign-id="none" onclick="selectCampaignFromGalleryEdit(\'none\')">' +
                    '<div class="campaign-card-img-wrap" style="background: #f0f0f0; display: flex; align-items: center; justify-content: center;">' +
                    '<span style="color: #999; font-size: 24px;">✕</span>' +
                    '</div>' +
                    '<div class="campaign-card-name">بدون إعلان</div>' +
