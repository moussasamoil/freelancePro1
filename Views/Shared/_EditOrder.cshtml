                'البحرين': { code: '973', lengths: [13, 12, 8], patterns: [/^00973[36]\d{7}$/, /^\+973[36]\d{7}$/, /^[36]\d{7}$/] },
                'تونس': { code: '216', lengths: [13, 12, 8], patterns: [/^00216[23459]\d{7}$/, /^\+216[23459]\d{7}$/, /^[23459]\d{7}$/] },
                'الكويت': { code: '965', lengths: [13, 12, 8], patterns: [/^00965[4569]\d{7}$/, /^\+965[4569]\d{7}$/, /^[4569]\d{7}$/] },
                'السعودية': { code: '966', lengths: [14, 13, 10], patterns: [/^009665\d{8}$/, /^\+9665\d{8}$/, /^05\d{8}$/] },
                'قطر': { code: '974', lengths: [13, 12, 8], patterns: [/^00974[3567]\d{7}$/, /^\+974[3567]\d{7}$/, /^[3567]\d{7}$/] },
                'فلسطين': { code: '970', lengths: [14, 13, 10], patterns: [/^009705\d{8}$/, /^\+9705\d{8}$/, /^05\d{8}$/] },
                'الأردن': { code: '962', lengths: [14, 13, 10], patterns: [/^009627\d{8}$/, /^\+9627\d{8}$/, /^07\d{8}$/] },
            };
            function detectPhoneType(cleaned) {
                if (cleaned.startsWith('00')) return 0;
                if (cleaned.startsWith('+')) return 1;
                return 2;
            }
            function toAsciiDigits(str) {
                return String(str).replace(/[٠-٩۰-۹]/g, function (d) {
                    const code = d.charCodeAt(0);
                    return String.fromCharCode(code - (code >= 0x06F0 ? 0x06F0 : 0x0660) + 0x30);
                });
            }
            function validatePhone(country, raw) {
                // Whitelist: convert Arabic/Persian digits to ASCII, then strip anything that isn't
                // a digit or '+'. This neutralizes pasted noise — invisible bidi marks, dashes, spaces,
                // parentheses, dots, letters — without us having to enumerate every possible character.
                const cleaned = toAsciiDigits(raw).replace(/[^0-9+]/g, '');
                const cfg = COUNTRY_PHONE_CONFIG[country];
                if (!cfg || cleaned.length === 0) return { valid: false, cleaned };
                const type = detectPhoneType(cleaned);
                const pattern = cfg.patterns[type];
                const len = cfg.lengths[type];
                const lenOk = Array.isArray(len) ? len.includes(cleaned.length) : cleaned.length === len;
                const valid = lenOk && pattern.test(cleaned);
                return { valid, cleaned, type };
            }
            function updatePhoneNumberValidation(country) {
                const $phone = $c('TelephoneNumber');
                const cfg = COUNTRY_PHONE_CONFIG[country];
                const maxInputLen = cfg ? cfg.lengths[0] + 6 : 20;
                $phone
                    .removeAttr('pattern')
                    .removeAttr('minlength')
                    .attr('maxlength', maxInputLen)
                    .data('country', country)
                    .removeClass('error success');
                $phone.closest('.form-group').next('.required-message').remove();
                phoneErrorMessageShown = false;
            }
            let phoneErrorMessageShown = false;
            let spinnerTimeout;
            $c('TelephoneNumber').on('input paste', function () {
                const inputElement = $(this);

                setTimeout(function () {
                    const currentVal = inputElement.val() || '';
                    const asciiVal = toAsciiDigits(currentVal).replace(/[^0-9+]/g, '');

                    if (asciiVal !== currentVal) {
                        inputElement.val(asciiVal);
                    }

                    const country = inputElement.data('country');
                    const result = validatePhone(country, inputElement.val());
                    const isValid = result.valid;
                    const $container = inputElement.closest('.form-group');
                    const $spinner = $container.find('.spinner-icon');

                    clearTimeout(spinnerTimeout);
                    $spinner.hide();

                    // أثناء الكتابة لا نمنع ولا نهز ولا نخفي باقي الفورم.
                    inputElement.removeClass('error');
                    if (phoneErrorMessageShown) {
                        $container.next('.required-message').remove();
                        phoneErrorMessageShown = false;
                    }

                    if (isValid) {
                        inputElement.addClass('success');
                        $c('secondPhoneCol').show();
                        $c('primaryPhoneCol').removeClass('col-12').addClass('col-6');
                    } else {
                        inputElement.removeClass('success');
                    }

                    updateSubmitButtonState();
                }, 0);
            });

            $c('TelephoneNumber').on('blur', function () {
                const inputElement = $(this);
