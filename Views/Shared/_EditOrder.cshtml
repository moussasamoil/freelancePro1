            // ============================================================
            // PHONE NUMBER (per-country length & pattern rules)
            // ============================================================
            const COUNTRY_PHONE_CONFIG = {
                'العراق': { code: '964', lengths: [15, 14, 11], patterns: [/^009647\d{9}$/, /^\+9647\d{9}$/, /^07\d{9}$/] },
