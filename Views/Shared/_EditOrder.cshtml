﻿
<style>
    /* يمنع رعشة حقول الأرقام أثناء الكتابة */
    #TelephoneNumber.error,
    #SecondTelephoneNumber.error,
    #TotalPrice.error,
    #DeliveryPrice.error,
    input.amount.error,
    .numeric-no-shake.error {
        animation: none !important;
        transform: none !important;
    }
</style>

@model lotus_blue.Models.ViewModel.OrderViewModel
@inject lotus_blue.Services.GetCurrentTimeInIstanbul TimeService
@using lotus_blue.Models
@using lotus_blue.Models.ViewModel
@using OrderSourceEnum = lotus_blue.Models.OrderSourceEnum
@* Prevents accidental close during order editing — static backdrop and no keyboard dismiss *@
<div class="modal   rtl  modal-dialog-centered" id="Edit" data-bs-keyboard="false" data-bs-backdrop="static" tabindex="-1" aria-labelledby="Edit" aria-hidden="true">
    @* Large size to fit the full order form without scrolling *@
    <div class="modal-dialog modal-lg modal-dialog-centered " style="position: relative;">
        @* Relative position required so the loading overlay (absolute) is scoped to this panel *@
        <div class="modal-content background-white-green" style="position: relative;">
            <div id="overlay" style="display: none; position: absolute; top: 0; left: 0; width: 100%; height: 100%; background-color: rgba(33, 37, 41, 0.1); z-index: 10;"></div>
            <div id="deleteProductConfirmEdit" style="position: fixed; inset: 0; z-index: 9999; display: none; background: rgba(33,37,41,0.55); align-items: center; justify-content: center;">
                <div class="row justify-content-center align-items-center" style="width: 100%; margin: 0;">
                    <div style="background-color:white" class="w-30 flex-column b-r-8 d-flex justify-content-center">
                        <div class="">
                            <div class="text-center pt-3">
                                <img src="/static/trash-can-regular.svg" width="50">
                            </div>
                            <p class="text-center pb-3 text-nowrap"> هل أنت متأكد من حذف المستودع .</p>
                        </div>
                        <div class="border-top">
                            <div class="row">
                                <div class="col-6 py-2 text-center text-green-v2 text-decoration-underline" id="confirm-remove">
                                    موافقه
                                </div>
                                <div class="col-6 py-2 text-center border-right text-grey-v2 text-decoration-underline" id="cancel-remove">
                                    تراجع
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            @* Modal header: title + cancel/confirm dismiss buttons *@
            <div class="modal-header">
                <button type="button" class="btn head-16 text-green" data-bs-dismiss="modal" aria-label="Close"> تراجع</button>
                <h5 class="modal-title  head text center" id="editOrderModalTitle"> تعديل الطلب</h5>
                <button type="button" class="btn head-16 text-green" data-bs-dismiss="modal" aria-label="Close"> انتهى</button>
            </div>
            <div class="modal-body">
                <form id="editOrderForm">
                    @* Hidden Id so OrderController.Edit(int id, OrderViewModel) binds correctly *@
                    <input type="hidden" name="Id" value="@Model.Id" />
                    <div class="row d-flex justify-content-center">
                        @* Country and city selection — server-prefilled *@
                        <div class="row">
                            <div class="col-6" id="countryCol">
                                <div class="form-group">
                                    <input type="text" class="form-control with-bg-image-country" readonly
                                           value="@Model.Country"
                                           style="background-image: url('@Common.GetImageUrlByCountryName(Model.Country.ToString())');" />
                                    <input type="hidden" name="Country" value="@Model.Country" id="countryDropdown" />
                                </div>
                            </div>
                            @* Cities server-rendered for the order's country *@
                            <div class="col-6" id="cityCol">
                                <div class="form-group ">
                                    <select asp-for="State" class="form-control" id="cityDropdown" required>
                                        <option data-image="/static/city-regular.svg" value="">المدينة</option>
                                        @if (lotus_blue.Models.Common.CitiesByCountry.ContainsKey(Model.Country))
                                        {
                                            foreach (var city in lotus_blue.Models.Common.CitiesByCountry[Model.Country])
                                            {
                                                <option value="@city"
                                                        data-image="/static/city-regular.svg"
                                                        selected="@(city == Model.State ? "selected" : null)">@city</option>
                                            }
                                        }
                                    </select>
                                    <span asp-validation-for="State" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                        @* Order source type and page name *@
                        <div class="row mt-3">
                            @* Shown when a non-WhatsApp source is selected *@
                            <div class="col-6 " id="sourceNameCol" style="@(Model.OrderSource != OrderSourceEnum.واتساب ? "" : "display: none;")">
                                <div class="form-group input-wrapper w-sm-100">
                                    <input placeholder="اسم الصفحة" id="SourceName" asp-for="SourceName" disabled="@(Model.OrderSource != OrderSourceEnum.واتساب ? null : "disabled")" class=" form-control with-bg-image-pagename" />
                                    <i class="fa-duotone fa-spinner-third fa-spin spinner-icon"></i>
                                    <span asp-validation-for="SourceName" class="text-danger"></span>
                                </div>
                            </div>
                            @* Source dropdown — shrinks to col-6 if source is selected *@
                            <div class="col-@(Model.OrderSource != OrderSourceEnum.واتساب ? "6" : "12") " id="orderSourceCol">
                                <div class="form-group">
                                    <select asp-for="OrderSource" class="form-control" id="orderSourceDropdown" required>
                                        <option data-image="/static/hashtag-regular.svg" value="" disabled>نوع الصفحة</option>
                                        @foreach (OrderSourceEnum source in Enum.GetValues(typeof(OrderSourceEnum)))
                                        {
                                            <option value="@((int)source)"
                                                    data-image="@Common.GetSocialMediaIconUrl(source)"
                                                    selected="@((int)source == (int)Model.OrderSource ? "selected" : null)">
                                                @source
                                            </option>
                                        }
                                    </select>
                                    <span asp-validation-for="OrderSource" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                        @* Store (manufacturing company) and merged delivery party selection *@
                        <div class="row mt-3">
                            @{
                                bool showDeliveryCol = Model.AvailableDeliveryParties != null && Model.AvailableDeliveryParties.Count > 1;
                            }
                            @* Store column: server-rendered with preselected store *@
                            <div class="@(showDeliveryCol ? "col-6" : "col-12") " id="storeCol">
                                <div class="form-group">
                                    <select asp-for="ManufacturingCompanyId" class="form-control" id="manufacturingCompanyDropdown" required>
                                        <option data-image="/static/building-regular.svg" value="" disabled>اسم المتجر </option>
                                        @if (Model.AvailableStores != null)
                                        {
                                            foreach (var store in Model.AvailableStores)
                                            {
                                                <option value="@store.id"
                                                        data-image="@store.logoUrl"
                                                        data-main-warehouse-id="@(store.mainWarehouseId?.ToString() ?? "")"
                                                        selected="@(store.id == Model.ManufacturingCompanyId ? "selected" : null)">@store.name</option>
                                            }
                                        }
                                    </select>
                                    <span asp-validation-for="ManufacturingCompanyId" class="text-danger"></span>
                                </div>
                            </div>
                            @* Merged delivery party column: server-rendered; shown only when more than one option *@
                            <div class="col-6 " id="deliveryCompanyCol" style="@(showDeliveryCol ? "" : "display: none;")">
                                <div class="form-group">
                                    <select id="deliveryPartyDropdown" asp-for="DeliveryCompanyId" class="form-control" required>
                                        <option data-image="/static/truck-regular.svg" value="" disabled>اختر طرف التوصيل</option>
                                        @if (Model.AvailableDeliveryParties != null)
                                        {
                                            foreach (var dp in Model.AvailableDeliveryParties)
                                            {
                                                <option value="@dp.id"
                                                        data-image="@dp.logoUrl"
                                                        data-is-delivery-rep="@(dp.isRepresentative ? "true" : "false")"
                                                        selected="@(dp.id == Model.DeliveryCompanyId ? "selected" : null)">@dp.name</option>
                                            }
                                        }
                                    </select>
                                    <span asp-validation-for="DeliveryCompanyId" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                        @* Customer contact: primary and secondary phone numbers *@
                        <div class="row mt-3" id="phoneRow">
                            <div class="col-6" id="primaryPhoneCol">
                                <div class="form-group w-sm-100 input-wrapper">
                                    <input type="tel" inputmode="tel" autocomplete="off" required placeholder="رقم الهاتف الأول" asp-for="TelephoneNumber" class="  form-control with-bg-image-phonenumber  numeric-no-shake" />
                                    <i class="fa-duotone fa-spinner-third fa-spin spinner-icon"></i>
                                    <span asp-validation-for="TelephoneNumber" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-6" id="secondPhoneCol">
                                <div class="form-group">
                                    <input type="tel" inputmode="tel" autocomplete="off" placeholder="رقم الهاتف الثاني (اختياري) " id="SecondTelephoneNumber" asp-for="SecondTelephoneNumber" class="form-control with-bg-image-phonenumber numeric-no-shake" />
                                    <span asp-validation-for="SecondTelephoneNumber" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                        @* Customer name. Notes moved to its own row beneath payment status. *@
                        <div class="row mt-3">
                            <div class="col-12 ">
                                <div class="form-group w-sm-100 input-wrapper">
                                    <input required placeholder="اسم العميل " id="CustomerName" asp-for="CustomerName" class="form-control  with-bg-image-client" />
                                    <i class="fa-duotone fa-spinner-third fa-spin spinner-icon"></i>
                                    <span asp-validation-for="CustomerName" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                        @* Order metadata: from-comments flag, creation date, payment status *@
                        <div class="row mt-3 ">
                            <div class="form-group col-6 " style="display: none;">
                                <div class="form-group ">
                                    <select asp-for="FromComments" class="form-control w-100" id="CommentsDropdown">
                                        <option value="" data-image="/static/comment-regular.svg">التعليقات</option>
                                        <option value="true" data-image="/static/check-regular.svg" selected="@(Model.FromComments ? "selected" : null)">نعم </option>
                                        <option value="false" data-image="/static/x-regular.svg" selected="@(!Model.FromComments ? "selected" : null)">لا</option>
                                    </select>
                                    <span asp-validation-for="FromComments" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="form-group col-6  ">
                                <div class="form-group ">
                                    <input required asp-for="CreatedDate" name="CreatedDate" value="@Model.CreatedDate.ToString("yyyy-MM-ddTHH:mm:ss")" type="datetime-local" class="form-control text-end with-bg-image-calendar calendar  pe-2 ps-2" />
                                    <span asp-validation-for="CreatedDate" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="form-group col-6  " id="paymentCol">
                                <div class="form-group ">
                                    <select asp-for="IsPaid" class="form-control w-sm-100 " id="IsPaid">
                                        <option data-image="/static/credit-card-front-regular.svg" value="">طريقة الدفع (اختياري)</option>
                                        <option value="true" data-image="/static/credit-card-front-regular.svg" selected="@(Model.IsPaid ? "selected" : null)">تم التحويل حوالة بنكية</option>
                                        <option value="false" data-image="/static/credit-card-front-regular.svg" selected="@(!Model.IsPaid ? "selected" : null)">غير مدفوع</option>
                                    </select>
                                    <span asp-validation-for="Gender" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                        @* Payment receipt — paste-only field, optional on edit. Visible only when IsPaid is "paid".
                        Prefilled with the saved receipt when present; ExistingPaymentReceiptUrl is posted back so the controller keeps the original if untouched. *@
                        <div class="row mt-3" id="paymentReceiptRow" style="@(Model.IsPaid ? "" : "display: none;")">
                            <div class="col-12 ">
                                <div class="form-group w-100 input-wrapper">
                                    <div id="PaymentReceiptPaste" class="form-control" contenteditable="true" data-placeholder="صورة إيصال الحوالة بنكية" style="min-height:38px;cursor:text;">@if (!string.IsNullOrEmpty(Model.PaymentReceiptUrl))
                                        {
                                            <img src="@Model.PaymentReceiptUrl" style="max-height:120px;max-width:100%;object-fit:contain;" />
                                        }</div>
                                    <input type="file" name="PaymentReceiptFile" id="PaymentReceiptFile" accept="image/*" style="display:none;" />
                                    <input type="hidden" name="ExistingPaymentReceiptUrl" value="@Model.PaymentReceiptUrl" />
                                </div>
                            </div>
                        </div>
                        @* Notes — own row beneath payment status. Optional. *@
                        <div class="row mt-3">
                            <div class="col-12 ">
                                <div class="form-group">
                                    <input placeholder="الملاحظات (اختياري)" id="Notes" asp-for="Notes" class="form-control with-bg-image-note" />
                                    <span asp-validation-for="Notes" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                        @* Full delivery address *@
                        <div class="row mt-3 ">
                            <div class="col-12 ">
                                <div class="form-group w-100 input-wrapper">
                                    <input required placeholder="العنوان بالكامل" id="Address" asp-for="Address" class="form-control with-bg-image-address" />
                                    <i class="fa-duotone fa-spinner-third fa-spin spinner-icon"></i>
                                    <span asp-validation-for="Address" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                        @* Chat URL — hidden for WhatsApp *@
                        <div class="row mt-3 " id="chatUrlRow" style="@(Model.OrderSource != OrderSourceEnum.واتساب ? "" : "display: none;")">
                            <div class="col-12 ">
                                <div class="form-group w-100 input-wrapper">
                                    <input @(Model.OrderSource != OrderSourceEnum.واتساب ? "required" : "") placeholder="رابط المحادثة" id="ChatUrl" name="chatUrl" value="@Model.chatUrl" class="form-control with-bg-image-address" />
                                    <i class="fa-duotone fa-spinner-third fa-spin spinner-icon"></i>
                                    <span asp-validation-for="chatUrl" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                        @* Ad campaign selection — gallery only, dropdown hidden *@
                        <div class="row mt-3 " id="campaignRow" style="display: none;">
                            <div class="col-12 ">
                                <div class="form-group" style="position: relative;">
                                    <select id="campaignDropdown" asp-for="CampaignId" class="form-control" data-touched="true" style="display: none;">
                                        <option value="" disabled hidden>اختر الإعلان</option>
                                        <option data-image="/static/truck-regular.svg" value="none" selected="@(!Model.CampaignId.HasValue ? "selected" : null)">بدون إعلان</option>
                                        @if (Model.AvailableCampaigns != null)
                                        {
                                            foreach (var campaign in Model.AvailableCampaigns)
                                            {
                                                if (campaign.manufacturingCompanyId.HasValue && campaign.manufacturingCompanyId == Model.ManufacturingCompanyId)
                                                {
                                                    <option value="@campaign.id"
                                                            data-image="@campaign.imageUrl"
                                                            selected="@(campaign.id == Model.CampaignId ? "selected" : null)">@campaign.name</option>
                                                }
                                            }
                                        }
                                    </select>
                                    <span asp-validation-for="CampaignId" class="text-danger"></span>
                                    <div id="campaignGalleryWrap" style="display: none;">
                                        <div id="campaignGallery" class="campaign-gallery"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        @* Order screenshot — paste-only field. Prefilled with the saved photo when present.
                        If the user pastes a new image, the hidden #OrderPhotoFile is set and the new file is uploaded;
                        if untouched, ExistingPhotoUrl is posted back so the controller keeps the original. *@
                        <div class="row mt-3 ">
                            <div class="col-12 ">
                                <div class="form-group w-100 input-wrapper">
                                    <div id="OrderPhotoPaste" class="form-control" contenteditable="true" data-placeholder="صورة الحجز" style="min-height:38px;cursor:text;">@if (!string.IsNullOrEmpty(Model.PhotoUrl))
                                        {
                                            <img src="@Model.PhotoUrl" style="max-height:120px;max-width:100%;object-fit:contain;" />
                                        }</div>
                                    <input type="file" name="PhotoFile" id="OrderPhotoFile" accept="image/*" style="display:none;" />
                                    <input type="hidden" name="ExistingPhotoUrl" value="@Model.PhotoUrl" />
                                </div>
                            </div>
                        </div>
                        @* Product picker + pre-rendered selected warehouses *@
                        <div id="selectedProductsList" class="row mt-3">
                            <div class="col-12">
                                <div class="form-group">
                                    <div class="warehouse-item">
                                        <select class="form-control warehouse-select" id="productDropdown" disabled>
                                            <option data-image="/static/box-open-2.svg" disabled selected value="">قم بإختيار إحدى المنتجات</option>
                                            @if (Model.AvailableWarehouses != null)
                                            {
                                                foreach (var wh in Model.AvailableWarehouses)
                                                {
                                                    <option value="@wh.id"
                                                            data-image="@wh.productImage">@wh.name</option>
                                                }
                                            }
                                        </select>
                                    </div>
                                </div>
                            </div>

                            @for (int i = 0; i < Model.SelectedWarehouses.Count; i++)
                            {
                                <div class="appended-warehouse-row row ms-0 mt-3"
                                     data-warehouse-id="@Model.SelectedWarehouses[i].WarehouseId"
                                     data-warehouse-name="@Model.SelectedWarehouses[i].WarehouseName"
                                     data-warehouse-amount="@Model.SelectedWarehouses[i].RemainingAmount"
                                     data-warehouse-remaining-amount="@Model.SelectedWarehouses[i].RemainingAmount"
                                     data-main-warehouse-id="@Model.SelectedWarehouses[i].MainWarehouseId">
                                    <div class="col-lg-6">
                                        <div class="form-group appenddiv blue-warehouse">
                                            <div class="warehouse-item">
                                                <span class="selected-warehouse">@Model.SelectedWarehouses[i].WarehouseName</span>
                                                <input type="hidden" name="SelectedWarehouses[@i].WarehouseId" value="@Model.SelectedWarehouses[i].WarehouseId">
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-lg-6 pe-4 ps-0">
                                        <div class="form-group">
                                            <div class="input-group my-input-group" style="width: 105%!important">
                                                <button type="button" class="btn decrease rounded-btn">-</button>
                                                <input min="1" type="text" inputmode="numeric" autocomplete="off" required placeholder="الكمية" class="form-control amount numeric-no-shake" asp-for="@Model.SelectedWarehouses[i].Amount" />
                                                <button type="button" class="btn increase rounded-btn">+</button>
                                            </div>
                                            <span asp-validation-for="@Model.SelectedWarehouses[i].Amount" class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                        <div class="row mt-3">
                            <div class="d-flex justify-content-center">
                            </div>
                        </div>
                        @* Total price + delivery price (role-gated) *@
                        @if (User.IsInRole("Admin") || User.IsInRole("FollowUpDepartment") || User.IsInRole("ExecutiveDirector"))
                        {
                            <div class="row mt-3">
                                <div class="col-lg-6">
                                    <div class="form-group input-wrapper d-flex justify-content-center">
                                        <input type="text" inputmode="decimal" autocomplete="off" id="TotalPrice" required asp-for="TotalPrice" class="form-control fw-bold with-bg-image-price text-green numeric-no-shake" placeholder="السعر الأجمالي" />
                                        <i class="fa-duotone fa-spinner-third fa-spin spinner-icon"></i>
                                        <span asp-validation-for="TotalPrice" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-lg-6">
                                    <div class="form-group input-wrapper d-flex justify-content-center">
                                        <input type="text" inputmode="decimal" autocomplete="off" id="DeliveryPrice" asp-for="DeliveryPrice" class="form-control fw-bold with-bg-image-price text-green numeric-no-shake" placeholder="سعر التوصيل" />
                                        <span asp-validation-for="DeliveryPrice" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <input type="hidden" asp-for="DeliveryPrice" />
                            <div class="d-flex  justify-content-center">
                                <div class="w-25 w-sm-50">
                                    <div class="form-group input-wrapper d-flex justify-content-center">
                                        <input type="text" inputmode="decimal" autocomplete="off" id="TotalPrice" required asp-for="TotalPrice" class="form-control fw-bold with-bg-image-price text-green numeric-no-shake" placeholder="السعر الأجمالي" />
                                        <i class="fa-duotone fa-spinner-third fa-spin spinner-icon"></i>
                                        <span asp-validation-for="TotalPrice" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>
                        }
                        @* Submit button *@
                        <div class="d-flex mb-3 justify-content-center ">
                            <button style="font-size:1.3rem;" type="submit" id="submitButton" class="btn py-1 background-gold text-white mb-3  w-65 mt-3">تاكيد تعديل الطلب</button>
                        </div>
                        @* Inline error panel shown on submission failure — Edit-scoped ids *@
                        <div style="width:23% !important" id="failedmessageEdit" class="container centered hidden legacy-popup-error-disabled" style="display:none !important; pointer-events:none !important;">
                            <div class="row justify-content-center align-items-center" style="min-height: 100vh;">
                                <div style="background-color:white" class=" flex-column b-r-8 d-flex justify-content-center">
                                    <div class="">
                                        <div class="text-center pt-3">
                                            <img src="/static/x-shadow-red.svg" width="50" />
                                        </div>
                                        <p class="text-center pb-3 text-black fw-bolder text-nowrap">خطأ في التعديل.</p>
                                        <p class="text-center text-black pb-3 message text-nowrap"></p>
                                    </div>
                                    <div class="border-top grey-hover">
                                        <div class="row">
                                            <div class="py-2 closeFailedMessage  text-center grey-hover text-green-v2 text-decoration-underline">
                                                موافق
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
<style>
    .with-bg-image-country {
        background-position: right 10px center !important;
        background-repeat: no-repeat;
        padding-right: 25px;
        background-size: 14px 14px;
    }
    /* The global site.css positions #decrease / #increase by id; our buttons use classes only
           (avoiding duplicate-id collisions with the Create modal on the same page), so re-apply
           the same positioning via class selectors scoped to .my-input-group. */
    #Edit .my-input-group .btn.decrease {
        border-end-end-radius: 0;
        border-start-end-radius: 0;
        position: absolute;
        right: 4px;
    }

    #Edit .my-input-group .btn.increase {
        border-start-start-radius: 0;
        border-end-start-radius: 0;
        position: absolute;
        left: 4px;
    }

    #campaignGalleryWrap {
        position: absolute;
        top: 50%;
        left: calc(100% + 32px);
        transform: translateY(-50%);
        width: 200px;
        background: #f6f6f6;
        border-radius: 16px;
        box-shadow: 0 0 4px rgba(0,0,0,.39);
        overflow: hidden;
        z-index: 10;
    }
    /* Campaign dropdown is intentionally fully hidden — gallery is the only UI.
           Select2 stays initialized on it (so all the existing data-flow stays intact),
           but neither the native select nor its rendered Select2 widget are ever shown. */
    #Edit #campaignDropdown,
    #Edit #campaignDropdown + .select2-container {
        display: none !important;
    }
    /* Select2 success state: green background on the container */
    .select2-container:has(.select2-selection__rendered.success) .select2-selection {
        background: #1d273b !important;
        background-color: #1d273b !important;
        border-color: #1d273b !important;
        border-radius: 4px;
    }
    /* Selected text and arrow become white */
    .select2-container:has(.select2-selection__rendered.success) .select2-selection__rendered {
        color: white !important;
    }

    .select2-container:has(.select2-selection__rendered.success) .select2-selection__arrow b {
        border-color: white transparent transparent transparent !important;
    }
