            // ============================================================
            // MISC INPUTS (price, optional fields)
            // ============================================================
            // TotalPrice validation:
            // 1) يتحقق من الحد الأدنى للبيع لكل منتج من ProductMinimumSellingPrices.
            // 2) بعدها يشغل فحص الحد الأدنى القديم للطلبات CountryMinimumPrices.
            // Product minimum selling price is enforced for all roles.
            // Old country minimum check is still bypassed for Admin / FollowUpDepartment / ExecutiveDirector.
            var isUnrestrictedRole = @Json.Serialize(User.IsInRole("Admin") || User.IsInRole("FollowUpDepartment") || User.IsInRole("ExecutiveDirector"));
            let totalPriceErrorMessageShown = false;
            let totalPriceSpinnerTimeout;
            let totalPriceXhr;

            function getSelectedProductMinimumItems() {
                var items = [];

                $c('selectedProductsList').find('.appended-warehouse-row').each(function () {
                    var $row = $(this);
                    var mainWarehouseId = parseInt($row.attr('data-main-warehouse-id'));
                    var amount = parseInt($row.find('.amount').val());

                    if (!isNaN(mainWarehouseId) && mainWarehouseId > 0) {
                        items.push({
                            mainWarehouseId: mainWarehouseId,
                            amount: (!isNaN(amount) && amount > 0) ? amount : 1
                        });
                    }
                });

                return items;
            }

            function getSelectedProductMinimumItemsQuery(items) {
                return {
                    mainWarehouseIds: items.map(function (item) { return item.mainWarehouseId; }).join(','),
                    amounts: items.map(function (item) { return item.amount; }).join(',')
                };
            }

            function runTotalPriceValidation() {
                const inputElement = $c('TotalPrice');
                if (!inputElement.length) return;

                const $container = inputElement.closest('.form-group');
                const $spinner = $container.find('.spinner-icon');
                const raw = inputElement.val().trim();
                const numeric = parseFloat(raw);
                const isNumeric = raw !== '' && !isNaN(numeric) && isFinite(numeric);

                inputElement.removeClass('error success');

                function showError(msg) {
                    productMinimumSellingPriceIsValid = false;
                    productMinimumSellingPriceMessage = msg || '';

                    inputElement.addClass('error').removeClass('success');

                    if (!totalPriceErrorMessageShown) {
                        $container.after('<div class="required-message">' + msg + '</div>');
                        totalPriceErrorMessageShown = true;
                    } else {
                        $container.next('.required-message').text(msg).show();
                    }

                    updateSubmitButtonState();
                }

                function clearError() {
                    productMinimumSellingPriceIsValid = true;
                    productMinimumSellingPriceMessage = '';

                    if (totalPriceErrorMessageShown) {
                        $container.next('.required-message').remove();
                        totalPriceErrorMessageShown = false;
                    }
                }

                function setSuccess() {
                    $spinner.hide();
                    clearError();
                    inputElement.addClass('success').removeClass('error');
                    updateSubmitButtonState();
                }

                if (!isNumeric) {
                    $spinner.hide();

                    if (raw !== '') {
                        productMinimumSellingPriceIsValid = false;
                        showError(' يرجى إدخال رقم صحيح.');
                    } else {
                        clearError();
                        updateSubmitButtonState();
                    }

                    return;
                }

                const country = $c('countryDropdown').val();
                const mcId = $c('manufacturingCompanyDropdown').val();

                if (!country || !mcId) {
                    setSuccess();
                    return;
                }

                function validateCountryMinimumPrice() {
                    if (isUnrestrictedRole) {
                        setSuccess();
                        return;
                    }

                    if (totalPriceXhr) {
                        totalPriceXhr.abort();
                    }

                    totalPriceXhr = $.ajax({
                        url: '/Order/ValidateTotalPrice',
                        type: 'GET',
                        data: {
                            country: country,
                            manufacturingCompanyId: mcId,
                            totalPrice: numeric
                        },
                        success: function (res) {
                            $spinner.hide();

                            if (res && res.valid) {
                                setSuccess();
                            } else {
                                showError((res && res.message) || 'السعر غير صالح');
                            }
                        },
                        error: function (jqXhr, status) {
                            if (status === 'abort') return;

                            $spinner.hide();
                            // لو حصل خطأ شبكة، السيرفر سايد فاليديشن لسه هيحمي الحفظ.
                            setSuccess();
                        }
                    });
                }

                function validateProductMinimumSellingPrice() {
                    var selectedItems = getSelectedProductMinimumItems();

                    if (selectedItems.length === 0) {
                        validateCountryMinimumPrice();
                        return;
                    }

                    var productQuery = getSelectedProductMinimumItemsQuery(selectedItems);

                    if (productMinimumSellingPriceXhr) {
                        productMinimumSellingPriceXhr.abort();
                    }

                    productMinimumSellingPriceXhr = $.ajax({
                        url: '/Order/ValidateProductMinimumSellingPrice',
                        type: 'GET',
                        data: {
                            country: country,
                            manufacturingCompanyId: mcId,
                            totalPrice: numeric,
                            mainWarehouseIds: productQuery.mainWarehouseIds,
                            amounts: productQuery.amounts
                        },
                        success: function (res) {
                            if (res && res.valid === false) {
                                $spinner.hide();
                                showError(res.message || 'السعر أقل من الحد الأدنى لسعر البيع.');
                                return;
                            }

                            validateCountryMinimumPrice();
                        },
                        error: function (jqXhr, status) {
                            if (status === 'abort') return;

                            // لو endpoint وقع، لا نوقف الواجهة؛ server-side validation هيمنع الحفظ.
                            validateCountryMinimumPrice();
                        }
                    });
                }

                $spinner.show();

                clearTimeout(productMinimumSellingPriceTimer);
                clearTimeout(totalPriceSpinnerTimeout);

                productMinimumSellingPriceIsValid = false;
                productMinimumSellingPriceMessage = 'جاري التحقق من الحد الأدنى لسعر البيع.';
                updateSubmitButtonState();

                productMinimumSellingPriceTimer = setTimeout(function () {
                    validateProductMinimumSellingPrice();
                }, 250);
            }

            $c('TotalPrice').on('input paste', function () {
