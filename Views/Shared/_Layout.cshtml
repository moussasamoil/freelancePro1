<body class="background-white-green">
    <header>
        <nav class="nav-shadow background-white-green navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom ">
            <div class="container-fluid">
                <div class="navbar-collapse  d-sm-inline-flex justify-content-between">
                    <div>
                        <i class="@iconClass"></i>
                    </div>

                    <div>
                        @headerText
                    </div>

                    <div class="p-0 " style="direction: rtl;">
                        @await Component.InvokeAsync("Sidebar")
                    </div>

                </div>
            </div>
        </nav>
    </header>

    <div class="mt-4 mx-3">
        <main role="main" class="pb-3 " style="direction:rtl;">
            @RenderBody()
        </main>
    </div>
    @Html.Partial("_Notification")

    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        <script>
            (function () {
                const currentPath = window.location.pathname.toLowerCase();
                const isMonitoringPage = currentPath.indexOf('/employeeactivity/loginsessions') === 0;

                let pendingActivity = true;
                let lastSentAt = 0;

                const minimumSendGap = 3000;

                function markActivity() {
                    pendingActivity = true;

                    const now = Date.now();

                    if (now - lastSentAt >= minimumSendGap) {
                        sendHeartbeat(false);
                    }
                }

                function sendHeartbeat(force) {
                    const now = Date.now();

                    if (!force && now - lastSentAt < 2000) {
                        return;
                    }

                    lastSentAt = now;

                    const payload = {
                        hasActivity: pendingActivity,
                        currentPage: window.location.pathname + window.location.search,
                        isTabActive: !document.hidden,
                        isMonitoringPage: isMonitoringPage
                    };

                    pendingActivity = false;

                    fetch('/EmployeeActivity/Heartbeat', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        credentials: 'same-origin',
                        keepalive: true,
                        body: JSON.stringify(payload)
                    }).catch(function () { });
                }

                ['mousemove', 'mousedown', 'keydown', 'scroll', 'touchstart', 'click'].forEach(function (eventName) {
                    document.addEventListener(eventName, markActivity, { passive: true });
                });

                document.addEventListener('visibilitychange', function () {
                    pendingActivity = !document.hidden || pendingActivity;
                    sendHeartbeat(true);
                });

                window.addEventListener('focus', function () {
                    pendingActivity = true;
                    sendHeartbeat(true);
                });

                window.addEventListener('beforeunload', function () {
                    sendHeartbeat(true);
                });

                setInterval(function () {
                    sendHeartbeat(true);
                }, 5000);

                setTimeout(function () {
                    sendHeartbeat(true);
                }, 500);
            })();
        </script>
    }




    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>



