<script>

    document.addEventListener("DOMContentLoaded", function () {
        var images = document.querySelectorAll('img:not([src])');
        images.forEach(function (img) {
            img.src = 'static/DefaultImage.svg'; // Your default image path
            img.setAttribute('width', '18'); // Set the width to 20px
            img.setAttribute('height', '18'); // Set the height to 20px
        });
    });

    // Function to adjust the top style
    function adjustTop() {
        // Select the element with the specified classes
        var element = document.querySelector('.select2-container.select2-container--default.select2-container--open');

        // Check if the element exists
        if (element) {
            // Get the current top style, assuming it's always in px
            var currentTop = element.style.top;

            // Parse the current top to get the numerical value
            var topValue = parseFloat(currentTop);

            // Check if the current top is a number
            if (!isNaN(topValue)) {
                // Subtract 8 px from the current top value
                var newTop = topValue - 8;

                // Apply the new top value back to the element
                element.style.top = `${newTop}px`;

                console.log(`Adjusted top from ${currentTop} to ${newTop}px`);
            } else {
                console.log('Current top value is not a valid number:', currentTop);
            }
        } else {
            console.log('No element found with the specified classes');
        }
    }

    // Call the function to adjust the top style
    adjustTop();


</script> 