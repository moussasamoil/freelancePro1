        // Debugging logs
        console.log('linkElement:', linkElement);
        console.log('qrReaderElement:', qrReaderElement);
        console.log('qrResultElement:', qrResultElement);

        let html5QrCode;

        if (linkElement && qrReaderElement && qrResultElement) {
            // Add a click event listener to the link element
            linkElement.addEventListener("click", () => {
                if (qrReaderElement.style.display === "block") {
                    // If the QR reader is already displayed, hide it and stop the scanner
                    qrReaderElement.style.display = "none";
                    if (html5QrCode) {
                        html5QrCode.stop().catch(err => console.error("Unable to stop scanning", err));
                    }
                } else {
                    // If the QR reader is not displayed, show it and start the scanner
                    qrReaderElement.style.display = "block";

                    // Initialize the HTML5 QR Code scanner if not already initialized
                    if (!html5QrCode) {
                        html5QrCode = new Html5Qrcode("qr-reader");
                    }

                    // Start the QR code scanner with the user's rear-facing camera
                    html5QrCode.start(
                        { facingMode: "environment" },
                        {
                            fps: 10,    // Frames per second to capture
                            qrbox: 250  // Size of the scanning box (square)
                        },
                        qrCodeMessage => {
                            // Handle the QR code message
                            qrResultElement.innerHTML = `QR Code detected: ${qrCodeMessage}`;
                            html5QrCode.stop();

                            // Redirect to the detected URL
                            window.location.href = qrCodeMessage;
                        },
                        errorMessage => {
                            // Handle errors during scanning
                            console.warn(`QR Code no longer in front of camera.`);
                        }
                    ).catch(err => {
                        // Handle errors during initialization
                        console.error(`Unable to start scanning: ${err}`);
                    });
                }
            });
        } else {
            console.error('One or more elements not found.');
        }
    });









    /* =========================================================
       HARD FIX JS: lock page/body scroll while AMP sidebar is open
       هذا يمنع ظهور السكرول الرصاصي الخارجي الموجود خلف السايد بار.
       ========================================================= */
    (function () {
        function toggleOuterScrollbarLock(isOpen) {
            if (document.documentElement) {
                document.documentElement.classList.toggle('luxira-sidebar-open', isOpen);
            }

            if (document.body) {
                document.body.classList.toggle('luxira-sidebar-open', isOpen);
            }
        }

        function initOuterScrollbarFix() {
            var sidebarElement = document.getElementById('header-sidebar');

            if (!sidebarElement) {
                return;
            }

            function syncSidebarState() {
                var isOpen = sidebarElement.hasAttribute('open') ||
                    sidebarElement.classList.contains('i-amphtml-sidebar-opened');

                toggleOuterScrollbarLock(isOpen);
            }

            sidebarElement.addEventListener('sidebarOpen', function () {
                toggleOuterScrollbarLock(true);
            });

            sidebarElement.addEventListener('sidebarClose', function () {
                toggleOuterScrollbarLock(false);
            });

            if (window.MutationObserver) {
                var observer = new MutationObserver(syncSidebarState);
                observer.observe(sidebarElement, {
                    attributes: true,
                    attributeFilter: ['open', 'class']
                });
            }

            syncSidebarState();
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initOuterScrollbarFix);
        } else {
            initOuterScrollbarFix();
        }
    })();

</script>


<script id="luxira-account-switch-sidebar-script">
    (function () {
        var selectedEmployeeProfile = null;
        var loadedEmployeeProfiles = [];
        var currentSwitchSearchText = "";

        function getSwitchAntiForgeryToken() {
            var tokenInput =
                document.querySelector('#luxiraAccountSwitchAntiForgeryForm input[name="__RequestVerificationToken"]') ||
                document.querySelector('#logoutForm input[name="__RequestVerificationToken"]') ||
                document.querySelector('input[name="__RequestVerificationToken"]');

            return tokenInput ? tokenInput.value : "";
        }

        async function readSwitchJsonResponse(response) {
            var text = await response.text();

            if (!text || !text.trim()) {
                return {
                    success: false,
                    message: response.ok
                        ? 'الرد من السيرفر فارغ.'
                        : 'السيرفر رفض الطلب. غالبًا توكن الحماية غير موجود أو الجلسة انتهت.'
                };
            }

            try {
                return JSON.parse(text);
            } catch (error) {
                return {
                    success: false,
                    message: response.ok
                        ? 'الرد من السيرفر ليس JSON صالح.'
                        : 'السيرفر رجّع صفحة أو Redirect بدل JSON. تأكدي من تسجيل الدخول وصلاحية الجلسة.'
                };
            }
        }

        function showPrimarySidebarMenu() {
            var primary = document.getElementById('luxiraPrimarySidebarMenu');
            var switchMenu = document.getElementById('luxiraAccountSwitchMenu');

            if (primary) {
                primary.style.display = '';
            }

            if (switchMenu) {
                switchMenu.style.display = 'none';
            }
        }

        function showEmployeeProfilesMenu() {
            var primary = document.getElementById('luxiraPrimarySidebarMenu');
            var switchMenu = document.getElementById('luxiraAccountSwitchMenu');
            var searchInput = document.getElementById('luxiraSwitchEmployeeSearch');

            if (primary) {
                primary.style.display = 'none';
            }

            if (switchMenu) {
                switchMenu.style.display = '';
            }

            if (searchInput) {
                searchInput.value = "";
                currentSwitchSearchText = "";
            }

            loadEmployeeProfiles();
        }

        function normalizeSwitchText(value) {
            return String(value || '')
                .toLowerCase()
                .replace(/\s+/g, ' ')
                .trim();
        }

        function readFirstExistingValue(account, keys) {
            if (!account) {
                return "";
            }

            for (var index = 0; index < keys.length; index++) {
                var key = keys[index];

                if (Object.prototype.hasOwnProperty.call(account, key) && account[key] !== null && account[key] !== undefined) {
                    var value = String(account[key]).trim();

                    if (value) {
                        return value;
                    }
                }
            }

            return "";
        }

        function valueLooksLikeEmail(value) {
            var text = String(value || '').trim();
            var atSign = String.fromCharCode(64);
            var atIndex = text.indexOf(atSign);

            return atIndex > 0
                && atIndex < text.length - 1
                && text.indexOf('.', atIndex + 2) > atIndex + 1
                && text.indexOf(' ') < 0;
        }

        function getAccountId(account) {
            return readFirstExistingValue(account, [
                'id',
                'Id',
                'userId',
                'UserId',
                'applicationUserId',
                'ApplicationUserId',
                'aspNetUserId',
                'AspNetUserId',
                'targetUserId',
                'TargetUserId'
            ]);
        }

        function isTrueValue(value) {
            if (value === true || value === 1) {
                return true;
            }

            var textValue = String(value || '').trim().toLowerCase();

            return textValue === 'true' || textValue === '1' || textValue === 'yes';
        }

        function getAccountIsCurrent(account) {
            if (!account) {
                return false;
            }

            var currentKeys = [
                'isCurrent',
                'IsCurrent',
                'current',
                'Current',
                'isCurrentUser',
                'IsCurrentUser'
            ];

            for (var index = 0; index < currentKeys.length; index++) {
                var key = currentKeys[index];

                if (Object.prototype.hasOwnProperty.call(account, key)) {
                    return isTrueValue(account[key]);
                }
            }

            return false;
        }

        function getAccountFullName(account) {
            var fullName = readFirstExistingValue(account, [
                'englishFullName',
                'EnglishFullName',
                'employeeEnglishName',
                'EmployeeEnglishName',
                'fullNameEnglish',
                'FullNameEnglish',
                'englishName',
                'EnglishName',
                'fullName',
                'FullName',
                'employeeFullName',
                'EmployeeFullName',
                'employeeName',
                'EmployeeName',
                'displayName',
                'DisplayName',
                'name',
                'Name'
            ]);

            if (!fullName || valueLooksLikeEmail(fullName)) {
                fullName = readFirstExistingValue(account, [
                    'userName',
                    'UserName'
                ]);
            }

            if (!fullName || valueLooksLikeEmail(fullName)) {
                fullName = 'بدون اسم';
            }

            return fullName;
        }

        function getAccountRole(account) {
            return readFirstExistingValue(account, [
                'roleName',
                'RoleName',
                'role',
                'Role',
                'userRole',
                'UserRole',
                'roles',
                'Roles',
                'permission',
                'Permission'
            ]);
        }

        function translateRoleToArabic(roleName) {
            var role = String(roleName || '').trim();

            if (!role) {
                return 'بدون صلاحية';
            }

            if (role.indexOf(',') >= 0) {
                role = role.split(',')[0].trim();
            }

            var normalizedRole = role.toLowerCase().replace(/\s+/g, '');

            var roleMap = {
                'admin': 'مدير النظام',
                'administrator': 'مدير النظام',
                'executivedirector': 'المدير التنفيذي',
                'accountant': 'محاسب',
                'followupdepartment': 'قسم المتابعة',
                'callcenter': 'كول سنتر',
                'deliverycompany': 'شركة التوصيل',
                'orderpreparer': 'تجهيز الطلبات',
                'deliveryrepresentative': 'مندوب التوصيل',
                'representative': 'مندوب',
                'employee': 'موظف',
                'user': 'مستخدم'
            };

            return roleMap[normalizedRole] || role;
        }

        function isExplicitlyInactiveValue(value) {
            if (value === false || value === 0) {
                return true;
            }

            var textValue = String(value).trim().toLowerCase();

            return textValue === 'false' ||
                textValue === '0' ||
                textValue === 'no' ||
                textValue === 'inactive' ||
                textValue === 'غير نشط';
        }

        function isActiveAccount(account) {
            if (!account) {
                return false;
            }

            var activeKeys = [
                'isActive',
                'IsActive',
                'employeeIsActive',
                'EmployeeIsActive',
                'isEmployeeActive',
                'IsEmployeeActive',
                'active',
                'Active',
                'isActiveEmployee',
                'IsActiveEmployee',
                'userIsActive',
                'UserIsActive'
            ];

            for (var index = 0; index < activeKeys.length; index++) {
                var key = activeKeys[index];

                if (Object.prototype.hasOwnProperty.call(account, key)) {
                    return !isExplicitlyInactiveValue(account[key]);
                }
            }

            /*
                لو الـ API الحالي لا يرجع IsActive، نترك الحساب ظاهرًا حتى لا تختفي القائمة كلها.
                الفلترة النهائية Active = 1 يجب أن تكون من AccountSwitchController.
            */
            return true;
        }

        function getAccountsArrayFromResult(result) {
            if (!result) {
                return [];
            }

            if (Array.isArray(result.accounts)) {
                return result.accounts;
            }

            if (Array.isArray(result.Accounts)) {
                return result.Accounts;
            }

            if (Array.isArray(result.data)) {
                return result.data;
            }

            if (Array.isArray(result.Data)) {
                return result.Data;
            }

            if (Array.isArray(result.items)) {
                return result.items;
            }

            if (Array.isArray(result.Items)) {
                return result.Items;
            }

            return [];
        }

        function prepareAccountForSwitch(account) {
            var userId = getAccountId(account);
            var fullName = getAccountFullName(account);
            var roleName = getAccountRole(account);
            var roleArabic = translateRoleToArabic(roleName);
            var isCurrent = getAccountIsCurrent(account);

            account._switchUserId = userId;
            account._switchFullName = fullName;
            account._switchRoleArabic = roleArabic;
            account._switchIsCurrent = isCurrent;

            return account;
        }

        function filterAccountsForSwitch(accounts) {
            var searchText = normalizeSwitchText(currentSwitchSearchText);

            return (accounts || [])
                .map(prepareAccountForSwitch)
                .filter(function (account) {
                    return !!account._switchUserId;
                })
                .filter(isActiveAccount)
                .filter(function (account) {
                    if (!searchText) {
                        return true;
                    }

                    var nameText = normalizeSwitchText(account._switchFullName);

                    return nameText.indexOf(searchText) >= 0;
                });
        }

        function renderEmployeeProfiles(accounts) {
            var list = document.getElementById('luxiraSwitchAccountsList');
            var empty = document.getElementById('luxiraSwitchAccountsEmpty');
            var filteredAccounts = filterAccountsForSwitch(accounts);

            if (!list) {
                return;
            }

            list.innerHTML = "";

            if (!filteredAccounts.length) {
                if (empty) {
                    empty.textContent = currentSwitchSearchText
                        ? 'لا توجد نتائج مطابقة لاسم الموظف.'
                        : 'لا توجد حسابات موظفين Active.';
                    empty.style.display = 'block';
                }

                return;
            }

            if (empty) {
                empty.style.display = 'none';
            }

            filteredAccounts.forEach(function (account) {
                var item = document.createElement('button');
                item.type = 'button';
                item.className = 'luxira-switch-account-item' + (account._switchIsCurrent ? ' is-current' : '');
                item.dataset.userId = account._switchUserId;

                item.innerHTML =
                    '<div class="luxira-switch-account-info">' +
                        '<div class="luxira-switch-account-name"></div>' +
                        '<div class="luxira-switch-account-role"></div>' +
                    '</div>' +
                    '<span class="luxira-switch-current-badge" style="' + (account._switchIsCurrent ? '' : 'display:none;') + '">الحالي</span>';

                item.querySelector('.luxira-switch-account-name').textContent = account._switchFullName;
                item.querySelector('.luxira-switch-account-role').textContent = account._switchRoleArabic;

                if (!account._switchIsCurrent) {
                    item.addEventListener('click', function () {
                        openEmployeeProfileConfirmPopup(account);
                    });
                }

                list.appendChild(item);
            });
        }

        async function fetchEmployeeProfilesFromServer() {
            var firstResponse = await fetch('/AccountSwitch/MyAccounts?activeOnly=true', {
                method: 'GET',
                cache: 'no-store',
                credentials: 'same-origin',
                headers: {
                    'Accept': 'application/json'
                }
            });

            var firstResult = await readSwitchJsonResponse(firstResponse);

            if (firstResponse.ok && firstResult && firstResult.success !== false) {
                return firstResult;
            }

            /*
                Fallback:
                لو الـ Controller عندك لا يدعم activeOnly أو بيرجع Error بسببها،
                نرجع للـ endpoint القديم بدون تغيير الراوت.
            */
            var fallbackResponse = await fetch('/AccountSwitch/MyAccounts', {
                method: 'GET',
                cache: 'no-store',
                credentials: 'same-origin',
                headers: {
                    'Accept': 'application/json'
                }
            });

            var fallbackResult = await readSwitchJsonResponse(fallbackResponse);

            if (!fallbackResponse.ok || !fallbackResult || fallbackResult.success === false) {
                throw new Error(
                    (firstResult && firstResult.message) ||
                    (fallbackResult && fallbackResult.message) ||
                    'تعذر تحميل الموظفين.'
                );
            }

            return fallbackResult;
        }

        async function loadEmployeeProfiles() {
            var loading = document.getElementById('luxiraSwitchAccountsLoading');
            var list = document.getElementById('luxiraSwitchAccountsList');
            var empty = document.getElementById('luxiraSwitchAccountsEmpty');

            if (loading) loading.style.display = 'block';
            if (list) list.innerHTML = "";
            if (empty) empty.style.display = 'none';

            try {
                var result = await fetchEmployeeProfilesFromServer();

                loadedEmployeeProfiles = getAccountsArrayFromResult(result);
                renderEmployeeProfiles(loadedEmployeeProfiles);
            } catch (e) {
                loadedEmployeeProfiles = [];

                if (empty) {
                    empty.textContent = e && e.message ? e.message : 'تعذر تحميل الموظفين.';
                    empty.style.display = 'block';
                }
            } finally {
                if (loading) loading.style.display = 'none';
            }
        }

        function removeEmployeeProfilePopup() {
            var oldPopup = document.getElementById('luxiraSwitchPasswordPopup');
            if (oldPopup) {
                oldPopup.remove();
            }
        }

        function openEmployeeProfileConfirmPopup(account) {
            selectedEmployeeProfile = prepareAccountForSwitch(account);
            removeEmployeeProfilePopup();

            var popup = document.createElement('div');
            popup.id = 'luxiraSwitchPasswordPopup';
            popup.className = 'luxira-switch-popup-backdrop';

            popup.innerHTML =
                '<div class="luxira-switch-popup-card">' +
                    '<div class="luxira-switch-popup-header">تبديل الموظف</div>' +
                    '<div class="luxira-switch-popup-body">' +
                        '<div class="luxira-switch-selected-account">' +
                            '<div id="luxiraSwitchSelectedName"></div>' +
                            '<div id="luxiraSwitchSelectedRole"></div>' +
                        '</div>' +
                        '<div class="luxira-switch-confirm-note">سيتم فتح حساب هذا الموظف مباشرة بدون باسورد، مع الاحتفاظ بجلسة الأدمن الأصلية.</div>' +
                        '<div id="luxiraSwitchError" class="luxira-switch-error"></div>' +
                    '</div>' +
                    '<div class="luxira-switch-popup-actions">' +
                        '<button type="button" id="luxiraSwitchCancelBtn" class="luxira-switch-popup-btn luxira-switch-cancel">إلغاء</button>' +
                        '<button type="button" id="luxiraSwitchConfirmBtn" class="luxira-switch-popup-btn luxira-switch-confirm">فتح الحساب</button>' +
                    '</div>' +
                '</div>';

            document.body.appendChild(popup);

            document.getElementById('luxiraSwitchSelectedName').textContent = selectedEmployeeProfile._switchFullName;
            document.getElementById('luxiraSwitchSelectedRole').textContent = selectedEmployeeProfile._switchRoleArabic;

            var cancelBtn = document.getElementById('luxiraSwitchCancelBtn');
            var confirmBtn = document.getElementById('luxiraSwitchConfirmBtn');

            if (cancelBtn) {
                cancelBtn.addEventListener('click', removeEmployeeProfilePopup);
            }

            if (confirmBtn) {
                confirmBtn.addEventListener('click', submitEmployeeProfileSwitch);
            }
        }

        function showSwitchError(message) {
            var error = document.getElementById('luxiraSwitchError');

            if (!error) {
                return;
            }

            error.textContent = message || 'حدث خطأ أثناء فتح حساب الموظف.';
            error.style.display = 'block';
        }

        function buildSwitchRedirectUrl(url) {
            var targetUrl = url || '/Home/Index';
            var separator = targetUrl.indexOf('?') === -1 ? '?' : '&';

            return targetUrl + separator + '_switch=' + new Date().getTime();
        }

        function redirectAfterEmployeeProfileSwitch(url) {
            var targetUrl = buildSwitchRedirectUrl(url);

            removeEmployeeProfilePopup();

            window.location.replace(targetUrl);

            window.setTimeout(function () {
                window.location.href = targetUrl;
            }, 250);

            window.setTimeout(function () {
                window.location.reload();
            }, 1500);
        }

        function readSwitchJsonResponseWithTimeout(response, timeoutMs) {
            return Promise.race([
                readSwitchJsonResponse(response),
                new Promise(function (resolve) {
                    window.setTimeout(function () {
                        resolve({
                            success: true,
                            redirectUrl: '/Home/Index',
                            timedOut: true
                        });
                    }, timeoutMs || 700);
                })
            ]);
        }

        async function submitEmployeeProfileSwitch() {
            if (!selectedEmployeeProfile || !selectedEmployeeProfile._switchUserId) {
                showSwitchError('اختاري الموظف أولًا.');
                return;
            }

            var confirmBtn = document.getElementById('luxiraSwitchConfirmBtn');
            var hardRedirectTimer = null;

            if (confirmBtn) {
                confirmBtn.disabled = true;
                confirmBtn.textContent = 'جاري الفتح...';
            }

            try {
                hardRedirectTimer = window.setTimeout(function () {
                    redirectAfterEmployeeProfileSwitch('/Home/Index');
                }, 1800);

                var response = await fetch('/AccountSwitch/Switch', {
                    method: 'POST',
                    cache: 'no-store',
                    credentials: 'same-origin',
                    headers: {
                        'Content-Type': 'application/json',
                        'Accept': 'application/json',
                        'RequestVerificationToken': getSwitchAntiForgeryToken()
                    },
                    body: JSON.stringify({
                        targetUserId: selectedEmployeeProfile._switchUserId
                    })
                });

                var result = await readSwitchJsonResponseWithTimeout(response, 700);

                if (hardRedirectTimer) {
                    window.clearTimeout(hardRedirectTimer);
                    hardRedirectTimer = null;
                }

                if (!response.ok || !result || result.success === false) {
                    throw new Error(result && result.message ? result.message : 'فشل فتح حساب الموظف.');
                }

                redirectAfterEmployeeProfileSwitch(result.redirectUrl || '/Home/Index');
            } catch (e) {
                if (hardRedirectTimer) {
                    window.clearTimeout(hardRedirectTimer);
                    hardRedirectTimer = null;
                }

                showSwitchError(e && e.message ? e.message : 'فشل فتح حساب الموظف.');

                if (confirmBtn) {
                    confirmBtn.disabled = false;
                    confirmBtn.textContent = 'فتح الحساب';
                }
            }
        }

        function initEmployeeProfilesSidebar() {
            var openBtn = document.getElementById('luxiraOpenAccountSwitchMenu');
            var backBtn = document.getElementById('luxiraBackToMainMenu');
            var searchInput = document.getElementById('luxiraSwitchEmployeeSearch');

            if (!openBtn) {
                return;
            }

            openBtn.addEventListener('click', function (event) {
                event.preventDefault();
                showEmployeeProfilesMenu();
            });

            if (backBtn) {
                backBtn.addEventListener('click', function (event) {
                    event.preventDefault();
                    showPrimarySidebarMenu();
                });
            }

            if (searchInput) {
                searchInput.addEventListener('input', function () {
                    currentSwitchSearchText = searchInput.value || "";
                    renderEmployeeProfiles(loadedEmployeeProfiles);
                });
            }

            var sidebar = document.getElementById('header-sidebar');

            if (sidebar) {
                sidebar.addEventListener('sidebarClose', function () {
                    removeEmployeeProfilePopup();
                    showPrimarySidebarMenu();

                    if (searchInput) {
                        searchInput.value = "";
                    }

                    currentSwitchSearchText = "";
                    loadedEmployeeProfiles = [];
                });
            }
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initEmployeeProfilesSidebar);
        } else {
            initEmployeeProfilesSidebar();
        }
    })();

</script>


