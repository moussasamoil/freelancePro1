@model lotus_blue.Models.ViewModel.SidebarViewModel
@{
    /*
        IsAdminSwitchSession = true معناها إن الحساب الحالي مفتوح من خلال الأدمن.
        مهم: بعد التنقل من موظف لموظف، بعض الصفحات قد لا تقرأ Roles/Claims بنفس اللحظة،
        لذلك لا نعتمد على Role Admin فقط. نعتبر الجلسة Admin Switch إذا وجد أي Claim من Claims السويتش
        أو وجد أي Cookie من Cookies السيرفر الخاصة بالـ Admin Switch.
        في الحالة دي: يظهر زر السويتش، والخروج لا يطلب صورة خروج، لكنه يعمل Logout كامل إلى صفحة Login.
    */
    var originalAdminUserId = User.FindFirst("OriginalAdminUserId")?.Value ?? "";
    var originalAdminEmail = User.FindFirst("OriginalAdminEmail")?.Value ?? "";
    var originalAdminName = User.FindFirst("OriginalAdminName")?.Value ?? "Admin";

    var hasAdminSwitchCookie =
        Context.Request.Cookies.ContainsKey("LuxiraAdminSwitchLogin") ||
        Context.Request.Cookies.ContainsKey("LuxiraOriginalAdminUserId") ||
        Context.Request.Cookies.ContainsKey("LuxiraOriginalAdminEmail") ||
        Context.Request.Cookies.ContainsKey("LuxiraOriginalAdminName");

    var isAdminSwitchSession =
        User.HasClaim("IsAdminSwitchSession", "true") ||
        User.HasClaim("IsSwitchedAccount", "true") ||
        !string.IsNullOrWhiteSpace(originalAdminUserId) ||
        hasAdminSwitchCookie;

    var canUseAccountSwitch = User.IsInRole("Admin") || isAdminSwitchSession;

    var skipSecureLogoutFaceCapture =
        isAdminSwitchSession ||
        User.IsInRole("Admin") ||
        User.IsInRole("DeliveryCompany") ||
        User.IsInRole("OrderPreparer");
}
