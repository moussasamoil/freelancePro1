    async function startSecureLogoutCamera() {
        const video = document.getElementById('secureLogoutCamera');
        const errorBox = document.getElementById('secureLogoutError');
        const successBox = document.getElementById('secureLogoutSuccess');
        const preview = document.getElementById('secureLogoutPreview');

        try {
            if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
                errorBox.innerText = "المتصفح لا يدعم تشغيل الكاميرا";
