    function buildSecureLogoutLocationText(data) {
        const parts = [];

        if (data.city) parts.push(data.city);
        if (data.region) parts.push(data.region);
        if (data.country_name) parts.push(data.country_name);

        return parts.join(' - ');
    }

    async function loadSecureLogoutIpAndLocation() {
        secureLogoutIpAddress = "";
        secureLogoutLocation = "";

        try {
            const response = await fetch('https://ipapi.co/json/', {
                method: 'GET',
                cache: 'no-store'
            });

            if (!response.ok) {
                throw new Error('Failed to load IP location');
            }

            const data = await response.json();

            secureLogoutIpAddress = data && data.ip ? data.ip : "";
            secureLogoutLocation = data ? buildSecureLogoutLocationText(data) : "";
        } catch (error) {
            try {
                const fallbackResponse = await fetch('https://api.ipify.org?format=json', {
                    method: 'GET',
                    cache: 'no-store'
                });

                const fallbackData = await fallbackResponse.json();

                secureLogoutIpAddress = fallbackData && fallbackData.ip ? fallbackData.ip : "";
                secureLogoutLocation = "";
            } catch {
                secureLogoutIpAddress = "";
                secureLogoutLocation = "";
            }
        }
    }


