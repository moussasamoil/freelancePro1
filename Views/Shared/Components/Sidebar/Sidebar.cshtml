    const secureLogoutFaceValidationMessage = "يجب أخذ صورة للوجه بشكل صحيح";

    function getSecureLogoutFaceImageQuality(canvasElement) {
        const ctx = canvasElement.getContext('2d');
        const width = canvasElement.width;
        const height = canvasElement.height;
        const imageData = ctx.getImageData(0, 0, width, height).data;
        const step = 8;
        let count = 0;
        let luminanceSum = 0;
        let luminanceSquaresSum = 0;
        let skinLikePixels = 0;
        let coloredPixels = 0;

        for (let y = 0; y < height; y += step) {
            for (let x = 0; x < width; x += step) {
                const index = (y * width + x) * 4;
                const r = imageData[index];
                const g = imageData[index + 1];
                const b = imageData[index + 2];
                const max = Math.max(r, g, b);
                const min = Math.min(r, g, b);
                const luminance = (0.299 * r) + (0.587 * g) + (0.114 * b);

                count++;
                luminanceSum += luminance;
                luminanceSquaresSum += luminance * luminance;

                if (max - min > 18) {
                    coloredPixels++;
                }

                const isSkinLike =
                    r > 70 && g > 35 && b > 20 &&
                    r > g * 1.03 && r > b * 1.12 &&
                    (max - min) > 15;

                if (isSkinLike) {
                    skinLikePixels++;
                }
            }
        }

        const averageLuminance = count ? luminanceSum / count : 0;
        const variance = count ? (luminanceSquaresSum / count) - (averageLuminance * averageLuminance) : 0;

        return {
            averageLuminance: averageLuminance,
            variance: variance,
            skinRatio: count ? skinLikePixels / count : 0,
            colorRatio: count ? coloredPixels / count : 0
        };
    }

    function hasLikelySecureLogoutHumanFaceFallback(canvasElement, quality) {
        const ctx = canvasElement.getContext('2d');
        const width = canvasElement.width;
        const height = canvasElement.height;

        if (!ctx || !width || !height) {
            return false;
        }

        const imageData = ctx.getImageData(0, 0, width, height).data;
        const step = 6;
        let skinPixels = 0;
        let upperSkinPixels = 0;
        let lowerSkinPixels = 0;
        let rightSkinPixels = 0;
        let leftSkinPixels = 0;
        let minX = width;
        let maxX = 0;
        let minY = height;
        let maxY = 0;

        for (let y = 0; y < height; y += step) {
            for (let x = 0; x < width; x += step) {
                const index = (y * width + x) * 4;
                const r = imageData[index];
                const g = imageData[index + 1];
                const b = imageData[index + 2];
                const max = Math.max(r, g, b);
                const min = Math.min(r, g, b);

                const isSkinLike =
                    r > 55 && g > 28 && b > 18 &&
                    r > g * 0.95 && r > b * 1.08 &&
                    max - min > 12 &&
                    !(r > 220 && g > 220 && b > 220) &&
                    !(Math.abs(r - g) < 10 && Math.abs(g - b) < 10);

                if (isSkinLike) {
                    skinPixels++;
                    if (y < height * 0.70) upperSkinPixels++;
                    else lowerSkinPixels++;
                    if (x > width * 0.55) rightSkinPixels++;
                    if (x < width * 0.45) leftSkinPixels++;
                    minX = Math.min(minX, x);
                    maxX = Math.max(maxX, x);
                    minY = Math.min(minY, y);
                    maxY = Math.max(maxY, y);
                }
            }
        }

        if (skinPixels < 18) {
            return false;
        }

        const skinWidth = maxX - minX;
        const skinHeight = maxY - minY;
        const hasFaceSizedSkinPatch = skinWidth >= 32 && skinHeight >= 32;
        const hasSkinInFaceArea = upperSkinPixels >= 10 || rightSkinPixels >= 10 || leftSkinPixels >= 10;

        return hasFaceSizedSkinPatch && hasSkinInFaceArea && quality.skinRatio >= 0.003;
    }

    async function validateSecureLogoutFaceImage(canvasElement) {
        const quality = getSecureLogoutFaceImageQuality(canvasElement);

        // نرفض الصورة الفاضية/السوداء/الرمادي، لكن نسمح بصورة وجه بعيدة أو فيها حركة بسيطة.
        if (quality.averageLuminance < 28 || quality.averageLuminance > 248 || quality.variance < 55 || quality.colorRatio < 0.006) {
            return false;
        }

        // الأفضل استخدام FaceDetector لو متاح، مع قبول الوجه حتى لو بعيد أو في طرف الصورة.
        if ('FaceDetector' in window) {
            try {
                const detector = new FaceDetector({ fastMode: true, maxDetectedFaces: 5 });
                const faces = await detector.detect(canvasElement);

                if (faces && faces.length > 0) {
                    const imageArea = canvasElement.width * canvasElement.height;
                    const hasValidDetectedFace = faces.some(function (face) {
                        const box = face.boundingBox || {};
                        const faceWidth = box.width || 0;
                        const faceHeight = box.height || 0;
                        const faceArea = faceWidth * faceHeight;

                        return faceWidth >= 28 && faceHeight >= 28 && imageArea > 0 && (faceArea / imageArea) >= 0.0035;
                    });

                    if (hasValidDetectedFace) {
                        return true;
                    }
                }
            } catch (error) {
                // نستخدم الفحص الاحتياطي بالأسفل لأن بعض المتصفحات تفشل في FaceDetector مع الإضاءة أو الحركة.
            }
        }

        return hasLikelySecureLogoutHumanFaceFallback(canvasElement, quality);
    }

    async function captureSecureLogoutPhoto() {
        const video = document.getElementById('secureLogoutCamera');
        const canvas = document.getElementById('secureLogoutCanvas');
        const preview = document.getElementById('secureLogoutPreview');
        const errorBox = document.getElementById('secureLogoutError');
        const successBox = document.getElementById('secureLogoutSuccess');

        if (!video || !video.videoWidth || !video.videoHeight) {
            errorBox.innerText = "الكاميرا لم تعمل بعد، انتظر لحظة ثم حاول مرة أخرى";
            errorBox.style.display = "block";
            return false;
        }

        canvas.width = video.videoWidth;
        canvas.height = video.videoHeight;

        const canvasContext = canvas.getContext('2d');
        canvasContext.drawImage(video, 0, 0, canvas.width, canvas.height);

        const isValidFaceImage = await validateSecureLogoutFaceImage(canvas);

        if (!isValidFaceImage) {
            secureLogoutFaceBase64 = "";
            preview.src = "";
            preview.style.display = "none";
            video.style.display = "block";
            successBox.style.display = "none";
            errorBox.innerText = secureLogoutFaceValidationMessage;
            errorBox.style.display = "block";
            return false;
        }

        secureLogoutFaceBase64 = canvas.toDataURL('image/jpeg', 0.75);

        preview.src = secureLogoutFaceBase64;
        preview.style.display = "block";
        video.style.display = "none";

        errorBox.style.display = "none";
        successBox.style.display = "block";

        stopSecureLogoutCamera();

        return true;
    }

    function retakeSecureLogoutPhoto() {
        secureLogoutFaceBase64 = "";

        const preview = document.getElementById('secureLogoutPreview');
        const successBox = document.getElementById('secureLogoutSuccess');
        const errorBox = document.getElementById('secureLogoutError');

        if (preview) {
            preview.src = "";
            preview.style.display = "none";
        }

        if (successBox) {
            successBox.style.display = "none";
        }

        if (errorBox) {
            errorBox.style.display = "none";
        }

        hideSecureLogoutLoading();

        startSecureLogoutCamera();
    }

    function showSecureLogoutLoading() {
        const loadingOverlay = document.getElementById('secureLogoutLoadingOverlay');
        const errorBox = document.getElementById('secureLogoutError');
        const successBox = document.getElementById('secureLogoutSuccess');
        const confirmBtn = document.getElementById('secureLogoutConfirmBtn');
        const retakeBtn = document.getElementById('secureLogoutRetakeBtn');

        if (errorBox) {
            errorBox.style.display = "none";
        }

        if (successBox) {
            successBox.style.display = "none";
        }

        if (loadingOverlay) {
            loadingOverlay.style.display = "flex";
        }

        isSecureLogoutSubmitting = true;

        if (confirmBtn) {
            confirmBtn.disabled = true;
            confirmBtn.setAttribute('disabled', 'disabled');
            confirmBtn.setAttribute('aria-disabled', 'true');
            confirmBtn.classList.add('is-logging-out');
            confirmBtn.innerHTML = `
                        <span class="secure-logout-btn-content">
                            <span class="secure-logout-btn-check">✓</span>
                            <span>جاري تسجيل الخروج</span>
                        </span>
                    `;
        }

        if (retakeBtn) {
            retakeBtn.disabled = true;
            retakeBtn.setAttribute('disabled', 'disabled');
            retakeBtn.setAttribute('aria-disabled', 'true');
        }
    }

    function hideSecureLogoutLoading() {
        const loadingOverlay = document.getElementById('secureLogoutLoadingOverlay');
        const confirmBtn = document.getElementById('secureLogoutConfirmBtn');
        const retakeBtn = document.getElementById('secureLogoutRetakeBtn');

        if (loadingOverlay) {
            loadingOverlay.style.display = "none";
        }

        isSecureLogoutSubmitting = false;

        if (confirmBtn) {
            confirmBtn.disabled = false;
            confirmBtn.removeAttribute('disabled');
            confirmBtn.setAttribute('aria-disabled', 'false');
            confirmBtn.classList.remove('is-logging-out');
            confirmBtn.innerHTML = "تأكيد الخروج";
        }

        if (retakeBtn) {
            retakeBtn.disabled = false;
            retakeBtn.removeAttribute('disabled');
            retakeBtn.setAttribute('aria-disabled', 'false');
        }
    }

    function secureLogoutDelay(milliseconds) {
        return new Promise(function (resolve) {
            setTimeout(resolve, milliseconds);
        });
    }

    async function handleSecureLogoutConfirm() {
        const errorBox = document.getElementById('secureLogoutError');
        const confirmBtn = document.getElementById('secureLogoutConfirmBtn');

        if (isSecureLogoutSubmitting || (confirmBtn && confirmBtn.disabled)) {
            return;
        }

        if (!secureLogoutFaceBase64) {
            const captured = await captureSecureLogoutPhoto();

            if (!captured) {
                return;
            }
        }

        try {
            showSecureLogoutLoading();

            const tokenInput = document.querySelector('#logoutForm input[name="__RequestVerificationToken"]');
            const token = tokenInput ? tokenInput.value : "";

            const response = await fetch('/EmployeeAttendance/RegisterCheckOut', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify({
                    faceImageBase64: secureLogoutFaceBase64,
                    checkOutIpAddress: secureLogoutIpAddress,
                    checkOutLocation: secureLogoutLocation
                })
            });

            const result = await response.json();

            if (result && result.success) {
                stopSecureLogoutCamera();

                await secureLogoutDelay(900);

                const popup = document.getElementById('secureLogoutPopup');
                if (popup) {
                    popup.remove();
                }

                clearLuxiraLogoutClientState();

                document.getElementById('logoutForm').submit();
                return;
            }

            errorBox.innerText = result && result.message
                ? result.message
                : "حصل خطأ أثناء تسجيل الخروج، حاول مرة أخرى.";

            errorBox.style.display = "block";
            hideSecureLogoutLoading();
        } catch (error) {
            errorBox.innerText = "حصل خطأ أثناء تسجيل الخروج، حاول مرة أخرى.";
            errorBox.style.display = "block";
            hideSecureLogoutLoading();
        }
    }









    document.addEventListener('DOMContentLoaded', function () {
