<script id="luxira-shift-auto-logout-script">
    (function () {
        if (window.__luxiraShiftAutoLogoutStarted) {
            return;
        }

        window.__luxiraShiftAutoLogoutStarted = true;

        async function checkCurrentShiftAccess() {
            try {
                const response = await fetch('/ShiftAccess/CheckCurrentShift', {
                    method: 'GET',
                    cache: 'no-store',
                    credentials: 'same-origin',
                    headers: {
                        'Accept': 'application/json'
                    }
                });

                if (!response.ok) {
                    return;
                }

                const result = await response.json();

                if (result && result.shouldLogout && result.redirectUrl) {
                    window.location.href = result.redirectUrl;
                }
            } catch {
                // Silent check: if the network fails, the next timer run will try again.
            }
        }

        window.setTimeout(checkCurrentShiftAccess, 10000);
        window.setInterval(checkCurrentShiftAccess, 60000);
    })();
</script>

