    async function luxiraReturnToOriginalAdmin(event) {
        if (event) {
            event.preventDefault();
            event.stopPropagation();
        }

        clearLuxiraLogoutClientState();
        rememberOriginalAdminOnLoginPage();

        try {
            const response = await fetch(switchReturnToAdminUrl, {
                method: 'POST',
                cache: 'no-store',
                credentials: 'same-origin',
                headers: {
                    'Accept': 'application/json'
                }
            });

            let result = null;

            try {
                result = await response.json();
            } catch (jsonError) {
                result = null;
            }

            if (response.ok && result && result.success) {
                const redirectUrl = result.redirectUrl || '/Home/Index';
                const separator = redirectUrl.indexOf('?') === -1 ? '?' : '&';
                const targetUrl = redirectUrl + separator + '_adminReturn=' + new Date().getTime();

                window.location.replace(targetUrl);

                window.setTimeout(function () {
                    window.location.href = targetUrl;
                }, 250);

                return;
            }
        } catch (e) {
            // fallback below
        }

        /*
            Fallback مباشر:
            لو الـ POST رجع Redirect/HTML أو حصلت مشكلة JSON، نستخدم GET endpoint.
            برضه لا يوجد تصوير خروج ولا إدخال باسورد.
        */
        var separator = switchReturnToAdminDirectUrl.indexOf('?') === -1 ? '?' : '&';
        var targetUrl = switchReturnToAdminDirectUrl + separator + '_=' + new Date().getTime();

        window.location.replace(targetUrl);

        window.setTimeout(function () {
            window.location.href = targetUrl;
        }, 250);
    }

