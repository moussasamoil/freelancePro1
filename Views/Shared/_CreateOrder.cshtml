                var steps = [
                    { name: 'phone1', fn: function () { $c('phoneRow').hide(); } },
                    { name: 'phone2', fn: function () { $c('secondPhoneCol').hide(); $c('primaryPhoneCol').removeClass('col-6').addClass('col-12'); } },
                    { name: 'customerName', fn: function () { $c('customerStoreRow').hide(); } },
                    { name: 'store', fn: function () { $c('storeCol').hide(); $c('customerNameCol').removeClass('col-6').addClass('col-12'); } },
                    { name: 'address', fn: function () { $c('addressRow').hide(); } },
                    { name: 'deliveryAndPhoto', fn: function () { $c('deliveryPhotoRow').hide(); } },
                    { name: 'orderSource', fn: function () { $c('orderSourceRow').hide(); } },
                    { name: 'postChatUrl', fn: function () { postChatUrlReached = false; $c('createdDateCol').hide(); $c('selectedProductsList').hide(); $c('campaignGalleryWrap').hide(); syncChatUrlDateRow(); } },
                    { name: 'paymentStatus', fn: function () { $c('paymentRow').hide(); $c('notesRow').hide(); $c('paymentReceiptCol').hide(); $c('paymentCol').removeClass('col-6').addClass('col-12'); $c('PaymentReceiptPaste').empty().removeClass('success'); var rf = document.getElementById('PaymentReceiptFile'); if (rf) rf.value = ''; $c('totalPriceWrap').removeClass('d-flex').hide(); } }
                ];
                var startIdx = -1;
                for (var i = 0; i < steps.length; i++) {
