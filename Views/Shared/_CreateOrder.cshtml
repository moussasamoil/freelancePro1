            // ============================================================
            // PHONE NUMBER (per-country length & pattern rules)
            // lengths/patterns order: [00-prefix, +-prefix, national]
            // ============================================================
            const COUNTRY_PHONE_CONFIG = {
                'العراق': { code: '964', lengths: [15, 14, 11], patterns: [/^009647\d{9}$/, /^\+9647\d{9}$/, /^07\d{9}$/] },
                'تركيا': { code: '90', lengths: [14, 13, 11], patterns: [/^00905\d{9}$/, /^\+905\d{9}$/, /^05\d{9}$/] },
                'ليبيا': { code: '218', lengths: [14, 13, [9, 10]], patterns: [/^002189\d{8}$/, /^\+2189\d{8}$/, /^0?9\d{8}$/] },
                'الإمارات': { code: '971', lengths: [14, 13, 10], patterns: [/^009715\d{8}$/, /^\+9715\d{8}$/, /^05\d{8}$/] },
                'سلطنة_عمان': { code: '968', lengths: [13, 12, 8], patterns: [/^00968[97]\d{7}$/, /^\+968[97]\d{7}$/, /^[97]\d{7}$/] },
                'البحرين': { code: '973', lengths: [13, 12, 8], patterns: [/^00973[36]\d{7}$/, /^\+973[36]\d{7}$/, /^[36]\d{7}$/] },
                'تونس': { code: '216', lengths: [13, 12, 8], patterns: [/^00216[23459]\d{7}$/, /^\+216[23459]\d{7}$/, /^[23459]\d{7}$/] },
                'الكويت': { code: '965', lengths: [13, 12, 8], patterns: [/^00965[4569]\d{7}$/, /^\+965[4569]\d{7}$/, /^[4569]\d{7}$/] },
                'السعودية': { code: '966', lengths: [14, 13, 10], patterns: [/^009665\d{8}$/, /^\+9665\d{8}$/, /^05\d{8}$/] },
                'قطر': { code: '974', lengths: [13, 12, 8], patterns: [/^00974[3567]\d{7}$/, /^\+974[3567]\d{7}$/, /^[3567]\d{7}$/] },
                'فلسطين': { code: '970', lengths: [14, 13, 10], patterns: [/^009705\d{8}$/, /^\+9705\d{8}$/, /^05\d{8}$/] },
                'الأردن': { code: '962', lengths: [14, 13, 10], patterns: [/^009627\d{8}$/, /^\+9627\d{8}$/, /^07\d{8}$/] },
            };
            function detectPhoneType(cleaned) {
                if (cleaned.startsWith('00')) return 0;
                if (cleaned.startsWith('+')) return 1;
                return 2;
            }
            // Convert Arabic-Indic (٠-٩) and Eastern Arabic-Indic (۰-۹) digits to ASCII (0-9)
            function toAsciiDigits(str) {
                return String(str).replace(/[٠-٩۰-۹]/g, function (d) {
                    const code = d.charCodeAt(0);
                    return String.fromCharCode(code - (code >= 0x06F0 ? 0x06F0 : 0x0660) + 0x30);
                });
            }
            function validatePhone(country, raw) {
                // Whitelist: convert Arabic/Persian digits to ASCII, then strip anything that isn't
                // a digit or '+'. This neutralizes pasted noise — invisible bidi marks, dashes, spaces,
                // parentheses, dots, letters — without us having to enumerate every possible character.
                const cleaned = toAsciiDigits(raw).replace(/[^0-9+]/g, '');
                const cfg = COUNTRY_PHONE_CONFIG[country];
                if (!cfg || cleaned.length === 0) return { valid: false, cleaned };
                const type = detectPhoneType(cleaned);
                const pattern = cfg.patterns[type];
                const len = cfg.lengths[type];
                const lenOk = Array.isArray(len) ? len.includes(cleaned.length) : cleaned.length === len;
                const valid = lenOk && pattern.test(cleaned);
                return { valid, cleaned, type };
            }
            function updatePhoneNumberValidation(country) {
                const $phone = $c('TelephoneNumber');
                const cfg = COUNTRY_PHONE_CONFIG[country];
                // Allow the longest possible form (00 + code + mobile) plus room for spaces
                const maxInputLen = cfg ? cfg.lengths[0] + 6 : 20;
                $phone
                    .removeAttr('pattern')
                    .removeAttr('minlength')
                    .attr('maxlength', maxInputLen)
                    .data('country', country)
                    .val('')
                    .removeClass('error success');
                $phone.closest('.form-group').next('.required-message').remove();
                phoneErrorMessageShown = false;
                $c('secondPhoneCol').hide();
                $c('primaryPhoneCol').removeClass('col-6').addClass('col-12');
            }
            // Define a flag to track if the message has been shown
            let phoneErrorMessageShown = false;
            let spinnerTimeout;
            $c('TelephoneNumber').on('input paste', function () {
                const inputElement = $(this);

                setTimeout(function () {
                    const currentVal = inputElement.val() || '';
                    const asciiVal = toAsciiDigits(currentVal).replace(/[^0-9+]/g, '');

                    if (asciiVal !== currentVal) {
                        inputElement.val(asciiVal);
                    }

                    const country = inputElement.data('country');
                    const result = validatePhone(country, inputElement.val());
                    const isValid = result.valid;
                    const $container = inputElement.closest('.form-group');
                    const $spinner = $container.find('.spinner-icon');

                    clearTimeout(spinnerTimeout);
                    $spinner.hide();

                    // أثناء الكتابة لا نمنع ولا نهز ولا نخفي باقي الفورم.
                    inputElement.removeClass('error');
                    if (phoneErrorMessageShown) {
                        $container.next('.required-message').remove();
                        phoneErrorMessageShown = false;
                    }

                    if (isValid) {
                        inputElement.addClass('success');
                        cascadeReveal();
                    } else {
                        inputElement.removeClass('success');
                    }

                    updateSubmitButtonState();
                }, 0);
            });

            $c('TelephoneNumber').on('blur', function () {
                const inputElement = $(this);
                const country = inputElement.data('country');
                const result = validatePhone(country, inputElement.val());
                const isValid = result.valid;
                const $container = inputElement.closest('.form-group');
                const $spinner = $container.find('.spinner-icon');

                $spinner.hide();

                if (inputElement.val().trim() !== '' && !isValid) {
                    inputElement.addClass('error').removeClass('success');
                    if (!phoneErrorMessageShown) {
                        $container.after('<div class="required-message">يرجى إدخال رقم هاتف صحيح</div>');
                        phoneErrorMessageShown = true;
                    } else {
                        $container.next('.required-message').text('يرجى إدخال رقم هاتف صحيح').show();
                    }
                    hideFromStep('phone2');
                } else if (isValid) {
                    inputElement.addClass('success').removeClass('error');
                    if (phoneErrorMessageShown) {
                        $container.next('.required-message').remove();
                        phoneErrorMessageShown = false;
                    }
                    cascadeReveal();
                }

                updateSubmitButtonState();
            });
            // ============================================================
            // SUCCESS / FAILURE MESSAGE DIALOGS
            // ============================================================
            $modalRoot.find('.text-danger').hide();
            $c('closeSuccess').click(function (event) {
                $('#successmessage').addClass('hidden');
                event.stopPropagation();
            });
            $(document).click(function (event) {
                if (!$(event.target).closest('#successmessage').length && !$(event.target).closest('#Create').length) {
                    $('#successmessage').addClass('hidden');
                }
            });
            $c('closeAndOpenOrderBtn').click(function (event) {
                $('#successmessage').addClass('hidden');
                $modalRoot.modal('show');
                event.stopPropagation();
            });
            // ============================================================
            // SOURCE NAME / CHAT URL VISIBILITY (driven by order source)
            // ============================================================
            function toggleSourceNameInput() {
                var orderSourceDropdown = $c('orderSourceDropdown');
                var sourceNameInput = $c('SourceName');
                var sourceNameCol = $c('sourceNameCol');
                var orderSourceCol = $c('orderSourceCol');
                var selectedValue = orderSourceDropdown.val();
                // Only show SourceName when a source other than واتساب (4) is explicitly chosen.
                // Default state (no selection) and WhatsApp both keep the field hidden.
                if (selectedValue && selectedValue !== "4") {
                    sourceNameInput.prop('disabled', false);
                    sourceNameInput.attr('required', true);
                    sourceNameCol.show();
                    orderSourceCol.removeClass('col-12').addClass('col-6');
                } else {
                    sourceNameInput.prop('disabled', true);
                    sourceNameInput.removeAttr('required');
                    sourceNameCol.hide();
                    orderSourceCol.removeClass('col-6').addClass('col-12');
                }
                // Chat URL gate: hidden when no source is picked or for WhatsApp (no URL on
                // those orders). Shown + required for every other source. The createdDate
                // and the products/campaign gallery normally wait for chatUrl validity, but
                // for WhatsApp orders there is no chatUrl so we reveal them as soon as the
                // source is chosen.
                var chaturlInput = $c('ChatUrl');
                var chatUrlCol = $c('chatUrlCol');
                if (!selectedValue) {
                    chaturlInput.removeAttr('required').val('').removeClass('error success');
                    chaturlInput.closest('.form-group').next('.required-message').remove();
                    chatUrlCol.hide();
                    hideFromStep('postChatUrl');
                } else if (selectedValue === "4") {
                    // WhatsApp: no chat URL needed — skip straight to date/products/campaigns.
                    chaturlInput.removeAttr('required').val('').removeClass('error success');
                    chaturlInput.closest('.form-group').next('.required-message').remove();
                    chatUrlCol.hide();
                    cascadeReveal();
                } else {
                    chaturlInput.attr('required', true);
                    chatUrlCol.show();
                    // Wait for a valid chatUrl before revealing date/products/campaigns.
                    hideFromStep('postChatUrl');
                }
                syncChatUrlDateRow();
                orderSourceDropdown.next('.select2-container').css('width', '100%');
            }
            function toggleCampaignVisibility() {
                // Campaign gallery requires both: a store selected (so we have campaigns to
                // render at all) AND the disclosure tree to have reached the postChatUrl
                // step (revealed when chatUrl is valid, or for WhatsApp orders right after
                // source selection). renderCampaignGallery() handles the empty-list case.
                if (selectedStoreId && postChatUrlReached) {
                    renderCampaignGallery();
                } else {
                    $c('campaignGalleryWrap').hide();
                }
                $c('campaignDropdown').next('.select2-container').css('width', '100%');
            }
            function toggleProductVisibility() {
                if (selectedStoreId && postChatUrlReached) {
                    $c('selectedProductsList').show();
                } else {
                    $c('selectedProductsList').hide();
                }
                $c('productDropdown').next('.select2-container').css('width', '100%');
            }
            // Call the function on page load and when the order source dropdown changes
            toggleSourceNameInput();
            toggleCampaignVisibility();
            toggleProductVisibility();
            $c('orderSourceDropdown').change(toggleSourceNameInput);
            // No IsPaid change handler — payment status is optional and does not gate
            // any downstream field. Notes and TotalPrice both reveal alongside payment
            // at the paymentStatus step.

            // ============================================================
            // INITIAL LOAD — stores list for manufacturingCompanyDropdown
            // ============================================================
            $.ajax({
                url: '/DataList/GetAllStores',
                type: 'GET',
                success: function (data) {
                    storesData = data;
                    var dropdown = $c('manufacturingCompanyDropdown');
                    dropdown.empty(); // Clear any existing options
                    // Append default option
                    dropdown.append($('<option></option>')
                        .val('')
                        .text('Select a Manufacturing Company')
                        .attr('disabled', 'disabled')
                        .attr('selected', 'selected'));
                    $.each(data, function (index, item) {
                        dropdown.append($('<option></option>')
                            .val(item.id)
                            .text(item.name)
                            .attr('data-image', item.logoUrl)
                            .attr('data-main-warehouse-id', item.mainWarehouseId || ''));
                    });
                    // Enable the dropdown after data is loaded
                    dropdown.prop('disabled', false);

                    if (data && data.length === 1) {
                        setTimeout(function () {
                            applySingleAllowedStore();
                            cascadeReveal();
                        }, 0);
                    }
                },
                error: function (error) {
                    console.log(error);
                }
            });
            // Hide placeholder (first option) in every Select2 when it opens.
            $modalRoot.find('select').on('select2:open', function (e) {
                // Immediately try to hide the first option
                // This is placed outside setTimeout to attempt to hide the option as soon as possible
                $('.select2-results__option:first-child').hide();
                // Then, use a minimal timeout to ensure the operation in case of any rendering delays
                setTimeout(function () {
                    // Re-attempt to hide the first option to ensure it's hidden if the first attempt was too early
                    $('.select2-results__option:first-child').hide();
                }, 1);
            });
            // ============================================================
            // CASCADING DROPDOWNS — country -> city / campaigns / delivery / warehouses
            // ============================================================
            $c('countryDropdown').change(function () {
                var selectedCountry = $(this).val();
                if (selectedCountry) removeErrorClassAndMessage($(this));
                updatePhoneNumberValidation(selectedCountry);
                // Reset the form but keep the selected country
                $c('createOrderForm').trigger("reset");
                $('#OrderPhotoPaste').empty();
                $c('countryDropdown').val(selectedCountry).trigger('change.select2');
                // Form reset clears values but not inline display state — re-run the
                // source-driven toggles so leftover-visible cells collapse back.
                $c('orderSourceDropdown').val('').trigger('change.select2');
                selectedStoreMainWarehouseId = null;
                selectedStoreId = null;
                allCampaigns = [];
                $c('campaignDropdown').data('touched', false).val('').trigger('change.select2');
                toggleSourceNameInput();
                // Country switch always rewinds the disclosure tree to the city step.
                // Hide everything from phone1 onward; only the city reveals here.
                hideFromStep('phone1');
                if (selectedCountry) {
                    revealStep('city');
                } else {
                    $c('cityCol').hide();
                    $c('countryCol').removeClass('col-6').addClass('col-12');
                }
                $c('countryDropdown').next('.select2-container').css('width', '100%');
                // Clear the city dropdown and repopulate
                resetCityDropdown();
                populateCities(selectedCountry);
                updatecampagins(); // fetches the campaign pool for the selected country (unfiltered)
                if (!applySingleAllowedStore()) {
                    $c('manufacturingCompanyDropdown').prop('disabled', false).closest('.form-group').show();
                    $c('manufacturingCompanyDropdown').next('.select2-container').show().css('width', '100%');
                }
                removeAppendedWarehouseItems();
                // Turkey has stricter name + address rules; re-run the validators when country switches.
                $c('CustomerName').trigger('blur');
                $c('Address').trigger('blur');
            });
            $c('cityDropdown').change(function () {
                if ($(this).val()) removeErrorClassAndMessage($(this));
                // City no longer drives the delivery party reveal — that now waits for
                // a valid address. We still pre-fetch the parties list here so it's
                // ready by the time the address handler asks for it; updateDeliveryParties
                // populates the dropdown but the row stays hidden until reveal time.
                updateDeliveryParties();
                confirmedAmeelDeliveryValue = '';
                previousConfirmedDeliveryPartyValue = '';
                $c('deliveryPartyDropdown').val('');
                if ($(this).val()) {
                    cascadeReveal();
                } else {
                    hideFromStep('phone1');
                }
            });
            var confirmedAmeelDeliveryValue = '';
            var previousConfirmedDeliveryPartyValue = '';
            var suppressDeliveryPartyConfirm = false;

            function processDeliveryPartyChange($dropdown) {
                if ($dropdown.val()) {
                    removeErrorClassAndMessage($dropdown);
                    previousConfirmedDeliveryPartyValue = $dropdown.val();
                }
                updateWarehouses();
                removeAppendedWarehouseItems();
                productDropdownSelect.prop('disabled', false);
                // Order source reveal requires both: a photo pasted AND a delivery party selected
                // (auto-selected for single-party countries, or manually picked for multi-party).
                maybeRevealOrderSource();
            }

            $c('deliveryPartyDropdown').change(function () {
                var $dropdown = $(this);
                var selectedValue = $dropdown.val();

                if (suppressDeliveryPartyConfirm) {
                    suppressDeliveryPartyConfirm = false;
                    return;
                }

                if (selectedValue && isLibyaCountrySelected() && isAmeelDeliveryOption($dropdown) && confirmedAmeelDeliveryValue !== selectedValue) {
                    showCreateConfirm(
                        'هذه الشركة تابعة لتحويلات بنكية، هل أنت متأكد من اختيارها؟',
                        function () {
                            confirmedAmeelDeliveryValue = selectedValue;
                            processDeliveryPartyChange($dropdown);
                        },
                        function () {
                            suppressDeliveryPartyConfirm = true;
                            $dropdown.val(previousConfirmedDeliveryPartyValue || '').trigger('change.select2');
                            if (!previousConfirmedDeliveryPartyValue) {
                                hideFromStep('orderSource');
                                removeAppendedWarehouseItems();
                            }
                        }
                    );
                    return;
                }

                processDeliveryPartyChange($dropdown);
            });
            // Store change reveals address. Products/campaigns visibility is no longer
            // driven by store selection — they wait for a valid chat URL (or WhatsApp
            // source) further down the disclosure tree.
            $c('manufacturingCompanyDropdown').change(function () {
                if ($(this).val()) removeErrorClassAndMessage($(this));
                // Clear any previously selected warehouses/products since they may not belong to the new store
                removeAppendedWarehouseItems();
                if ($(this).val() === "") {
                    productDropdownSelect.prop('disabled', true);
                    selectedStoreMainWarehouseId = null;
                    selectedStoreId = null;
                    hideFromStep('address');
                } else {
                    productDropdownSelect.prop('disabled', false);
                    var selectedOption = $(this).find('option:selected');
                    var mwId = selectedOption.attr('data-main-warehouse-id');
                    selectedStoreMainWarehouseId = mwId ? parseInt(mwId) : null;
                    selectedStoreId = parseInt($(this).val());
                    populateFirstWarehouseDropdown();
                    cascadeReveal();
                }
                populateCampaignDropdown(); // filters the country campaign pool down to this store's campaigns
            });
            // ============================================================
            // CITY DROPDOWN (populated from the static CitiesByCountry map)
            // ============================================================
            function resetCityDropdown() {
                var cityDropdown = $c('cityDropdown');
                cityDropdown.empty();
                cityDropdown.append($('<option>', {
                    value: '',
                    text: 'المدينة',
                    "data-image": "/static/city-regular.svg", // Static image for the placeholder
                    disabled: true,
                    selected: true
                })).val('').trigger('change'); // Clear any existing options and reset value
                // Re-initialize Select2 for cityDropdown
                cityDropdown.select2({
                    placeholder: 'المدينة',
                    allowClear: true,
                    templateResult: formatOption,
                    templateSelection: formatOption,
                    dropdownParent: $('#Create'),
                    dir: "rtl",
                    width: '100%'
                });
            }
            // Function to populate cities dropdown based on the selected country
            function populateCities(selectedCountry) {
                var cityDropdown = $c('cityDropdown');
                cityDropdown.empty();
                cityDropdown.append($('<option>', {
                    value: '',
                    text: 'المدينة',
                    "data-image": "/static/city-regular.svg", // Static image for the placeholder
                    disabled: true,
                    selected: true
                }));
                if (selectedCountry && citiesByCountry[selectedCountry]) {
                    var cities = citiesByCountry[selectedCountry];
                    var modelStateExists = cities.some(city => city === modelState);
                    // Loop through cities and append each as an option
                    cities.forEach(function (city) {
                        cityDropdown.append($('<option>', {
                            value: city,
                            text: city,
                            "data-image": "/static/city-regular.svg" // Use the static image URL for all city options
                        }));
                    });
                    // Set the selected value
                    cityDropdown.val(modelStateExists ? modelState : '').trigger('change');
                } else {
                    // No cities available for the selected country
                    cityDropdown.append($('<option>', {
                        value: '',
                        text: 'المدينة',
                        "data-image": "/static/city-regular.svg" // Static image for the placeholder
                    })).val('').trigger('change');
                }
                // Re-initialize Select2 for cityDropdown
                cityDropdown.select2({
                    templateResult: formatOption,
                    templateSelection: formatOption,
                    dropdownParent: $('#Create'),
                    dir: "rtl",
                    width: '100%'
                });
            }
            // ============================================================
            // CAMPAIGNS (ads) — fetched by country, filtered by store
            // ============================================================
            function updatecampagins() {
                var country = $c('countryDropdown').val();
                $.ajax({
                    type: 'GET',
                    url: '@Url.Action("GetCampaignsByCountry", "DataList")',
                    data: { countryId: country },
                    success: function (data) {
                        allCampaigns = data || [];
                        populateCampaignDropdown();
                        toggleCampaignVisibility();
                    },
                    error: function (xhr, textStatus, errorThrown) {
                        console.error('Error: ' + textStatus, errorThrown);
                    }
                });
            }
            function getFilteredCampaigns() {
                // Only campaigns explicitly linked to the currently selected store.
                if (!selectedStoreId) {
                    return [];
                }
                return allCampaigns.filter(function (c) {
                    return c.manufacturingCompanyId === selectedStoreId;
                });
            }
            function populateCampaignDropdown() {
                var campaignDropdown = $c('campaignDropdown');
                var previousValue = campaignDropdown.val();
                var wasTouched = campaignDropdown.data('touched') === true;
                var filtered = getFilteredCampaigns();

                campaignDropdown.empty();
                campaignDropdown.append($('<option>', {
                    value: '',
                    text: 'اختر الإعلان',
                    disabled: true,
                    selected: true,
                    hidden: true
                }));

                if (!filtered || filtered.length === 0) {
                    // No ads for this store: do not stop the flow and submit as null CampaignId.
                    campaignDropdown.append($('<option>', {
                        value: 'none',
                        text: 'بدون إعلان',
                        "data-image": "/static/truck-regular.svg"
                    }));
                    campaignDropdown.val('none');
                    campaignDropdown.data('touched', true);
                } else {
                    $.each(filtered, function (index, ad) {
                        campaignDropdown.append($('<option>', {
                            value: ad.id,
                            text: ad.name,
                            'data-image': ad.imageUrl
                        }));
                    });

                    // Preserve prior real campaign only if it still belongs to the selected store.
                    if (previousValue && previousValue !== 'none' && filtered.some(function (c) { return c.id == previousValue; })) {
                        campaignDropdown.val(previousValue);
                        campaignDropdown.data('touched', wasTouched);
                    } else {
                        campaignDropdown.val('');
                        campaignDropdown.data('touched', false);
                    }
                }

                campaignDropdown.select2({
                    templateResult: formatOption,
                    templateSelection: formatOption,
                    dropdownParent: $('#Create'),
                    dir: "rtl"
                });
                campaignDropdown.trigger('change.select2');

                renderCampaignGallery();
                maybeRevealPaymentStatus();
                updateSubmitButtonState();
            }
            // ============================================================
            // DELIVERY COMPANIES & REPRESENTATIVES
            // ============================================================
            function updateDeliveryParties() {
                var country = $c('countryDropdown').val();
                var city = $c('cityDropdown').val();
                if (!country || !city) return;
                $.ajax({
                    type: 'GET',
                    url: '@Url.Action("GetAllDeliveryCompaniesAndRepresentatives", "DataList")',
                    data: { countryId: country, cityId: city },
                    success: function (data) {
                        var dd = $c('deliveryPartyDropdown');
                        dd.empty();
                        dd.append($('<option>', {
                            value: '',
                            text: 'اختر طرف التوصيل',
                            'data-image': '/static/truck-regular.svg',
                            disabled: true,
                            selected: true
                        }));
                        $.each(data || [], function (index, p) {
                            dd.append($('<option>', {
                                value: p.id,
                                text: p.name,
                                'data-image': p.logoUrl,
                                'data-is-delivery-rep': p.isRepresentative ? 'true' : 'false'
                            }));
                        });
                        dd.select2({
                            templateResult: formatOption,
                            templateSelection: formatOption,
                            dropdownParent: $('#Create'),
                            dir: 'rtl',
                            width: '100%'
                        });
                        // Only reveal the delivery column when there's more than one party.
                        // With 0 or 1, auto-select (when present) and keep it hidden so the
                        // order-screenshot cell spans the full row. With >1 they share col-6.
                        var $deliveryCol = $c('deliveryCompanyCol');
                        var $photoCol = $c('orderPhotoCol');
                        if (data && data.length > 1) {
                            $deliveryCol.show();
                            $photoCol.removeClass('col-12').addClass('col-6');
                        } else {
                            if (data && data.length === 1) {
                                dd.val(data[0].id).trigger('change');
                                removeErrorClassAndMessage(dd);
                            }
                            $deliveryCol.hide();
                            $photoCol.removeClass('col-6').addClass('col-12');
                        }
                        $c('manufacturingCompanyDropdown').next('.select2-container').css('width', '100%');
                    },
                    error: function (xhr, textStatus, errorThrown) {
                        console.error('Error: ' + textStatus, errorThrown);
                    }
                });
            }
            // ============================================================
            // WAREHOUSES & PRODUCT ROWS
            // ============================================================
            function updateWarehouses() {
                var companyIdToSend = $c('deliveryPartyDropdown').val();
                $.ajax({
                    type: 'GET',
                    url: '@Url.Action("GetFilteredWarehouses", "DataList")',
                    data: { deliveryCompanyId: companyIdToSend },
                    success: function (data) {
                        allWarehouseOptions = data;
                        warehouseOptions = data;
                        populateFirstWarehouseDropdown();
                    },
                    error: function (xhr, textStatus, errorThrown) {
                        console.error('Error: ' + textStatus, errorThrown);
                    }
                });
            }
            function hasMainWarehouseProduct() {
                if (!selectedStoreMainWarehouseId) return true;
                var found = false;
                $c('selectedProductsList').find('.appended-warehouse-row').each(function () {
                    if (parseInt($(this).attr('data-main-warehouse-id')) === selectedStoreMainWarehouseId) {
                        found = true;
                        return false;
                    }
                });
                return found;
            }
            function getFilteredWarehouseOptions() {
                if (isUnrestrictedRole || !selectedStoreMainWarehouseId || hasMainWarehouseProduct()) {
                    return warehouseOptions;
                }
                return warehouseOptions.filter(function (w) {
                    var mw = parseInt(getWarehouseMainWarehouseIdValue(w) || 0);
                    return mw === parseInt(selectedStoreMainWarehouseId || 0);
                });
            }
            function populateFirstWarehouseDropdown() {
                var warehouseDropdown = $c('productDropdown');
                warehouseDropdown.find('option').not('[value=""]').remove();
                var displayOptions = getFilteredWarehouseOptions();
                $.each(displayOptions, function (index, warehouse) {
                    var warehouseId = getWarehouseIdValue(warehouse);
                    if (warehouseId === undefined || warehouseId === null || String(warehouseId).length === 0) {
                        return;
                    }

                    var warehouseName = getWarehouseNameValue(warehouse);
                    var warehouseImage = getWarehouseImageValue(warehouse);
                    var warehouseAmount = getWarehouseAmountValue(warehouse);
                    var warehouseMainId = getWarehouseMainWarehouseIdValue(warehouse) || selectedStoreMainWarehouseId || '';

                    warehouseDropdown.append($('<option>', {
                        value: warehouseId,
                        text: warehouseName,
                        'data-image': warehouseImage,
                        'data-amount': warehouseAmount,
                        'data-main-warehouse-id': warehouseMainId
                    }));
                });
                warehouseDropdown.prop('disabled', false);
                warehouseDropdown.val('').trigger('change.select2');
                warehouseDropdown.next('.select2-container').css('width', '100%');
            }
            // ---- Appended warehouse rows: add / delete / quantity controls ----
            function addNewWarehouseItem(forcedWarehouseId, forcedWarehouseText, forcedOptionElement) {
                var selectedWarehouseId = forcedWarehouseId || $c('productDropdown').val();
                var selectedOption = forcedOptionElement ? $(forcedOptionElement) : $c('productDropdown').find('option:selected');

                if (!selectedWarehouseId || selectedWarehouseId === 'undefined' || selectedWarehouseId === 'null') {
                    selectedWarehouseId = selectedOption.val();
                }

                if (!selectedWarehouseId || selectedWarehouseId === 'undefined' || selectedWarehouseId === 'null') {
                    return;
                }

                var alreadyExists = $c('selectedProductsList').find('.appended-warehouse-row').filter(function () {
                    return String($(this).attr('data-warehouse-id')) === String(selectedWarehouseId);
                }).length > 0;
                if (alreadyExists) {
                    populateFirstWarehouseDropdown();
                    return;
                }

                var selectedWarehouse = (warehouseOptions || []).find(function (warehouse) {
                    var wid = getWarehouseIdValue(warehouse);
                    return String(wid) === String(selectedWarehouseId);
                }) || (allWarehouseOptions || []).find(function (warehouse) {
                    var wid = getWarehouseIdValue(warehouse);
                    return String(wid) === String(selectedWarehouseId);
                });

                // في حالة المتجر الواحد أو اختلاف أسماء الخصائص الراجعة من الـ API،
                // نبني المنتج من الـ option نفسه عشان الاختيار يتحول لصف منتج فعلي.
                if (!selectedWarehouse) {
                    selectedWarehouse = {
                        id: selectedWarehouseId,
                        name: forcedWarehouseText || selectedOption.text() || '',
                        productImage: selectedOption.attr('data-image') || '/mainicons/fallback_product.svg',
                        amount: selectedOption.attr('data-amount') || 999,
                        mainWarehouseId: selectedOption.attr('data-main-warehouse-id') || selectedStoreMainWarehouseId || ''
                    };
                }

                selectedWarehouse.id = getWarehouseIdValue(selectedWarehouse) || selectedWarehouseId;
                selectedWarehouse.name = getWarehouseNameValue(selectedWarehouse) || forcedWarehouseText || selectedOption.text() || '';
                selectedWarehouse.productImage = getWarehouseImageValue(selectedWarehouse) || selectedOption.attr('data-image') || '/mainicons/fallback_product.svg';
                selectedWarehouse.amount = getWarehouseAmountValue(selectedWarehouse) || selectedOption.attr('data-amount') || 999;
                selectedWarehouse.mainWarehouseId = getWarehouseMainWarehouseIdValue(selectedWarehouse) || selectedOption.attr('data-main-warehouse-id') || selectedStoreMainWarehouseId || '';

                var warehouseIndex = $c('selectedProductsList').find('.appended-warehouse-row').length;
                var warehouseHtml = `
                                                <div class="appended-warehouse-row row ms-0 mt-3" data-warehouse-id="${selectedWarehouse.id}" data-warehouse-name="${selectedWarehouse.name}" data-warehouse-amount="${selectedWarehouse.amount}" data-main-warehouse-id="${selectedWarehouse.mainWarehouseId}">
                                                    <div class="col-lg-6">
                                                        <div class="form-group appenddiv gold-warehouse">
                                                            <div class="warehouse-item">
                                                                <span><img width="25" height="23" src="${selectedWarehouse.productImage}"></span>
                                                                <span class="selected-warehouse">${selectedWarehouse.name}</span>
                                                                <input type="hidden" name="SelectedWarehouses[${warehouseIndex}].WarehouseId" value="${selectedWarehouse.id}">
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="col-lg-6 pe-4 ps-0">
                                                        <div class="form-group">
                                                            <div class="input-group my-input-group" style="width: 105%!important">
                                                                    <button type="button" id="decrease" class="btn f-s-1-50rem decrease rounded-btn">-</button>
                                                                <input min="1" type="text" inputmode="numeric" autocomplete="off" required value="1" placeholder="الكمية" class="form-control amount numeric-no-shake" name="SelectedWarehouses[${warehouseIndex}].Amount" />
                                                                    <button type="button" id="increase" class="btn f-s-1-50rem increase rounded-btn">+</button>
                                                            </div>
                                                            <span class="text-danger"></span> <!-- Placeholder for validation message -->
                                                        </div>
                                                    </div>
                                                </div>`;
                $c('selectedProductsList').append(warehouseHtml);
                // Update warehouse dropdown
                warehouseOptions = warehouseOptions.filter(function (warehouse) {
                    var wid = getWarehouseIdValue(warehouse);
                    return String(wid) !== String(selectedWarehouseId);
                });
                populateFirstWarehouseDropdown();
                updateSubmitButtonState(); // Update the submit button state
                // Remove the required message and add success class
                const $container = $c('productDropdown').next('.select2-container');
                const $selection = $container.find('.select2-selection.select2-selection--single');
                $container.next('.required-message').remove();
                $selection.addClass('success');
                maybeRevealPaymentStatus();
                runTotalPriceValidation();
            }
            // sho الكمية المتاحة
            $c('selectedProductsList').on('input', '.amount', function () {
                var $amountInput = $(this);
                var enteredValue = parseInt($amountInput.val());
                var maxAmount = parseInt($amountInput.closest('.row').data('warehouse-amount'));
                // Check if the entered value exceeds the maximum available amount
                if (!isNaN(enteredValue) && enteredValue > maxAmount) {
                    showFormError(`الكمية المتاحة ${maxAmount}`);
                    $amountInput.val(maxAmount); // Optionally reset the value to the max amount
                }

                runTotalPriceValidation();
                updateSubmitButtonState();
            });
            $c('selectedProductsList').on('click', '.increase', function () {
                var $amountInput = $(this).closest('.my-input-group').find('.amount');
                var value = parseInt($amountInput.val());
                var maxAmount = parseInt($amountInput.attr('max')); // Get the maximum value allowed from the max attribute
                var minAmount = parseInt($amountInput.attr('min')); // Get the minimum value allowed from the min attribute
                // Check if the current value is less than the maximum allowed value
                if (!isNaN(value) && (isNaN(maxAmount) || value < maxAmount)) {
                    $amountInput.val(value + 1); // Increment the value by 1
                    runTotalPriceValidation();
                    updateSubmitButtonState();
                }
            });
            $c('selectedProductsList').on('click', '.decrease', function () {
                var $amountInput = $(this).closest('.my-input-group').find('.amount');
                var value = parseInt($amountInput.val());
                if (!isNaN(value) && value > 1) {
                    $amountInput.val(value - 1);
                    runTotalPriceValidation();
                    updateSubmitButtonState();
                } else {
                    // If value is 1 or less, show confirmation dialog before removing the row
                    $currentRowToDelete = $(this).closest('.row');
                    $c('deleteProductConfirm').css('display', 'flex');
                }
            });
            $c('confirm-remove').on('click', function () {
                if ($currentRowToDelete) {
                    var warehouseId = $currentRowToDelete.data('warehouse-id');
                    var warehouseName = $currentRowToDelete.data('warehouse-name');
                    var warehouseAmount = $currentRowToDelete.data('warehouse-amount');
                    var warehouseToAddBack = allWarehouseOptions.find(function (w) {
                        return String(getWarehouseIdValue(w)) === String(warehouseId);
                    });
                    if (!warehouseToAddBack) {
                        warehouseToAddBack = { id: warehouseId, name: warehouseName, amount: warehouseAmount, mainWarehouseId: $currentRowToDelete.data('main-warehouse-id') || '' };
                    }
                    warehouseOptions.push(warehouseToAddBack);
                    populateFirstWarehouseDropdown();
                    $currentRowToDelete.remove();
                    $currentRowToDelete = null;
                    $c('deleteProductConfirm').css('display', 'none');
                    maybeRevealPaymentStatus();
                    runTotalPriceValidation();
                    updateSubmitButtonState();
                }
            });
            $c('cancel-remove').on('click', function () {
                $c('deleteProductConfirm').css('display', 'none');
            });
            // add warehouse item when selecting product.
            // Use the Select2 event data directly because in the single-store auto-select case
            // the normal .val() can be reset/cleared before the change handler reads it.
            $c('productDropdown').on('select2:select', function (e) {
                var item = e && e.params && e.params.data ? e.params.data : null;
                var pickedId = item ? item.id : $(this).val();
                var pickedText = item ? item.text : '';
                var pickedElement = item ? item.element : null;

                if (pickedId) {
                    addNewWarehouseItem(pickedId, pickedText, pickedElement);
                }
            });

            $c('productDropdown').on('change', function () {
                var pickedId = $(this).val();
                if (pickedId) {
                    addNewWarehouseItem(pickedId, '', null);
                }
            });
            function removeAppendedWarehouseItems() {
                $modalRoot.find('.appended-warehouse-row').remove();
            }

            // ============================================================
            // SUBMIT BUTTON STATE + FINAL FORM VALIDATION / SUBMIT
            // ============================================================
            function areInputsValid() {
                var isWhatsApp = $c('orderSourceDropdown').val() === "4";
                // List of input field IDs for non-numeric checks
                const inputIDs = [
                    'countryDropdown',
                    'cityDropdown',
                    'orderSourceDropdown',
                    'manufacturingCompanyDropdown',
                    'deliveryPartyDropdown',
                    'TelephoneNumber',
                    'CustomerName',
                    'Address',
                ];
                // WhatsApp orders have no chat URL — only validate it for other sources
                if (!isWhatsApp) {
                    inputIDs.push('ChatUrl');
                }
                // Check if standard inputs are non-empty
                const areStandardInputsValid = inputIDs.every(id => {
                    const value = $c(id).val();
                    return value !== '' && value != null;
                });
                // Check for TotalPrice to ensure it's a valid, non-empty number
                const totalPriceValue = $c('TotalPrice').val().trim();
                const isTotalPriceValid = totalPriceValue !== '' && !isNaN(parseFloat(totalPriceValue)) && isFinite(totalPriceValue);
                // Order screenshot must be pasted.
                var photoInput = document.getElementById('OrderPhotoFile');
                const isPhotoPasted = !!(photoInput && photoInput.files && photoInput.files.length > 0);
                // At least one warehouse/product row must be appended.
                const hasProduct = $c('selectedProductsList').find('.appended-warehouse-row').length > 0;
                // Campaign is not required for stores with no ads.
                // Stores with ads are checked on final submit so the user gets a clear message.
                // Payment receipt is required only when payment status is "paid".
                var receiptOk = true;
                if ($c('IsPaid').val() === 'true') {
                    var receiptInput = document.getElementById('PaymentReceiptFile');
                    receiptOk = !!(receiptInput && receiptInput.files && receiptInput.files.length > 0);
                }
                return areStandardInputsValid
                    && isTotalPriceValid
                    && isPhotoPasted
                    && hasProduct
                    && receiptOk;
            }
            function updateSubmitButtonState() {
                if (typeof createOrderSubmitInProgress !== 'undefined' && createOrderSubmitInProgress) {
                    $c('submitButton').prop('disabled', true).text('جارٍ الإنشاء...');
                    return;
                }

                // المطلوب: زر موافقة يفضل قابل للضغط دائمًا.
                // التحقق النهائي يتم عند الضغط نفسه، والسيرفر ما زال يحمي الحد الأدنى والأسعار.
                // هذا يمنع إن أول ضغطة تضيع بسبب انتظار Ajax validation أو تحديث حالة الزر.
                if (showDebugQuery) {
                    console.log('[DEBUG] updateSubmitButtonState() - submit button kept enabled until final submit validation');
                }
                $c('submitButton').prop('disabled', false).text('موافقة');
            }
            $modalRoot.find('#TotalPrice,#TelephoneNumber,#deliveryPartyDropdown,#CustomerName,#Address,#ChatUrl,#campaignDropdown,#countryDropdown,#cityDropdown,#orderSourceDropdown,#manufacturingCompanyDropdown,#IsPaid').on('input change', function () {
                updateSubmitButtonState();
            });

            $modalRoot.on('input paste', '.appended-warehouse-row .amount', function () {
                var input = this;
                setTimeout(function () {
                    normalizeNumberTextInput(input, false);
                    $(input).removeClass('error');
                    updateSubmitButtonState();
                }, 0);
            });

            $modalRoot.on('change blur', '.appended-warehouse-row .amount', function () {
                normalizeNumberTextInput(this, false);
                runTotalPriceValidation();
                updateSubmitButtonState();
            });
            // The paste-image fields now drive their own validity updates via
            // attachPasteImageField onCommit/onClear callbacks; no global delegate
            // or polling watchdog is needed.
            $modalRoot.on('change', function () {
                updateSubmitButtonState();
                maybeRevealOrderSource();
            });
            // Initial update for submit button state
            updateSubmitButtonState();
            $modalRoot.on('click', '.closeFailedMessage', function () {
                $('#failedmessage').addClass('hidden').css('display', 'none');
                $c('overlay').hide(); // Also hide the overlay
            });
            // ---- Order photo: hardened via attachPasteImageField. Paste, drag-and-drop,
            // ---- and a MutationObserver all funnel into the same commit-File path,
            // ---- so the hidden #OrderPhotoFile is reliably populated regardless of
            // ---- which mechanism actually delivered the image.
            orderPhotoField = attachPasteImageField({
                $field: $c('OrderPhotoPaste'),
                fileInputId: 'OrderPhotoFile',
                onCommit: function () {
                    updateSubmitButtonState();
                    maybeRevealOrderSource();
                },
                onClear: function () {
                    hideFromStep('orderSource');
                    updateSubmitButtonState();
                }
            });

            // ---- Form submit handler: validate, then lock once, AJAX POST ----
            var createOrderSubmitInProgress = false;

            function resetCreateOrderSubmitButton() {
                createOrderSubmitInProgress = false;
                $c('submitButton')
                    .prop('disabled', false)
                    .text('موافقة');
            }

            function lockCreateOrderSubmitButton() {
                createOrderSubmitInProgress = true;
                $c('submitButton')
                    .prop('disabled', true)
                    .text('جارٍ الإنشاء...');
            }

            $c('createOrderForm').submit(function (event) {
                event.preventDefault();

                if (createOrderSubmitInProgress) {
                    return false;
                }
                const country = $c('countryDropdown').val();
                const phoneNumber = $c('TelephoneNumber').val();
                const phoneCheck = validatePhone(country, phoneNumber);
                var deliveryPartyValue = $c('deliveryPartyDropdown').val();
                var cityDropdown = $c('cityDropdown'); // Assuming this element exists
                var sourceName = $c('SourceName').val(); // Get the value of SourceName input
                var customerName = $c('CustomerName').val();
                var address = $c('Address').val();
                var chaturl = $c('ChatUrl').val();
                // Validate each field and apply error class accordingly
                if (!sourceName) {
                    $c('SourceName').addClass('error');
                } else {
                    $c('SourceName').removeClass('error');
                }
                if (!customerName) {
                    $c('CustomerName').addClass('error');
                } else {
                    $c('CustomerName').removeClass('error');
                }
                if (!address) {
                    $c('Address').addClass('error');
                } else {
                    $c('Address').removeClass('error');
                }
                if (!chaturl) {
                    $c('ChatUrl').addClass('error');
                } else {
                    $c('ChatUrl').removeClass('error');
                }
                // لا نقفل زر الموافقة إلا بعد نجاح كل الفحوصات؛
                // عشان لو في حقل ناقص الزر يفضل شغال ومايحتاجش المستخدم يدوس أكثر من مرة.
                if (!deliveryPartyValue) {
                    showFormError("الرجاء اختيار طرف التوصيل.");
                    event.preventDefault();
                    return false;
                }
                // Instagram is allowed for any page name/store.
                if (!phoneCheck.valid) {
                    showFormError('يرجى إدخال رقم هاتف صحيح.');
                    event.preventDefault();
                    return false;
                }
                if (cityDropdown.val() === "" || cityDropdown.val() === "المدينة") {
                    showFormError("الرجاء اختيار المدينة.");
                    event.preventDefault();
                    return false;
                }
                if ($c('selectedProductsList').find('.appended-warehouse-row').length === 0) {
                    showFormError("يجب إختيار مستودع واحد على الأقل.");
                    event.preventDefault();
                    return false;
                }
                // Order screenshot is required on create. The hidden #OrderPhotoFile is
                // populated by attachPasteImageField; rescueIfNeeded handles the rare case
                // where DataTransfer assignment silently no-op'd by re-hydrating from a
                // data:-URL <img> still in the field.
                if (orderPhotoField) orderPhotoField.rescueIfNeeded();
                if (paymentReceiptField) paymentReceiptField.rescueIfNeeded();
                var photoInput = document.getElementById('OrderPhotoFile');
                if (!photoInput || !photoInput.files || photoInput.files.length === 0) {
                    showFormError('يرجى لصق صورة الطلب.');
                    $('#OrderPhotoPaste').addClass('error');
                    event.preventDefault();
                    return false;
                }
                $('#OrderPhotoPaste').removeClass('error');
                // Payment receipt is required only when payment status is "paid".
                if ($c('IsPaid').val() === 'true') {
                    var receiptInput = document.getElementById('PaymentReceiptFile');
                    if (!receiptInput || !receiptInput.files || receiptInput.files.length === 0) {
                        showFormError('يرجى لصق صورة إيصال الحوالة بنكية.');
                        $('#PaymentReceiptPaste').addClass('error');
                        event.preventDefault();
                        return false;
                    }
                    $('#PaymentReceiptPaste').removeClass('error');
                }
                const customerNameResult = validateCustomerNameForCountry();
                if (!customerNameResult.ok) {
                    showFormError(customerNameResult.message);
                    event.preventDefault();
                    return false;
                }
                if (!validateAddressLatin()) {
                    showFormError('لا يُسمح بإدخال أحرف عربية في عنوان طلبات تركيا.');
                    event.preventDefault();
                    return false;
                }
                if (!validateChatUrlAscii()) {
                    event.preventDefault();
                    return false;
                }
                // Campaign is required only if the selected store actually has ads.
                // If the store has no ads, the order continues normally and CampaignId is submitted as null.
                var $campaign = $c('campaignDropdown');
                var selectedStoreCampaigns = getFilteredCampaigns();
                if (selectedStoreCampaigns && selectedStoreCampaigns.length > 0) {
                    var selectedCampaignValue = $campaign.val();
                    if ($campaign.data('touched') !== true || !selectedCampaignValue || selectedCampaignValue === 'none') {
                        addErrorClassAndMessage($campaign, 'يرجى اختيار الإعلان لهذا المتجر.');
                        showFormError('يرجى اختيار الإعلان لهذا المتجر.');
                        renderCampaignGallery();
                        event.preventDefault();
                        return false;
                    }
                }
                // لا نوقف أول ضغطة بسبب فحص السعر الحي؛ الفحص الحاسم موجود في السيرفر أثناء الحفظ.
                // لو السعر أقل من الحد الأدنى، السيرفر سيرجع رسالة واضحة ونرجع الزر يشتغل فورًا.

                // Sentinel "none" → submit as empty so server stores null CampaignId
                if ($campaign.val() === 'none') {
                    $campaign.find('option[value="none"]').val('');
                    $campaign.val('');
                }
                // Disable the productDropdown picker so its SelectedWarehouses[0].WarehouseId
                // does not collide with the appended row's hidden input during model binding
                $c('productDropdown').prop('disabled', true);
                $modalRoot.find('.closeFailedMessage').click(function () {
                    $('#failedmessage').addClass('hidden').css('display', 'none');
                });
                lockCreateOrderSubmitButton();

                // Proceed with AJAX request
                var formData = new FormData(this);
                // Capture how long the timer ran so the server can persist it on the order.
                if (typeof window.lotusCreateOrderElapsedSec === 'number') {
                    formData.set('CreationDurationSeconds', window.lotusCreateOrderElapsedSec);
                }
                // Normalize phone to local 0-prefix form using the exact country dial code
                var cfg = COUNTRY_PHONE_CONFIG[country];
                var normalizedPhone = phoneCheck.cleaned;
                if (cfg) {
                    var code = cfg.code;
                    if (normalizedPhone.startsWith('00' + code)) {
                        normalizedPhone = '0' + normalizedPhone.slice(('00' + code).length);
                    } else if (normalizedPhone.startsWith('+' + code)) {
                        normalizedPhone = '0' + normalizedPhone.slice(('+' + code).length);
                    } else if (country === 'ليبيا' && /^9\d{8}$/.test(normalizedPhone)) {
                        // Libya accepts local form with or without leading 0; canonicalize to "09…" on submit.
                        normalizedPhone = '0' + normalizedPhone;
                    }
                }
                formData.set('TelephoneNumber', normalizedPhone);
                $.ajax({
                    type: "POST",
                    url: '@Url.Action("Create", "Order")', // Correctly formatted controller action
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function (response) {
                        if (response && response.message) {
                            var errorMessage = response.message;

                            // تظهر رسالة الخطأ فوق زر موافقة بدل بوب أب خطأ التنزيل.
                            showFormError(errorMessage);

                            // Server rejected the order — restore the form so the user can fix and resubmit.
                            $c('productDropdown').prop('disabled', false);
                            resetCreateOrderSubmitButton();
                            $c('overlay').hide();
                            $('#failedmessage').addClass('hidden').hide();
                        } else {
                            var orderId = response.orderId;
                            $modalRoot.modal('hide');
                            $c('printOrderLink').attr('href', '/pdf/printorder?ids=' + orderId);
                            $('#successmessage').removeClass('hidden').css('display', 'block');
                            $c('orderIDPlaceholder').text(orderId);
                        }
                    },
                    error: function (xhr, status, error) {
                        console.error("AJAX Error:", status, error);

                        var errorMessage = "حدث خطأ أثناء إرسال الطلب. الرجاء المحاولة مرة أخرى.";

                        try {
                            var response = xhr.responseJSON || JSON.parse(xhr.responseText || "{}");
                            errorMessage = response.message || errorMessage;
                        } catch (e) {
                            if (xhr.responseText) {
                                errorMessage = xhr.responseText;
                            }
                        }

                        // تظهر الرسالة داخل الفورم فوق زر التأكيد بدل الـ popup/overlay.
                        showFormError(errorMessage);

                        // Server rejected the order — restore the form so the user can fix and resubmit.
                        $c('productDropdown').prop('disabled', false);
                        resetCreateOrderSubmitButton();
                        $c('overlay').hide();
                        $('#failedmessage').addClass('hidden').hide();
                    }
                });
                event.preventDefault();
            });

            // ============================================================
            // SPRITE CLOCK — counts up from 00:00, swapping digit images each tick.
            //
            // Architecture:
            //   - Visual update runs on requestAnimationFrame so it stays smooth
            //     and timestamp-driven (no drift if the tab is throttled).
            //   - Audio ticks run on a self-rescheduling setTimeout chain. setTimeout
            //     keeps firing in background tabs (clamped to ~1s by the browser, but
            //     audio still plays). After 30s the tick rate becomes 2.5x (400ms) — the
            //     audible cue we're in the "fast" zone. We exposed the elapsed seconds
            //     as window.lotusCreateOrderElapsedSec so the form submit can capture
            //     CreationDurationSeconds.
            // ============================================================
            // timerStart is a Unix timestamp in ms (Date.now()). Elapsed time is the
            // wall-clock delta — independent of frame rate, animation throttling, or
            // tab focus. The visible digits advance on a 1000ms setInterval; the audio
            // ticks run on a self-rescheduling setTimeout chain (still wall-clock-based).
            var timerStart = 0;
            var displayIntervalId = null;
            var tickTimeoutId = null;
            var nextTickAt = 0;
            var FAST_THRESHOLD_MS = 30000;
            var BASE_TICK_MS = 1000;
            var FAST_TICK_MS = 400; // x2.5 of base 1000ms
            var lastDigitsKey = '';
            // Pre-cache <audio> elements for each digit src so swapping is just a src
            // change with the browser already having the bytes.
            var tickAudio = new Audio('/clock/beep555.mp3');
            tickAudio.preload = 'auto';

            function playTick() {
                try {
                    // Cloning lets overlapping ticks play (matters in the fast zone).
                    var a = tickAudio.cloneNode(true);
                    a.volume = 1.0;
                    a.play().catch(function () { /* autoplay blocked — silent until first interaction */ });
                } catch (e) { /* ignore */ }
            }
            function setDigit(slotIndex, digit) {
                var img = document.querySelector('#Create .sprite-clock-d' + slotIndex);
                if (!img) return;
                var src = '/clock/' + digit + '.png';
                if (img.getAttribute('src') !== src) img.setAttribute('src', src);
            }
            function renderDigits(totalSec) {
                // Cap at 99:59 — the sprite has 4 digit slots only.
                var capped = Math.min(totalSec, 99 * 60 + 59);
                var m = Math.floor(capped / 60);
                var s = capped % 60;
                var d0 = Math.floor(m / 10);
                var d1 = m % 10;
                var d2 = Math.floor(s / 10);
                var d3 = s % 10;
                var key = '' + d0 + d1 + d2 + d3;
                if (key === lastDigitsKey) return;
                lastDigitsKey = key;
                setDigit(0, d0);
                setDigit(1, d1);
                setDigit(2, d2);
                setDigit(3, d3);
            }
            function updateDisplay() {
                var elapsedMs = Date.now() - timerStart;
                if (elapsedMs < 0) elapsedMs = 0;
                var totalSec = Math.floor(elapsedMs / 1000);
                window.lotusCreateOrderElapsedSec = totalSec;
                var $timer = $c('createOrderTimer');
                renderDigits(totalSec);
                $timer.toggleClass('fast', elapsedMs >= FAST_THRESHOLD_MS);
            }
            function scheduleNextTick() {
                var elapsedMs = Date.now() - timerStart;
                var inFast = elapsedMs >= FAST_THRESHOLD_MS;
                var step = inFast ? FAST_TICK_MS : BASE_TICK_MS;
                // Absolute wall-clock scheduling: if a tab was throttled and we fell
                // behind, snap forward instead of firing a backlog of ticks.
                var now = Date.now();
                if (nextTickAt < now) nextTickAt = now;
                nextTickAt += step;
                var delay = Math.max(0, nextTickAt - now);
                tickTimeoutId = setTimeout(function () {
                    playTick();
                    scheduleNextTick();
                }, delay);
            }
            function startCreateOrderTimer() {
                stopCreateOrderTimer();
                timerStart = Date.now();
                nextTickAt = timerStart;
                lastDigitsKey = '';
                window.lotusCreateOrderElapsedSec = 0;
                $c('createOrderTimer').removeClass('fast');
                renderDigits(0);
                updateDisplay();
                displayIntervalId = setInterval(updateDisplay, 1000);
                scheduleNextTick();
            }
            function stopCreateOrderTimer() {
                if (displayIntervalId) { clearInterval(displayIntervalId); displayIntervalId = null; }
                if (tickTimeoutId) { clearTimeout(tickTimeoutId); tickTimeoutId = null; }
            }
            $modalRoot.on('shown.bs.modal', startCreateOrderTimer);
            $modalRoot.on('hidden.bs.modal', stopCreateOrderTimer);
            // Reset the disclosure tree on close so the next open starts gated, regardless
            // of leftover `.success` class state from the previous session.
            $modalRoot.on('hidden.bs.modal', function () {
                hideFromStep('phone1');
            });
            // If modal is already visible when this script loads (AJAX-injected open), start now
            if ($modalRoot.hasClass('show') || $modalRoot.is(':visible')) {
                startCreateOrderTimer();
            }
        });
    })();
</script>


