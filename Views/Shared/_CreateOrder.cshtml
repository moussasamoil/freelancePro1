            // ============================================================
            // CUSTOMER NAME VALIDATION (country-specific — Turkey stricter)
            // ============================================================
            let customerNameErrorMessageShown = false;
            let customerNameSpinnerTimeout;
            // Latin A–Z / a–z plus Turkish-specific letters (Ç Ğ I İ Ö Ş Ü and lowercase/dotless-i).
            // Spaces are permitted to separate the given name from the family name.
            const turkishNameAllowedRegex = /^[A-Za-zÇĞİIÖŞÜçğıiöşü\s]+$/;
            function validateCustomerNameForCountry() {
                const val = ($c('CustomerName').val() || '').trim();
                const country = $c('countryDropdown').val();
                if (!val) {
                    return { ok: false, message: ' يرجى إدخال اسم عميل صحيح.' };
                }
                if (country === 'تركيا') {
                    // Turkey requires a full name: at least two words (one space between non-empty tokens).
                    const parts = val.split(/\s+/).filter(Boolean);
                    if (parts.length < 2) {
                        return { ok: false, message: 'يرجى إدخال الاسم الكامل (الاسم واللقب) لطلبات تركيا.' };
                    }
                    // Only Latin and Turkish letters are allowed — no Arabic, digits, or punctuation.
                    if (!turkishNameAllowedRegex.test(val)) {
