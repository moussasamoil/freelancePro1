
<style>
    /* يمنع رعشة حقول الأرقام أثناء الكتابة */
    #TelephoneNumber.error,
    #SecondTelephoneNumber.error,
    #TotalPrice.error,
    #DeliveryPrice.error,
    input.amount.error,
    .numeric-no-shake.error {
        animation: none !important;
        transform: none !important;
    }
</style>

@model lotus_blue.Models.ViewModel.OrderViewModel
@inject lotus_blue.Services.GetCurrentTimeInIstanbul TimeService
@{
    DateTime istanbulTime = TimeService.GetIstanbulTimeWithOffset();
}
@* Prevents accidental close during order entry — static backdrop and no keyboard dismiss *@
<div class="modal   rtl  modal-dialog-centered" id="Create" data-bs-keyboard="false" data-bs-backdrop="static" tabindex="-1" aria-labelledby="Create" aria-hidden="true">
    @* Large size to fit the full order form without scrolling *@
    <div class="modal-dialog modal-lg modal-dialog-centered " style="position: relative;">
        @* Sprite clock — sits above the modal panel, centered. Black rounded slab holds two
        digit groups: the running mm:ss timer (left, 4 digits) and the current shift's
        order-creation count (right, 2 digits), separated by a gap. *@
        <div id="createOrderTimer" class="sprite-clock" aria-live="polite">
            <div class="sprite-clock-group sprite-clock-timer">
                <img class="sprite-clock-digit sprite-clock-d0" src="/clock/0.png" alt="" />
                <img class="sprite-clock-digit sprite-clock-d1" src="/clock/0.png" alt="" />
                <img class="sprite-clock-colon" src="/clock/column.png" alt=":" />
                <img class="sprite-clock-digit sprite-clock-d2" src="/clock/0.png" alt="" />
                <img class="sprite-clock-digit sprite-clock-d3" src="/clock/0.png" alt="" />
            </div>
            <div class="sprite-clock-group sprite-clock-count">
                <img class="sprite-clock-digit sprite-clock-c0" src="/clock/0.png" alt="" />
                <img class="sprite-clock-digit sprite-clock-c1" src="/clock/0.png" alt="" />
            </div>
        </div>
        @* Relative position required so the loading overlay (absolute) is scoped to this panel *@
        <div class="modal-content background-white-green" style="position: relative;">
            <div id="overlay" style="display: none; position: absolute; top: 0; left: 0; width: 100%; height: 100%; background-color: rgba(33, 37, 41, 0.1); z-index: 10;"></div>
            <div id="deleteProductConfirm" style="position: absolute; inset: 0; z-index: 9999; display: none; background: rgba(33,37,41,0.55); align-items: center; justify-content: center;">
                <div class="row justify-content-center align-items-center" style="width: 100%; margin: 0;">
                    <div style="background-color:white" class="w-60 flex-column b-r-8 d-flex justify-content-center">
                        <div class="">
                            <div class="text-center pt-3">
                                <img src="/static/trash-can-regular.svg" width="50">
                            </div>
                            <p class="text-center pb-3 text-nowrap"> هل أنت متأكد من حذف المستودع .</p>
                        </div>
                        <div class="border-top">
                            <div class="row">
                                <div class="col-6 py-2 text-center text-green-v2 text-decoration-underline" id="confirm-remove">
                                    موافقه
                                </div>
                                <div class="col-6 py-2 text-center border-right text-grey-v2 text-decoration-underline" id="cancel-remove">
                                    تراجع
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            @* Modal header: title + cancel/confirm dismiss buttons *@
            <div class="modal-header">
                <button type="button" class="btn head-16 text-green" data-bs-dismiss="modal" aria-label="Close"> تراجع</button>
                <h5 class="modal-title  head text center" id="createOrderModalTitle"> إنشاء طلب جديد</h5>
                <button type="button" class="btn head-16 text-green" data-bs-dismiss="modal" aria-label="Close"> انتهى</button>
            </div>
            <div class="modal-body">
                <form id="createOrderForm">
                    <div class="row d-flex justify-content-center">
                        @* Row 1: Country | City *@
                        <div class="row">
                            <div class="col-12" id="countryCol">
                                <div class="form-group ">
                                    <select asp-for="Country" class="form-control " id="countryDropdown" required>
                                        <option data-image="/static/earth-americas-sharp-solid.svg" value="" selected>    اختر الدولة   </option>
                                        @foreach (var country in Enum.GetValues(typeof(lotus_blue.Models.Common.Countries)))
                                        {
                                            <option value="@country" data-image="@Common.GetImageUrlByCountryName(country.ToString())">@country</option>
                                        }
                                    </select>
                                    <span asp-validation-for="Country" class="text-danger"></span>
                                </div>
                            </div>
                            @* Cities are empty on load — JS populates them via Ajax when a country is selected *@
                            <div class="col-6" id="cityCol" style="display: none;">
                                <div class="form-group ">
                                    <select asp-for="State" class="form-control" id="cityDropdown" required>
                                        <option data-image="/static/city-regular.svg" value="" selected>المدينة</option>
                                        <!-- Add your option elements here -->
                                    </select>
                                    <span asp-validation-for="State" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                        @* Row 2: Phone1 | Phone2 — hidden until city is selected. Phone2 reveals after phone1 passes validation. *@
                        <div class="row mt-3" id="phoneRow" style="display: none;">
                            <div class="col-12" id="primaryPhoneCol">
                                <div class="form-group w-sm-100 input-wrapper">
                                    <input type="tel" inputmode="tel" autocomplete="off" required placeholder="رقم الهاتف الأول" asp-for="TelephoneNumber" class="  form-control with-bg-image-phonenumber  numeric-no-shake" />
                                    <i class="fa-duotone fa-spinner-third fa-spin spinner-icon"></i>
                                    <span asp-validation-for="TelephoneNumber" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-6" id="secondPhoneCol" style="display: none;">
                                <div class="form-group">
                                    <input type="tel" inputmode="tel" autocomplete="off" placeholder="رقم الهاتف الثاني (اختياري) " id="SecondTelephoneNumber" asp-for="SecondTelephoneNumber" class="form-control with-bg-image-phonenumber numeric-no-shake" />
                                    <span asp-validation-for="SecondTelephoneNumber" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                        @* Row 3: Customer name | Store name — hidden until phone1 is valid; store reveals after customer name is valid. *@
                        <div class="row mt-3" id="customerStoreRow" style="display: none;">
                            <div class="col-12" id="customerNameCol">
                                <div class="form-group w-sm-100 input-wrapper">
                                    <input required placeholder="اسم العميل " id="CustomerName" asp-for="CustomerName" class="form-control  with-bg-image-client" />
                                    <i class="fa-duotone fa-spinner-third fa-spin spinner-icon"></i>
                                    <span asp-validation-for="CustomerName" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-6 " id="storeCol" style="display: none;">
                                <div class="form-group">
                                    <select asp-for="ManufacturingCompanyId" class="form-control" id="manufacturingCompanyDropdown" required disabled>
                                        <option data-image="/static/building-regular.svg" value="" disabled selected>اسم المتجر </option>
                                    </select>
                                    <span asp-validation-for="ManufacturingCompanyId" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                        @* Row 4: Address (full width) — hidden until a store is selected. *@
                        <div class="row mt-3 " id="addressRow" style="display: none;">
                            <div class="col-12 ">
                                <div class="form-group w-100 input-wrapper">
                                    <input required placeholder="العنوان بالكامل" id="Address" asp-for="Address" class="form-control with-bg-image-address" />
                                    <i class="fa-duotone fa-spinner-third fa-spin spinner-icon"></i>
                                    <span asp-validation-for="Address" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                        @* Row 5: Delivery party | Order screenshot — hidden until address is valid. Delivery party only shown when 2+ parties (otherwise auto-selected and column stays hidden, screenshot spans full width). *@
                        <div class="row mt-3" id="deliveryPhotoRow" style="display: none;">
                            <div class="col-6 " id="deliveryCompanyCol" style="display: none;">
                                <div class="form-group">
                                    <select id="deliveryPartyDropdown" asp-for="DeliveryCompanyId" class="form-control" required>
                                        <option data-image="/static/truck-regular.svg" value="" disabled selected>اختر طرف التوصيل</option>
                                        <!-- Options populated dynamically based on the selected country and city -->
                                    </select>
                                    <span asp-validation-for="DeliveryCompanyId" class="text-danger"></span>
                                </div>
                            </div>
                            @* Order screenshot — text-style field; user pastes (Ctrl+V) an image, which renders inline. The hidden <input type="file"> is what FormData posts. *@
                            <div class="col-12 " id="orderPhotoCol">
                                <div class="form-group w-100 input-wrapper">
                                    <div id="OrderPhotoPaste" class="form-control" contenteditable="true" data-placeholder="صورة الحجز" style="min-height:38px;cursor:text;"></div>
                                    <input type="file" name="PhotoFile" id="OrderPhotoFile" accept="image/*" style="display:none;" />
                                </div>
                            </div>
                        </div>
                        @* Row 6: Page type (order source) | Page name — hidden until both screenshot pasted AND delivery party selected. SourceName only shown for non-WhatsApp sources. *@
                        <div class="row mt-3" id="orderSourceRow" style="display: none;">
                            <div class="col-12 " id="orderSourceCol">
                                <div class="form-group">
                                    <select asp-for="OrderSource" class="form-control" id="orderSourceDropdown" required>
                                        <option data-image="/static/hashtag-regular.svg" value="" disabled selected>نوع الصفحة</option>
                                        @foreach (OrderSourceEnum source in Enum.GetValues(typeof(OrderSourceEnum)))
                                        {
                                            var sourceText = source.ToString();
                                            var sourceKey = (sourceText ?? "")
                                                .Replace("_", "")
                                                .Replace(" ", "")
                                                .ToLowerInvariant();

                                            var isAllowedSource =
                                                sourceKey.Contains("whatsapp") ||
                                                sourceKey.Contains("واتس") ||
                                                sourceKey.Contains("facebook") ||
                                                sourceKey.Contains("فيس") ||
                                                sourceKey.Contains("instagram") ||
                                                sourceKey.Contains("insta") ||
                                                sourceKey.Contains("انست");

                                            if (!isAllowedSource)
                                            {
                                                continue;
                                            }

                                            <option value="@((int)source)" data-image="@Common.GetSocialMediaIconUrl(source)">
                                                @source
                                            </option>
                                        }
                                    </select>
                                    <span asp-validation-for="OrderSource" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-6 " id="sourceNameCol" style="display: none;">
                                <div class="form-group input-wrapper w-sm-100">
                                    @* Disabled by default so it can't be submitted empty; JS enables it once visible *@
                                    <input placeholder="اسم الصفحة" id="SourceName" asp-for="SourceName" disabled class=" form-control with-bg-image-pagename" />
                                    <i class="fa-duotone fa-spinner-third fa-spin spinner-icon"></i>
                                    <span asp-validation-for="SourceName" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                        @* Row 7: Chat URL | CreatedDate. ChatUrl is shown once an order source is selected (and not WhatsApp). CreatedDate appears once chatUrl is valid (or, for WhatsApp orders that have no chat url, once the order source is chosen). Width is reconciled by syncChatUrlDateRow(). *@
                        <div class="row mt-3 " id="chatUrlDateRow" style="display: none;">
                            <div class="col-12 " id="chatUrlCol" style="display: none;">
                                <div class="form-group w-100 input-wrapper">
                                    <input required placeholder="رابط المحادثة" id="ChatUrl" asp-for="chatUrl" class="form-control with-bg-image-address" />
                                    <i class="fa-duotone fa-spinner-third fa-spin spinner-icon"></i>
                                    <span asp-validation-for="chatUrl" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-6 form-group" id="createdDateCol" style="display: none;">
                                <div class="form-group ">
                                    <input required asp-for="CreatedDate" name="CreatedDate" value="@TimeService.GetIstanbulTimeWithOffset().ToString("yyyy-MM-ddTHH:mm:ss")" type="datetime-local" class="form-control text-end with-bg-image-calendar calendar  pe-2 ps-2" />
                                    <span asp-validation-for="CreatedDate" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                        @* Hidden FromComments dropdown — kept off-row so it still posts, but no longer renders in the visible layout. *@
                        <div style="display: none;">
                            <select asp-for="FromComments" id="CommentsDropdown">
                                <option selected value="">التعليقات</option>
                                <option value="true">نعم </option>
                                <option value="false">لا</option>
                            </select>
                        </div>
                        @* Ad campaign — the dropdown is the model-bound input but is never shown.
                        The visible UI is #campaignGalleryWrap below, hoisted out of the form rows
                        so the form layout has no empty row reserved for it (the gallery is
                        position:absolute and renders off to the side of the modal panel). *@
                        <select id="campaignDropdown" asp-for="CampaignId" class="form-control" style="display: none;">
                            <option value="" disabled selected hidden>اختر الإعلان</option>
                            <option data-image="/static/truck-regular.svg" value="">بدون إعلان</option>
                            <!-- Options will be dynamically added here based on the selected country and city -->
                        </select>
                        <span asp-validation-for="CampaignId" class="text-danger"></span>
                        @* Product picker — the entry point for building the order's product list.
                        User flow: the agent picks a product here and confirms it; the product moves into #selectedProductsList as a locked row with a quantity spinner. Repeating this adds more products. Removing a row sends the product back here.
                        Data flow: warehouseOptions is the available pool. Confirming a product removes it from the pool (so it can't be picked twice); deleting a confirmed row adds it back (sourced from allWarehouseOptions to recover the original stock data). *@
                        <div id="selectedProductsList" class="row mt-3" style="display: none;">
                            <div class="col-12">
                                <div class="form-group">
                                    <div class="warehouse-item">
                                        <select class="form-control warehouse-select" id="productDropdown" asp-for="SelectedWarehouses[0].WarehouseId" asp-items="Model?.WarehouseList" disabled>
                                            <option data-image="/static/box-open-2.svg" disabled selected value="">قم بإختيار إحدى المنتجات</option>
                                        </select>
                                        <span asp-validation-for="SelectedWarehouses[0].WarehouseId" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        @* Payment status reveals once products + campaign have been chosen. Starts col-12; once "تم التحويل حوالة بنكية" is picked, it shrinks to col-6 and a paste-style payment receipt field appears alongside (mandatory only when paid). TotalPrice still has its own gate. *@
                        <div class="row mt-3 " id="paymentRow" style="display: none;">
                            <div class="col-12 form-group" id="paymentCol">
                                <div class="form-group ">
                                    <select asp-for="IsPaid" class="form-control w-100" id="IsPaid">
                                        <option data-image="/static/credit-card-front-regular.svg" value="">طريقة الدفع (اختياري)</option>
                                        <option value="true" data-image="/static/credit-card-front-regular.svg">تم التحويل حوالة بنكية</option>
                                        <option value="false" data-image="/static/credit-card-front-regular.svg">غير مدفوع</option>
                                    </select>
                                    <span asp-validation-for="Gender" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-6" id="paymentReceiptCol" style="display: none;">
                                <div class="form-group w-100 input-wrapper">
                                    <div id="PaymentReceiptPaste" class="form-control" contenteditable="true" data-placeholder="صورة إيصال الحوالة بنكية" style="min-height:38px;cursor:text;"></div>
                                    <input type="file" name="PaymentReceiptFile" id="PaymentReceiptFile" accept="image/*" style="display:none;" />
                                </div>
                            </div>
                        </div>
                        @* Notes — own row beneath payment status. Optional. *@
                        <div class="row mt-3" id="notesRow" style="display: none;">
                            <div class="col-12" id="notesCol">
                                <div class="form-group">
                                    <input placeholder="الملاحظات (اختياري)" id="Notes" asp-for="Notes" class="form-control with-bg-image-note" />
                                    <span asp-validation-for="Notes" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                        <div class="row mt-3">
                            <div class="d-flex justify-content-center">
                            </div>
                        </div>
                        @* Total price input — hidden until a payment status is picked. Backend min-price validation in OrderController runs after submit; per-country thresholds live in CountryMinimumPrices. *@
                        <div class="justify-content-center" id="totalPriceWrap" style="display: none;">
                            <div class="w-25 w-sm-50">
                                <div class="form-group input-wrapper d-flex justify-content-center">
                                    <input type="text" inputmode="decimal" autocomplete="off" id="TotalPrice" required value="" asp-for="TotalPrice" class="form-control fw-bold with-bg-image-price text-green numeric-no-shake" placeholder="السعر الأجمالي" />
                                    <i class="fa-duotone fa-spinner-third fa-spin spinner-icon"></i>
                                    <span asp-validation-for="TotalPrice" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                        @* Submit button *@
                        <div class="d-flex mb-3 justify-content-center ">
                            <button style="font-size:1.3rem;" type="submit" id="submitButton" class="btn py-1 background-gold text-white mb-3  w-65 mt-3">موافقة</button>
                        </div>
                        @* Inline error panel shown on submission failure *@
                        <div style="width:23% !important" id="failedmessage" class="container centered hidden legacy-popup-error-disabled" style="display:none !important; pointer-events:none !important;">
                            <div class="row justify-content-center align-items-center" style="min-height: 100vh;">
                                <div style="background-color:white" class=" flex-column b-r-8 d-flex justify-content-center">
                                    <div class="">
                                        <div class="text-center pt-3">
                                            <img src="/static/x-shadow-red.svg" width="50" />
                                        </div>
                                        <p class="text-center pb-3 text-black fw-bolder text-nowrap">خطأ في التنزيل.</p>
                                        <p class="text-center text-black pb-3 message text-nowrap"></p>
                                    </div>
                                    <div class="border-top grey-hover">
                                        <div class="row">
                                            <div class="py-2 closeFailedMessage  text-center grey-hover text-green-v2 text-decoration-underline">
                                                موافق
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
                @* Campaign gallery — positioned absolutely against the modal-content (which is
                position:relative). Lives outside the form so the form layout reserves no
                row for it; only renders when a store is picked (toggleCampaignVisibility). *@
                <div id="campaignGalleryWrap" style="display: none;">
                    <div class="campaign-gallery-title">اختار الاعلان</div>
                    <div id="campaignGallery" class="campaign-gallery"></div>
                </div>
            </div>
        </div>
    </div>
</div>
@* after success order post
 *@
<div id="successmessage" class="hidden " style="width:35%;">
    <div class="container pb-5 custom-box-shadow b-r-8  background-white">
        <div class="row pt-5">
            <div class="col text-center ">
                <img width="70" class="mx-auto d-block" src="/static/turesign.svg">
            </div>
        </div>
        <div class="row">
            <div class="col text-center">
                <p><span id="orderIDPlaceholder"></span></p>
            </div>
        </div>
        <div class="row">
            <div class="col text-center">
                <p>تمت العملية بنجاح</p>
            </div>
        </div>
        <div class="row " style="margin-top: 130px;">
            <div class="col text-center">
                <a id="printOrderLink" class="text-green-v2 b-r-8 custom-box-shadow" style="padding-left: 180px; padding-right: 180px;" target="_blank">إيصال</a>
            </div>
        </div>
        <div class="row mt-3">
            <div class="col text-center">
                <a id="closeAndOpenOrderBtn" style="padding-left:132px; padding-right:132px;" class="text-green-v2  b-r-8 custom-box-shadow">قم بإجراء طلب جديد</a>
            </div>
        </div>
        <div class="row mt-4">
            <div id="closeSuccess" class="col text-center">
                <img src="/static/77-01.svg" width="50" />
            </div>
        </div>
    </div>
</div>
<style>
    #campaignGalleryWrap {
        position: absolute;
        top: 50%;
        left: calc(100% + 32px);
        transform: translateY(-50%);
        width: 200px;
        background: #f6f6f6;
        border-radius: 16px;
        box-shadow: 0 0 4px rgba(0,0,0,.39);
        overflow: hidden;
        z-index: 10;
    }

    .campaign-gallery-title {
        padding: 10px 12px 0;
        color: #111827;
        font-size: 13px;
        font-weight: 900;
        text-align: center;
        direction: rtl;
    }
    /* Campaign dropdown is intentionally fully hidden — gallery is the only UI.
                               Select2 stays initialized on it (so all the existing data-flow stays intact),
                               but neither the native select nor its rendered Select2 widget are ever shown. */
    #Create #campaignDropdown,
    #Create #campaignDropdown + .select2-container {
        display: none !important;
    }
    /* Digital clock — viewport-fixed, horizontally centered, sits above the modal panel.
                               Modern black rounded slab holds two digit groups: the running mm:ss timer (left,
                               4 digits) and the current shift's order-creation count (right, 2 digits), with a
                               gap between them. Digit images are 174x247 native, displayed at fixed pixel size. */
    .sprite-clock {
        position: fixed;
        top: calc(50% - 420px);
        left: 50%;
        transform: translateX(-50%);
        z-index: 1100;
        display: flex;
        /* Force LTR so the timer (DOM-first) sits on the left and the creation
                                   count (DOM-second) sits on the right, regardless of the modal's RTL ctx. */
        direction: ltr;
        align-items: center;
        gap: 36px;
        line-height: 0;
        max-width: 95vw;
    }
    /* Each group is its own modern black rounded slab with its own padding/shadow. */
    .sprite-clock-group {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 18px 30px;
        background: #0b0b0b;
        border-radius: 24px;
        box-shadow: 0 12px 36px rgba(0, 0, 0, 0.35);
    }

    .sprite-clock-digit {
        display: block;
        height: 108px;
        width: auto;
        user-select: none;
        pointer-events: none;
    }

    .sprite-clock-colon {
        display: block;
        height: 108px;
        width: auto;
        user-select: none;
        pointer-events: none;
        margin: 0 3px;
    }
    /* x4-zone — subtle red tint pulse once we cross 30s (timer digits only) */
    @@keyframes sprite-clock-fast-pulse {
        0%, 100% {
            filter: drop-shadow(0 0 6px rgba(255,0,0,.6));
        }

        50% {
            filter: drop-shadow(0 0 14px rgba(255,0,0,.95));
        }
    }

    .sprite-clock.fast .sprite-clock-timer .sprite-clock-digit {
        animation: sprite-clock-fast-pulse 0.5s ease-in-out infinite;
    }
    /* Select2 success state: green background on the container */
    .select2-container:has(.select2-selection__rendered.success) .select2-selection {
        background: #1d273b !important;
        background-color: #1d273b !important;
        border-color: #1d273b !important;
        border-radius: 4px;
    }
    /* Selected text and arrow become white */
    .select2-container:has(.select2-selection__rendered.success) .select2-selection__rendered {
        color: white !important;
    }

    .select2-container:has(.select2-selection__rendered.success) .select2-selection__arrow b {
        border-color: white transparent transparent transparent !important;
    }
    /* Inverted tick icon: white circle, green checkmark */
    .select2-container:has(.select2-selection__rendered.success) .select2-selection__rendered.success {
        background-image: url('/static/turesign-inverted.svg') !important;
        background-position: left 10px center !important;
        background-repeat: no-repeat !important;
        background-size: 20px 20px !important;
        padding-left: 32px !important;
    }

    .campaign-gallery {
        display: grid;
