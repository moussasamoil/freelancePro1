<div id="pageOverlay"></div>

<div id="dynamicNotification" class="container centered" style="display: none;">
    <div class="row justify-content-center align-items-center" style="min-height: 100vh;">
        <div style="background-color:white" class="w-30   flex-column b-r-8 d-flex justify-content-center">
            <div class="">
                <div class="text-center pt-3">
                    <div id="notificationIconWrapper" style="display:inline-flex;align-items:center;justify-content:center;border-radius:50%;width:60px;height:60px;">
                        <img id="notificationIcon" src="/static/trash-can-regular.svg" width="30" />
                    </div>
                </div>
                <p id="notificationText" class="text-center pb-3 text-nowrap"></p>
            </div>
            <div id="notificationAutoBar" style="display:none;" class="border-top">
