                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>


    /* CSS for the overlay effect */
    #pageOverlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.5);
        z-index: 1066;
        display: none;
    }

    #dynamicNotification {
        z-index: 1100; /* Ensure it's above the overlay */
    }

    #notificationAutoBar {
        overflow: hidden;
    }

    #notificationLoadBar {
        height: 4px;
        background-color: #f5c518;
        width: 100%;
        transform-origin: left;
        animation: none;
    }

    @@keyframes notificationDrain {
        from { width: 100%; }
        to   { width: 0%; }
    }



</style>

