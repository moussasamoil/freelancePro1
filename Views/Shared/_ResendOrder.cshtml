@model lotus_blue.Models.ViewModel.OrderViewModel
@inject lotus_blue.Services.GetCurrentTimeInIstanbul TimeService

@{
    DateTime istanbulTime = TimeService.GetIstanbulTimeWithOffset();
}
<div style="direction:rtl !important" class="modal fade" id="Resend" tabindex="-1" data-bs-backdrop="static" aria-labelledby="Resend" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered ">
        <div class="modal-content  ">
            <div class="modal-header">
                <button type="button" class="btn head-16 close" data-bs-dismiss="modal" aria-label="Close"> تراجع</button>
                <h5 class="modal-title  head text center" id="createOrderModalTitle">انشاء طلب</h5>
                <button type="button" class="btn head-16  close" data-bs-dismiss="modal" aria-label="Close"> انتهى</button>
            </div>
            <div class="modal-body">
                <form id="createOrderForm" method="post" asp-controller="Order" asp-route-id="@Model.Id" asp-action="Create">
                    <input type="hidden" name="ExternalOrderId" value="@Model.ExternalOrderId" />
                    <input type="hidden" name="DeliveryCompanyId" id="hiddenDeliveryCompanyId" value="" />
                    <input type="hidden" name="ManufacturingCompanyId" id="hiddenManufacturingCompanyId" value="@Model.ManufacturingCompanyId" />

                    <input type="hidden" name="State" id="hiddenState" value="">

                    <div class="row d-flex justify-content-center">
                        <div class="row">
                            <div class="col-lg-3">
                                <div class="form-group">
                                    <input type="text" name="Country" class="form-control with-bg-image-country" id="countryInput" value="@Model.Country" readonly style="background-image: url('@Common.GetImageUrlByCountryName(Model.Country.ToString())');">
                                </div>
                            </div>

                            <div class="col-lg-3">
                                <div class="form-group">
                                    <select name="State" class="form-control" id="cityDropdown"></select>
                                    <span asp-validation-for="State" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-lg-3">
                                <div class="form-group">
                                    <select asp-for="OrderSource" id="orderSourceDropdown" class="form-control w-100">
                                        @foreach (var source in Enum.GetValues(typeof(OrderSourceEnum)))
                                        {
                                            <option data-image="@Common.GetSocialMediaIconUrl((OrderSourceEnum)source)" value="@source">@source</option>
                                        }
                                    </select>
                                    <span asp-validation-for="OrderSource" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-lg-3" id="sourceNameDiv">
                                <div class="form-group">
                                    <input placeholder="اسم الصفحة" asp-for="SourceName" class="form-control with-bg-image-pagename" />
                                    <span asp-validation-for="SourceName" class="text-danger"></span>
                                </div>
                            </div>
                        </div>




                        <div class="row mt-3 sbshide" style="@(Model.ExternalOrderId != null ? "display: none;" : "")">
                            <div class="col-lg-6">
                                <div class="form-group">
                                    <select id="manufacturingCompanyDropdown" class="form-control">
                                        <option value="" disabled selected>اسم  المتجر</option>
                                    </select>
                                    <span asp-validation-for="ManufacturingCompanyId" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-lg-3">
                                <div class="form-group">
                                    <select id="deliveryCompanyDropdown" asp-for="DeliveryCompanyId" class="form-control">
                                        <option data-image="/static/truck-regular.svg" value="" selected> شركة التوصيل</option>
                                        <!-- Options will be dynamically added here based on the selected country and city -->
                                    </select>
                                    <span asp-validation-for="DeliveryCompanyId" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-lg-3">
                                <div class="form-group">
                                    <select id="deliveryRepresentativeDropdown" asp-for="DeliveryCompanyId" class="form-control">
                                        <option data-image="/static/truck-regular.svg" value="" selected>أسم  المندوب</option>
                                        <!-- Options will be dynamically added here based on the selected country and city -->
                                    </select>
                                    <span asp-validation-for="DeliveryCompanyId" class="text-danger"></span>
                                </div>
                            </div>
                        </div>



                        <div class="row mt-3">
                            <div class="col-lg-6">
                                <div class="form-group">
                                    <input type="number" placeholder="رقم الهاتف الأول" asp-for="TelephoneNumber" class="form-control  with-bg-image-phonenumber " />
                                    <span asp-validation-for="TelephoneNumber" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="form-group">
                                    <input type="number" placeholder="رقم الهاتف التاني " asp-for="SecondTelephoneNumber" class="form-control  with-bg-image-phonenumber" />
                                    <span asp-validation-for="SecondTelephoneNumber" class="text-danger"></span>
                                </div>
                            </div>

                        </div>
                        <div class="row mt-3">
                            <div class="col-lg-6">
                                <div class="form-group">
                                    <input placeholder="اسم العميل " asp-for="CustomerName" class="form-control with-bg-image-client " />
                                    <span asp-validation-for="CustomerName" class="text-danger"></span>
                                </div>

                            </div>
                            <div class="col-lg-6">
                                <div class="form-group">
                                    <input placeholder="الملاحظات" asp-for="Notes" class="form-control with-bg-image-note" />
                                    <span asp-validation-for="Notes" class="text-danger"></span>
                                </div>

                            </div>

                        </div>


                        <div class="row mt-3">


                            <div class="form-group col-lg-6 ">
                                <div class="form-group">
                                    <input placeholder="العنوان بالكامل" asp-for="Address" class="form-control with-bg-image-address" />
                                    <span asp-validation-for="Address" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="form-group col-lg-6 ">

                                <!-- Adjusted width for the gender dropdown -->
                                <select asp-for="Gender" class="form-control w-100" id="GenderDropdown" required>
                                    <!-- Placeholder option -->
                                    @*                                         <option selected value="" data-image="/static/Gender.svg">الجنس</option>
                                    *@
                                    <!-- Other gender options -->
                                    <option value="false" data-image="/static/Female.svg">أنثى</option>

                                    <option value="true" data-image="/static/Male.svg">ذكر</option>
                                </select>
                                <span asp-validation-for="Gender" class="text-danger"></span>
                            </div>

                          
                          
                        </div>



                        <div class="row mt-3">

                            <div class="form-group col-6  ">
                                <div class="form-group d-flex justify-content-center">
                                    <!-- Adjusted width for the gender dropdown -->
                                    <select asp-for="IsPaid" class="form-control w-100" id="IsPaid">
                                        <!-- Placeholder option -->
                                        <option data-image="/static/credit-card-front-regular.svg" value="">طريقة الدفع (اختياري)</option>
                                        <option value="true" data-image="/static/credit-card-front-regular.svg">تم التحويل حوالة بنكية</option>
                                        <option value="false" data-image="/static/credit-card-front-regular.svg">غير مدفوع</option>

                                    </select>
                                    <span asp-validation-for="Gender" class="text-danger"></span>
                                </div>
                            </div>



                            <div class="form-group col-lg-6 ">
                                <div class="form-group d-flex justify-content-center">
                                    <!-- Use 'asp-for' for model binding, and set 'name' to match -->
                                    <input required asp-for="CreatedDate" name="CreatedDate" value="@Model.CreatedDate.ToString("yyyy-MM-ddTHH:mm")" type="datetime-local" class="form-control text-end with-bg-image-calendar calendar  pe-2 ps-2" />
                                    <span asp-validation-for="CreatedDate" class="text-danger"></span>
                                </div>
                            </div>
                        </div>



                        <div id="selectedProductsList" class="row mt-3">
                            <div class="col-lg-12">
                                <div class="form-group">
                                    <div class="warehouse-item">
                                        <select class="form-control warehouse-select" id="productDropdown" asp-for="SelectedWarehouses[0].WarehouseId" asp-items="Model.WarehouseList" required>
                                            <option data-image="/static/box-open-2.svg" disabled selected value="">قم بإختيار إحدى المنتجات</option>
                                        </select>
                                        <span asp-validation-for="SelectedWarehouses[0].WarehouseId" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>
                        </div>

                   
                        <div class="row mt-3">
                            <div class="d-flex justify-content-center">
                                <div class="form-group d-flex justify-content-center">
                                    <input  value="@Model.TotalPrice" asp-for="TotalPrice" class="form-control w-50 with-bg-image-price" style="color: #1d273b;" />
                                    <span asp-validation-for="TotalPrice" class="text-danger"></span>
                                </div>
                            </div>
                        </div>


                        <div class="d-flex mb-3 justify-content-center ">
                            <button type="submit" style="background-color:#1d273b!important;" class="btn text-white  mb-3  w-75 mt-3"> <i class="fa-regular fa-floppy-disk"></i> تاكيد تعديل الطلب</button>
                        </div>
                    </div>
                </form>

            </div>
        </div>
    </div>
</div>
<input hidden value="@Model.ExternalOrderId" id="ExternalId" />
<div id="deliveryInfo" data-delivery-company-id="@Model.DeliveryCompanyId"></div>

