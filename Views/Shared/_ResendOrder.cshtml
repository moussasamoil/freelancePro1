<script>

    function formatOption(option) {
        // Ensure option.element is available to prevent errors in non-DOM options
        if (!option.id || !option.element) {
            // Check for and handle the placeholder option specifically
            var imageUrl = $(option.element).data('image');
            var imageTag = imageUrl ? '<img src="' + imageUrl + '" class="img-flag" style="margin-bottom: 5px; width: 14px; height: 14px;" />' : '';
            return $('<span>' + imageTag + option.text + '</span>');
        }

        var imageUrl = $(option.element).data('image');
        var imageTag = imageUrl ? '<img src="' + imageUrl + '" class="img-flag" style="margin-bottom: 5px; width: 14px; height: 14px;" />' : '';
        return $('<span>' + imageTag + option.text + '</span>');
    }



    $('#cityDropdown,#orderSourceDropdown,#manufacturingCompanyDropdown,#StoreNameDropDown,#productDropdown,#GenderDropdown,#deliveryCompanyDropdown,#deliveryRepresentativeDropdown,#IsPaid').select2({
        templateResult: formatOption,
        templateSelection: formatOption,
        dropdownParent: $('#Resend'), // Ensure this is the correct container for your modal/dialog.
        dir: "rtl" // Applies RTL layout to both dropdowns.
    });

</script>

<script type="text/javascript">

    var modelDeliveryCompanyId = $('#deliveryInfo').data('delivery-company-id');
    console.log("Model DeliveryCompanyId:", modelDeliveryCompanyId);
    $('#deliveryCompanyDropdown').change(function () {
        // Reset delivery representative dropdown
        $('#deliveryRepresentativeDropdown').val('');

        // Update the hidden input to the value of delivery company dropdown
        var selectedValue = $(this).val();
        $('#hiddenDeliveryCompanyId').val(selectedValue);

        // Optional: Add any specific logic for when the delivery company dropdown changes
    });

    $('#deliveryRepresentativeDropdown').change(function () {
        // Reset delivery company dropdown
        $('#deliveryCompanyDropdown').val('');

        // Update the hidden input to the value of delivery representative dropdown
        var selectedValue = $(this).val();
        $('#hiddenDeliveryCompanyId').val(selectedValue);

        // Optional: Add any specific logic for when the delivery representative dropdown changes
    });

    function updateHiddenInput() {
        var companyDropdownValue = $('#deliveryCompanyDropdown').val();
        var representativeDropdownValue = $('#deliveryRepresentativeDropdown').val();

        if (companyDropdownValue) {
            $('#hiddenDeliveryCompanyId').val(companyDropdownValue);
        } else if (representativeDropdownValue) {
            $('#hiddenDeliveryCompanyId').val(representativeDropdownValue);
        }

        // Event handler for delivery company dropdown change
        $('#deliveryCompanyDropdown').change(function () {
            // Reset delivery representative dropdown
            $('#deliveryRepresentativeDropdown').val('');

            // Update the hidden input to the value of delivery company dropdown
            var selectedValue = $(this).val();
            $('#hiddenDeliveryCompanyId').val(selectedValue);
        });

        // Event handler for delivery representative dropdown change
        $('#deliveryRepresentativeDropdown').change(function () {
            // Reset delivery company dropdown
            $('#deliveryCompanyDropdown').val('');

            // Update the hidden input to the value of delivery representative dropdown
            var selectedValue = $(this).val();
            $('#hiddenDeliveryCompanyId').val(selectedValue);
        });

        // Check if options match the modelDeliveryCompanyId for initial load or other triggers
        var modelDeliveryCompanyId = $('#hiddenDeliveryCompanyId').val(); // Assuming this value is pre-defined or set elsewhere
        var isCompanyOptionAvailable = $('#deliveryCompanyDropdown option[value="' + modelDeliveryCompanyId + '"]').length > 0;
        var isRepresentativeOptionAvailable = $('#deliveryRepresentativeDropdown option[value="' + modelDeliveryCompanyId + '"]').length > 0;

        var selectedValue = null;
        // Check which dropdown contains an option that matches the modelDeliveryCompanyId and set that as the selectedValue
        if (isRepresentativeOptionAvailable) {
            selectedValue = modelDeliveryCompanyId; // Assuming this ID is for a representative
            $('#deliveryRepresentativeDropdown').val(selectedValue); // Set the dropdown if necessary
        } else if (isCompanyOptionAvailable) {
            selectedValue = modelDeliveryCompanyId; // Assuming this ID is for a company
            $('#deliveryCompanyDropdown').val(selectedValue); // Set the dropdown if necessary
        }

        // Update the hidden input with the selected value if not already done by change handlers
        if (selectedValue !== null) {
            $('#hiddenDeliveryCompanyId').val(selectedValue);
            console.log("Updated hiddenDeliveryCompanyId value:", selectedValue);
        }
    }

    // Initial call to setup event handlers and perform any initial updates
    updateHiddenInput();


    function updateWarehouseIndexes() {
        $('.appended-warehouse-row').each(function (index) {
            // Update the index for each warehouse element
            $(this).find('.selected-warehouse').attr('name', `SelectedWarehouses[${index}].WarehouseName`);
            $(this).find('input[type=hidden]').attr('name', `SelectedWarehouses[${index}].WarehouseId`);
            $(this).find('.amount').attr('name', `SelectedWarehouses[${index}].Amount`);
            $(this).find('.amount').attr('id', `SelectedWarehouses_${index}__Amount`);
        });
    }

    // At the top of your script
    var warehousesToRemove = [];

    // amount increase button
    $(document).on('click', '.increase', function () {
        var $amountInput = $(this).closest('.my-input-group').find('.amount');
        var value = parseInt($amountInput.val() || 0); // Handle null or undefined values
        var maxAmount = parseInt($amountInput.closest('.row').data('warehouse-remaining-amount'));

        $amountInput.val(value + 1);
    });

    // amount decrease button
    $(document).on('click', '.decrease', function () {
        var $amountInput = $(this).closest('.my-input-group').find('.amount');
        var value = parseInt($amountInput.val());

        if (!isNaN(value) && value > 1) {
            $amountInput.val(value - 1);
        } else {
            if (confirm('هل انت متاكد من حذف المستودع')) {
                var $row = $(this).closest('.appended-warehouse-row');
                $row.remove();
                updateWarehouseIndexes();
            }
        }
    });


    function checkWarehouseCount() {
        var allWarehouseElements = document.querySelectorAll('.existing-warehouse-class, .appended-warehouse-row');
        if (allWarehouseElements.length < 1) {
            alert("يجب أن يكون هناك مستودع واحد على الأقل.");
            return false; // Return false if the condition to prevent submission is met
        }
        return true; // Return true to allow form submission
    }

    form.addEventListener("submit", function (event) {
        if (!checkWarehouseCount()) {
            event.preventDefault(); // Prevent form submission if there are no warehouses
        } else {
            // If the form is being submitted, send AJAX requests to remove warehouses
            warehousesToRemove.forEach(function (warehouse) {
                $.ajax({
                    url: '/Order/RemoveWarehouse',
                    type: 'POST',
                    data: {
                        orderId: warehouse.orderId,
                        warehouseId: warehouse.warehouseId
                    },
                    success: function (result) {
                        console.log('Warehouse removed successfully from the backend.');
                    },
                    error: function (xhr, status, error) {
                        var errorMessage = xhr.status + ': ' + xhr.statusText;
                        console.error('Error - ' + errorMessage);
                        alert('Error - ' + errorMessage);
                    }
                });
            });
            warehousesToRemove = []; // Clear the array after processing
        }
    });



    $(document).ready(function () {


        $.ajax({
            type: 'GET',
            url: '@Url.Action("GetAllStores", "DataList")',
            success: function (data) {
                populateDropdown(data);
            },
            error: function (xhr, status, error) {
                console.error(error);
            }
        });

        $('#hiddenManufacturingCompanyId').val('@Model.ManufacturingCompanyId');


        $('#manufacturingCompanyDropdown').change(function () {
            // Update the value of hiddenManufacturingCompanyId when the dropdown changes
            $('#hiddenManufacturingCompanyId').val($(this).val());
        });

        function populateDropdown(companies) {
            var dropdown = $('#manufacturingCompanyDropdown');
            dropdown.empty();
            dropdown.append($('<option>').val('').text('اسم  المتجر').prop('disabled', true));
            $.each(companies, function (index, company) {
                var option = $('<option>').val(company.id).text(company.name).data('image', company.logoUrl);
                if (company.id == '@Model.ManufacturingCompanyId') {
                    option.prop('selected', true);
                }
                dropdown.append(option);
            });
        }



        var source = @Html.Raw(Json.Serialize(Model.OrderSource)); // Assuming Model.OrderSource contains the value

        console.log("Order Source:", source); // Debugging)

        // Check if the source is "واىساب"
        if (source === 4) {
            var sourceNameInput = document.querySelector('#sourceNameDiv input');
            sourceNameInput.disabled = true;
        }



        $('#form').on('submit', function () {
            // Explicitly set the dropdown value to ensure it's captured
            cityDropdown.val(cityDropdown.find('option:selected').val());

            // Set the hidden input value to the dropdown's selected value
            $('#hiddenState').val(cityDropdown.val());



            // Log values to console for debugging purposes
            updateHiddenInput(); // Ensure hidden input value is current
            console.log("Submitting with Delivery Company/Representative ID:", $('input[name="DeliveryCompanyId"]').val());
        });


        $("#cityDropdown").change(function () {
            var selectedState = $(this).val();
            $("#hiddenState").val(selectedState);
        });

        $('#StoreNameDropDown').on('change', function () {
            // Get the selected option
            var selectedOption = $(this).find('option:selected');
            var id = selectedOption.val(); // The value of the option is the ID
            var name = selectedOption.text(); // The text of the option is the name

            // Print the ID and name
            console.log('Selected ID: ' + id + ', Name: ' + name);

            // Optionally, display these values on your web page
            // $('#someElement').text('Selected ID: ' + id + ', Name: ' + name);
        });




        // get from  id
        var form = document.getElementById("form");
        // get ware house amount input id
        var amountInput = document.getElementById("amountInput");


        // get current coutnry value
        var initialCountry = '@Html.Raw(Model.Country)';
        // get current state  value
        var initialState = '@Html.Raw(Model.State)';

        // Set the initial values for the coutnry drop down
        $('#countryDropdown').val(initialCountry);

        // Set the initial values for the city drop down



        // Debugging: Log the initial values to the console
        console.log("Initial Country:", initialCountry);
        console.log("Initial State:", initialState);


        var warehouseOptions = [];
        // get cities
        var citiesByCountry = @Html.Raw(Json.Serialize(lotus_blue.Models.Common.CitiesByCountry));
        // get current city


        // get country drop down value
        var countryDropdown = $('#countryDropdown');
        // get city drop down value
        var cityDropdown = $("#cityDropdown");

        var selectedCountry = countryDropdown.val();


        // Function to populate cities dropdown based on the selected country
        function populateCities(selectedCountry) {
            console.log("populateCities called with selectedCountry:", selectedCountry); // Debug

            cityDropdown.empty(); // Clear any existing options
            console.log("Dropdown cleared"); // Debug

            cityDropdown.append($('<option>', {
                value: '',
                text: 'المدينة',
                'data-image': '/static/city-regular.svg'
            }));
            console.log("Default city option appended"); // Debug

            // Check if the selectedCountry is defined and has cities in the citiesByCountry object
            if (selectedCountry && citiesByCountry[selectedCountry]) {
                var cities = citiesByCountry[selectedCountry];
                console.log("Cities for selectedCountry:", cities); // Debug

                var cityExistsInModel = cities.includes(initialState); // Check if initialState exists in cities
                console.log("Does the city exist in the model?", cityExistsInModel); // Debug

                // Append cities to the dropdown
                cities.forEach(function (city) {
                    cityDropdown.append($('<option>', {
                        value: city,
                        text: city,
                        'data-image': '/static/city-regular.svg'

                    }));
                    console.log("Appended city:", city); // Debug
                });

                // Set the selected city if it exists in the model; otherwise, default to 'المدينة'
                cityDropdown.val(cityExistsInModel ? initialState : '');
                console.log("Dropdown value set to:", cityDropdown.val()); // Debug to confirm value set
            } else {
                // If no cities or invalid country, keep the dropdown to 'المدينة'
                cityDropdown.val('');
                console.log("No valid country selected or no cities available. Dropdown set to default."); // Debug
            }
        }


        // Populate the city dropdown on page load
        populateCities(initialCountry);


        // update delviery companies based on country
        function updateDeliveryCompanies(selectedCountry) {
            var country = selectedCountry || $('#countryDropdown').val(); // Use the provided selectedCountry or get it from the dropdown
            var city = $('#cityDropdown').val();
            // Add a variable for the initial delivery company id from the model
            var initialDeliveryCompanyId = '@Model.DeliveryCompanyId';

            $.ajax({
                type: 'GET',
                url: '@Url.Action("GetAllDeliveryCompanies", "DataList")',
                data: { countryId: country },
                success: function (data) {
                    var deliveryCompanyDropdown = $('#deliveryCompanyDropdown');
                    deliveryCompanyDropdown.empty();
                    deliveryCompanyDropdown.append($('<option>', {
                        value: '',
                        text: 'أسم شركة التوصيل',
                        disabled: true,
                        "data-image": "/static/truck-regular.svg", // Static image for the placeholder

                    }));

                    $.each(data, function (index, company) {
                        deliveryCompanyDropdown.append($('<option>', {
                            value: company.id,
                            text: company.name,
                            "data-image": "/static/truck-regular.svg", // Static image for the placeholder

                        }));
                    });

                    // After populating, set the selected value if the initialDeliveryCompanyId is present
                    if (initialDeliveryCompanyId) {
                        deliveryCompanyDropdown.val(initialDeliveryCompanyId);
                    }
                },
                error: function (xhr, textStatus, errorThrown) {
                    console.error('Error: ' + textStatus, errorThrown);
                }
            });
        }

        // call this function to populate delivery companies based on model country
        updateDeliveryCompanies(initialCountry);


        function updateDeliveryRepresentatives() {
            var country = initialCountry;// Use the provided selectedCountry or get it from the dropdown
            var city = $('#cityDropdown').val();
            // Add a variable for the initial delivery company id from the model
            var initialDeliveryCompanyId = '@Model.DeliveryCompanyId';

            $.ajax({
                type: 'GET',
                url: '@Url.Action("GetAllDeliveryRepresentatives", "DataList")',
                data: { countryId: country, cityId: city },
                success: function (data) {
                    var deliveryRepresentativeDropdown = $('#deliveryRepresentativeDropdown');
                    deliveryRepresentativeDropdown.empty();
                    deliveryRepresentativeDropdown.append($('<option>', {
                        value: '',
                        text: 'أسم شركة التوصيل',
                        disabled: true,
                        "data-image": "/static/truck-regular.svg", // Static image for the placeholder

                    }));

                    $.each(data, function (index, company) {
                        deliveryRepresentativeDropdown.append($('<option>', {
                            value: company.id,
                            text: company.name,
                            "data-image": "/static/truck-regular.svg", // Static image for the placeholder

                        }));
                    });

                    // After populating, set the selected value if the initialDeliveryCompanyId is present
                    if (initialDeliveryCompanyId) {
                        deliveryRepresentativeDropdown.val(initialDeliveryCompanyId);
                    }

                    if ($('#deliveryRepresentativeDropdown').val()) {
                        console.log("Delivery representative dropdown has a value");

                        // If it has a value, disable cityDropdown
                        $('#cityDropdown').prop('disabled', true);
                    } else {
                        console.log("Delivery representative dropdown does not have a value");
                    }

                },
                error: function (xhr, textStatus, errorThrown) {
                    console.error('Error: ' + textStatus, errorThrown);
                }
            });
        }
        updateDeliveryRepresentatives();


        $('#deliveryCompanyDropdown, #deliveryRepresentativeDropdown').change(function () {
            updateHiddenInput();
            var hasAppendedWarehouses = $('.appended-warehouse-row').length > 0;

            if (hasAppendedWarehouses && confirm('Changing the delivery company will remove all listed warehouses. Do you want to continue?')) {
                removeAllWarehouses();
                // Directly call updateHiddenInput() to reflect changes made by removeAllWarehouses()
                updateHiddenInput();
            }

            // Update warehouses and amount
            updateWarehouses();
        });





        //get the value for delivey company on page load
        var initialDeliveryCompanyIdFromModel = '@Model.DeliveryCompanyId';
        console.log("Initial Delivery Company ID:", initialDeliveryCompanyIdFromModel);

        // Call updateWarehouses function with the retrieved delivery company ID on page load
        updateWarehouses(initialDeliveryCompanyIdFromModel);
        // update warehouses function based on delviery company changed
        function updateWarehouses(deliveryCompanyId) {
            var country = $('#countryDropdown').val();
            var city = $('#cityDropdown').val();
            var deliveryCompanyId = $('#deliveryCompanyDropdown').val() || initialDeliveryCompanyIdFromModel;
            var deliveryRepresentativeValue = $('#deliveryRepresentativeDropdown').val();
            var companyIdToSend = deliveryCompanyId; // Separate variable to store the value to send
            if (deliveryCompanyId === null || deliveryCompanyId === "") {
                // If deliveryCompanyId is null or empty, use the value of deliveryRepresentativeValue
                companyIdToSend = deliveryRepresentativeValue;
            }

            if (deliveryRepresentativeValue === null || deliveryRepresentativeValue === "") {
                // If deliveryRepresentativeValue is null or empty, use the value of deliveryCompanyId
                companyIdToSend = deliveryCompanyId;
            }
            $.ajax({
                type: 'GET',
                url: '@Url.Action("GetFilteredWarehouses", "DataList")', // Replace with your actual URL
                data: { deliveryCompanyId: companyIdToSend },
                success: function (data) {
                    warehouseOptions = data; // Store the warehouse data
                    populateFirstWarehouseDropdown(); // Corrected the function call
                    console.log("Inside AJAX call, Delivery Company ID: ", deliveryCompanyId);
                },
                error: function (xhr, textStatus, errorThrown) {
                    console.error('Error: ' + textStatus, errorThrown);
                }
            });
        }

        // show append قم باختيار احدى المنتجات
        function populateFirstWarehouseDropdown() {
            var warehouseDropdown = $('#productDropdown');
            warehouseDropdown.empty();
            warehouseDropdown.append($('<option>', {
                disabled: true,
                selected: true,
                text: 'قم بإختيار إحدى المنتجات',
                'data-image': '/static/box-open-2.svg'

            }));

            warehouseOptions.forEach(function (warehouse) {
                warehouseDropdown.append($('<option>', {
                    value: warehouse.id,
                    text: warehouse.name,
                    'data-image': warehouse.productImage // Assuming this is correct

                }));
            });
        }


        // اضافة مستودع جديد

        function addNewWarehouseItem() {
            var selectedWarehouseId = $('#productDropdown').val();
            var selectedWarehouse = warehouseOptions.find(warehouse => warehouse.id.toString() === selectedWarehouseId);

            if (!selectedWarehouse) return; // Exit if no warehouse is selected

            // Calculate the new index based on the total number of warehouses
            var warehouseIndex = $('.appended-warehouse-row').length;

            var warehouseHtml = `
                                            <div class="appended-warehouse-row row ms-0 mt-3" data-warehouse-id="${selectedWarehouse.id}" data-warehouse-name="${selectedWarehouse.name}" data-warehouse-amount="${selectedWarehouse.amount}">
                                                <div class="col-lg-6">
                                                    <div class="form-group appenddiv blue-warehouse">
                                                        <div class="warehouse-item">
                                                            <span class="selected-warehouse">${selectedWarehouse.name}</span>
                                                            <input type="hidden" name="SelectedWarehouses[${warehouseIndex}].WarehouseId" value="${selectedWarehouse.id}">
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-lg-6 pe-4 ps-0">
                                                    <div class="form-group">
                                                        <div class="input-group my-input-group" style="width: 105%!important">
                                                                <button type="button" class="btn decrease rounded-btn">-</button>
                                                            <input min="1" required value="1" placeholder="الكمية" class="form-control amount" name="SelectedWarehouses[${warehouseIndex}].Amount">
                                                                <button  type="button" class="btn increase rounded-btn">+</button>
                                                        </div>
                                                        <span class="text-danger"></span> <!-- Placeholder for validation message -->
                                                    </div>
                                                </div>
                                            </div>`;

            $('#selectedProductsList').append(warehouseHtml);

            // Update warehouse dropdown
            warehouseOptions = warehouseOptions.filter(warehouse => warehouse.id.toString() !== selectedWarehouseId);
            populateFirstWarehouseDropdown();

        }


        // when قم باختيار احدى المنتجات  change its calling adding new warehouse to add a new item

        $('#productDropdown').change(function () {
            if ($(this).val()) {
                addNewWarehouseItem();
                updateWarehouseIndexes()
            }
        });


        // check max amount
        $('#selectedProductsList').on('input', '.amount', function () {
            var $amountInput = $(this);
            var enteredValue = parseInt($amountInput.val());
            var maxAmount = parseInt($amountInput.closest('.row').data('warehouse-amount'));

            // Check if the entered value exceeds the maximum available amount
            if (!isNaN(enteredValue) && enteredValue > maxAmount) {
                alert(`Available amount is ${maxAmount}`);
                $amountInput.val(maxAmount); // Optionally reset the value to the max amount
            }
        });

        // remove all warehouses on country delivery company changes
        function removeAllWarehouses() {
            // Confirm with the user before proceeding
            if (confirm('القيام بهذه العملية سوف يحذف المنتجات. هل تريد المتابعة؟')) {
                $('.appended-warehouse-row').each(function () {
                    var warehouseId = $(this).data('warehouse-id');
                    var orderId = '@Model.Id'; // Ensure this value is correctly populated

                    // Perform the AJAX request to remove the warehouse
                    $.ajax({
                        url: '/Order/RemoveWarehouse', // Adjust the URL as needed for your routing
                        type: 'POST',
                        data: {
                            orderId: orderId,
                            warehouseId: warehouseId
                        },
                        context: this, // This line is important to maintain the context inside the success callback
                        success: function (result) {
                            // If the warehouse is successfully removed, remove the corresponding row in the DOM
                            $(this).remove(); // 'this' refers to the '.appended-warehouse-row' element
                            console.log('Warehouse removed successfully');

                        },
                        error: function (xhr, status, error) {
                        }
                    });
                });
            }
        }

        // remove appended items function
        function removeAppendedWarehouseItems() {
            $('.appended-warehouse-row').remove(); // This targets the specific rows to remove
            updateWarehouseIndexes()

        };



    });

</script>
