@* ملاحظة الطلب — chat-style modal wired to OrderPosts type=2 (OrderNote). Opens via the ملاحظة الطلب link. *@
<div class="modal fade order-notes-dummy-modal" id="orderNotesDummyModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog" id="orderNotesDummyDialog">
        <div class="modal-content ond-chat-window">

            <header class="ond-chat-header">
                <div class="ond-avatar">
                    <img class="ond-avatar-img" id="ondStoreImage" src="" alt="" />
                </div>
                <div class="ond-header-titles">
                    <div class="ond-arabic-line" id="ondStoreName"></div>
                    <div class="ond-contact-name" id="ondSourceLabel"></div>
                </div>
                <div class="ond-header-actions">
                    <button class="ond-icon-btn" type="button" data-bs-dismiss="modal" aria-label="Close">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#9a9a9a" stroke-width="2.2" stroke-linecap="round">
                            <path d="M5 5l14 14M19 5L5 19" />
                        </svg>
                    </button>
                </div>
            </header>

            <main class="ond-messages" id="ondMessages"></main>

            <footer class="ond-composer">
                <button class="ond-send-btn" type="button" id="ondSendBtn" aria-label="Send message">إرسال</button>
                <div class="ond-composer-wrap">
                    <div class="ond-attach-preview" id="ondAttachPreview" style="display:none;"></div>
                    <textarea class="ond-composer-input" id="ondComposerInput" rows="1" placeholder="اكتب رسالة"></textarea>
                </div>
            </footer>

        </div>
    </div>
</div>

<style>
    #orderNotesDummyModal {
        --ond-green: #293753;
        --ond-green-dark: #1d273b;
        --ond-bubble-gray: #ececec;
        --ond-text-dark: #222;
        --ond-text-mid: #777;
        --ond-text-light: #aaa;
        --ond-border-soft: #f0f0f0;
    }

    #orderNotesDummyDialog .ond-chat-window {
        width: 100%;
        height: 100%;
        background: #fff;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        border: none;
        border-radius: 0;
        direction: ltr;
        text-align: left;
    }

    #orderNotesDummyModal .ond-chat-header {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 14px 26px;
        border-bottom: 1px solid var(--ond-border-soft);
        flex-shrink: 0;
    }
    #orderNotesDummyModal .ond-avatar {
        width: 80px; height: 80px;
        border-radius: 0 !important;
        background: transparent !important;
        border: 0 !important;
        outline: 0 !important;
        box-shadow: none !important;
        padding: 0 !important;
        display: flex; align-items: center; justify-content: center;
        flex-shrink: 0;
    }
    #orderNotesDummyModal .ond-avatar-img {
        width: 100%; height: 100%;
        object-fit: contain;
        display: block;
        border-radius: 0 !important;
        background: transparent !important;
        border: 0 !important;
        outline: 0 !important;
        box-shadow: none !important;
    }
    #orderNotesDummyModal .ond-header-titles {
        flex-grow: 1;
        display: flex;
        flex-direction: column;
        gap: 2px;
    }
    #orderNotesDummyModal .ond-arabic-line {
        direction: rtl;
        color: var(--ond-green);
        font-size: 15px;
        font-weight: 600;
        text-align: left;
    }
    #orderNotesDummyModal .ond-contact-name {
        font-size: 20px;
        font-weight: 700;
        color: var(--ond-text-dark);
        direction: rtl;
        text-align: left;
    }
    #orderNotesDummyModal .ond-header-actions {
        display: flex; align-items: center; gap: 18px;
    }
    #orderNotesDummyModal .ond-icon-btn {
        background: none; border: none; cursor: pointer;
        display: flex; align-items: center; justify-content: center; padding: 4px;
    }

    #orderNotesDummyModal .ond-messages {
        flex-grow: 1;
        overflow-y: auto;
        padding: 32px 40px 16px;
        display: flex;
        flex-direction: column;
        gap: 18px;
        background: #fff;
        scrollbar-width: thin;
        scrollbar-color: #1d273b #f1f3f5;
    }
    #orderNotesDummyModal .ond-row { display: flex; flex-direction: column; max-width: 70%; }
    #orderNotesDummyModal .ond-row.right { align-self: flex-end; align-items: flex-end; }
    #orderNotesDummyModal .ond-row.left { align-self: flex-start; align-items: flex-start; }
    #orderNotesDummyModal .ond-meta {
        display: flex; align-items: center; justify-content: space-between;
        width: 100%;
        color: var(--ond-text-mid);
        font-size: 14px;
        margin-bottom: 8px;
        gap: 12px;
    }
    #orderNotesDummyModal .ond-meta .ond-meta-name { color: var(--ond-green); font-weight: 600; }
    #orderNotesDummyModal .ond-bubble {
        padding: 14px 20px;
        font-size: 17px;
        line-height: 1.5;
        word-wrap: break-word;
        white-space: pre-wrap;
    }
    #orderNotesDummyModal .ond-bubble.sent {
        background: var(--ond-green);
        color: #fff;
        border-radius: 18px;
    }
    #orderNotesDummyModal .ond-bubble.received {
        background: var(--ond-bubble-gray);
        color: var(--ond-text-dark);
        border-radius: 18px;
    }
    #orderNotesDummyModal .ond-bubble.group-end { position: relative; }
    #orderNotesDummyModal .ond-bubble.sent.group-end::after {
        content: ""; position: absolute;
        top: 19%; bottom: -6px; width: 10px;
        background: transparent;
        border-left: 7px var(--ond-green) solid;
        border-radius: 0 18px 0 32px;
        right: 3px;
        transform: translateX(50%);
    }
    #orderNotesDummyModal .ond-bubble.received.group-end::after {
        content: ""; position: absolute;
        top: 19%; bottom: -6px; width: 10px;
        background: transparent;
        border-right: 7px var(--ond-bubble-gray) solid;
        border-radius: 18px 0 32px 0;
        left: 3px;
        transform: translateX(-50%);
    }

    #orderNotesDummyModal .ond-bubble-images {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
        gap: 6px;
        margin-bottom: 6px;
        width: 100%;
    }
    #orderNotesDummyModal .ond-bubble-images img {
        width: 100%;
        aspect-ratio: 1 / 1;
        object-fit: cover;
        border-radius: 8px;
        display: block;
        cursor: zoom-in;
    }

    #orderNotesDummyModal .ond-empty {
        align-self: center;
        margin: auto 0;
        color: var(--ond-text-light);
        font-size: 14px;
    }

    #orderNotesDummyModal .ond-composer {
        display: flex; align-items: flex-end; gap: 16px;
        padding: 16px 26px;
        border-top: 1px solid var(--ond-border-soft);
        flex-shrink: 0;
    }
    #orderNotesDummyModal .ond-composer-wrap {
        flex-grow: 1;
        background: #f5f5f5;
        border-radius: 8px;
        padding: 8px 12px;
        display: flex;
        flex-direction: column;
        gap: 6px;
    }
    #orderNotesDummyModal .ond-attach-preview {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
    }
    #orderNotesDummyModal .ond-attach-thumb {
        position: relative;
        width: 56px; height: 56px;
        border-radius: 6px;
        overflow: hidden;
        background: #ddd;
    }
    #orderNotesDummyModal .ond-attach-thumb img {
        width: 100%; height: 100%; object-fit: cover; display: block;
    }
    #orderNotesDummyModal .ond-attach-thumb-remove {
        position: absolute; top: 2px; right: 2px;
        width: 18px; height: 18px;
        border: none; border-radius: 50%;
        background: rgba(0,0,0,0.6); color: #fff;
        font-size: 12px; line-height: 1; cursor: pointer;
        display: flex; align-items: center; justify-content: center;
        padding: 0;
    }
    #orderNotesDummyModal .ond-composer-input {
        background: transparent;
        border: none;
        padding: 6px 6px;
        font-size: 15px;
        color: var(--ond-text-dark);
        direction: rtl;
        text-align: right;
        outline: none;
        font-family: inherit;
        resize: none;
        max-height: 140px;
        overflow-y: auto;
    }
    #orderNotesDummyModal .ond-composer-input::placeholder { color: var(--ond-text-light); }
    #orderNotesDummyModal .ond-send-btn {
        background: var(--ond-green);
        color: #fff;
        border: none;
        border-radius: 8px;
        padding: 12px 22px;
        font-size: 15px;
        font-weight: 600;
        font-family: inherit;
        cursor: pointer;
        flex-shrink: 0;
    }
    #orderNotesDummyModal .ond-send-btn:hover { background: var(--ond-green-dark); }
    #orderNotesDummyModal .ond-send-btn:disabled { opacity: 0.6; cursor: not-allowed; }
</style>
