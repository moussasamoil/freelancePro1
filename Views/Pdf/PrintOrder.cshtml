@model List<lotus_blue.Models.ViewModel.OrderViewModel>
@{
    Layout = "_EmptyLayout";

    ViewData["Title"] = "فاتورة الطلبات";
}

@foreach (var Model in Model)
{
    <div class="print" id="Print" style="direction: rtl; margin: 0 auto;">
        <div style="background-color: #f1f2f3; padding: 20px; margin: 0;">
            <div style="max-width: 800px; margin: auto; background-color: #fff; border-radius: 8px; box-shadow: 0px 2px 10px rgba(0, 0, 0, 0.1); padding: 40px; padding-bottom: 0px !important;">
                <div style="text-align: start;">
                    @if (Model.ManufacturingCompany != null && !string.IsNullOrEmpty(Model.ManufacturingCompany.InvoiceImage))
                    {
                        <h1 style="margin: 0; color: black;"><img src="/@Model.ManufacturingCompany.InvoiceImage" width="125" /></h1>
                    }
                    else
                    {
                        <h1 style="margin: 0; color: black;"><img src="/static/مفرغغ.png" width="125" /></h1>
                    }
                </div>

                <div style="overflow: hidden; margin-top: 10px;">
                    <div style="width: 48%; float: right;">
                        <p style="font-weight: bold;"> المرسل</p>
                        <p>@(Model.ManufacturingCompany?.Name ?? "MAJESTA GROUP")</p>
                        @if (!string.IsNullOrEmpty(Model.ManufacturingCompany?.PhoneNumber))
                        {
                            <p>@Model.ManufacturingCompany.PhoneNumber</p>
                        }
                        <p> التاريخ - @Model.CreatedDate.ToString("yyyy-MM-dd")</p>
                    </div>
                    <div style="width: 48%; float: left;">
                        <p style="font-weight: bold;"> المستلم</p>
                        <p>@Model.CustomerName</p>
                        <p>@Model.TelephoneNumber</p>
                        <p>@Model.Address</p>
                        <p>@Model.State</p>
                    </div>
                </div>
                <h4 style="color: #80D1F1; text-align: center; margin-top: 15px; margin-bottom: 0;">فاتورة الطلب</h4>

                <table style="width: 100%; border-collapse: collapse; margin-top: 10px; background-color: #fff;">
                    <thead>
                        <tr>
                            <th style="border-bottom: 1px solid #e0e0e0; padding: 16px; text-align: right; width: 35%;">اسم المنتج</th>
                            <th style="border-bottom: 1px solid #e0e0e0; padding: 16px; text-align: right; width: 20%;">الكمية</th>
                            <th style="border-bottom: 1px solid #e0e0e0; padding: 16px; text-align: right; width: 20%;">السعر </th>
                            <th style="border-bottom: 1px solid #e0e0e0; padding: 16px; text-align: right; width: 25%;">السعر الأجمالي</th>
                            <th style="display: none;">Handlinger</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var warehouse in Model.SelectedWarehouses)
                        {
                            <tr>
                                <td style="border-bottom: 1px solid #e0e0e0; padding: 16px; text-align: right;">@warehouse.WarehouseName</td>
                                <td style="border-bottom: 1px solid #e0e0e0; padding: 16px; text-align: right;">@warehouse.Amount</td>
                                <td style="border-bottom: 1px solid #e0e0e0; padding: 16px; text-align: right;">@(Model.TotalPrice / warehouse.Amount)</td>
                                <td style="border-bottom: 1px solid #e0e0e0; padding: 16px; text-align: right;">@Model.TotalPrice @Common.GetCurrencyByCountryName(Model.Country.ToString())</td>
                            </tr>
                        }
                    </tbody>
                </table>

                <table style="width: 100%; border-collapse: collapse;">
                    <thead>
                        <tr>
                            <th width="50" style="padding: 8px; text-align: right;">
                                <p style="color: #80D1F1; font-size: 1em; font-weight: bold;"><strong>رقم الوصل:</strong> <span>#@Model.Id</span></p>
                            </th>

                            <th width="50" style="padding: 8px; text-align: left;">
                                <p style="color: #80D1F1; font-size: 1em; font-weight: bold;"><strong>المبلع الإجمالي:</strong> <span id="total">@Model.TotalPrice @Common.GetCurrencyByCountryName(Model.Country.ToString())</span></p>
                            </th>
                        </tr>
                    </thead>
                </table>

                @if (Model.QRCodeImageBase64 != null)
                {
                    <div style="text-align: center; padding-top: 20px;">
                        <a href="@Model.QRCodeUrl" target="_blank">
                            <img src="data:image/png;base64,@Model.QRCodeImageBase64" width="160" alt="QR Code" />
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
}

<!--Bootstrap Typical Styles-->
<style>
    body {
        margin: 0;
        font-size: 1rem;
        font-weight: 400;
        line-height: 1.5;
        color: #212529;
        background-color: #fff;
        -webkit-text-size-adjust: 100%;
        -webkit-tap-highlight-color: transparent
    }

    thead {
        vertical-align: bottom
    }

    tbody {
        vertical-align: inherit
    }

    h5 {
        font-size: 1.25rem
    }

    .py-5 {
        padding-top: 3rem !important;
        padding-bottom: 3rem !important
    }

    .pt-5 {
        padding-top: 3rem !important;
    }

    .my-4 {
        margin-top: 2rem !important;
        margin-bottom: 2rem !important;
    }

    .mx-3 {
        margin-right: 1rem !important;
        margin-left: 1rem !important;
    }

    .container, .container-fluid, .container-lg, .container-md, .container-sm, .container-xl, .container-xxl {
        width: 100%;
        padding-right: var(--bs-gutter-x,.75rem);
        padding-left: var(--bs-gutter-x,.75rem);
        margin-right: auto;
        margin-left: auto
    }

    .h6,
    h6 {
        font-size: 1rem
    }

    p {
        margin-top: 0;
        margin-bottom: 1rem
    }

    b,
    strong {
        font-weight: bolder
    }

    .small,
    small {
        font-size: .875em
    }

    a {
        color: #0d6efd;
        text-decoration: underline
    }

        a:hover {
            color: #0a58ca
        }

    .text-center {
        text-align: center !important;
    }

    .text-end {
        text-align: end !important;
    }

    .fw-bold {
        font-weight: bold !important;
    }

    .w-100 {
        width: 100% !important;
    }

    .clearfix {
        clear: both;
    }
</style>


<style>

    #Print {
        display: block;
        transform: scale(0.98);
        transform: scaleY(0.87);
        transform-origin: top !important;
    }

    .print {
        page-break-after: always !important;
    }
</style>

<script>
    /*
        // Function to open the print dialog when the page is loaded
        window.onload = function () {
            window.print();
        };
    */
</script>
