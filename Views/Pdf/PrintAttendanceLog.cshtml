@using System
@using System.Linq
@using System.Collections.Generic
@model lotus_blue.Controllers.AttendanceLogPdfViewModel

@{
    Layout = null;

    Func<string, string> Show = value => string.IsNullOrWhiteSpace(value) ? "-" : value;

    var employeeNameToShow = Show(Model.EmployeeName);
    var employeeCodeToShow = Show(Model.EmployeeCode);
    var employeeIdNumberToShow = Show(Model.EmployeeIdNumber);
    var employeePhoneToShow = Show(Model.EmployeePhoneNumber);
    var employeeAddressToShow = Show(Model.EmployeeAddress);
    var employeeSalaryToShow = Show(Model.EmployeeSalary);
    var employeeAcademicLevelToShow = Show(Model.EmployeeAcademicLevel);
    var employeeTasksToShow = Show(Model.EmployeeTasks);
    var employeeDateOfBirthToShow = Show(Model.EmployeeDateOfBirth);
    var employeeGenderToShow = Show(Model.EmployeeGender);
    var employeeCountryToShow = Show(Model.EmployeeCountry);
    var employeeDateAddedToShow = Show(Model.EmployeeDateAdded);
    var employeeStatusToShow = Show(Model.EmployeeStatus);
    var accountTypeToShow = Show(Model.AccountType);
    var rowsPerPage = 15;
    var tablePagesCount = Math.Max(1, (int)Math.Ceiling((Model.Rows?.Count ?? 0) / (decimal)rowsPerPage));
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />

    <style>
        * {
            box-sizing: border-box;
        }

        html,
        body {
            margin: 0;
            padding: 0;
            background: #ffffff;
            color: #111827;
            font-family: Arial, Tahoma, sans-serif;
            direction: rtl;
        }

        body {
            font-size: 12px;
            line-height: 1.45;
            padding-bottom: 66px;
        }

        .pdf-page {
            width: 100%;
            padding: 8px 18px 76px;
            background: #ffffff;
        }

        .brand-header {
            width: 100%;
            height: 56px;
            margin: 0 0 18px;
            background: #959cab;
            /* نفس إحساس المرجع: غامق ناحية اللوجو، ويفتح ناحية اليمين لكن لا يصل للأبيض */
            background: -webkit-linear-gradient(left, #1b263d 0%, #1f2839 14%, #444c5d 30%, #6d778d 48%, #959cab 66%, #b8bdc7 84%, #d7dae0 100%);
            background: linear-gradient(to right, #1b263d 0%, #1f2839 14%, #444c5d 30%, #6d778d 48%, #959cab 66%, #b8bdc7 84%, #d7dae0 100%);
            overflow: hidden;
            direction: ltr;
            display: table;
            table-layout: fixed;
        }

        .brand-logo-wrap {
            height: 56px;
            display: table-cell;
            vertical-align: middle;
            padding-left: 14px;
            width: 215px;
        }

        .brand-logo {
            width: 190px;
            max-height: 54px;
            display: block;
            object-fit: contain;
            background: transparent;
        }

        .account-title-row {
            margin: 0 0 11px;
            border-bottom: 1px solid #b8c2cc;
            padding: 0 4px 7px;
            color: #64748b;
            font-size: 13px;
            font-weight: 700;
            text-align: right;
        }

        .account-details {
            width: 100%;
            display: table;
            table-layout: fixed;
            margin-bottom: 18px;
            direction: rtl;
        }

        .details-column {
            display: table-cell;
            vertical-align: top;
            width: 50%;
        }

            .details-column.right-column {
                padding-left: 18px;
            }

            .details-column.left-column {
                padding-right: 18px;
            }

        .detail-row {
            display: table;
            width: 100%;
            table-layout: fixed;
            margin-bottom: 5px;
            page-break-inside: avoid;
        }

        .info-row {
            display: flex;
            flex-direction: row;
            align-items: center;
            gap: 6px;
            direction: ltr;
            font-weight: normal !important;
        }

        .info-label {
            min-width: 110px;
            text-align: right;
            direction: rtl;
            font-weight: normal !important;
        }

        .info-value {
            flex: 1;
            text-align: right;
            direction: rtl;
            font-weight: normal !important;
        }

        .detail-label,
        .detail-colon,
        .detail-value {
            display: table-cell;
            vertical-align: top;
            font-size: 11.5px;
            line-height: 1.5;
        }

        .detail-label {
            width: 115px;
            color: #111827;
            font-weight: 900;
            white-space: nowrap;
            text-align: right;
        }

        .detail-colon {
            width: 10px;
            color: #111827;
            font-weight: 900;
            text-align: center;
        }

        .detail-value {
            color: #111827;
            font-weight: 600;
            text-align: right;
            word-break: break-word;
        }

        .employee-main-value {
            color: #1a263e;
            font-weight: 900;
        }

        .table-page {
            width: 100%;
            page-break-inside: avoid;
        }

        .table-page-break {
            page-break-before: always;
            padding-top: 8px;
        }

        .report-table {
            width: 100%;
            border-collapse: collapse;
            border-spacing: 0;
            table-layout: fixed;
            direction: rtl;
            margin-top: 8px;
            font-size: 10px;
            page-break-inside: auto;
        }

            .report-table thead {
                display: table-header-group;
            }

            .report-table tr {
                page-break-inside: avoid;
                page-break-after: auto;
            }

            .report-table th,
            .report-table td {
                border: 1px solid #111827;
                padding: 11px 6px;
                text-align: center;
                vertical-align: middle;
                word-break: break-word;
                line-height: 1.55;
                background: #ffffff;
            }

            .report-table th {
                background: #ffffff;
                color: #1d273b;
                font-weight: 900;
                direction: rtl;
            }

            .report-table td {
                direction: rtl;
            }

            .report-table .serial-cell {
                width: 38px;
            }

            .report-table .date-cell {
                width: 11%;
            }

            .report-table .time-cell {
                width: 11%;
            }

            .report-table .status-cell {
                width: 11%;
            }

            .report-table .amount-cell {
                width: 12%;
            }

            .report-table .reason-cell {
                width: 19%;
                text-align: right;
            }

        .amount-pill {
            display: inline-block;
            min-width: 74px;
            padding: 4px 10px;
            border-radius: 999px;
            font-size: 10px;
            font-weight: 900;
            direction: ltr;
            text-align: center;
            white-space: nowrap;
        }

        .deduction-value {
            color: #dc2626;
            background: rgba(220, 38, 38, 0.10);
            border: 1px solid rgba(220, 38, 38, 0.30);
        }

        .advance-value {
            color: #b45309;
            background: rgba(245, 158, 11, 0.16);
            border: 1px solid rgba(180, 83, 9, 0.32);
        }

        .bonus-value {
            color: #15803d;
            background: rgba(21, 128, 61, 0.12);
            border: 1px solid rgba(21, 128, 61, 0.28);
        }

        .totals-row {
            width: 100%;
            margin-top: 13px;
            text-align: left;
            direction: ltr;
            clear: both;
        }

        .total-deductions-box {
            min-width: 185px;
            display: inline-block;
            border-radius: 999px;
            padding: 8px 14px;
            margin-right: 6px;
            font-size: 12px;
            font-weight: 900 !important;
            text-align: center;
            direction: rtl;
            white-space: nowrap;
        }

            .total-deductions-box.total-error {
                color: #dc2626;
                background: rgba(220, 38, 38, 0.10);
                border: 1px solid rgba(220, 38, 38, 0.32);
            }

            .total-deductions-box.total-advance {
                color: #b45309;
                background: rgba(245, 158, 11, 0.16);
                border: 1px solid rgba(180, 83, 9, 0.32);
            }

            .total-deductions-box.total-bonus {
                color: #15803d;
                background: rgba(21, 128, 61, 0.12);
                border: 1px solid rgba(21, 128, 61, 0.28);
            }

            .total-deductions-box.total-late {
                color: #1c273c;
                background: rgba(15, 118, 110, 0.12);
                border: 1px solid rgba(15, 118, 110, 0.28);
                min-width: 230px;
            }

    </style>
</head>

<body>
    <div class="pdf-page">
        <div class="brand-header">
            <div class="brand-logo-wrap">
                <img class="brand-logo" src="data:image/png;base64," alt="LUXIRA HOLDING" />
            </div>
        </div>

        <div class="account-title-row">حساب الموظف</div>

        <div class="account-details">

            <div class="details-column left-column">
                <div class="detail-row">
                    <div class="detail-label">صاحب الحساب</div>
                    <div class="detail-colon">:</div>
                    <div class="detail-value">: LUXIRA KOZMETİK TİCARET LİMİTED ŞİRKETİ</div>
                </div>



                <div class="detail-row">
                    <div class="detail-label">المدخل رقم</div>
                    <div class="detail-colon">:</div>
                    <div class="detail-value">@Model.EntryNumber</div>
                </div>

                <div class="detail-row">
                    <div class="detail-label">رقم الحساب</div>
                    <div class="detail-colon">:</div>
                    <div class="detail-value">TR48 0020 5000 0995 6653 0000 01</div>
                </div>

                <div class="detail-row">
                    <div class="detail-label">العنوان</div>
                    <div class="detail-colon">:</div>
                    <div class="detail-value">ŞİRİNEVLER MAH. Mah. MERİÇ SK. No: 15 BAHÇELİEVLER/İstanbul</div>
                </div>

                <div class="detail-row">
                    <div class="detail-label">تاريخ إضافة الموظف</div>
                    <div class="detail-colon">:</div>
                    <div class="detail-value">@employeeDateAddedToShow</div>
                </div>

                <div class="detail-row">
                    <div class="detail-label">نوع الحساب</div>
                    <div class="detail-colon">:</div>
                    <div class="detail-value">@accountTypeToShow</div>
                </div>








            </div>
            <div class="details-column right-column">
                <div class="detail-row">
                    <div class="detail-label">تاريخ كشف السحب</div>
                    <div class="detail-colon">:</div>
                    <div class="detail-value">@Model.StatementDate.ToString("dd.MM.yyyy")</div>
                </div>

                <div class="detail-row">
                    <div class="detail-label">اسم الموظف</div>
                    <div class="detail-colon">:</div>
                    <div class="detail-value employee-main-value">@employeeNameToShow</div>
                </div>
                <div class="detail-row">
                    <div class="detail-label">الراتب</div>
                    <div class="detail-colon">:</div>
                    <div class="detail-value">@employeeSalaryToShow</div>
                </div>
                <div class="detail-row">
                    <div class="detail-label">عنوان الموظف</div>
                    <div class="detail-colon">:</div>
                    <div class="detail-value">@employeeAddressToShow</div>
                </div>

                <div class="detail-row">
                    <div class="detail-label">رقم الموظف</div>
                    <div class="detail-colon">:</div>
                    <div class="detail-value employee-main-value">@employeeCodeToShow</div>
                </div>

                <div class="detail-row">
                    <div class="detail-label">مهام الموظف</div>
                    <div class="detail-colon">:</div>
                    <div class="detail-value">@employeeTasksToShow</div>
                </div>

                <div class="detail-row">
                    <div class="detail-label">دولة الموظف</div>
                    <div class="detail-colon">:</div>
                    <div class="detail-value">@employeeCountryToShow</div>
                </div>

                <div class="detail-row">
                    <div class="detail-label">الهاتف</div>
                    <div class="detail-colon">:</div>
                    <div class="detail-value">@employeePhoneToShow</div>
                </div>


            </div>

        </div>

        @for (var pageIndex = 0; pageIndex < tablePagesCount; pageIndex++)
        {
            var pageRows = (Model.Rows ?? new List<lotus_blue.Controllers.AttendanceLogPdfRowViewModel>())
            .Skip(pageIndex * rowsPerPage)
            .Take(rowsPerPage)
            .ToList();

            <div class="table-page @(pageIndex > 0 ? "table-page-break" : "")">
                <table class="report-table" dir="rtl">
                    <thead>
                        <tr>
                            <th class="serial-cell">م</th>
                            <th class="date-cell">التاريخ</th>
                            <th class="time-cell">ساعات الدوام</th>
                            <th class="time-cell">وقت الدخول</th>
                            <th class="time-cell">وقت الخروج</th>
                            <th class="status-cell">حالة الحضور</th>
                            <th class="amount-cell">خصم اليوم</th>
                            <th class="amount-cell">إجمالي السلف حتى تاريخ السجل</th>
                            <th class="amount-cell">إجمالي المكافآت حتى تاريخ السجل</th>
                            <th class="reason-cell">سبب الخصم</th>
                        </tr>
                    </thead>

                    <tbody>
                        @for (var rowIndex = 0; rowIndex < pageRows.Count; rowIndex++)
                        {
                            var row = pageRows[rowIndex];
                            var serial = (pageIndex * rowsPerPage) + rowIndex + 1;

                            <tr>
                                <td>@serial</td>
                                <td>@row.Date</td>
                                <td>@row.ShiftHours</td>
                                <td>@row.CheckInTime</td>
                                <td>@row.CheckOutTime</td>
                                <td>@row.AttendanceStatus</td>
                                <td><span class="amount-pill deduction-value">@row.DeductionAmount.ToString("0.00")</span></td>
                                <td><span class="amount-pill advance-value">@row.AdvanceAmount.ToString("0.00")</span></td>
                                <td><span class="amount-pill bonus-value">@row.BonusAmount.ToString("0.00")</span></td>
                                <td class="reason-cell">@row.DeductionReason</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <div class="totals-row">
            <div class="total-deductions-box total-late">
                إجمالي التأخير الأساسي: @Model.TotalBasicLateTimeText
            </div>

            <div class="total-deductions-box total-error">
                إجمالي خصومات الأيام المحددة: @Model.TotalDeductions.ToString("0.00")
            </div>

            <div class="total-deductions-box total-advance">
                إجمالي السلف: @Model.TotalAdvances.ToString("0.00")
            </div>

            <div class="total-deductions-box total-bonus">
                إجمالي المكافآت: @Model.TotalBonuses.ToString("0.00")
            </div>
        </div>

    </div>
</body>
</html>
