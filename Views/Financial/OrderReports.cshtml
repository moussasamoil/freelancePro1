@model lotus_blue.Models.ViewModel.PaginationViewModel<lotus_blue.Models.ViewModel.OrderReportViewModel>

@{
    ViewData["Title"] = "فواتير شركات التوصيل ";
}


@if (User.IsInRole("Admin"))
{
    <div class="row d-flex justifiy-content-between">
       

        <div class="col-2">
            <select id="DeliveryCompanyId"  class="form-control drop-down-design" required>
            </select>
        </div>

        <div class="col-2">
            <select id="CountryId" name="Country" class="form-control  drop-down-design" required>
              
            </select>
        </div>
        <div class="col-2">
            <select id="ManufacturingCompanyId" class="form-control drop-down-design" required>

            </select>
        </div>

    </div>


    <div class="row mb-3 mt-3">
       



        <!-- Second column -->
        <div class="col d-flex align-items-center justify-content-end">
            <div class="form-group d-flex align-items-center">
                <label for="pageSize" class="me-2">أظهر:</label>
                <select id="pageSize" name="pageSize" class="form-control me-2">
                    <option value="10">10</option>
                    <option value="25">25</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                </select>
                <label for="pageSize">مدخلات</label>
            </div>
        </div>


    </div>
}

<table class="table">
    <thead>
        <tr>
            <th><input type="checkbox" id="select-all" /> Select All</th>
            <th>الحالة</th>
            <th>قيمة المبلغ</th>
            <th>التاريخ</th>
            <th>رقم الحساب</th>
            <th>الدولة</th>
            <th>شركة التوصيل</th>
            <th>المتجر</th>
            <th>تحميل</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var report in Model.Items)
        {
            <tr>
                <td><input type="checkbox" class="order-report-checkbox" data-id="@report.Id" /></td>
                <td>صادر</td>
                <td>@report.TotalAmount @report.Currency</td>
                <td>@report.GeneratedTime</td>
                <td>@report.Id</td>
                <td>@report.Country</td>
                <td>@report.DeliveryCompanyName</td>
                <td>@report.StoreName</td>
                <td>
                    <button onclick="window.open('@Url.Action("DownloadOrderReport", new { orderReportId = report.Id })', '_blank')" class="btn text-white btn-success">تحميل الفاتورة</button>
                </td>
            </tr>
        }
    </tbody>
</table>


<button id="generate-report" class="btn btn-primary">Generate Combined Report</button>




<div id="pagination-link" class="mt-0 container-fluid">
    <div class="d-flex justify-content-between align-items-center">

        <p class="text-start pt-2 total-items-display">@Model.TotalItems عدد الفواتير</p>

        <nav aria-label="Page navigation" class="mx-auto">
            <div class="d-flex justify-content-start">
                <ul class="pagination p-0">
                    <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link pointer" data-page="1">
                            <i class="fa-solid fa-chevron-double-right text-green"></i>
                        </a>
                    </li>
                    <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link" data-page="@(Model.CurrentPage - 1)">
                            <i class="fa-solid fa-chevron-right text-green"></i>
                        </a>
                    </li>

                    @{
                        int startPage = Model.CurrentPage;
                        int endPage = startPage + 2;
                        if (endPage > Model.TotalPages)
                        {
                            endPage = Model.TotalPages;
                        }
                    }

                    @for (int i = startPage; i <= endPage; i++)
                    {
                        <li class="numbers page-item @(Model.CurrentPage == i ? "active" : "")">
                            <a class="page-link" data-page="@i">@i</a>
                        </li>
                    }

                    @if (Model.TotalPages > endPage)
                    {
                        <li class="page-item disabled">
                            <span class="page-link">...</span>
                        </li>

                        @for (int i = Model.TotalPages - 2; i <= Model.TotalPages; i++)
                        {
                            <li class="numbers page-item @(Model.CurrentPage == i ? "active" : "")">
                                <a class="page-link" data-page="@i">@i</a>
                            </li>
                        }
                    }



                    <li class="page-item @(Model.CurrentPage ==  Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" data-page="@(Model.CurrentPage + 1)">
                            <i class="fa-solid fa-chevron-left text-green f-s-18"></i>
                        </a>
                    </li>
                    <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" data-page="@(Model.TotalPages)">
                            <i class="fa-solid fa-chevron-double-left text-green"></i>
                        </a>
                    </li>


                </ul>
            </div>
        </nav>


    </div>
</div>


<script>
  
    $('#pagination-link').on('click', '.page-link', function (e) {
        e.preventDefault(); // Prevent the default link behavior
        var page = $(this).data('page'); // Get the page number from the data-page attribute of the clicked link
        FetchOrderReports(page); // Pass the page number to the FetchOrderReports function
    });

    

    function FetchOrderReports(page) {
        var deliveryCompanyId = $('#DeliveryCompanyId').val(); // Get the selected delivery company id
        var pageSize = $('#pageSize').val(); // Get the selected page size

   

        // Get the selected start and end dates

        var country = $('#CountryId').val();
        var storeId = $('#ManufacturingCompanyId').val();

        $.ajax({
            url: '@Url.Action("OrderReports", "financial")', // Make sure this points to the correct controller and action
            type: 'GET',
            data: {
                page: page,
                pagesize: pageSize,
                deliveryCompanyIdFilter: deliveryCompanyId,
                startDay: startDate.format('YYYY-MM-DD'),
                endDay: endDate.format('YYYY-MM-DD'),
                countryId: country,
                storeId: storeId

            },
            success: function (result) {
                // Update the HTML of the table and pagination controls
                const newTable = $(result).find('.table').html();
                $('.table').html(newTable);
                const newPagination = $(result).find('.pagination').html();
                $('.pagination').html(newPagination);
                const TotalItems = $(result).find('.total-items-display').html();
                $('.total-items-display').html(TotalItems);

            },
            error: function (xhr, status, error) {
                console.error("An error occurred: " + status + ", " + error);
            }
        });
    }

    


    $(document).ready(function () {
     
     

        // Bind change event to the Country select
        $('#ManufacturingCompanyId,#CountryId,#pageSize,#DeliveryCompanyId').change(function () {
            FetchOrderReports(); // Fetch data with updated filters
        });

    
    });


    $(document).ready(function () {
        // Select all checkboxes logic
        document.getElementById('select-all').addEventListener('change', function () {
            var checkboxes = document.querySelectorAll('.order-report-checkbox');
            for (var checkbox of checkboxes) {
                checkbox.checked = this.checked;
            }
        });

        // Handle generate combined report button click
        document.getElementById('generate-report').addEventListener('click', function () {
            var selectedReportIds = [];
            var checkboxes = document.querySelectorAll('.order-report-checkbox:checked');
            for (var checkbox of checkboxes) {
                selectedReportIds.push(checkbox.getAttribute('data-id'));
            }

            if (selectedReportIds.length === 0) {
                alert('Please select at least one report.');
                return;
            }

            // Send selected order report IDs to the backend
            fetch('/financial/GenerateCombinedReport', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() // for ASP.NET Core CSRF
                },
                body: JSON.stringify(selectedReportIds)
            })
                .then(response => response.blob())
                .then(blob => {
                    var url = window.URL.createObjectURL(blob);
                    window.open(url, '_blank');  // Open the generated PDF in a new tab
                })
                .catch(error => console.error('Error generating report:', error));
        });
    });


</script>