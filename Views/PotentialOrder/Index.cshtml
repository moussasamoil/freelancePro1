<input type="hidden" id="startDate" />
<input type="hidden" id="endDate" />

<script>
    $(document).ready(function () {

        initializeLitepicker('#po-datepicker', function () { loadData(1); });

        // Open PO creation form
        $('#openCreatePotential').click(function () {
            $.ajax({
                url: '/Home/CreatePotentialClient',
                type: 'GET',
                success: function (data) {
                    $('#modal-container').html(data);
                    $('#CreatePotential').modal('show');
                },
                error: function (xhr, status, error) {
                    console.error('AJAX Error: ' + status + ' - ' + error);
                }
            });
        });

        localStorage.removeItem('selectedPotentialOrderIds');

        function getSelectedIds() {
            return JSON.parse(localStorage.getItem('selectedPotentialOrderIds')) || [];
        }

        function setSelectedIds(ids) {
            localStorage.setItem('selectedPotentialOrderIds', JSON.stringify(ids));
        }

        // Show/hide upgrade button based on selection
        function toggleUpgradeButton() {
            var selected = getSelectedIds();
            if (selected.length > 0) {
                var hasUpgradeableRows = false;
                $('input[name="selectedPotentialOrders"]:checked').each(function () {
                    if ($(this).data('status') < 7) {
                        hasUpgradeableRows = true;
                        return false;
                    }
                });
                if (hasUpgradeableRows) {
                    $('.status-upgrade').show();
                } else {
                    $('.status-upgrade').hide();
                }
            } else {
                $('.status-upgrade').hide();
            }
        }

        // Handle individual checkbox clicks
        $(document).on('change', 'input[type="checkbox"][name="selectedPotentialOrders"]', function () {
            var storedIds = getSelectedIds();
            var id = $(this).val();

            if ($(this).is(':checked')) {
                if (!storedIds.includes(id)) {
                    storedIds.push(id);
                }
            } else {
                var index = storedIds.indexOf(id);
                if (index > -1) {
                    storedIds.splice(index, 1);
                }
            }

            setSelectedIds(storedIds);
            $('#selectAll').prop('checked', $('input[type="checkbox"][name="selectedPotentialOrders"]').length === $('input[type="checkbox"][name="selectedPotentialOrders"]:checked').length);
            toggleUpgradeButton();
        });

        // Handle "Select All"
        $(document).on('change', '#selectAll', function () {
            var isChecked = $(this).is(':checked');
            var storedIds = getSelectedIds();

            $('input[type="checkbox"][name="selectedPotentialOrders"]').each(function () {
                var id = $(this).val();
                $(this).prop('checked', isChecked);

                if (isChecked) {
                    if (!storedIds.includes(id)) {
                        storedIds.push(id);
                    }
                } else {
                    var index = storedIds.indexOf(id);
                    if (index > -1) {
                        storedIds.splice(index, 1);
                    }
                }
            });

            setSelectedIds(storedIds);
            toggleUpgradeButton();
        });

        // Restore selected checkboxes
        function restoreSelectedIds() {
            var storedIds = getSelectedIds();
            $('input[type="checkbox"][name="selectedPotentialOrders"]').each(function () {
                if (storedIds.includes($(this).val())) {
                    $(this).prop('checked', true);
                }
            });
            $('#selectAll').prop('checked', $('input[type="checkbox"][name="selectedPotentialOrders"]').length === $('input[type="checkbox"][name="selectedPotentialOrders"]:checked').length);
            toggleUpgradeButton();
        }

        restoreSelectedIds();

        // Handle upgrade button click
        $('.status-upgrade').click(function () {
            var $btn = $(this);
            var selectedIds = getSelectedIds();

            if (selectedIds.length === 0) {
                showNotification(
                    "الرجاء تحديد طلب واحد على الأقل",
                    null,
                    '/static/info-icon.svg'
                );
                return;
            }

            $btn.prop('disabled', true).addClass('disabled');

            showNotification(
                "هل تريد ترقية حالة الطلبات المحددة؟",
                function () {
                    $('#loadingIndicator').show();

                    $.ajax({
                        url: '@Url.Action("UpdateStatusForMultiple", "PotentialOrder")',
                        type: 'POST',
                        data: { ids: selectedIds },
                        success: function (result) {
                            if (result.success) {
                                localStorage.removeItem('selectedPotentialOrderIds');
                                showNotification(
                                    "تم تحديث حالة الطلبات بنجاح",
                                    function () {
                                        location.reload();
                                    },
                                    '/static/trash-can-regular.svg'
                                );
                            } else {
                                $btn.prop('disabled', false).removeClass('disabled');
                                showNotification(
                                    "خطأ: " + (result.message || "فشل في تعديل حالة الطلبات"),
                                    null,
                                    '/static/trash-can-regular.svg'
                                );
                            }
                        },
                        error: function (xhr, status, error) {
                            $btn.prop('disabled', false).removeClass('disabled');
                            showNotification(
                                "خطأ في الاتصال: " + error,
                                null,
                                '/static/trash-can-regular.svg'
                            );
                        },
                        complete: function () {
                            $('#loadingIndicator').hide();
                        }
                    });
                },
                '/static/trash-can-regular.svg'
            );
        });

        // Search
        const searchInput = $("#searchInput");
        const clearSearchIcon = $("#searchingshow");

        function toggleClearIconVisibility() {
            clearSearchIcon.css('visibility', searchInput.val().length > 0 ? 'visible' : 'hidden');
        }

        searchInput.on("input", function () {
            toggleClearIconVisibility();
            loadData(1);
        });

        clearSearchIcon.on("click", function () {
            searchInput.val("");
            toggleClearIconVisibility();
            loadData(1);
        });

        toggleClearIconVisibility();

        // Filters
        $('#StatusId, #CountryId, #StoreNameId, #OrderSourceId, #EmployeeId, #pageSize').change(function () {
            loadData(1);
        });

        function loadData(page) {
            var data = {
                page: page,
                pageSize: $('#pageSize').val(),
                search: $('#searchInput').val(),
                countryId: $('#CountryId').val(),
                statusId: $('#StatusId').val(),
                storeId: $('#StoreNameId').val(),
                orderSourceId: $('#OrderSourceId').val(),
                employeeId: $('#EmployeeId').val(),
                startDate: $('#startDate').val(),
                endDate: $('#endDate').val()
            };

            $.ajax({
                url: '/PotentialOrder/Index',
                type: 'GET',
                data: data,
                success: function (result) {
                    var $result = $('<div>').html(result);
                    $('.table').replaceWith($result.find('.table'));
                    $('.pagination').replaceWith($result.find('.pagination'));
                    $('.total-items-display').text($result.find('.total-items-display').text());
                    restoreSelectedIds();
                },
                error: function (xhr, status, error) {
                    console.error("AJAX error:", status, error);
                }
            });
        }

        $(document).on('click', '.pagination a.page-link', function (event) {
            event.preventDefault();
            const page = $(this).data('page');
            loadData(page);
        });

    });

    // Mirror of isAdmin check in the Razor @@if blocks above — needed so the JS row builder
    // can conditionally include/exclude the employee column, matching the server-rendered rows.
    var isAdminOrExecutiveDirector = @Html.Raw(Json.Serialize(User.IsInRole("Admin") || User.IsInRole("ExecutiveDirector")));

    // Builds and prepends a table row from a SignalR NotifyPotentialOrderAdded payload.
    // This mirrors what the Razor foreach does on page load, so new POs appear instantly
    // without a reload — same pattern as addOrderToTable() on the Home page.
    function addPotentialOrderToTable(potentialOrderJson) {
        const obj = JSON.parse(potentialOrderJson);
        const po = obj.PotentialOrder;
        const employeeName = obj.EmployeeName || '';
        const employeeImage = obj.EmployeeImage || '';

        // Build WhatsApp link — same logic as the Razor poWhatsAppUrl block above.
        // Phone code prefix is handled server-side by GetPhoneNumberCodeByCountryStatus;
        // the payload already stores the raw phone number, so we just link to wa.me/.
        const whatsAppUrl = po.PhoneNumber ? 'https://wa.me/' + po.PhoneNumber : '';

        // Messaging buttons: match the <td class="مراسلة"> column logic exactly
        let messagingButtons = '';
        if (po.ChatUrl && po.OrderSource === 'انستغرام') {
            messagingButtons += `<a target="_blank" href="${po.ChatUrl}" class="btn text-white me-2 text-nowrap instagram-btn"><span><i class="fa-brands fa-instagram"></i></span> انستغرام</a>`;
        } else if (po.ChatUrl) {
            messagingButtons += `<a target="_blank" href="${po.ChatUrl}" class="btn text-white background-whiteblue me-2 text-nowrap"><span><i class="fa-light fa-comment"></i></span> فيسبوك</a>`;
        }
        if (po.PhoneNumber) {
            messagingButtons += `<a target="_blank" href="${whatsAppUrl}" class="btn text-white me-2 text-nowrap" style="background-color:#2ab149;"><span><i class="fa-light fa-comment"></i></span> واتساب</a>`;
        }

        // Employee column is only shown for Admin / ExecutiveDirector — matches the @@if above the th
        const employeeCell = isAdminOrExecutiveDirector
            ? `<td class="text-nowrap d-none d-xl-table-cell text-end">${employeeImage ? `<img src="/${employeeImage}" width="14" class="b-r-50">` : ''} ${employeeName}</td>`
            : '';

        const storeLogoImg = po.StoreLogoUrl ? `<img loading="lazy" class="pb-1 icon-size-standard" src="/${po.StoreLogoUrl}" />` : '';

        // data-status="6" = عميل_محتمل (int value of the enum) — needed by toggleUpgradeButton()
        const newRow = `
                <tr class="background-white-green">
                    <td><input type="checkbox" name="selectedPotentialOrders" value="${po.Id}" data-status="6" class="potential-order-checkbox" /></td>
                    <td class="text-green text-nowrap"><i class="fa-solid f-s-14 text-green fa-cube me-1"></i> ${po.Id}</td>
                    ${employeeCell}
                    <td class="text-nowrap">${po.CustomerName}</td>
                    <td class="d-none d-md-table-cell">${po.CreatedDate}</td>
                    <td class="text-end d-none d-md-table-cell text-nowrap">
                        <img loading="lazy" class="pb-1 icon-size-standard" src="${po.CountryImageUrl}" /> ${po.Country}
                    </td>
                    <td class="text-end d-none d-md-table-cell text-nowrap">
                        ${storeLogoImg} ${po.StoreName}
                    </td>
                    <td class="text-end d-none d-md-table-cell text-nowrap">
                        <img loading="lazy" class="pb-1" style="width:16px; height:16px;" src="${po.OrderSourceIconUrl}" /> ${po.OrderSource}
                    </td>
                    <td class="d-none d-md-table-cell text-nowrap"><span class="po-status-badge po-status-${po.StatusInt}">${po.Status}</span></td>
                    <td class="d-none d-md-table-cell text-nowrap">${po.LastEditedDate}</td>
                    <td class="d-none d-md-table-cell"><div class="d-flex justify-content-center">${messagingButtons}</div></td>
                </tr>`;

        document.querySelector('table tbody').insertAdjacentHTML('afterbegin', newRow);
    }

    // SignalRRealTime.js already listens for NotifyPotentialOrderAdded (plays audio + browser notification).
    // This second handler adds the DOM injection — only fires on the PO index page so it doesn't
    // try to call addPotentialOrderToTable on pages that don't have the table.
    if (typeof connection !== 'undefined') {
        connection.on("NotifyPotentialOrderAdded", function (potentialOrderJson) {
            if (window.location.pathname.toLowerCase().includes('/potentialorder')) {
                addPotentialOrderToTable(potentialOrderJson);
            }
        });
    }
</script>
