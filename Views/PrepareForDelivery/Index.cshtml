@* Main page wrapper: full-width on small screens, fluid container with top padding and "page" class *@
<div class="w-sm-100 mt-3 mt-md-3 container-fluid px-3 pt-3 page">
    <!-- Orange banner -->
    <div class="banner">تنفيذ من العمليات المحفوظة</div>

    <!-- Hide-order section -->
    <div id="hideOrderContainer" class="hide-order-container mt-2" style="display:none;">
        <div class="toggle-order-hide">
            <div id="hideOrderToggle" class="toggle-btn"></div>
            <p class="toggle-text">
                أريد إخفاء معلومات الطلب<br>
                التابع لكود شحنة رقم <span id="hideOrderCode">-</span> التابع لدولة <span id="hideOrderCountry">-</span>
            </p>
        </div>
        <p class="hide-order-note">
            عند إخفاء الطلب سيتم إخفاؤه من الواجهة وإعادة الطلب عند الإنتهاء من جميع باقي الطلبات.
        </p>
    </div>

    <!-- ═══════════ ROW 1: Filters ═══════════
         Dropdowns for Country, Store, Delivery Company + a search input.
         All changes trigger loadFilteredQueue() via JS to refresh the order queue below. -->
    <div class="filters mt-2">
        <div class="filter-row">
            <div id="pfd-add-order-btn" class="text-nowrap open custom-inpage-dropdown d-flex justify-content-start align-items-center" style="cursor:pointer;flex: 1;">
                <img src="/mainicons/file-circle-plus-regular.svg" width="25" height="25" />
                <span class="pe-2 flex-grow-1">إضافة طلب جديد</span>
                <i class="fa-duotone ps-0 fa-chevron-down"></i>
            </div>
            <select id="CountryId" name="Country" class="form-control drop-down-design filter-btn">
            </select>
            <select id="StoreNameId" name="StoreName" class="form-control drop-down-design filter-btn">
            </select>
            <select id="DeliveryCompanyId" name="DeliveryCompany" class="form-control drop-down-design filter-btn">
            </select>
            @if (User.IsInRole("Admin") || User.IsInRole("FollowUpDepartment") || User.IsInRole("ExecutiveDirector"))
            {
                <select id="EmployeeId" name="Employee" class="form-control drop-down-design filter-btn">
                </select>
            }
        </div>
        <div class="d-flex align-items-center gap-2 search-container">
            <div class="input-group custom-width-search-input input_with_icon">
                <input type="text" id="searchInput" name="search" class="pe-5 text-dark custom-box-shadow Search search-input" placeholder="ابحث عن الشحنات...">
                <span class="icon search-icon">
                    <img src="/mainicons/search.svg" alt="search" width="20" height="20" />
                </span>
                <span class="cancel-search-btn round hidden">
                    <img src="/mainicons/cancel search.svg" alt="cancel" width="6" height="6" style="display:block;" />
                </span>
            </div>
            <span class="search-cancel">إلغاء</span>
        </div>
    </div>

    <!-- ═══════════ ROW 2: Order Queue ═══════════
     Horizontal strip of SVG order cards. First card = active.
     Clicking the row calls onQueueRowClick() to load the top order. -->
    <div class="remaining-orders">
        <div class="remaining-orders-title" id="remainingOrdersTitle">
            باقي الطلبات @initialRemainingDownloadCount
        </div>
        <div id="orderQueueRow" class="order-cards-row" onclick="onQueueRowClick()">
            @if (Model.OrderQueue != null && Model.OrderQueue.Any())
            {
                @for (int i = 0; i < Model.OrderQueue.Count; i++)
                {
                    var isActive = i == 0;
                    <div class="order-card@(Model.OrderQueue[i].IsDelayed ? " is-delayed" : "")" data-order-id="@Model.OrderQueue[i].Id" data-is-delayed="@(Model.OrderQueue[i].IsDelayed ? "true" : "false")">
                        <img src="/mainicons/@(isActive ? "active order card" : "order card").svg" alt="@(isActive ? "active order" : "order")" />
                    </div>
                }
            }
        </div>
        <div class="order-cards-skeleton-row">
            <div class="skeleton-card"></div>
            <div class="skeleton-card"></div>
            <div class="skeleton-card"></div>
            <div class="skeleton-card"></div>
            <div class="skeleton-card"></div>
        </div>
    </div>



    <!-- ═══════════ NEW DESIGN: Main 3-column content ═══════════ -->
    <div id="pfd-new-design" class="main-content">

        <!-- Column 1: Order Details -->
        <div class="panel order-details">
            <div class="panel-header">معلومات الطلب</div>

            <!-- Employee photo + order creation date (absolutely positioned in panel body) -->
            <div id="nd-employee-block" class="nd-employee-block" style="display:none;">
                <img id="nd-employee-photo" class="nd-employee-photo b-r-50" src="" alt="" />
                <div id="nd-created-date" class="nd-created-date"></div>
            </div>
            <div id="nd-employee-name" class="nd-employee-name" style="display:none;"></div>

            <!-- "تم التنزيل" overlay (shown in preview mode) -->
            <div id="nd-downloaded-label" class="downloaded-label" style="display:none;">تم التنزيل</div>

            <!-- Cancel X button -->
            <button class="cancel-x-btn" style="top:60px;" aria-label="إلغاء">
                <img class="cancel-default" src="/mainicons/hide order.svg" alt="close" width="13" height="13" />
                <img class="cancel-hover" src="/mainicons/hide order hover.svg" alt="close" width="13" height="13" />
            </button>

            <!-- Premium badge (hidden until data loads) -->
            <div id="nd-premium-badge" class="premium-logo hidden" style="display:none;">
                <img src="/mainicons/Premium Order Logo.svg" alt="premium" width="46" height="41" />
            </div>

            <!-- Skeleton for header -->
            <div id="nd-col1-skeleton-header" class="sk-details-header">
                <div class="sk-block sk-h2"></div>
                <div class="sk-block sk-subline"></div>
                <div class="sk-block sk-badge-lg"></div>
            </div>
            <!-- Real header (hidden until loaded) -->
            <div id="nd-col1-header" class="details-header" style="display:none;"></div>

            <!-- Skeleton for detail rows -->
            <div id="nd-col1-skeleton-table" class="details-table">
                <div class="sk-block sk-label"></div><div class="sk-block sk-value wide"></div>
                <div class="sk-block sk-label"></div><div class="sk-block sk-value med"></div>
                <div class="sk-block sk-label"></div><div class="sk-block sk-value med"></div>
                <div class="sk-block sk-label"></div><div class="sk-block sk-value med"></div>
                <div class="sk-block sk-label"></div><div class="sk-block sk-value med"></div>
                <div class="sk-block sk-label"></div><div class="sk-block sk-value full"></div>
                <div class="sk-block sk-label"></div><div class="sk-block sk-value wide"></div>
                <div class="sk-block sk-label"></div><div class="sk-block sk-badge-lg" style="border-radius:800px;margin:4px 20px;"></div>
                <div class="sk-block sk-label"></div><div class="sk-block sk-badge-lg" style="border-radius:800px;margin:4px 20px;"></div>
                <div class="sk-block sk-label"></div><div class="sk-block sk-mini-table"></div>
                <div class="sk-block sk-label"></div><div class="sk-block sk-value med"></div>
            </div>
            <!-- Real detail rows (hidden until loaded) -->
            <div id="nd-col1-table" class="details-table" style="display:none;"></div>
        </div>

        <!-- Column 2: Products -->
        <div class="panel products-panel">
            <div class="panel-header">المنتجات</div>

            <!-- Skeleton gallery -->
            <div id="nd-col2-skeleton" class="products-gallery">
                <div class="sk-product-card"><div class="sk-block sk-product-img"></div><div class="sk-block sk-product-name"></div><div class="sk-block sk-product-qty"></div></div>
                <div class="sk-product-card"><div class="sk-block sk-product-img"></div><div class="sk-block sk-product-name"></div><div class="sk-block sk-product-qty"></div></div>
                <div class="sk-product-card"><div class="sk-block sk-product-img"></div><div class="sk-block sk-product-name"></div><div class="sk-block sk-product-qty"></div></div>
                <div class="sk-product-card"><div class="sk-block sk-product-img"></div><div class="sk-block sk-product-name"></div><div class="sk-block sk-product-qty"></div></div>
                <div class="sk-product-card"><div class="sk-block sk-product-img"></div><div class="sk-block sk-product-name"></div><div class="sk-block sk-product-qty"></div></div>
                <div class="sk-product-card"><div class="sk-block sk-product-img"></div><div class="sk-block sk-product-name"></div><div class="sk-block sk-product-qty"></div></div>
            </div>
            <!-- Real gallery (hidden until loaded) -->
            <div id="nd-col2-gallery" class="products-gallery" style="display:none;"></div>

            <!-- Skeleton status -->
            <div id="nd-col2-skeleton-status" class="order-status-section">
                <div class="sk-block sk-status-label"></div>
                <div class="sk-block sk-status-badge"></div>
            </div>
            <!-- Real status (hidden until loaded) -->
            <div id="nd-col2-status" class="order-status-section" style="display:none;"></div>

            <div class="submit-section">
                <button id="nd-submit-btn" class="btn-confirm" disabled>
                    تأكيد إدخال الطلب
                    <img src="/mainicons/submit.svg" alt="confirm" />
                </button>
            </div>
        </div>

        <!-- Column 3: Shipments -->
        <div class="panel shipments-panel">
            <div class="col3-inner">
                <div class="panel-header">الشحنات</div>

                <div id="nd-col3-list" class="delivery-codes-container">
                    @if (Model.RecentlySubmittedOrders != null && Model.RecentlySubmittedOrders.Any())
                    {
                        @foreach (var submitted in Model.RecentlySubmittedOrders)
                        {
                            <div class="delivery-section" data-order-id="@submitted.Id" style="cursor:pointer;">
                                <div class="delivery-row">
                                    <div class="delivery-time-wrap"><div class="delivery-time">@submitted.LastEditedDate?.ToString("HH:mm")</div></div>
                                    <div class="delivery-info">
                                        <div class="copy-icon-btn" onclick="event.stopPropagation(); copyToClipboard('@submitted.Id', 'كود الشحنة')"><img src="/mainicons/copy icon.svg" alt="copy" /></div>
                                        <span class="delivery-code-num">@submitted.Id</span>
                                        <img class="delivery-flag" src="@Common.GetImageUrlByCountryName(submitted.Country.ToString())" alt="flag" />
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="empty-state-body" style="padding:16px 0;">
                            <img class="empty-exclamation" src="/mainicons/exclamation mark.svg" alt="" />
                            <p class="empty-state-text">لا توجد شحنات مدخلة خلال الـ24 ساعة الماضية..</p>
                        </div>
                    }
                </div>

                <div id="nd-col3-return-wrap" class="return-btn-wrap" style="display:none;">
                    <button id="nd-col3-return-btn" class="btn-return" disabled>
                        الطلب السابق
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="white"><path d="M19 7v4H5.83l3.58-3.59L8 6l-6 6 6 6 1.41-1.41L5.83 13H21V7h-2z" /></svg>
                    </button>
                </div>
            </div>
        </div>

    </div><!-- /main-content -->

</div>
