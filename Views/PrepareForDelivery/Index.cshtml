    // ── Render queue cards ──
    function renderQueueCards(orders, remainingDownloadsCount) {
    var $row = $('#orderQueueRow');
    var count = (typeof remainingDownloadsCount !== 'undefined' && remainingDownloadsCount !== null)
    ? remainingDownloadsCount
    : (orders ? orders.length : 0);
    $('#remainingOrdersTitle').text('باقي الطلبات ' + count);
    updatePfdDownloadBadge(count);
    if (!orders || orders.length === 0) {
    $row.empty();
    ndHideRow2Skeleton();
    return;
    }
    var html = '';
    orders.forEach(function (o, i) {
    var svg = i === 0 ? 'active order card' : 'order card';
    var alt = i === 0 ? 'active order' : 'order';
    var delayedClass = o.isDelayed ? ' is-delayed' : '';
    html += '<div class="order-card' + delayedClass + '" data-order-id="' + o.id + '" data-is-delayed="' + (o.isDelayed ? 'true' : 'false') + '">' +
    '<img src="/mainicons/' + svg + '.svg" alt="' + alt + '" /></div>';
    });
    $row.html(html);
    ndHideRow2Skeleton();
    }
    // ── Add submitted order to col3 ──
    function addToRecentlySubmitted(submittedOrder) {
    var timeStr = submittedOrder.time;
    if (!timeStr) {
