<!-- ═══════════ SCRIPTS ═══════════
     All client-side logic for this page. Sections inside:
     - copyToClipboard()       Toast + clipboard helper
     - onQueueRowClick()       Loads the top queue order on row click
     - loadOrderData()         AJAX fetch of a single order's details/products
     - renderOrderDetail()     Rebuilds the Col1 HTML from fetched order data
     - renderProducts()        Rebuilds the Col2 products grid
     - updateSubmitButton()    Enables/disables confirm button based on order status
     - Filter handlers         Country/Store/DeliveryCompany dropdowns + search debounce
     - Submitted row click     Col3 click → preview mode (loads order without enabling submit)
     - Submit button click     POSTs to /PrepareForDelivery/SubmitOrder, updates queue + Col3
     - loadDefaultQueue()      Fetches unfiltered طلب_جديد queue from server
     - loadFilteredQueue()     Fetches queue filtered by current dropdown/search values
     - renderQueueCards()      Rebuilds Row 2 queue strip from fetched order list
     - addToRecentlySubmitted() Prepends a new row to Col3 after a successful submit
     - countryImageMap         Razor-generated JS map of country name → flag image URL
     - escapeHtml/escapeQuotes Sanitization helpers for dynamic HTML injection -->
<script src="/js/toastify-js.js"></script>
<script>
    var pfdCountriesUrl = '/DataList/GetPfdCountries';

    @if (User.IsInRole("CallCenter"))
    {
        <text>
            // Hide delivery company id 77 (Amyal) from the PFD filter dropdown for CallCenter users —
            // backend also filters its orders out for this role.
            $(document).ajaxComplete(function (event, xhr, settings) {
            if (settings && settings.url && settings.url.indexOf('/DataList/GetAllDeliveryCompanies') !== -1) {
            $('#DeliveryCompanyId option[value="@lotus_blue.Controllers.PrepareForDeliveryController.CallCenterHiddenDeliveryCompanyId"]').remove();
            }
            });
        </text>
    }

    var currentOrderId = @(Model.CurrentOrder?.Id ?? 0);
    var currentCountryId = 0;
    var isPreviewMode = false;
    var pfdRemainingDownloadsCount = @initialRemainingDownloadCount;

    function updatePfdDownloadBadge(count) {
    var safeCount = parseInt(count, 10);
    if (isNaN(safeCount) || safeCount < 0) {
    safeCount = 0;
    }

    pfdRemainingDownloadsCount = safeCount;

    var $badges = $('#pfdRemainingDownloadsBadge, .pfd-remaining-download-count, [data-pfd-remaining-download-count]');
    if (!$badges.length) return;

