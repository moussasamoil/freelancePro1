    // Returns { warehouse, route }
    function getLibyaCityInfo(city) {
    if (!city) return { warehouse: 'مخزن سوق الجمعه', route: null };
    var entry = libyaCityMap[city.trim()];
    if (!entry) return { warehouse: 'مخزن سوق الجمعه', route: null };
    return {
    warehouse: entry.warehouse,
    route: entry.route
    };
    }
    // Legacy helper kept for any remaining callers
    function getLibyaWarehouse(city) {
    return getLibyaCityInfo(city).warehouse;
    }

    // ═══════════ NEW DESIGN: skeleton ↔ data swap ═══════════

    // Show col3 loading skeleton
    function ndShowCol3Loading() {
    var skHtml = '';
    for (var i = 0; i < 5; i++) {
    skHtml += '<div class="delivery-section" style="pointer-events:none;opacity:0.5;">' +
    '<div class="delivery-row">' +
    '<div class="delivery-time-wrap"><span class="delivery-time"><span class="sk-block" style="width:36px;height:14px;display:inline-block;background:#e0e0e0;border-radius:4px;"></span></span></div>' +
    '<div class="delivery-info">' +
    '<span class="sk-block" style="width:50px;height:14px;display:inline-block;background:#e0e0e0;border-radius:4px;"></span>' +
    '<span class="sk-block" style="width:34px;height:34px;display:inline-block;background:#e0e0e0;border-radius:50%;"></span>' +
    '</div>' +
    '</div>' +
    '</div>';
    }
    $('#nd-col3-list').html(skHtml);
    $('#recentlySubmittedList').html('<div class="text-center text-muted py-3">جارٍ البحث...</div>');
    }

    // Show all skeletons, hide all real containers
    function ndShowSkeletons() {
    $('#nd-col1-skeleton-header, #nd-col1-skeleton-table').show();
    $('#nd-col1-header, #nd-col1-table').hide();
    $('#nd-premium-badge').hide();
    $('#nd-employee-block').hide();
    $('#nd-col2-skeleton, #nd-col2-skeleton-status').show();
    $('#nd-col2-gallery, #nd-col2-status').hide();
    $('#nd-submit-btn').prop('disabled', true);
    // Row2: show skeleton, hide real queue
    $('.order-cards-skeleton-row').show();
    $('#orderQueueRow').hide();
    // Col3 is Razor-rendered, no skeleton swap needed
    }
    // Hide row2 skeleton, show real queue
    function ndHideRow2Skeleton() {
    $('.order-cards-skeleton-row').hide();
    $('#orderQueueRow').show();
    }

    // Render col1 and col2 with real data, hiding skeletons (col3 is Razor-rendered)
    function ndRenderOrder(order, products) {
    ndRenderCol1(order, products);
    ndRenderCol2(order, products);
    }

    // ── Col 1: Order Details ──
    function ndRenderCol1(order, products) {
    var countryImgUrl = getCountryImageUrl(order.countryId);

    // Header
    var headerHtml =
    '<h2>تفاصيل الطلب</h2>' +
    '<div class="detail-value copiable" data-copy-text="' + escapeAttr(order.manufacturingCompanyName || '') + '" data-copy-label="اسم المتجر">' +
    '<span>' + escapeHtml(order.manufacturingCompanyName || '') + '</span>' +
    (order.manufacturingCompanyLogo ? '<img class="flag" src="/' + order.manufacturingCompanyLogo + '" alt="" />' : '') +
    '</div>' +
    (order.countryId === @((int)Countries.ليبيا) ? (function() {
    var info = getLibyaCityInfo(order.state);
    var row1 = '<div style="display:flex;column-gap:8px;align-items:center;flex-wrap:wrap;margin-bottom:6px;">' +
    '<span class="warehouse-tag copiable" data-copy-text="' + escapeAttr(info.warehouse) + '" data-copy-label="المخزن">' + escapeHtml(info.warehouse) + '</span>' +
    '</div>';
    var row2 = '';
    if (info.route) {
    var parts = info.route.split(' المنطقة ');
    var laneDisplay = parts[0];
    var locationRest = parts.length > 1 ? parts.slice(1).join(' المنطقة ') : '';
    var locationDisplay = locationRest ? 'المنطقة ' + locationRest : '';
    var laneCopy = laneDisplay.replace(/^مسار\s+/, '');
    var locationCopy = locationRest;
    row2 = '<div style="display:flex;column-gap:8px;align-items:center;flex-wrap:wrap;">' +
    '<span class="warehouse-tag route-string copiable" data-copy-text="' + escapeAttr(laneCopy) + '" data-copy-label="المسار">' + escapeHtml(laneDisplay) + '</span>' +
    (locationDisplay ? '<span class="warehouse-tag route-string copiable" data-copy-text="' + escapeAttr(locationCopy) + '" data-copy-label="المنطقة">' + escapeHtml(locationDisplay) + '</span>' : '') +
    '</div>';
    }
    return row1 + row2;
    })() : '') +
    (order.fixedOrderTimes > 0 ?
    '<div class="d-flex align-items-center gap-1">' +
    '<div style="padding-left:42px;padding-right:42px;background-color:#45bbea;" class="me-1 rounded-pill h5 fw-bold text-center py-1 border-0 text-white mb-0">تم المعالجة</div>' +
    '<div style="padding-left:12px;padding-right:12px;background-color:#45bbea;" class="me-1 rounded-pill h5 fw-bold text-center py-1 border-0 text-white mb-0">' + order.fixedOrderTimes + '</div>' +
    '</div>'
    : '');
    $('#nd-col1-header').html(headerHtml);
    $('#nd-downloaded-label').toggle(isPreviewMode);

    // Detail table
    var isPaidLabel = order.isPaid ? 'تم التحويل حوالة بنكية' : 'غير مدفوع';
    var tableHtml =
    '<div class="detail-header">اسم الدولة</div>' +
    '<div class="detail-value copiable" data-copy-text="' + escapeAttr(order.country) + '" data-copy-label="الدولة">' +
    '<span>' + escapeHtml(order.country) + '</span>' +
    (countryImgUrl ? '<img class="flag" src="' + countryImgUrl + '" alt="flag" />' : '') +
    '</div>' +

    '<div class="detail-header">شركة التوصيل</div>' +
    '<div class="detail-value copiable" data-copy-text="' + escapeAttr(order.deliveryCompanyName || '') + '" data-copy-label="شركة التوصيل">' +
    '<span>' + escapeHtml(order.deliveryCompanyName || '') + '</span>' +
    '<img class="flag" src="/' + (order.deliveryCompanyLogo || 'static/DefaultImage.svg') + '" alt="" />' +
    '</div>' +

    '<div class="detail-header">اسم العميل</div>' +
    '<div class="detail-value copiable" data-copy-text="' + escapeAttr(order.customerName || '') + '" data-copy-label="اسم العميل"><span>' + escapeHtml(order.customerName || '') + '</span></div>' +

    '<div class="detail-header">المدينة</div>' +
    '<div class="detail-value copiable" data-copy-text="' + escapeAttr(order.state || '') + '" data-copy-label="المدينة"><span>' + escapeHtml(order.state || '') + '</span></div>' +

    '<div class="detail-header">العنوان</div>' +
    '<div class="detail-value copiable" data-copy-text="' + escapeAttr(order.address || '') + '" data-copy-label="العنوان" style="font-size:18px;"><span style="text-align:right;">' + escapeHtml(order.address || '') + '</span></div>' +

    '<div class="detail-header">رقم الهاتف</div>' +
    '<div class="detail-value teal copiable" data-copy-text="' + escapeAttr(order.telephoneNumber || '') + '" data-copy-label="رقم الهاتف"><span>' + escapeHtml(phoneForPfdDisplay(order.telephoneNumber || '', order.countryId)) + '</span></div>' +

    (order.notes ? '<div class="detail-header">الملاحظات</div>' +
    '<div class="detail-value copiable" data-copy-text="' + escapeAttr(order.notes) + '" data-copy-label="الملاحظات"><span>' + escapeHtml(order.notes) + '</span></div>' : '') +

    '<div class="detail-header">عبارة النسخ</div>' +
    '<div class="detail-value copiable" data-copy-text="ممنوع فتح الطلب نهائيا" data-copy-label="عبارة النسخ"><span>ممنوع فتح الطلب نهائيا</span></div>' +

    '<div class="detail-header">كود الشحنة</div>' +
    '<div class="detail-value copiable" data-copy-text="' + (order.fixedOrderTimes > 0 ? order.id + 'LLL' : order.id) + '" data-copy-label="كود الشحنة"><span class="badge-code">' + (order.fixedOrderTimes > 0 ? order.id + 'LLL' : order.id) + '</span></div>' +

    '<div class="detail-header">حالة الدفع</div>' +
    '<div class="detail-value copiable" data-copy-text="' + isPaidLabel + '" data-copy-label="حالة الدفع"><span class="badge-payment-status ' + (order.isPaid ? 'paid' : 'unpaid') + '">' + isPaidLabel + '</span></div>';

    // Mini product table
    if (products && products.length > 0) {
    tableHtml += '<div class="detail-header">تفاصيل الطلب</div>' +
    '<div class="detail-value" style="justify-content:flex-end;"><div class="product-mini-table">';
    products.forEach(function (p) {
    tableHtml += '<div class="mini-row copiable" data-copy-text="' + escapeAttr(p.name) + '" data-copy-label="المنتج">' +
    '<div class="mini-img"><img src="/' + (p.image || 'mainicons/DefaultImage.svg') + '" alt="" onerror="this.onerror=null; this.src=\'/mainicons/fallback_product.svg\';" /></div>' +
    '<div class="mini-name">' + escapeHtml(p.name) + '</div>' +
    '<div class="mini-qty">' + p.amount + '</div>' +
    '</div>';
    });
    tableHtml += '</div></div>';
    }

    // Total or Remaining (for Iraq). Paid orders show 0 — driver doesn't collect anything.
    var displayPrice = order.isPaid
    ? 0
    : (order.countryId === @((int)Countries.العراق)
    ? (order.totalPrice - order.deliveryPrice)
    : order.totalPrice);
    var priceLabel = order.countryId === @((int)Countries.العراق) ? 'المبلغ المتبقي' : 'المبلغ الإجمالي';
    tableHtml += '<div class="detail-header">' + priceLabel + '</div>' +
    (order.currency ? '<div class="detail-value total-value copiable" data-copy-text="' + (displayPrice || '') + '" data-copy-label="المبلغ"><span>' + (displayPrice != null ? displayPrice.toFixed(2) : '0.00') + ' ' + order.currency + '</span></div>' : '');

    $('#nd-col1-table').html(tableHtml);

    // Employee photo + creation date (absolutely positioned in col1 body)
    if (order.employeeLogoUrl) {
    $('#nd-employee-photo').attr('src', '/' + order.employeeLogoUrl).attr('alt', order.employeeName || '');
    $('#nd-employee-name').text(order.employeeName || '').toggle(!!order.employeeName);
    $('#nd-created-date').text(order.createdDate || '');
    $('#nd-employee-block').show();
    } else {
    $('#nd-employee-block').hide();
    $('#nd-employee-name').hide();
    }

    // Swap: hide skeletons, show real
    $('#nd-col1-skeleton-header, #nd-col1-skeleton-table').hide();
    $('#nd-col1-header, #nd-col1-table').show();
    // Clean up empty state
    $('.order-details').removeClass('empty-order-details');
    $('.products-panel').removeClass('empty-products-panel');
    $('#nd-empty-create-btn').hide();
    $('.cancel-x-btn').show();
    }

    // ── Col 2: Products ──
    function ndRenderCol2(order, products) {
    // Products gallery
    var galleryHtml = '';
    if (products && products.length > 0) {
    products.forEach(function (p) {
    galleryHtml += '<div class="product-card">' +
    '<div class="product-img-wrap"><img src="/' + (p.image || 'mainicons/DefaultImage.svg') + '" alt="product" onerror="this.onerror=null; this.src=\'/mainicons/fallback_product.svg\';" /></div>' +
    '<p class="product-name">' + escapeHtml(p.name) + '</p>' +
    '<p class="product-qty">الكمية: ' + p.amount + '</p>' +
    '</div>';
    });
    } else {
    galleryHtml = '<div style="grid-column:1/-1;" class="empty-state-body"><img class="empty-no-products" src="/mainicons/no products.svg" alt="" /><p class="empty-state-text">لإظهار المنتجات عليك اختيار الطلب</p></div>';
    }
    $('#nd-col2-gallery').html(galleryHtml);

    // Status
    var isInDelivery = order.orderStatus && order.orderStatus.indexOf('قيد') !== -1 && order.orderStatus.indexOf('التوصيل') !== -1;
    var badgeStyle = isInDelivery ? 'background:rgba(255,205,56,0.1);color:rgba(255,205,56,1);font-weight:700;' : '';
    var deferredTag = order.wasDeferred ? '<span class="status-badge" style="display:block;margin-top:6px;background:rgba(220,53,69,.1);color:#dc3545;font-size:18px;padding:4px 22px;">مؤجل مسبقا</span>' : '';
    var statusHtml = '<span class="order-status-label">حالة الطلب</span>' +
    '<span class="status-badge" style="' + badgeStyle + '">' + escapeHtml(order.orderStatus ? order.orderStatus.replace(/_/g, ' ') : '') + '</span>' + deferredTag;
    $('#nd-col2-status').html(statusHtml);

    // Submit button
    var $btn = $('#nd-submit-btn');
    if (isPreviewMode || order.orderStatusInt !== @((int)OrderStatusEnum.طلب_جديد)) {
    $btn.prop('disabled', true);
    } else {
    $btn.prop('disabled', false);
    }

    // Swap: hide skeletons, show real
    $('#nd-col2-skeleton, #nd-col2-skeleton-status').hide();
    $('#nd-col2-gallery, #nd-col2-status').show();
    }

    // Add to new design col3 when an order is submitted
    function ndAddToCol3(submittedOrder) {
    var flagUrl = getCountryImageUrl(submittedOrder.countryId);
    var timeStr = submittedOrder.time || '';
    var row = '<div class="delivery-section" data-order-id="' + submittedOrder.id + '" style="cursor:pointer;">' +
    '<div class="delivery-row">' +
    '<div class="delivery-time-wrap"><div class="delivery-time">' + timeStr + '</div></div>' +
    '<div class="delivery-info">' +
    '<div class="copy-icon-btn" onclick="event.stopPropagation(); copyToClipboard(\'' + submittedOrder.id + '\', \'كود الشحنة\')"><img src="/mainicons/copy icon.svg" alt="copy" /></div>' +
    '<span class="delivery-code-num">' + submittedOrder.id + '</span>' +
    (flagUrl ? '<img class="delivery-flag" src="' + flagUrl + '" alt="flag" />' : '') +
    '</div>' +
    '</div>' +
    '</div>';
    var $list = $('#nd-col3-list');
    // Remove "no shipments" placeholder if present
    $list.children('.empty-state-body').remove();
    $list.prepend(row);
    }

    // Show empty state (no orders) in the new design
    function ndShowEmpty() {
    $('#nd-col1-skeleton-header, #nd-col1-skeleton-table').hide();
    $('#nd-col1-header').html(
    '<div class="empty-state-body">' +
    '<img class="empty-exclamation" src="/mainicons/exclamation mark.svg" alt="" />' +
    '<div class="empty-state-text"><p>لا يوجد طلب محدد..</p><p>يرجى الإضافة أو الإختيار من الأعلى</p></div>' +
    '</div>'
    ).show();
    $('.order-details').addClass('empty-order-details');
    // Show create-order button inside col1
    if (!$('#nd-empty-create-btn').length) {
    $('.order-details').append(
    '<div id="nd-empty-create-btn" class="empty-create-btn-row">' +
    '<button class="btn-create-order" onclick="$(\'#pfd-add-order-btn\').click();">' +
    'إضافة طلب جديد' +
    '<img src="/mainicons/plus.svg" alt="plus" width="18" height="18" />' +
    '</button>' +
    '</div>'
    );
    } else {
    $('#nd-empty-create-btn').show();
    }
    $('#nd-col1-table').hide();
    $('#nd-col2-skeleton, #nd-col2-skeleton-status').hide();
    $('#nd-col2-gallery').html(
    '<div style="grid-column:1/-1;" class="empty-state-body">' +
    '<img class="empty-no-products" src="/mainicons/no products.svg" alt="" />' +
    '<p class="empty-state-text">لإظهار المنتجات عليك اختيار الطلب</p>' +
    '</div>'
    ).show();
    $('.products-panel').addClass('empty-products-panel');
    $('#nd-col2-status').hide();
    $('#nd-submit-btn').prop('disabled', true);
    ndHideRow2Skeleton();
    }

    // Show empty state for col1 + col2 only (no row2 impact)
    function ndShowEmptyCol1Col2() {
    $('#nd-col1-skeleton-header, #nd-col1-skeleton-table').hide();
    $('#nd-col1-header').html(
    '<div class="empty-state-body">' +
    '<img class="empty-exclamation" src="/mainicons/exclamation mark.svg" alt="" />' +
    '<div class="empty-state-text"><p>لا يوجد طلب محدد..</p><p>يرجى الإضافة أو الإختيار من الأعلى</p></div>' +
    '</div>'
    ).show();
    $('.order-details').addClass('empty-order-details');
    if (!$('#nd-empty-create-btn').length) {
    $('.order-details').append(
    '<div id="nd-empty-create-btn" class="empty-create-btn-row">' +
    '<button class="btn-create-order" onclick="$(\'#pfd-add-order-btn\').click();">' +
    'إضافة طلب جديد' +
    '<img src="/mainicons/plus.svg" alt="plus" width="18" height="18" />' +
    '</button>' +
    '</div>'
    );
    } else {
    $('#nd-empty-create-btn').show();
    }
    $('#nd-col1-table').hide();
    $('.cancel-x-btn').hide();
    $('#nd-premium-badge').hide();
    $('#nd-col2-skeleton, #nd-col2-skeleton-status').hide();
    $('#nd-col2-gallery').html(
    '<div style="grid-column:1/-1;" class="empty-state-body">' +
    '<img class="empty-no-products" src="/mainicons/no products.svg" alt="" />' +
    '<p class="empty-state-text">لإظهار المنتجات عليك اختيار الطلب</p>' +
    '</div>'
    ).show();
    $('.products-panel').addClass('empty-products-panel');
    $('#nd-col2-status').hide();
    $('#nd-submit-btn').prop('disabled', true);
    currentOrderId = 0;
    updateHideOrderSection(0, '-');
    }

    // Cancel X button — dismiss current order, show empty col1+col2
    $('.cancel-x-btn').on('click', function () {
    isPreviewMode = false;
    $('#pfd-new-design').removeClass('pfd-preview-mode');
    $('#nd-downloaded-label').hide();
    ndShowEmptyCol1Col2();
    });

    $('#pfd-add-order-btn').on('click', function () {
    $.ajax({
    url: '/Home/CreateOrder',
    type: 'GET',
    success: function (data) {
    $('#modal-container').html(data);
    $('#Create').modal('show');
    }
    });
    });
</script>
<div id="modal-container"></div>
