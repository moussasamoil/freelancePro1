    // Country IDs whose phone numbers are shown and copied without country code or leading 0.
    var stripCountryCodeCountryIds = [
    @((int)Countries.البحرين),
    @((int)Countries.الكويت),
    @((int)Countries.سلطنة_عمان),
    @((int)Countries.قطر)
    ];
    var phoneCodesByCountryId = @Html.Raw(Json.Serialize(Common.PhoneNumberCodesByCountry.ToDictionary(kv => ((int)kv.Key).ToString(), kv => kv.Value)));

    function stripCountryCodeAndLeadingZero(raw, countryId) {
    if (!raw) return '';
    var cleaned = String(raw).replace(/[-\s]/g, '');
    if (!cleaned) return '';
    var code = phoneCodesByCountryId[countryId];
    var digits = code ? code.replace(/^\+/, '') : '';
    if (digits) {
    if (cleaned.indexOf('00' + digits) === 0) cleaned = cleaned.substring(2 + digits.length);
    else if (cleaned.indexOf('+' + digits) === 0) cleaned = cleaned.substring(1 + digits.length);
    }
    if (cleaned.charAt(0) === '0') cleaned = cleaned.substring(1);
    return cleaned;
    }

    function phoneForPfdDisplay(raw, countryId) {
    return stripCountryCodeCountryIds.indexOf(countryId) >= 0
    ? stripCountryCodeAndLeadingZero(raw, countryId)
    : (raw || '');
    }
    // ── Toast notification ──
    function copyToClipboard(text, fieldName) {
    if (!text || text === 'null' || text === '') return;
    // Libya: strip leading 0 from phone numbers
    if (currentCountryId === @((int)Countries.ليبيا) && fieldName === 'رقم الهاتف' && text.charAt(0) === '0') {
    text = text.substring(1);
    }
    // Bahrain / Kuwait / Oman / Qatar: phones are already rendered without code+leading-0,
    // but copy strings come from the raw telephoneNumber, so strip here too.
    if (fieldName === 'رقم الهاتف' && stripCountryCodeCountryIds.indexOf(currentCountryId) >= 0) {
    text = stripCountryCodeAndLeadingZero(text, currentCountryId);
    }
    // Wrap phone numbers with LTR directional marks so they paste left-to-right in RTL contexts
    if (fieldName === 'رقم الهاتف') {
    text = '‪' + text + '‬';
    }
    var showSuccess = function () {
    Toastify({
    text: "تم نسخ " + fieldName,
    duration: 2000,
    gravity: "bottom",
    position: "center",
    style: { background: "#2ab149", borderRadius: "8px", fontWeight: "bold" }
    }).showToast();
    };
    if (navigator.clipboard && navigator.clipboard.writeText) {
    navigator.clipboard.writeText(text).then(showSuccess);
    } else {
    var ta = document.createElement('textarea');
    ta.value = text;
    ta.style.position = 'fixed';
    ta.style.opacity = '0';
    document.body.appendChild(ta);
    ta.select();
    document.execCommand('copy');
    document.body.removeChild(ta);
    showSuccess();
    }
    }
