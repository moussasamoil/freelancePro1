@model lotus_blue.Models.ViewModel.PrepareForDeliveryViewModel
@using lotus_blue.Models
@using lotus_blue.OrderStatus
@using static lotus_blue.Models.Common
@{
    Layout = "AllOrdersLayout";
    ViewData["Title"] = "تنزيل الطلبات";
    ViewData["MainClass"] = "no-overflow";
    ViewData["HeaderLeft"] = "<span class=\"hidden\">تعديل</span><span  class=\"hidden\" id=\"execute-op-btn\">نفذ العملية</span>";

    var initialRemainingDownloadCount = Model.RemainingDownloadCount > 0
        ? Model.RemainingDownloadCount
        : (Model.OrderQueue != null ? Model.OrderQueue.Count : 0);
}
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Arabic:wght@400;700&family=Open+Sans:wght@400;700&family=Inter:wght@400;700&display=swap" rel="stylesheet" />
<style>
    .hidden {
        opacity: 0;
    }
    /* Header */
    .header {
        display: flex;
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        padding: 8px;
        border-bottom: 1px solid #dee2e6;
        box-shadow: 0 0 4px rgba(0,0,0,.25);
        font-weight: 700;
        font-size: 13px;
        white-space: nowrap;
    }

    .header-actions {
        display: flex;
        flex-direction: row-reverse;
        gap: 32px;
        color: #1d273b;
    }

    .header-title, .header-back {
        color: #333;
    }

    /* Page */
    .page {
        display: flex;
        flex-direction: column;
        gap: 12px;
        align-items: center;
        padding: 12px 0px !important;
        margin: 0 !important;
    }

    /* Banner */
    .banner {
        background: #f4ebdc;
        border-radius: 99px;
        padding: 8px 62px;
        height: 35px;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        text-align: center;
        font-weight: 700;
        font-size: 16px;
        color: #ee9817;
        font-family: 'Inter', sans-serif;
    }

    /* Hide-order */
    .hide-order-container {
        display: flex;
        flex-direction: column;
        gap: 8px;
        width: 100%;
    }

    .toggle-order-hide {
        background: #fff;
        border-radius: 8px;
        box-shadow: 0 0 12px rgba(0,0,0,.15);
        padding: 6px 12px;
        display: flex;
        flex-direction: row-reverse;
        align-items: center;
        justify-content: space-between;
        width: 100%;
        gap: 12px;
    }

    .toggle-btn {
        width: 48px;
        height: 29px;
        background: #e9e9e9;
        border-radius: 99px;
        position: relative;
        cursor: pointer;
        flex-shrink: 0;
        transition: background .2s;
    }

        .toggle-btn::after {
            content: '';
            position: absolute;
            width: 25px;
            height: 25px;
            background: #fff;
            border-radius: 50%;
            top: 2px;
            right: 2px;
            box-shadow: 0 1px 3px rgba(0,0,0,.3);
            transition: right .2s;
        }

        .toggle-btn.active {
            background: #34C85A;
        }

            .toggle-btn.active::after {
                right: 21px;
            }

    .toggle-text {
        font-weight: 700;
        font-size: 16px;
        color: #72777b;
        line-height: 1.6;
        text-align: right;
    }

    .hide-order-note {
        font-size: 16px;
        color: #72777b;
        line-height: 1.6;
        text-align: right;
        font-weight: 400;
    }

    /* Filters */
    .filters {
        display: flex;
        align-items: center;
        flex-direction: column;
        gap: 8px;
        width: 100%;
    }

    .filter-row {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        width: 100%;
    }

        .filter-row .select2-container {
            width: 0 !important;
            flex: 1 1 0;
            min-width: 0;
        }

    .filter-btn {
        background: #fff;
        border: 1px solid #e0e0e0;
        border-radius: 8px;
        height: 42px;
        flex: 1 1 0;
        min-width: 0;
        width: 0 !important;
        display: flex;
        flex-direction: row-reverse;
        align-items: center;
        justify-content: flex-end;
        gap: 6px;
        padding: 0 15px;
        cursor: pointer;
        font-weight: 700;
        font-size: 13px;
        color: #333;
        white-space: nowrap;
        font-family: inherit;
    }

    .filter-icon {
        background: #1d273b;
        border-radius: 11px;
        width: 22px;
        height: 22px;
        display: flex;
        flex-direction: row-reverse;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

        .filter-icon img {
            width: 12px;
            height: 12px;
        }

    .search-container {
        display: flex;
        gap: 8px;
        justify-content: center;
        align-items: center;
        width: 100%;
        height: unset;
    }

    .search-cancel {
        font-weight: 700;
        font-size: 13px;
        color: #1d273b;
        white-space: nowrap;
        cursor: pointer;
    }

    .search-input-wrap {
        background: #fff;
        border: 1px solid #e0e0e0;
        border-radius: 8px;
        height: 42px;
        display: flex;
        flex-direction: row-reverse;
        align-items: center;
        justify-content: space-between;
        padding: 0 12px;
        width: 609px;
        gap: 8px;
    }

        .search-input-wrap input {
            border: none;
            outline: none;
            font-size: 13px;
            color: #000;
            font-family: inherit;
            text-align: right;
            direction: rtl;
            flex: 1;
            background: transparent;
        }

    .cancel-search-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        width: 12px;
        height: 12px;
        background: #1d273b;
        border-radius: 50%;
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        left: 12px;
        z-index: 10;
    }

    .search-icon-btn {
        display: flex;
        flex-direction: row-reverse;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    /* Remaining orders */
    .remaining-orders {
        background: #f6f6f6;
        border-radius: 8px;
        box-shadow: 0 0 4px rgba(0,0,0,.25);
        width: 100%;
        padding-bottom: 8px;
    }

    .remaining-orders-title {
        padding: 4px 23px;
        gap: 8px;
        height: 21px;
        font-weight: 700;
        font-size: 11px;
        line-height: 13px;
        color: #1d273b;
    }

    .order-cards-row, .order-cards-skeleton-row {
        display: flex;
        gap: 4px;
        align-items: center;
        padding: 0 12px;
        overflow-x: hidden;
        cursor: pointer;
    }

    .order-card {
        border-radius: 8px;
        flex-shrink: 0;
        cursor: pointer;
    }

        .order-card img {
            width: 100px;
            height: 60px;
            display: block;
            border-radius: 8px;
        }

    .skeleton-card {
        width: 100px;
        height: 60px;
        border-radius: 8px;
        flex-shrink: 0;
        background: linear-gradient(90deg, #e8e8e8 25%, #f5f5f5 50%, #e8e8e8 75%);
        background-size: 200% 100%;
        animation: shimmer 1.4s ease-in-out infinite;
    }

    .filler-space {
        flex: 1;
        background: #fff;
        border-radius: 8px;
        height: 60px;
        min-width: 40px;
    }

    /* Main 3-col */
    .main-content {
        display: flex;
        flex-direction: row-reverse;
        gap: 12px;
        align-items: flex-start;
        width: 100%;
    }

    .panel {
        background: #fff;
        border: 1px solid transparent;
        border-radius: 8px;
        box-shadow: 0 0 4px rgba(0,0,0,.25);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        transition: border-color .15s;
    }

        .panel:hover {
            border-color: #1d273b;
        }

    .panel-header {
        background: #f9f9f9;
        padding: 7px 23px;
        text-align: right;
        font-weight: 700;
        font-size: 16px;
        color: #1d273b;
        flex-shrink: 0;
    }

    /* Order Details */
    .order-details {
        flex: 1;
        min-width: 0;
        align-self: stretch;
        position: relative;
    }

    .nd-employee-block {
        position: absolute;
        top: 56px;
        right: 16px;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 6px;
        z-index: 5;
    }

    .nd-employee-photo {
        width: 42px;
        height: 42px;
        object-fit: cover;
    }

    .nd-employee-name {
        position: absolute;
        top: 56px;
        right: 94px;
        display: flex;
        align-items: center;
        height: 42px;
        font-size: 13px;
        font-weight: 700;
        color: #1d273b;
        white-space: nowrap;
        z-index: 5;
    }

    .nd-created-date {
        font-size: 13px;
        color: #555;
        white-space: nowrap;
        text-align: center;
    }

    .downloaded-label {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        font-weight: 700;
        font-size: 44px;
        color: #000;
        z-index: 10;
    }

    .details-header {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
        padding: 16px 0 8px;
        min-height: 160px;
    }

        .details-header .detail-value {
            padding: 0;
        }

        .details-header h2 {
            font-weight: 700;
            font-size: 16px;
            color: #000;
            margin-bottom: 0;
        }

    .details-table {
        display: grid;
        grid-template-columns: auto 1fr;
        gap: 0 48px;
        padding: 7px 23px;
        width: 100%;
    }

    .detail-header {
        display: flex;
        flex-direction: row-reverse;
        align-items: flex-start;
        justify-content: flex-end;
        padding: 4px 20px 4px 0;
        font-weight: 700;
        font-size: 16px;
        color: #000;
        white-space: nowrap;
    }

    .detail-value {
        background: #fff;
        display: flex;
        flex-direction: row-reverse;
        align-items: center;
        justify-content: flex-end;
        gap: 8px;
        padding: 4px 20px;
        font-size: 16px;
        color: #000;
        border-radius: 4px;
        cursor: pointer;
    }

        .detail-value:hover {
            color: #1d273b;
        }

    .badge-payment-status.paid {
        background: #28a745;
    }

    .badge-payment-status.unpaid {
        background: red;
    }

    .detail-value:hover .badge-code,
    .detail-value:hover .badge-payment-status {
        background: #1d273b !important;
    }

    .detail-value:hover .product-mini-table {
        background: rgba(24,160,136,.1);
    }

    .detail-value.teal {
        color: #2ab149;
    }

    .detail-value img.flag {
        width: 15px;
        height: 12px;
        object-fit: cover;
    }

    .badge-code {
        background: #192744;
        color: #fff;
        font-weight: 700;
        font-size: 20px;
        line-height: 24px;
        border-radius: 800px;
        padding: 3px 47px;
        white-space: nowrap;
        font-family: 'Open Sans', sans-serif;
    }

    .badge-payment-status {
        background: red;
        color: #fff;
        font-weight: 700;
        font-size: 20px;
        line-height: 24px;
        border-radius: 800px;
        padding: 4px 53px;
        white-space: nowrap;
        width: 148px;
        text-align: center;
        font-family: 'Open Sans', sans-serif;
    }

    .badge-code, .badge-payment-status {
        display: flex;
        width: 148px;
        flex-direction: column;
        align-items: center;
    }

    .product-mini-table {
        background: #fff;
        border-radius: 8px;
        box-shadow: 0 0 4px rgba(0,0,0,.2);
        width: 197px;
        overflow: hidden;
    }

    .mini-row {
        display: flex;
        flex-direction: row-reverse;
        border-bottom: 1px solid #dee2e6;
        border-top: 1px solid #dee2e6;
        height: 25px;
        font-family: 'Open Sans', 'Noto Sans Arabic', sans-serif;
        font-size: 13px;
        color: #6c757d;
    }

        .mini-row.tall {
            height: 49px;
        }

    .mini-qty {
        width: 26px;
        border-left: 1px solid #dee2e6;
        border-right: 1px solid #dee2e6;
        display: flex;
        flex-direction: row-reverse;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .mini-name {
        flex: 1;
        border-left: 1px solid #dee2e6;
        border-right: 1px solid #dee2e6;
        display: flex;
        flex-direction: row-reverse;
        align-items: center;
        justify-content: center;
        padding: 0 4px;
        text-align: center;
        overflow: hidden;
    }

    .mini-img {
        width: 42px;
        border-left: 1px solid #dee2e6;
        border-right: 1px solid #dee2e6;
        display: flex;
        flex-direction: row-reverse;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

        .mini-img img {
            width: 25px;
            height: 20px;
            object-fit: cover;
        }

    .total-value {
        color: #1d273b;
        font-size: 16px;
        flex-direction: row;
    }

    .cancel-x-btn {
        position: absolute;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        border: none;
        background: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        left: 15px;
        box-shadow: 0 0 4px rgba(255,0,0,.5);
    }

        .cancel-x-btn .cancel-hover {
            display: none;
        }

        .cancel-x-btn:hover {
            background: #ff0000;
            box-shadow: 0 0 4px rgba(255,0,0,.5);
        }

            .cancel-x-btn:hover .cancel-default {
                display: none;
            }

            .cancel-x-btn:hover .cancel-hover {
                display: block;
            }

    .premium-logo {
        position: absolute;
        top: 50px;
        right: 15px;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 2px;
    }

    .premium-label {
        font-weight: 700;
        font-size: 14px;
        color: #ffcd38;
    }

    /* Products panel */
    .products-panel {
        width: 328px;
        flex-shrink: 0;
        align-self: stretch;
    }

    .products-gallery {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 10px;
        padding: 16px 16px 8px;
        flex: 1;
    }

    .product-card {
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .product-img-wrap {
        background: #f6f6f6;
        border-radius: 16px;
        width: 100%;
        aspect-ratio: 1;
        overflow: hidden;
        box-shadow: 0 0 4px rgba(0,0,0,.39);
        margin-bottom: 4px;
    }

        .product-img-wrap:hover {
            background: #c6cbd6;
        }

        .product-img-wrap img {
            width: 100%;
            height: 100%;
            object-fit: contain;
            display: block;
            transition: transform .2s;
        }

        .product-img-wrap:hover img {
            transform: scale(1.15);
        }

    .product-name {
        font-weight: 700;
        font-size: 8px;
        color: #000;
        text-align: center;
        width: 100%;
    }

    .product-qty {
        font-weight: 700;
        font-size: 8px;
        color: #787878;
        text-align: center;
        width: 100%;
    }

    .order-status-section {
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 4px;
        align-items: flex-start;
        padding: 8px 16px;
        flex: 1;
        margin-bottom: 32px;
    }

    .order-status-label {
        font-weight: 700;
        font-size: 16px;
        color: #1d273b;
        font-family: 'Inter', sans-serif;
    }

    .status-badge {
        background: rgba(0,123,255,.1);
        color: #007bff;
        font-weight: 700;
        font-size: 18px;
        border-radius: 8px;
        padding: 8px 44px;
        white-space: nowrap;
        font-family: 'Inter', sans-serif;
    }

    .submit-section {
        display: flex;
        flex-direction: row-reverse;
        align-items: flex-end;
        justify-content: center;
        padding: 0 7px 6px;
    }

    .btn-confirm {
        background: #2ab149;
        color: #fff;
        font-weight: 700;
        font-size: 16px;
        border: none;
        border-radius: 8px;
        height: 45px;
        width: 314px;
        display: flex;
        flex-direction: row-reverse;
        align-items: center;
        justify-content: center;
        gap: 8px;
        cursor: pointer;
        font-family: inherit;
    }

        .btn-confirm img {
            width: 16px;
            height: 16px;
        }

    /* Warehouse tag (Libya only) */
    .warehouse-tag {
        font-weight: bold;
        background-color: #fef0e7;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 1px solid #fc9008;
        border-radius: 99px;
        padding: 2px 40px 2px;
        color: #fc9008;
        font-size: 18px;
        font-weight: 400;
        white-space: nowrap;
        line-height: normal;
        width: unset;
        cursor: pointer;
        transition: background .15s;
    }

        .warehouse-tag:hover {
            background: rgba(0,150,136,.1);
        }
    /* Route string tag (Libya odd-case: غير متوفر توصيل) */
    .route-string {
        background-color: #fdf9ed;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 2px 20px;
        color: #d5a46e;
        font-size: 18px;
        font-weight: 400;
        white-space: nowrap;
        line-height: normal;
        width: unset;
        cursor: pointer;
        transition: background .15s;
        border-color: #d5a46e;
    }

        .route-string:hover {
            background: rgba(0,150,136,.1);
        }

    /* Shipments panel */
    .shipments-panel {
        width: 164px;
        flex-shrink: 0;
        align-self: stretch;
        position: relative;
        width: 200px;
    }

    .col3-inner {
        position: absolute;
        inset: 0;
        overflow-y: hidden;
        display: flex;
        flex-direction: column;
    }

    .delivery-codes-container {
        flex: 1;
        min-height: 0;
        overflow-y: auto;
        display: flex;
        flex-direction: column;
    }

    .delivery-section {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        padding: 0 4px;
        padding-top: 0;
        padding-bottom: 8px
    }

        .delivery-section:hover {
            background: rgba(204,230,225,.5);
        }

    .delivery-row {
        display: flex;
        flex-direction: row-reverse;
        align-items: flex-end;
        gap: 8px;
        height: 32px;
        padding: 5px 8px 5px 4px;
        border-bottom: 0.5px solid #e0e0e0;
        width: 100%;
    }

    .delivery-time {
        font-size: 12px;
        color: #787878;
        width: 31px;
        text-align: center;
        flex-shrink: 0;
        height: 9px;
    }

    .delivery-time-wrap {
        height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
    }

    .delivery-info {
        flex: 1;
        display: flex;
        flex-direction: row-reverse;
        align-items: center;
        justify-content: flex-end;
        gap: 4px;
    }

    .delivery-code-num {
        font-size: 14px;
        color: #000;
        white-space: nowrap;
        height: 22px;
    }

    .delivery-flag {
        width: 20px;
        height: 16px;
        object-fit: cover;
        flex-shrink: 0;
        margin-bottom: 6px;
    }

    .copy-icon-btn {
        cursor: pointer;
        display: flex;
        flex-direction: row-reverse;
        align-items: center;
    }

        .copy-icon-btn img {
            width: 17px;
            height: 17px;
        }

    .return-btn-wrap {
        padding: 0 7px 6px;
        flex-shrink: 0;
    }

    .btn-return {
        background: #ffcd38;
        color: #fff;
        font-weight: 700;
        font-size: 16px;
        border: none;
        border-radius: 8px;
        height: 45px;
        width: 100%;
        display: flex;
        flex-direction: row-reverse;
        align-items: center;
        justify-content: center;
        gap: 4px;
        cursor: pointer;
        font-family: inherit;
        transition: opacity .2s;
    }

        .btn-return:disabled {
            background: #c8c8c8;
            cursor: default;
            opacity: .6;
        }

        .btn-return img {
            width: 24px;
            height: 24px;
            filter: brightness(0) invert(1);
        }

    /* Skeleton shimmer */
    @@keyframes shimmer {
        0% {
            background-position: -200% 0;
        }

        100% {
            background-position: 200% 0;
        }
    }

    .delivery-skeleton-row {
        display: flex;
        flex-direction: row-reverse;
        align-items: center;
        gap: 8px;
        height: 32px;
        padding: 5px 8px 5px 4px;
        border-bottom: 0.5px solid #e0e0e0;
        width: 100%;
    }

        .delivery-skeleton-row > div {
            border-radius: 6px;
            background: linear-gradient(90deg, #e8e8e8 25%, #f5f5f5 50%, #e8e8e8 75%);
            background-size: 200% 100%;
            animation: shimmer 1.4s ease-in-out infinite;
        }

    .sk-flag {
        width: 20px;
        height: 14px;
        flex-shrink: 0;
    }

    .sk-code {
        flex: 1;
        height: 14px;
    }

    .sk-time {
        width: 31px;
        height: 10px;
        flex-shrink: 0;
    }

    /* Skeleton shared base */
    .sk-block {
        border-radius: 6px;
        background: linear-gradient(90deg, #e8e8e8 25%, #f5f5f5 50%, #e8e8e8 75%);
        background-size: 200% 100%;
        animation: shimmer 1.4s ease-in-out infinite;
    }

    /* Col1 skeletons */
    .sk-details-header {
        display: flex;
        flex-direction: column;
