    // Toggle the current order's delayed flag, then jump to next undelayed order.
    $(document).on('click', '#hideOrderToggle', function () {
    if (!currentOrderId) return;
    var $toggle = $(this);
    var newDelayed = !$toggle.hasClass('active');
    // Reflect the toggle animation immediately, then wait so the user sees it before the request fires.
    $toggle.toggleClass('active', newDelayed);
    var targetOrderId = currentOrderId;
    setTimeout(function () {
    $.post('/PrepareForDelivery/SetDelayed', { orderId: targetOrderId, isDelayed: newDelayed }, function (result) {
    if (!result.success) return;
    var $cards = $('#orderQueueRow .order-card');
    $cards.filter('[data-order-id="' + targetOrderId + '"]')
    .attr('data-is-delayed', newDelayed ? 'true' : 'false')
    .toggleClass('is-delayed', newDelayed);
    // Find next undelayed card (excluding the just-toggled one); fallback to first delayed; else stay.
    var $next = $cards.filter('[data-is-delayed="false"]').filter(function () {
    return String($(this).data('order-id')) !== String(targetOrderId);
    }).first();
    if (!$next.length) {
    $next = $cards.filter(function () {
    return String($(this).data('order-id')) !== String(targetOrderId);
    }).first();
    }
    if ($next.length) {
    loadOrderData($next.data('order-id'));
    } else {
    $toggle.toggleClass('active', newDelayed);
    }
    });
    }, 800);
    });
