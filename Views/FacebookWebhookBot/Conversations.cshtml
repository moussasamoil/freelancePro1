    // Helper function to create a full timestamp from hour:minute
    function createFullTimestamp(hourMinute) {
        if (!hourMinute) return new Date(); // Fallback to the current date if timestamp is missing

        const [hour, minute] = hourMinute.split(':');
        const now = new Date();
        now.setHours(parseInt(hour, 10), parseInt(minute, 10), 0, 0); // Set hours and minutes, clear seconds and milliseconds
        return now;
    }

    // Function to update the timestamp dynamically
    // Function to update the timestamp dynamically
    function updateTimestamp(initialTimestamp, timestampId) {
        const timestampElement = document.getElementById(timestampId);
        if (!timestampElement) return;

        function refreshTimestamp() {
            const now = new Date();
            const elapsedSeconds = Math.floor((now - initialTimestamp) / 1000);

            if (elapsedSeconds < 60) {
                timestampElement.textContent = elapsedSeconds === 0
                    ? 'الآن'
                    : `${elapsedSeconds} ثانية`;
                setTimeout(refreshTimestamp, 1000); // Update every second
            } else {
                // Get hours and minutes
                const hours = initialTimestamp.getHours();
                const minutes = initialTimestamp.getMinutes().toString().padStart(2, '0');

                // Determine whether it's AM or PM
                const period = hours < 12 ? 'ص' : 'م';

                // Convert hours to 12-hour format
                const formattedHours = hours % 12 === 0 ? 12 : hours % 12;

                // Display the custom formatted time
                timestampElement.textContent = `${formattedHours}:${minutes} ${period}`;
            }
        }

        refreshTimestamp();
    }






