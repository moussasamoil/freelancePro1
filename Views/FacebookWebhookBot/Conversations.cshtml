    // Toggle conversation `IsOrder` status
    document.querySelector("#order-status-icon").addEventListener("click", async function () {
        if (currentConversationId) {
            try {
                // Send a POST request to toggle the order status
                const response = await fetch(`/api/facebook/webhook/toggle-order/${currentConversationId}`, {
                    method: "POST"
                });

                if (response.ok) {
                    console.log("Conversation order status toggled successfully.");

                    // Get the updated status from the response
                    const data = await response.json();
                    const isOrder = data.isOrder;

                    // Update the icon color based on the new status
                    const icon = document.getElementById("order-status-icon");
                    if (isOrder) {
                        icon.classList.remove("text-danger");
                        icon.classList.add("text-success");
                    } else {
                        icon.classList.remove("text-success");
                        icon.classList.add("text-danger");
                    }

                    // Notify other clients in real-time using SignalR
                    await messageHubConnection.invoke("UpdateOrderStatus", currentConversationId, isOrder);
                } else {
                    console.error("Failed to toggle order status.");
                }
            } catch (error) {
                console.error("Error toggling order status:", error);
            }
        }
    });

