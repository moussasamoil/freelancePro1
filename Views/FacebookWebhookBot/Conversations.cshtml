    // Function to append a message to the chat body
    function appendMessage(message) {
        const chatBody = document.querySelector('.chat-body');
        const messageDiv = document.createElement('div');

        // Check if the message is from the user (bold font for messages from the user)
        if (message.isFromUser) {
            // User's message (left side, bold font)
            messageDiv.className = 'message  from-other'; // Other message
            messageDiv.innerHTML = `
                            <div class="message-info">
                                <small class="text-muted timestamp">${message.timestamp || new Date().toLocaleTimeString()}</small>
                                <small class="text-muted sender-name">${message.sendername || "User"}</small>
                            </div>
                            <div class="message-bubble user-bubble" > <!-- Bold for user messages -->
                                ${message.text}
                                <div class="triangle-left"></div>
                            </div>
                        `;
        } else {
            // Your message (right side, normal font)
            messageDiv.className = 'message from-user'; // Your message
            messageDiv.innerHTML = `
                            <div class="message-info">
                                <small class="text-muted timestamp">${message.timestamp || new Date().toLocaleTimeString()}</small>
                                <small class="text-muted sender-name">${message.sendername || "Page"}</small>
                            </div>
                            <div class="message-bubble other-bubble" style="font-weight: normal;"> <!-- Normal for sent messages -->
                                ${message.text}
                                <div class="triangle-right"></div>
                            </div>
                        `;
        }

        chatBody.appendChild(messageDiv);
        chatBody.scrollTop = chatBody.scrollHeight; // Scroll to the latest message
    }


