        }

        // Start processing the queue if not already in progress
        if (!isSending) {
            await processAllMessageQueues();
        }


        // Join the selected conversation group for real-time updates
        try {
            await messageHubConnection.invoke("JoinConversation", currentConversationId);
            console.log(`Joined conversation group: ${currentConversationId}`);
        } catch (error) {
            console.error("Error joining conversation:", error);
        }
    }

    async function processAllMessageQueues() {
        isSending = true;

        try {
            for (const queueKey of Object.keys(messageQueues)) {
                const { recipientId, messages } = messageQueues[queueKey];

                while (messages.length > 0) {
                    const messageText = messages.shift();
                    console.log(`Sending message: "${messageText}" for ${queueKey}`);

                    try {
                        await sendMessageToQueueConversation(queueKey, recipientId, messageText);
                    } catch (error) {
                        console.error(`Error sending message for ${queueKey}:`, error);
                    }

                    await delay(500); // Adjust delay as needed
                }

                // Clear the queue after processing
                delete messageQueues[queueKey];
            }

        } catch (error) {
            console.error("Error processing all message queues:", error);
        } finally {
            isSending = false;
        }
    }


    // Load messages for a specific conversation
    async function loadConversationMessages(conversationId) {
        console.log(`Loading messages for conversation ID: ${conversationId}`);
        try {
            const response = await fetch(`/api/facebook/webhook/conversations/${conversationId}/messages`);
            if (!response.ok) {
                throw new Error(`Failed to load messages: ${await response.text()}`);
            }
            const messages = await response.json();
            console.log(`Messages loaded for conversation ID: ${conversationId}`, messages);

            // Cache messages and append each one
            messageCache[conversationId] = messages;
            messages.forEach(appendMessage);

            // Ensure scroll position resets to the latest message
            const chatBody = document.querySelector('.chat-body');
            chatBody.scrollTop = chatBody.scrollHeight;
            console.log(`Scrolled to bottom of chat body for conversation ${conversationId}`);
            // Mark all messages as read after loading them
            console.log(`Attempting to mark conversation ${conversationId} as read.`);
            await markConversationAsRead(conversationId);


        } catch (error) {
            console.error("Error in loadConversationMessages:", error);
        }
    }


    // Function to mark all messages in a conversation as read
    async function markConversationAsRead(conversationId) {
        try {
            console.log(`Sending request to mark conversation ${conversationId} as read.`);
            const response = await fetch(`/api/facebook/webhook/conversations/${conversationId}/markAsRead`, {
