    document.getElementById("read-status-icon").addEventListener("click", async function () {
        if (!currentConversationId) {
            console.error("No active conversation to update read status.");
            return;
        }

        try {
            const response = await fetch(`/api/facebook/webhook/toggle-read/${currentConversationId}`, {
                method: "POST"
            });

            if (response.ok) {
                const data = await response.json();
                const isRead = data.isRead;

                // Update the icon based on the new status
                const icon = document.getElementById("read-status-icon");
                if (icon) {
                    if (isRead) {
                        icon.classList.remove("text-danger");
                    } else {
                        icon.classList.add("text-danger");
                    }
                }

                // Handle the unread badge and message content on the front end
                const conversationDiv = document.getElementById(`conversation-${currentConversationId}`);
                const unreadBadge = conversationDiv?.querySelector('.unread-count');
                const messageContent = conversationDiv?.querySelector('.message-content');

                if (isRead) {
                    // Remove the unread badge and bold styling
                    if (unreadBadge) unreadBadge.remove();
                    if (messageContent) messageContent.classList.remove('fw-bolder');
                } else {
                    // Add the unread badge and bold styling
                    if (!unreadBadge) {
                        const newBadge = document.createElement('span');
                        newBadge.className = 'badge-circle bg-success mt-1 unread-count';
                        newBadge.innerText = '1';
                        conversationDiv.appendChild(newBadge);
                    }
                    if (messageContent) messageContent.classList.add('fw-bolder');
                }

                // Notify other clients using SignalR
                await messageHubConnection.invoke("UpdateReadStatus", {
                    conversationId: currentConversationId,
                    isRead: isRead
                });
            } else {
                console.error("Failed to toggle read status.");
            }
        } catch (error) {
            console.error("Error toggling read status:", error);
        }
    });



