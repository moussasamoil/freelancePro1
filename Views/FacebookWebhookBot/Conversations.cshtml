    // Function to process the queue for a specific conversation
    async function processConversationQueue(conversationId) {
        if (activeConversations.has(conversationId)) {
            console.log(`Conversation ${conversationId} is already being processed.`);
            return;
        }

        const queue = messageQueues[conversationId];
        if (!queue || !queue.messages || !queue.recipientId) {
            console.error(`No valid queue for conversation ${conversationId}`);
            return;
        }

        const { recipientId, messages } = queue;
        activeConversations.set(conversationId, true); // Mark as active

        try {
            while (messages.length > 0) {
                const messageText = messages.shift();
                console.log(`Sending message for conversation ${conversationId}: "${messageText}"`);

                await sendMessageToQueueConversation(conversationId, recipientId, messageText);
                await delay(1000); // Adjust delay as needed
            }

            console.log(`Completed sending messages for conversation ${conversationId}`);
        } catch (error) {
            console.error(`Error processing queue for conversation ${conversationId}:`, error);
        }
        finally {
            activeConversations.delete(conversationId);
            delete messageQueues[conversationId]; // Clean up processed queues
        }

    }


    // Function to send individual messages via a POST request using AJAX
    function sendMessageToQueueConversation(conversationId, recipientId, text) {
        const [pageId] = conversationId.split('_');

        if (!conversationId || !recipientId || !text) {
            console.warn(`Invalid data for sending message to conversation ${conversationId}`);
            return;
        }

        const payload = {
            text,
            pageId,
            recipientId,
            isFromUser: false
        };

        console.log(`Sending POST request for ${conversationId}:`, payload);

        // AJAX POST request
        return $.ajax({
            url: `/api/facebook/webhook/conversations/${conversationId}/messages`,
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(payload),
            success: async function () {
                console.log(`Message sent successfully for ${conversationId}`);
              
               // appendMessage(message);
                // ✅ Reload the conversation messages and append the new message
              //  await loadConversationMessages(conversationId);
            },
            error: function (jqXHR, textStatus, errorThrown) {
                console.error(`Failed to send message for ${conversationId}: ${errorThrown}`);
            }
        });
    }


    // Get references to the input and button elements
    const messageInput = document.getElementById('message-input');

    // Variable to track if a message is being sent
    let isMessageSending = false;

    // Function to handle sending the message
    function handleSendMessage() {
        if (isMessageSending) return; // Prevent sending multiple messages

        const messageText = messageInput.value.trim();

        // Check if there is text to send
        if (!messageText) return;

        // Disable input while sending the message
        isMessageSending = true;
        messageInput.disabled = false;

        // Send the message to the current conversation
        if (currentConversationId && recipientId) {
            sendMessageToQueueConversation(currentConversationId, recipientId, messageText)
                .done(function () {
                    // Clear the input field only if the message is successfully sent
                    messageInput.value = '';
                })
                .fail(function () {
                    console.error("Failed to send the message.");
                })
                .always(function () {
                    // Re-enable the input after the request is complete
                    isMessageSending = false;
                    messageInput.disabled = false;
                });
        } else {
            console.error("No active conversation or recipient ID available.");
            isMessageSending = false;
            messageInput.disabled = false;
        }
    }

    // Trigger the send message function on pressing Enter
    messageInput.addEventListener('keydown', (event) => {
        if (event.key === 'Enter') {
            handleSendMessage();
        }
    });



    // Delay function
    function delay(ms) {
        return new Promise(resolve => setTimeout(resolve, ms));
    }

  


