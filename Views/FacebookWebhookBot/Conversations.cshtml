        let url = `/api/facebook/webhook/allconversations`;

        // Create query parameters dynamically from the filters object
        const params = new URLSearchParams();

        // Add filters only if they have valid values
        Object.entries(filters).forEach(([key, value]) => {
            if (value !== null && value !== undefined) {
                params.append(key, value);
            }
        });

        // Append parameters to the URL if any were added
        if (params.toString()) {
            url += `?${params.toString()}`;
        }

        console.log("Fetching conversations from URL:", url);

        try {
            // Fetch the filtered conversations
            const response = await fetch(url);
            if (!response.ok) {
                const errorText = await response.text();
                throw new Error(`Failed to load conversations: ${response.status} - ${errorText}`);
