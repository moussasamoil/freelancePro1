@{
    ViewData["Title"] = "Conversations";
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}
@using lotus_blue.Controllers
@* <header
 *@
<header>
    <div class="container-fluid">
        <nav class="nav-shadow px-3 background-white-green py-0 fixed-top navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom">
            <div class="d-flex justify-content-between w-100">
                <div class="p-0 rtl">
                    <a class="px-2 py-1 text-black text-decoration-none d-inline-block" href="javascript:window.history.back();">
                        تراجع
                    </a>

                </div>
                <div class="text-center pt-1 ">
                    <img id="logo" width="200" class="text-center pb-3 main-logo pb-md-1" loading="lazy" src="/static/مفرغغ.png" />
                </div>
                <div class=" pt-1">
                    انتهى
                </div>
            </div>
        </nav>
    </div>
</header>



<h4 class="d-flex justify-content-center pt-1 text-green">
    مجموعة أدوات الأعمال
</h4>


<div id="filterpages" class="d-flex justify-content-start flex-wrap gap-4">
    @foreach (var item in FacebookWebhookBotController.PAGES_CONFIG)
    {
        <div class="d-flex justify-content-center flex-column filter-page" data-page-id="@item.Key">
            <div class="circle">
                <img src="@item.Value.PagePhoto" alt="@item.Value.PageName">
            </div>
            <p class="pt-1 text-center">@item.Value.PageName</p>
        </div>
    }
</div>


<!-- Hidden input to store the selected page ID for filtering -->
<input type="hidden" id="page-filter" name="page-filter" />



<div>
  @*   <button id="send-offer-messages-flare-woman" class="btn btn-primary">عروض فلير بنات</button>

    <button id="send-offer-messages-moonlight" class="btn btn-primary">عروض مون لايت </button>

    <button id="send-offer-messages-flare-man" class="btn btn-primary">عروض فلير شباب</button>

    <button id="send-offer-messages-lotusblue" class="btn btn-primary">عروض لوتس بلو </button>

    <button id="send-offer-messages-loxxking-man" class="btn btn-primary">عروض لوكس كينغ شباب</button>

    <button id="send-offer-messages-loxxking-woman" class="btn btn-primary">عروض لوكس كينغ بنات </button> *@
    <div class="row">
        <!-- Right Sidebar - Column 3 -->
        <div class="col-12 col-md-3 bg-light">
            <div class="p-3">

