                    <div class="input-group flex-grow-1 ">
                        <input type="text" id="searchInput" name="search" class="pe-5 w-100 custom-box-shadow
            Search search-input">

                        <span class="icon search-icon">
                            <i class="fa-solid text-green fa-magnifying-glass fa-rotate-90"></i>
                        </span>
                        <span id="searchingshow" class="icon clear-search-icon cursor-pointer" style="visibility: hidden;">
                            <i class="fa-solid text-green text-green fa-circle-xmark "></i>
                        </span>
                    </div>
                </div>



            </div>

            <!-- Filter Tabs -->
            <div class="filter-tabs mb-3 d-flex justify-content-start" role="tablist">
                <button id="resetFiltersButton" class="tab-button f-s-16  all" type="button" role="tab">الكل</button>
                <button class="tab-button f-s-16 read" type="button" role="tab">غير مقرؤة</button>
                <!-- التصنيفات Dropdown -->
                <select id="categoriesDropdown" class="form-select">
                    <option value="">اختر تصنيف</option>
                    <option value="completedOrders">طلبات مكتملة</option>
                    <option value="incompleteOrders">طلبات غير مكتملة</option>
                    <option value="completedOffers">عروض مكتملة</option>
                    <option value="incompleteOffers">عروض غير مكتملة</option>
                </select>
                <button id="showCountriesButton" class="tab-button f-s-16" type="button" role="tab">الدول</button>
                <button id="showUndefinedOrder" class="tab-button f-s-16" type="button" role="tab">غير معرف</button>

            </div>

            <!-- Dropdown for Countries -->
            <div id="countryDropdownContainer" style="display: none;">
                <select id="countryDropdown" class="form-select">
                    <option value="" disabled selected>اختر الدولة</option>
                    <option value="1">العراق</option>
                    <option value="2">الإمارات</option>
                    <option value="3">قطر</option>
                    <option value="4">ليبيا</option>
                    <option value="5">سلطنة عمان</option>
                    <option value="6">فلسطين</option>
                    <option value="7">تركيا</option>
                    <option value="8">الأردن</option>
                    <option value="9">الكويت</option>
                    <option value="10">البحرين</option>
                    <option value="11">السعودية</option>
                    <option value="12">تونس</option>
                    <option value="13">المغرب</option>
                    <option value="14">الجزائر</option>
                    <option value="15">لبنان</option>
                </select>
            </div>

            <!-- Dropdown for Gender -->
            <div id="genderDropdownContainer" style="display: none;">
                <select id="genderDropdown" class="form-select">
                    <option value="" disabled selected>اختر الجنس</option>
                    <option value="true">ذكر</option> <!-- Male -->
                    <option value="false">أنثى</option> <!-- Female -->
                </select>
            </div>

            <!-- Message List -->
            <div class="list-group custom-scroll" id="scrollable-div">
                <!-- Message Item -->
                <div class="list-group-item  d-flex align-items-center border-0">
                </div>
                <div class="message-border-bottom"></div>

                <!-- Repeat Message Item as needed -->
            </div>


        </div>


        <!-- Main Chat Area - Column 8 -->
        <div class="col-12 col-md-8 border-end fixed-middle">

            <!-- Chat Header -->
            <div class="chat-header d-flex justify-content-between align-items-center p-1 bg-white border-bottom hidden">
                <div class="d-flex align-items-center">
                    <i class="fas fa-times "></i>
                    <i class="fas fa-check-square text-danger me-3" id="order-status-icon"></i>
                    <i class="fas fa-envelope  me-3" id="read-status-icon"></i>
                    <div class="dropdown">
                        <i class="fa-solid fa-earth-americas me-3" id="country-dropdown-icon" data-bs-toggle="dropdown"></i>
                        <ul class="dropdown-menu" aria-labelledby="country-dropdown-icon">
                            @foreach (var country in Enum.GetValues(typeof(Common.Countries)))
                            {
                                <li>
                                    <a class="dropdown-item country-option" href="#" data-country-id="@((int)country)">
                                        @country
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>

                    <div class="dropdown">
                        <i class="fa-solid fa-warehouse me-3" id="product-dropdown-icon" data-bs-toggle="dropdown"></i>
                        <ul class="dropdown-menu" aria-labelledby="product-dropdown-icon">
                            <li><a class="dropdown-item product-option" href="#" data-product-name="Foundation">Foundation</a></li>
                            <li><a class="dropdown-item product-option" href="#" data-product-name="Powder">Powder</a></li>
                            <li><a class="dropdown-item product-option" href="#" data-product-name="Shampoo">Shampoo</a></li>
                            <li><a class="dropdown-item product-option" href="#" data-product-name="Corset">Corset</a></li>
                            <li><a class="dropdown-item product-option" href="#" data-product-name="Mascara">Mascara</a></li>
                        </ul>
                    </div>


                </div>

                <div class="d-flex align-items-center gap-2">
                    <h6 id="conversation-country"></h6>
                    <img height="15" width="15" id="conversation-flag" />
                    <h6 id="product-name"></h6>
                    <h6 id="gender-name"></h6>

                </div>


                <div class="d-flex align-items-center">
                    <div>
                        <h6 class="m-0 text-green fw-bold" id="conversation-username"> </h6>
                        <small class="text-muted" id="conversation-pagename"> </small>
                    </div>
                    <img width="72" height="72" src="" class="rounded-circle me-2" alt="Logo" id="conversation-logo">
                </div>
            </div>

            <!-- Chat Body -->
            <div class="chat-body p-3 hidden" style="height: 500px; overflow-y: auto; background-color: #f7f7f7;">

                <div id="message-list">
                    <!-- Messages will be dynamically appended here -->
                </div>

            </div>

