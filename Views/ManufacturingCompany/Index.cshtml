@using lotus_blue.Models.ViewModel
@model PaginationViewModel<ManufacturingCompanyViewModel>


@{
    ViewData["Title"] = "تفاصيل الشركات المصنعة ";

}
<div class="row mb-3">

    <div class="col-lg w-100 my-auto mb-0 me-3 col-sm-12 p-relative text-nowrap">
        <select id="ManufacturingCompanyId" name="storeId" class="form-control drop-down-design" >
        </select>
    </div>

    <!-- Second column -->
    <div class="col-lg-6 d-flex align-items-center justify-content-end">
        <div class="form-group d-flex align-items-center">
            <label for="pageSize" class="me-2">أظهر:</label>
            <select id="pageSize" name="pageSize" class="form-control me-2">
                <option value="10">10</option>
                <option value="25">25</option>
                <option value="50">50</option>
                <option value="100">100</option>
            </select>
            <label for="pageSize">مدخلات</label>
        </div>
    </div>


</div>


<table id="table" class="table">
    <thead>
        <tr>
            <th>#</th>
            <th>الاسم</th>
            <th>الإجراءات</th>
            <th>الفعالية</th>

        </tr>
    </thead>
    <tbody>
        @if (Model != null)
        {
            @foreach (var company in Model.Items)
            {

                <tr>
                    <td>@company.Id</td>

                    <td>@company.Name</td>
                    <td>
                        <div class="d-inline-flex">
                            <a asp-action="Edit" class="btn btn-yellow-v3" asp-route-id="@company.Id">تعديل</a>

                         
                        </div>

                    </td>
                    <td>
                        <div class="row align-items-center d-flex justify-content-center">
                            <div class="col-auto">
                                <div class="form-check form-switch">
                                    <input class="form-check-input shown-checkbox" type="checkbox" id="isShown-@company.Id" data-manufacturingcompany-id="@company.Id" @(company.IsShown ? "checked" : "")>
                                    <label class="form-check-label" for="isShown-@company.Id"> مرئي</label>
                                </div>
                            </div>
                        </div>
                    </td>


                </tr>

            }
        }
    </tbody>
</table>

<div class="mt-3 row">
    <div class="d-flex justify-content-start col-lg-4">
        <!-- Align the first div to the start -->
        <p class="text-start pt-2">@Model.TotalItems عدد الشركات</p>
    </div>
    <div class="col-lg-8">
        <nav aria-label="Page navigation">
            <div class="d-flex justify-content-start">
                <!-- Align the second div to the center -->
                <ul class="pagination">
                    <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link @(Model.CurrentPage == 1 ? "page-link-custom" : "")" href="@Url.Action("Index", new { page = Model.CurrentPage - 1 })">السابق</a>
                    </li>
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="numbers page-item @(Model.CurrentPage == i ? "active" : "")">
                            <a class="page-link" href="@Url.Action("Index", new { page = i })">@i</a>
                        </li>
                    }
                    <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                        <a class="page-link page-link-custom" href="@Url.Action("Index", new { page = Model.CurrentPage + 1 })">التالي</a>
                    </li>
                </ul>
            </div>
        </nav>
    </div>
</div>

<script>

    $(document).ready(function () {
        var globalManufacturingId; // Declare the global variable

        $('.active-checkbox, .shown-checkbox').change(function () {
            // Set the global variable when any checkbox is changed
            globalManufacturingId = $(this).data('manufacturingcompany-id');

            if ($(this).hasClass('shown-checkbox')) {
                var isShown = $(this).is(':checked');
                $.post('/ManufacturingCompany/SetIsShown', { manufacturingcompanyId: globalManufacturingId, isShown: isShown }, function (response) {
                    // Optionally handle the response
                });
            }
        });




        // Corrected function to fetch warehouses based on the search term
        function fetchdata() {
            var storeId = $('#ManufacturingCompanyId').val();
            var pageSize = $('#pageSize').val();

            $.ajax({
                url: '@Url.Action("Index", "ManufacturingCompany")',
                type: 'GET',
                data: { storeId: storeId, pageSize: pageSize },
                success: function (result) {
                    const newTbody = $(result).find('#table > tbody').html();
                    $('#table > tbody').html(newTbody);

                    const pagination = $(result).find('.pagination').html();
                    $('.pagination').html(pagination);
                }
            });
        }



        $('#ManufacturingCompanyId, #pageSize').change(function () {
            fetchdata();
        });

      

    });




</script>