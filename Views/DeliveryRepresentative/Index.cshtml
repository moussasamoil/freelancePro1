@using lotus_blue.Models.ViewModel
@model PaginationViewModel<DeliveryCompanyViewModel>

@{
    ViewData["Title"] = " مندوبين  التوصيل";
}

<style>
  

</style>

<div class="row mb-3">
    <!-- First column -->

    <div class="col-lg w-100 my-auto mb-0 me-3 col-sm-12 p-relative text-nowrap">
        <select id="CountryId" name="CountryId" class="form-control drop-down-design" >
          
        </select>
    </div>

    <div class="col-lg w-100 my-auto mb-0 me-3 col-sm-12 p-relative text-nowrap">
        <select id="CityId" name="CityId" class="form-control drop-down-design">
        </select>
    </div>

    <div class="col-lg w-100 my-auto mb-0 me-3 col-sm-12 p-relative text-nowrap">
        <select id="DeliveryRepresentativeId" name="DeliveryRepresentativeId" class="form-control drop-down-design" >
        </select>
    </div>


    <!-- Second column -->
    <div class="col-lg-6 d-flex align-items-center justify-content-end">
        <div class="form-group d-flex align-items-center">
            <label for="pageSize" class="me-2">أظهر:</label>
            <select id="pageSize" name="pageSize" class="form-control me-2">
                <option value="10">10</option>
                <option value="25">25</option>
                <option value="50">50</option>
                <option value="100">100</option>
            </select>
            <label for="pageSize">مدخلات</label>
        </div>
    </div>


</div>



<table id="table" class="table">
    <thead>
        <tr>
            <th>#</th>
            <th> الصورة الشخصية</th>
            <th>اسم  المندوب</th>
            <th>رقم الهاتف</th>
            <th>البريد الالكتروني</th>
            <th>اختصاص المندوب</th>
            <th>الدولة </th>
            <th>المدينة </th>

            <th>الخيارات</th>
            <th>الفعالية</th>

        </tr>
    </thead>
    <tbody>
        @foreach (var company in Model.Items)
        {
            <tr>
                <td>@company.Id</td>
                <td>
                    @if (company.Logo != null)
                    {
                        <img loading="lazy" width="25" height="25" src="@company.Logo" alt="Company Logo">

                    }
                    else
                    {
                        <i class="fa-solid fa-circle-user fa-2xl mt-3" style="color: #d3d3d3;"></i>
                    }
                </td>
                <td>@company.Name</td>
                <td>@company.PhoneNumber</td>
                <td>@company.Email</td>
                <td>@company.Specialty</td>
                <td>@company.Country</td>
                <td>@company.City</td>

                <td>
                    <div class="d-inline-flex">
                        <a asp-action="Details" class="btn btn-outline-success" asp-route-id="@company.Id">التفاصيل</a>
                        <a asp-action="Edit" class="btn btn-yellow-v3 me-4" asp-route-id="@company.Id">تعديل</a>
                      
                    </div>
                </td>

                <td>
                    <div class="form-check form-switch">
                        <input class="form-check-input shown-checkbox" type="checkbox" id="IsShown-@company.Id" data-employee-id="@company.Id" @(company.IsShown ? "checked" : "unchecked")>
                        <label class="form-check-label" for="IsShown-@company.Id">  الظهور</label>
                    </div>
                    <div class="form-check form-switch">
                        <input class="form-check-input active-checkbox" type="checkbox" id="IsActive-@company.Id" data-employee-id="@company.Id" @(company.IsActive ? "checked" : "unchecked")>
                        <label class="form-check-label" for="IsActive-@company.Id"> مفعل</label>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- Display pagination controls -->
<div id="pagination-link" class="mt-0 container-fluid">
    <div class="d-flex justify-content-between align-items-center">

        <p class="text-start pt-2 total-items-display">@Model.TotalItems عدد المنتجات</p>

        <nav aria-label="Page navigation" class="mx-auto">
            <div class="d-flex justify-content-start">
                <ul class="pagination p-0">
                    <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link pointer" data-page="1">
                            <i class="fa-solid fa-chevron-double-right text-green"></i>
                        </a>
                    </li>
                    <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link" data-page="@(Model.CurrentPage - 1)">
                            <i class="fa-solid fa-chevron-right text-green"></i>
                        </a>
                    </li>

                    @{
                        int startPage = Model.CurrentPage;
                        int endPage = startPage + 2;
                        if (endPage > Model.TotalPages)
                        {
                            endPage = Model.TotalPages;
                        }
                    }

                    @for (int i = startPage; i <= endPage; i++)
                    {
                        <li class="numbers page-item @(Model.CurrentPage == i ? "active" : "")">
                            <a class="page-link" data-page="@i">@i</a>
                        </li>
                    }

                    @if (Model.TotalPages > endPage)
                    {
                        <li class="page-item disabled">
                            <span class="page-link">...</span>
                        </li>

                        @for (int i = Model.TotalPages - 2; i <= Model.TotalPages; i++)
                        {
                            <li class="numbers page-item @(Model.CurrentPage == i ? "active" : "")">
                                <a class="page-link" data-page="@i">@i</a>
                            </li>
                        }
                    }



                    <li class="page-item @(Model.CurrentPage ==  Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" data-page="@(Model.CurrentPage + 1)">
                            <i class="fa-solid fa-chevron-left text-green f-s-18"></i>
                        </a>
                    </li>
                    <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" data-page="@(Model.TotalPages)">
                            <i class="fa-solid fa-chevron-double-left text-green"></i>
                        </a>
                    </li>


                </ul>
            </div>
        </nav>


    </div>
</div>


<script>

    $(document).ready(function () {
        // Function to fetch data
        function fetchdata(page) {
            var countryId = $('#CountryId').val();
            var deliveryCompanyId = $('#DeliveryRepresentativeId').val();
            var pageSize = $('#pageSize').val();
            var cityId = $('#CityId').val(); // Added CityId

            $.ajax({
                url: '@Url.Action("Index", "DeliveryRepresentative")',
                type: 'GET',
                data: {
                    countryId: countryId, deliveryCompanyId: deliveryCompanyId, pageSize: pageSize, page: page, cityId: cityId, // Send CityId to the backend
                },
                success: function (response) {
                    $('#table').html($(response).find('#table').html());
                    $('.pagination').html($(response).find('.pagination').html());

                    // Re-bind the event handlers after replacing the content
                    bindCheckboxEvents();
                }
            });
        }

        // Function to bind checkbox events
        function bindCheckboxEvents() {
            $('.active-checkbox, .shown-checkbox').off('change').on('change', function () {
                var DeliveryrepresentativeId = $(this).data('employee-id');

                if ($(this).hasClass('active-checkbox')) {
                    var isActive = $(this).is(':checked');
                    $.post('/DeliveryRepresentative/SetIsActive', { DeliveryrepresentativeId: DeliveryrepresentativeId, isActive: isActive }, function (response) {
                        console.log('IsActive set to:', isActive);
                    });
                } else if ($(this).hasClass('shown-checkbox')) {
                    var isShown = $(this).is(':checked');
                    $.post('/DeliveryRepresentative/SetIsShown', { deliveryRepresentativeId: DeliveryrepresentativeId, isShown: isShown }, function (response) {
                        console.log('IsShown set to:', isShown);
                    });
                }
            });
        }

        // Initial binding of events
        bindCheckboxEvents();

        // Fetch data when filters change
        $('#CountryId, #CityId, #DeliveryRepresentativeId, #pageSize').change(function () {
            fetchdata();
        });

        // Event listener for pagination links
        $(document).on('click', '.pagination a.page-link', function (event) {
            event.preventDefault(); // Prevent the default action of clicking on a link

            // Extract the page number from the data-page attribute of the clicked element
            const page = $(this).data('page');

            // Call fetchData function with the extracted page number
            fetchdata(page);
        });

     
    });

</script>
