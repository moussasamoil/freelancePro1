@model lotus_blue.Models.ViewModel.StoreDataViewModel

<div class="container">
    <h1>Store Details</h1>
    <table class="table">
        <tr>
            <th>Property</th>
            <th>Value</th>
        </tr>
        <tr>
            <td>Id:</td>
            <td>@Model.Id</td>
        </tr>
        <tr>
            <td>Logo URL:</td>
            <td>@Model.LogoUrl</td>
        </tr>
        <tr>
            <td>Information URL:</td>
            <td>@Model.InformationUrl</td>
        </tr>
        <tr>
            <td>Name:</td>
            <td>@Model.Name</td>
        </tr>
        <tr>
            <td>Tax Registration Number:</td>
            <td>@Model.TaxRegistrationNumber</td>
        </tr>
        <tr>
            <td>Address:</td>
            <td>@Model.Address</td>
        </tr>
        <tr>
            <td>Id Number:</td>
            <td>@Model.IdNumber</td>
        </tr>
        <tr>
            <td>Phone Number:</td>
            <td>@Model.PhoneNumber</td>
        </tr>
        <tr>
            <td>Specialty:</td>
            <td>@Model.Specialty</td>
        </tr>
        <tr>
            <td>Website:</td>
            <td>@Model.Website</td>
        </tr>
        <tr>
            <td>Notes:</td>
            <td>@Model.Notes</td>
        </tr>
        <tr>
            <td>Selected Country:</td>
            <td>@Model.SelectedCountry</td>
        </tr>
        <tr>
            <td>City:</td>
            <td>@Model.City</td>
        </tr>
    </table>
</div>
