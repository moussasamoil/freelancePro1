@page
@model LoginModel
@using System.Linq
@using System.Text.Json

@{
    Layout = "_LoginLayout";

    var loginModelStateErrorMessage = ViewData.ModelState.Values
        .SelectMany(v => v.Errors)
        .Select(e => !string.IsNullOrWhiteSpace(e.ErrorMessage) ? e.ErrorMessage : e.Exception?.Message)
        .FirstOrDefault(e => !string.IsNullOrWhiteSpace(e));

    var loginTempDataErrorMessage = TempData["LoginErrorMessage"]?.ToString();

    var loginServerErrorMessage = !string.IsNullOrWhiteSpace(Model.ErrorMessage)
        ? Model.ErrorMessage
        : (!string.IsNullOrWhiteSpace(loginTempDataErrorMessage)
            ? loginTempDataErrorMessage
            : loginModelStateErrorMessage);

    var profiles = Model.EmployeeLoginProfiles ?? new List<LoginModel.LoginEmployeeProfile>();
    var firstProfile = profiles.FirstOrDefault();

    var postedEmail = Model.Input?.Email ?? string.Empty;
    var postedEmailExistsInProfiles = profiles.Any(p =>
        string.Equals(p.Email, postedEmail, StringComparison.OrdinalIgnoreCase));

    /*
        لو المستخدم دخل من إضافة مستخدم وظهر Error مثل "لا يسمح بالدخول" أو Invalid login،
        نخليه على شاشة الإيميل والباسورد ولا نرجعهش لشاشة صور المستخدمين.
        أما لو الخطأ لحساب موجود في صور الجهاز، يفضل على شاشة الصورة المختارة.
    */
    var manualLogin = Model.ManualLogin
        || (!string.IsNullOrWhiteSpace(loginServerErrorMessage)
            && !string.IsNullOrWhiteSpace(postedEmail)
            && !postedEmailExistsInProfiles);

    var manualEmailValue = manualLogin ? postedEmail : string.Empty;

    var selectedEmail = !manualLogin && !string.IsNullOrWhiteSpace(postedEmail)
        ? postedEmail
        : firstProfile?.Email;

    var selectedProfile = profiles.FirstOrDefault(p => string.Equals(p.Email, selectedEmail, StringComparison.OrdinalIgnoreCase))
        ?? firstProfile;

    // نبدأ بإخفاء كروت الحسابات لحد ما IP الجهاز يتحمّل ويتعمل فلترة،
    // عشان بعد Logout ما تظهرش كل الحسابات لثانية قبل الإخفاء.
    var profileHeroInitialClass = manualLogin ? "login-mode-hidden" : "login-ip-filter-pending";
    var profileHeroInitialStyle = manualLogin ? "" : "visibility:hidden;";

    var profilesJson = JsonSerializer.Serialize(profiles.Select(p => new
    {
        email = p.Email,
        name = p.Name,
        imageUrl = p.ImageUrl,
        allowedIpAddress = p.AllowedIpAddress
    }));
}

<button type="button"
        id="loginOpenProfilesDrawer"
        class="login-top-user-btn"
        aria-label="إعدادات المستخدمين"
        title="إعدادات المستخدمين">
    <svg class="login-top-user-svg" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M12 12c2.35 0 4.25-1.9 4.25-4.25S14.35 3.5 12 3.5s-4.25 1.9-4.25 4.25S9.65 12 12 12Zm0 2.15c-3.45 0-6.75 1.72-6.75 4.05v.55c0 .55.45 1 1 1h11.5c.55 0 1-.45 1-1v-.55c0-2.33-3.3-4.05-6.75-4.05Z" />
    </svg>
</button>

<div id="loginProfilesOverlay" class="login-profiles-overlay"></div>

<aside id="loginProfilesDrawer" class="login-profiles-drawer" aria-hidden="true">
    <div class="login-profiles-header-panel">
        <button type="button" id="loginCloseProfilesDrawer" class="login-profiles-back-btn" aria-label="رجوع">›</button>
        <div class="login-profiles-title">إعدادات المستخدم</div>
    </div>

    <div class="login-profiles-card">
        <div id="loginProfilesList" class="login-profiles-list login-ip-filter-pending" style="visibility:hidden;">
            @foreach (var profile in profiles)
            {
                <button type="button"
                        class="login-profile-row"
                        draggable="false"
                        data-email="@profile.Email"
                        data-name="@profile.Name"
                        data-image="@profile.ImageUrl"
                        data-allowed-ips="@profile.AllowedIpAddress">
                    <span class="login-profile-drag">☰</span>

                    <span class="login-profile-avatar-wrap">
                        <img src="@profile.ImageUrl"
                             alt="@profile.Name"
                             class="login-profile-avatar"
                             onerror="this.onerror=null;this.src='/static/DefaultImage.svg';" />
                    </span>

                    <span class="login-profile-text">
                        <span class="login-profile-name">@profile.Name</span>
                    </span>
                </button>
            }
        </div>

        <div id="loginNoIpUsersMessage" class="login-no-ip-users-message login-mode-hidden">
            لا يوجد موظفون متاحون على نفس IP الحالي
        </div>
    </div>

    <button type="button" id="loginAddUserBtn" class="login-add-user-card-button">
        <span class="login-add-plus">+</span>
        <span>إضافة مستخدم</span>

    </button>
</aside>

<div class="d-flex justify-content-center">
    <div class="col-lg-3 col-sm-12 col-md-12 text-center login-box">
        <div id="loginManualHero" class="login-manual-hero @(manualLogin ? "" : "login-mode-hidden")">
            <img id="loginMainLogo"
                 src="/static/011.png"
                 width="100"
                 height="100"
                 class="login-main-logo" />

            <h2 class="mt-4 login-main-title">مرحبا بكم</h2>
        </div>

        <div id="loginProfileHeroBlock" class="login-profile-hero-block @profileHeroInitialClass" style="@profileHeroInitialStyle">
            <div id="loginEmployeeHero" class="login-employee-hero">
                <button type="button" id="loginCarouselPrevArrow" class="login-carousel-arrow login-carousel-arrow-prev login-mode-hidden" aria-label="السابق">‹</button>

                <button type="button" id="loginPrevProfile" class="login-side-profile-btn login-side-profile-prev" aria-label="السابق">
                    <img id="loginPrevProfileImage"
                         src="/static/DefaultImage.svg"
                         alt="السابق"
                         class="login-side-profile-image"
                         onerror="this.onerror=null;this.src='/static/DefaultImage.svg';" />
                </button>

                <img id="loginSelectedProfileImage"
                     src="@(selectedProfile?.ImageUrl ?? "/static/DefaultImage.svg")"
                     alt="@(selectedProfile?.Name ?? "User")"
                     width="108"
                     height="108"
                     class="login-main-logo login-selected-profile-image"
                     onerror="this.onerror=null;this.src='/static/DefaultImage.svg';" />

                <button type="button" id="loginNextProfile" class="login-side-profile-btn login-side-profile-next" aria-label="التالي">
                    <img id="loginNextProfileImage"
                         src="/static/DefaultImage.svg"
                         alt="التالي"
                         class="login-side-profile-image"
                         onerror="this.onerror=null;this.src='/static/DefaultImage.svg';" />
                </button>

                <button type="button" id="loginCarouselNextArrow" class="login-carousel-arrow login-carousel-arrow-next login-mode-hidden" aria-label="التالي">›</button>
            </div>

            <h2 id="loginSelectedProfileName" class="mt-4 login-main-title">
                @(selectedProfile?.Name ?? "اختر المستخدم")
            </h2>
        </div>

        @if (!string.IsNullOrWhiteSpace(loginServerErrorMessage))
        {
            <div id="loginIpErrorPopup" class="login-ip-error-popup login-warning-popup" role="alert" aria-live="assertive">
                <div class="login-ip-error-icon login-warning-icon" aria-hidden="true">
                    <svg class="login-warning-svg" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" focusable="false">
                        <path d="M12 2.75c.65 0 1.23.35 1.55.91l8.22 14.24c.32.56.32 1.24-.01 1.8-.33.55-.91.9-1.55.9H3.79c-.64 0-1.22-.35-1.55-.9-.33-.56-.33-1.24-.01-1.8L10.45 3.66c.32-.56.9-.91 1.55-.91Z" />
                        <path class="login-warning-svg-cut" d="M12 8.1c.52 0 .94.42.94.94v4.72a.94.94 0 0 1-1.88 0V9.04c0-.52.42-.94.94-.94Zm0 8.05a1.12 1.12 0 1 1 0 2.24 1.12 1.12 0 0 1 0-2.24Z" />
                    </svg>
                </div>
                <div class="login-ip-error-content login-warning-content">
                    <div class="login-ip-error-title login-warning-title">تنبيه</div>
                    <div class="login-ip-error-text login-warning-text">@loginServerErrorMessage</div>
                </div>
            </div>
        }

        <form id="account" method="post">
            <input type="hidden"
                   asp-for="Input.ClientPublicIp"
                   id="ClientPublicIp" />

            <input type="hidden"
                   asp-for="Input.ClientIpLocation"
                   id="ClientIpLocation" />

            <input type="hidden"
                   name="Input.ClientDeviceType"
                   id="ClientDeviceType" />

            <input type="hidden"
                   name="Input.ClientUserAgent"
                   id="ClientUserAgent" />

            <input type="hidden"
                   asp-for="ManualLogin"
                   id="ManualLogin"
                   value="@(manualLogin ? "true" : "false")" />

            <input type="hidden"
                   asp-for="Input.Email"
                   id="loginSelectedEmail"
                   value="@(manualLogin ? manualEmailValue : selectedProfile?.Email)" />

            <div id="loginManualEmailGroup" class="form-group mt-3 @(manualLogin ? "" : "login-mode-hidden")">
                <input placeholder="أدخل البريد الإلكتروني"
                       id="loginManualEmailInput"
                       name="ManualEmailPreview"
                       value="@manualEmailValue"
                       class="form-control input centered-placeholder login-email-input"
                       autocomplete="off"
                       data-lpignore="true"
                       aria-required="true" />

                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <div class="form-group mt-3">
                <input placeholder="أدخل كلمة المرور"
                       asp-for="Input.Password"
                       class="form-control input centered-placeholder"
                       autocomplete="new-password"
                       data-lpignore="true"
                       data-form-type="other"
                       value=""
                       aria-required="true" />

                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <div class="form-group mt-3">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            </div>

            <div class="form-group mt-3">
                <button id="loginSubmitBtn"
                        type="submit"
                        class="btn btn-primary login-submit-btn">
                    تسجيل الدخول
                </button>
            </div>
        </form>
    </div>
</div>


<style id="login-show-same-ip-employees-only-style">
    .login-profile-row.is-ip-hidden,
    #loginProfilesList .login-profile-row.is-ip-hidden {
        display: none !important;
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        window.loginEmployeeProfiles = @Html.Raw(profilesJson);
        window.loginManualMode = @(manualLogin ? "true" : "false");
        window.loginCurrentPublicIp = "";
        window.loginClientIpIsLoaded = false;
        window.loginClientIpLoadPromise = null;

        (function setLoginDeviceInformation() {
            function detectLoginDeviceType() {
                var ua = navigator.userAgent || "";
                var uaLower = ua.toLowerCase();
                var platform = navigator.platform || "";

                var isIpadDesktopMode =
                    platform.toLowerCase() === "macintel" &&
                    navigator.maxTouchPoints &&
                    navigator.maxTouchPoints > 1;

                var isTablet =
                    /ipad|tablet|kindle|silk|playbook/i.test(ua) ||
                    isIpadDesktopMode ||
                    (uaLower.indexOf("android") >= 0 && uaLower.indexOf("mobile") < 0);

                var isMobile =
                    /mobi|iphone|ipod|windows phone|blackberry|opera mini|opera mobi/i.test(ua) ||
                    (uaLower.indexOf("android") >= 0 && uaLower.indexOf("mobile") >= 0);

                if (isTablet) {
                    return "tablet";
                }

                if (isMobile) {
                    return "mobile";
                }

                return "desktop";
            }

            var deviceTypeInput = document.getElementById("ClientDeviceType");
            var userAgentInput = document.getElementById("ClientUserAgent");

            if (deviceTypeInput) {
                deviceTypeInput.value = detectLoginDeviceType();
            }

            if (userAgentInput) {
                userAgentInput.value = navigator.userAgent || "";
            }
        })();

        (function () {
            function normalizeIpForLogin(ip) {
                if (!ip) return "";

                ip = String(ip).trim();

                if (ip.indexOf(",") >= 0) {
                    ip = ip.split(",")[0].trim();
                }

                if (ip === "::1") {
                    return "127.0.0.1";
                }

                if (ip.indexOf("::ffff:") === 0) {
                    ip = ip.replace("::ffff:", "");
                }

                return ip;
            }

            function notifyClientIpLoaded(ip) {
                const normalizedIp = normalizeIpForLogin(ip);

                window.loginCurrentPublicIp = normalizedIp;
                window.loginClientIpIsLoaded = true;

                window.dispatchEvent(new CustomEvent("loginClientIpLoaded", {
                    detail: {
                        ip: normalizedIp
                    }
                }));
            }

            async function loadClientPublicIpForLogin() {
                const publicIpInput = document.getElementById('ClientPublicIp');
                const locationInput = document.getElementById('ClientIpLocation');

                function buildLocationText(data) {
                    const parts = [];

                    if (data.city) parts.push(data.city);
                    if (data.region) parts.push(data.region);
                    if (data.country_name) parts.push(data.country_name);

                    return parts.join(' - ');
                }

                try {
                    const response = await fetch('https://ipapi.co/json/', {
                        method: 'GET',
                        cache: 'no-store'
                    });

                    if (!response.ok) {
                        throw new Error('Failed to load public IP location');
                    }

                    const data = await response.json();
                    const currentPublicIp = data && data.ip ? data.ip : "";
                    const currentLocation = data ? buildLocationText(data) : "";

                    if (publicIpInput) {
                        publicIpInput.value = normalizeIpForLogin(currentPublicIp);
                    }

                    if (locationInput) {
                        locationInput.value = currentLocation;
                    }

                    notifyClientIpLoaded(currentPublicIp);
                } catch (error) {
                    try {
                        const fallbackResponse = await fetch('https://api.ipify.org?format=json', {
                            method: 'GET',
                            cache: 'no-store'
                        });

                        const fallbackData = await fallbackResponse.json();
                        const fallbackIp = fallbackData && fallbackData.ip ? fallbackData.ip : "";

                        if (publicIpInput) {
                            publicIpInput.value = normalizeIpForLogin(fallbackIp);
                        }

                        if (locationInput) {
                            locationInput.value = "";
                        }

                        notifyClientIpLoaded(fallbackIp);
                    } catch {
                        notifyClientIpLoaded("");
                    }
                }
            }

            window.loginClientIpLoadPromise = loadClientPublicIpForLogin();
        })();

        (function setupLoginProfilesDrawer() {
            const storageKey = 'luxiraLoginProfileOrder';
            const lastSelectedStorageKey = 'luxiraLoginLastSelectedProfileEmail';

            function getLoginQueryValue(name) {
                try {
                    return new URLSearchParams(window.location.search).get(name) || '';
                } catch {
                    return '';
                }
            }

            function getCookieValue(name) {
                const encodedName = encodeURIComponent(name) + '=';
                const parts = document.cookie ? document.cookie.split(';') : [];

                for (let i = 0; i < parts.length; i++) {
                    const part = parts[i].trim();

                    if (part.indexOf(encodedName) === 0) {
                        return decodeURIComponent(part.substring(encodedName.length));
                    }
                }

                return '';
            }

            const preferredAdminEmailFromLogout =
                getLoginQueryValue('selectedEmail') ||
                getCookieValue('LuxiraLoginPreferredEmail') ||
                sessionStorage.getItem(lastSelectedStorageKey) ||
                '';

            if (preferredAdminEmailFromLogout) {
                localStorage.setItem(lastSelectedStorageKey, preferredAdminEmailFromLogout);
            }

            const openBtn = document.getElementById('loginOpenProfilesDrawer');
            const closeBtn = document.getElementById('loginCloseProfilesDrawer');
            const drawer = document.getElementById('loginProfilesDrawer');
            const overlay = document.getElementById('loginProfilesOverlay');
            const list = document.getElementById('loginProfilesList');
            const noIpUsersMessage = document.getElementById('loginNoIpUsersMessage');

            const selectedEmailInput = document.getElementById('loginSelectedEmail');
            const selectedImage = document.getElementById('loginSelectedProfileImage');
            const selectedName = document.getElementById('loginSelectedProfileName');

            const prevBtn = document.getElementById('loginPrevProfile');
            const nextBtn = document.getElementById('loginNextProfile');
            const carouselPrevArrow = document.getElementById('loginCarouselPrevArrow');
            const carouselNextArrow = document.getElementById('loginCarouselNextArrow');
            const prevImage = document.getElementById('loginPrevProfileImage');
            const nextImage = document.getElementById('loginNextProfileImage');
            const employeeHero = document.getElementById('loginEmployeeHero');

            const manualLoginInput = document.getElementById('ManualLogin');
            const manualHero = document.getElementById('loginManualHero');
            const profileHeroBlock = document.getElementById('loginProfileHeroBlock');
            const manualEmailGroup = document.getElementById('loginManualEmailGroup');
            const manualEmailInput = document.getElementById('loginManualEmailInput');
            const accountForm = document.getElementById('account');

            let draggedRow = null;
            let currentPublicIp = "";
            let isSubmittingAfterIpWait = false;

            function removeIpFilterPendingState() {
                if (list) {
                    list.classList.remove('login-ip-filter-pending');
                    list.style.visibility = '';
                }

                if (profileHeroBlock) {
                    profileHeroBlock.classList.remove('login-ip-filter-pending');
                    profileHeroBlock.style.visibility = '';
                }
            }

            function normalizeIp(ip) {
                if (!ip) return "";

                ip = String(ip).trim();

                if (ip.indexOf(",") >= 0) {
                    ip = ip.split(",")[0].trim();
                }

                if (ip === "::1") {
                    return "127.0.0.1";
                }

                if (ip.indexOf("::ffff:") === 0) {
                    ip = ip.replace("::ffff:", "");
                }

                return ip;
            }

            function splitAllowedIps(value) {
                if (!value) return [];

                return String(value)
                    .split(/[,;\s]+/)
                    .map(normalizeIp)
                    .filter(Boolean);
            }

            function emailsEqual(firstEmail, secondEmail) {
                return (firstEmail || '').toLowerCase() === (secondEmail || '').toLowerCase();
            }

            function getRows(includeHidden) {
                const rows = Array.from(document.querySelectorAll('.login-profile-row'));

                if (includeHidden) {
                    return rows;
                }

                return rows.filter(row => !row.classList.contains('is-ip-hidden'));
            }

            function getStoredLastSelectedEmail() {
                return localStorage.getItem(lastSelectedStorageKey) || '';
            }

            function saveLastSelectedEmail(email) {
                if (!email) return;

                localStorage.setItem(lastSelectedStorageKey, email);
            }

            function clearLoginWarningMessage() {
                const errorPopup = document.getElementById('loginIpErrorPopup');

                if (errorPopup) {
                    errorPopup.classList.add('login-mode-hidden');
                    errorPopup.setAttribute('aria-hidden', 'true');
                }

                document.querySelectorAll('#account .validation-summary-errors, #account .field-validation-error').forEach(function (element) {
                    element.classList.add('login-mode-hidden');
                });
            }

            function setManualMode(clearEmail) {
                window.loginManualMode = true;

                if (manualLoginInput) {
                    manualLoginInput.value = 'true';
                }

                if (manualHero) {
                    manualHero.classList.remove('login-mode-hidden');
                }

                if (profileHeroBlock) {
                    profileHeroBlock.classList.add('login-mode-hidden');
                    profileHeroBlock.classList.remove('login-ip-filter-pending');
                    profileHeroBlock.style.visibility = '';
                }

                if (list) {
                    list.classList.remove('login-ip-filter-pending');
                    list.style.visibility = '';
                }

                if (manualEmailGroup) {
                    manualEmailGroup.classList.remove('login-mode-hidden');
                }

                getRows(true).forEach(r => r.classList.remove('is-selected'));

                if (selectedEmailInput) {
                    selectedEmailInput.value = '';
                }

                if (clearEmail && manualEmailInput) {
                    manualEmailInput.value = '';
                }

                const passwordInput = document.getElementById('Input_Password');

                if (passwordInput) {
                    passwordInput.value = '';
                    passwordInput.setAttribute('autocomplete', 'new-password');
                }

                if (manualEmailInput) {
                    setTimeout(() => manualEmailInput.focus(), 120);
                }
            }

            function setProfileMode() {
                window.loginManualMode = false;

                if (manualLoginInput) {
                    manualLoginInput.value = 'false';
                }

                if (manualHero) {
                    manualHero.classList.add('login-mode-hidden');
                }

                if (profileHeroBlock) {
                    profileHeroBlock.classList.remove('login-mode-hidden');
                    profileHeroBlock.classList.remove('login-ip-filter-pending');
                    profileHeroBlock.style.visibility = '';
                }

                if (list) {
                    list.classList.remove('login-ip-filter-pending');
                    list.style.visibility = '';
                }

                if (manualEmailGroup) {
                    manualEmailGroup.classList.add('login-mode-hidden');
                }
            }

            function saveCurrentOrder() {
                if (!list) return;

                const emails = getRows(true)
                    .map(row => row.dataset.email)
                    .filter(Boolean);

                localStorage.setItem(storageKey, JSON.stringify(emails));
            }

            function applyStoredOrder() {
                if (!list) return;

                let saved = [];

                try {
                    saved = JSON.parse(localStorage.getItem(storageKey) || '[]');
                } catch {
                    saved = [];
                }

                if (!saved.length) return;

                const rows = getRows(true);
                const byEmail = {};

                rows.forEach(row => {
                    byEmail[(row.dataset.email || '').toLowerCase()] = row;
                });

                saved.forEach(email => {
                    const row = byEmail[(email || '').toLowerCase()];

                    if (row) {
                        list.appendChild(row);
                    }
                });
            }

            function setSideProfile(button, image, row) {
                if (!button || !image || !row) return;

                const imageUrl = row.dataset.image || '/static/DefaultImage.svg';
                const name = row.dataset.name || row.dataset.email || 'User';

                image.src = imageUrl;
                image.alt = name;
                button.title = name;
                button.classList.remove('login-mode-hidden');
                button.disabled = false;
            }

            function hideSideProfile(button) {
                if (!button) return;

                button.classList.add('login-mode-hidden');
                button.disabled = true;
                button.removeAttribute('title');
            }

            function setCarouselArrowsVisible(visible) {
                [carouselPrevArrow, carouselNextArrow].forEach(function (btn) {
                    if (!btn) return;

                    btn.classList.toggle('login-mode-hidden', !visible);
                    btn.disabled = !visible;
                });
            }

            function showNoProfilesState() {
                /*
                    مفيش أي حساب محفوظ/متاح على نفس الجهاز الحالي:
                    نفتح شاشة اللوجين اليدوي مباشرة بدل ما نعرض كارت صور فاضي.
                */
                setManualMode(false);

                if (selectedEmailInput) {
                    selectedEmailInput.value = '';
                }

                getRows(true).forEach(r => r.classList.remove('is-selected'));

                hideSideProfile(prevBtn);
                hideSideProfile(nextBtn);

                if (employeeHero) {
                    employeeHero.classList.remove('is-single-profile', 'is-two-profiles', 'is-three-profiles', 'is-many-profiles', 'has-extra-profiles');
                }

                setCarouselArrowsVisible(false);

                if (noIpUsersMessage) {
                    noIpUsersMessage.classList.add('login-mode-hidden');
                }
            }

            function updateHeroSideImages() {
                const rows = getRows();

                if (!rows.length) {
                    showNoProfilesState();
                    return;
                }

                if (noIpUsersMessage) {
                    noIpUsersMessage.classList.add('login-mode-hidden');
                }

                if (employeeHero) {
                    employeeHero.classList.remove('is-single-profile', 'is-two-profiles', 'is-three-profiles', 'is-many-profiles', 'has-extra-profiles');
                }

                setCarouselArrowsVisible(false);

                const currentIndex = getSelectedIndex();

                if (rows.length === 1) {
                    /* حساب واحد فقط: صورة واحدة في النص + الاسم + الباسورد بدون خيارات صور جانبية */
                    hideSideProfile(prevBtn);
                    hideSideProfile(nextBtn);

                    if (employeeHero) {
                        employeeHero.classList.add('is-single-profile');
                    }

                    return;
                }

                if (rows.length === 2) {
                    /* حسابين فقط: الصورة المختارة + صورة الحساب الثاني فقط، بدون أزرار أسهم */
                    const otherIndex = (currentIndex + 1) % rows.length;

                    hideSideProfile(prevBtn);
                    setSideProfile(nextBtn, nextImage, rows[otherIndex]);

                    if (employeeHero) {
                        employeeHero.classList.add('is-two-profiles');
                    }

                    return;
                }

                const prevIndex = (currentIndex - 1 + rows.length) % rows.length;
                const nextIndex = (currentIndex + 1) % rows.length;

                setSideProfile(prevBtn, prevImage, rows[prevIndex]);
                setSideProfile(nextBtn, nextImage, rows[nextIndex]);

                if (employeeHero) {
                    if (rows.length === 3) {
                        /* 3 حسابات: صورة في النص وصورتين على الجنب فقط، بدون أسهم */
                        employeeHero.classList.add('is-three-profiles');
                    } else {
                        /* أكثر من 3 حسابات: تظهر أسهم التقليب لأن فيه حسابات زيادة مش ظاهرة */
                        employeeHero.classList.add('is-many-profiles', 'has-extra-profiles');
                        setCarouselArrowsVisible(true);
                    }
                }
            }

            function selectProfile(row, closeAfterSelect, shouldPersist) {
                if (!row || row.classList.contains('is-ip-hidden')) return;

                if (shouldPersist !== false || closeAfterSelect === true) {
                    clearLoginWarningMessage();
                }

                setProfileMode();

                const email = row.dataset.email || '';
                const name = row.dataset.name || email;
                const image = row.dataset.image || '/static/DefaultImage.svg';

                if (selectedEmailInput) selectedEmailInput.value = email;

                if (selectedImage) {
                    selectedImage.src = image;
                    selectedImage.alt = name;
                }

                if (selectedName) selectedName.textContent = name;

                getRows(true).forEach(r => r.classList.remove('is-selected'));
                row.classList.add('is-selected');

                if (shouldPersist !== false) {
                    saveLastSelectedEmail(email);
                }

                updateHeroSideImages();

                if (closeAfterSelect) {
                    closeDrawer();
                }

                const passwordInput = document.getElementById('Input_Password');
                if (passwordInput) {
                    passwordInput.value = '';
                    passwordInput.setAttribute('autocomplete', 'new-password');

                    setTimeout(() => passwordInput.focus(), 150);
                }
            }

            function getSelectedIndex() {
                const rows = getRows();

                if (!rows.length) return -1;

                const currentEmail = selectedEmailInput ? (selectedEmailInput.value || '').toLowerCase() : '';
                let index = rows.findIndex(row => (row.dataset.email || '').toLowerCase() === currentEmail);

                return index < 0 ? 0 : index;
            }

            function findVisibleRowByEmail(email) {
                if (!email) return null;

                return getRows().find(row => emailsEqual(row.dataset.email, email)) || null;
            }

            function selectInitialVisibleProfile() {
                const rows = getRows();

                if (!rows.length) {
                    showNoProfilesState();
                    return;
                }

                const savedEmail = getStoredLastSelectedEmail();
                const currentEmail = selectedEmailInput ? selectedEmailInput.value : '';

                const selectedRow =
                    findVisibleRowByEmail(preferredAdminEmailFromLogout)
                    || findVisibleRowByEmail(savedEmail)
                    || findVisibleRowByEmail(currentEmail)
                    || rows[0];

                selectProfile(selectedRow, false, false);
            }

            function moveProfile(step) {
                const rows = getRows();
                if (!rows.length) return;

                const currentIndex = getSelectedIndex();
                const nextIndex = (currentIndex + step + rows.length) % rows.length;

                selectProfile(rows[nextIndex], false, true);
            }

            function openDrawer() {
                drawer.classList.add('is-open');
                overlay.classList.add('is-open');
                drawer.setAttribute('aria-hidden', 'false');

                if (openBtn) {
                    openBtn.classList.add('is-hidden');
                }
            }

            function closeDrawer() {
                drawer.classList.remove('is-open');
                overlay.classList.remove('is-open');
                drawer.setAttribute('aria-hidden', 'true');

                if (openBtn) {
                    openBtn.classList.remove('is-hidden');
                }
            }

            function getDragAfterElement(container, y) {
                const draggableElements = [...container.querySelectorAll('.login-profile-row:not(.is-dragging):not(.is-ip-hidden)')];

                return draggableElements.reduce((closest, child) => {
                    const box = child.getBoundingClientRect();
                    const offset = y - box.top - box.height / 2;

                    if (offset < 0 && offset > closest.offset) {
                        return { offset: offset, element: child };
                    }

                    return closest;
                }, { offset: Number.NEGATIVE_INFINITY }).element;
            }

            function setupSorting() {
                if (!list) return;

                let placeholder = null;
                let floatingRow = null;
                let dragOffsetY = 0;
                let dragOffsetX = 0;
                let activePointerId = null;
                let lastPointerX = 0;
                let lastPointerY = 0;
                let justFinishedDrag = false;

                function getPointerClient(event) {
                    return {
                        x: event.clientX || 0,
                        y: event.clientY || 0
                    };
                }

                function createPlaceholder(row) {
                    const rowRect = row.getBoundingClientRect();
                    const place = document.createElement('div');

                    place.className = 'login-profile-drag-placeholder';
                    place.style.height = rowRect.height + 'px';

                    return place;
                }

                function createFloatingRow(row, startX, startY) {
                    const rowRect = row.getBoundingClientRect();
                    const listRect = list.getBoundingClientRect();
                    const clone = row.cloneNode(true);

                    clone.classList.remove('is-selected', 'is-dragging', 'is-being-dragged-source');
                    clone.classList.add('login-profile-floating-drag');
                    clone.removeAttribute('id');
                    clone.setAttribute('draggable', 'false');

                    clone.style.width = listRect.width + 'px';
                    clone.style.left = listRect.left + 'px';
                    clone.style.top = rowRect.top + 'px';

                    dragOffsetY = startY - rowRect.top;
                    dragOffsetX = startX - rowRect.left;

                    document.body.appendChild(clone);

                    return clone;
                }

                function updateFloatingPosition(clientX, clientY) {
                    if (!floatingRow) return;

                    const listRect = list.getBoundingClientRect();
                    const drawerRect = drawer ? drawer.getBoundingClientRect() : listRect;
                    const floatingHeight = floatingRow.offsetHeight || 70;

                    let top = clientY - dragOffsetY;

                    const minTop = Math.max(drawerRect.top + 4, listRect.top - 8);
                    const maxTop = Math.min(drawerRect.bottom - floatingHeight - 4, window.innerHeight - floatingHeight - 4);

                    if (Number.isFinite(minTop) && Number.isFinite(maxTop) && maxTop > minTop) {
                        top = Math.max(minTop, Math.min(top, maxTop));
                    }

                    floatingRow.style.left = listRect.left + 'px';
                    floatingRow.style.width = listRect.width + 'px';
                    floatingRow.style.top = top + 'px';
                }

                function movePlaceholder(clientY) {
                    if (!placeholder) return;

                    const afterElement = getDragAfterElement(list, clientY);

                    if (afterElement == null) {
                        list.appendChild(placeholder);
                    } else if (afterElement !== placeholder) {
                        list.insertBefore(placeholder, afterElement);
                    }
                }

                function finishDrag() {
                    document.removeEventListener('pointermove', onPointerMove, true);
                    document.removeEventListener('pointerup', onPointerUp, true);
                    document.removeEventListener('pointercancel', onPointerCancel, true);

                    if (draggedRow && placeholder && placeholder.parentNode === list) {
                        list.insertBefore(draggedRow, placeholder);
                    }

                    if (draggedRow) {
                        draggedRow.classList.remove('is-dragging', 'is-being-dragged-source');
                        draggedRow.style.display = '';
                    }

                    if (placeholder && placeholder.parentNode) {
                        placeholder.parentNode.removeChild(placeholder);
                    }

                    if (floatingRow && floatingRow.parentNode) {
                        floatingRow.parentNode.removeChild(floatingRow);
                    }

                    placeholder = null;
                    floatingRow = null;
                    activePointerId = null;

                    if (draggedRow) {
                        justFinishedDrag = true;
                        setTimeout(function () {
                            justFinishedDrag = false;
                        }, 250);
                    }

                    draggedRow = null;
                    saveCurrentOrder();
                    updateHeroSideImages();
                }

                function cancelDrag() {
                    finishDrag();
                }

                function onPointerMove(event) {
                    if (!draggedRow || activePointerId !== event.pointerId) return;

                    event.preventDefault();

                    const point = getPointerClient(event);
                    lastPointerX = point.x;
                    lastPointerY = point.y;

                    updateFloatingPosition(point.x, point.y);
                    movePlaceholder(point.y);
                }

                function onPointerUp(event) {
                    if (activePointerId !== null && activePointerId !== event.pointerId) return;

                    event.preventDefault();
                    finishDrag();
                }

                function onPointerCancel(event) {
                    if (activePointerId !== null && activePointerId !== event.pointerId) return;

                    event.preventDefault();
                    cancelDrag();
                }

                function startDrag(row, event) {
                    if (!row || row.classList.contains('is-ip-hidden')) return;

                    event.preventDefault();
                    event.stopPropagation();

                    const point = getPointerClient(event);
                    lastPointerX = point.x;
                    lastPointerY = point.y;

                    draggedRow = row;
                    activePointerId = event.pointerId;

                    placeholder = createPlaceholder(row);
                    floatingRow = createFloatingRow(row, point.x, point.y);

                    row.classList.add('is-dragging', 'is-being-dragged-source');

                    list.insertBefore(placeholder, row);
                    row.style.display = 'none';

                    updateFloatingPosition(point.x, point.y);

                    document.addEventListener('pointermove', onPointerMove, true);
                    document.addEventListener('pointerup', onPointerUp, true);
                    document.addEventListener('pointercancel', onPointerCancel, true);
                }

                getRows(true).forEach(row => {
                    row.setAttribute('draggable', 'false');

                    const dragHandle = row.querySelector('.login-profile-drag');

                    if (!dragHandle) return;

                    dragHandle.setAttribute('role', 'button');
                    dragHandle.setAttribute('aria-label', 'تغيير ترتيب المستخدم');
                    dragHandle.setAttribute('title', 'تغيير ترتيب المستخدم');

                    dragHandle.addEventListener('pointerdown', function (event) {
                        startDrag(row, event);
                    }, { passive: false });

                    dragHandle.addEventListener('click', function (event) {
                        event.preventDefault();
                        event.stopPropagation();
                    });
                });

                list.addEventListener('dragstart', function (event) {
                    event.preventDefault();
                }, true);

                list.addEventListener('click', function (event) {
                    if (!justFinishedDrag) return;

                    event.preventDefault();
                    event.stopPropagation();

                    if (typeof event.stopImmediatePropagation === 'function') {
                        event.stopImmediatePropagation();
                    }
                }, true);
            }

            function applyCurrentIpFilter(ip) {
                currentPublicIp = normalizeIp(ip);

                /*
                    عرض موظفي نفس IP فقط:
                    الموظف يظهر في صفحة تسجيل الدخول إذا كان IP الحالي موجودًا
                    داخل AllowedIpAddress الخاص بالشيفت الفعال.
                */
                let visibleRowsCount = 0;

                getRows(true).forEach(row => {
                    const allowedIps = splitAllowedIps(row.dataset.allowedIps || row.getAttribute('data-allowed-ips') || '');
                    const isSameIp =
                        currentPublicIp &&
                        allowedIps.some(allowedIp => normalizeIp(allowedIp) === currentPublicIp);

                    row.classList.toggle('is-ip-hidden', !isSameIp);

                    if (isSameIp) {
                        visibleRowsCount++;
                    }
                });

                removeIpFilterPendingState();

                if (noIpUsersMessage) {
                    noIpUsersMessage.classList.toggle('login-mode-hidden', visibleRowsCount > 0);
                }

                /*
                    مهم: لو الصفحة في Manual Login بسبب إضافة مستخدم أو بسبب Error،
                    ما نرجعهاش تلقائيًا لشاشة الصور بعد ما IP يتحمل.
                */
                if (window.loginManualMode === true || (manualLoginInput && manualLoginInput.value === 'true')) {
                    return;
                }

                if (visibleRowsCount === 0) {
                    showNoProfilesState();
                    return;
                }

                selectInitialVisibleProfile();
            }

            function setupHeroTouchNavigation() {
                if (!employeeHero) return;

                let touchStartX = 0;
                let touchStartY = 0;
                let touchStartTime = 0;

                employeeHero.addEventListener('touchstart', function (event) {
                    if (window.loginManualMode === true || (manualLoginInput && manualLoginInput.value === 'true')) return;
                    if (getRows().length < 2) return;
                    if (!event.touches || event.touches.length !== 1) return;

                    touchStartX = event.touches[0].clientX;
                    touchStartY = event.touches[0].clientY;
                    touchStartTime = Date.now();
                }, { passive: true });

                employeeHero.addEventListener('touchend', function (event) {
                    if (window.loginManualMode === true || (manualLoginInput && manualLoginInput.value === 'true')) return;
                    if (getRows().length < 2) return;
                    if (!event.changedTouches || event.changedTouches.length !== 1) return;

                    const endX = event.changedTouches[0].clientX;
                    const endY = event.changedTouches[0].clientY;
                    const diffX = endX - touchStartX;
                    const diffY = endY - touchStartY;
                    const elapsed = Date.now() - touchStartTime;

                    if (elapsed > 900) return;
                    if (Math.abs(diffX) < 42) return;
                    if (Math.abs(diffX) < Math.abs(diffY) * 1.15) return;

                    if (diffX < 0) {
                        moveProfile(1);
                    } else {
                        moveProfile(-1);
                    }
                }, { passive: true });
            }

            applyStoredOrder();
            setupSorting();
            setupHeroTouchNavigation();

            if (window.loginManualMode) {
                setManualMode(false);
            } else if (window.loginClientIpIsLoaded) {
                applyCurrentIpFilter(window.loginCurrentPublicIp);
            }

            window.addEventListener('loginClientIpLoaded', function (event) {
                const ip = event && event.detail ? event.detail.ip : '';
                applyCurrentIpFilter(ip);
            });

            if (openBtn) openBtn.addEventListener('click', openDrawer);
            if (closeBtn) closeBtn.addEventListener('click', closeDrawer);
            if (overlay) overlay.addEventListener('click', closeDrawer);

            getRows(true).forEach(row => {
                row.addEventListener('click', function () {
                    if (row.classList.contains('is-dragging') || row.classList.contains('is-ip-hidden')) return;
                    selectProfile(row, true, true);
                });
            });

            if (prevBtn) {
                prevBtn.addEventListener('click', function () {
                    moveProfile(-1);
                });
            }

            if (nextBtn) {
                nextBtn.addEventListener('click', function () {
                    moveProfile(1);
                });
            }

            if (carouselPrevArrow) {
                carouselPrevArrow.addEventListener('click', function () {
                    moveProfile(-1);
                });
            }

            if (carouselNextArrow) {
                carouselNextArrow.addEventListener('click', function () {
                    moveProfile(1);
                });
            }

            const addBtn = document.getElementById('loginAddUserBtn');

            if (addBtn) {
                addBtn.addEventListener('click', function () {
                    closeDrawer();
                    clearLoginWarningMessage();
                    setManualMode(true);

                    if (window.history && window.history.replaceState) {
                        window.history.replaceState(null, document.title, window.location.pathname);
                    }
                });
            }

            if (manualEmailInput) {
                manualEmailInput.addEventListener('input', clearLoginWarningMessage);
                manualEmailInput.addEventListener('change', clearLoginWarningMessage);
            }

            function ensureClientPublicIpBeforeSubmit() {
                const publicIpInput = document.getElementById('ClientPublicIp');

                if (publicIpInput && !publicIpInput.value && window.loginCurrentPublicIp) {
                    publicIpInput.value = normalizeIp(window.loginCurrentPublicIp);
                }
            }

            function prepareLoginFormBeforeSubmit() {
                ensureClientPublicIpBeforeSubmit();

                if (manualLoginInput && manualLoginInput.value === 'true') {
                    if (selectedEmailInput && manualEmailInput) {
                        selectedEmailInput.value = (manualEmailInput.value || '').trim();
                    }
                } else if (selectedEmailInput) {
                    saveLastSelectedEmail(selectedEmailInput.value);
                }
            }

            function waitForClientIpReady(timeoutMs) {
                if (window.loginClientIpIsLoaded) {
                    return Promise.resolve();
                }

                const ipPromise = window.loginClientIpLoadPromise && typeof window.loginClientIpLoadPromise.then === 'function'
                    ? window.loginClientIpLoadPromise
                    : Promise.resolve();

                const timeoutPromise = new Promise(resolve => {
                    setTimeout(resolve, timeoutMs);
                });

                return Promise.race([ipPromise, timeoutPromise]);
            }

            if (accountForm) {
                accountForm.setAttribute('autocomplete', 'off');

                accountForm.addEventListener('submit', function (event) {
                    if (!isSubmittingAfterIpWait && !window.loginClientIpIsLoaded) {
                        event.preventDefault();

                        waitForClientIpReady(1800).then(function () {
                            prepareLoginFormBeforeSubmit();
                            isSubmittingAfterIpWait = true;

                            if (accountForm.requestSubmit) {
                                accountForm.requestSubmit();
                            } else {
                                accountForm.submit();
                            }
                        });

                        return;
                    }

                    prepareLoginFormBeforeSubmit();
                });
            }
        })();
    </script>
}

